    # w innocent "Nonsense. I'm the one who asked you out tonight, you don't have to cover a thing."
    w innocent "Nonsens. To ja cię zabrałem na randkę, nie musisz pokrywać absolutnie niczego."

# game/script.rpy:603
translate pl start_ffe053ec:

    # p anxious "...."
    p anxious "..."

