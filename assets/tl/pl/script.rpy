    # w pj innocent "(Date you? Yes!!)"
    w pj innocent "(Z tobą być? Tak!!!)"

# game/script.rpy:2908
translate pl ch6_1977ea6f:

    # p seriously "...Clean the rest of your house together?" with vpunch
    p seriously "...pomóc mi posprzątać resztę domu?" with vpunch

# game/script.rpy:2909
translate pl ch6_4cd578fd:

    # w ohdear "...Hm?"
    w ohdear "...Hm?"

# game/script.rpy:2910
translate pl ch6_bdf3c1ab:

    # p shy "I-it'll be more fun than it sounds! And if you get bored, we can do something else..."
    p shy "B-będzie milej, niż ci się wydaje! A jeśli się znudzisz, możemy zawsze zająć się czymś innym..."

# game/script.rpy:2911
translate pl ch6_a76308ac:

    # w calm "Pastille..."
    w calm "Pastylku..."

# game/script.rpy:2912
translate pl ch6_80a12d07:

    # p embarrassed "I just thought if we did it together, you'd get a say in where everything goes, so nothing ends up getting lost...!"
    p embarrassed "{size=-4}Pomyślałem tylko, że jeśli zajmiemy się tym razem, będziesz mógł zadecydować, gdzie jest czego miejsce, więc niczego przypadkiem nie zgubimy...!{/size}"

# game/script.rpy:2913
translate pl ch6_ee213eff:

    # w love "Pastille...!"
    w love "Pastylku...!"

# game/script.rpy:2914
translate pl ch6_c8b7db60:

    # p ehe2 "And it's totally fine if you don't want me going through your stuff anymore. We really don't have to--"
    p ehe2 "I wszystko w porządku, jeśli nie chcesz, bym nadal przeglądał twoje rzeczy. Jeśli naprawdę sobie tego nie życzysz-"

# game/script.rpy:2915
translate pl ch6_38742bdf:

    # w happy "Pastille, it's fine! I think it's a lovely idea."
    w happy "Pastylek, wszystko w porządku! Myślę, że to świetny pomysł."

# game/script.rpy:2916
translate pl ch6_d3b99301:

    # p wha "R-really...?"
    p wha "N-naprawdę...?"

# game/script.rpy:2917
translate pl ch6_d5f25738:

    # w innocent "Yes. In fact, I'd appreciate your help."
    w innocent "Tak. Właściwie, bardzo doceniam twoją pomoc."

# game/script.rpy:2918
translate pl ch6_4ba187a4:

    # w love "One thing or another has always come up when I try to clean on my own. I'm simply useless at it."
    w love "Kiedy próbuję sprzątać, zawsze przypadkiem znajduję lepsze rzeczy do roboty. Jestem bezużyteczny."

# game/script.rpy:2919
translate pl ch6_c049910d:

    # p happy "Then... I'll take the lead! I wanted to start with these boxes by the couch..."
    p happy "Więc... ja będę przewodził! Chciałem zacząć od tamtych pudełek przy sofie..."

# game/script.rpy:2923
translate pl ch6_98446b5c:

    # "Pastille already had a plan for everything, it seemed."
    "Wydawało się, że Pastylek miał już plan na wszystko."

# game/script.rpy:2924
translate pl ch6_80b953ec:

    # "His energy was contagious. He was right that it would be fun--it was entertaining even just watching him go."
    "Jego energia była zaraźliwa. Miał rację, było w tym coś zajmującego - samo obserwowanie go w swoim żywiole było wciągające."

# game/script.rpy:2925
translate pl ch6_8e73e0b2:

    # "To see him dart around the room so energetically, finding the perfect place for every little thing..."
    "To, jak z gracją poruszał się po pomieszczeniu, zawsze znajdując odpowiednie miejsce na każdą malutką rzecz..."

# game/script.rpy:2926
translate pl ch6_f19b7285:

    # "He truly has a talent for organization."
    "Naprawdę ma talent."

# game/script.rpy:2927
translate pl ch6_8bb41e57:

    # nvl clear
    # "Meanwhile, I mostly played the role of assistant."
    nvl clear
    "Tymczasem ja przyjąłem rolę asystenta."

# game/script.rpy:2929
translate pl ch6_a1ad8874:

    # "He would ask for my input every now and then, or instruct me to place something he found somewhere across the room."
    "Od czasu do czasu pytał mnie o zdanie, czy prosił, bym przeniósł coś, co dopiero znalazł na drugim końcu pokoju."

# game/script.rpy:2930
translate pl ch6_092cda92:

    # "He made little decisions like that so easily. If it were me, I'd get stuck on every one..."
    "Zauważyłem, że bardzo łatwo przychodzi mu podejmowanie takich decyzji. Gdyby ta odpowiedzialność spadła na mnie, za daleko byśmy nie zaszli..."

# game/script.rpy:2931
translate pl ch6_48fd29c3:

    # "But he saw everything through, effortlessly. It was nothing short of amazing."
    "Ale on bez wysiłku wiedział wszystko. Było to wprost ujmujące."

# game/script.rpy:2932
translate pl ch6_8d433bab:

    # nvl clear
    # n "And so, in a short few hours..."
    nvl clear
    n "Tak więc, po kilku godzinach..."

# game/script.rpy:2938
translate pl ch6_80154118:

    # n "...The entire house had become neat and tidy."
    n "...Cały dom był uprzątnięty."

# game/script.rpy:2941
translate pl ch6_fe44cae1:

    # p "Okay... I think I'm satisfied. You?"
    p "Dobrze... Chyba jestem usatysfakcjonowany. A ty?"

# game/script.rpy:2942
translate pl ch6_9e685ed1:

    # w pj shy "Hmm~ don't you think you deserve to be rewarded for all your hard work? 💙"
    w pj shy "Hmm~ Nie sądzisz, że zasługujesz na nagrodę za tę ciężką pracę? 💙"

# game/script.rpy:2943
translate pl ch6_876e21b0:

    # p uhoh "Ah--I-I should've seen that one coming...!"
    p uhoh "Ach- P-powinienem był się tego spodziewać...!"

# game/script.rpy:2944
translate pl ch6_09a70627:

    # p shy "But no, not right now! I should actually get going...."
    p shy "Ale nie, nie teraz! Powinienem się zbierać..."

# game/script.rpy:2945
translate pl ch6_4a104fcf:

    # w smile "You won't stay?"
    w smile "Nie zostajesz?"

# game/script.rpy:2946
translate pl ch6_7477ec63:

    # p smile "I promised Gumdrop I'd be back for the afternoon shift. She'll start to worry if I don't come back soon."
    p smile "Obiecałem Żelce, że wrócę do niej na drugą zmianę. Zacznie się martwić, jeśli będę zwlekał z powrotem."

# game/script.rpy:2947
translate pl ch6_7efae89a:

    # w calm "Hmhm... I'll save your reward for next time, then."
    w calm "Hmhm... W takim razie nagroda poczeka."

# game/script.rpy:2950
translate pl ch6_ebdb2310:

    # n "Pastille slips on his jacket and shoes."
    n "Pastylek wkłada swoją kurtkę i buty."

# game/script.rpy:2951
translate pl ch6_4a339e2c:

    # n "Just before he leaves, he turns back to face Periwinkle..."
    n "Nim otwiera drzwi, odwraca się w stronę Barwinka..."

# game/script.rpy:2954
translate pl ch6_931329ba:

    # p "By the way, um... I was thinking..."
    p "Tak właściwie, um... Tak sobie myślałem..."

# game/script.rpy:2955
translate pl ch6_97a64bda:

    # w pj "Yes...?"
    w pj "Tak...?"

# game/script.rpy:2956
translate pl ch6_55b62f87:

    # p oh "There are some days my friends travel out of town. For alchemy stuff."
    p oh "W niektóre dni moi przyjaciele wyjeżdżają z miasta. W poszukiwaniu składników."

# game/script.rpy:2957
translate pl ch6_5634565b:

    # p shy "So if you ever wanted to drop by while I'm working on those days... I think that'd be okay..."
    p shy "Więc jeśli chciałbyś kiedyś mnie w taki dzień odwiedzić... Chyba byłoby w porządku..."

# game/script.rpy:2958
translate pl ch6_9d4854d5:

    # p ehe "That's, um... the most I can do right now... sorry."
    p ehe "To, um... To wszystko, co mogę teraz zaoferować... Przepraszam."

# game/script.rpy:2959
translate pl ch6_41c1209f:

    # w happy "I'll gladly take you up on that! I'd love to keep you company 💙"
    w happy "Z chęcią skorzystam! Uwielbiam dotrzymywać ci towarzystwa 💙"

# game/script.rpy:2960
translate pl ch6_8fc6bb84:

    # p smile "Great! Okay, then...."
    p smile "Świetnie! Dobrze, w takim razie..."

# game/script.rpy:2964
translate pl ch6_7cabd49b:

    # n "Pastille gives him a quick peck on the cheek..."
    n "Pastylek całuje go w policzek..."

# game/script.rpy:2966
translate pl ch6_3305bee7:

    # n "...before saying goodbye, and walking out the door."
    n "...i się żegna, wychodząc za drzwi."

# game/script.rpy:2971
translate pl ch6_7969eade:

    # w pj wow "...."
    w pj wow "..."

# game/script.rpy:2973
translate pl ch6_c71484d3:

    # "What... WAS all of that?"
    "Co... CO to miało być?"

# game/script.rpy:2974
translate pl ch6_77393381:

    # "It was extremely domestic! I can't be imagining things, can I?"
    "To było niezwykle... domowe! Nie wyobrażam sobie tego, prawda?"

# game/script.rpy:2975
translate pl ch6_a79fc5b9:

    # "He said it was okay... to come and visit him...?"
    "Powiedział, że w porządku będzie... jeśli go odwiedzę...?"

# game/script.rpy:2976
translate pl ch6_3ed40c2c:

    # "That has to mean something, doesn't it?"
    "To musi coś oznaczać, czyż nie?"

# game/script.rpy:2977
translate pl ch6_b3442fd3:

    # nvl clear
    # w pj nofair "......"
    nvl clear
    w pj nofair "..."

# game/script.rpy:2980
translate pl ch6_d0687ab0:

    # n "Periwinkle begins pacing around the room."
    n "Barwinek zaczyna kręcić się po pokoju."

# game/script.rpy:2982
translate pl ch6_ee66677e:

    # "Now, now... let's not get carried away."
    "Ale, ale... Nie zapędzajmy się."

# game/script.rpy:2983
translate pl ch6_da436e71:

    # "This is a delicate situation. Dropping these intense feelings onto him out of nowhere may only serve to scare him off."
    "To wyjątkowo delikatna sytuacja. Wyjawienie mu tych uczuć znienacka jedynie go wystraszy."

# game/script.rpy:2984
translate pl ch6_9440b0fe:

    # "Neither of us was looking for a committed relationship from the beginning--that was made explicitly clear early on!"
    "Żadne z nas nie szukało stałego związku - od samego początku wyraźnie to zaznaczaliśmy!"

# game/script.rpy:2985
translate pl ch6_43ab76b1:

    # "And yet... and yet...!"
    "A jednak... A jednak...!"

# game/script.rpy:2986
translate pl ch6_6333e45c:

    # nvl clear
    # w nofair2 "He isn't playing fair...! My heart can't take this!"
    nvl clear
    w nofair2 "Nie gra fair...! Moje serce tego nie zniesie!"

# game/script.rpy:2989
translate pl ch6_027ff050:

    # n "Periwinkle throws himself onto the couch dramatically."
    n "Barwinek dramatycznie rzuca się na sofę."

# game/script.rpy:2990
translate pl ch6_e25e9729:

    # w pj yell "There's no way I'll be able to stop thinking of him now... even being at home has become a reminder in and of itself...!"
    w pj yell "Nie ma mowy, że będę w stanie przestać o nim myśleć... Samo przebywanie w domu mi o nim przypomina...!"

# game/script.rpy:2991
translate pl ch6_08637e4e:

    # w nofair "Everything is nice because of him! And now I'm suffering...!!"
    w nofair "Przez niego wszystko gra! I przez to cierpię...!!!"

# game/script.rpy:2993
translate pl ch6_c2595cfb:

    # "This is simply too much..."
    "To po prostu za dużo..."

# game/script.rpy:2994
translate pl ch6_b7a26f25:

    # "There has to be a way for me to safely indulge in these romantic feelings."
    "Musi być jakiś sposób na bezpieczne oddanie się tym uczuciom."

# game/script.rpy:2995
translate pl ch6_f0e953fa:

    # "Things are fine as they are. Progressing, even."
    "Dobrze jest jak jest. Relacja nawet się rozwija."

# game/script.rpy:2996
translate pl ch6_8a9f8371:

    # "If I just let it run its natural course, then maybe we'll end up..."
    "Jeśli pozwolę jej nadal naturalnie się pogłębiać, może skończymy..."

# game/script.rpy:2997
translate pl ch6_74c39862:

    # nvl clear
    # "Ah... what do I want out of this?"
    nvl clear
    "Ach... Czego ja tak właściwie chcę?"

# game/script.rpy:2999
translate pl ch6_d0086124:

    # "To be with him forever? ME?!"
    "Być z nim na wieki? JA?!"

# game/script.rpy:3000
translate pl ch6_54531ff3:

    # "I haven't had a single healthy long-term relationship in my entire life! Love isn't in the cards for someone like me..."
    "Nie byłem w ani jednym zdrowym związku przez całe życie! Miłość zdecydowanie nie jest pisana osobom jak ja..."

# game/script.rpy:3001
translate pl ch6_de6de606:

    # "Ugh, I... I can't even recognize myself right now...!"
    "Uch, ja... Ja nawet nie poznaję samego siebie...!"

# game/script.rpy:3002
translate pl ch6_c71bbc8b:

    # nvl clear
    # w decline "*sigh* ...Calm down."
    nvl clear
    w decline "*westchnienie* ...Spokojnie."

# game/script.rpy:3004
translate pl ch6_e31dafc0:

    # w neutral "I'm overreacting again. Nothing has effectively changed just yet."
    w neutral "Znowu przesadzam. Nic jeszcze się nie zmieniło."

# game/script.rpy:3006
translate pl ch6_ac683799:

    # "I can't keep fighting myself on this..."
    "Nie mogę nadal ze sobą walczyć..."

# game/script.rpy:3007
