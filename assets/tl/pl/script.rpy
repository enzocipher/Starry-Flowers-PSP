translate pl ch5_aa4f7e0f:

    # r think "Love, then...? No, you aren't the type...."
    r think "Więc to miłość...? Nie, nie jesteś taki..."

# game/script.rpy:2413
translate pl ch5_9a95397c:

    # r wink "Come on, why won't you just tell me? I can't help if you won't give up any details."
    r wink "Proszę, czemu po prostu mi nie powiesz? Nie jestem w stanie ci pomóc bez znajomości jakichkolwiek detali."

# game/script.rpy:2414
