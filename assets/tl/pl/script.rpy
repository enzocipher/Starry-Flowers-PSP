translate pl start_bd8b2307:

    # p smile "My best friend is an alchemist, so I've recently been going on little adventures to help gather ingredients for her craft."
    p smile "Moja najlepsza przyjaciółka jest alchemiczką, więc ostatnio często wyruszam na małe wyprawy, by zdobyć składniki na jej dzieła."

# game/script.rpy:541
