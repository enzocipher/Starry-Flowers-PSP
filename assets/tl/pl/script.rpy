    w date calm "Nic mi o tym nie wiadomo."

# game/script.rpy:2076
translate pl ch4_3e5dc9da:

    # p calm "Phew. I'm glad I could fix it... I was worried it might be expensive."
    p calm "Fiu. Dobrze, że udało mi się ją naprawić... Bałem się, że stracę oszczędności."

# game/script.rpy:2077
translate pl ch4_b7aae312:

    # w smile "You never told me you were so good with magic. As I recall, you said you had been living without it?"
    w smile "Nigdy nie mówiłeś, że tak dobrze radzisz sobie z magią. Wydawało mi się, że wspominałeś że żyłeś bez niej?"

# game/script.rpy:2078
translate pl ch4_ae7d5ce2:

    # p think "Yeah, mostly."
    p think "Tak, mniej więcej."

# game/script.rpy:2079
