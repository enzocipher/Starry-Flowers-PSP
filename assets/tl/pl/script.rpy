    # w shy "I'm starting to think a more lustful scent might've been a better fit."
    w shy "Zaczynam myśleć, że zapach pożądania pasowałby jeszcze lepiej."

# game/script.rpy:500
translate pl start_a5d894c0:

    # p omgstop "Wh-what does that even mean...?!" with vpunch
    p omgstop "C-co to w ogóle znaczy...?!" with vpunch

# game/script.rpy:501
translate pl start_f5e481ca:

    # w teehee "Just that you've done nothing but exceed my expectations 💙"
    w teehee "Znaczy tyle, że przewyższasz moje wszelkie oczekiwania 💙"

# game/script.rpy:502
translate pl start_857b0c55:

    # p flustered "I-I'm not... doing anything...."
    p flustered "A-ale nawet... nic takiego nie zrobiłem..."

# game/script.rpy:504
translate pl start_51513c28:

    # n "Pastille retreats behind his glass of water, overwhelmed by embarrassment once again."
