    # p oh "Oh... that IS nice."
    p oh "Och... jakie to miłe."

# game/script.rpy:497
translate pl start_66fd115e:

    # p smile "What smell is that? I'm no good at pinpointing stuff like this..."
    p smile "Co to za zapach? Nie jestem za dobry w takich rzeczach..."

# game/script.rpy:498
translate pl start_67b12735:

    # w oh "Vanilla. I thought it suited you. Although..."
    w oh "Wanilia. Myślałem, że pasuje do ciebie. Ale..."

# game/script.rpy:499
