    w calm "Hmhm, przyjemność po mojej stronie 💙"

# game/script.rpy:1003
translate pl ch2_482c7dd0:

    # "Even casual relationships can end in breakups like this."
    "Nawet niezobowiązujące relacje mogą tak się urwać."

# game/script.rpy:1004
translate pl ch2_7fabf76c:

    # "This is largely why I tend to prefer one-night affairs. Things can just become so messy as needs evolve..."
    "To właśnie dlatego preferuję przygody na jedną noc. Wszystko się komplikuje, gdy relacja się umacnia..."

# game/script.rpy:1005
translate pl ch2_e8be9790:

    # "As Cassia and I go our separate ways, I can't help feeling a little blue."
    "Przez to, jak skończyła Cassia i ja, nic nie poradzę, ale czuję się trochę przygnębiony."

# game/script.rpy:1006
translate pl ch2_7b0bc9f1:

    # "Perhaps I'll return home for the day after all."
    "Może jednak wrócę do domu."

# game/script.rpy:1007
translate pl ch2_76b2fe88_2:

    # nvl clear
    nvl clear

# game/script.rpy:1018
translate pl ch2_80d3118f:

