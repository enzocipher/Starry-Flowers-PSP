    r "Dobry wieczór, Barwinku! Czego dzisiaj poszukujesz?"

# game/script.rpy:2390
translate pl ch5_c89d618d:

    # r wink "New bottles? A book? Or perhaps... ME? 💙"
    r wink "Nowych butelek? Książki? A może... MNIE 💙"

