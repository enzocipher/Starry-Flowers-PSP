    # w teehee "Careful, my sweet... if you say it like that, I'm going to start asking you to cook my every meal."
    w teehee "{size=-4}Uważaj, mój drogi... Jeśli nadal będziesz wygadywał takie bzdury, będę musiał zacząć prosić cię o gotowanie dla mnie wszystkich posiłków dnia.{/size}"

# game/script.rpy:2860
translate pl ch6_c38947a1:

    # p sure "Fine, you got me. They're special gourmet pancakes I can only whip up every once in a while."
    p sure "No dobrze, niech będzie. To specjalne naleśniki, które przyrządzam tylko czasami."

# game/script.rpy:2861
translate pl ch6_4b7d60e9:

    # w happy "Lucky me~! 💙"
    w happy "Ja to mam szczęście~! 💙"

# game/script.rpy:2864
translate pl ch6_9df71125:

    # n "Periwinkle finishes his pancakes while Pastille begins washing the dishes..."
    n "Barwinek kończy jeść naleśniki, a Pastylek zaczyna myć naczynia..."

# game/script.rpy:2866
translate pl ch6_395109a4:

    # "This may just be the most spoiled I've ever felt..."
    "To może być ten moment, w którym stwierdzam, że bardziej się mnie nie da rozpieścić..."

# game/script.rpy:2867
translate pl ch6_76489d66:

    # "Being with Pastille is like getting caught in an endless whirlwind of positive feelings."
    "Przebywanie z Pastylkiem, jestem pewien, to wpadnięcie w niekończący się wir pozytywnych uczuć."
    nvl clear

# game/script.rpy:2868
translate pl ch6_0dbd129d:

    # "No wonder I've become obsessed with him. This boy is dangerously kind."
    "Nie dziwi mnie, że mam na jego punkcie obsesję. Ten chłopak jest niebezpiecznie uprzejmy."

# game/script.rpy:2869
translate pl ch6_c7414828:

    # "After these past few emotionally tumultuous days, I... how could I possibly turn away from his comfort...?"
    "A po tych wszystkich dniach emocjonalnej niestabilności, ja... W sensie, jak niby miałbym odrzucić jego czułość...?"

# game/script.rpy:2870
translate pl ch6_7ab087e8:

    # nvl clear
    # n "Periwinkle rests his elbows on the table, head tilted into palm as he watches Pastille in his kitchen."
    nvl clear
    n "Barwinek opiera łokcie na stole, głowę wygodnie układa w dłoniach i przygląda się Pastylkowi."

# game/script.rpy:2873
translate pl ch6_59ce0cf4:

    # w pj oh "Out of curiosity..."
    w pj oh "Tak z ciekawości..."

# game/script.rpy:2875
translate pl ch6_bdbd5257:

    # p "Hm?"
    p "Hm?"

# game/script.rpy:2876
translate pl ch6_d05db3f5:

    # w "Earlier, before I woke up. What made you ask to start cleaning my room?"
    w "Wcześniej, zanim się obudziłem. Dlaczego zapytałeś, czy możesz posprzątać?"

# game/script.rpy:2877
translate pl ch6_2563590a:

    # p ehe "Oh, I noticed it was getting harder to walk around..."
    p ehe "Och, zauważyłem, że coraz ciężej jest przedostać się do drzwi..."

# game/script.rpy:2878
translate pl ch6_8bffd0df:

    # p shy "I think I stepped on some of your clothes when I, um... carried you in there last night. Sorry."
    p shy "Kiedy, um, kiedy stanąłem na twoich ubraniach gdy... zanosiłem cię do łóżka wczorajszej nocy. Przepraszam."

# game/script.rpy:2879
translate pl ch6_32cb935a:

    # w calm "That's nothing to apologize for. It was fun."
    w calm "Nie ma za co przepraszać. Było miło."

# game/script.rpy:2880
translate pl ch6_a00c9b60:

    # p embarrassed "Eheh... a-anyway... I felt a little bad about it."
    p embarrassed "Eheh... A-ale... czułem się przez to trochę źle."

# game/script.rpy:2881
translate pl ch6_7219c855:

    # p ehe "So I figured, if I'm going to be coming back here so often, I might as well help clean."
    p ehe "Więc pomyślałem, że skoro będę cię często odwiedzał, mogę równie dobrze zadbać o czystość."

# game/script.rpy:2882
