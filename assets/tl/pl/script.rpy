    # nvl clear
    nvl clear

# game/script.rpy:681
translate pl start_889df456:

    # w calm "Sorry about the mess. I just haven't found the time to tidy up~"
    w calm "Przepraszam za bałagan. Nie miałem czasu, by posprzątać~"

# game/script.rpy:682
translate pl start_ef3726ee:

    # w oh "{nw}"
    w oh "{nw}"

# game/script.rpy:684
translate pl start_91d784bf:

    # n "The door closes loudly behind them. When Pastille doesn't respond, Periwinkle turns back to face him..."
    n "Drzwi zamykają się za nimi z głośnym trzaskiem. Kiedy Pastylek nie odpowiada, Barwinek odwraca się w jego stronę..."

# game/script.rpy:690
translate pl start_00b95dae:

    # n "Pastille's back is against the door as he fumbles to untie his mantle."
    n "Plecy Pastylka dotykają drzwi, a on próbuje rozwiązać swój płaszcz."

# game/script.rpy:694
translate pl start_09ae6c7c:

    # w drool "(He's completely run out of patience, hasn't he...!)"
    w drool "(Kompletnie skończyła mu się cierpliwość, czyż nie...?)"

# game/script.rpy:695
translate pl start_9c346134:

    # w shy "(Then I'm afraid I simply have no choice but to indulge him~)"
    w shy "(W takim razie wydaje mi się, iż nie pozostawia mi żadnego wyboru~)"

# game/script.rpy:700
translate pl start_033d605a:

    # w "Hmhm, I shouldn't keep you waiting a second longer, now should I?"
    w "Hmhm, nie powinieneś czekać ani trochę dłużej, prawda?"

# game/script.rpy:701
translate pl start_4a130bfc:

    # p "M-mn...!"
    p "M-mn...!"

# game/script.rpy:703
translate pl start_90ffdfad:

    # w "Ah, but I still need to change into something a little easier to take off..."
    w "Ach, nadal muszę przebrać się w coś, co trochę łatwiej z siebie zrzucić..."

# game/script.rpy:704
translate pl start_6e757cc4:

    # w "Looking this good comes at a price, you see. I promise I won't keep you waiting."
    w "Dobry wygląd ma swoją cenę, rozumiesz. Obiecuję, nie będziesz czekał za długo."

# game/script.rpy:705
translate pl start_827e34fc:

    # p "O-okay..."
    p "O-okej..."

# game/script.rpy:708
translate pl start_66ce2a36:

    # n "Periwinkle gives him another peck on the lips, and leads him through the cluttered living room to his bedroom door..."
    n "Barwinek daje mu kolejnego całusa i prowadzi przez zagracony salon aż do drzwi sypialni..."

# game/script.rpy:721
translate pl ch2_7b49a2da:

    # centered "{w=3}{nw}"
    centered "{w=3}{nw}"

# game/script.rpy:727
translate pl ch2_420c2aa2:

    # "It took me ages to get out of bed that morning."
    "Wieki mi zajęło wstanie z łóżka."

# game/script.rpy:728
translate pl ch2_d9e096c6:

    # "After all... I just couldn't stop thinking about how absolutely adorable Pastille was! 💙"
    "Bo w końcu... nie mogłem przestać myśleć o tym, jak absolutnie uroczy był Pastylek! 💙"

# game/script.rpy:729
translate pl ch2_7c711ce7:

    # "He scrambled out of here almost as soon as he woke up, saying he couldn't be late for work..."
    "Uciekł zaraz po tym, jak się obudził, mówiąc, że nie może spóźnić się do pracy..."

# game/script.rpy:730
translate pl ch2_e5f82cff:

    # "Such a shame. Would've been nice to get one last round in~"
    "Jaka szkoda. Miło byłoby mieć czas na jeszcze jedną rundę~"

# game/script.rpy:731
translate pl ch2_a69cdafc:

    # "...I did get a kiss goodbye, though 💙"
    "...Ale dostałem pocałunek na pożegnanie 💙"

# game/script.rpy:732
translate pl ch2_79c07e86:

    # nvl clear
    # w bed shy "Ahh, it's nice to feel like a housewife for a moment~"
    nvl clear
    w bed shy "Ach, miło czasami się poczuć jak gospodyni domowa~"

# game/script.rpy:734
translate pl ch2_369e7bdd:

    # w smile "But I should get to work, too..."
    w smile "Ale też powinienem zbierać się do pracy..."

# game/script.rpy:735
translate pl ch2_a95a50d1:

    # w happy "I have an order to fill, don't I~?"
    w happy "Mam zamówienie, czyż nie~?"

# game/script.rpy:738
translate pl ch2_3c76f5d0:

    # n "Periwinkle finally rolls out of bed and gets ready for the day..."
    n "Barwinek nareszcie wstaje z łóżka i szykuje się na długi dzień..."

# game/script.rpy:741
translate pl ch2_5a13e7e9:

    # "The order in question is for a nearby apothecary."
    "Najnowsze zamówienie jest dla niedalekiej apteki."

# game/script.rpy:742
translate pl ch2_35f25f34:

    # "Did you know? Aromagic like mine is actually quite good for you~"
    "Wiedziałeś, że aromagia pomaga na wiele spraw?~"

# game/script.rpy:743
translate pl ch2_8f79525a:

    # "It's got nothing on actual healing magic, but the calming atmosphere it creates does wonders for one's mood."
    "Nie może równać się z prawdziwą magią leczniczą, ale kojąca atmosfera, którą tworzy, potrafi działać cuda."

# game/script.rpy:744
translate pl ch2_48c6a187:

    # nvl clear
    # "This particular batch is meant to help with insomnia..."
    nvl clear
    "Ten nakład ma pomagać z bezsennością..."

# game/script.rpy:746
translate pl ch2_9bdec3ec:

    # "Which is ironic, considering how late I stayed up with Pastille 💙"
    "Co jest dość ironiczne, biorąc pod uwagę, że całą noc nie spałem przez Pastylka 💙"

# game/script.rpy:747
translate pl ch2_e22fb32a:

    # nvl clear
    # w pj teehee "Whoops, can't be getting distracted now~ I really need to finish up these last few bottles..."
    nvl clear
    w pj teehee "Ups, nie mogę się teraz rozpraszać~ Naprawdę muszę dokończyć te kilka butelek..."

# game/script.rpy:750
translate pl ch2_e708ef33:

    # w calm "{nw}"
    w calm "{nw}"

# game/script.rpy:751
translate pl ch2_2dd620a3:

    # n "Periwinkle closes his eyes and draws his wand."
    n "Barwinek zamyka oczy i wyciąga swoją różdżkę."

# game/script.rpy:753
translate pl ch2_3425d8a6:

    # n "Large drops form at its tip, falling into the empty bottle one by one."
    n "Na jej czubku tworzą się duże krople, które następnie opadają do pustej butelki."

# game/script.rpy:754
translate pl ch2_3222c5b9:

    # n "With each drip, the bottle's contents swell, and after only the fifth drop, it's completely filled."
    n "Z każdą kroplą jej zawartość się powiększa, a po piątej butelka jest już całkowicie napełniona."

# game/script.rpy:757
translate pl ch2_fbaed311:

    # w innocent "Perfect! Ahh, it's so much easier to finish these with a clear mind..."
    w innocent "Świetnie! Ach, o wiele łatwiej się tym zajmować z czystym umysłem..."

# game/script.rpy:758
translate pl ch2_6e325112:

    # w shy "I can't help it if a refreshing night out is the only way to regain my focus 💙"
    w shy "Nic nie poradzę na to, że orzeźwiająca noc to jedyny sposób na skupienie się 💙"

# game/script.rpy:759
translate pl ch2_afd133a7:

    # w teehee "Although~ I probably could've gotten one of these done last night if Pastille hadn't been so impatient... 💙"
    w teehee "Ale~ pewnie mógłbym napełnić jedną z tych butelek zeszłej nocy, gdyby tylko Pastylek nie był taki niecierpliwy... 💙"

# game/script.rpy:760
translate pl ch2_44174832:

    # w calm "No, no, mustn't let my mind wander too far from work now."
    w calm "Nie, nie, nie mogę się teraz rozpraszać, muszę pracować."

# game/script.rpy:762
translate pl ch2_67507517:

    # n "Periwinkle fills the remaining bottles, screwing the lids on as he goes."
    n "Barwinek napełnia pozostałe butelki i dokręca ich zakrętki."

# game/script.rpy:764
translate pl ch2_5bd5f285:

    # w smile "There. Hmhm, now my house is going to smell like lavender..."
    w smile "Już. Hmhm, teraz mój dom będzie pachniał lawendą..."

# game/script.rpy:765
translate pl ch2_8bdf90ac:

    # w innocent "I'd better head out before I'm lulled to sleep by my own magic~"
    w innocent "Lepiej je odniosę zanim moja własna magia mnie uśpi~"

# game/script.rpy:779
translate pl ch2_85bf7599:

    # "The apothecary is only a short walk away, but I've never managed to walk in its doors on time."
    "Apteka znajduje się niedaleko mojego domu, ale nigdy jeszcze nie udało mi się dotrzeć do niej na czas."

# game/script.rpy:780
translate pl ch2_bd4b3ec4:

    # "Perhaps because it's so close, I always underestimate the time it takes to reach it..."
    "Może dlatego, że jest tak blisko, zawsze daję sobie za mało czasu na dojście do niej..."

# game/script.rpy:781
translate pl ch2_3b3d6df9:

    # "I can hear the owner tapping her foot with impatience as soon as I open the door."
    "Słyszę już, jak właścicielka z niecierpliwością tupie nogą."

# game/script.rpy:782
translate pl ch2_76b2fe88:

    # nvl clear
    nvl clear

# game/script.rpy:785
translate pl ch2_a74c124f:

    # w happy "Astragalus~! I have that special order ready for you~"
    w happy "Traganko~! Mam dla ciebie specjalne zamówienie~"

# game/script.rpy:786
translate pl ch2_318b7805:

    # a annoyed "You're late again, Periwinkle."
    a annoyed "Barwinek. Spóźniłeś się. Znowu."

# game/script.rpy:787
translate pl ch2_1019ebc0:

    # w innocent "Lost track of time 💙 You'll forgive me, won't you~?"
    w innocent "Straciłem poczucie czasu 💙 Wybaczysz mi, prawda~?"

# game/script.rpy:788
translate pl ch2_7862874c:

    # a "You are literally my only provider who has no respect for appointments."
    a "Jesteś dosłownie moim jedynym dostawcą, który nie darzy terminów żadnym szacunkiem."

# game/script.rpy:789
translate pl ch2_2fb8a6f9:

    # w oh "That's simply not true! I never miss a date."
    w oh "To przecież nieprawda! Jak się z kimś umawiam, to się stawiam na spotkanie."

# game/script.rpy:790
translate pl ch2_acda7219:

    # a lol "There's the problem. You were out getting laid again, weren't you?"
    a lol "I to właśnie twój problem. Znowu kogoś przeleciałeś, co nie?"

# game/script.rpy:791
translate pl ch2_dbeacd97:

    # w pout "How vulgar~ I had a romantic evening with a VERY cute boy..."
    w pout "Ale jesteś wulgarna~ Spędziłem romantyczny wieczór z BARDZO uroczym chłopakiem..."

# game/script.rpy:792
translate pl ch2_d7ebcbc7:

    # w innocent "Who then ended up sleeping over 💙"
    w innocent "Który potem spędził ze mną także noc 💙"

# game/script.rpy:793
translate pl ch2_facdd2e0:

    # a whatever "Well, you had all week to fill the order. Try getting it done in advance next time."
    a whatever "Cóż, miałeś cały tydzień na skończenie zamówienia. Następnym razem spróbuj wszystko ogarnąć zawczasu."

# game/script.rpy:794
translate pl ch2_8de08278:

    # w calm "Yes, ma'am~"
    w calm "Tak jest, kapitanie~"

# game/script.rpy:795
translate pl ch2_e220bd55:

    # a closed "Now let's see what you brought..."
    a closed "Zobaczmy, co mi przyniosłeś..."

# game/script.rpy:797
translate pl ch2_6aa2ff6b:

    # "I've worked with Astragalus for a few years now."
    "Pracuję z Traganką już od kilku lat."

# game/script.rpy:798
translate pl ch2_88aee593:

    # "She's COMPLETLY immune to my charms. Shocking, to say the least."
    "Jest KOMPLETNIE odporna na mój urok. Szokujące, wiem."

# game/script.rpy:799
translate pl ch2_f1139fde:

    # "But it's meant we've been able to remain good friends all this time~"
    "Ale to oznacza, że udało nam się zostać dobrymi przyjaciółmi~"

# game/script.rpy:800
translate pl ch2_4fc199f3:

    # "Or... hm. Let's see..."
    "Albo... hm. Zobaczmy..."

# game/script.rpy:801
translate pl ch2_76b2fe88_1:

    # nvl clear
    nvl clear

# game/script.rpy:804
translate pl ch2_2c3696be:

    # w oh "Astragalus. Would you consider us to be good friends?"
    w oh "Traganko. Uznajesz nas za dobrych przyjaciół?"

# game/script.rpy:805
translate pl ch2_c86bbb5c:

    # a whatever "I put up with you."
    a whatever "Toleruję cię."

# game/script.rpy:806
translate pl ch2_373f7314:

    # w happy "My, but you don't put up with ANYONE! You must really like me 💙"
    w happy "Rety, ale ty nie tolerujesz NIKOGO! Musisz serio mnie lubić 💙"

# game/script.rpy:807
translate pl ch2_47067d4c:

    # a lol "You got a favor to ask or something? Is that what you're getting at?"
    a lol "Potrzebujesz jakiejś przysługi czy coś? Do tego to prowadzi?"

# game/script.rpy:808
translate pl ch2_df3d1bd8:

    # w calm "No, I was just thinking of how to categorize our relationship."
    w calm "Nie, zastanawiałem się tylko, w jaką kategorię wrzucić naszą relację."

# game/script.rpy:809
translate pl ch2_72e2a8ac:

    # a "\"Business associate\" works just fine, doesn't it?"
    a "\"Współpracownik\" brzmi dobrze, co nie?"

# game/script.rpy:810
translate pl ch2_5f78763b:

    # w happy "Come now, surely you consider us to be closer than that!"
    w happy "Proszę cię, na pewno masz mnie za kogoś więcej!"

# game/script.rpy:811
translate pl ch2_ce50824a:

    # a sure "I know better than to get involved with you, Periwinkle."
    a sure "Wiem, że lepiej się z tobą nie angażować, Barwinek."

# game/script.rpy:812
translate pl ch2_17ce8a61:

    # w my "Why, whatever do you mean?"
    w my "Rety, a to dlaczego?"

# game/script.rpy:813
translate pl ch2_0ac87123:

    # a whatever "You're too dazzling."
    a whatever "Bo jesteś zbyt olśniewający."

# game/script.rpy:814
translate pl ch2_4a6eea27:

    # w innocent "I take that as a compliment~"
    w innocent "Wezmę to za komplement~"

# game/script.rpy:815
translate pl ch2_d60255a0:

    # a annoyed "Great, now will you stop distracting me? I'm trying to count."
    a annoyed "To super, mógłbyś teraz przestać mnie rozpraszać? Próbuję się skupić."

# game/script.rpy:817
translate pl ch2_8c4a5641:

    # "Yes, we're definitely good friends."
    "Tak, jesteśmy bardzo dobrymi przyjaciółmi."

# game/script.rpy:818
translate pl ch2_9ecc4a32:

    # "\"Too dazzling\" though... I'm not sure there IS such a thing."
    "\"Zbyt olśniewający\"... Nie wiedziałem, że coś takiego istnieje."

# game/script.rpy:819
translate pl ch2_82c90c4f:

    # "And what would be wrong with it if there was? What point is there in not shining as brightly as one can?"
    "A nawet gdyby, to co z tym nie tak? Nie ma sensu w powstrzymywaniu się, by nie lśnić najjaśniej, jak tylko się potrafi, prawda?"

# game/script.rpy:820
translate pl ch2_d0dcce99:

    # "Astragalus finishes counting the bottles, sighing in feigned exasperation as she marks them off her checklist..."
    "Traganka kończy liczyć butelki i wzdycha, udając rozdrażnienie, gdy skreśla je ze swojej listy..."

# game/script.rpy:821
translate pl ch2_529b0ff5:

    # nvl clear
    # a sure "You may always be late... but you deliver quality every time. You're consistent, if nothing else."
    nvl clear
    a sure "Może i zawsze się spóźniasz... ale twój towar jest wysokiej jakości. Przynajmniej jesteś konsekwentny."

# game/script.rpy:824
translate pl ch2_389bf1e7:

    # w teehee "The waiting is part of the fun. It builds excitement, wouldn't you say?"
    w teehee "Czekanie to część zabawy. Buduje ekscytację, nie sądzisz?"

# game/script.rpy:825
translate pl ch2_2f490664:

    # a whatever "Nope, just builds frustration for me. But at least you always come through."
    a whatever "Nie, jak dla mnie buduje jedynie frustrację. Ale przynajmniej zawsze przychodzisz."

# game/script.rpy:827
translate pl ch2_4251ed12:

    # n "She unlocks a small drawer behind the counter, and takes out an envelope with Periwinkle's name scribbled on it."
    n "Otwiera małą szufladę za ladą i wyciąga kopertę z imieniem Barwinka."

# game/script.rpy:829
translate pl ch2_9104554e:

    # a closed "Here's the rest of your payment. Don't spend it all in one place."
    a closed "Reszta pensji. Nie wydaj całej w jeden dzień."

# game/script.rpy:830
translate pl ch2_338d50e7:

    # w calm "Oh, I couldn't if I tried! Really, you're too generous..."
    w calm "Och, nie mógłbym nawet gdybym chciał! Jesteś zbyt hojna..."

# game/script.rpy:833
translate pl ch2_8daa5982:

    # n "Astragalus rolls her eyes and begins stocking the shelves with her new inventory."
    n "Traganka przewraca oczami i zajmuje się układaniem nowego towaru na półkach."

# game/script.rpy:835
translate pl ch2_ffbdbe6c:

    # "Two or three orders a month... that's all it takes to support myself, entirely through this apothecary."
    "Dwa czy trzy zamówienia na miesiąc... wystarczają, by się utrzymać, tylko dzięki tej aptece."

# game/script.rpy:836
translate pl ch2_ba2406db:

    # "Hard to believe my magic is really worth so much, but who am I to complain?"
    "Ciężko uwierzyć, że moja magia naprawdę jest tyle warta, ale co będę narzekał?"

# game/script.rpy:837
translate pl ch2_acb5044d:

    # "It's certainly a more favorable balance compared to the kind of work I was doing years ago."
    "To zdecydowanie o wiele korzystniejsza sytuacja niż praca, którą zajmowałem się lata temu."

# game/script.rpy:838
translate pl ch2_7acd925f:

    # nvl clear
    # "And I do enjoy the freedom, the excessive amounts of time I have for partying, for dates..."
    nvl clear
    "I podoba mi się wolność, czas, który mam na imprezy, na randki..."

# game/script.rpy:840
translate pl ch2_a2058868:

    # "Ah, on that note~"
    "Ach, skoro o tym mowa~"

# game/script.rpy:841
translate pl ch2_0b1b7e93:

    # nvl clear
    # w happy "With all that business out of the way... would you like to hear about my date? 💙"
    nvl clear
    w happy "Skoro mamy sprawy biznesowe za sobą... chcesz usłyszeć więcej o mojej randce? 💙"

# game/script.rpy:844
translate pl ch2_fa857f5d:

    # a sure "Would I LIKE to? Not necessarily."
    a sure "Czy CHCĘ? Nie, niezbyt."

# game/script.rpy:845
translate pl ch2_95d8347d:

    # w teehee "Please, Astragalus, as someone with no romance in your OWN life, the least you can do is live vicariously through me~"
    w teehee "{size=-4}Proszę, Traganko, jako ktoś z absolutnym brakiem romansu we własnym życiu, jedyne, co ci pozostało, to przeżywać te doświadczenia dzięki moim opowieściom~{/size}"

# game/script.rpy:846
translate pl ch2_8be11c8d:

    # a whatever "The no romance thing is by choice. I listen to you gush for your own damn sake."
    a whatever "Brak romansu to wybór. A słucham o twoich podbojach dla twojego własnego dobra."

# game/script.rpy:847
translate pl ch2_66b3a391:

    # w my "For MY sake?"
    w my "Dla MOJEGO dobra?"

# game/script.rpy:848
translate pl ch2_e2b9789b:

    # a sure "Yeah, I'm afraid you might actually implode if you had no one to talk to about this stuff."
    a sure "Ta, czasamu obawiam się, że mi tu implodujesz, jeśli nie pozwolę ci się wygadać."

# game/script.rpy:849
translate pl ch2_fdfc2ccd:

    # a lol "I'm actually making a noble sacrifice every day that you come in here with new tales of romantic conquest."
    a lol "Tak właściwie, to jest to wielkie poświęcenie z mojej strony, że pozwalam ci tu przychodzić z historiami rodem z nowel dla starych bab."

# game/script.rpy:850
translate pl ch2_b3b6ebb7:

    # w pout "Hmph. If you're truly suffering, I shall desist..."
    w pout "Hmph. Jeśli naprawdę przez to cierpisz, skończę..."

# game/script.rpy:851
translate pl ch2_115b6d90:

    # a smile "That's the thing, though... I DO like seeing you all worked up over something, even if I don't understand it myself."
    a smile "O to właśnie chodzi... LUBIĘ cię oglądać, kiedy coś cię tak pochłania, nawet jeśli sama tego nie rozumiem."

# game/script.rpy:852
translate pl ch2_dfd74c02:

    # w happy "Ahh, so there IS a mutual benefit! You'll listen, then? 💙"
    w happy "Ach, więc JEST tu obustronna korzyść! Posłuchasz mnie? 💙"

# game/script.rpy:853
translate pl ch2_e4b44b62:

    # a sure "Yeah, at least until I get all this put away. After that, I'm kicking you out for the day."
    a sure "Ta, przynajmniej dopóki układam towar. Jak tylko skończę, wywalam cię stąd na resztę dnia."

# game/script.rpy:855
translate pl ch2_aa202e59:

    # w calm "Fair enough. I'd better be brief, then..."
    w calm "Brzmi sprawiedliwie. Więc będę się streszczał..."

# game/script.rpy:857
translate pl ch2_c163a19e:

    # w teehee "He's the absolute cutest thing! I picked him up at a candy shop yesterday 💙"
    w teehee "Jest dosłownie najsłodszy! Znalazłem go w sklepiku ze słodyczami 💙"

# game/script.rpy:858
translate pl ch2_7ea91466:

    # w happy "Fluffy pink hair, with golden eyes, naturally rosy cheeks that make him look as if he's always a little embarrassed by something..."
    w happy "Miękkie różowe włosy, złote oczy, zarumienione policzki przez które wygląda, jakby zawsze był zawstydzony..."

# game/script.rpy:859
translate pl ch2_78bc035b:

    # w shy "He's shy, but not the type that becomes paralyzed in the bedroom--"
    w shy "Jest nieśmiały, ale nie przeszkadza mu to, by w łóżku-"

# game/script.rpy:860
translate pl ch2_e6e9e69b:

    # a augh "Periwinkle, for the last time, I do NOT need to hear about bedroom stuff." with vpunch
    a augh "Barwinek, mówię to ostatni raz, naprawdę NIE MUSZĘ znać detali o tym, co robisz w łóżku." with vpunch

# game/script.rpy:861
translate pl ch2_91bce83e:

    # w my "I wasn't giving any details!"
    w my "Ale nie dawałem ci nawet żadnych detali!"

# game/script.rpy:862
translate pl ch2_f28bb905:

    # w shy "Although, the details ARE the best part 💙"
    w shy "I wiesz, detale są najlepszą częścią tego monologu 💙"

# game/script.rpy:863
translate pl ch2_6f8d4d69:

    # a annoyed "This is a \"safe for work\" zone only. Break that rule, and you're outta here."
    a annoyed "Znajdujemy się w strefie \"safe for work\". Złam tę zasadę, wylatujesz."

# game/script.rpy:864
translate pl ch2_91ce2d8b:

    # w innocent "My apologies~ I'll refrain."
    w innocent "Przepraszam~ Powstrzymam się."

# game/script.rpy:865
translate pl ch2_dc5be651:

    # w love "Anyway, my point is... he's EXTREMELY cute. Adorable, in fact!"
    w love "Tak czy siak, chodzi o to, że... jest OKROPNIE słodki. Uroczy, powiedziałbym!"

# game/script.rpy:866
translate pl ch2_d8b497e3:

    # a eyeroll "Right, so, standard fare for you."
    a eyeroll "Ta, czyli standard."

# game/script.rpy:867
translate pl ch2_fc605430:

    # w my "Absolutely not! If he was just your average cutie, would I be emphasizing his cuteness so much?"
    w my "Absolutnie nie! Gdyby był tylko najzwyczajniejszym uroczym chłopakiem, podkreślałbym tak jego urok?"

# game/script.rpy:868
translate pl ch2_a47387c2:

    # a sure "I don't meet these people, so it's all the same to me."
    a sure "Nie spotykam się z tymi ludźmi, więc mi wszystko jedno."

# game/script.rpy:869
translate pl ch2_afb4034f:

    # w oh "How can it be~? The intensity is so drastically different... perhaps SO intense that I'm having trouble explaining it properly."
    w oh "Jak to możliwe~? Przecież intensywność jest zdecydowanie inna... możliwe, że tak wysoka, że będę miał problem z wyjaśnieniem jej."

# game/script.rpy:870
translate pl ch2_3da682aa:

    # a closed "I'll say. All you've really told me so far is that he's cute and shy."
    a closed "Przerwę ci. Jedyne, co tak naprawdę mi powiedziałeś, to że jest uroczy i nieśmiały."

# game/script.rpy:871
translate pl ch2_8e3642e4:

    # w shy "He's kind, as well! He saved the best part of our dessert for me without even asking!"
    w shy "Jest też uprzejmy! Zostawił dla mnie najlepszą część deseru, kiedy nawet o to nie prosiłem!"

# game/script.rpy:872
translate pl ch2_dfa9b85a:

    # a lol "Wow, I would've led with that one."
    a lol "Wow, to faktycznie wyjątkowy."

# game/script.rpy:873
translate pl ch2_fdbe174a:

    # w pout "Ohh, enough of your sarcasm. When all my favorite details are off-limits, what do you suppose I'm LEFT with?"
    w pout "Och, skończ z tym sarkazmem. Kiedy wszystkie ulubione detale mam pominąć, czego ode mnie oczekujesz?"

# game/script.rpy:874
translate pl ch2_ab7c305b:

    # a happy "Well, what really matters is that you had a good night. Even if it meant you couldn't get here on time like I asked."
    a happy "Cóż, liczy się to, że miło spędziłeś noc. Mimo że przez nią nie zdołałeś przyjść tu na czas."

# game/script.rpy:875
translate pl ch2_f5e62b00:

    # w love "Ahh~ I'm already hoping to see him again, to be honest..."
    w love "Ach~ Mam nadzieję, że jeszcze się z nim zobaczę, jeśli mam być szczery..."

# game/script.rpy:876
translate pl ch2_0979287d:

    # a hm "Oh yeah? Don't hear that from you very often."
    a hm "Och, serio? Nie za często to mówisz."

# game/script.rpy:877
translate pl ch2_83be95f7:

    # w oh "Really? But I've gone on second dates all the time."
    w oh "Tak? Ale cały czas chodzę na drugie randki."

# game/script.rpy:878
translate pl ch2_95f62998:

    # a lol2 "This guy got a name?"
    a lol2 "Ten ziom ma jakieś imię?"

# game/script.rpy:879
translate pl ch2_899be6dd:

    # w shy "Hmhm, I don't kiss and tell 💙"
    w shy "Hmhm, nie chwalę się romansami 💙"

# game/script.rpy:880
translate pl ch2_7b70ce89:

    # a sure "No, actually, you tell me about everyone you kiss."
    a sure "Chłopie, chwalisz się nimi cały czas."

# game/script.rpy:881
translate pl ch2_44e74989:

    # a lol "C'mon, if he's really the absolute cutest, it's a shame to keep him anonymous, right? Not like I'm gonna tell anyone anyways."
    a lol "{size=-4}No weź, jeśli naprawdę jest absolutnie najsłodszy, pozostawienie go anonimowym byłoby niesprawiedliwe, co nie? Przecież nikomu nie powiem.{/size}"

# game/script.rpy:882
translate pl ch2_cb259e44:

    # w calm "Fine... his name is Pastille."
    w calm "Dobrze.... na imię ma Pastylek."

# game/script.rpy:883
translate pl ch2_ce121fd3:

    # a annoyed "Hmph. Even his name's cute."
    a annoyed "Hmph. Nawet imię ma urocze."

# game/script.rpy:884
translate pl ch2_b434ce04:

    # w happy "Right~?"
    w happy "Co nie~?"

# game/script.rpy:885
translate pl ch2_2d463d2b:

    # w smile "Oh, that reminds me--he sold me some candies that share his name. Would you like to try?"
    w smile "Och, to mi przypomniało - sprzedał mi cukierki, z którymi dzieli imię. Zechcesz spróbować?"

# game/script.rpy:886
translate pl ch2_628745c1:

    # a happy "Sure. How could a witch turn down free candy?"
    a happy "Pewnie. Widziałeś kiedyś, żeby wiedźma nie chciała darmowych cukierków?"

# game/script.rpy:887
translate pl ch2_2ac72dd0:

    # n "Periwinkle digs into his bag and pulls out one of the pastilles."
    n "Barwinek wyciąga z torebki jedną pastylkę."

# game/script.rpy:888
translate pl ch2_c90345e5:

    # n "He hands the candy to Astragalus, who promptly unwraps it and pops it into her mouth."
    n "Podaje ją Tragance, która prędko wyciąga ją z papierka i wkłada w usta."

# game/script.rpy:889
translate pl ch2_e3dc6cdf:

    # a hm "Mmf... Oh, these are GOOD. Where'd you say this candy shop was?"
    a hm "Mmf... Och, to jest DOBRE. Gdzie ten sklep?"

# game/script.rpy:890
translate pl ch2_6e7c54dc:

    # w happy "Not far from here! I'll give you directions..."
    w happy "Niedaleko! Pokażę ci drogę..."

# game/script.rpy:897
translate pl ch2_58993334:

    # "Shortly after telling Astragalus where to find Atelier Sweets, she unceremoniously kicked me out..."
    "Kiedy tylko powiedziałem Tragance, jak dotrzeć do Atelier Sweets, bezceremonialnie mnie wykopała..."

# game/script.rpy:898
translate pl ch2_7f4ee160:

    # "She'd long finished putting all those bottles away, after all."
    "I tak już dawno temu skończyła układać wszystkie te butelki."

# game/script.rpy:899
translate pl ch2_d635dbff:

    # "With money in my pocket, and no more work to be done for the moment... I'm free to begin pursuing my next date~"
    "Z pieniędzmi w kieszeni i mnóstwem wolnego czasu... mogę spokojnie zacząć poszukiwania kolejnego partnera~"

# game/script.rpy:900
translate pl ch2_a4f99886:

    # nvl clear
    # "But wherever shall I go? It's a weekday, too early for parties, too early for drinks..."
    nvl clear
    "Ale gdzie mam iść? Jest dzień roboczy, za wcześnie na imprezy, za wcześnie na picie..."

# game/script.rpy:902
translate pl ch2_1e5385aa:

    # "I suppose I could return home and straighten up the place. However..."
    "Chyba mógłbym wrócić do domu i trochę posprzątać. Ale..."

# game/script.rpy:903
translate pl ch2_801baa18:

    # nvl clear
    # w calm "(Why would I busy myself with chores when I could be celebrating another order successfully filled?)"
    nvl clear
    w calm "(Po co mam zawracać sobie głowę obowiązkami, kiedy mogę uczcić kolejne skończone zamówienie?)"

# game/script.rpy:906
translate pl ch2_7123d8ef:

    # n "Before Periwinkle can decide on where to go, a familiar witch approaches him."
    n "Nim Barwinek dokonuje wyboru, znajduje go znajoma czarownica."

# game/script.rpy:909
translate pl ch2_a7e53e02:

    # c "Periwinkle...?"
    c "Barwinek...?"

# game/script.rpy:910
translate pl ch2_ed8e4bc5:

    # w happy "Ohh, Cassia! So lovely to see you~"
    w happy "Och, Cassia! Tak miło cię widzieć."

# game/script.rpy:911
translate pl ch2_cca6951a:

    # c happy "Yay, I'm so glad we ran into each other~"
    c happy "Jej, tak się cieszę, że na ciebie wpadłam~"

# game/script.rpy:913
translate pl ch2_18cfade9:

    # "How to describe Cassia..."
    "Jak mam opisać Cassię..."

# game/script.rpy:914
translate pl ch2_0c67f0a0:

    # "She's exceedingly cuddly. We met at a party one night, during which she latched onto my arm and never let go. Quite endearing!"
    "Jest niezmiernie przytulaśna. Spotkaliśmy się kiedyś na imprezie, podczas której złapała moje ramię i już nigdy go nie puściła. Doprawdy ujmujące!"

# game/script.rpy:915
translate pl ch2_6535f464:

    # "Since then, we've gone on little dates from time to time..."
    "Od tamtego czasu często chodzimy na małe randki..."

# game/script.rpy:916
translate pl ch2_91a4c39c:

    # "She really loves my magic, so I tend to spoil her whenever we're together 💙"
    "Naprawdę uwielbia moją magię, więc często ją rozpieszczam, gdy się spotykamy 💙"

# game/script.rpy:917
translate pl ch2_fc9d5dc6:

    # nvl clear
    # w smile "Did you need something, dear?"
    nvl clear
    w smile "Potrzebujesz czegoś, skarbie?"

# game/script.rpy:920
translate pl ch2_7206142c:

    # c aww "Ah, yes! I tried coming over last night, but you didn't seem to be home..."
    c aww "Ach, tak! Byłam u ciebie zeszłej nocy, ale chyba nie było cię w domu..."

# game/script.rpy:921
translate pl ch2_693e007a:

    # w shy "Aww, you came to visit me? I'm flattered 💙"
    w shy "Och, złożyłaś mi wizytę? Jestem zaszczycony 💙"

# game/script.rpy:922
translate pl ch2_399869f1:

    # w smile "I must've been out to dinner at the time... Sorry that I missed you~"
    w smile "Musiałem być na kolacji... Przepraszam, że się minęliśmy~"

# game/script.rpy:923
translate pl ch2_2f0adf6c:

    # c smile "Oh, it's okay~ I was mostly looking to talk..."
    c smile "Och, nie ma sprawy~ Chciałam tylko porozmawiać..."

# game/script.rpy:924
translate pl ch2_c9ba5380:

    # c aww "So, um, if you're available right now... do you wanna go to a café?"
    c aww "Więc, um, jeśli masz teraz czas... chcesz iść na kawę?"

# game/script.rpy:925
translate pl ch2_d5996b44:

    # w innocent "That sounds perfect! I would love to."
    w innocent "Brzmi świetnie! Propozycja przyjęta."

# game/script.rpy:931
translate pl ch2_e516a126:

    # "We take our seats at the nearby café."
    "Siadamy przy stoliku w pobliskiej kawiarni."

# game/script.rpy:932
translate pl ch2_07ec8f7d:

    # "It's a pleasant, sunny little place. I've come here often with all sorts of other witches."
    "To miłe, słoneczne miejsce. Często tu przychodzę z innymi czarodziejami i czarownicami."

# game/script.rpy:933
translate pl ch2_798bacd1:

    # "Cassia orders her usual hot chocolate with extra marshmallows, while I decide on a simple rose tea."
    "Cassia zamawia swoją ulubioną gorącą czekoladę z dodatkowymi piankami, a ja decyduję się na zwykłą różaną herbatę."

# game/script.rpy:934
translate pl ch2_13febc5a:

    # nvl clear
    # c oh "Ooh, Periwinkle, could you make my marshmallows smell like roses, too?"
    nvl clear
    c oh "Och, Barwinek, a możesz zrobić tak, żeby moje pianki też pachniały różami?"

# game/script.rpy:937
translate pl ch2_e1d1de4a:

    # w innocent "With pleasure 💙"
    w innocent "Z przyjemnością 💙"

# game/script.rpy:938
translate pl ch2_d7d93e12:

    # n "Periwinkle's wand drops from his sleeve, and he gives Cassia's cup a quick little tap."
    n "Różdżka Barwinka wysuwa się z jego rękawa, a następnie stuka delikatnie o kubek Cassii."

# game/script.rpy:939
translate pl ch2_9343669f:

    # c happy "Eheh, yay~ It really smells just like roses~!"
    c happy "Eheh, jej~ Naprawdę pachną jak róże~!"

# game/script.rpy:940
translate pl ch2_790200db:

    # w smile "Just as you asked, dear. It may slightly affect the taste, so let me know if you'd like the spell undone."
    w smile "O to prosiłaś, kochana. Może to wpłynąć na smak, więc daj mi znać, jeśli chcesz, bym zdjął czar."

# game/script.rpy:942
translate pl ch2_51b79206:

    # n "Cassia dips her spoon in and lifts a marshmallow to her lips, blowing on it lightly before popping it into her mouth."
    n "Cassia zamacza swoją łyżeczkę i podnosi jedną piankę do ust, dmuchając na nią lekko, po czym wkłada ją do buzi."

# game/script.rpy:943
translate pl ch2_bb00d05f:

    # c happy "Mmf... no, it's wonderful! Ehehe~ 🤎"
    c happy "Mmf... Nie, jest super! Ehehe~ 🤎"

# game/script.rpy:946
translate pl ch2_88501500:

    # "She truly can find the joy in any little moment. Such a delight..."
    "Naprawdę potrafi odnaleźć szczęście w każdym momencie. Rozkoszna..."

# game/script.rpy:947
translate pl ch2_28e04d59:

    # "Definitely a contender for the title of absolute cutest witch. Though I would call her... absolutely cute, rather than the absolute cutest."
    "Zdecydowanie silny zawodnik w konkursie o tytuł absolutnie najsłodszej czarownicy. Ale ja raczej... nazwałbym ją absolutnie słodką, nie najsłodszą."

# game/script.rpy:948
translate pl ch2_22a82a32:

    # "It takes more than cuteness alone to earn the title of absolute cutest witch! That's where the difference lies, of course."
    "By nosić tytuł najsłodszej, potrzeba czegoś więcej niż samej słodkości! To robi wielką różnicę, oczywiście."

# game/script.rpy:949
translate pl ch2_1167b98f:

    # nvl clear
    # "But what am I thinking? How rude it is, to begin ranking my dates in such a way."
    nvl clear
    "Ale o czym ja myślę? To bardzo niemiłe, by tak klasyfikować osoby, z którymi się spotykam."

# game/script.rpy:951
translate pl ch2_89364570:

    # "I must be stuck on the thought from my earlier conversation with Astragalus... trying to put Pastille's cuteness into words."
    "Moje myśli chyba zacięły się na wcześniejszej rozmowie z Traganką... i próbują wyrazić słowami urok Pastylka."

# game/script.rpy:952
translate pl ch2_f14542af:

    # "He really is something special... ah, it's all in the contrast! His polite, well-mannered and proper exterior, concealing such intense desire, begging you to make the first move, and then going ahead and taking it on his own as soon as you--"
    "Naprawdę jest wyjątkowy... Ach, tu chodzi o kontrast! O to, jaki jest uprzejmy, ułożony i porządny na zewnątrz, co ukrywa pragnienie, wręcz błaga cię o pierwszy ruch, a potem się odważa i bierze sprawy w swoje ręce, gdy tylko-"

# game/script.rpy:953
translate pl ch2_d02f8f43:

    # nvl clear
    # w oops "(...Enough of that! There's someone else in front of me now, isn't there?)" with vpunch
    nvl clear
    w oops "(...Koniec z tym! Mam przed sobą kogoś innego, prawda?)" with vpunch

# game/script.rpy:956
translate pl ch2_84a03c6d:

    # n "Cassia continues happily sipping her hot chocolate before speaking up again."
    n "Cassia z radością pije swoją gorącą czekoladę, nim znowu zabiera głos."

# game/script.rpy:958
translate pl ch2_4958d936:

    # c aw "Ahh, I missed you, Periwinkle~ I've been so busy with packing, I haven't had a chance to see you at all..."
    c aw "Ach, stęskniłam się, Barwinku~ Byłam tak zajęta pakowaniem się, nie miałam ani chwili wolnego czasu, by się z tobą zobaczyć..."

# game/script.rpy:959
translate pl ch2_15a35145:

    # w my "Packing? And just where are you headed off to?"
    w my "Pakowaniem? A gdzież to się udajesz?"

# game/script.rpy:960
translate pl ch2_959ab161:

    # c oh "Oh, that's right! I never had a chance to tell you~"
    c oh "Och, racja! Nie powiedziałam ci~"

# game/script.rpy:961
translate pl ch2_28a09411:

    # c happy "I'm finally moving in with my partners~! In two more days, the three of us will all be sleeping in the same bed~ 🤎"
    c happy "Nareszcie wprowadzam się do moich partnerów~! Już za dwa dni nasza trójka będzie szczęśliwie spać w jednym łóżku~ 🤎"

# game/script.rpy:962
translate pl ch2_1b9c5f18:

    # w happy "Ooh, that sounds cozy~ Congratulations!"
    w happy "Och, brzmi przytulnie~ Gratulacje!"

# game/script.rpy:963
translate pl ch2_937fc8b0:

    # c aww "Ehe, thank you~ 🤎 I've looked forward to it for so long..."
    c aww "Ehe, dzięki 🤎 Tak długo na to czekałam..."

# game/script.rpy:964
translate pl ch2_aae442de:

    # w smile "It sounds like you're about to enter a lovely domestic life. You deserve it!"
    w smile "Wygląda na to, że jesteś u progu idealnego życia. Zasługujesz na to!"

# game/script.rpy:965
translate pl ch2_f5692979:

    # c "Aww, hehehe... I'm really happy."
    c "Ooo, hehehe... Tak się cieszę."

# game/script.rpy:966
translate pl ch2_d2fabfa3:

    # c oh "But, um... speaking of my partners. You've still never even met them..."
    c oh "Ale, um... skoro mowa o partnerach. Jeszcze ich nie spotkałeś..."

# game/script.rpy:967
translate pl ch2_f5612c00:

    # w calm "True. But I can imagine they're wonderful, just from how you've talked about them."
    w calm "Prawda. Ale wyobrażam sobie, że są przewspaniali, tyle wywnioskowałem z tego, co o nich opowiadasz."

# game/script.rpy:968
translate pl ch2_f82c96ac:

    # c aww "Right~ but, um... what if you didn't have to imagine?"
    c aww "Pewnie~ ale, um... co, jeśli nie musiałbyś sobie wyobrażać?"

# game/script.rpy:969
translate pl ch2_add80a4e:

    # c smile "That's what I've been wanting to talk to you about. I was hoping... we might all be able to go on a group date sometime!"
    c smile "O tym właśnie chciałam z tobą porozmawiać. Miałam nadzieję, że... moglibyśmy kiedyś wszyscy przejść się na randkę!"

# game/script.rpy:970
translate pl ch2_c81c387b:

    # w oh "Oh~?"
    w oh "Och~?"

# game/script.rpy:971
translate pl ch2_8b6f2fb7:

    # c aw "Yeah~! Because, like... I just think you're so wonderful, Periwinkle. I want them to know you, too!"
    c aw "Tak~! Bo, jakby... myślę, że jesteś taki świetny, Barwinek. Chcę, żeby oni też o tym wiedzieli!"

# game/script.rpy:972
translate pl ch2_40b31e80:

    # w sorry "Mm... although it sounds like fun, I'm a bit..."
    w sorry "Mm... Brzmi dobrze, lecz jestem odrobinę..."

# game/script.rpy:973
translate pl ch2_7122e72f:

    # c please "W-wait, before you say no...!"
    c please "Chwila, z-zanim odmówisz...!"

# game/script.rpy:974
translate pl ch2_b6456ff5:

    # c "They're both very easygoing, and so loving, and nice...! I can promise it won't be overwhelming..."
    c "Obydwoje są wyrozumiali i kochani i tacy, tacy mili...! Obiecuję, że nie będzie przytłaczająco..."

# game/script.rpy:975
translate pl ch2_62b54e38:

    # w decline "That unfortunately isn't where the issue lies, my dear..."
    w decline "Niestety, to nie w tym problem, moja droga..."

# game/script.rpy:976
translate pl ch2_bb65f581:

    # c sad "I-I know you said you didn't want to get involved before... but I just know that we would all get along so well!"
    c sad "W-wiem, że mówiłeś, że nie chcesz się w nic mieszać... ale wiem też, że spokojnie byś się z nimi dogadał, tak jak ze mną!"

# game/script.rpy:977
translate pl ch2_9db7f2b9:

    # c "I'd like to reassure you however I can. But I understand if you still turn me down..."
    c "Chcę cię w tym upewnić jak tylko mogę. Ale zrozumiem, jeśli odmówisz..."

# game/script.rpy:979
translate pl ch2_99af5b21:

    # "Matters of love are so tricky, aren't they?"
    "Sprawy miłosne są tak skomplikowane, czyż nie?"

# game/script.rpy:980
translate pl ch2_b7229a67:

    # "I still recall the first time something like this was asked of me..."
    "Nadal pamiętam pierwszy raz, gdy zapytano mnie o coś takiego..."

# game/script.rpy:981
translate pl ch2_70f4d8cb:

    # "I had been nervous going in, but I had also never entered a group situation before. I attributed my anxiety solely to that."
    "Wchodząc w to byłem bardzo zestresowany, ale nigdy wcześniej nie byłem w związku z więcej niż jedną osobą. Przypisałem swoją niepewność właśnie temu."

# game/script.rpy:982
translate pl ch2_5aaf6eab:

    # "However, it quickly became clear that I just wasn't suited to it at all..."
    "Jednak szybko okazało się, że po prostu nie dla mnie takie związki..."

# game/script.rpy:983
translate pl ch2_92e49d6c:

    # nvl clear
    # "I do love to spoil each of my partners--but strictly one at a time."
    nvl clear
    "Kocham rozpieszczać swoich partnerów - lecz tylko jednego na raz."

# game/script.rpy:985
translate pl ch2_13099713:

    # "Perhaps I was left scarred by the breakdown in communication, the passionate fires of a long-established romance..."
    "Może niejasny podział komunikacji pozostawił na mnie blizny, pasjonujący ogień długoletniej relacji zgaszony..."

# game/script.rpy:986
translate pl ch2_000f6a86:

    # "Surely Cassia and her partners are magnificent people. It may indeed be fun for a night."
    "Cassia i jej partnerzy to na pewno wspaniałe osoby. Jedna noc nikomu nie zaszkodzi."

# game/script.rpy:987
translate pl ch2_e1d8cf3a:

    # "But becoming entangled in committed relationships is something I've always avoided from the beginning, isn't it?"
