# game/script.rpy:2385
translate pl ch5_a61feed8:

    # "But soon, the shopkeeper comes to my aid."
    "Na szczęście na ratunek przychodzi mi sprzedawczyni."

# game/script.rpy:2386
translate pl ch5_76b2fe88:

    # nvl clear
    nvl clear

