# game/script.rpy:430
translate pl start_1fb598dd:

    # w smile "Next, expectations. I consider clarity in this regard to be a key part of ensuring we both enjoy ourselves to the fullest."
    w smile "Po drugie, oczekiwania. Uważam, że rozjaśnienie wszelkich niepewności w tym obszarze stanowi podstawę silnej relacji."

# game/script.rpy:431
translate pl start_9ddac06c:

    # w "I do this sort of thing often, you see. As such, I have a couple of ground rules to establish."
    w "Dosyć często to robię, rozumiesz. Dlatego też mam kilka podstawowych zasad."

# game/script.rpy:433
