    w oh "Och?"

# game/script.rpy:435
translate pl start_140c840a:

    # p ehe "I'm not looking for anything serious. In fact, I kinda prefer when it's just a one-night thing..."
    p ehe "Nie szukam niczego na dłużej. Właściwie to wolałbym, by to było tylko... na jedną noc..."

# game/script.rpy:436
