translate pl ch5_acc12d29:

    # "It's precisely as that temperamental little witch said: if I stop thinking about him, the problem will resolve on its own 💙"
    "To dokładnie tak jak stwierdziła tamta temperamentna mała wiedźma: jeśli przestanę o nim myśleć, problem sam się rozwiąże 💙"

# game/script.rpy:2452
translate pl ch5_e74671f6:

    # nvl clear
    # "And so... I must take a few days to focus on myself!"
    nvl clear
    "Więc... potrzebuję kilku dni, by skupić się na sobie!"

# game/script.rpy:2454
translate pl ch5_b149db3c:

    # "At least until I can find my way out of this odd state I've ended up in...."
    "Przynajmniej do czasu, gdy odnajdę sposób, jak uwolnić się z tego dziwnego stanu, w który się wprowadziłem..."

# game/script.rpy:2455
translate pl ch5_76b2fe88_1:

    # nvl clear
    nvl clear

