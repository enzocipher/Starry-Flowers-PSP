# game/script.rpy:615
translate pl start_c0d59d1c:

    # "So that's how it is, hm~?"
    "Więc o to chodzi, hm~?"

# game/script.rpy:616
translate pl start_7db31c84:

    # "I'm being treated to a more intimate side of this witch boy right now 💙"
    "Ten czarodziej właśnie ukazuje mi swoją intymną stronę 💙"

# game/script.rpy:617
translate pl start_ca35036d:

    # "We walk together under the street lights, until we reach our original meeting place..."
    "Spacerujemy tak pod latarniami aż docieramy do miejsca naszego spotkania..."

# game/script.rpy:618
translate pl start_76b2fe88_8:

    # nvl clear
    nvl clear

