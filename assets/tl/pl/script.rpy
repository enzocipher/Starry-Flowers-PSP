# game/script.rpy:505
translate pl start_0c12172a:

    # w love "(I did say I'd go a little easier on him, didn't I...? Ah, he's just too irresistible 💙)"
    w love "(Mówiłem, że będę go traktować łagodniej, czyż nie...? Ach, ale jest wprost nieodparty 💙"

# game/script.rpy:507
translate pl start_41bfaa4f:

    # w calm "Anywho... I bottle and sell scents like this one. It's fairly lucrative work, once you build a reputation for yourself."
    w calm "Tak czy siak... Butelkuję i sprzedaję takie zapachy. Jest to opłacalny zawód, jeśli tylko zdobędziesz dobrą reputację."

# game/script.rpy:508
translate pl start_9b95030e:

    # p oh "Ah... sounds fulfilling."
    p oh "Ach... brzmi satysfakcjonująco."

# game/script.rpy:509
translate pl start_df636102:

    # w smile "What about you, Pastille? What kind of magic do you specialize in?"
    w smile "A ty, Pastylku? W jakim rodzaju magii się specjalizujesz?"

# game/script.rpy:510
translate pl start_acfb287e:

    # p shy "Oh, I... I had mostly been living without magic, until recently."
    p shy "Och, więc... do niedawna żyłem jeszcze całkiem bez magii."

# game/script.rpy:511
translate pl start_ba1cda83:

    # w oh "Without magic...? I can't imagine."
    w oh "Bez magii...? Nie umiem sobie tego nawet wyobrazić."

# game/script.rpy:512
translate pl start_39cda655:

    # p smile "It's not so bad. I mean, humans do it, so why not?"
    p smile "Nie było tak źle. Znaczy, ludzie tak żyją, więc czemu nie?"

# game/script.rpy:513
translate pl start_1b160ca1:

