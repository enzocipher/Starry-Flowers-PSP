translate pl ch6_fcf147cb:

    # "I held Pastille's hand in the end, I remember that. He had been so nervous, I could practically hear his heart beating out of his chest..."
    "Pamiętam, że na samym końcu złapałem Pastylka za rękę. Był tak zestresowany, że praktycznie słyszałem, jak jego serce próbuje uciec z klatki piersiowej..."

# game/script.rpy:3183
translate pl ch6_76b2fe88_6:

    # nvl clear
    nvl clear

# game/script.rpy:3185
translate pl ch6_c267c7e4:

    # "I hadn't understood just how stressful it would be for him."
    "Nie wiedziałem, jak bardzo stresujące to dla niego będzie."

# game/script.rpy:3186
translate pl ch6_193283c6:

    # "I felt guilty at having put him through it, although the idea was his to begin with."
    "Czułem się winny jako sprawca, mimo że to był jego pomysł."

# game/script.rpy:3187
translate pl ch6_91dcf0bc:

    # "He decided to go through that... for himself? Or for me?"
    "Postanowił przez to przejść... dla siebie? Czy dla mnie?"

# game/script.rpy:3188
translate pl ch6_78813798:

    # "This seemingly mundane interaction that meant so much more for the both of us...."
    "Oto ta pozornie najzwyklejsza interakcja, która dla naszej dwójki znaczyła o wiele więcej..."

# game/script.rpy:3189
translate pl ch6_76b2fe88_7:

    # nvl clear
    nvl clear

# game/script.rpy:3191
translate pl ch6_d5c67421:

    # p "...."
    p "..."

# game/script.rpy:3192
translate pl ch6_b375b5a9:

    # w love "Pastille...?"
    w love "Pastylku...?"

# game/script.rpy:3193
translate pl ch6_7d1ba007:

    # p ehe2 "Sorry. I'm okay."
    p ehe2 "Przepraszam. Wszystko w porządku."

# game/script.rpy:3194
translate pl ch6_555a4581:

    # p embarrassed "I feel stupid having made such a big deal of it... of course it all turned out just fine...."
    p embarrassed "Czuję się głupio, że robiłem z tego taką aferę... Oczywiście, że wszystko skończyło się pomyślnie..."

# game/script.rpy:3195
translate pl ch6_871b9d05:

    # w calm "It was important to you. We all get worked up over things we care about, don't we?"
    w calm "To było dla ciebie ważne. Mamy tendencję do przejmowania się rzeczami, na których nam zależy, nieco za bardzo, czyż nie?"

# game/script.rpy:3196
translate pl ch6_e65a7757:

    # p shy "A-are you including yourself in that? You seem like you always have it together...."
    p shy "C-co masz na myśli mówiąc, że MAMY? Wydawało mi się, że świetnie sobie radzisz w takich sytuacjach..."

# game/script.rpy:3197
translate pl ch6_0135eb0d:

    # w happy "Ohh, am I hiding it THAT well~?"
    w happy "Och, aż tak dobrze to ukrywam~?"

# game/script.rpy:3198
translate pl ch6_e3e6d0c0:

    # p ehe "Haha, anyway... um, we can go...."
    p ehe "Haha, nieważne... Um, możemy iść..."

# game/script.rpy:3200
translate pl ch6_23c6df31:

    # w smile "...."
    w smile "..."

# game/script.rpy:3201
translate pl ch6_026080f9:

    # w ohdear "(How is he going to react when he discovers what a mess I've been...?)"
    w ohdear "(Jak zareaguje, gdy dowie się, w jakiej rozsypce byłem jeszcze niedawno...?)"

# game/script.rpy:3204
translate pl ch6_6537e332:

    # "Pastille walks me home, and promises to return later tonight."
    "Pastylek odprowadza mnie do domu z obietnicą, że później mnie odwiedzi."

# game/script.rpy:3205
translate pl ch6_49b208d4:

    # "Things will move forward from there, won't they? Or is it too soon...?"
    "Stąd wszystko pójdzie jak z górki, prawda? Czy to za wcześnie...?"

# game/script.rpy:3206
translate pl ch6_2cc88408:

    # "Maybe it's too much for one day! I don't want to add to his stress...."
    "Może to za wiele na jeden dzień! Nie chcę stresować go jeszcze bardziej..."

# game/script.rpy:3207
translate pl ch6_1dc0c4c0:

    # nvl clear
    # w oops "(Ugh... why is this so difficult...?)"
    nvl clear
    w oops "(Ugh... Czemu to takie ciężkie...?)"

# game/script.rpy:3209
translate pl ch6_b84eb580:

    # w conflicted "(His perception of me could be completely destroyed! Tarnished!)"
    w conflicted "(To, jak mnie postrzega może na zawsze się zmienić! Zniszczyć!)"

# game/script.rpy:3210
translate pl ch6_d13ffbb7:

    # w sorry "(But that's a risk worth taking... isn't it...?)"
    w sorry "(Ale warto podjąć ryzyko... Prawda...?)"

# game/script.rpy:3219
translate pl ch6_dad1a362:

    # n "That night... Periwinkle laid on the floor in the middle of his living room and waited."
    n "Tej nocy... Barwinek leżał na środku swojego salonu i czekał."

# game/script.rpy:3221
translate pl ch6_83701cac:

    # w shutin neutral "...."
    w shutin neutral "..."

# game/script.rpy:3222
translate pl ch6_82a844cb:

    # w empty "(I'd expected this night to come eventually, and yet... I still don't feel any more prepared for it.)"
    w empty "(Wiedziałem, że ta noc prędzej czy później nadejdzie, a jednak... Jednak nadal nie czuję się na nią gotowy.)"

# game/script.rpy:3224
translate pl ch6_0b065d30:

    # n "Periwinkle idly taps his wand to one of the candles on the table."
    n "Barwinek leniwie stuka swoją różdżką o jedną ze świeczek na stoliku."

# game/script.rpy:3225
translate pl ch6_b971b49b:

    # w shutin oops "...Still peachy. The curse is not yet lifted."
    w shutin oops "...Dalej brzoskwinie. Klątwa dalej na mnie ciąży."

# game/script.rpy:3227
translate pl ch6_b7ed660b:

    # n "Pastille's knock finally comes, and Periwinkle rises to answer."
    n "Nareszcie w domu rozlega się pukanie do drzwi, a Barwinek biegnie, by przywitać gościa."

# game/script.rpy:3233
translate pl ch6_7f645bd4:

    # p "Oh, it smells nice in here. Is that your magic?"
    p "Och, bardzo ładnie tu pachnie. To twoja magia?"

# game/script.rpy:3234
translate pl ch6_c6202711:

    # w shutin innocent "You like it? It's my latest specialty 💙"
    w shutin innocent "Podoba ci się? To moja ostatnia specjalność 💙"

# game/script.rpy:3235
translate pl ch6_d842efac:

    # p happy "Aww, what a treat!"
    p happy "Och, cóż za zaszczyt!"

# game/script.rpy:3237
translate pl ch6_2d39236d:

    # p smile "Have you eaten yet? I could make us a special dinner."
    p smile "Jadłeś już? Mógłbym przygotować równie specjalną kolację."

# game/script.rpy:3238
translate pl ch6_43c03053:

    # w my "Oh~ what's the occasion?"
    w my "Och~ Z jakiej okazji?"

# game/script.rpy:3239
translate pl ch6_cdb2e25e:

    # p ehe "Celebrating the fact nothing went horribly wrong today. I brought a few things, if I could just borrow your stove..."
    p ehe "Z takiej, że dziś wszystko poszło po mojej myśli. Kupiłem kilka rzeczy, gdybyś użyczł mi swojej kuchenki..."

# game/script.rpy:3240
translate pl ch6_ccea5b7d:

    # w innocent "By all means~"
    w innocent "Proszę bardzo~"

# game/script.rpy:3243
translate pl ch6_b1a59605:

    # "I once again found myself in the excruciatingly domestic situation of watching Pastille prepare a meal in my kitchen."
    "Znów znalazłem się w straszliwie domowej sytuacji, oglądając Pastylka przygotowującego danie w mojej kuchni."

# game/script.rpy:3244
translate pl ch6_27f276dd:

    # "There's no way he doesn't realize it, right? That we've been acting as a couple for a long time now..."
    "Nie ma opcji, że nie zdaje sobie z tego sprawy, prawda? Że już od dawna zachowujemy się jak para..."

# game/script.rpy:3245
translate pl ch6_64b1117b:

    # "It's just that neither of us have bothered to address it."
    "Tylko żadne z nas nie czuło potrzeby zauważenia tego."

# game/script.rpy:3246
translate pl ch6_11c05150:

    # "Shouldn't it be properly acknowledged...?"
    "Nie powinniśmy się do tego jakoś odnieść...?"

# game/script.rpy:3247
translate pl ch6_a15243f7:

    # nvl clear
    # "Pastille chats with me as he cooks, but I'm admittedly distracted by these thoughts."
    nvl clear
    "Pastylek opowiada mi coś podczas gotowania, ale jestem zbyt rozproszony tymi myślami."

# game/script.rpy:3249
translate pl ch6_8b6ec33b:

    # "Perhaps putting a name to it would only cause it to unravel..."
    "Może nazwanie jakkolwiek naszej relacji jedynie skomplikowałoby sprawę..."

# game/script.rpy:3250
translate pl ch6_fed127ba:

    # "Currently, there's no expectation. We're free to see whoever else we like."
    "Na chwilę obecną nie mamy wobec siebie żadnych oczekiwań. Możemy widywać się z kim zechcemy."

# game/script.rpy:3251
translate pl ch6_588f3995:

    # "Though... it doesn't seem either of us are doing that."
    "Ale... nie wygląda na to, by którykolwiek z nas korzystał z tej wolności."

# game/script.rpy:3252
translate pl ch6_7d13798e:

    # nvl clear
    # n "Pastille approaches the table where Periwinkle sits, holding a plate in each hand."
    nvl clear
    n "Pastylek podchodzi do stołu, przy którym siedzi Barwinek, trzymając w każdej ręce po talerzu."

# game/script.rpy:3258
translate pl ch6_45d7faef:

    # p "Ta-da~ Pasta's ready."
    p "Ta-da~ Makaron gotowy."

# game/script.rpy:3259
translate pl ch6_10cdcc29:

    # w shutin happy "Ooh, bon appétit 💙"
    w shutin happy "Ooch, bon appétit 💙"

# game/script.rpy:3262
translate pl ch6_0e94caa2:

    # "Maybe he's already decided we're a couple, and I'm just obsessing over formalities."
    "Może już zadecydował, że jesteśmy w związku, a ja niepotrzebnie zawracam sobie głowę formalnościami."

# game/script.rpy:3263
translate pl ch6_b80eb0a1:

    # "What does it matter, so long as the two of us are happy?"
    "Kogo to obchodzi, o ile jesteśmy szczęśliwi?"

# game/script.rpy:3264
translate pl ch6_e81d99d4:

    # "And I really AM happy..."
    "Bo na pewno jestem szczęśliwy..."

# game/script.rpy:3265
translate pl ch6_a91d3dfd:

    # "His cooking... tastes wonderful...."
    "Jego jedzenie... smakuje wspaniale..."

# game/script.rpy:3266
translate pl ch6_76b2fe88_8:

    # nvl clear
    nvl clear

# game/script.rpy:3269
translate pl ch6_41880f7f:

    # p "...Peri? You okay?"
    p "...Inek? Wszystko okej?"

# game/script.rpy:3270
translate pl ch6_94ce811b:

    # w shutin ah "Hm? Yes...?"
    w shutin ah "Hm? Tak...?"

# game/script.rpy:3271
translate pl ch6_a057a474:

    # p ehe "You were being so quiet, I started to worry that I messed up our dinner somehow..."
    p ehe "Milczysz od dłuższego czasu, zacząłem się martwić, że jedzenie ci nie smakuje..."

# game/script.rpy:3272
translate pl ch6_05d526a2:

    # w guilty "No, no... it's delicious!"
    w guilty "Nie, nie... Jest przepyszne!"

# game/script.rpy:3273
translate pl ch6_8f95049d:

    # w smile "I was just lost in the pasta, is all. Forgive me, I didn't mean to worry you."
    w smile "Zatraciłem się w makaronie, to wszystko. Wybacz, nie chciałem cię martwić."

# game/script.rpy:3276
translate pl ch6_bc3ffb32:

    # "I need to get out of my own head."
    "Muszę wyjść z własnej głowy."

# game/script.rpy:3277
translate pl ch6_4781f2a1:

    # "Pastille is here in front of me! And I'm too distracted to savor it...!"
    "Pastylek jest tu, przede mną! A ja jestem zbyt rozproszony, by z tego korzystać...!"

# game/script.rpy:3278
translate pl ch6_36793aff:

    # "Forget my doubts. We'll just have to see where the night takes us..."
    "Zapomnijmy o wątpliwościach. Zobaczymy, jak potoczy się noc..."

# game/script.rpy:3279
translate pl ch6_8abc74f1:

    # nvl clear
    # n "Periwinkle takes his plate to the sink and begins to wash up."
    nvl clear
    n "Barwinek zabiera swój talerz do zlewu i zaczyna go myć."

# game/script.rpy:3283
translate pl ch6_3e0f9893:

    # p wha "Ah--I can take care of that!"
    p wha "Ach- Ja mogę się tym zająć!"

# game/script.rpy:3284
translate pl ch6_e738bebe:

    # w love "Nonsense, you just cooked us dinner! It's your turn to relax, my sweet 💙"
    w love "Nonsens, ugotowałeś obiad! Teraz twoja kolej na relaks, mój drogi 💙"

# game/script.rpy:3285
translate pl ch6_56c4b6d1:

    # p shy "Are you sure I can't help...? I wouldn't mind at all...."
    p shy "Na pewno nie mogę pomóc...? Nie przeszkadzałoby mi to..."

# game/script.rpy:3286
translate pl ch6_bc36cfb7:

    # w calm "You can help by bringing me your plate when you're finished."
    w calm "Możesz pomóc przynosząc mi talerz, gdy skończysz jeść."

# game/script.rpy:3287
translate pl ch6_c83acea9:

    # p ehe "Okaaay...."
    p ehe "Okeeeej..."

# game/script.rpy:3290
translate pl ch6_4911fe5a:

    # n "Pastille does as he's told, then wanders over to the couch."
    n "Pastylek tak właśnie robi, po czym siada na kanapie."

# game/script.rpy:3293
translate pl ch6_e34ed609:

    # p "Hey, um..."
    p "Hej, um..."

# game/script.rpy:3294
translate pl ch6_fe1d1ce2:

    # p "If you have anyone you want to introduce me to, I'd be happy to meet them. Return the favor, sort of thing."
    p "Jeśli chciałbyś mnie komuś przedstawić, z chęcią go poznam. By się zrewanżować, w pewnym sensie."

# game/script.rpy:3296
translate pl ch6_bbf226dc:

    # p "I-I know it can be awkward though, so... if not, that's okay too...."
    p "A-ale wiem, że to może być trochę niezręczne, więc... jeśli nie chcesz, nie ma sprawy..."

# game/script.rpy:3297
translate pl ch6_6753e7b3:

    # w "Hm... no, no one comes to mind."
    w "Hm... Nie, nikt taki nie przychodzi mi do głowy."

# game/script.rpy:3298
translate pl ch6_a367466f:

    # p "...Huh? Really?"
    p "...Hm? Naprawdę?"

# game/script.rpy:3299
translate pl ch6_6e2dd70d:

    # w "Sure, I know a lot of people. But I couldn't say I'm particularly close with any of them..."
    w "Pewnie, znam wielu ludzi, ale nie powiedziałbym, że z kimkolwiek jestem bardzo blisko..."

# game/script.rpy:3301
translate pl ch6_8585d2d5:

    # w "Except maybe one? But you've already met my business partner."
    w "Oprócz jednej osoby, ale już poznałeś moją partnerkę biznesową."

# game/script.rpy:3302
translate pl ch6_0aad42dd:

    # p "Oh! At the apothecary, right?"
    p "Och! W aptece, tak?"

# game/script.rpy:3304
translate pl ch6_05485f5a:

    # w "Precisely."
    w "Dokładnie."

# game/script.rpy:3305
translate pl ch6_d5c67421_1:

    # p "...."
    p "..."

# game/script.rpy:3307
translate pl ch6_01f6d082:

    # w "Hm~? What's with that look."
    w "Hm~? Co to za mina?"

# game/script.rpy:3309
translate pl ch6_c50b5f2b:

    # p "N-no, nothing... I just don't know what to say now."
    p "N-nie, nic takiego... Nie wiem co powiedzieć."

# game/script.rpy:3310
translate pl ch6_1af14dea:

    # w "Hmhm, you expected someone as charismatic as me to have all sorts of new people to introduce you to, then?"
    w "Hmhm, założyłeś, że ktoś tak charyzmatyczny jak ja ma wielu znajomych, którym mógłby cię przedstawić, prawda?"

# game/script.rpy:3311
translate pl ch6_9e2f690d:

    # p "I guess so. I'm just surprised..."
    p "Chyba tak. Jestem trochę zaskoczony..."

# game/script.rpy:3312
translate pl ch6_e3fe1cd7:

    # p "I, um, really like... being around you... so I expected that to be true for your other friends, too."
    p "Ja, um, bardzo lubię... twoje towarzystwo... więc myślałem, że inni również je doceniają."

# game/script.rpy:3313
translate pl ch6_81608c29:

    # w "Hmm..."
    w "Hmm..."

# game/script.rpy:3315
translate pl ch6_04156cdb:

    # w "I'd say you're probably the closest I've ever been with someone."
    w "Muszę przyznać, że chyba jesteś mi najbliższą osobą."

# game/script.rpy:3316
translate pl ch6_291e005a:

    # w "...Literally speaking."
    w "...W każdym sensie."

# game/script.rpy:3320
translate pl ch6_ba9915e5:

    # n "They laugh together, then fall into a comfortable silence..."
    n "Obydwoje wybuchają śmiechem, a niedługo potem zapada wygodna cisza..."

# game/script.rpy:3321
translate pl ch6_34bec6e3:

    # n "With their heads leaned together, Periwinkle nuzzles his face into Pastille's shoulder affectionately."
    n "Ich głowy opierają się o siebie, a Barwinek wtula swoją twarz w ramię Pastylka."

# game/script.rpy:3322
translate pl ch6_7680a727:

    # n "After a few moments, Pastille asks..."
    n "Po kilku chwilach Pastylek pyta..."

# game/script.rpy:3325
translate pl ch6_7e4e52b8:

    # p "Do you... wanna get in bed?"
    p "Chcesz może... iść do łóżka?"

# game/script.rpy:3326
translate pl ch6_08b40548:

    # w shutin teehee "For sleep, or for pleasure?"
    w shutin teehee "By spać, czy coś innego chodzi ci po głowie?"

# game/script.rpy:3327
translate pl ch6_275c3be8:

    # p omg "U-um, that's up to you...!" with vpunch
    p omg "U-um, to zależy od ciebie...!" with vpunch

# game/script.rpy:3329
translate pl ch6_1609c48e:

    # n "Periwinkle stands, then turns around to take Pastille's hands."
    n "Barwinek wstaje i obraca się, by chwycić dłoń Pastylka."

# game/script.rpy:3330
translate pl ch6_a6d0b21a:

    # w shutin "Come, then."
    w shutin "Więc chodźmy."

# game/script.rpy:3335
translate pl ch6_e0c4b6a5:

    # n "He leads him into the bedroom, closing the door behind them."
    n "Prowadzi go do sypialni i zamyka za nimi drzwi."

# game/script.rpy:3336
translate pl ch6_17bd39fe:

    # n "When he does, Pastille speaks up again..."
    n "Gdy to za nimi, Pastylek znów się odzywa..."

# game/script.rpy:3339
translate pl ch6_90e29b25:

    # p "You know... I'm still finding it hard to believe there's no one else you're close to."
    p "Wiesz... nadal ciężko mi uwierzyć, że z nikim nie jesteś blisko."

# game/script.rpy:3340
translate pl ch6_25de1dd0:

    # w shutin "Hm~? Two is a reasonable number."
    w shutin "Hm~? Dwójka to rozsądna ilość."

# game/script.rpy:3341
translate pl ch6_48ef453d:

    # w calm "You had two friends as well, did you not? Syrup and Gumdrop."
    w calm "Ty również masz dwie przyjaciółki, prawda? Syrop i Żelkę."

# game/script.rpy:3342
translate pl ch6_dcd034df:

    # p sure "Fair point... but counting YOU makes three."
    p sure "Tu masz rację... ale licząc ciebie, to trójka."

# game/script.rpy:3343
translate pl ch6_1da53c55:

    # w love "Ah, you have me beat. Perhaps I should try harder to catch up."
    w love "Ach, masz mnie. Może powinienem się bardziej starać, by cię dogonić."

# game/script.rpy:3346
translate pl ch6_c5a565be:

    # n "Periwinkle collapses into bed, while Pastille sits down beside him."
    n "Barwinek kładzie się na łóżku, a Pastylek zajmuje miejsce obok niego."

# game/script.rpy:3349
translate pl ch6_85981fc3:

    # w "I think I've preferred it, though. Keeping a healthy distance from others..."
    w "Chyba tak jest lepiej. Gdy trzymam zdrowy dystans od innych..."

# game/script.rpy:3350
translate pl ch6_43989462:

    # p "Really? How come?"
    p "Naprawdę? Dlaczego tak sądzisz?"

# game/script.rpy:3351
translate pl ch6_a40f3b27:

    # w "The alternative has been disastrous in my experience. I'm far too intense."
    w "Alternatywa okazała się być katastrofalna w moim wypadku. Jestem o wiele zbyt uczuciowy."

# game/script.rpy:3352
translate pl ch6_c4dfb99a:

    # p "Ha, what do you mean by THAT...?"
    p "Ha, co masz na myśli...?"

# game/script.rpy:3353
translate pl ch6_d85fd387:

    # w "Goodness, my best example is the worst one..."
    w "Mój boże, najlepszym przykładem jest ten najgorszy..."

# game/script.rpy:3355
translate pl ch6_0c4b9b3e:

    # w "In my teenage years... there was a boy I would've done anything for."
    w "Gdy byłem nastolatkiem... był taki chłopak, dla którego gotów byłem zrobić wszystko."

# game/script.rpy:3356
translate pl ch6_567cfdcb:

    # w "I wanted his approval so badly. I wanted to be loved."
    w "Tak bardzo pragnąłem jego akceptacji. Chciałem tylko, by mnie kochał."

# game/script.rpy:3357
translate pl ch6_53f3ef0f:

    # w "...It's funny, I can't even think of what drew me to him."
    w "...Śmieszne, nie wiem nawet, co takiego mnie do niego przyciągnęło."

# game/script.rpy:3359
translate pl ch6_b214fa05:

    # w "I suppose he was just a vessel to project onto. An idealized boyfriend, this... shortcut to happiness."
    w "Wydaje mi się, że był dla mnie jedynie ciałem, którego wymysłu kurczowo się trzymałem."
    w "Wyidealizowanym chłopakiem, tym... skrótem ku szczęściu. Hmhm... biedny chłop."

# game/script.rpy:3360
translate pl ch6_1201679b:

    # w "Hmhm... poor guy. He didn't know what to do with the torrent of feelings I'd been forcing onto him. We were young."
    w "Nie miał pojęcia, co ma zrobić z nadmiarem uczuć, którymi go obdarzałem wbrew jego woli. Byliśmy za młodzi."

# game/script.rpy:3361
translate pl ch6_7ae36a53:

    # w "A love like that is much too painful. If it can even be called love...."
    w "Taka miłość przynosi jedynie ból. Jeśli można nazywać ją miłością..."

# game/script.rpy:3363
translate pl ch6_4235f80c:

    # w "It took some practice to be able to separate the emotions out."
    w "Z biegiem lat nauczyłem się, jak izolować takie uczucia."

# game/script.rpy:3364
translate pl ch6_094487a5:

    # w "To be able to indulge in the romantic and sexual energy I craved, while protecting my fragile heart..."
    w "Jak cieszyć się uwagą romantyczną i seksualną, której tak pragnąłem, równocześnie chroniąc moje delikatne serce..."

# game/script.rpy:3365
translate pl ch6_c9592a6d:

    # w "But, ever since I figured it out, I've gotten to experience all sorts of love through these casual flings~"
    w "Ale odkąd to rozgryzłem, nauczyłem się też, jak doznawać wszelkich rodzajów miłości dzięki tym przelotnym romansom~"

# game/script.rpy:3366
translate pl ch6_bd22f0ce:

    # w "(What am I saying...?)"
    w "(O czym ja gadam...?)"

# game/script.rpy:3367
translate pl ch6_b87e6b7a:

    # w "It's perfect for me 💙 The ideal life, really."
    w "To świetne rozwiązanie 💙 Idealne życie, powiedziałbym."

# game/script.rpy:3368
translate pl ch6_694c6d8c:

    # w "(Don't listen to me, Pastille....)"
    w "(Nie słuchaj mnie, Pastylku...)"

# game/script.rpy:3373
translate pl ch6_a29244df:

    # p "Hmm..."
    p "Hmm..."

# game/script.rpy:3374
translate pl ch6_884754a7:

    # p smile "I don't know if your heart is as fragile as you think."
    p smile "Nie wiem, czy twoje serce jest tak delikatne, za jakie je uważasz."

# game/script.rpy:3375
translate pl ch6_cb22988c:

    # w shutin love "You don't believe me? Despite what it seems, I have the heart of an innocent maiden~!"
    w shutin love "Nie wierzysz mi? Może nie wyglądam, ale mam serce niewinnej panienki~!"

# game/script.rpy:3376
translate pl ch6_1dece50f:

    # p sure "Haha, I don't know about innocent, but..."
    p sure "Haha, nie wiem, jak z niewinnością, ale..."

# game/script.rpy:3380
translate pl ch6_ea6c8d9d:

    # n "Pastille leans forward and lays his head on Periwinkle's chest."
    n "Pastylek pochyla się i kładzie głowę na klatce piersiowej Barwinka."

# game/script.rpy:3381
translate pl ch6_192176bb:

    # p "...Sounds pretty strong to me."
    p "...Jak dla mnie brzmi dość silnie."

# game/script.rpy:3382
translate pl ch6_075d682d:

    # w "...!!"
    w "...!!!"

# game/script.rpy:3384
translate pl ch6_77261c10:

    # p "Ah, it's beating harder now."
    p "Ach, teraz bije jeszcze mocniej."

# game/script.rpy:3386
translate pl ch6_51fe2183:

    # w "B-because you suddenly embraced me! See, this is what I mean by fragile...!" with vpunch
    w "B-bo nagle mnie przytuliłeś! Widzisz, to miałem na myśli nazywając je delikatnym...!" with vpunch

# game/script.rpy:3389
translate pl ch6_afbec36c:

    # n "Periwinkle struggles out from under him, and the pair sits facing each other on the bed."
    n "Gdy Barwinek wyrywa się spod Pastylka, dwójka siada na łóżku, skierowana ku sobie."

# game/script.rpy:3392
translate pl ch6_f8a67d56:

    # p "You know... at first, I thought romantic stuff was just a formality for you. But you actually love it, huh?"
    p "Wiesz... na początku myślałem, że te wszystkie romanse to dla ciebie formalność. Ale ty to kochasz, hm?"

# game/script.rpy:3393
translate pl ch6_9c15c768:

    # w shutin love "Are you only realizing that NOW?"
    w shutin love "Dopiero TERAZ zdajesz sobie z tego sprawę?"

# game/script.rpy:3394
translate pl ch6_35b3829b:

    # p ehe "Haha, I guess not...."
    p ehe "Haha, chyba nie..."

# game/script.rpy:3398
translate pl ch6_d170010a:

    # "What are you trying to say, Pastille?"
    "Co próbujesz powiedzieć, Pastylku?"

# game/script.rpy:3399
translate pl ch6_736befba:

    # "That it's okay for me to love you...?"
    "Że mogę cię kochać...?"

# game/script.rpy:3400
translate pl ch6_310f8fb1:

    # "That I'll be safe?"
    "Że będę bezpieczny?"

# game/script.rpy:3401
translate pl ch6_76b2fe88_9:

    # nvl clear
    nvl clear

# game/script.rpy:3404
translate pl ch6_94871324:

    # w "Then, hurry up and kiss me."
    w "Więc się pospiesz i mnie pocałuj."

# game/script.rpy:3406
translate pl ch6_4a8350ae:

    # p "Okay ❤ Sorry to keep you waiting."
    p "Dobrze ❤ Przepraszam za zwlekanie."

# game/script.rpy:3408
translate pl ch6_d66b3318:

    # n "Pastille closes the distance between them..."
    n "Pastylek zmniejsza odległość między ich ustami..."

# game/script.rpy:3409
translate pl ch6_54a35ace:

    # "I'm too weak."
    "Jestem za słaby."

# game/script.rpy:3410
translate pl ch6_139334f1:

    # "The words won't come out..."
    "Słowa stają mi w gardle..."

# game/script.rpy:3411
translate pl ch6_76b2fe88_10:

    # nvl clear
    nvl clear

# game/script.rpy:3413
translate pl ch6_0f7e6da5:

    # n "As they kiss, Periwinkle becomes more and more entangled in his thoughts..."
    n "Podczas pocałunku, Barwinek jeszcze bardziej zatraca się w swoich myślach..."

# game/script.rpy:3414
translate pl ch6_f42e65a6:

    # "Ahh, it hurts...!"
    "Ach, boli...!"

# game/script.rpy:3415
translate pl ch6_d63ae36a:

    # "I want to be even closer...."
    "Chcę być bliżej..."

# game/script.rpy:3416
translate pl ch6_76b2fe88_11:

    # nvl clear
    nvl clear

# game/script.rpy:3418
translate pl ch6_341a3f02:

    # n "He lets himself fall backward, bringing Pastille down with him."
    n "Upada na plecy, ciągnąc za sobą Pastylka."

# game/script.rpy:3419
translate pl ch6_443d47e5:

    # "This isn't nearly enough to satisfy me..."
    "Tyle mi nie wystarczy..."

# game/script.rpy:3420
translate pl ch6_c8df87cf:

    # "Just, please, don't stop...."
    "Tylko, proszę, nie przestawaj..."

# game/script.rpy:3421
translate pl ch6_76b2fe88_12:

    # nvl clear
    nvl clear

# game/script.rpy:3425
translate pl ch6_cb671a59:

    # n "Periwinkle's heart cried out..."
    n "Serce Barwinka zapłakało..."

# game/script.rpy:3426
translate pl ch6_a66018f1:

    # n "His jumbled emotions caught in his throat, manifesting through his hands, clinging desperately to Pastille..."
    n "Jego emocje ugrzęzły w jego klatce piersiowej, ukazując się jedynie dzięki jego dłoniom, desperacko trzymającym Pastylka..."

# game/script.rpy:3427
translate pl ch6_5f6ba41c:

    # n "...who continued to kiss him and hold him through the night."
    n "...który całą noc obdarowywał go pocałunkami."

# game/script.rpy:3438
translate pl ch7_7b49a2da:

    # centered "{w=3}{nw}"
    centered "{w=3}{nw}"

# game/script.rpy:3443
translate pl ch7_6f509ab8:

    # n "The next morning, Periwinkle steps out onto his doorstep with a heavy sigh."
    n "Następnego ranka, Barwinek wychodzi na zewnątrz z głębokim westchnieniem."

# game/script.rpy:3445
translate pl ch7_a6ad8caa:

    # w hood empty "(If I lay around in bed all day, I'll only feel more miserable...)"
    w hood empty "(Jeśli cały dzień będę leżał w łóżku, tylko dodam sobie utrapień...)"

# game/script.rpy:3446
translate pl ch7_bfb25d37:

    # w oops "(I need to stop avoiding my work. I have to talk to Astragalus....)"
    w oops "(Muszę przestać unikać pracy. Muszę porozmawiać z Traganką...)"

# game/script.rpy:3447
translate pl ch7_3eb69f61:

    # w empty "(She isn't going to be pleased with me though....)"
    w empty "(Nie spodoba jej się moje zachowanie...)"

# game/script.rpy:3449
translate pl ch7_c0771f75:

    # n "Holding his mantle tightly, he makes his way to the apothecary..."
    n "Trzymając ciasno swój płaszcz, udaje się w drogę do apteki..."

# game/script.rpy:3457
translate pl ch7_ec45006e:

    # n "When he arrives, Astragalus is preoccupied with arranging some of her merchandise."
    n "Gdy do niej dociera, Traganka jest wyraźnie zajęta układaniem części swojego towaru."

# game/script.rpy:3458
translate pl ch7_2eb737f5:

    # n "She turns abruptly at the unexpected sound of the door's chime."
    n "Na dźwięk dzwonka odwraca się, zaskoczona."

# game/script.rpy:3461
translate pl ch7_23102229:

    # a augh "Hey, we're not open yet--!" with vpunch
    a augh "Hej, jeszcze nie otwarte-!" with vpunch

# game/script.rpy:3463
translate pl ch7_21ae3d6f:

    # a hm "...Huh? Periwinkle?"
    a hm "...Hę? Barwinek?"

# game/script.rpy:3464
translate pl ch7_0cfdf83c:

    # w hood decline "Good morning, Astragalus."
    w hood decline "Dzień dobry, Traganko."

# game/script.rpy:3465
translate pl ch7_ca42047f:

    # a uh "I haven't seen you all month--I barely recognized you under that hood!"
    a uh "Od miesiąca cię nie widziałam- Ledwo idzie cię poznać spod tego kaptura!"

# game/script.rpy:3466
translate pl ch7_a59d0c89:

    # a augh "I was about to come and knock on your damn door if you didn't show your face here soon. You've got a huge backlog of orders waiting!"
    a augh "Gdybyś się nie pokazał, gotowa bym była sama pójść do twojego domu i wyważyć drzwi. Masz całą masę zaległych zamówień!"

# game/script.rpy:3467
translate pl ch7_6328fc6a:

    # w empty "...I can't take them. My magic is useless."
    w empty "...Nie mogę ich wykonać. Moja magia jest bezużyteczna."

# game/script.rpy:3468
translate pl ch7_709a7b6c:

    # a uh "Whaddaya mean, \"useless\"?"
    a uh "Jak to \"bezużyteczna\"?"

# game/script.rpy:3469
translate pl ch7_78308c9b:

    # n "Periwinkle meekly hands over one of his pale pink vials."
    n "Barwinek nieśmiało podaje jej jedną z butelek wypełnionych różowym płynem."

# game/script.rpy:3470
translate pl ch7_e6a68b87:

    # w ohhh "This is all I can make... it's been this way for ages."
    w ohhh "Tylko to mogę robić... od bardzo dawna."

# game/script.rpy:3471
translate pl ch7_c42de9e7:

    # a whatever "*sigh* Let's see..."
    a whatever "*westchnienie* Zobaczmy..."

# game/script.rpy:3472
translate pl ch7_60a7f254:

    # n "Astragalus unscrews the top, and eyes Periwinkle suspiciously before giving it a whiff..."
    n "Traganka odkręca butelkę i przygląda się podejrzanie Barwinkowi, po czym wącha substancję..."

# game/script.rpy:3473
translate pl ch7_0d690c65:

    # a uh "Whew, that's powerful!!" with vpunch
    a uh "Fiu, ale mocne!" with vpunch

# game/script.rpy:3474
translate pl ch7_2b253749:

    # a think "Not bad, though... warms me right up. Could stand to be diluted a little, just to make it less overwhelming..."
    a think "Ale nie jest źle... chyba rozgrzewa. Mogłoby postać sobie dłuższą chwilę, żeby nie było takie przytłaczające..."

# game/script.rpy:3475
translate pl ch7_40f53860:

    # a lol "So. What's got you stuck on a scent like this?"
    a lol "Więc. Jakim cudem utknąłeś z takim zapachem?"

# game/script.rpy:3476
translate pl ch7_de42c61a:

    # w ohhh2 "...It's Pastille...."
    w ohhh2 "...To Pastylek..."

# game/script.rpy:3477
translate pl ch7_0381a0e1:

    # w whine2 "He's ruined me! I'll never be able to return to the way I was before...!"
    w whine2 "Zrujnował mnie! Nigdy nie będę w stanie wrócić do formy...!"

# game/script.rpy:3478
translate pl ch7_4bd0f1d4:

    # a closed "I see. So things got complicated, just like I warned you."
    a closed "Rozumiem. Czyli sprawy się skomplikowały, jak cię ostrzegałam."

# game/script.rpy:3479
translate pl ch7_1fb3e795:

    # w cwy "Mhm... *sniffle*..."
    w cwy "Mhm... *szloch*"

# game/script.rpy:3480
translate pl ch7_6be39aa2:

    # w cwy2 "I-I love him so much, I think I might die...."
    w cwy2 "T-tak bardzo go kocham, chyba umrę..."

# game/script.rpy:3481
translate pl ch7_48204255:

    # a neutral "Come on... Back room. Now."
    a neutral "No chodź... Na zaplecze. W tej sekundzie."

# game/script.rpy:3485
translate pl ch7_7d77e570:

    # n "Periwinkle nods and obediently follows Astragalus into her private office..."
    n "Barwinek kiwa głową i posłusznie podąża za Traganką..."

# game/script.rpy:3490
translate pl ch7_1be0328f:

    # n "He quietly takes in his surroundings before she suddenly turns to him with a raised finger."
    n "Po cichu przygląda się pomieszczeniu, ale wtedy przed jego nosem pojawia się podniesiony palec, ostrzeżenie."

# game/script.rpy:3492
translate pl ch7_170b612d:

    # a "Don't touch anything."
    a "Niczego mi nie dotykać."

# game/script.rpy:3493
translate pl ch7_90a8c977:

    # w hood ohhh "...?"
    w hood ohhh "...?"

# game/script.rpy:3495
translate pl ch7_020bb483:

    # n "Astragalus drags a bean bag chair out from the corner and plops it in the middle of the room unceremoniously."
    n "Traganka bez większego zamieszania rzuca pufę, którą wysunęła z kąta, na sam środek pokoju."

# game/script.rpy:3497
translate pl ch7_507ec09a:

    # a "Sit."
    a "Siadaj."

# game/script.rpy:3498
translate pl ch7_e6ea4d0e:

    # w hood ohhh "...It's dusty...."
    w hood ohhh "...Zakurzona..."

# game/script.rpy:3499
translate pl ch7_44201857:

    # a augh "UGH, you're such a diva..."
    a augh "BOŻE, ale z ciebie panienka..."

# game/script.rpy:3500
translate pl ch7_c4c193b3:

    # n "She gives it a couple good smacks, beating the dust into the air instead."
    n "Daje jej kilka mocnych klapsów, sprawiając, że kurz wzbija się w powietrze."

# game/script.rpy:3501
translate pl ch7_c411bd45:

    # a annoyed "...NOW sit."
    a annoyed "...TERAZ siadaj."

# game/script.rpy:3502
translate pl ch7_ca9dcc70:

    # w oops "Very well...."
    w oops "No dobrze..."

# game/script.rpy:3505
translate pl ch7_86603b28:

    # n "He complies, and Astragalus spins her office chair around to face him."
    n "Wykonuje polecenie, a Traganka odwraca swoje krzesło, by spojrzeć mu w twarz."

# game/script.rpy:3508
translate pl ch7_46e11470:

    # a "Alright, Periwinkle. Here's what's gonna happen."
    a "No dobra, Barwinek. Oto, co się wydarzy."

# game/script.rpy:3509
translate pl ch7_89a00474:

    # a "I'm gonna brew us up some tea, and you're gonna explain everything. From the beginning."
    a "Ja zaparzę nam trochę herbaty, a ty wyjaśnisz mi wszystko. Od samego początku."

# game/script.rpy:3510
translate pl ch7_0ccf1ed0:

    # w hood sorry "Explain what...?"
    w hood sorry "Wyjaśnię co...?"

# game/script.rpy:3511
translate pl ch7_0e7a98bb:

    # a "About Pastille. Even the stuff I already know. Everything, from the top."
    a "Wszystko o Pastylku. Nawet to, o czym już wiem. Po prostu wszystko, od A do Z."

# game/script.rpy:3512
translate pl ch7_30cf76fb:

    # w ohhh "Everything...?"
    w ohhh "Wszystko...?"

# game/script.rpy:3513
translate pl ch7_4f05ba39:

    # a "Skip the bedroom details, obviously. Just walk me through anything important that happened since you met."
    a "Możesz pominąć to, co wyprawialiście w łóżku. Wyjaśnij to, co wydarzyło się odkąd się poznaliście, a co uważasz za ważne."

# game/script.rpy:3514
translate pl ch7_c147a5e1:

    # w whine "I-I don't want to! Reliving it all is only going to make things worse...!"
    w whine "A-ale nie chcę! Przeżywanie tego wszystkiego od początku tylko pogorszy sprawę...!"

# game/script.rpy:3517
translate pl ch7_d617b2fd:

    # n "Astragalus stands and walks over to her kettle to start the tea."
    n "Traganka wstaje i podchodzi do czajnika, by przygotować herbatę."

# game/script.rpy:3519
translate pl ch7_c88d1b30:

    # a "Alright, you lovesick dolt..."
    a "No dobra, zakochany głupku..."

# game/script.rpy:3520
translate pl ch7_95976d4b:

    # a annoyed "You wanna know why exactly your magic's been stuck like that? It's because you don't have an outlet for all those emotions."
    a annoyed "Wiesz, czemu twoja magia się zawiesiła? Bo nie dajesz upustu tym wszystkim emocjom."

# game/script.rpy:3521
translate pl ch7_ea89bd51:

    # a closed "Instead, you keep bottling them up--literally, I guess. It's all that comes out because it's all there is inside you."
    a closed "Dlatego się kumulują. W twojej magii, czy tam w butelkach, nieważne. Tylko one się z ciebie wydostają, bo tylko one w tobie są."

# game/script.rpy:3522
translate pl ch7_61f43815:

    # w hood ohhh "...."
    w hood ohhh "..."

# game/script.rpy:3523
translate pl ch7_4d08edac:

    # a lol2 "So, let it all out! What, you think I'm gonna judge you?"
    a lol2 "Więc się wygadaj! Co, myślisz, że będę cię osądzać?"

# game/script.rpy:3524
translate pl ch7_0e405e25:

    # w oops "No... I don't know."
    w oops "Nie... Nie wiem."

# game/script.rpy:3525
translate pl ch7_a2f71b21:

    # a lol "Would you rather spill it all to him instead?"
    a lol "Wolałbyś opowiedzieć o tym jemu?"

# game/script.rpy:3526
translate pl ch7_237d6381:

    # w cwy "I can't...! It's too much!"
    w cwy "Nie mogę...! To za dużo!"

# game/script.rpy:3527
translate pl ch7_61ef0d5e:

    # a sure "Then tell it to me, a neutral third party."
    a sure "Więc opowiedz o tym mi, obiektywnej osobie trzeciej."

# game/script.rpy:3528
translate pl ch7_5df175e3:

    # a uh "Actually, I can't say that I'm neutral... I'd need to find a new supplier if you couldn't fill my orders anymore."
    a uh "W sumie, nie mogę się nazywać obiektywną... Musiałabym znaleźć nowego dostawcę, gdybyś dalej nie nadążał z zamówieniami."

# game/script.rpy:3529
translate pl ch7_3a7ea07c:

    # w oops "I do feel a little more at ease imagining this is all a business matter for you...."
    w oops "Pocieszające, że chodzi ci tylko o biznes..."

# game/script.rpy:3530
translate pl ch7_969f721a:

    # a smile "Then just think of it like that."
    a smile "Więc tego się trzymajmy."

# game/script.rpy:3532
translate pl ch7_e9b2e9b2:

    # n "Astragalus pours their tea and returns to her seat with two mugs in hand."
    n "Traganka napełnia kubki herbatą i wraca z nimi na swoje miejsce."

# game/script.rpy:3533
translate pl ch7_a98ff37d:

    # n "With a heavy sigh, Periwinkle finally relents and begins his story..."
    n "Z głębokim westchnieniem, Barwinek nareszcie się ugina i zaczyna swoją historię..."

# game/script.rpy:3539
translate pl ch7_d30066c5:

    # "I told her everything I could think of..."
    "Powiedziałem jej wszystko, o czym myślałem..."

# game/script.rpy:3540
translate pl ch7_33d9f84f:

    # "My first impressions of him. How he continuously subverted my expectations."
    "O pierwszym wrażeniu. O tym, jak bezustannie przewyższał wszelkie oczekiwania."

# game/script.rpy:3541
translate pl ch7_c5f52926:

    # "My mistakes. Appearing where I shouldn't have, then going into a desperate spiral as I tried to rid myself of the guilt over it."
    "O moich błędach. O pojawieniu się tam, gdzie nie powinno mnie być, o desperackich próbach pozbycia się poczucia winy."

# game/script.rpy:3542
translate pl ch7_1bbf690f:

    # "How he was the one to come to apologize afterward..."
    "O tym, jak potem przyszedł do mnie z przeprosinami..."

# game/script.rpy:3543
translate pl ch7_c5838a34:

    # nvl clear
    # "Our date that day, which was so, so wonderful... but which also laid bare the feelings I was too afraid to acknowledge."
    nvl clear
    "O naszej randce tego dnia, która była tak, tak wspaniała... ale również ukazała wszystkie uczucia, których tak się obawiałem."

# game/script.rpy:3545
translate pl ch7_e6e49546:

    # "How I latched on to any alternative explanation I could in order to escape them."
    "O tym, jak uczepiłem się każdego ich wyjaśnienia, które pozwalało mi od nich uciec."

# game/script.rpy:3546
translate pl ch7_4e84de73:

    # "The moment I could finally admit it to myself. All the ways he'd changed my life for the better."
    "O momencie, w którym nareszcie się do nich przyznałem. O wszystkich sposobach, w jakie zmienił moje życie na lepsze."

# game/script.rpy:3547
translate pl ch7_6a07a020:

    # "How we grew closer and closer, while I held those feelings tighter to my chest..."
    "O tym, jak zbliżaliśmy się do siebie, podczas gdy ja nadal trzymałem te uczucia w sobie..."

# game/script.rpy:3548
translate pl ch7_d4484d1e:

    # nvl clear
    # "I told her how he had finally worked up the courage to introduce me to his friends."
    nvl clear
    "Powiedziałem jej o tym, że nareszcie zebrał się na to, by przedstawić mnie swoim przyjaciółkom."

# game/script.rpy:3550
translate pl ch7_65da988b:

    # "How his hand trembled in mine as we walked out the door together."
    "O tym, jak jego dłonie drżały, gdy przekroczyliśmy próg."

# game/script.rpy:3551
translate pl ch7_ee6b35c9:

    # "This point of contention, a far-off goal I had decided would have to be met before advancing..."
    "O tym punkcie niezgody, odległym celu, o którym zadecydowałem, że powinien zostać osiągnięty nim posunę się dalej..."

# game/script.rpy:3552
translate pl ch7_ca54ab44:

    # "Everything, up to the state I'm in now. Useless, paralyzed, and sobbing."
    nvl clear
    "O wszystkim prowadzącym do mojego obecnego stanu. Bezużytecznego, sparaliżowanego, zapłakanego."

# game/script.rpy:3553
translate pl ch7_92f40e14:

    # nvl clear
    # "Astragalus listened patiently through all of it."
    nvl clear
    "Traganka cierpliwie słuchała opowieści."

# game/script.rpy:3555
translate pl ch7_343d2423:

    # "She asked questions from time to time. Clarification on the timeframe, certain details..."
    "Od czasu do czasu zadawała pytania. A to chciała sprecyzowania ram czasowych, a to pewnych szczegółów..."

# game/script.rpy:3556
translate pl ch7_87e644fe:

    # "Her reaffirming comments offered such comfort, such relief to this pain I'd kept confined to my own heart."
    "Jej podtrzymujące rozmowę komentarze dodawały mi otuchy, były odskocznią od bólu, który zamknąłem w swoim sercu."

# game/script.rpy:3557
translate pl ch7_b69014f7:

    # "Until finally, I had nothing left to say."
    "Aż w końcu nie miałem już nic do powiedzenia."

# game/script.rpy:3558
translate pl ch7_d27b4990:

    # nvl clear
    # n "Astragalus sits back in her chair and heaves a sigh."
    nvl clear
    n "Traganka porusza się w swoim krześle i wzdycha głośno."

# game/script.rpy:3562
translate pl ch7_a8670c2a:

    # a "So? How are you feeling?"
    a "I? Jak się czujesz?"

# game/script.rpy:3563
translate pl ch7_04d072f1:

    # w hood oh2 "There's a certain clarity in laying it all out at once..."
    w hood oh2 "Wyrzucenie tego z siebie dało mi poczucie jasności..."

# game/script.rpy:3564
translate pl ch7_547bdb80:

    # w ohhh "But, I still... don't know what I can do to push things forward... could I even handle the rejection...?"
    w ohhh "Ale nadal... nie wiem, jak pchnąć wszystko do przodu... Jak przeżyję odrzucenie...?"

# game/script.rpy:3565
translate pl ch7_a359177e:

    # a eyeroll "He won't reject you."
    a eyeroll "Nie odrzuci cię."

# game/script.rpy:3566
translate pl ch7_229785e7:

    # w sorry "What makes you so certain...?"
    w sorry "Czemu jesteś tego tak pewna...?"

# game/script.rpy:3567
translate pl ch7_47ddd304:

    # a lmao "That boy is madly in love with you!! Why else would he devote all that time and energy to making you happy?"
    a lmao "Ten chłopak jest zakochany po uszy! Gdyby było inaczej, po co miałby marnować czas i energię na twoje szczęście?"

# game/script.rpy:3568
translate pl ch7_a282e00e:

    # w pout "Because I'm great in bed! Obviously!!" with vpunch
    w pout "Bo jestem świetny w łóżku! Naturalnie!!!" with vpunch

# game/script.rpy:3569
translate pl ch7_7d78d80b:

    # a lol2 "Quit deflecting! You know that's not all it is."
    a lol2 "Przestań zmieniać temat! Wiesz, że to wcale nie tak."

# game/script.rpy:3570
translate pl ch7_c44bc880:

    # w nofair2 "I don't want to leave any room for doubt... if I were to confess now, and it didn't go well, I'd... I'd be destroyed beyond repair!"
    w nofair2 "Nie chcę zostawiać miejsca na niepewność..."
    w "Gdybym miał teraz wyznać mu prawdę, i nie poszłoby po mojej myśli, byłbym... byłbym skończony!"

# game/script.rpy:3571
translate pl ch7_699f61db:

    # w nofair "That's why, if I'm going to say it, I want it to be a sure thing."
    w nofair "Dlatego, jeśli mam mu to powiedzieć, chcę być pewny."

# game/script.rpy:3572
translate pl ch7_70aa9f4c:

    # a sure "Life ain't about \"sure things\"."
    a sure "W życiu nie ma miejsca na \"bycie pewnym\"."

# game/script.rpy:3573
translate pl ch7_1ce1b2b1:

    # w oops "Even so. I'm going to wait for the opportune moment before exposing my vulnerable heart...."
    w oops "I tak. Mam zamiar zaczekać na odpowiedni moment zanim postanowię narazić swoje serce..."

# game/script.rpy:3574
translate pl ch7_67d2fe6a:

    # a eyeroll "As long as you've got a plan."
    a eyeroll "Przynajmniej masz jakiś plan."

# game/script.rpy:3576
translate pl ch7_5c6e9d30:

    # n "Astragalus leans down to pick up Periwinkle's empty mug, then holds it out in front of him."
    n "Traganka pochyla się, by zabrać od Barwinka pusty kubek, a następnie podnosi go nieco, trzymając go przed twarzą chłopaka."

# game/script.rpy:3577
translate pl ch7_05b45148:

    # a happy "Try your magic again. Whatever scent you want, just pour it right in the cup."
    a happy "Dawaj, czaruj. Jakikolwiek zapach, w tym kubku."

# game/script.rpy:3578
translate pl ch7_61f43815_1:

    # w hood ohhh "...."
    w hood ohhh "..."

# game/script.rpy:3582
translate pl ch7_bffebb26:

    # n "Periwinkle nervously draws his wand, holds it out to the cup... then closes his eyes, and taps."
    n "Barwinek nerwowo wyciąga swoją różdżkę, dotyka nią kubka... zamyka oczy i stuka."

# game/script.rpy:3585
translate pl ch7_62bd9f4e:

    # w hood ohhh2 "...Is it...?"
    w hood ohhh2 "...Czy to...?"

# game/script.rpy:3586
translate pl ch7_31d796dc:

    # a "...."
    a "..."

# game/script.rpy:3587
translate pl ch7_a378f6db:

    # a hm "Chamomile?"
    a hm "Rumianek?"

# game/script.rpy:3588
translate pl ch7_a5fd1669:

    # w my "It isn't peach...!"
    w my "Nie brzoskwinia...!"

# game/script.rpy:3589
translate pl ch7_48779aee:

    # w happy "I-I'm cured!!" with vpunch
    w happy "J-jestem uleczony!!!" with vpunch

# game/script.rpy:3590
translate pl ch7_c8bd051e:

    # a lol2 "Yeah, dumbass! Did you forget this is an apothecary?"
    a lol2 "Ta, kretynie! Zapomniałeś, że jesteśmy w aptece?"

# game/script.rpy:3591
translate pl ch7_15718a3f:

    # w ohdear "Ah... it is, isn't it...."
    w ohdear "Ach... Tak, prawda..."

# game/script.rpy:3592
translate pl ch7_21466243:

    # a eyeroll "Next time you've got a problem with your magic, don't sit around crying about it on your own. Come straight to me, and I'll fix you up."
    a eyeroll "Przy następnym problemie z magią, nie siedź płacząc w samotności, że nie działa. Przyjdź do mnie, ja cię naprawię, serio."

# game/script.rpy:3593
translate pl ch7_ba5c6de9:

    # w love "Thank you... I..."
    w love "Dziękuję... Ja..."

# game/script.rpy:3594
translate pl ch7_44e91ae4:

    # w shy "I'm truly glad that we're friends... I would be lost without you."
    w shy "Jestem naprawdę wdzięczny, że jesteśmy przyjaciółmi... Bez ciebie byłbym stracony."

# game/script.rpy:3595
translate pl ch7_4ffcdd35:

    # a sure "Business associates. Don't forget I've got loads of orders for you now that you're back to normal."
    a sure "Jesteśmy współpracownikami. Nie zapominaj, że skoro jesteś już normalny, mam dla ciebie całą masę zamówień."

# game/script.rpy:3596
translate pl ch7_b19f23d3:

    # w happy "I'll go home and fill them right away! But first..."
    w happy "Wrócę do domu i od razu się nimi zajmę! Ale najpierw..."

# game/script.rpy:3597
translate pl ch7_9d2c05b0:

    # w love "May I hug you?"
    w love "Mogę cię przytulić?"

# game/script.rpy:3598
translate pl ch7_04792b09:

    # a augh "Not a chance!" with vpunch
    a augh "Chyba śnisz!" with vpunch

# game/script.rpy:3599
translate pl ch7_d733da0f:

    # w teehee "Hmhm, it was worth a shot. You'll accept my platonic affection one day~!"
    w teehee "Hmhm, warto było spróbować. Pewnego dnia zaakceptujesz moje platoniczne uczucia, Traganko~!"

# game/script.rpy:3600
translate pl ch7_7f7593b0:

    # a happy "Yeah, yeah... get outta my office, Periwinkle."
    a happy "Ta, ta... Wypad z biura, Barwinek."

# game/script.rpy:3607
translate pl ch7_875a28a9:

    # n "The pair exits the back room, but they only make it a few steps out before Periwinkle turns on his heel."
    n "Dwójka wychodzi z pomieszczenia, ale nie udaje im się nawet dojść do lady, a Barwinek odwraca się na pięcie."

# game/script.rpy:3608
translate pl ch7_4d17f35d:

    # w hood oh "Ah, one more thing, before I go..."
    w hood oh "Ach, jeszcze jedna rzecz..."

# game/script.rpy:3610
translate pl ch7_3f808ca6:

    # a "Hm? What's up."
    a "Hm? O co biega?"

# game/script.rpy:3611
translate pl ch7_faf56b4e:

    # w smile "I've been curious to ask. The last time I was here, you told me that magic can be interpreted as a judge of one's character..."
    w smile "Od dawna chciałem zapytać. Ostatnim razem powiedziałaś, że na podstawie magii można wiele powiedzieć o czarodzieju..."

# game/script.rpy:3612
translate pl ch7_09ac5a27:

    # a think "Oh, right. When I changed my mind about Pastille."
    a think "Och, ta. Kiedy zmieniłam zdanie o Pastylku."

# game/script.rpy:3613
translate pl ch7_e02f8699:

    # w calm "Yes, precisely. It's rather impressive that you could see through to his true nature, despite having only just met..."
    w calm "Tak, dokładnie. To doprawdy imponujące, że tyle o nim wiedziałaś pomimo tego, że dopiero co go poznałaś..."

# game/script.rpy:3614
translate pl ch7_d75c0f1f:

    # a lol "Sure, but he was pretty easy to read. Don't be too impressed."
    a lol "Ta, ale był łatwy do rozgryzienia. Nie bądź tak zachwycony."

# game/script.rpy:3615
translate pl ch7_7bba75e2:

    # w love "...Well?"
    w love "...I?"

# game/script.rpy:3616
translate pl ch7_21235aed:

    # a lol2 "Well what?"
    a lol2 "I co?"

# game/script.rpy:3617
translate pl ch7_665ef7a8:

    # w happy "What does my magic say about me~? I'm dying to know 💙"
    w happy "Co mówi o mnie moja magia~? Wprost umieram z ciekawości 💙"

# game/script.rpy:3618
translate pl ch7_f33dfb60:

    # a sure "YOUR magic... was always lively and carefree. Compassionate, too. Like Pastille's."
    a sure "TWOJA magia... od zawsze była pełna życia i beztroski. Także współczucia, jak Pastylka."

# game/script.rpy:3619
translate pl ch7_08b17c47:

    # w love "How can you possibly read something like \"carefree\" from perfume?"
    w love "Jakim cudem jesteś w stanie odczytać coś jak \"beztroska\" na podstawie perfum?"

# game/script.rpy:3620
translate pl ch7_e94ff0db:

    # a lol "Hey, I'm just telling you the vibes I've gotten over the years."
    a lol "Hej, mówię ci tylko, jakie wrażenie na mnie sprawiłeś przez te wszystkie lata."

# game/script.rpy:3621
translate pl ch7_a2de6d44:

    # a think "Your aromas prioritize pleasure. But there was definitely a hint of loneliness in them, too..."
    a think "Priorytetem twoich zaklęć jest przyjemność. Ale zdecydowanie było w nich nieco samotności..."

# game/script.rpy:3622
translate pl ch7_d8043053:

    # w teehee "Alright, now I KNOW you're making things up. I've always had someone to keep me company 💙"
    w teehee "No dobrze, teraz WIEM, że wymyślasz to na poczekaniu. Od zawsze uwielbiałem towarzystwo 💙"

# game/script.rpy:3623
translate pl ch7_15310979:

    # a smile "Just because you've always got someone around doesn't mean you can't be lonely."
    a smile "Posiadanie kogoś obok siebie nie oznacza braku samotności."

# game/script.rpy:3624
translate pl ch7_c61d8bb7:

    # w calm "And I suppose someone like you would know a thing or two about loneliness, hm?"
    w calm "Bo ktoś jak ty wie wszystko o samotności, hm?"

# game/script.rpy:3625
translate pl ch7_c94c969b:

    # a hm "I'm not lonely at all. In fact, I PREFER to be alone."
    a hm "Wcale nie jestem samotna. Właściwie, WOLĘ być sama."

# game/script.rpy:3626
translate pl ch7_adf9c46f:

    # a closed "YOU on the other hand... can't stand it even for a second. That's why you'd always run off chasing someone to fill the void."
    a closed "TY za to... nie mógłbyś tego znieść. Dlatego zawsze szukasz kogoś, kto wypełniłby pustkę."

# game/script.rpy:3627
translate pl ch7_cd947219:

    # w ohdear "...Well THAT certainly isn't true."
    w ohdear "...TO na pewno nieprawda."

# game/script.rpy:3628
translate pl ch7_be244ae7:

    # a lol "The peach stuff you gave me earlier was PURE loneliness. It was crying out, like \"Please, Pastille, never leave me~!\""
    a lol "Ta brzoskwinia z wcześniej była CZYSTĄ samotnością. Jakby płakała, \"Proszę, Pastylek, nie zostawiaj mnie~!\"."

# game/script.rpy:3629
translate pl ch7_27338eed:

    # w pout "This isn't fun anymore. Forget that I asked!"
    w pout "Już mi się nie podoba. Zapomnij!"

# game/script.rpy:3630
translate pl ch7_11cf638a:

    # a happy "Sorry. Couldn't resist."
    a happy "Sorki. Nie mogłam się oprzeć."

# game/script.rpy:3631
translate pl ch7_7623f766:

    # w oops "...."
    w oops "..."

# game/script.rpy:3632
translate pl ch7_b80c39a5:

    # w ohhh "I suppose you're right, though... I haven't been able to tell him that in words."
    w ohhh "Ale chyba masz rację... Nie potrafiłem ubrać tego w słowa."

# game/script.rpy:3633
translate pl ch7_ad5bdd9e:

    # w nofair2 "I can't keep holding back... he has to know. No matter the outcome."
    w nofair2 "Nie mogę tego przedłużać... Musi wiedzieć. Nie obchodzą mnie konsekwencje."

# game/script.rpy:3634
translate pl ch7_60359fd7:

    # a smile "Good luck, okay? I'm sure it'll turn out just fine."
    a smile "Powodzenia, okej? Na pewno wszystko pójdzie jak po maśle."

# game/script.rpy:3635
translate pl ch7_a4d8dbdf:

    # w ohhh "Yes... yes, it likely will."
    w ohhh "Tak... Tak, na pewno."

# game/script.rpy:3636
translate pl ch7_0f7a9daf:

    # w shy "Thank you again... I'm truly grateful for all that you've done for me."
    w shy "Jeszcze raz dziękuję... Jestem wdzięczny za wszystko, co dla mnie robisz."

# game/script.rpy:3641
translate pl ch7_47504267:

    # n "Astragalus waves him off, and Periwinkle leaves the apothecary with new resolve..."
    n "Traganka macha na pożegnanie, a zdeterminowany Barwinek opuszcza aptekę z nowym celem..."

# game/script.rpy:3651
translate pl ch7_8954e2f7:

    # "I spent the next several days catching up on my work."
    "Następne kilka dni poświęciłem nadganianiu zaległych zamówień."

# game/script.rpy:3652
translate pl ch7_c124ee6b:

    # "Magic truly does come so easily with a clear mind! If only I'd swallowed my pride sooner."
    "Magia naprawdę przychodzi o wiele łatwiej z czystym umysłem! Gdybym tylko przełknął dumę wcześniej."

# game/script.rpy:3653
translate pl ch7_1e30c6c5:

    # "I completed batch after batch almost effortlessly, going down the long checklist Astragalus had given me..."
    "Bez trudu kończyłem partię za partią, powoli kończąc też długą listę podarowaną mi przez Tragankę..."

# game/script.rpy:3654
translate pl ch7_ba772060:

    # "I hadn't even felt tired by the end of it. As if all this energy had been stored up inside me all along!"
    "Ani trochę mnie to nie zmęczyło. Cała ta energia kryła się we mnie przez cały czas!"

# game/script.rpy:3655
translate pl ch7_2d728c30:

    # nvl clear
    # "It was a relief to return to somewhat normalcy."
    nvl clear
    "Poczułem ulgę wracając do normalności."

# game/script.rpy:3657
translate pl ch7_e65838f7:

    # "Thinking of Pastille no longer caused my heart to ache... at least, not enough to put me in a state of total despondence."
    "Myślenie o Pastylku już nie sprawiało, że w moim sercu budził się ból... przynajmniej nie taki, który mnie kompletnie przybijał."

# game/script.rpy:3658
translate pl ch7_b8bdf17b:

    # "Instead, those thoughts served as motivation. The way forward was clear."
    "Zamiast tego, te myśli mnie motywowały. Droga naprzód była prosta."

# game/script.rpy:3659
translate pl ch7_975f7c4e:

    # "I would tell him how I felt... and surely..."
    "Powiem mu, co czuję... i na pewno..."

# game/script.rpy:3660
translate pl ch7_38f5635f:

    # nvl clear
    # w pj calm "Surely things will turn out just fine...."
    nvl clear
    w pj calm "Na pewno pójdzie jak po maśle..."

# game/script.rpy:3665
translate pl ch7_94b11f24:

    # n "The following night... Pastille shows up on Periwinkle's doorstep."
    n "Następnej nocy... Pastylek pojawia się w drzwiach Barwinka."

# game/script.rpy:3667
translate pl ch7_1810d3ec:

    # p "Get dressed. I wanna take you somewhere."
    p "Ubieraj się. Chcę cię gdzieś zabrać."

# game/script.rpy:3668
translate pl ch7_89d40548:

    # w pj happy "Oh~ and where exactly am I being whisked away to? 💙"
    w pj happy "Och~ Gdzie mnie porywasz? 💙"

# game/script.rpy:3669
translate pl ch7_f5ebb1d6:

    # p happy "You'll see. Wear comfortable shoes, okay?"
    p happy "Zobaczysz. Ubierz wygodne buty, dobrze?"

# game/script.rpy:3670
translate pl ch7_cd6c9ac9:

    # w calm "How mysterious..."
    w calm "Tajemniczo..."

# game/script.rpy:3671
translate pl ch7_c60adcac:

    # w smile "Hmhm, very well. I'll be ready momentarily 💙"
    w smile "Hmhm, dobrze. Będę gotowy w moment 💙"

# game/script.rpy:3674
translate pl ch7_98348ebf:

    # "This is it..."
    "Proszę bardzo..."

# game/script.rpy:3675
translate pl ch7_09cbb0da:

    # "The dramatic confession scene is upon us!"
    "Oto nadchodzi chwila dramatycznego wyznania!"

# game/script.rpy:3676
translate pl ch7_e135b4c9:

    # "I have to look my best! For good luck, of course."
    "Muszę wyglądać jak najlepiej! Na szczęście, oczywiście."

# game/script.rpy:3677
translate pl ch7_572f99bc:

    # "And for confidence...."
    "I dla pewności siebie..."

# game/script.rpy:3678
translate pl ch7_76b2fe88:

    # nvl clear
    nvl clear

# game/script.rpy:3690
translate pl ch7_28d525bc:

    # n "Hand in hand, the pair makes their way to the train station."
    n "Ramię w ramię, dwójka kieruje się w stronę stacji kolejowej."

# game/script.rpy:3691
translate pl ch7_931bcf8a:

    # w cute innocent "(Hmhm~ had he been planning something while I was sequestered away with my work?)"
    w cute innocent "(Hmhm~ Czyżby coś planował, kiedy ja byłem zajęty pracą?)"

# game/script.rpy:3692
translate pl ch7_db582720:

    # w love "(Pastille is always so full of surprises... how positively delightful 💙)"
    w love "(Pastylek zawsze mnie zaskakuje... Co pozytywnie czarujące 💙)"

# game/script.rpy:3695
translate pl ch7_b5146a9c:

    # p "I hope I didn't interrupt any plans you had for the night...."
    p "Mam nadzieję, że w niczym ci nie przeszkodziłem..."

# game/script.rpy:3696
translate pl ch7_028375c7:

    # w happy "Oh, not at all~! It was about time I got out of the house again."
    w happy "Och, nie martw się~! Najwyższy czas, żebym znów wyszedł z domu."

# game/script.rpy:3697
translate pl ch7_dd0f85ec:

    # w smile "I've actually had a very productive past several days, you know. Toiling away over my perfumes."
    w smile "Ostatnie kilka dni spędziłem dość produktywnie. Pracowałem nad perfumami."

# game/script.rpy:3698
translate pl ch7_dcf1b0e8:

    # p ehe "Haha, I thought that might be the case, since you hadn't dropped by in a while."
    p ehe "Haha, tak myślałem, skoro nie odwiedziłeś mnie od kilku dni."

# game/script.rpy:3699
translate pl ch7_fb3a840a:

    # w innocent "Did you miss me? 💙"
    w innocent "Tęskniłeś? 💙"

# game/script.rpy:3700
translate pl ch7_13104245:

    # p embarrassed "W-well...."
    p embarrassed "C-cóż..."

# game/script.rpy:3702
translate pl ch7_b1056d27:

    # n "Periwinkle hugs Pastille's arm tightly as they continue their walk."
    n "Barwinek przytula ramię Pastylka podczas reszty drogi."

# game/script.rpy:3703
translate pl ch7_9e455bb5:

    # w cute shy "(I missed you, too...)"
    w cute shy "(Też tęskniłem...)"

# game/script.rpy:3706
translate pl ch7_92a9892d:

    # "When Pastille and I step off the train, we're greeted by grassy fields and a sky full of luminous stars."
    "Gdy wychodzimy z pociągu, witają nas wielkie pola i niebo przepełnione jasnymi gwiazdami."

# game/script.rpy:3707
translate pl ch7_1242c23a:

    # "Just where has he taken me...?"
    "Gdzież on mnie zabrał...?"

# game/script.rpy:3708
translate pl ch7_924bc4f2:

    # "A trail of lanterns lights the lone path forward..."
    "Szlak latarni oświetla samotną ścieżkę..."

# game/script.rpy:3709
translate pl ch7_27428714:

    # "Pastille takes the lead."
    "Pastylek przejmuje prowadzenie."

# game/script.rpy:3710
translate pl ch7_76b2fe88_1:

    # nvl clear
    nvl clear

# game/script.rpy:3713
translate pl ch7_794d51f4:

    # p "It's a bit of a walk from here... but I promise it'll be worth it."
    p "Trzeba trochę przejść... ale obiecuję, warto."

# game/script.rpy:3714
translate pl ch7_dd9f0107:

    # w cute love "A long walk, hm? Couldn't we take a ride on your broom together~?"
    w cute love "Długi spacer, hm? Nie mogliśmy przelecieć się twoją miotłą~?"

# game/script.rpy:3715
translate pl ch7_6e405e15:

    # p sure "Nah, it'd defeat the purpose. It'll feel more rewarding getting there on foot."
    p sure "Nie, to nie miałoby sensu. Dojście tam na nogach da nam satysfakcję."

# game/script.rpy:3716
translate pl ch7_ebba887b:

    # w calm "Hmhm... fair enough. Tragic, though, that you'd willingly pass on an opportunity for me to cling to you."
    w calm "Hmhm... niech będzie. Tragiczne, niestety, że dobrowolnie przepuściłeś okazję przytulania mnie."

# game/script.rpy:3717
translate pl ch7_34a0afcc:

    # p ehe "Haha, we can fly on the way back if you want."
    p ehe "Haha, z powrotem możemy lecieć, jeśli chcesz."

# game/script.rpy:3719
translate pl ch7_4f263e5f:

    # n "Pastille offers his hand again, which Periwinkle takes with a smile."
    n "Pastylek znów wyciąga dłoń, którą Barwinek z uśmiechem bierze w swoją."

# game/script.rpy:3724
translate pl ch7_59ddd814:

    # w "...Tell me more about your relationship with magic."
    w "...Opowiedz mi więcej o twojej relacji z magią."

# game/script.rpy:3725
translate pl ch7_2528ce76:

    # p "Hm? What do you mean?"
    p "Hm? Co masz na myśli?"

# game/script.rpy:3726
translate pl ch7_3c167982:

    # w "It was the same when we cleaned my house together. You insisted on doing things manually..."
    w "Kiedy sprzątaliśmy razem mój dom, nalegałeś, by wszystko robić ręcznie..."

# game/script.rpy:3727
translate pl ch7_7c5e0bd7:

    # w "Not that I minded at all. Seeing you lift so many heavy things was a treat in itself 💙"
    w "Ale to nie tak, że mi to przeszkadza. Patrzenie, jak przenosisz wszystkie te ciężkie rzeczy było samą przyjemnością 💙"

# game/script.rpy:3728
translate pl ch7_4caf8895:

    # p "Hahaha, well..."
    p "Hahaha, cóż..."

# game/script.rpy:3729
translate pl ch7_10f7805a:

    # p "Ever since I was young... it was clear I was, um... \"ridiculously talented\", as they'd put it."
    p "Odkąd byłem dzieckiem... wiadomym było, że, um... byłem \"wprost absurdalnie utalentowany\", jak mawiano."

# game/script.rpy:3730
translate pl ch7_e85247dc:

    # p "My moms wanted me to be a traditional witch. They enrolled me in one of the top schools, so I could learn from the best."
    p "Moje mamy chciały, żebym był tradycyjnym czarodziejem."
    p "Zapisały mnie do jednej z najlepszych istniejących szkół, żebym mógł uczyć się od najlepszych."

# game/script.rpy:3732
translate pl ch7_0b59e908:

    # p "I-it was an all-girls school, though... Guess I was young enough that no one realized I was a boy."
    p "T-to była szkoła dla dziewcząt... Chyba byłem na tyle młody, że nikt nie zauważył że byłem chłopcem."

# game/script.rpy:3733
translate pl ch7_c1703821:

    # p "I really... didn't belong there. On any level."
    p "Tak naprawdę... nie potrafiłem się odnaleźć. Wcale."

# game/script.rpy:3734
translate pl ch7_fa8d2d79:

    # p "But, I kept at it as long as I could. Just enough to keep my parents happy, until I could go out and live on my own."
    p "Ale wytrzymałem ile mogłem. Tyle, by moi rodzice byli szczęśliwi, do momentu, gdy mogłem się wyprowadzić i żyć jak chciałem."

# game/script.rpy:3736
translate pl ch7_73d8e924:

    # p "Haha, I still don't understand exactly why... but I always felt uncomfortable using my magic."
    p "Haha, nadal nie rozumiem, dlaczego... ale nigdy nie czułem się komfortowo z moją magią."

# game/script.rpy:3737
translate pl ch7_b1a584dd:

    # p "It felt like cheating. Like... this kind of power shouldn't come so easily."
    p "Czułem się jak oszust. Jakby... taka moc nie miała prawa przychodzić tak łatwo."

# game/script.rpy:3738
translate pl ch7_f94b0797:

    # p "Sy thought so, too. I guess that's why I latched onto her when we met..."
    p "Sy też tak sądziła. To chyba dlatego tak się do niej przywiązałem, gdy ją poznałem..."

# game/script.rpy:3739
translate pl ch7_b940b2af:

    # p "She used to really hate magic. Which worked out perfectly for me--it was a good excuse to pretend to be a regular human like her."
    p "Kiedyś naprawdę nienawidziła magii. Co dla mnie było wspaniałe -"
    p "Dawało idealną wymówkę, by udawać, że jestem zwykłym człowiekiem jak ona."

# game/script.rpy:3740
translate pl ch7_e058bb72:

    # p "So... that's what I did. For the past... seven years?"
    p "Więc... to właśnie robiłem. Przez ostatnie... siedem lat?"

# game/script.rpy:3743
translate pl ch7_fe2bf237:

    # w cute my "Seven years... that's quite a long time!"
    w cute my "Siedem lat... to bardzo długo!"

# game/script.rpy:3745
translate pl ch7_4d057338:

    # p "Yeah, but there was a lot to distract me back then... it took a while to get Atelier Sweets up and running."
    p "Tak, ale wiele rzeczy mnie rozpraszało... Trochę zajęło rozkręcenie Atelier Sweets, rozumiesz."

# game/script.rpy:3746
translate pl ch7_dc3c7909:

    # p calm "And... Sy did eventually find out. I thought she'd disown me when she did..."
    p calm "I... Sy w końcu się dowiedziała. Myślałem, że mnie znienawidzi..."

# game/script.rpy:3747
translate pl ch7_c13fd2df:

    # p ehe "But instead... she told me I shouldn't have hid it. Even though I doubt we would've become friends if I told her from the beginning..."
    p ehe "Ale zamiast tego... powiedziała, że nie powinienem był się ukrywać."
    p "Mimo że nie wydaje mi się, że zostalibyśmy przyjaciółmi, gdyby wiedziała od początku..."

# game/script.rpy:3748
translate pl ch7_53e2aed6:

    # w calm "Quite impossible to please, hm?"
    w calm "Trudno ją uszczęśliwić, co?"

# game/script.rpy:3749
translate pl ch7_03a0e69e:

    # p sure "You have no idea...."
    p sure "Nawet nie masz pojęcia..."

# game/script.rpy:3750
translate pl ch7_6dc476af:

    # p smile "But... ever since she said that, I've been able to start embracing magic again. On my own terms."
    p smile "Ale... odkąd mi to powiedziała, uczę się od nowa korzystać z magii. Wedle własnych zasad."

# game/script.rpy:3751
translate pl ch7_3832c226:

    # w "(I'm beginning to grasp why he values her so highly...)"
    w "(Zaczynam rozumieć, dlaczego tak wysoko ceni Syrop...)"

# game/script.rpy:3752
translate pl ch7_ff5b5b21:

    # p ohno "Um, sorry that I just keep talking about myself...."
    p ohno "Um, przepraszam, że tak mówię tylko o sobie..."

# game/script.rpy:3753
translate pl ch7_d3905dce:

    # w happy "Don't apologize~! I'm the one who asked."
    w happy "Nie przepraszaj~! To ja zapytałem."

# game/script.rpy:3754
translate pl ch7_7c140cec:

    # w smile "Besides, I'm content to listen. Say as much as you like."
    w smile "Poza tym, miło się ciebie słucha. Mogę to robić ile tylko chcesz."

# game/script.rpy:3755
translate pl ch7_acb13031:

    # p embarrassed "Thanks...."
    p embarrassed "Dziękuję..."

# game/script.rpy:3758
translate pl ch7_ea22c411:

    # n "Periwinkle gives Pastille's hand a reassuring squeeze."
    n "Barwinek próbuje dodać Pastylkowi otuchy, ściskając jego dłoń."

# game/script.rpy:3760
translate pl ch7_6ce8c1d1:

    # "I love him..."
    "Kocham go..."

# game/script.rpy:3761
translate pl ch7_aa288728:

    # "I have to find the right moment to tell him that."
    "Muszę poczekać na odpowiedni moment, by mu powiedzieć."

# game/script.rpy:3762
translate pl ch7_973b0143:

    # "Should it be now? During this romantic walk?"
    "Czy to teraz? Podczas tego spaceru?"

# game/script.rpy:3763
translate pl ch7_34c7c040:

    # "Ah, but he still has yet to reveal our destination..."
    "Ach, ale nadal nie wyjawił celu naszej podróży..."

# game/script.rpy:3764
translate pl ch7_87cfcf28:

    # "What do you have in store for me, Pastille...?"
    "Co nas czeka, Pastylku...?"

# game/script.rpy:3765
translate pl ch7_76b2fe88_2:

    # nvl clear
    nvl clear

# game/script.rpy:3768
translate pl ch7_cd548b59:

    # p "I think I might be too used to how Sy is... she's usually so preoccupied with her own stuff."
    p "Chyba jestem zbyt przyzwyczajony do charakteru Sy... Zazwyczaj jest zajęta swoimi własnymi sprawami."

# game/script.rpy:3769
translate pl ch7_e4e3ea32:

    # p smile "So it's nice... having someone who actually wants to listen to me."
    p smile "Więc miło jest... mieć kogoś, kto naprawdę chce mnie słuchać."

# game/script.rpy:3770
translate pl ch7_63040b81:

    # p flustered2 "Agh, that makes her sound like such a horrible friend...! She's really not!!" with vpunch
    p flustered2 "Ach, mówię o niej, jakby była okropną przyjaciółką...! Naprawdę tak nie jest!!!" with vpunch

# game/script.rpy:3771
translate pl ch7_0bd17d69:

    # w cute happy "You certainly haven't made a convincing case for her~!"
    w cute happy "Zdecydowanie nie przedstawiłeś przekonujących argumentów~!"

# game/script.rpy:3772
translate pl ch7_92bac40c:

    # p calm "*sigh* I know. But that wasn't the point I was trying to make..."
    p calm "*westchnienie* Wiem. Ale nie o to mi chodziło..."

# game/script.rpy:3773
translate pl ch7_cb1d6efd:

    # w oh "Oh?"
    w oh "Och?"

# game/script.rpy:3774
translate pl ch7_6f213e95:

    # p ohno2 "I really...!"
    p ohno2 "Ja bardzo...!"

# game/script.rpy:3775
translate pl ch7_2ddcc144:

    # p flustered2 "...."
    p flustered2 "..."

# game/script.rpy:3776
translate pl ch7_5793c0e9:

    # w love "Yes...?"
    w love "Tak...?"

# game/script.rpy:3777
translate pl ch7_bd8caf25:

    # p seriously "Let me start over."
    p seriously "Niech zacznę od początku."

# game/script.rpy:3780
translate pl ch7_4457e2ee:

    # n "Pastille takes a deep breath before continuing..."
    n "Pastylek bierze głęboki wdech..."

# game/script.rpy:3781
translate pl ch7_3c52a2e3:

    # p wha "Going back to... what we were talking about before. With my magic and everything."
    p wha "Wracając do... wcześniejszego tematu rozmowy. Mojej magii."

# game/script.rpy:3782
translate pl ch7_b651cf3a:

    # p think "I think I have trouble accepting myself for what I am... I tend to hide things, even when I don't need to."
    p think "Chyba ciężko mi zaakceptować to, jaki jestem... Mam skłonność do ukrywania pewnych rzeczy, mimo że tego nie chcę."

# game/script.rpy:3783
translate pl ch7_8c631518:

    # p oh "Being with YOU feels like... it's better not to hide? Like, I'm allowed to just BE."
    p oh "Bycie z TOBĄ wydaje się... czymś, czego nie chcę ukrywać? Jakby wolno mi było po prostu BYĆ."

# game/script.rpy:3784
translate pl ch7_bd2d007a:

    # p shy "Or, more like... celebrated? For being? I-I don't know, that feels weird to say."
    p shy "Albo może jakbym powinienem... to czcić? Bycie? N-nie wiem, to brzmi dziwnie."

# game/script.rpy:3785
translate pl ch7_f3a624fa:

    # w cute wow "...."
    w cute wow "..."

# game/script.rpy:3786
translate pl ch7_a1e89604:

    # p ehe "Y-you can stop me if I'm being too much...."
    p ehe "M-możesz mi przerwać, jeśli mówię za wiele..."

# game/script.rpy:3787
translate pl ch7_cb9e5642:

    # w nofair2 "(IT'S BECAUSE I LOVE YOU...! Why can't I just say that...?!)" with vpunch
    w nofair2 "(NIE MOGĘ, BO CIĘ KOCHAM...! Dlaczego nie mogę po prostu tego powiedzieć...?!)" with vpunch

# game/script.rpy:3789
translate pl ch7_0e54bcb0:

    # p smile "Oh! We're here!"
    p smile "Och! Oto jesteśmy!"

# game/script.rpy:3790
translate pl ch7_f344f25d:

    # w my "W-we are...?"
    w my "J-jesteśmy...?"

# game/script.rpy:3799
translate pl ch7_01fc1362:

    # "When we came up over the hill..."
    "Gdy stanęliśmy na szczycie wzgórza..."

# game/script.rpy:3800
translate pl ch7_5d572078:

    # "The vastness of the night sky overwhelmed me."
    "Bezkres nocnego nieba mnie obezwładnił."

# game/script.rpy:3801
translate pl ch7_38f127a1:

    # "But more than that..."
    "Ale to nie koniec..."

# game/script.rpy:3802
translate pl ch7_6294189d:

    # "The field of small blue flowers, that stretched as far as the eye could see..."
    "Pole małych, niebieskich kwiatów, które rozciągało się tak daleko, jak sięgało ludzkie oko..."

# game/script.rpy:3803
translate pl ch7_69330f7d:

    # "Matched it so perfectly."
    "Tak idealnie do niego pasowało."

# game/script.rpy:3804
translate pl ch7_76b2fe88_3:

    # nvl clear
    nvl clear

# game/script.rpy:3808
translate pl ch7_c19eb018:

    # w cute shock "Pastille...!"
    w cute shock "Pastylku...!"

# game/script.rpy:3811
translate pl ch7_00d275ec:

    # p "They're periwinkles. When I looked up where to find some... I found out about this place."
    p "To barwinki. Kiedy szukałem, gdzie można je znaleźć... Dowiedziałem się o tym miejscu."

# game/script.rpy:3812
translate pl ch7_36ad9faf:

    # p doki "A-apparently it's a famous date spot... I thought you'd like to see it, so...."
    p doki "P-ponoć to sławne miejsce na randki... Pomyślałem, że chciałbyś je zobaczyć, więc..."

# game/script.rpy:3814
translate pl ch7_3d805e46:

    # w "I... I-I...!"
    w "Ja... J-ja...!"

# game/script.rpy:3815
translate pl ch7_8adde88a:

    # w whine2 "I shouldn't have told you I'm weak to romance...!! Pastille!!!" with vpunch
    w whine2 "Nie powinienem był ci mówić, że romantyczność to moja słabość...!!! Pastylku!!!" with vpunch

# game/script.rpy:3819
translate pl ch7_05c9cbbc:

    # n "A glint catches Periwinkle's eye,{nw}"
    n "Barwinek kątem oka zauważa błysk,{nw}"

# game/script.rpy:3821
translate pl ch7_a8567a09:

    # extend " and he looks up to notice... a meteor shower has begun."
    extend " a gdy podnosi wzrok, widzi... że zaczął się deszcz meteorytów."

# game/script.rpy:3823
translate pl ch7_73f1a48a:

    # w my "Ah...!"
    w my "Ach...!"

# game/script.rpy:3824
translate pl ch7_559af831:

    # p happy "Oh, good! It started just in time...."
    p happy "Och, świetnie! Zaczął się na czas..."

# game/script.rpy:3825
translate pl ch7_060caff3:

    # w shock "You planned this, too?!" with vpunch
    w shock "To też zaplanowałeś?!" with vpunch

# game/script.rpy:3826
translate pl ch7_a08d1d6b:

    # p embarrassed "Well, I knew this was supposed to be happening tonight... so...."
    p embarrassed "Cóż, wiedziałem, że podobno ma się to stać dzisiaj... więc..."

# game/script.rpy:3831
translate pl ch7_e01493c6:

    # w overwhelmed "PASTILLE!!!!!!!"
    w overwhelmed "PASTYLEK!!!!!!"

# game/script.rpy:3833
translate pl ch7_b1a81c31:

    # p "WAH--!!" with vpunch
    p "ACH-!!!" with vpunch

# game/script.rpy:3838
translate pl ch7_e7ad4e10:

    # n "Periwinkle tackles Pastille to the ground, landing them in the field of flowers..."
    n "Barwinek powala Pastylka na ziemię, lądując w polu kwiatów..."

# game/script.rpy:3842
translate pl ch7_993f86f6:

    # w "This is perfect..."
    w "To wszystko idealne..."

# game/script.rpy:3843
translate pl ch7_29d90c6e:

    # w "I-I don't know what else to say...! I'm speechless...."
    w "N-nie wiem co mam powiedzieć...! Odjęło mi mowę..."

# game/script.rpy:3844
translate pl ch7_74dc2d6c:

    # p "Haha, I guess I went a little overboard...."
    p "Haha, może trochę przesadziłem..."

# game/script.rpy:3845
translate pl ch7_71a07f4f:

    # w "A little?! This is the most romantic thing anyone's ever done for me!!!" with vpunch
    w "Trochę? To najbardziej romantyczna rzecz, którą ktokolwiek kiedykolwiek dla mnie zrobił!!!" with vpunch

# game/script.rpy:3846
translate pl ch7_e978b8e5:

    # n "He buries his face in Pastille's chest, holding him close."
    n "Chowa twarz w piersi Pastylka, trzymając go blisko siebie."

# game/script.rpy:3847
translate pl ch7_16aecb80:

    # p "Well... there's actually... one more thing I wanted to say."
    p "Cóż... jest jeszcze... coś, co chciałbym powiedzieć."

# game/script.rpy:3849
translate pl ch7_2f9a6199:

    # n "He can feel Pastille's heart pounding."
    n "Czuje bicie serca Pastylka."

# game/script.rpy:3850
translate pl ch7_3890f9c5:

    # p "Ahh, where do I start... um...."
    p "Ach, gdzie mam zacząć... Um..."

# game/script.rpy:3851
translate pl ch7_e74b39bd:

    # p "You know how... Sy and Gumdrop are really important to me?"
    p "Wiesz, że... Sy i Żelka są dla mnie bardzo ważne?"

# game/script.rpy:3852
translate pl ch7_d67e120d:

    # p "I always thought that I needed to keep myself available for them. To take care of the store and everything."
    p "Zawsze myślałem, że muszę być pod ręką, dla nich. Zajmować się sklepem i w ogóle."

# game/script.rpy:3853
translate pl ch7_2ebc1e5f:

    # p "But in practice, that just meant... I never really took any time for myself."
    p "Ale w rzeczywistości oznaczało to... że nigdy nie miałem czasu dla siebie."

# game/script.rpy:3854
translate pl ch7_dc57cb02:

    # p "Like, my own needs were something I could just bury, and it would be fine... because it's for their sake."
    p "Znaczy, moje własne potrzeby stanowiły coś, co mogłem ignorować, i wszystko było w porządku... bo chciałem je wspierać."

# game/script.rpy:3856
translate pl ch7_3e7da720:

    # p "I guess that's part of why... I'd go out with random guys in secret. As something just for me, totally detached from everything else."
    p "To chyba dlatego... potajemnie spotykam się z przypadkowymi mężczyznami."
    p "To coś tylko dla mnie, kompletnie niepowiązane z innymi rzeczami, którymi się zajmuję."

# game/script.rpy:3857
translate pl ch7_a24acfbd:

    # p "I tried... having a real relationship once. It didn't work out, obviously. I-I never told Sy about him..."
    p "Kiedyś... próbowałem wejść w prawdziwy związek. Nie wyszło nam, oczywiście. I-i nigdy nie powiedziałem o nim Sy..."

# game/script.rpy:3858
translate pl ch7_4e3c6695:

    # p "But that made me think... that I was right to continue on the way I had been. Since I wasn't willing to let my priorities shift."
    p "I to mi dało do myślenia... zacząłem się zastanawiać, czy powinienem to wszystko kontynuować."
    p "Skoro nie jestem w stanie zmienić priorytetów."

# game/script.rpy:3859
translate pl ch7_03dafb87:

    # n "Periwinkle grips Pastille's cloak a little tighter."
    n "Barwinek chwyta płaszcz Pastylka nieco mocniej."

# game/script.rpy:3860
translate pl ch7_8f89c97b:

    # w "Wh-what are you saying...?"
    w "O cz-czym mówisz...?"

# game/script.rpy:3861
translate pl ch7_ed9ffa87:

    # p "I guess, um... that, with you... I don't mind it as much."
    p "Chyba, um... o tym, że z tobą... się tym za bardzo nie przejmuję."

# game/script.rpy:3868
translate pl ch7_1b31e9f8:

    # "H-he's... he's going to beat me to it at this rate!!"
    "O-on... Jak dalej tak pójdzie, będzie pierwszy!!!"

# game/script.rpy:3869
translate pl ch7_5760d7ef:

    # "I-I can't let that happen...!"
    "N-nie mogę na to pozwolić...!"

# game/script.rpy:3870
translate pl ch7_e860da44:

    # nvl clear
    # n "Periwinkle suddenly rolls himself on top of Pastille, pinning him down."
    nvl clear
    n "Nagle Barwinek przekręca się na Pastylka, trzymając go w miejscu."

# game/script.rpy:3875
translate pl ch7_e3a3d605:

    # w "Pastille, I'm in love with you!!!"
    w "Pastylku, kocham cię!!!"

# game/script.rpy:3876
translate pl ch7_3353d4b4:

    # p "Wh-wha--??!?!? S-since when?!" with vpunch
    p "C-co-?!?!?! O-od kiedy?!" with vpunch

# game/script.rpy:3878
translate pl ch7_d08ef308:

    # w "I-I don't know, maybe this whole time?!"
    w "N-nie wiem, może od zawsze?!"

# game/script.rpy:3879
translate pl ch7_fc9fe40d:

    # w "I only admitted it to myself that morning you made me pancakes...."
    w "Przyznałem to przed sobą tego ranka, gdy zrobiłeś mi naleśniki..."

# game/script.rpy:3881
translate pl ch7_69ecef14:

    # p "That's what it took..?"
    p "Tyle wystarczyło...?"

# game/script.rpy:3882
translate pl ch7_72ea541b:

    # w "Why? How long have YOU felt this way?"
    w "Dlaczego? Od kiedy TY się tak czujesz?"

# game/script.rpy:3884
translate pl ch7_1e470d14:

    # p "Since... having to carry you home, after spending the day together? I think that's when I first realized it..."
    p "Odkąd... odniosłem cię do domu, spędziliśmy razem dzień? Chyba wtedy doszłem do takiego wniosku..."

# game/script.rpy:3885
translate pl ch7_f1180398:

    # w "Then why didn't you say something?! I've been suffering in silence this entire time...!" with vpunch
    w "To dlaczego nic nie mówiłeś?! Przez cały ten czas cierpiałem w ciszy...!" with vpunch

# game/script.rpy:3887
translate pl ch7_350e8d77:

    # p "I-I thought you wanted to keep it casual...?"
    p "M-myślałem, że chciałeś niezobowiązującej relacji...?"

# game/script.rpy:3888
translate pl ch7_2ded0261:

    # w "We saw each other almost every day!! How is that casual?!"
    w "Widywaliśmy się niemal każdego dnia!!! Jak to ma być niezobowiązujące?!"

# game/script.rpy:3889
translate pl ch7_8f5651d3:

    # p "But you never acted any differently...! A-and I was busy sorting through my own feelings anyway...."
    p "Ale nigdy nie zmieniłeś zachowania...! A-a ja byłem zajęty porządkowaniem własnych uczuć..."

# game/script.rpy:3891
translate pl ch7_8cca7f14:

    # w "Mmmnnnnnn...!!!!!!! So was I...."
    w "Mmmnnnnnn...!!!!!!! Tak samo jak ja..."

# game/script.rpy:3892
translate pl ch7_56b8e860:

    # w "But that's no excuse for how long you kept me waiting...! I-I won't forgive you!"
    w "Ale to żadna wymówka na to, jak długo kazałeś mi czekać...! N-nie wybaczę ci!"

# game/script.rpy:3894
translate pl ch7_d5c67421:

    # p "...."
    p "..."

# game/script.rpy:3895
translate pl ch7_47bd51eb:

    # w "Wh-what...? Why are you smiling like that?"
    w "C-co...? Czemu tak się uśmiechasz?"

# game/script.rpy:3896
translate pl ch7_fbb1d3e9:

    # p "It's cute... seeing you all worked up like this."
    p "To urocze... jak bardzo się tym przejmujesz."

# game/script.rpy:3897
translate pl ch7_ae85e999:

    # w "--!!"
    w "--!!!"

# game/script.rpy:3900
translate pl ch7_ed75769f:

    # n "Periwinkle struggles to his feet and begins stomping away."
    n "Barwinek wstaje z trawy i zaczyna podróż na dół."

# game/script.rpy:3902
translate pl ch7_f6c38887:

    # w cute nofair2 "Y-you could've saved me a lot of heartache, you know...!"
    w cute nofair2 "M-mogłeś mi oszczędzić bólu serca, wiesz...!"

# game/script.rpy:3903
translate pl ch7_7dc24b88:

    # n "Pastille sits up, straightening out his cloak and retrieving his hat."
    n "Pastylek siada, wygładzając płaszcz i podnosząc kapelusz."

# game/script.rpy:3906
translate pl ch7_ff9468ab:

    # p "Where are you going...? Come back."
    p "Gdzie idziesz...? Wracaj."

# game/script.rpy:3907
translate pl ch7_f6894d83:

    # w nofair "No!! I'm too upset!" with vpunch
    w nofair "Nie!!! Jestem zdenerwowany!" with vpunch

# game/script.rpy:3908
translate pl ch7_ff48b4a6:

    # p ehe "Peri...."
    p ehe "Inek..."

# game/script.rpy:3909
translate pl ch7_34963f72:

    # w yell "I was convinced... CONVINCED, that I'd cursed myself with some kind of love potion! My fake aphrodisiac turned real!"
    w yell "Byłem pewny... PEWNY, że przez przypadek rzuciłem na siebie zaklęcie miłosne! Że mój wymyślony afrodyzjak zaczął działać!"

# game/script.rpy:3910
translate pl ch7_c9c42113:

    # p "What in the world...?"
    p "Co takiego...?"

# game/script.rpy:3911
translate pl ch7_ca056bf8:

    # w "Because we didn't fuck that day! Fucking was supposed to be the entire point of it!!" with vpunch
    w "Bo cię tego dnia nie przeleciałem! Seks miał być przecież całym sensem całej sytuacji!!!" with vpunch

# game/script.rpy:3912
translate pl ch7_03d3511b:

    # p dying "P-PERI...!"
    p dying "I-INEK...!"

# game/script.rpy:3913
translate pl ch7_21cbb225:

    # w nofair2 "Everything spiraled out of control since then...! I couldn't stop thinking about you!!"
    w nofair2 "Wszystko uciekło spod kontroli...! Nie mogłem przestać o tobie myśleć!!!"

# game/script.rpy:3914
translate pl ch7_c400f965:

    # w yell "You BROKE my magic! For weeks and weeks, all I could conjure was that stupid peach blossom scent...!"
    w yell "ZEPSUŁEŚ moją magię! Przez tygodnie i tygodnie byłem w stanie tworzyć jedynie ten głupi brzoskwiniowy zapach...!"

# game/script.rpy:3915
translate pl ch7_b704fa44:

    # p woah "A-ah... really...?"
    p woah "A-ach... Serio...?"

# game/script.rpy:3916
translate pl ch7_b58af626:

    # w nofair2 "Yes! Until just the other day... which I spent CRYING, in the dusty back room of the apothecary, telling Astragalus all about it...!"
    w nofair2 "TAK! Do czasu... do dnia, który spędziłem na PŁACZU na zapleczu zakurzonej apteki, monologując przy Tragance...!"

# game/script.rpy:3917
translate pl ch7_03175381:

    # w nofair "After all that... everything I spent so long preparing my heart for... you have the NERVE to try to confess first...?!"
    w nofair "Po tym wszystkim... całym tym czasie spędzonym na przygotowywaniu mojego serca..."
    w "Masz CZELNOŚĆ wyznać to pierwszy...?!"

# game/script.rpy:3918
translate pl ch7_ea73974b:

    # p aw "I'm sorry."
    p aw "Przepraszam."

# game/script.rpy:3919
translate pl ch7_4abce74d:

    # w nofair2 "Don't apologize! I already said I won't forgive you!!" with vpunch
    w nofair2 "Nie przepraszaj! Już powiedziałem, nie wybaczę ci!!!" with vpunch

# game/script.rpy:3920
translate pl ch7_937c48a8:

    # p ehe "What do you want me to do, then...?"
    p ehe "Więc co mam zrobić...?"

# game/script.rpy:3921
translate pl ch7_2af101c3:

    # w insulted "I don't know, fucking kiss me if you love me so much!!!"
    w insulted "Nie wiem, cholera, pocałuj mnie skoro tak mnie kochasz!!!"

# game/script.rpy:3929
translate pl ch7_71e3c067:

    # n "Pastille approaches, gently raising a hand to Periwinkle's cheek..."
    n "Pastylek zbliża się do Barwinka i delikatnie unosi dłoń do jego policzka..."

# game/script.rpy:3931
translate pl ch7_c2b3fc7a:

    # n "...and does exactly as he's told."
    n "...i robi to, co mu kazano."

# game/script.rpy:3933
translate pl ch7_58024a15:

    # p "I love you."
    p "Kocham cię."

# game/script.rpy:3934
translate pl ch7_dde4b08e:

    # n "Periwinkle's heart skips a beat."
    n "Serce Barwinka wyrywa mu się z piersi."

# game/script.rpy:3936
translate pl ch7_2c91cb68:

    # w "I love you, too...!"
    w "Też cię kocham...!"

# game/script.rpy:3937
translate pl ch7_ff617e74:

    # n "He hugs Pastille tightly, careful not to knock him over this time."
    n "Mocno przytula Pastylka, uważając, by tym razem go nie przewrócić."

# game/script.rpy:3944
translate pl ch7_33de9d18:

    # "It takes everything I've got to keep myself from bursting into tears."
    "Ledwo jestem w stanie powstrzymać się od płaczu."

# game/script.rpy:3945
translate pl ch7_57e13493:

    # "I won't ruin my makeup on this perfect date...!"
    "Nie mogę zrujnować makijażu na jednej pięknej randce...!"

# game/script.rpy:3946
translate pl ch7_1c5f0457:

    # "This beautiful place, that Pastille chose just for us..."
    "To śliczne miejsce, które Pastylek wybrał tylko dla nas..."

# game/script.rpy:3947
translate pl ch7_bc3b2ea7:

    # "I can't have my memory of this perfect night obscured by tears...."
    "Nie mogę splamić tego wspomnienia łzami..."

# game/script.rpy:3948
translate pl ch7_76b2fe88_4:

    # nvl clear
    nvl clear

# game/script.rpy:3954
translate pl ch7_ec2dd684:

    # p "It looks like the meteor shower's over...."
    p "Wygląda na to, że deszcz meteorytów się skończył..."

# game/script.rpy:3955
translate pl ch7_75d5ddf8:

    # w cute pout "...Take me home...."
    w cute pout "...Chodźmy do domu..."

# game/script.rpy:3956
translate pl ch7_8bb2e9cd:

    # p ehe "A-are you still mad at me...?"
    p ehe "D-dalej jesteś na mnie zły...?"

# game/script.rpy:3957
translate pl ch7_5b794844:

    # w oops "I'm not mad at you...."
    w oops "Nigdy nie byłem..."

# game/script.rpy:3958
translate pl ch7_16f5b969:

    # p aw "I've never seen you like this. I don't know how else I should interpret it."
    p aw "Nigdy nie widziałem cię w takim stanie. Nie jestem pewien, jak mam to interpretować."

# game/script.rpy:3959
translate pl ch7_f5a91280:

    # w conflicted "I'm overwhelmed. Elated... relieved... and frustrated...."
    w conflicted "Czuję się przytłoczony. Wniebowzięty... podnieciony... i sfrustrowany..."

# game/script.rpy:3960
translate pl ch7_8b592c68:

    # w ohhh "I-I want to get in bed... so that you can hold me close all night..."
    w ohhh "Ch-chcę mieć cię w łóżku... trzymać cię blisko całą noc..."

# game/script.rpy:3961
translate pl ch7_ad678a44:

    # w ohhh2 "I don't think I'll be convinced that this was real unless you do that. So... please...?"
    w ohhh2 "I chyba nie będę do końca przekonany, że to wszystko jest prawdziwe, jeśli tak się nie stanie. Więc... proszę...?"

# game/script.rpy:3962
translate pl ch7_9cd2e04f:

    # p doki "That sounds... really nice...."
    p doki "To brzmi... bardzo dobrze..."

# game/script.rpy:3963
translate pl ch7_23f5322d:

    # p happy "Okay ❤ If it's to convince you, I guess I have no choice...."
    p happy "Dobrze ❤ Jeśli tylko to cię przekona, chyba nie mam wyboru..."

