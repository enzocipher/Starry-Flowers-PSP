# game/script.rpy:988
translate pl ch2_b61e07ce:

    # nvl clear
    # w neutral "This is all very sweet of you. But I do have to decline."
    nvl clear
    w neutral "To bardzo, bardzo miło z twojej strony, ale muszę odmówić."

# game/script.rpy:991
translate pl ch2_d6eb3267:

    # c letdown "Aww... I can't help but feel a little broken-hearted."
    c letdown "Ooch... to teraz czuję się, jakbyś trochę łamał mi serce."

# game/script.rpy:992
translate pl ch2_02d40560:

    # w decline "I apologize... Truly, it's nothing personal."
    w decline "Przepraszam... Naprawdę, to nic osobistego."

# game/script.rpy:993
translate pl ch2_cea46204:

    # c aww "Oh, I know~ I don't take offense or anything..."
    c aww "Och, wiem~ Nie uraziłeś mnie czy coś..."

# game/script.rpy:994
translate pl ch2_13fca6f4:

    # c letdown "It's just sad. Now that I'm going to be living with them... and, knowing you don't want to meet them..."
    c letdown "To tylko trochę smutne. Teraz, gdy będę z nimi mieszkać... a ty nie chcesz ich poznać..."

# game/script.rpy:995
translate pl ch2_82188b3a:

    # c sad "I think it's best we just break things off...."
    c sad "Chyba najlepiej będzie, jeśli zakończymy sprawę na dobre..."

# game/script.rpy:996
translate pl ch2_9b7a5305:

    # w neutral "Yes, I agree. As you said, it's for the best."
    w neutral "Tak, zgadzam się. Tak jak mówisz, będzie najlepiej."

# game/script.rpy:997
translate pl ch2_22bfa56a:

    # c aww "I hope we can still be friends, though~"
    c aww "Ale mam nadzieję, że dalej będziemy przyjaciółmi~"

# game/script.rpy:998
