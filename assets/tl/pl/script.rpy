    w calm "Uwielbiam tę atmosferę. Jedzenie także jest niczego sobie."

# game/script.rpy:426
translate pl start_db213eb7:

    # w smile "Now, let's get a few formalities out of the way, shall we? First and foremost... your pronouns?"
    w smile "Dobrze, więc miejmy podstawowe pytania za sobą, co ty na to? Po pierwsze... zaimki?"

# game/script.rpy:427
translate pl start_a5b368da:

    # p oh "Oh, um, I just use he/him. What about you?"
    p oh "Och, um, tylko on/jego. A ty?"

# game/script.rpy:428
translate pl start_e13d1dc4:

    # w calm "The same. Though I don't necessarily mind being called by others... especially considering my presentation."
    w calm "Tak samo. Jednakże niespecjalnie przejmuję się, gdy ktoś używa innych... biorąc pod uwagę mój wygląd."

# game/script.rpy:429
