    # n "One hand holds his mantle in place, while the other brushes his bangs aside anxiously..."
    n "Jedną ręką ściska swój płaszcz, drugą nieśmiało przeczesuje swoje włosy..."

# game/script.rpy:419
translate pl start_21398492:

    # w smile "Is this your first time?"
    w smile "Pierwszy raz?"

# game/script.rpy:420
translate pl start_db90c8f0:

