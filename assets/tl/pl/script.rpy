# game/script.rpy:999
translate pl ch2_96818197:

    # c happy "Yeah~! Thank you for always treating me so well, Periwinkle."
    c happy "Ta~! Dziękuję za to, jak dobrze zawsze mnie traktowałeś, Barwinek."

# game/script.rpy:1000
translate pl ch2_f9c0bf81:

