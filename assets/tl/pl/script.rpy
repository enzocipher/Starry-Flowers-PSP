translate pl ch2_cad66722:

    # "I suppose I'd forgotten the feeling of not being enough for someone."
    "Chyba zapomniałem, jakie to uczucie nie być dla kogoś wystarczającym."

# game/script.rpy:1032
translate pl ch2_fc6603e2:

    # "Usually these things tend to dissipate naturally, without confrontation or notice."
    "Zazwyczaj takie rzeczy odchodzą w zapomnienie same z siebie, bez konfrontacji czy zawiadomienia."

# game/script.rpy:1033
translate pl ch2_e7803a00:

    # "So when they don't... it stings."
