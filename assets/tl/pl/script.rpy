translate pl ch5_9af0cc6b:

    # w guilty "Whenever I tell myself I'll get to it later, I tend to leave it for days...."
    w guilty "Zawsze, gdy mówię sobie, że zajmę się tym później, zostawiam je tak na kilka dni..."

# game/script.rpy:2499
translate pl ch5_7561ad39:

    # n "But the single large pile he expected wasn't there. Instead, it was split in two, with one half already neatly folded..."
    n "Ale wielkiej sterty, której się spodziewał, nie ma. Zamiast niego zastaje dwa stosy, ubrania w jednym z nich starannie złożone..."

# game/script.rpy:2500
translate pl ch5_7ae4391f:

    # w my "Ah... I don't remember making this much progress...."
    w my "Ach... Nie przypominam sobie, bym poczynił tak wielki progres..."

# game/script.rpy:2501
translate pl ch5_8e27678f:

    # w insulted "N-no...! Pastille did this, didn't he?! When he came to pick me up yesterday!!" with vpunch
    w insulted "N-nie...! To sprawka Pastylka, czyż nie?! Zrobił to wczoraj, gdy po mnie przyszedł!!!" with vpunch

# game/script.rpy:2502
translate pl ch5_ebbaaa9d:

    # w oops "Curses... he's too good! I can't touch this right now...!"
    w oops "Cholera... Jest za dobry! Nie mogę teraz niczego dotknąć...!"

# game/script.rpy:2503
translate pl ch5_fabf3693:

    # n "Periwinkle covers the pile of neatly folded clothes with the rest of the unfolded ones in retaliation."
    n "W odwecie, Barwinek postanawia przykryć stos złożonych ubrań tymi, których Pastylek nie zdążył przeglądnąć."

# game/script.rpy:2504
translate pl ch5_7f95d5c9:

    # w aha "There. One less reminder to worry about."
    w aha "Już. Jedna pamiątka mniej."

# game/script.rpy:2505
translate pl ch5_6d9815d8:

    # w decline "Now I'm going to have to think of something else to do...."
    w decline "Teraz muszę wymyślić coś innego..."

# game/script.rpy:2510
translate pl ch5_99c1ff41:

    # "So far, my attempts at forgetting about Pastille have been completely futile."
    "Jak na razie moje próby zapomnienia o Pastylku okazują się być kompletnie daremne."

# game/script.rpy:2511
translate pl ch5_80ef4d03:

    # "But that's perfectly fine...! No one said it was going to be easy."
    "Ale to przecież w porządku...! Nikt nie mówił, że będzie łatwo."

# game/script.rpy:2512
translate pl ch5_9c18fb74:

    # "Ironically, the more you tell yourself NOT to think of something, the more your mind will be enticed by it...."
    "Okazuje się, dość ironicznie, iż im częściej powtarzasz sobie, by o czymś NIE myśleć, tym częściej zawracasz sobie tym głowę..."

# game/script.rpy:2513
translate pl ch5_896a9911:

    # nvl clear
    # "I mustn't let this consume me. I have to find a way to relax."
    nvl clear
    "Nie mogę pozwolić, by mną to władało. Muszę odnaleźć sposób, w jaki mogę się zrelaksować."

# game/script.rpy:2515
translate pl ch5_67f5662b:

    # "A nice bath should help to calm my nerves..."
    "Ciepła kąpiel pomogłaby mi opanować nerwy..."

# game/script.rpy:2516
translate pl ch5_76b2fe88_2:

    # nvl clear
    nvl clear

# game/script.rpy:2521
translate pl ch5_142a3147:

    # n "Later that evening..."
    n "Później tego wieczoru..."

# game/script.rpy:2523
translate pl ch5_b084a8a3:

    # w shutin happy "I'm feeling so refreshed, I could do just about anything~!"
    w shutin happy "Czuję się tak odświeżony, mogę wszystko~!"

# game/script.rpy:2524
translate pl ch5_bfecbb7d:

    # w smile "I should try cooking for myself tonight... Now THERE'S a task that'll require my full attention!"
    w smile "Może mógłbym dla siebie coś ugotować... TO zadanie, któremu potrzebna moja całkowita uwaga!"

# game/script.rpy:2525
translate pl ch5_5e931d21:

    # n "Periwinkle opens up the fridge for ideas..."
    n "Barwinek otwiera lodówkę, by znaleźć inspirację..."

# game/script.rpy:2526
translate pl ch5_eb1a4107:

    # w oh "A pint of milk. A few cups of yogurt, some eggs, whipped cream..."
    w oh "Pół litra mleka. Nieco jogurtu, kilka jajek, bita śmietana..."

# game/script.rpy:2527
translate pl ch5_a167090a:

    # w pout "There isn't much in the way of meals, is there? This is why I never cook..."
    w pout "Nie ma tu za wiele porządnych składników, prawda? To dlatego właśnie nigdy nie gotuję..."

# game/script.rpy:2528
translate pl ch5_c2f55194:

    # w happy "Ah, but I could try making an omelet! Breakfast for dinner~ oh, what fun~"
    w happy "Ach, ale mógłbym zrobić omlet! Śniadanie na obiad~ Och, cóż za frajda~"

# game/script.rpy:2531
translate pl ch5_b1019ee6:

    # n "Periwinkle cheerfully reaches for the eggs, then pauses."
    n "Barwinek sięga po jajka, lecz jego dłoń zatrzymuje się w drodze."

# game/script.rpy:2532
translate pl ch5_9393331d:

    # w shutin oh "...Actually. Can I cook without magic...?"
    w shutin oh "...Tak właściwie. Czy dam radę gotować bez magii...?"

# game/script.rpy:2533
translate pl ch5_94dffac0:

    # n "He turns to face the stove."
    n "Odwraca się w stronę kuchenki."

# game/script.rpy:2534
translate pl ch5_d5bc20eb:

    # w neutral "This burner... is the kind you'd light with a spell."
    w neutral "Ten palnik... zapala się tylko dzięki magii."

# game/script.rpy:2535
translate pl ch5_5df0ebaf:

    # w oops "I'm far too nervous my magic is going to come out smelling of peaches again..."
    w oops "Boję się, że moja magia znów będzie pachniała brzoskwiniami..."

# game/script.rpy:2536
translate pl ch5_f95e4a27_1:

    # w mad "...."
    w mad "..."

# game/script.rpy:2537
translate pl ch5_98438b48:

    # n "Periwinkle slams the fridge shut."
    n "Barwinek zamyka lodówkę."

# game/script.rpy:2538
translate pl ch5_04db34f2:

    # w innocent "Forget cooking! What was I thinking~? I'm not cut out to be a chef 💙"
    w innocent "Zapomnijmy o gotowaniu! Co ja sobie myślałem~? Żaden ze mnie kucharz 💙"

# game/script.rpy:2539
translate pl ch5_ce61890c:

    # w "(Pastille on the other hand...)"
    w "(Za to Pastylek...)"

# game/script.rpy:2540
translate pl ch5_72f902e5:

    # w oops "No, no, no...! Thinking of him in this delightful domestic context is ESPECIALLY banned!"
    w oops "Nie, nie, nie...! Myślenie o nim w tym miłym, przytulnym kontekście jest ZABRONIONE RAZY DWA!"

# game/script.rpy:2541
translate pl ch5_fdc8fc60:

    # w whine "No matter how much I want to eat his cooking now...! He's obviously the type to be good at it...!"
    w whine "Nieważne, jak bardzo chcę spróbować jego gotowania...! Oczywiście, że jest w tym dobry...!"

# game/script.rpy:2542
translate pl ch5_cba66395:

    # w neutral "...."
    w neutral "..."

# game/script.rpy:2543
translate pl ch5_351d08ce:

    # w empty "Ahh, this is depressing... I'm already right back to where I started."
    w empty "Ach, to po prostu smutne... Znów jestem w punkcie wyjścia."

# game/script.rpy:2544
translate pl ch5_9f77ed17:

    # w sleepy "*sigh* I'll just order takeout...."
    w sleepy "*westchnienie* Zamówię coś..."

# game/script.rpy:2547
translate pl ch5_0cc969eb:

    # n "Periwinkle goes to bed that night utterly incapable of forgetting about Pastille."
    n "Tej nocy, Barwinek wraca do łóżka wprost niezdolny do zapomnienia o Pastylku."

# game/script.rpy:2553
translate pl ch5_9d3aad6a:

    # n "Operation \"SERIOUSLY, do not think about that boy!\" - Day 2"
    n "Operacja \"SERIO, CHŁOPIE, koniec myślenia o sam-wiesz-kim!\" - Dzień 2"

# game/script.rpy:2554
translate pl ch5_3e78daf8:

    # "I've tried working... I've tried doing chores... I've even tried to cook! All miserable failures."
    "Próbowałem pracować... Próbowałem prac domowych... Próbowałem nawet gotować! Wszystko zakończyło się żałosnym niepowodzeniem."

# game/script.rpy:2555
translate pl ch5_cd9bef67:

    # "That's why, today, I'm taking drastic measures: complete escapism!"
    "Dlatego właśnie dzisiaj sięgam po drastyczne środki: kompletny eskapizm!"

# game/script.rpy:2556
translate pl ch5_5895572f:

    # "I'm returning to my roots. I'll reread one of my favorite series! If nothing else, it should make a nice source of inspiration..."
    "Wracam do korzeni. Przeczytam jeszcze raz moją ulubioną serię! Jeśli nie pomoże, może przynajmniej stanowić będzie źródło inspiracji..."

# game/script.rpy:2557
translate pl ch5_7c3c5f99:

    # nvl clear
    # n "Periwinkle pulls out volume one of a certain manga from his bookshelf."
    nvl clear
    n "Barwinek zdejmuje z półki wydanie ulubionej mangi."

# game/script.rpy:2561
translate pl ch5_c39703ae:

    # w shutin happy "\"Fabric of our Love\"! How many years has it been~?"
    w shutin happy "\"Tkaniny Naszej Miłości\"! Ileż to czasu minęło~?"

# game/script.rpy:2562
translate pl ch5_45eda1a9:

    # w love "The dresses were always drawn so beautifully in this series... I still think of them from time to time."
    w love "Wszystkie sukienki w tej serii są tak ślicznie narysowane... Nadal od czasu do czasu o nich myślę."

# game/script.rpy:2565
translate pl ch5_4ce77425:

    # "It's the story of a girl who's fallen for a handsome prince 💙 Standard fare for the types of manga I read."
    "To historia dziewczyny, która zakochuje się w przystojnym księciu 💙 Standardowy typ mangi."

# game/script.rpy:2566
translate pl ch5_c86d4767:

    # "Her mother is a talented seamstress who designs all sorts of dazzling gowns for her to wear... and when the prince sees her in one, he becomes smitten with her!"
    "Jej matka to utalentowana krawcowa, która szyje dla niej najpiękniejsze stroje... a gdy książe widzi ją w jednej z kreacji, od razu się w niej zakochuje!"

# game/script.rpy:2567
translate pl ch5_1a90caff:

    # nvl clear
    # "At first, she's in heaven! This is the prince of her dreams~!"
    nvl clear
    "Najpierw jest wniebowzięta! To facet jej marzeń~!"

# game/script.rpy:2569
translate pl ch5_ebf04359:

    # "But she soon wonders if the prince is only attracted to the dresses, the glamour... and not the poor girl underneath."
    "Ale potem zaczyna trapić ją myśl, iż książę kocha jedynie jej suknie, ich urok... a nie biedną kobietę, która je nosi."

# game/script.rpy:2570
translate pl ch5_bbca257f:

    # "Until the prince reveals... ah, I shouldn't spoil it! 💙 The ending is too sweet~!"
    "Aż w końcu książę ujawnia... Ach, nie, nie powinienem zdradzać zakończenia! 💙 Jest tak urocze~!"

# game/script.rpy:2571
translate pl ch5_8ea6ec16:

    # nvl clear
    # n "After admiring the cover art for a while, Periwinkle finally opens the book and begins to read."
    nvl clear
    n "Po wpatrywaniu się w okładkę przez dłuższą chwilę, Barwinek nareszcie przewraca stronę i zaczyna czytać."

# game/script.rpy:2575
translate pl ch5_558ae81a:

    # w shutin love "Just as lovely as I remember... such delicate linework...."
    w shutin love "Tak urocze jak zapamiętałem... Te delikatne linie..."

# game/script.rpy:2576
translate pl ch5_c6240c65:

    # w calm "I wouldn't blame that prince for noticing the dresses before the girl. They really are so beautiful."
    w calm "Nie winiłbym o nic księcia, gdyby pierwsze zauważył suknie, nie dziewczynę. Naprawdę są przepiękne."

# game/script.rpy:2577
translate pl ch5_63862a4b:

    # w oh "Come to think of it, the way this prince is drawn..."
    w oh "Jak nad tym myślę, ten książe..."

# game/script.rpy:2578
translate pl ch5_130cf072:

    # w "His short, fluffy hair, his gentle features... remind me of..."
    w "Jego krótkie, puszyste włosy, jego łagodne rysy... przypominają..."

# game/script.rpy:2581
translate pl ch5_6e0c6c75:

    # n "Periwinkle closes the book in a panic."
    n "Barwinek w panice zamyka książkę."

# game/script.rpy:2583
translate pl ch5_30eaa72d:

    # w shutin mad "That was dangerous. I can't risk even thinking his name...!"
    w shutin mad "To już niebezpieczne. Nie mogę ryzykować myślenia nawet o jego imieniu...!"

# game/script.rpy:2584
translate pl ch5_f09961e7:

    # w whine "Ahh, and there's even a later chapter where he's dressed in servants' clothing! There are too many parallels...!"
    w whine "Ach, jest rozdział, w którym ma na sobie strój sługi! Jest tak podobny...!"

# game/script.rpy:2585
translate pl ch5_41e8eb06:

    # n "Periwinkle rolls across his bed and slides the book back into its place on his shelf."
    n "Barwinek zeskakuje z łóżka i odkłada książkę na jej miejsce."

# game/script.rpy:2586
translate pl ch5_5b74eeff:

    # w pout "This isn't fair... how can one of my most beloved series be off-limits in my time of need...?"
    w pout "To niesprawiedliwe... Dlaczego nawet moja ukochana seria musi mi to robić, gdy jej potrzebuję...?"

# game/script.rpy:2587
translate pl ch5_8b1d5778:

    # n "He scans through the different titles once more, before landing on a 12-volume series..."
    n "Przepatruje inne tytuły jeszcze raz, a jego oczy lądują na 12-tomowej serii..."

# game/script.rpy:2589
translate pl ch5_f3715939:

    # w neutral "I don't remember this one as clearly... but as an all-girls story, it should be safe...."
    w neutral "Tego nie pamiętam za dobrze... ale to historia o dziewczynach, powinna być bezpieczna..."

# game/script.rpy:2591
translate pl ch5_57ab056b:

    # n "Periwinkle pulls the new book from his shelf, and quietly immerses himself in its fictional world..."
    n "Barwinek wyciąga nową książkę z półki i po cichu zatraca się w fikcyjnym świecie..."

# game/script.rpy:2595
translate pl ch5_0630a164:

    # "Before I knew it, I'd finished reading all 12 volumes. The whole day had flown right by."
    "Nim się obejrzałem, skończyłem czytać wszystkie 12 części. Straciłem na tym cały dzień."

# game/script.rpy:2596
translate pl ch5_7bca8e7b:

    # "I couldn't help but keep turning the pages... the story was so much more than I remembered!"
    "Nie mogłem się powstrzymać przed przewracaniem kartek... Ta historia była o wiele ciekawsza niż zapamiętałem!"

# game/script.rpy:2597
translate pl ch5_34844c79:

    # "The protagonist was nothing to write home about, but her childhood friend? Ah, what a moving character arc...!"
    "Protagonistka nie była nikim specjalnym, ale jej przyjaciółka z dzieciństwa? Ach, cóż za rozwój bohatera...!"

# game/script.rpy:2598
translate pl ch5_33580eee:

    # nvl clear
    # "She's very charismatic from the start. The kind of person you'd think has it all figured out... but you couldn't be more wrong!"
    nvl clear
    "Od samego początku jest bardzo charyzmatyczną postacią. Takim rodzajem osoby, która na pierwszy rzut oka wie wszystko... ale to mylne!"

# game/script.rpy:2600
translate pl ch5_49da7a6c:

    # "Over the course of the series, she goes through so many love interests... back in the day, I had assumed it was because the author couldn't make up their mind!"
    "W trakcie serii zakochuje się tak wiele razy... Kiedyś myślałem, że to dlatego iż autorka nie miała pojęcia, z kim ją zeswatać!"

# game/script.rpy:2601
translate pl ch5_e0af319b:

    # nvl clear
    # "But reading it all at once, it must've been planned from the beginning... these doomed relationships are merely self-sabotage! A distraction from pursuing her one true love!"
    nvl clear
    "Ale teraz, po przeczytaniu tego raz jeszcze, jestem pewien, że taki był plan... Wszystkie te stracone związki były sabotażem! Odwróceniem uwagi od jej prawdziwej miłości!"

# game/script.rpy:2603
translate pl ch5_9828e662:

    # "She never realizes the obvious answer until the very end...! And what an emotional finale!"
    "I nie dowiaduje się, kto to taki, aż do samego zakończenia...! Cóż za emocjonujący finał!"

# game/script.rpy:2604
translate pl ch5_967fea48:

    # "When she finally confesses, and the two girls share their first kiss...!"
    "Gdy nareszcie przyznaje się do swoich uczuć i dziewczyny dzielą pierwszy pocałunek...!"

# game/script.rpy:2605
translate pl ch5_a29c652c:

    # nvl clear
    # w shutin love "Ah~! The fireworks!! Could anything be more romantic?!" with vpunch
    nvl clear
    w shutin love "Ach~! Fajerwerki! Czy istnieje coś bardziej romantycznego na tym świecie?!" with vpunch

# game/script.rpy:2608
translate pl ch5_bf1c8f6a:

    # w happy "Her tears of happiness...! Finally being honest with herself, and with her best friend...! How lovely!"
    w happy "Jej łzy szczęścia...! To, że nareszcie jest szczera w stosunku do siebie, do swojej przyjaciółki...! Jak cudownie!"

# game/script.rpy:2609
translate pl ch5_bab1bf08:

    # w calm "The well of loneliness that is her character was portrayed so flawlessly... she's the most real of them all."
    w calm "Samotność pochłaniająca jej postać, ukazana w tak bezbłędny sposób... Jest najbardziej realistyczną bohaterką."

# game/script.rpy:2610
translate pl ch5_3c397fdf:

    # w love "Ending the story any other way would've been an injustice. She deserves the world...!"
    w love "Zakończenie tej historii w jakikolwiek inny sposób byłoby niesprawiedliwe. Zasługuje na szczęście...!"

# game/script.rpy:2611
translate pl ch5_4f0b1bd8:

    # w oh "Hmm... I own this author's follow-up series as well, don't I...?"
    w oh "Hmm... Chyba mam gdzieś inne serie tej autorki, prawda...?"

# game/script.rpy:2612
translate pl ch5_7b7b7eff:

    # w happy "Time to get some snacks and start searching for it 💙 I can't resist diving in right away~!"
    w happy "Czas, by zgromadzić przekąski i rozpocząć poszukiwania 💙 Nie mogę się oprzeć~!"

# game/script.rpy:2616
translate pl ch5_e43c6f26:

    # n "Operation \"Escape reality\" - Day 3"
    n "Operacja \"Ucieczka od Rzeczywistości\" - Dzień 3"

# game/script.rpy:2617
translate pl ch5_f8a47392:

    # n "Periwinkle continued to read..."
    n "Barwinek nadal czytał..."

# game/script.rpy:2621
translate pl ch5_18ee21a7:

    # n "...and read..."
    n "...i czytał..."

# game/script.rpy:2625
translate pl ch5_577f25be:

    # n "...and read."
    n "...i czytał."

# game/script.rpy:2627
translate pl ch5_6b9ceb2b:

    # n "Until he heard a knock at his door."
    n "Aż usłyszał pukanie do drzwi."

# game/script.rpy:2629
translate pl ch5_eb6b9ef1:

    # w shutin oh "(Pastille...? No, that isn't his knock.)"
    w shutin oh "(Pastylek...? Nie, on tak nie puka.)"

# game/script.rpy:2630
translate pl ch5_add831c5:

    # w oops "(Ah, wait--I was trying to forget about him!)"
    w oops "(Ach, chwila- Miałem o nim zapomnieć!)"

# game/script.rpy:2631
translate pl ch5_49e273c0:

    # w oh "(Though I suppose it means I was successful for a while... I even forgot that I was avoiding something to begin with....)"
    w oh "(Aczkolwiek wydaje mi się, że to znaczy iż na jakąś chwilę mi się udało... Zapomniałem, że chcę zapomnieć...)"

# game/script.rpy:2637
translate pl ch5_3fd120b3:

    # n "When he opens the door, Periwinkle is greeted by a small crowd of friends and acquaintances."
    n "Gdy otwiera drzwi, Barwinek zastaje małą grupę przyjaciół i znajomych."

# game/script.rpy:2640
translate pl ch5_24c4f6ca:

    # h "Periwinkle~! Get dressed, we're hitting the clubs!"
    h "Barwinek~! Ubieraj się, idziemy do klubu!"

# game/script.rpy:2641
translate pl ch5_2c561f37:

    # w shutin happy "Wow~ the whole cavalry's arrived!"
    w shutin happy "Wow~ Oto przybyła pielgrzymka!"

# game/script.rpy:2642
translate pl ch5_ccfacf58:

    # w love "Unfortunately, I'm going to have to decline... tonight isn't going to work for me."
    w love "Ale niestety, muszę odmówić... Dzisiejszej nocy nie dam rady."

# game/script.rpy:2643
translate pl ch5_0c4017c9:

    # h "Whaaat~?! But no one's seen you in AGES! You haven't abandoned us for a new scene, have you?"
    h "Cooooo~?! Ale nikt cię nie widział od WIEKÓW! Nie porzuciłeś nas, prawda?"

# game/script.rpy:2644
translate pl ch5_547f416c:

    # w guilty "Oh, nothing like that... I've just been a little preoccupied. I'm taking some time to myself at the moment."
    w guilty "Och, nic z tych rzeczy... Byłem tylko trochę zajęty. Wziąłem kilka wolnych dni dla siebie."

# game/script.rpy:2645
translate pl ch5_1bc1c398:

    # h "Nothing wrong with a little self-care, but... are you suuure you don't wanna come out and enjoy the night life?"
    h "Nie ma nic złego w dbaniu o siebie, ale... jesteś peeeeeewny, że nie chcesz z nami wyjść i cieszyć się życiem?"

# game/script.rpy:2646
translate pl ch5_e857923b:

    # w love "Ahh, I don't know... I've fallen so far behind on my work."
    w love "Ach, sam nie wiem... Mam tyle zaległości w pracy."

# game/script.rpy:2647
translate pl ch5_87ce4ec9:

    # h "Choosing work over getting laid? Now I KNOW something's up with you!"
    h "Wolisz pracę od szybkiego numerku? Teraz NA PEWNO wiem, że coś jest nie tak!"

# game/script.rpy:2648
translate pl ch5_7d59c83b:

    # w happy "How offensive~! I have more going on than just going out and flirting with everyone I meet!"
    w happy "Ubliżasz mi~! Robię coś więcej, niż wychodzenie i flirtowanie ze wszystkimi!"

# game/script.rpy:2649
translate pl ch5_c159c59e:

    # h "Haahaha! Of course, of course~!"
    h "Haahaahaa! Pewnie, pewnie~!"

# game/script.rpy:2650
translate pl ch5_87163668:

    # w calm "I do appreciate the invitation, though. Thank you for thinking of me."
    w calm "Doceniam wasze zaproszenie. Dziękuję, że o mnie pomyśleliście."

# game/script.rpy:2651
translate pl ch5_d75fa27b:

    # h "We just had to come and make sure you were still alive. The clubs are lonely without you~!"
    h "Chcieliśmy po prostu sprawdzić, czy aby na pewno dalej żyjesz. Jest tak nudno bez ciebie~!"

# game/script.rpy:2652
translate pl ch5_5fa75dc3:

    # w happy "I'll have to make my grand return some other time, then. Have a lovely evening~!"
    w happy "Kiedy indziej zobaczycie mój wielki powrót, obiecuję. Miłego wieczoru~!"

# game/script.rpy:2655
translate pl ch5_84d367b4:

    # n "The group waves goodbye and disappears into the night..."
    n "Grupa macha na pożegnanie i znika za zakrętem..."

# game/script.rpy:2659
translate pl ch5_1fb460c7:

    # w shutin calm "Hmhm... it's been a while since I've had to turn them down...."
    w shutin calm "Hmhm... Minęło trochę czasu od ostatniego razu, gdy im odmówiłem..."

# game/script.rpy:2660
translate pl ch5_bd0d5988:

    # n "Periwinkle leans his back against the door and sighs."
    n "Barwinek opiera się o drzwi i wzdycha głęboko."

# game/script.rpy:2662
translate pl ch5_a96c004e:

    # "I'm definitely not in any state to go clubbing right now."
    "Zdecydowanie nie jestem teraz w odpowiednim stanie, by imprezować."

# game/script.rpy:2663
translate pl ch5_8fa632dc:

    # "No matter how much it warms my heart to know that I am missed, I won't be making the same mistake as the other night!"
    "Nieważne, iż przekonania że ktoś za mną tęskni są mi miodem na uszy, nie mam zamiaru popełniać dwa razy tego samego błędu!"

# game/script.rpy:2664
translate pl ch5_ab8d7c49:

    # "I can't go recklessly diving into the comforting arms of another as long as my mind is still hung up on Pastille..."
    "Nie mogę bezmyślnie poszukiwać ukojenia w ramionach nieznajomych, kiedy nadal potrafię myśleć jedynie o Pastylku..."

# game/script.rpy:2665
translate pl ch5_31e9e456:

    # nvl clear
    # "But how long will I remain in this state?"
    nvl clear
    "Ale na jak długo utrzyma się ten stan?"

# game/script.rpy:2667
translate pl ch5_87296cd0:

    # "Shutting myself away, binge-reading comics..."
    "Odcinając się od świata, wracam do czytania komiksów..."

# game/script.rpy:2668
translate pl ch5_6ab20be7:

    # "These were emergency measures. I can't avoid the outside world forever."
    "Sięgnąłem już po środki awaryjne. Nie mogę unikać świata przez całe życie."

# game/script.rpy:2669
translate pl ch5_091fa9e2:

    # nvl clear
    # "In any case, shouldn't Pastille be returning here at some point?"
    nvl clear
    "Tak właściwie, czy Pastylek nie powinien kiedyś wrócić?"

# game/script.rpy:2671
translate pl ch5_ee826e83:

    # "From where we left off, I'd have expected him to come knocking as soon as possible!"
    "Patrząc na to, jak skończyło się ostatnie spotkanie, spodziewałem się, że przybiegnie tu jak najszybciej!"

# game/script.rpy:2672
translate pl ch5_16870329:

    # "And yet... it's been three full days now, hasn't it?"
    "A jednak... minęły już trzy dni, czyż nie?"

# game/script.rpy:2673
translate pl ch5_efc836eb:

    # "How long could he possibly abstain from my touch! Or is something wrong...?"
    "Jak długo mógłby niby wytrzymać bez mojego dotyku?! Czy coś jest nie tak...?"

# game/script.rpy:2674
translate pl ch5_282afc69:

    # nvl clear
    # "I shouldn't be thinking about any of this... but I'm beginning to feel..."
    nvl clear
    "Nie powinienem o tym myśleć... Ale zaczynam być..."

# game/script.rpy:2676
translate pl ch5_bb1c3e4d:

    # "Annoyed? Confused...?"
    "Zirytowany? Zagubiony...?"

# game/script.rpy:2677
translate pl ch5_82208e45:

    # nvl clear
    # w shutin conflicted "(If he never comes back, I suppose my problem would go away on its own...)"
    nvl clear
    w shutin conflicted "(Jeśli nigdy nie wróci, problem sam się rozwiąże...)"

# game/script.rpy:2680
translate pl ch5_7082d627:

    # w oops "(But I hate the thought of that. As things are now, I'd only be haunted by thoughts of what I could've possibly done wrong.)"
    w oops "(Ale nienawidzę o tym myśleć. Biorąc pod uwagę obecny stan rzeczy, pewnie nękałyby mnie myśli o tym, co zrobiłem źle.)"

# game/script.rpy:2681
translate pl ch5_6a2ef4f7:

    # w empty "(What IS my plan, then? Continue to ping-pong back and forth between these extreme emotional states?)"
    w empty "(Jaki w takim razie mam plan działania? Nadal jak piłeczka ping-pongowa odbijać się między dwoma skrajnościami?)"

# game/script.rpy:2682
translate pl ch5_eba87ac9:

    # n "He rubs his eyes in exhaustion."
    n "Zmęczony, przeciera oczy."

# game/script.rpy:2683
translate pl ch5_e4efba8a:

    # w sleepy "...I'll worry about this tomorrow...."
    w sleepy "...Będę się tym martwił jutro..."

# game/script.rpy:2685
translate pl ch5_4025cec7:

    # n "Periwinkle steps back into his room and tucks himself into bed with his books..."
    n "Barwinek wraca do pokoju i kładzie się pod kołdrą z masą książek..."

# game/script.rpy:2691
translate pl ch5_9fbba0e4:

    # n "But an hour later... another knock comes."
    n "Ale godzinę później... w domu znów rozlega się pukanie do drzwi."

# game/script.rpy:2692
translate pl ch5_48a3bbb2:

    # n "This time, the pattern is unmistakable."
    n "Tym razem jednak jego schemat jest charakterystyczny."

# game/script.rpy:2693
translate pl ch5_5b483588:

    # w shutin ah "(Pastille is here....)"
    w shutin ah "(Pastylek tu jest...)"

# game/script.rpy:2695
translate pl ch5_5a00cde9:

    # "Well, well, well..."
    "Proszę, proszę, proszę..."

# game/script.rpy:2696
translate pl ch5_5f55459f:

    # "So he's come after all."
    "A więc przyszedł."

# game/script.rpy:2697
translate pl ch5_16205056:

    # nvl clear
    # "Despite all my hard work of trying to forget..."
    nvl clear
    "Pomimo tego, jak ciężko pracowałem, by zapomnieć..."

# game/script.rpy:2699
translate pl ch5_5eb7e5c9:

    # "I've actually been waiting for this moment, haven't I?"
    "To na ten moment czekałem, czyż nie?"

# game/script.rpy:2700
translate pl ch5_b9f40f3e:

    # "I don't care what these feelings might mean anymore. I'm tired of fighting them."
    "Już nawet nie dbam o to, co oznaczają te emocje. Zmęczyło mnie walczenie z nimi."

# game/script.rpy:2701
translate pl ch5_83d0f4c7:

    # "I... just want Pastille."
    "Chcę... chcę tylko Pastylka."

# game/script.rpy:2702
translate pl ch5_76b2fe88_3:

    # nvl clear
    nvl clear

# game/script.rpy:2706
translate pl ch5_ee017070:

    # n "He opens the door, and sure enough, Pastille is the one he finds standing there."
    n "Otwiera drzwi wejściowe, za którymi, jak podejrzewał, czeka na niego Pastylek."

# game/script.rpy:2708
translate pl ch5_b3482bb2:

    # p "Hi!"
    p "Hej!"

# game/script.rpy:2709
translate pl ch5_ad5989c9:

    # w shutin happy "Why, good evening~ and what could you have possibly come for at this hour?"
    w shutin happy "No, no, dobry wieczór~ Czego u mnie szukasz o tak późnej godzinie?"

# game/script.rpy:2710
translate pl ch5_d6116a12:

    # p shy "To, um... pick up where we left off the other night? Maybe?"
    p shy "Ja, um... chciałem dokończyć to, co przerwaliśmy tamtej nocy? Może?"

# game/script.rpy:2711
translate pl ch5_de585d14:

    # w calm "(It's about time...)"
    w calm "(Najwyższy czas...)"

# game/script.rpy:2712
translate pl ch5_5385df4b:

    # w smile "Come in, come in~"
    w smile "Wejdź, wejdź~"

# game/script.rpy:2717
translate pl ch5_cd910a5d:

    # p "Sorry, I meant to come see you again sooner. I had a few things to sort out before I--"
    p "Przepraszam, chciałem odwiedzić się wcześniej. Miałem wiele rzeczy na głowie i-"

# game/script.rpy:2718
translate pl ch5_bc730da8:

    # w shutin "Hush, now. That's not where we left off at all, was it?"
    w shutin "Ci, cicho już. To nie tutaj przerwaliśmy, prawda?"

# game/script.rpy:2719
translate pl ch5_2e90126b:

    # p wha "Huh? Y-yeah, I guess not...."
    p wha "Hę? T-tak, raczej nie..."

# game/script.rpy:2720
translate pl ch5_018d96d1:

    # w calm "I'm more interested in how you got me home that night. You see, the last thing I remember is sitting on that bench..."
    w calm "Bardziej zainteresowany jestem tym, jak tamtego dnia dostałem się do domu."
    w "Wiesz, ostatnim, co pamiętam, jest odpoczynek na ławce..."

# game/script.rpy:2721
translate pl ch5_ea6b3cdd:

    # p shy "Oh! Uh, well, I was having a hard time waking you up, so I just ended up carrying you..."
    p shy "Och! Uch, cóż, nie mogłem cię obudzić, więc po prostu cię tu zaniosłem..."

# game/script.rpy:2722
translate pl ch5_7bf95963:

    # w love "The whole way, by yourself~?"
    w love "Przeszedłeś tak całą drogę~?"

# game/script.rpy:2723
translate pl ch5_85a7733b:

    # p ehe "I mean, having a broom to ride helped a lot..."
    p ehe "Znaczy, miotła na pewno pomogła..."

# game/script.rpy:2725
translate pl ch5_025b722e:

    # n "Periwinkle closes in."
    n "Barwinek się przybliża."

# game/script.rpy:2727
translate pl ch5_99ae40bd:

    # w "We rode it together, then?"
    w "Lecieliśmy na niej razem?"

# game/script.rpy:2728
translate pl ch5_c7a8bcd7:

    # p "That was the easiest way, yes..."
    p "Tak było najłatwiej, tak..."

# game/script.rpy:2730
translate pl ch5_ea00b1f1:

    # w "You must've held me close, so I wouldn't fall."
    w "Musiałeś bardzo ciasno mnie trzymać, skoro nie spadłem."

# game/script.rpy:2731
translate pl ch5_17dffd1d:

    # p "I-I did..."
    p "T-tak było..."

# game/script.rpy:2732
translate pl ch5_c05aeb0d:

    # w "Putting your hands all over me, hm?"
    w "Nie mogłeś trzymać rąk przy sobie, hm?"

# game/script.rpy:2734
translate pl ch5_d5950d96:

    # p "I-I didn't feel you up while you were unconscious!!" with vpunch
    p "P-przecież bym cię nie dotykał w taki sposób, skoro byłeś nieprzytomny!!!" with vpunch

# game/script.rpy:2736
translate pl ch5_e4c9d1f9:

    # n "He gives him a big kiss."
    n "Całuje go słodko."

# game/script.rpy:2737
translate pl ch5_40d0a112:

    # w "I was only kidding 💙"
    w "Żarcik 💙"

# game/script.rpy:2744
translate pl ch5_8c5d6ecb:

    # w shutin oh "But you also changed my clothes..."
    w shutin oh "Ale przebrałeś mnie też w inne ubrania..."

# game/script.rpy:2745
translate pl ch5_3f8c0164:

    # p shout "Because I thought you'd be more comfortable that way! It was an innocent gesture!!"
    p shout "Bo pomyślałem, że dzięki temu będzie ci wygodniej! To był całkiem niewinny gest!!!"

# game/script.rpy:2746
translate pl ch5_722429a2:

    # w shy "I can't believe you saw my bare chest...!"
    w shy "Nie wierzę, widziałeś mnie bez koszuli!"

# game/script.rpy:2747
translate pl ch5_d0de9f7d:

    # p mou "I've already seen it!!" with vpunch
    p mou "N-nie pierwszy raz!!!" with vpunch

# game/script.rpy:2748
translate pl ch5_129da7dd:

    # w kyaa "Kyaa~!"
    w kyaa "Kyaa~!"

# game/script.rpy:2750
translate pl ch5_2a5bf1a0:

    # n "Pastille suddenly lifts him by the waist and hoists him over his shoulder."
    n "Znienacka, Pastylek podnosi go mocnym chwytem za talię i przerzuca przez swoje ramię."

# game/script.rpy:2752
translate pl ch5_b0384b66:

    # w "PASTILLE--!!!!"
    w "PASTYLEK-!!!"

# game/script.rpy:2753
translate pl ch5_c919570c:

    # w "Wah!! Please handle me more delicately~! 💙"
    w "Ach!!! Proszę, bądź delikatniejszy~! 💙"

# game/script.rpy:2758
translate pl ch5_ce101c14:

    # n "When they reach the bed, Pastille falls backwards onto it, taking Periwinkle with him..."
    n "Gdy docierają do łóżka, Pastylek upada na plecy w poduszki, ciągnąc za sobą Barwinka..."

# game/script.rpy:2761
translate pl ch5_e3264b9c:

    # n "They pause there a moment, laughs fading to soft breaths."
    n "Zatrzymują się na sekundę, a ich głośne śmiechy powoli cichną."

# game/script.rpy:2762
translate pl ch5_de48edd8:

    # w "You forgot to turn the light off...."
    w "Zapomniałeś wyłączyć światło..."

# game/script.rpy:2763
translate pl ch5_a01f3a61:

    # p "W-well... I can't get up now...."
    p "C-cóż... Teraz już nie wstanę..."

# game/script.rpy:2764
translate pl ch5_165a8c0c:

    # w "(How can he be so impatient after making me wait for so long...?)"
    w "(Jak może być tak niecierpliwy, gdy to on kazał czekać mnie...?)"

# game/script.rpy:2766
translate pl ch5_32610596:

    # w "Hmhm... oh well."
    w "Hmhm... No cóż."

# game/script.rpy:2778
translate pl ch6_7b49a2da:

    # centered "{w=3}{nw}"
    centered "{w=3}{nw}"

# game/script.rpy:2785
translate pl ch6_119ba1b9:

    # "I awake to a rustling sound."
    "Budzi mnie szelest."

# game/script.rpy:2786
translate pl ch6_ab14d017:

    # "My bed is empty again, but when I roll over..."
    "Moje łóżko znów jest puste, a gdy się obracam..."

# game/script.rpy:2787
translate pl ch6_b46fc96f:

    # "Pastille is there, standing in front of my closet."
    "Widzę Pastylka, stojącego przed moją szafą."

# game/script.rpy:2788
translate pl ch6_761374d1:

    # nvl clear
    # "I sit up, rubbing the sleep from my eyes."
    nvl clear
    "Także wstaję, przecierając zaspane oczy."

# game/script.rpy:2790
translate pl ch6_bd31bc8e:

    # "He's holding a box. As he lifts it on to the top shelf, its contents shift, making a clattering noise."
    "W rękach trzyma pudełko. Gdy odkłada je z powrotem na miejsce, jego zawartość głośno brzdęka."

# game/script.rpy:2791
translate pl ch6_64a5f7e2:

    # "Utterly confused as to what he's doing, I finally call out to him."
    "Nie mając zielonego pojęcia o tym, co mógłby robić, nareszcie się odzywam."

# game/script.rpy:2792
translate pl ch6_cd1b109b:

    # nvl clear
    # w bed sleepy "Pastille...?"
    nvl clear
    w bed sleepy "Pastylku...?"

# game/script.rpy:2798
translate pl ch6_f0b9d5cf:

    # p "Sorry! I didn't break anything, I promise."
    p "Przepraszam! Niczego nie popsułem, przysięgam."

# game/script.rpy:2799
translate pl ch6_162a2395:

    # w sleepy2 "What are you doing in my closet...?"
    w sleepy2 "Co tam robisz...?"

# game/script.rpy:2800
translate pl ch6_c6af6f68:

    # p um "Huh...? You said I could clean up."
    p um "Hę...? Mówiłeś, że mogę posprzątać?"

# game/script.rpy:2801
translate pl ch6_50b69d81:

    # w "Hmm...?"
    w "Hmm...?"

# game/script.rpy:2802
translate pl ch6_ac6fcf82:

    # w guilty "Oh, haha... is there anything I won't agree to in my sleep...?"
    w guilty "Och, haha... We śnie zgodzę się na wszystko...!"

# game/script.rpy:2803
translate pl ch6_50286f17:

    # p embarrassed "Ah--I'm sorry, I thought you were awake when I asked...! I-I'll stop."
    p embarrassed "Ach- Przepraszam, myślałem, że nie śpisz, gdy pytałem...! M-mogę przestać."

# game/script.rpy:2804
translate pl ch6_11d9a40b:

    # w sleepy3 "It's fine... I just didn't expect to wake up to you rifling through my things."
    w sleepy3 "W porządku... Nie spodziewałem się, że obudzi mnie chłopak sprzątający mój pokój."

# game/script.rpy:2805
translate pl ch6_1b21a1bb:

    # p flustered2 "Th-that really wasn't my intention...! I just felt like organizing stuff...."
    p flustered2 "N-nie takie miałem intencje...! Zechciałem tylko uporządkować trochę rzeczy..."

# game/script.rpy:2806
translate pl ch6_8abb953b:

    # p think "What do people normally do on the morning after...? I guess I should've made breakfast."
    p think "Co ludzie normalnie robią rano...? Chyba powinienem był przygotować śniadanie."

# game/script.rpy:2807
translate pl ch6_d9be9541:

    # w happy "Ohh~ I want to eat pancakes~!"
    w happy "Och~ Chcę naleśniki~!"

# game/script.rpy:2808
translate pl ch6_602cfadd:

    # p happy "Great! I'll make some!!"
    p happy "Świetnie! Zrobię naleśniki!!!"

# game/script.rpy:2810
translate pl ch6_7c1da6cd:

    # n "Pastille practically bolts from the room to get started on cooking."
    n "Pastylek niemal wypada z pokoju, by zająć się gotowaniem."

# game/script.rpy:2811
translate pl ch6_c9e53739:

    # w sleepy3 "Hmhm... oh, Pastille...."
    w sleepy3 "Hmhm... Och, Pastylku..."

# game/script.rpy:2814
translate pl ch6_54d8e5dc:

    # "Looking around the room, he did much more than organize my closet..."
    "Gdy rozglądam się po pokoju, okazuje się, że zajął się czymś więcej niż zwykłym porządkowaniem szafy..."

# game/script.rpy:2815
translate pl ch6_d495c413:

    # "The books I'd been reading were all tucked back into their proper places on the bookshelf."
    "Książki, które czytałem przez ostatnie dni, stały z powrotem na swoich miejscach w biblioteczce."

# game/script.rpy:2816
translate pl ch6_ff59d209:

    # "The clothes that had been strewn across the floor, or otherwise left hanging in ridiculous places, now sat in the hamper waiting to be washed."
    "Ubrania, które niedawno leżały na podłodze lub wisiały w miejsach absolutnie nieprzeznaczonych dla ubrań, teraz czekały na pranie w koszu."

# game/script.rpy:2817
translate pl ch6_0c0a8ef8:

    # nvl clear
    # "Even the pile of unfolded laundry I had previously abandoned was now absent--properly folded and placed into the appropriate drawers by Pastille."
    nvl clear
    "Nawet stos prania, którego układanie porzuciłem, po prostu zniknął - wszystkie elementy odzieży były poskładane i odłożone na miejsce."

# game/script.rpy:2819
translate pl ch6_c62ed776:

    # "In a word, I'm in awe."
    "Byłem, jednym słowem, zachwycony."

# game/script.rpy:2820
translate pl ch6_d9bb5a76:

    # "How long had he been at this? And all while I slept?"
    "Jak długo mu to zajęło? Wszystko, gdy spałem?"

# game/script.rpy:2821
translate pl ch6_d234491a:

    # "It shouldn't even be possible."
    "To nie powinno być nawet możliwe."

# game/script.rpy:2822
translate pl ch6_58188605:

    # nvl clear
    # w bed neutral "...."
    nvl clear
    w bed neutral "..."

# game/script.rpy:2825
translate pl ch6_a12675e8:

    # w oh2 "(I have so much more floor space than I remembered... how did he manage to do that...?)"
    w oh2 "(Mam o wiele więcej miejsca na podłodze niż sądziłem... Jak on tego dokonał...?)"

# game/script.rpy:2828
translate pl ch6_9f49ab7b:

    # n "Periwinkle puts on a fresh pair of pajamas and walks out to the kitchen in a daze."
    n "Barwinek ubiera świeżą piżamę i kieruje się do kuchni."

# game/script.rpy:2834
translate pl ch6_d0be8d4a:

    # p "Hey! Pancakes are ready."
    p "Hej! Naleśniki gotowe."

# game/script.rpy:2836
translate pl ch6_2bbe66e9:

    # w pj happy "Oh~! Is it too soon to say I love you?"
    w pj happy "Och~! Czy za wcześnie na wyznania miłości?"

# game/script.rpy:2837
translate pl ch6_59343347:

    # p sure "Haha, please enjoy...."
    p sure "Haha, proszę, smacznego..."

# game/script.rpy:2838
translate pl ch6_5c9fb064:

    # n "Periwinkle takes his seat at the table and digs in..."
    n "Barwinek zajmuje miejsce przy stole i zaczyna jeść..."

# game/script.rpy:2841
translate pl ch6_dba11a19:

    # "They're... delicious."
    "Są... przepyszne."

# game/script.rpy:2842
translate pl ch6_ed24b619:

    # "Perfectly light and fluffy... the optimal amount of syrup and whipped cream..."
    "Idealnie lekkie i puszyste... Optymalna ilość syropu klonowego i bitej śmietany..."

# game/script.rpy:2843
translate pl ch6_877ba230:

    # "Every bite is so heavenly, I could cry!"
    "Każdy gryz jest niebiański, chyba się popłaczę!"

# game/script.rpy:2844
translate pl ch6_534a3175:

    # "I've never felt so emotional over food...! What has this boy done to me?"
    "Nigdy jeszcze nie zakochałem się w jedzeniu...! Co ten chłopak ze mną robi?"

# game/script.rpy:2845
translate pl ch6_d42fc5b3:

    # nvl clear
    # "I was right about him being the culinary type."
    nvl clear
    "Miałem rację stwierdzając, że jest dobrym kucharzem."

# game/script.rpy:2847
translate pl ch6_a846ccd2:

    # "I didn't think I would get to try his cooking so soon... this is a surprise attack."
    "Ale nie sądziłem, że dane mi będzie skosztować jego kuchni tak szybko... To był atak z zaskoczenia."

# game/script.rpy:2848
translate pl ch6_3495ef88:

    # "He even... ah, but how did those get there? I have to ask--"
    "I nawet... Ach, a te tu skąd? Będę musiał zapytać-"

# game/script.rpy:2849
translate pl ch6_76b2fe88:

    # nvl clear
    nvl clear

# game/script.rpy:2853
translate pl ch6_1784b473:

    # w pj oh "Pastille... where did you get these strawberries?"
    w pj oh "Pastylku... Skąd wziąłeś truskawki?"

# game/script.rpy:2854
translate pl ch6_cf3877d3:

