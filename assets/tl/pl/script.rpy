    # w shy "Hmhm, silly Pastille..."
    w shy "Hmhm, głupiutki Pastylek..."

# game/script.rpy:2888
translate pl ch6_fa84fa9d:

    # w love "You're always welcome here 💙"
    w love "Zawsze jesteś tu mile widziany 💙"

# game/script.rpy:2889
translate pl ch6_265a51d5:

    # p doki "Ah...! W-well, thank you...."
    p doki "Ach...! C-cóż, dziękuję..."

# game/script.rpy:2893
translate pl ch6_4bd430f5:

    # "Fine."
    "No dobra."

# game/script.rpy:2894
translate pl ch6_44596fc6:

    # "Okay! Enough... I'll admit it."
    "Dobra! Koniec... Przyznaję."

# game/script.rpy:2895
translate pl ch6_66217057:

    # "I'm stupidly, desperately, absolutely ridiculously..."
    "Jestem, co głupie, desperackie, absolutnie niedorzeczne..."

# game/script.rpy:2896
translate pl ch6_4b601189:

    # "...in love with Pastille."
    "...zakochany w Pastylku."

# game/script.rpy:2897
translate pl ch6_b65603b6:

    # nvl clear
    # "There! I said it--or at least, I'm saying it to myself."
    nvl clear
    "Proszę! Przyznałem - przynajmniej sam sobie."

# game/script.rpy:2899
translate pl ch6_8127d328:

    # "I'll accept this. Pastille is incredible! Who WOULDN'T fall for him?"
    "Mi pasuje. Pastylek jest wspaniały! Kto by się w nim NIE zakochał?"

# game/script.rpy:2900
translate pl ch6_a7f8f6b4:

    # "I don't want anyone else anymore. I've been poisoned by this perfect boy."
    "Nie chcę nikogo innego. Zniszczył mnie dla wszystkich, bo nikt nie jest tak perfekcyjny jak on."

# game/script.rpy:2901
translate pl ch6_4d52c35b:

    # "The problem now is what to DO about it...."
    "Teraz tylko pytanie, co mam zrobić z tym faktem...?"

# game/script.rpy:2902
translate pl ch6_76b2fe88_1:

    # nvl clear
    nvl clear

# game/script.rpy:2905
translate pl ch6_b4d687b8:

    # p "Weird question, but..."
    p "Dziwne pytanie, ale..."

# game/script.rpy:2906
translate pl ch6_36c7f47d:

    # p shy "Would you want to... um..."
    p shy "Czy chciałbyś... Um..."

