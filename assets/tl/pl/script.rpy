    # w happy "Astragalus certainly thought you were talented. I'm impressed too, of course."
    w happy "Traganka zdecydowanie myśli, że jesteś utalentowany. Mi również zaimponowałeś, oczywiście."

# game/script.rpy:2081
translate pl ch4_537846ba:

    # p shy "Th-thanks... haha, if only I could use magic to stop myself from being a klutz...."
    p shy "Dz-dzięki... Haha, gdybym tylko dzięki magii mógł stać się mniejszą niezdarą..."

# game/script.rpy:2082
translate pl ch4_e7496cc5:

    # w teehee "Oh, are you embracing that nickname now?"
    w teehee "Och, spodobało ci się przezwisko?"

# game/script.rpy:2083
translate pl ch4_32e4b18b:

    # p scream "N-no!! Please go back to saying \"my sweet\"!!!" with vpunch
    p scream "N-nie!!! Proszę, nazywaj mnie dalej po prostu \"mój słodki\"!!!" with vpunch

# game/script.rpy:2084
translate pl ch4_e86c0674:

    # w love "Ah~ if you like that one so much, I suppose I have no choice! 💙"
    w love "Ach~ Skoro tak ci się to podoba, chyba nie mam wyjścia 💙"

# game/script.rpy:2085
translate pl ch4_419d487f:

    # p omgstop "I-I... I just meant...!"
    p omgstop "N-nie... Chodziło mi o coś innego...!"

# game/script.rpy:2086
translate pl ch4_8c34b708:

    # p flustered "N-Nevermind!! Don't call me anything...!" with vpunch
    p flustered "N-nieważne!!! W ogóle mnie niczym nie nazywaj...!" with vpunch

# game/script.rpy:2087
translate pl ch4_58252808:

    # w shy "Hmhmhm 💙 Oh, Pastille...."
    w shy "Hmhmhm 💙 Och, Pastylku..."

# game/script.rpy:2090
translate pl ch4_5df76680:

    # "We resume our stroll around town..."
    "Wznawiamy nasz spacer wokół miasteczka..."

# game/script.rpy:2091
translate pl ch4_df4e55af:

    # "This time, it's Pastille who takes the lead. He seems to have someplace in mind, but hasn't said as much."
    "Tym razem to Pastylek prowadzi. Wydaje się, że wybrał jakiś cel podróży, ale nie odzywa się za wiele."

# game/script.rpy:2092
translate pl ch4_5623091f:

    # "He merely takes my hand and leads me up a labyrinth of stairs..."
    "Trzyma moją dłoń i prowadzi mnie labiryntem schodów..."

# game/script.rpy:2093
translate pl ch4_76b2fe88_10:

    # nvl clear
    nvl clear

# game/script.rpy:2097
translate pl ch4_fd97df8a:

    # "And once we reach the top..."
    "A gdy docieramy na samą górę..."

# game/script.rpy:2098
translate pl ch4_37819467:

    # "A gust of wind swoops through the trees overhead, showering us in flower petals."
    "Podmuch wiatru potrząsa otaczającymi nas drzewami, których liście kręcą się wokół nas."

# game/script.rpy:2099
translate pl ch4_af3d310d:

    # nvl clear
    # w date ah "Ah. Peach blossoms..."
    nvl clear
    w date ah "Ach. Kwiaty brzoskwini..."

# game/script.rpy:2103
translate pl ch4_bf824512:

    # p "It's nice, isn't it?"
    p "Ładnie, prawda?"

# game/script.rpy:2104
translate pl ch4_745730c3:

    # w love "Hmhm, I can't help but think you're trying to tell me something right now~"
    w love "Hmhm, mam nieodparte wrażenie, że próbujesz mi coś powiedzieć~"

# game/script.rpy:2105
translate pl ch4_36d2e96b:

    # p oh "Huh...?"
    p oh "Hę...?"

# game/script.rpy:2106
translate pl ch4_7daf2c79:

    # w smile "Don't you remember? My \"aphrodisiac\" was also peach-scented..."
    w smile "Nie pamiętasz? Mój \"afrodyzjak\" też miał zapach brzoskwini..."

# game/script.rpy:2107
translate pl ch4_290ca16a:

    # p wha "Ah..."
    p wha "Ach..."

# game/script.rpy:2108
translate pl ch4_d493bae3:

    # p kyaa "A-AH...! I WASN'T THINKING ABOUT THAT...!!!" with vpunch
    p kyaa "A-ACH...! NIE POMYŚLAŁEM O TYM...!!!" with vpunch

# game/script.rpy:2109
translate pl ch4_d739c596:

    # p wow "I-I just, was trying to think of other places we could go, and this one came to mind..."
    p wow "P-po prostu próbowałem wybrać miejsce, do którego moglibyśmy się udać, i to wpadło mi do głowy..."

# game/script.rpy:2110
translate pl ch4_eab2cf4c:

    # w happy "It's lovely. Very romantic 💙"
    w happy "Jest uroczo. Bardzo romantycznie 💙"

# game/script.rpy:2111
translate pl ch4_2f1a8383:

    # w shy "(Straight out of a shoujo manga, honestly... how does he know I'm weak to such things?)"
    w shy "(Jak z shoujo mangi, naprawdę... Skąd wie, że mam słabość do takich rzeczy?)"

# game/script.rpy:2112
translate pl ch4_9218331e:

    # p omg "We don't have to stay... I mean, we've already walked around so much--it's okay if you wanna head back now..."
    p omg "Nie musimy tu zostawać... Znaczy, i tak już długo spacerowaliśmy - nic nie szkodzi, jeśli chcesz wracać..."

# game/script.rpy:2113
translate pl ch4_18984878:

    # p omgstop "N-NOT TO... DO THINGS... I just meant...! I-I'm gonna stop talking......" with vpunch
    p omgstop "N-NIE, ŻEBY... ROBIĆ RZECZY... Tylko...! P-przestanę gadać..." with vpunch

# game/script.rpy:2114
translate pl ch4_6d760657:

    # w love "Pastille."
    w love "Pastylku."

# game/script.rpy:2115
translate pl ch4_7a8b97fb:

    # p seriously "Y-yes...?"
    p seriously "T-tak...?"

# game/script.rpy:2116
translate pl ch4_ec1d1b34:

    # w calm "You've presented me quite the conundrum. If I kiss you now, you'll definitely want to return home with me as soon as possible..."
    w calm "Dałeś mi teraz nie lada zagwozdkę. Jeśli cię teraz pocałuję, na pewno będziesz chciał jak najszybciej wracać ze mną do domu..."

# game/script.rpy:2117
translate pl ch4_80145f9c:

    # w happy "But I wasn't done learning all about you. I'm not ready for our date to end 💙"
    w happy "Ale nie wiem jeszcze o tobie tylu rzeczy. Nie jestem gotów na koniec tej randki 💙"

# game/script.rpy:2118
translate pl ch4_5974e4ff:

    # p embarrassed "O-oh... that IS a conundrum...."
    p embarrassed "O-och... To ci zagwozdka..."

# game/script.rpy:2119
translate pl ch4_dbc74acd:

    # w love "Yes, you see? Both options are equally appealing. However can I decide~?"
    w love "Tak, rozumiesz? Obydwie opcje są tak samo kuszące. I jak tu wybrać~?"

# game/script.rpy:2120
translate pl ch4_ec2c6956:

    # p shy "Haha, um, well... i-it's still light out! Maybe we can hold back until after dinner...."
    p shy "Haha, um, cóż... n-nadal jest jasno! Może możemy tu zostać do kolacji..."

# game/script.rpy:2121
translate pl ch4_584de9f1:

    # w teehee "Or I could have YOU for dinner 💙"
    w teehee "Albo mogę zjeść CIEBIE na kolację 💙"

# game/script.rpy:2122
translate pl ch4_31907a91:

    # p kyaa "A-AH...!" with vpunch
    p kyaa "A-ACH...!" with vpunch

# game/script.rpy:2123
translate pl ch4_f4a3afbc:

    # w calm "On the other hand, you bring up a valid point. Holding back is fun in itself."
    w calm "Ale z drugiej strony, masz trochę racji. Hamowanie się jest doprawdy ujmujące."

# game/script.rpy:2124
translate pl ch4_9d41c26b:

    # p omgstop "Do you expect me to recover after what you just said...?!"
    p omgstop "Oczekujesz, że się pozbieram po tym, co właśnie powiedziałeś...?!"

# game/script.rpy:2125
translate pl ch4_32adccf0:

    # w happy "See~? This IS quite fun!"
    w happy "Widzisz~? Tyle zabawy!"

# game/script.rpy:2126
translate pl ch4_b5263d43:

    # w calm "It's decided, then. The date continues."
    w calm "Więc zadecydowane. Kontynuujemy randkę."

# game/script.rpy:2130
translate pl ch4_98062818:

    # "I give Pastille a moment to calm himself."
    "Daję Pastylkowi chwilę na uspokojenie się."

# game/script.rpy:2131
translate pl ch4_43346300:

    # "We walk up to the railing and look out at the town..."
    "Podchodzimy do barierki i spoglądamy na miasteczko..."

# game/script.rpy:2132
translate pl ch4_2e739e18:

    # nvl clear
    # "You can see Atelier Sweets from here. And the train station next to it."
    nvl clear
    "Widać stąd Atelier Sweets. I stację kolejową zaraz obok."

# game/script.rpy:2134
translate pl ch4_65c0b220:

    # "My house is... somewhere in a row of similarly built homes. Inconspicuous."
    "Mój dom jest... gdzieś tam, w szeregu takich samych budynków. Niepozorny."

# game/script.rpy:2135
translate pl ch4_140deac1:

    # "Fallen petals litter the bricks at our feet, with every little breeze carrying a few more over the railing to land somewhere unknown."
    "Zerwane płatki pokrywają ścieżkę pod naszymi stopami, a każdy podmuch wiatru podnosi kilka z nich i zabiera ze sobą w świat."

# game/script.rpy:2136
translate pl ch4_9b3a7e5d:

    # "After watching them for a while, I turn back to Pastille."
    "Po obserwowaniu ich przez chwilkę, odwracam się do Pastylka."

# game/script.rpy:2137
translate pl ch4_76b2fe88_11:

    # nvl clear
    nvl clear

# game/script.rpy:2140
translate pl ch4_6319f667:

    # w date "Tell me about your magic."
    w date "Opowiedz mi o swojej magii."

# game/script.rpy:2141
translate pl ch4_81ee26b5:

    # p um "O-okay... what do you want to know?"
    p um "O-okej... Co chcesz wiedzieć?"

# game/script.rpy:2142
translate pl ch4_c829cbee:

    # w innocent "Your specialty, dear!"
    w innocent "Chcę znać twoją specjalność, mój drogi!"

# game/script.rpy:2143
translate pl ch4_9847abef:

    # w smile "If you were that good at reconstruction, I imagine it must fall somewhere in that category...?"
    w smile "Skoro tak sobie radzisz z rekonstrukcjami, pewnie to ta kategoria...?"

# game/script.rpy:2144
translate pl ch4_b09961bf:

    # p ehe "Um, not really... I'm actually an astral witch."
    p ehe "Um, nie, niezbyt... Jestem czarodziejem astralnym."

# game/script.rpy:2145
translate pl ch4_443121bc:

    # w my "My, how rare! And what exactly does that entail for you?"
    w my "Rety, cóż za rzadkość! A co dokładnie to dla ciebie oznacza?"

# game/script.rpy:2146
translate pl ch4_44c2df3e:

    # p shy "Ahh, well, I mostly use it for fire spells, like anyone else..."
    p shy "Ach, cóż, używam magii głównie do zaklęć ognia, jak wszyscy inni..."

# game/script.rpy:2147
translate pl ch4_bcabe313:

    # w oh "Forgive me, I'm not well-versed in magic theory... but doesn't astral magic have something to do with creation?"
    w oh "Wybacz, nie jestem zbyt obeznany w teorii magicznej... ale czy magia astralna nie wiąże się z tworzeniem?"

# game/script.rpy:2148
translate pl ch4_ac2d501e:

    # p ehe2 "It does... but that stuff is pretty advanced. I haven't been able to find any books explaining how to use it."
    p ehe2 "Wiąże się... ale to dość zaawansowane zaklęcia. Nie znalazłem żadnej książki, która by ich uczyła."

# game/script.rpy:2149
translate pl ch4_02f8bfe1:

    # p embarrassed "...Which is probably for the best, actually. No one should be allowed to go around creating souls spontaneously...!"
    p embarrassed "...Co chyba wyszło mi na dobre. Nikt nie powinien tak po prostu tworzyć nowych dusz...!"

# game/script.rpy:2150
translate pl ch4_29508975:

    # w neutral "Hm..."
    w neutral "Hm..."

# game/script.rpy:2152
translate pl ch4_1b5322bf:

    # "Pastille rubs the back of his neck, looking off into the distance."
    "Pastylek pociera swoją szyję, wpatrując się gdzieś w oddal."

# game/script.rpy:2153
translate pl ch4_309805fa:

    # "He seems so troubled by the subject..."
    "Wydaje się zmartwiony tematem..."

# game/script.rpy:2154
translate pl ch4_9604342e:

    # "I suppose because he had been living without magic, it may feel strange to openly discuss it?"
    "Zgaduję, że to dlatego iż żył bez magii, więc teraz dziwnie się czuje tak otwarcie o niej mówiąc?"

# game/script.rpy:2155
translate pl ch4_48123bf8:

    # nvl clear
    # "An astral witch, though... I wouldn't have guessed."
    nvl clear
    "Czarodziej astralny, hm... Nigdy bym nie zgadł."

# game/script.rpy:2157
translate pl ch4_c8d56a68:

    # "Putting two and two together, ONE thing makes perfect sense now..."
    "Dodając do siebie fakty, JEDNA rzecz ma teraz wiele sensu..."

# game/script.rpy:2158
translate pl ch4_551942a5:

    # nvl clear
    # w ah "So the famous Atelier Sweets golem was YOUR creation?"
    nvl clear
    w ah "Więc ten jakże sławny golem Atelier Sweets to twoje dzieło?"

# game/script.rpy:2161
translate pl ch4_2c8fd31f:

    # p ehe2 "Haha, is she really that famous? I'd expect our sales to be a little better if that were the case..."
    p ehe2 "Haha, naprawdę jest sławna? W takim wypadku spodziewałbym się, że sprzedaż powinna nam iść nieco lepiej..."

# game/script.rpy:2162
translate pl ch4_fd97e90a:

    # p flustered2 "But... yeah. Just don't go around telling everyone--I didn't know what I was doing when I made her."
    p flustered2 "Ale... tak. Nie rozpowiadam tego wszędzie - nie wiedziałem co robię, gdy ją tworzyłem."

# game/script.rpy:2163
translate pl ch4_e7fb158c:

    # w my "What an amazing feat... and yet you sound almost ashamed of it!"
    w my "Takie cudowne dzieło... a jednak brzmisz, jakbyś prawie się jej wstydził!"

# game/script.rpy:2164
translate pl ch4_0bf92251:

    # p ohno "I-it's not like I regret it or anything... Gumdrop is really great! I just..."
    p ohno "T-to nie tak, że tego żałuję... Żelka jest świetna! Ale..."

# game/script.rpy:2165
translate pl ch4_2ed99bc8:

    # p nervous "I feel bad that she's stuck in a body with so many limitations. Like, she didn't ask to be made that way..."
    p nervous "Czuję się źle, że skazałem ją na życie w tak ograniczonym ciele. Bo przecież nie prosiła, bym ją tworzył..."

# game/script.rpy:2166
translate pl ch4_8694e630:

    # p flustered2 "I didn't know you could even make golems that felt real emotions, so of course I never considered any of that."
    p flustered2 "{size=-4}Nie wiedziałem nawet, że można tworzyć golemy z prawdziwymi uczuciami, więc oczywistym jest, iż nidgy nie zastanawiałem się nad takimi sprawami.{/size}"

# game/script.rpy:2167
translate pl ch4_cde66f06:

    # p shy "...Sorry to go off about it. I-I've just been feeling guilty lately--kind of a heavy topic."
    p shy "...Przepraszam, rozgadałem się. P-po prostu czuję się ostatnio bardzo winny- To dość ciężki temat."

# game/script.rpy:2168
translate pl ch4_9931704c:

    # w ah "No, no... thank you for telling me."
    w ah "Nie, nie... Dziękuję, że mi powiedziałeś."

# game/script.rpy:2169
translate pl ch4_b7df5332:

    # w calm "It's as if I've discovered a whole new side of you today. I'm grateful to know it."
    w calm "To tak, jakbym dziś odkrył cię na nowo. Jestem wdzięczny, że dałeś mi się poznać od tej strony."

# game/script.rpy:2170
translate pl ch4_d2da19ee:

    # p ehe "Thanks for listening... I don't get many chances to talk about things like this, so I'm grateful for it, too."
    p ehe "Dziękuję za wysłuchanie mnie... Nie za często nadarza się okazja, bym mówił o takich rzeczach, więc również jestem wdzięczy."

# game/script.rpy:2171
translate pl ch4_2f822c09:

    # w love "Hmhm, hearing you speak of her though, I'd love to meet this golem of yours one day."
    w love "Hmhm, jak tak mówisz o tym swoim golemie, bardzo chciałbym kiedyś go spotkać."

# game/script.rpy:2172
translate pl ch4_87960f32:

    # p sure "Sure. Maybe one day."
    p sure "Pewnie. Kiedyś na pewno."

# game/script.rpy:2175
translate pl ch4_e955de1d:

    # "Pastille is amazing."
    "Pastylek jest wspaniały."

# game/script.rpy:2176
translate pl ch4_dd1b4e98:

    # "I've never met anyone who would downplay their talents this much--I could ask a thousand questions and still only scratch the surface..."
    "Nigdy nie spotkałem kogoś, kto tak nie docenia własnych talentów- Mógłbym zadać mu tysiące pytań, a i tak nie dowiedziałbym się za wiele..."

# game/script.rpy:2177
translate pl ch4_034046bb:

    # "My, now I'M the insatiable one. How the tables have turned!"
    "Rety, teraz to JA jestem tym nie do zaspokojenia. Cóż za obrót spraw!"

# game/script.rpy:2178
translate pl ch4_aa528040:

    # nvl clear
    # "We decide it's time to move on, and descend the stairs from whence we came..."
    nvl clear
    "Decydujemy zgodnie, że nadszedł czas na opuszczenie tego miejsca, i zaczynamy drogę na dół..."

# game/script.rpy:2180
translate pl ch4_5310cd5c:

    # "...Still chatting endlessly as we decide where we'll wander to next."
    "...Nadal nieskończenie rozmawiając o tym, gdzie udamy się za chwilę."

# game/script.rpy:2181
translate pl ch4_76b2fe88_12:

    # nvl clear
    nvl clear

# game/script.rpy:2184
translate pl ch4_ab4f864b:

    # "Over dinner, Pastille opens up a little more."
    "Przy kolacji, Pastylek nieco bardziej się otwiera."

# game/script.rpy:2185
translate pl ch4_2a1a4890:

    # "We trade anecdotes, listening intently to each others' stories no matter how unremarkable the events told within them."
    "Wymieniamy się anegdotami i słuchamy swoich historii, nieważne, jak przeciętne wydarzenia opisujemy."

# game/script.rpy:2186
translate pl ch4_a504ab29:

    # "I could never tire of it~ I was hooked by his every word."
    "Nigdy bym się tym nie zmęczył~ Wciągnąłem się w każde jedno słowo."

# game/script.rpy:2187
translate pl ch4_efbe6e4c:

    # nvl clear
    # "Alas, the hours flew by, and our day together was quickly approaching its end..."
    nvl clear
    "Niestety, godziny nieubłagalnie mijały, a nasz wspólny dzień szybko dobiegał końcowi..."

# game/script.rpy:2189
translate pl ch4_d04a4349:

    # "But now we had the whole night to look forward to 💙"
    "Ale mieliśmy przed sobą całą noc 💙"

# game/script.rpy:2190
translate pl ch4_b7200d05:

    # "The sun was on its way down as we emerged back onto the street, the atmosphere so different than it had been just a short while ago."
    "Słońce było już w drodze w dół gdy wyszliśmy na ulicę, atmosfera o wiele inna od tej, która otaczała nas jeszcze niedawno."

# game/script.rpy:2191
translate pl ch4_d4905e0a:

    # "Pastille brushes his bangs aside and asks..."
    "Pastylek przeczesuje swoje włosy i pyta..."

# game/script.rpy:2192
translate pl ch4_76b2fe88_13:

    # nvl clear
    nvl clear

# game/script.rpy:2194
translate pl ch4_b2bdea1d:

    # p "Do you wanna head back? It's starting to get late...."
    p "Gotów na powrót? Zaczyna się robić późno..."

# game/script.rpy:2195
translate pl ch4_843a037d:

    # w date shy "Hmhm, you've waited so patiently to be able to say that."
    w date shy "Hmhm, czekałeś tak długo, by to powiedzieć."

# game/script.rpy:2196
translate pl ch4_8b799080:

    # p embarrassed "I-it's not like you aren't thinking of it too..."
    p embarrassed "T-to nie tak, że TY o tym nie myślisz..."

# game/script.rpy:2197
translate pl ch4_6cca094e:

    # w innocent "Let's go through the park. It's a shorter walk 💙"
    w innocent "Przejdźmy się przez park. To krótsza droga 💙"

# game/script.rpy:2198
translate pl ch4_027952fc:

    # p ehe "Sure...! A-after you...."
    p ehe "Pewnie...! Z-za tobą..."

