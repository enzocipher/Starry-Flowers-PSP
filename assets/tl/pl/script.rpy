# game/script.rpy:543
translate pl start_d04e37c7:

    # w smile "So diligent 💙 Does that mean this is your first night out in a while?"
    w smile "Jaki pracowity 💙 Czyżby to była twoja pierwsza randka od dawna?"

# game/script.rpy:544
translate pl start_03f245f3:

    # p oh "Ah... yeah, I guess it is."
    p oh "Ach... Tak, to prawda."

# game/script.rpy:545
translate pl start_97012fb5:

    # w innocent "I'm honored you were willing to share it with me, then~"
