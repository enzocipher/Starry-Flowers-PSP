    p wha "Hę...?"

# game/script.rpy:421
translate pl start_c33cac40:

    # w happy "Coming here, I mean. What did you think I was asking~?"
    w happy "W tym miejscu, znaczy. A o czym sobie pomyślałeś?"

# game/script.rpy:422
translate pl start_6a4783ff:

