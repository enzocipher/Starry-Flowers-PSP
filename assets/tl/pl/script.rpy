translate pl ch5_9642d0ad:

    # n "...which, much to his dismay, yields the same result."
    n "...która, ku jego przerażeniu, kończy tak samo jak poprzednia."

# game/script.rpy:2480
translate pl ch5_f95e4a27:

    # w mad "...."
    w mad "..."

# game/script.rpy:2481
translate pl ch5_5d25a848:

    # w oops "Okay. Magic is tied to emotions... I mustn't get frustrated. I have to focus."
    w oops "Dobra. Magia łączy się z emocjami... Nie mogę zbyt się frustrować. Muszę się skupić."

# game/script.rpy:2482
translate pl ch5_a5ede285:

    # w decline "Deep breaths. It never helps to force it... just imagine the desired scent, and...."
    w decline "Głębokie oddechy. Zmuszanie się niczemu nie pomoże... Wyobraź sobie ten zapach, i..."

# game/script.rpy:2485
translate pl ch5_a6226304:

    # n "He tries for a third time..."
    n "Próbuje trzeci raz..."

# game/script.rpy:2486
translate pl ch5_818ee6b1:

    # n "...and yet..."
    n "...i wciąż..."

# game/script.rpy:2489
translate pl ch5_9250f26a:

    # w yell "Peach again?!" with vpunch
    w yell "Znów brzoskwinia?!" with vpunch

# game/script.rpy:2490
translate pl ch5_aec19f40:

    # w pout "This is a waste of supplies. So much for my attempt at diligence...!"
    w pout "To strata materiałów. I tyle by było z mojej pracowitości...!"

# game/script.rpy:2491
translate pl ch5_2f58dc58:

    # w oops "If I can't conjure other scents, I'll have to find something else to occupy my time...."
    w oops "Jeśli nie jestem w stanie tworzyć innych zapachów, muszę znaleźć coś innego, co zajmie mój czas..."

# game/script.rpy:2492
translate pl ch5_c94aab20:

    # w innocent "Ahh, housework! I can finally get some chores done around here~!"
    w innocent "Ach, prace domowe! Nareszcie będę mógł trochę wysprzątać~!"

# game/script.rpy:2493
translate pl ch5_199d4349:

    # w aha "Nothing could possibly distract me from finishing them today... they ARE the distraction!"
    w aha "Nic nie rozproszy mnie dziś na tyle, bym o nich zapomniał... To ONE są rozproszeniem!"

# game/script.rpy:2494
translate pl ch5_db67403d:

    # w oh "Oh, that's right! I still had laundry to put away, didn't I?"
    w oh "Och, tak, właśnie! Nadal muszę zrobić pranie, czyż nie?"

