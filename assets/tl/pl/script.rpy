# game/script.rpy:482
translate pl start_b83133bb:

    # p ehe2 "S-so, Periwinkle... what do you do for a living?"
    p ehe2 "W-więc, Barwinku... czym się zajmujesz?"

# game/script.rpy:483
translate pl start_a835dd10:

    # w smile "Besides tease you until you're barely able to speak?"
    w smile "Poza droczeniem się z tobą i odbieraniem ci mowy?"

# game/script.rpy:484
