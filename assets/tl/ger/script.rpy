    "Es ist schon eine Weile her, dass ich mit einem Dämonen geschlafen hab... 💙 Jetzt freue ich mich darauf~!"

# game/script.rpy:1469
translate ger ch3_078fe372:

    # nvl clear
    # centered "{nw}"
    nvl clear
    centered "{nw}"

