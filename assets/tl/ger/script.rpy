# game/script.rpy:339
translate ger start_6178e217:

    # w happy "Hello, and welcome to the deliciously romantic tale of my first love~! 💙"
    w happy "Hallo und willkommen zur köstlich romantischen Geschichte von meiner ersten Liebe~! 💙"

# game/script.rpy:340
translate ger start_75384ed2:

    # w calm "There's just one thing before we begin... I can grant you the power to choose my accessories at various points in the story."
    w calm "Da gibt es eine Sache, bevor wir beginnen..."
    w "Ich kann dir die Macht verleihen, meine Accessoires an verschiedenen Punkten in der Geschichte für mich auszuwählen."

# game/script.rpy:341
translate ger start_5aa584c1:

    # w teehee "I'm being very gracious to offer such a thing, you know 💙 If you use it, you had better make me look as adorable as possible."
    w teehee "{size=-3}Es ist sehr großzügig von mir, dies anzubieten, weißt du 💙 Wenn du sie nutzt, dann lässt du mich besser so liebenswert wie nur möglich aussehen."

# game/script.rpy:342
translate ger start_1a90223c:

    # w smile "This little feature has no effect on the story otherwise. It's simply for your entertainment, should you wish for it."
    w smile "Dieses kleine Feature hat keinen Einfluss auf die Story. Es dient lediglich der Unterhaltung, solltest du dies wünschen."

# game/script.rpy:346
translate ger start_b10e0414:

    # n "Would you like to enable the dressup feature?" nointeract
    n "Möchtest du das Dress Up Feature zulassen?" nointeract

# game/script.rpy:350
translate ger start_197230b2:

    # w happy "Then without further ado... let's get ready for my first date with Pastille~! 💙"
    w happy "Dann ohne weitere Umschweife... bereiten wir uns auf mein erstes Date mit Pastille vor~! 💙"

# game/script.rpy:355
translate ger start_7584d0b6:

    # w calm "Then without further ado..."
    w calm "Dann ohne weitere Umschweife..."

# game/script.rpy:362
translate ger start_7b49a2da:

    # centered "{w=3}{nw}"
    centered "{w=3}{nw}"

# game/script.rpy:369
translate ger start_ab7ee487:

    # "Today I met a boy at a candy shop."
    "Heute traf ich einen Jungen im Süßwarenladen."

# game/script.rpy:370
translate ger start_085c93f7:

    # "The moment I saw him, I just knew I couldn't leave without flirting a little~"
    "In dem Moment, als ich ihn sah, wusste ich, dass ich ihn nicht gehen lassen kann, ohne ein bisschen zu flirten~"

# game/script.rpy:371
translate ger start_3670944d:

    # "He was so delightfully flustered. Which, of course, only made him that much cuter..."
    "Er war so herrlich nervös. Was ihn natürlich nur noch süßer gemacht hat..."

# game/script.rpy:372
translate ger start_3201de99:

    # "When I told him to meet me here, he could only manage to nod in response."
    "Als ich ihm sagte, er soll mich hier treffen, konnte er nur noch nicken."

# game/script.rpy:373
translate ger start_de85fd75:

    # nvl clear
    # w happy "(So cute... ah, my favorite type to pursue!)"
    nvl clear
    w happy "(So süß... ah, mein liebster Typ zum Jagen!)"

# game/script.rpy:376
translate ger start_fbd81c6f:

    # w smile "(Ah! There he is now~)"
    w smile "(Ah! Da ist er ja~)"

# game/script.rpy:385
translate ger start_3578f0d2:

    # p ehe "Hey! I hope I didn't keep you waiting too long..."
    p ehe "Hey! Ich hoffe, ich habe dich nicht zu lange warten lassen..."

# game/script.rpy:386
translate ger start_db24a8d5:

    # w my "Pastille! Look at you~"
    w my "Pastille! Sieh dich an~"

# game/script.rpy:387
translate ger start_f197d905:

    # w happy "And here I thought you looked plenty good in that uniform! My heart was unprepared 💙"
    w happy "Und ich dachte, besser als in deiner Uniform ginge nicht! Mein Herz war darauf nicht vorbereitet 💙"

# game/script.rpy:388
translate ger start_5b504872:

    # p ohno "S-sorry, is it too much? I can change..."
    p ohno "S-sorry, ist das zu viel? Ich kann mich umziehen..."

# game/script.rpy:389
translate ger start_ee51ebde:

    # w drool "My, but I haven't even fully seen what's under that cloak of yours! It'd be such a waste to change prematurely..."
    w drool "Du, ich hab ja noch nicht mal ganz gesehen, was unter deinem Umhang ist! Wär doch eine Verschwendung, sich vorzeitig umzuziehen..."

# game/script.rpy:390
translate ger start_1f1b24bf:

    # p shy "Ah... r-right! Forget it, then."
    p shy "Ah... st-stimmt! Dann lass ich's."

# game/script.rpy:391
translate ger start_ebcee129:

    # w calm "Besides..."
    w calm "Außerdem..."

# game/script.rpy:392
translate ger start_fa697933:

    # w teehee "It'll be my pleasure to unwrap you later on, my sweet 💙"
    w teehee "Wird es mir eine Freude sein, dich später auszupacken, mein Süßer 💙"

# game/script.rpy:393
translate ger start_31907a91:

    # p kyaa "A-AH...!" with vpunch
    p kyaa "A-AH...!" with vpunch

# game/script.rpy:394
translate ger start_308ba70d:

    # w innocent "Now, shall we head to dinner?"
    w innocent "Also dann, gehen wir rein?"

# game/script.rpy:395
translate ger start_38a173c6:

    # p omg "O-okay...! Lead the way...."
    p omg "O-okay...! Geh du voran...."

# game/script.rpy:399
translate ger start_a3c06338:

    # "I truly didn't expect it..."
    "Ich hatte es wirklich nicht erwartet..."

# game/script.rpy:400
translate ger start_f7e871b8:

    # "He definitely seemed the type to have a more modest sense of style."
    "Er wirkte definitiv so, als hätte er einen eher schlichten Modegeschmack."

# game/script.rpy:401
translate ger start_92955daf:

    # "Thigh highs, with such a short skirt? Or was it a dress...? I only briefly glimpsed it."
    "Schenkelhohe Strümpfe mit einem so kurzen Rock? Oder war es ein Kleid...? Ich hatte nur einen kurzen Blick erhaschen können."

# game/script.rpy:402
translate ger start_da91d2ff:

    # "I'm quite looking forward to seeing more tonight 💙"
    "Ich freue mich sehr darauf, heute Nacht mehr zu sehen 💙"

# game/script.rpy:403
translate ger start_76b2fe88:

    # nvl clear
    nvl clear

# game/script.rpy:411
translate ger start_f9685e80:

    # "The restaurant I decided on is one in my usual rotation. Good for a quiet, comfortable evening."
    "Das Restaurant, für das ich mich entschied, ist eins meiner Stammlokale. Gut für einen ruhigen, gemütlichen Abend."

# game/script.rpy:412
translate ger start_ec15e064:

    # "For a variety of dates, you must have a variety of locations in mind! Tonight's mood is... ~Romantic Rendezvous~"
    "Für eine Vielfalt an Dates braucht man auch eine Vielfalt an Lokalen im Kopf! Die Stimmung für den Abend ist... ~Romantische Verabredung~"

# game/script.rpy:413
translate ger start_86384255:

    # "It's a little high-end, though not overtly so. Just enough to make the night feel special 💙"
    "Es ist ein bisschen gehoben, aber nicht zu offensichtlich. Gerade genug, um den Abend besonders wirken zu lassen 💙"

# game/script.rpy:414
translate ger start_76b2fe88_1:

    # nvl clear
    nvl clear

# game/script.rpy:417
translate ger start_95b9df83:

    # n "Pastille slides into the booth, following Periwinkle's lead."
    n "Pastille rutscht, Periwinkle folgend, in die Nische."

# game/script.rpy:418
translate ger start_ac7632e0:

    # n "One hand holds his mantle in place, while the other brushes his bangs aside anxiously..."
    n "Eine Hand hält seinen Umhang fest, während die andere seinen Pony nervös zur Seite schiebt..."

# game/script.rpy:419
translate ger start_21398492:

    # w smile "Is this your first time?"
    w smile "Ist das dein erstes Mal?"

# game/script.rpy:420
translate ger start_db90c8f0:

    # p wha "Huh...?"
    p wha "Häh...?"

# game/script.rpy:421
translate ger start_c33cac40:

    # w happy "Coming here, I mean. What did you think I was asking~?"
    w happy "Hier, meine ich. Was dachtest du denn, was ich meinte~?"

# game/script.rpy:422
translate ger start_6a4783ff:

    # p embarrassed "Ah--! Haha... no, nothing...."
    p embarrassed "Ah--! Haha... nein, nichts...."

# game/script.rpy:423
translate ger start_00f05a14:

    # p neutral "I've never been here before. It seems fancy."
    p neutral "Ich bin hier noch nie gewesen. Es wirkt schick."

# game/script.rpy:424
translate ger start_f4e0eba9:

    # w calm "I'm a fan of the atmosphere. The food isn't bad, either."
    w calm "Ich bin ein Fan der Atmosphäre. Das Essen ist auch nicht schlecht."

# game/script.rpy:426
translate ger start_db213eb7:

    # w smile "Now, let's get a few formalities out of the way, shall we? First and foremost... your pronouns?"
    w smile "Nun lass uns mal ein paar Formalitäten aus dem Weg räumen, okay? Zuallerst einmal... deine Pronomen?"

# game/script.rpy:427
translate ger start_a5b368da:

    # p oh "Oh, um, I just use he/him. What about you?"
    p oh "Oh, ähm, ich nutze einfach er/ihn. Was ist mit dir?"

# game/script.rpy:428
translate ger start_e13d1dc4:

    # w calm "The same. Though I don't necessarily mind being called by others... especially considering my presentation."
    w calm "Das gleiche. Es macht mir aber nicht wirklich was aus, andere zu hören zu bekommen... man bedenke nur meine Aufmachung."

# game/script.rpy:429
translate ger start_22814ee5:

    # p ehe "Aha, understandable..."
    p ehe "Aha, verständlich..."

# game/script.rpy:430
translate ger start_1fb598dd:

    # w smile "Next, expectations. I consider clarity in this regard to be a key part of ensuring we both enjoy ourselves to the fullest."
    w smile "Und nun Erwartungen."
    w "Ich erachte Klarheit, was das angeht, als wichtiges Element, um sicherzustellen, dass wir den größtmöglichen Spaß haben."

# game/script.rpy:431
translate ger start_9ddac06c:

    # w "I do this sort of thing often, you see. As such, I have a couple of ground rules to establish."
    w "Ich mach so was öfters, weißt du. Deshalb habe ich ein paar Grundregeln aufgestellt."

# game/script.rpy:433
translate ger start_d94542f4:

    # p smile "Sure. I'm actually glad you brought it up..."
    p smile "Klar. Ich bin sogar froh, dass du das ansprichst..."

# game/script.rpy:434
translate ger start_cb1d6efd:

    # w oh "Oh?"
    w oh "Oh?"

# game/script.rpy:435
translate ger start_140c840a:

    # p ehe "I'm not looking for anything serious. In fact, I kinda prefer when it's just a one-night thing..."
    p ehe "Ich bin nicht auf der Suche nach was Ernstem. Ich mag es sogar lieber, wenn es nur ein Ding für eine Nacht ist..."

# game/script.rpy:436
translate ger start_4711c7fe:

    # w innocent "Hmhm, we're on the very same page then!"
    w innocent "Mhm, dann sind wir auf einer Wellenlänge!"

# game/script.rpy:437
translate ger start_c6c6b93b:

    # p shy "Um, not that I mind if... y'know. We end up wanting to do this again some other time."
    p shy "Ähm, also nicht dass ich was dagegen hätte... du weißt schon. Wenn wir das irgendwann doch nochmal machen wollen."

# game/script.rpy:438
translate ger start_8df12252:

    # w drool "(That's quite likely for me, in this case...)"
    w drool "(In diesem Fall wird das ziemlich wahrscheinlich sein...)"

# game/script.rpy:439
translate ger start_3f4a3176:

    # w happy "Certainly! I'm open to that as well."
    w happy "Sicher! Dafür bin ich ebenfalls offen."

# game/script.rpy:440
translate ger start_d287ebe0:

    # p um "Did you have... any other ground rules? Sorry, I didn't mean to cut you off..."
    p um "Hast du... noch andere Grundregeln? Sorry, ich wollte dich nicht unterbrechen..."

# game/script.rpy:441
translate ger start_0c30cc41:

    # w smile "Are you nervous?"
    w smile "Bist du nervös?"

# game/script.rpy:442
translate ger start_275debba:

    # p nervous "Y...yes...."
    p nervous "J...ja...."

# game/script.rpy:443
translate ger start_715412b4:

    # w calm "You can tell me to stop if you're ever feeling too overwhelmed. That's the other rule."
    w calm "Du kannst mir jederzeit sagen, wenn du dich überwältigt fühlst. Das ist die andere Regel."

# game/script.rpy:444
translate ger start_62d8969b:

    # p ohno "I, um..."
    p ohno "Ich, ähm..."

# game/script.rpy:445
translate ger start_2a3aa3d6:

    # w smile "...?"
    w smile "...?"

# game/script.rpy:446
translate ger start_b1edeb82:

    # p embarrassed "I like... feeling overwhelmed. T-to an extent."
    p embarrassed "Ich mag es... mich überwältigt zu fühlen. I-in gewissem Maße."

# game/script.rpy:447
translate ger start_2164c6c3:

    # w love "(I had assumed as much, but to hear you admit it outright...! Ah, Pastille! 💙)"
    w love "(Das hatte ich schon angenommen, aber es so von ihm zu hören...! Ah, Pastille! 💙)"

# game/script.rpy:448
translate ger start_d8ad86c7:

    # w teehee "In that case, I'll do my best to overwhelm you, my sweet~"
    w teehee "In diesem Fall werde ich mein Bestes geben, dich zu überwältigen, mein Süßer~"

# game/script.rpy:449
translate ger start_a9e27c65:

    # p omg "A-AH...." with vpunch
    p omg "A-AH...." with vpunch

# game/script.rpy:454
translate ger start_35081bb5:

    # "Yes, this was shaping up to be a wonderful night indeed."
    "Ja, das entwickelte sich durchaus zu einem wundervollen Abend."

# game/script.rpy:455
translate ger start_cf4b36ae:

    # "The waiter came to take our order. I went first, to give my sweet date a chance to compose himself."
    "Der Kellner kam und nahm unsere Bestellung auf. Ich bestellte zuerst, damit mein süßes Date die Chance hat, sich zu fangen."

# game/script.rpy:456
translate ger start_d9753442:

    # "With our food ordered, Pastille finally drops his mantle to reveal..."
    "Als wir unser Essen bestellt hatten, nimmt Pastille endlich seinen Umhang ab und zeigt..."

# game/script.rpy:457
translate ger start_76b2fe88_2:

    # nvl clear
    nvl clear

# game/script.rpy:460
translate ger start_462aa618:

    # w drool "(My, my...! So it was a cute little dress after all!)"
    w drool "(Meine Güte...! Es war also tatsächlich ein kleines süßes Kleid!)"

# game/script.rpy:462
translate ger start_17819f40:

    # w happy "Oh~ and here I thought you were saving the surprise for AFTER dinner!"
    w happy "Oh~ und ich dachte, du würdest die Überraschung für NACH dem Essen aufheben!"

# game/script.rpy:463
translate ger start_2fff06b6:

    # p ehe "Sorry, um... I started feeling awkward with the extra layer...."
    p ehe "Sorry, ähm... es hat sich irgendwie komisch angefühlt, noch diese Extraschicht zu tragen...."

# game/script.rpy:464
translate ger start_6210c123:

    # w love "Don't apologize~ My only lament is not getting to take it off you myself 💙"
    w love "Entschuldige dich nicht~ Meine einzige Klage ist, dass nicht ich es bin, der es dir auszieht 💙"

# game/script.rpy:465
translate ger start_31907a91_1:

    # p kyaa "A-AH...!" with vpunch
    p kyaa "A-AH...!" with vpunch

# game/script.rpy:466
translate ger start_0a043ff2:

    # w teehee "You'll save the last few layers for me, won't you?"
    w teehee "Die letzten paar Schichten überlässt du aber mir, oder?"

# game/script.rpy:467
translate ger start_02d73954:

    # p dying "M...MHM...!"
    p dying "M...MHM...!"

# game/script.rpy:468
translate ger start_a79b9707:

    # w innocent "That's all that matters, then 💙"
    w innocent "Nur darauf kommt es an 💙"

# game/script.rpy:470
translate ger start_e98f0bac:

    # "I'm having the time of my life. And by the looks of it, so is Pastille!"
    "Ich habe eine Menge Spaß. Und so wie es aussieht, Pastille auch!"

# game/script.rpy:471
translate ger start_86f73f34:

    # "Ahh, I LIVE to tease cute witch boys... how fortunate that I came across the sweetest one today!"
    "Aah, ich LEBE dafür, süße Hexenjungs zu necken... was für ein Glück, dass ich heute den süßesten davon getroffen habe!"

# game/script.rpy:472
translate ger start_76b2fe88_3:

    # nvl clear
    nvl clear

# game/script.rpy:474
translate ger start_b1b75f8a:

    # "Our food arrives before Pastille is able to recover."
    "Unser Essen kommt an, bevor es Pastille gelingt, sich zu erholen."

# game/script.rpy:475
translate ger start_e9d06f67:

    # "He can't even look the waiter in the eye... 💙 How adorable!"
    "Er kann dem Kellner nicht mal in die Augen schauen... 💙 Wie entzückend!"

# game/script.rpy:476
translate ger start_bb6e6224:

    # "No, I mustn't overindulge before we've even eaten our meal..."
    "Nein, ich darf mich nicht schon vor dem Essen zu sehr hineinsteigern..."

# game/script.rpy:477
translate ger start_813dd076:

    # "There will be plenty of time after dessert~"
    "Nach dem Dessert wird noch genug Zeit sein~"

# game/script.rpy:478
translate ger start_76b2fe88_4:

    # nvl clear
    nvl clear

# game/script.rpy:480
translate ger start_c8daa5b3:

    # n "Pastille takes a few bites of his food before speaking up."
    n "Pastille isst ein bisschen was von seinem Essen, ehe er zu sprechen anfängt."

# game/script.rpy:482
translate ger start_b83133bb:

    # p ehe2 "S-so, Periwinkle... what do you do for a living?"
    p ehe2 "A-also, Periwinkle... was machst du denn beruflich?"

# game/script.rpy:483
translate ger start_a835dd10:

    # w smile "Besides tease you until you're barely able to speak?"
    w smile "Abgesehen davon, dich so sehr zu necken, dass du kaum noch reden kannst?"

# game/script.rpy:484
translate ger start_91a58fff:

    # p flustered "Yes, besides that!"
    p flustered "Ja, davon abgesehen!"

# game/script.rpy:485
translate ger start_4a82f0a6:

    # w calm "My line of WORK, then... hmhm, I suppose I can tell you."
    w calm "Meine ARBEIT also... hmm, ich denke, das kann ich dir verraten."

# game/script.rpy:487
translate ger start_0c6c18ec:

    # w smile "I'm an aromagician. I specialize in creating pleasant scents."
    w smile "Ich bin ein Aromagier. Mein Fachgebiet ist die Herstellung angenehmer Düfte."

# game/script.rpy:492
translate ger start_8154e712:

    # n "Periwinkle tugs his wand out from his sleeve and lightly taps the candle on the table."
    n "Periwinkle zückt seinen Zauberstab aus dem Ärmel und tippt damit leicht an die Kerze auf dem Tisch."

# game/script.rpy:493
translate ger start_d54b5a73:

    # n "In a small burst, the atmosphere shifts around the pair..."
    n "In einer kleinen Explosion verändert sich die Atmosphäre um sie herum..."

# game/script.rpy:494
translate ger start_508d0c25:

    # n "The candle's original aroma is quickly forgotten as it's replaced by something new and cozier."
    n "Das ursprüngliche Aroma der Kerze ist schnell vergessen, als es durch etwas Neues und Gemütlicheres ersetzt wird."

# game/script.rpy:496
translate ger start_47abf8af:

    # p oh "Oh... that IS nice."
    p oh "Oh... das IST angenehm."

# game/script.rpy:497
translate ger start_66fd115e:

    # p smile "What smell is that? I'm no good at pinpointing stuff like this..."
    p smile "Was für ein Geruch ist das? Ich bin nicht gut darin, so etwas genau zu erkennen..."

# game/script.rpy:498
translate ger start_67b12735:

    # w oh "Vanilla. I thought it suited you. Although..."
    w oh "Vanille. Ich dachte, es steht dir. Allerdings..."

# game/script.rpy:499
translate ger start_86dccb51:

    # w shy "I'm starting to think a more lustful scent might've been a better fit."
    w shy "...glaube ich, ein eher wollüstiger Duft hätte besser gepasst."

# game/script.rpy:500
translate ger start_a5d894c0:

    # p omgstop "Wh-what does that even mean...?!" with vpunch
    p omgstop "W-was soll das denn bedeuten...?!" with vpunch

# game/script.rpy:501
translate ger start_f5e481ca:

    # w teehee "Just that you've done nothing but exceed my expectations 💙"
    w teehee "Nur dass du nichts getan hast, außer meine Erwartungen zu übertreffen 💙"

# game/script.rpy:502
translate ger start_857b0c55:

    # p flustered "I-I'm not... doing anything...."
    p flustered "I-ich mach... doch gar nichts...."

# game/script.rpy:504
translate ger start_51513c28:

    # n "Pastille retreats behind his glass of water, overwhelmed by embarrassment once again."
    n "Pastille versteckt sich hinter seinem Glas Wasser, mal wieder von seiner Verlegenheit überwältigt."

# game/script.rpy:505
translate ger start_0c12172a:

    # w love "(I did say I'd go a little easier on him, didn't I...? Ah, he's just too irresistible 💙)"
    w love "(Ich meinte doch, ich schalte bei ihm einen Gang runter, oder...? Ah, er ist einfach zu unwiderstehlich 💙)"

# game/script.rpy:507
translate ger start_41bfaa4f:

    # w calm "Anywho... I bottle and sell scents like this one. It's fairly lucrative work, once you build a reputation for yourself."
    w calm "Wie dem auch sei... Ich fülle Düfte wie diesen in Flaschen ab und verkaufe sie."
    w "Es ist eine recht lukrative Arbeit, wenn du dir erstmal einen Ruf aufgebaut hast."

# game/script.rpy:508
translate ger start_9b95030e:

    # p oh "Ah... sounds fulfilling."
    p oh "Ah... klingt erfüllend."

# game/script.rpy:509
translate ger start_df636102:

    # w smile "What about you, Pastille? What kind of magic do you specialize in?"
    w smile "Was ist mir dir, Pastille? Welche Art von Magie ist dein Fachgebiet?"

# game/script.rpy:510
translate ger start_acfb287e:

    # p shy "Oh, I... I had mostly been living without magic, until recently."
    p shy "Oh, ich... ich habe bis vor kurzem die meiste Zeit ohne Magie gelebt."

# game/script.rpy:511
translate ger start_ba1cda83:

    # w oh "Without magic...? I can't imagine."
    w oh "Ohne Magie...? Kann ich mir gar nicht vorstellen."

# game/script.rpy:512
translate ger start_39cda655:

    # p smile "It's not so bad. I mean, humans do it, so why not?"
    p smile "Es ist gar nicht so schlecht. Ich meine, Menschen machen das so, also warum nicht?"

# game/script.rpy:513
translate ger start_1b160ca1:

    # w "I suppose that's true."
    w "Wohl wahr."

# game/script.rpy:514
translate ger start_a901b988:

    # w smile "I very directly make a living off of mine, so I'd find myself in quite a bind if I wasn't able to use it!"
    w smile "Meine dient meinem Lebensunterhalt, also wäre ich echt in der Klemme, könnte ich sie nicht nutzen!"

# game/script.rpy:515
translate ger start_a5adf706:

    # w teehee "Not that I mind being bound from time to time, you know 💙"
    w teehee "Nicht, dass es mir was ausmacht, ab und zu in einer Klemme zu sein, wenn du verstehst 💙"

# game/script.rpy:516
translate ger start_49904814:

    # p omgstop "H-how do you keep doing that...?! Every time I think we're talking about something innocent..."
    p omgstop "W-wie machst du das nur immer...?! Jedes Mal denke ich, wir reden über etwas Unschuldiges..."

# game/script.rpy:517
translate ger start_cbd9ddf7:

    # w love "(Ah, I just can't help myself, can I?)"
    w love "(Ah, ich kann einfach nicht anders!)"

# game/script.rpy:518
translate ger start_5f36b5b8:

    # w teehee "Deliberate word choice, my sweet~ would you like me to hold back a little more?"
    w teehee "Wohlüberlegte Wortwahl, mein Süßer~ möchtest du, dass ich mich etwas mehr zurückhalte?"

# game/script.rpy:519
translate ger start_04132ea6:

    # p um "N-no, it's okay... I was just..."
    p um "N-nein, es ist okay... Ich war nur..."

# game/script.rpy:520
translate ger start_89193a14:

    # p embarrassed "Kinda impressed...."
    p embarrassed "irgendwie beeindruckt..."

# game/script.rpy:526
translate ger start_ca622856:

    # "We finish up our meals, and decide on sharing a slice of strawberry cheesecake for dessert."
    "Wir essen auf und entscheiden uns dafür, uns zum Dessert noch ein Stück Strawberry Cheesecake zu teilen."

# game/script.rpy:527
translate ger start_d1910196:

    # "Pastille deliberately leaves the larger bits of strawberries for me..."
    "Pastille lässt absichtlich die größeren Stücke Erdbeeren für mich liegen..."

# game/script.rpy:528
translate ger start_014b42bb:

    # "I wonder, is it because he doesn't like them? Or is he just THAT kind?"
    "Ich frage mich, ob er sie nicht mag? Oder ist er einfach SO nett?"

# game/script.rpy:529
translate ger start_a37124b7:

    # "Either way, this has quickly become my most favorite date of the past few months 💙"
    "So oder so, das hier ist schnell zu meinem allerliebsten Date der letzten paar Monate geworden 💙"

# game/script.rpy:530
translate ger start_76b2fe88_5:

    # nvl clear
    nvl clear

# game/script.rpy:534
translate ger start_a47a6a63:

    # w smile "Tell me more about yourself, Pastille. I'm afraid the only thing I know is that you work at the renowned Atelier Sweets..."
    w smile "Erzähl mir mehr über dich, Pastille. Ich fürchte, ich weiß nur, dass du im berühmten Atelier Sweets arbeitest..."

# game/script.rpy:535
translate ger start_a256d276:

    # p ehe "Oh, um... there's not much else to know...."
    p ehe "Oh, ähm... da gibt es nicht viel mehr zu wissen...."

# game/script.rpy:536
translate ger start_b5d5581a:

    # w happy "Surely there's plenty more than just that! Any hobbies, perhaps?"
    w happy "Sicherlich gibt's da noch einiges mehr als nur das! Irgendwelche Hobbys vielleicht?"

# game/script.rpy:537
translate ger start_ff0c91f6:

    # p shy "C...cleaning, maybe?"
    p shy "P...putzen vielleicht?"

# game/script.rpy:538
translate ger start_323445d9:

    # w calm "Any NON work-related hobbies, dear."
    w calm "Irgendwelche NICHT arbeitslastigen Hobbys, Süßer."

# game/script.rpy:539
translate ger start_452a98f0:

    # p ehe2 "Sorry, I never know how to answer these types of questions..."
    p ehe2 "Sorry, ich weiß nie, wie ich diese Art von Fragen beantworten soll..."

# game/script.rpy:540
translate ger start_bd8b2307:

    # p smile "My best friend is an alchemist, so I've recently been going on little adventures to help gather ingredients for her craft."
    p smile "{size=-2}Meine beste Freundin ist eine Alchimistin. Und kürzlich bin ich auf kleine Abenteuer gegangen, um ihr dabei zu helfen, Zutaten für ihre Arbeit zu finden."

# game/script.rpy:541
translate ger start_6c670493:

    # w my "Now THERE'S something interesting!"
    w my "Na DAS ist doch mal was Interessantes!"

# game/script.rpy:542
translate ger start_e955536c:

    # p shy "Other than that, I honestly don't get out much... I have my hands full running the store."
    p shy "Davon abgesehen geh ich ehrlich gesagt nicht viel raus... Ich habe mit dem Laden alle Hände voll zu tun."

# game/script.rpy:543
translate ger start_d04e37c7:

    # w smile "So diligent 💙 Does that mean this is your first night out in a while?"
    w smile "So fleißig 💙 Heißt das, du gehst heute das erste Mal seit langem wieder abends aus?"

# game/script.rpy:544
translate ger start_03f245f3:

    # p oh "Ah... yeah, I guess it is."
    p oh "Ah... joa, ich glaube schon."

# game/script.rpy:545
translate ger start_97012fb5:

    # w innocent "I'm honored you were willing to share it with me, then~"
    w innocent "Dann fühle ich mich geehrt, dass du diesen Abend mit mir verbringst~"

# game/script.rpy:546
translate ger start_8c01ab99:

    # p shy "Yeah! I don't think I ever would've tried this place if you hadn't brought me in..."
    p shy "Ja! Ich denke nicht, dass ich dieses Lokal jemals ausprobiert hätte, wenn du mich nicht hierher gebracht hättest..."

# game/script.rpy:547
translate ger start_ddcf714a:

    # p ehe "So... it's been worth it so far. Thanks, Periwinkle."
    p ehe "Deshalb... ist es das bisher auch wert. Danke, Periwinkle."

# game/script.rpy:553
translate ger start_79c59f28:

    # "The table had long been cleared, and yet our conversation continued through the night."
    "Der Tisch war schon längst abgeräumt worden und trotzdem ging unser Gespräch noch die ganze Nacht."

# game/script.rpy:554
translate ger start_1efc9d29:

    # "This place is never too busy, which always leaves me free to linger here without the guilt of taking up any much-needed table space."
    "Hier ist nie zu viel los, also besteht keine Eile, den Platz zu räumen."

# game/script.rpy:555
translate ger start_b7237054:
    nvl clear
    # "The longer the date, the more satisfying the finale 💙 That's something I live by."
    "Je länger das Date, desto befriedigender das Finale 💙 Das ist etwas wonach ich lebe."

# game/script.rpy:556
translate ger start_6ec3835a:

    # "Rushing straight to the climax inevitably gets a bit dull after a while. I want to enjoy this night to its fullest 💙"
    "Direkt zum Höhepunkt zu eilen, führt unweigerlich dazu, dass es nach einer Weile langweilig wird. Ich möchte diesen Abend so gut wie möglich auskosten 💙"

# game/script.rpy:557
translate ger start_76b2fe88_6:

    # nvl clear
    nvl clear

# game/script.rpy:560
translate ger start_2ff85601:

    # w love "Hmhmhm... Pastille... do you see the witch at that table over there?"
    w love "Hmhmhm... Pastille... siehst du die Hexe an dem Tisch da drüben?"

# game/script.rpy:561
translate ger start_8185ca92:

    # p neutral "Hm...?"
    p neutral "Hm...?"

# game/script.rpy:563
translate ger start_9f7508ef:

    # w happy "Don't be too obvious, now. The one with the tall hat, you see...?"
    w happy "Nicht so auffällig! Der mit dem großen Hut, siehst du...?"

# game/script.rpy:564
translate ger start_69f4106c:

    # p uhoh "Ah... y-yeah, I see them."
    p uhoh "Ah... j-ja, ich sehe sie."

# game/script.rpy:565
translate ger start_e8772676:

    # w teehee "I brought them here about two weeks ago. I guess they agreed that it made a nice date spot!"
    w teehee "Ich habe sie vor zwei Wochen hergebracht. Ich nehme an, sie haben dem zugestimmt, dass das ein guter Ort für ein Date ist!"

# game/script.rpy:566
translate ger start_b7da8094:

    # p ehe2 "Hahaha... I, um... I actually..."
    p ehe2 "Hahaha... ich, ähm... Tatsächlich..."

# game/script.rpy:567
translate ger start_b052a575:

    # p uhoh "Th-the guy sitting across from them... I'm pretty sure I've been with him before."
    p uhoh "D-der Kerl, der ihnen gegenüber sitzt... Ich bin ziemlich sicher, dass ich mal was mit ihm hatte."

# game/script.rpy:569
translate ger start_9590f34f:

    # w my "NO... surely, you're joking, Pastille!"
    w my "NEIN... du machst sicher nur Witze, Pastille!"

# game/script.rpy:570
translate ger start_d1b5f16c:

    # p omgstop "SH-SHHHH!!! Don't say my name so loudly...!"
    p omgstop "Sch-schhhh!!! Sag meinen Namen nicht so laut...!"

# game/script.rpy:571
translate ger start_2eb04fd0:

    # w happy "Just keep your head low, I'm sure he won't notice."
    w happy "Halt einfach deinen Kopf unten. Ich bin sicher, er bemerkt dich nicht."

# game/script.rpy:572
translate ger start_ffe0c64f:

    # w oh "...Oh, he's just looked this way."
    w oh "...Oh, er hat eben in unsere Richtung geschaut."

# game/script.rpy:573
translate ger start_50c22d14:

    # p scream "AAAAAHH...!!!" with vpunch
    p scream "AAAAAHH...!!!" with vpunch

# game/script.rpy:574
translate ger start_f4ea47ed:

    # w teehee "Only kidding 💙"
    w teehee "Nur ein Spaß 💙"

# game/script.rpy:575
translate ger start_e2427086:

    # p flustered "P-Peri...!!"
    p flustered "P-Peri...!!"

# game/script.rpy:576
translate ger start_fc329306:

    # w shy "Ooh, a nickname already? We're moving so fast..."
    w shy "Ooh, schon einen Spitznamen? Wir gehen ja schnell voran..."

# game/script.rpy:577
translate ger start_212fa4c4:

    # p seriously "You're the one who's been calling me \"my sweet\" all night...!"
    p seriously "Du bist doch derjenige, der schon den ganzen Abend \"mein Süßer\" zu mir sagt...!"

# game/script.rpy:578
translate ger start_3e500425:

    # w oh "Well, you are, aren't you? Whose fault is it that you share a name with candy?"
    w oh "Nun, bist du doch, oder? Wessen Schuld ist es, dass du den gleichen Namen wie eine Süßigkeit hast?"

# game/script.rpy:579
translate ger start_54dcfd58:

    # p shout "Not mine!!"
    p shout "Nicht meine!!"

# game/script.rpy:580
translate ger start_bb5f7312:

    # w smile "Still. Do you think those two make a good couple?"
    w smile "Trotzdem. Denkst du, die beiden geben ein gutes Paar ab?"

# game/script.rpy:581
translate ger start_831b1ea7:

    # p flustered2 "How should I know...?!"
    p flustered2 "Woher soll ich das wissen...?!"

# game/script.rpy:582
translate ger start_b2b6228d:

    # w happy "Just imagine the kind of person I'd go on a date with, and pair them with the other!"
    w happy "Stell dir einfach die Art Person vor, mit der ich auf ein Date gehen würde und steck sie mit der anderen zusammen!"

# game/script.rpy:583
translate ger start_9fb1f04a:

    # p shy "And what kind of person is that...?"
    p shy "Und welche Art Person ist das...?"

# game/script.rpy:584
translate ger start_33e2c8d5:

    # w innocent "You, for one 💙"
    w innocent "Du zum Beispiel 💙"

# game/script.rpy:585
translate ger start_adb706d7:

    # p ehe "Pfft--maybe they wouldn't be so good together..."
    p ehe "Pfft--vermutlich würden sie nicht so gut zueinander passen..."

# game/script.rpy:586
translate ger start_43faf218:

    # w oh "My, am I supposed to take offense to that?"
    w oh "Meine Güte, sollte ich mich davon angegriffen fühlen?"

# game/script.rpy:587
translate ger start_881b271e:

    # p smile "Nah, that guy was just kinda pushy."
    p smile "Nee, der Typ war einfach nur irgendwie aufdringlich."

# game/script.rpy:588
translate ger start_bbb521cf:

    # w happy "Hmhm... ahaha, you're too much, Pastille!"
    w happy "Hmhm... ahaha, du bist mir einer, Pastille!"

# game/script.rpy:594
translate ger start_4554f13a:

    # "We eventually made our way out of the restaurant that night..."
    "Irgendwann am Abend sind wir doch mal aus dem Restaurant gegangen..."

# game/script.rpy:595
translate ger start_7211b97d:

    # "It had gotten quite late already. When's the last time I stayed until closing...?"
    "Es war schon ziemlich spät geworden. Wann bin ich das letzte Mal so lange geblieben?"

# game/script.rpy:596
translate ger start_bc63f4b9:

    # "There was never a moment of awkward silence between us. Only Pastille's embarrassed pauses--clear attempts to steer his mind away from debauchery 💙"
    "Es gab keinen einzigen Moment der peinlichen Stille bei uns. Nur Pastilles verlegene Pausen--klare Versuche, seinen Kopf der Verführung zu entziehen 💙"

# game/script.rpy:597
translate ger start_1f9c5254:

    # "As we wander back into the night air, he's the first to speak up again..."
    "Als wir wieder zurück an der Nachtluft waren, ist er derjenige, der zuerst spricht..."

# game/script.rpy:598
translate ger start_76b2fe88_7:

    # nvl clear
    nvl clear

# game/script.rpy:601
translate ger start_a046c557:

    # p "You could've at least let me cover the tip..."
    p "Du hättest mich wenigstens das Trinkgeld geben lassen können..."

# game/script.rpy:602
translate ger start_bbd42092:

    # w innocent "Nonsense. I'm the one who asked you out tonight, you don't have to cover a thing."
    w innocent "Unsinn. Ich bin derjenige, der dich heute ausgeführt hat, du musst keine Kosten tragen."

# game/script.rpy:603
translate ger start_ffe053ec:

    # p anxious "...."
    p anxious "...."

# game/script.rpy:604
translate ger start_14e8a9bb:

    # w teehee "In fact, I'd prefer if you DIDN'T cover--"
    w teehee "Eigentlich würde ich es bevorzugen, wenn du GAR NICHTS trag--"

# game/script.rpy:605
translate ger start_d7542b15:

    # p omg "Okay, I saw that one coming this time! Y-you don't have to say it..." with vpunch
    p omg "Okay, den hab ich diesmal kommen sehen! D-du musst es nicht aussprechen..." with vpunch

# game/script.rpy:606
translate ger start_ddc15564:

    # w happy "Too easy, hm? Ahaha~"
    w happy "Zu leicht, hm? Ahaha~"

# game/script.rpy:607
translate ger start_b2f2809d:

    # w smile "But really, it's a shame to hide such a cute outfit from the world 💙"
    w smile "Aber echt mal, es ist doch schade, dieses süße Outfit der Welt zu enthalten 💙"

# game/script.rpy:608
translate ger start_71e4cdd4:

    # p ehe "I-I don't have the confidence..."
    p ehe "I-ich hab nicht das nötige Selbstbewusstsein..."

# game/script.rpy:609
translate ger start_00c0a8d9:

    # w shy "Ahh. Reminds me of my youth..."
    w shy "Aah. Erinnert mich an meine Jungend..."

# game/script.rpy:610
translate ger start_151a84c5:

    # w smile "You'll get there, my sweet. One day, you'll be able to toss aside any feelings of inadequacy, and wear all sorts of daring outfits with pride!"
    w smile "Da kommst du noch hin, mein Süßer."
    w "{size=-2}Eines Tages wirst du in der Lage sein, jegliches Gefühl, unpassend zu sein, abzulegen und alle möglichen gewagten Outfits mit Stolz zu tragen!"

# game/script.rpy:611
translate ger start_e98f9e49:

    # p neutral "N-no, it's not a matter of self esteem or anything. It's just..."
    p neutral "N-nein, es hat nichts mit Selbstwert zu tun oder so. Es ist nur..."

# game/script.rpy:612
translate ger start_e62d49d4:

    # p embarrassed "If anyone I knew saw me in this, I would die."
    p embarrassed "Wenn mich jemand, den ich kenne, darin sehen würde, würde ich sterben."

# game/script.rpy:615
translate ger start_c0d59d1c:

    # "So that's how it is, hm~?"
    "So ist das also, hm~?"

# game/script.rpy:616
translate ger start_7db31c84:

    # "I'm being treated to a more intimate side of this witch boy right now 💙"
    "Ich werde gerade mit einer intimeren Seite dieses Hexenjungen belohnt 💙"

# game/script.rpy:617
translate ger start_ca35036d:

    # "We walk together under the street lights, until we reach our original meeting place..."
    "Wir laufen gemeinsam unter den Straßenlaternen, bis wir unseren ursprünglichen Treffpunkt erreichen..."

# game/script.rpy:618
translate ger start_76b2fe88_8:

    # nvl clear
    nvl clear

# game/script.rpy:622
translate ger start_ae339b7f:

    # w oh "Would you like me to escort you home?"
    w oh "Soll ich dich noch nach Hause begleiten?"

# game/script.rpy:623
translate ger start_0cb1f383:

    # p wha "N-no, that's okay..."
    p wha "N-nein, ist schon okay..."

# game/script.rpy:624
translate ger start_56666e95:

    # w smile "Then, if you don't mind... my place is just down the street."
    w smile "Dann, wenn's dir nichts ausmacht... mein Haus ist gleich da die Straße runter."

# game/script.rpy:625
translate ger start_f4615b4a:

    # w innocent "Perhaps you'd like to accompany me?"
    w innocent "Vielleicht magst du mich ja begleiten?"

# game/script.rpy:626
translate ger start_21bf7ae8:

    # p embarrassed "Yes--I mean... I wouldn't want you to have to walk alone in the dark."
    p embarrassed "Ja--ich meine... Ich würde nicht wollen, dass du alleine im Dunkeln laufen musst."

# game/script.rpy:627
translate ger start_de097d15:

    # w calm "Such a gentleman 💙"
    w calm "Was für ein Gentleman 💙"

# game/script.rpy:632
translate ger start_d36a9b3e:

    # n "Periwinkle expertly slides his hand up and under Pastille's mantle, linking arms as they go along."
    n "Periwinkle schiebt seine Hand gekonnt unter Pastilles Umhang und hakt sich bei ihm ein, während sie laufen."

# game/script.rpy:633
translate ger start_1353eaa8:

    # n "They walk in comfortable silence, toward Periwinkle's house..."
    n "Sie laufen in einer angenehmen Ruhe auf Periwinkles Haus zu..."

# game/script.rpy:639
translate ger start_94642492:

    # w calm "Well, this is me..."
    w calm "Also, da sind wir..."

# game/script.rpy:640
translate ger start_78aeb21b:

    # w innocent "I had a most lovely evening. Thank you for accompanying me to dinner tonight 💙"
    w innocent "Ich hatte einen absolut schönen Abend. Danke, dass du mich zum Abendessen begleitet hast 💙"

# game/script.rpy:641
translate ger start_59d5d240:

    # p wha "I-I had fun, too... thanks for inviting me out."
    p wha "I-ich hatte auch Spaß... danke für die Einladung."

# game/script.rpy:643
translate ger start_5e0cd997:

    # n "Pastille fidgets as if he has something to ask, but can't find the words."
    n "Pastille zappelt herum, als würde er etwas fragen wollen, findet aber nicht die richtigen Worte."

# game/script.rpy:645
translate ger start_915dfd7a:

    # w smile "Pastille."
    w smile "Pastille."

# game/script.rpy:647
translate ger start_c33092e1:

    # n "Periwinkle takes a step closer."
    n "Periwinkle kommt einen Schritt näher."

# game/script.rpy:649
translate ger start_b2502cf7:

    # p "Y-yes...?"
    p "J-ja...?"

# game/script.rpy:654
translate ger start_6f64de6b:

    # n "He leans in, pausing for any sort of reaction..."
    n "Er lehnt sich nach vorne und hält inne, um auf irgendeine Reaktion zu warten..."

# game/script.rpy:656
translate ger start_d62e590f:

    # n "...only for Pastille's lips to come clumsily crashing forward."
    n "...welche die ist, dass Pastilles Lippen ihm ungeschickt entgegen schnellen."

# game/script.rpy:659
translate ger start_5d610763:

    # w drool "(He's in more of a rush than I thought...!)"
    w drool "(Er ist forscher, als ich dachte...!)"

# game/script.rpy:660
translate ger start_f378704d:

    # w shy "(Then again, I DID spend all night winding him up....)"
    w shy "(Dann wiederum hab ICH ihn ja den ganzen Abend über angestichelt....)"

# game/script.rpy:663
translate ger start_d5c67421:

    # p "...."
    p "...."

# game/script.rpy:664
translate ger start_446d0040:

    # w love "(So cute...! 💙)"
    w love "(So süß...! 💙)"

# game/script.rpy:665
translate ger start_79e2b8c5:

    # w oh "Ah, Pastille... I just remembered."
    w oh "Ah, Pastille... Mir ist gerade was eingefallen."

# game/script.rpy:666
translate ger start_ba66744e:

    # w innocent "Since we're here... would you like to come in and sample some of my magic?"
    w innocent "Wenn wir schon hier sind... magst du mit rein und meine Magie ausprobieren?"

# game/script.rpy:667
translate ger start_c82fd8a6:

    # p kyaa "I-I'd like that, yes...!"
    p kyaa "S-sehr gerne, ja...!"

# game/script.rpy:668
translate ger start_3cf70de4:

    # w calm "Very well, then 💙"
    w calm "Dann also los 💙"

# game/script.rpy:671
translate ger start_38a91372:

    # "We both knew from the beginning that he would be staying the night, of course."
    "Natürlich wussten wir beide von Anfang an, dass er die Nacht bei mir verbringen würde."

# game/script.rpy:672
translate ger start_073ddabd:

    # "It's just so much more fun drawing it out like this... 💙"
    "Es macht nur so viel mehr Spaß, das so in die Länge zu ziehen... 💙"

# game/script.rpy:673
translate ger start_90128a54:

    # "Ah, but if that kiss is any indication of things to come... I may have gone a little overboard tonight."
    "Ah, aber wenn der Kuss ein Hinweis darauf ist, was noch kommt... könnte ich heute Abend wohl etwas übertrieben haben."

# game/script.rpy:674
translate ger start_3dc4f1af:

    # "If so... we're in for quite a sleepover 💙"
    "Wenn es so ist... dann wird das eine heftige Übernachtung 💙"

# game/script.rpy:675
translate ger start_76b2fe88_9:

    # nvl clear
    nvl clear

# game/script.rpy:681
translate ger start_889df456:

    # w calm "Sorry about the mess. I just haven't found the time to tidy up~"
    w calm "Entschuldige die Unordnung. Ich hatte noch nicht die Zeit gefunden, aufzuräumen~"

# game/script.rpy:682
translate ger start_ef3726ee:

    # w oh "{nw}"
    w oh "{nw}"

# game/script.rpy:684
translate ger start_91d784bf:

    # n "The door closes loudly behind them. When Pastille doesn't respond, Periwinkle turns back to face him..."
    n "Die Tür fällt hinter ihnen laut ins Schloss. Als Pastille nicht antwortet, dreht sich Periwinkle zu ihm um..."

# game/script.rpy:690
translate ger start_00b95dae:

    # n "Pastille's back is against the door as he fumbles to untie his mantle."
    n "Pastille lehnt sich an die Tür und fummelt am Verschluss seines Mantels herum."

# game/script.rpy:694
translate ger start_09ae6c7c:

    # w drool "(He's completely run out of patience, hasn't he...!)"
    w drool "(Er hat wirklich gar keine Geduld mehr, oder...!)"

# game/script.rpy:695
translate ger start_9c346134:

    # w shy "(Then I'm afraid I simply have no choice but to indulge him~)"
    w shy "(Dann, fürchte ich, hab ich wohl keine andere Wahl als ihm nachzugeben~)"

# game/script.rpy:700
translate ger start_033d605a:

    # w "Hmhm, I shouldn't keep you waiting a second longer, now should I?"
    w "Hmhm, ich sollte dich wohl keine Sekunde länger warten lassen, hm?"

# game/script.rpy:701
translate ger start_4a130bfc:

    # p "M-mn...!"
    p "M-mn...!"

# game/script.rpy:703
translate ger start_90ffdfad:

    # w "Ah, but I still need to change into something a little easier to take off..."
    w "Ah, aber ich muss noch in etwas schlüpfen, das leichter auszuziehen geht..."

# game/script.rpy:704
translate ger start_6e757cc4:

    # w "Looking this good comes at a price, you see. I promise I won't keep you waiting."
    w "So gut auszusehen hat seinen Preis, weißt du. Ich versprech, ich lass dich nicht länger warten."

# game/script.rpy:705
translate ger start_827e34fc:

    # p "O-okay..."
    p "O-okay..."

# game/script.rpy:708
translate ger start_66ce2a36:

    # n "Periwinkle gives him another peck on the lips, and leads him through the cluttered living room to his bedroom door..."
    n "Periwinkle gibt ihm noch einen schnellen Kuss und führt ihn durch sein unaufgeräumtes Wohnzimmer zum Schlafzimmer..."

# game/script.rpy:721
translate ger ch2_7b49a2da:

    # centered "{w=3}{nw}"
    centered "{w=3}{nw}"

# game/script.rpy:727
translate ger ch2_420c2aa2:

    # "It took me ages to get out of bed that morning."
    "Es hat Ewigkeiten gedauert, aus dem Bett zu kommen."

# game/script.rpy:728
translate ger ch2_d9e096c6:

    # "After all... I just couldn't stop thinking about how absolutely adorable Pastille was! 💙"
    "Immerhin... konnte ich einfach nicht aufhören, daran zu denken, wie absolut hinreißend Pastille war! 💙"

# game/script.rpy:729
translate ger ch2_7c711ce7:

    # "He scrambled out of here almost as soon as he woke up, saying he couldn't be late for work..."
    "Er machte sich fast sofort nach dem Aufwachen aus dem Staub, um nicht zu spät zur Arbeit kommen..."
    nvl clear

# game/script.rpy:730
translate ger ch2_e5f82cff:

    # "Such a shame. Would've been nice to get one last round in~"
    "Sehr schade. Wäre schön gewesen, noch eine Ehrenrunde zu drehen~"

# game/script.rpy:731
translate ger ch2_a69cdafc:

    # "...I did get a kiss goodbye, though 💙"
    "...Ich hab immerhin einen Abschiedskuss bekommen 💙"

# game/script.rpy:732
translate ger ch2_79c07e86:

    # nvl clear
    # w bed shy "Ahh, it's nice to feel like a housewife for a moment~"
    nvl clear
    w bed shy "Aah, es ist schön, sich für einen Moment wie eine Hausfrau zu fühlen~"

# game/script.rpy:734
translate ger ch2_369e7bdd:

    # w smile "But I should get to work, too..."
    w smile "Aber ich sollte ebenfalls an die Arbeit..."

# game/script.rpy:735
translate ger ch2_a95a50d1:

    # w happy "I have an order to fill, don't I~?"
    w happy "Ich habe noch eine Bestellung abzufüllen, oder~?"

# game/script.rpy:738
translate ger ch2_3c76f5d0:

    # n "Periwinkle finally rolls out of bed and gets ready for the day..."
    n "Endlich rollt sich Periwinkle aus dem Bett und bereitet sich auf den Tag vor..."

# game/script.rpy:741
translate ger ch2_5a13e7e9:

    # "The order in question is for a nearby apothecary."
    "Die betreffende Bestellung ist für eine nahegelegene Apotheke."

# game/script.rpy:742
translate ger ch2_35f25f34:

    # "Did you know? Aromagic like mine is actually quite good for you~"
    "Wusstest du das? Aromagie wie meine ist tatsächlich echt gut für dich~"

# game/script.rpy:743
translate ger ch2_8f79525a:

    # "It's got nothing on actual healing magic, but the calming atmosphere it creates does wonders for one's mood."
    "Es kann nicht mit richtiger Heilmagie mithalten, aber die beruhigende Atmosphäre, die sie erzeugt, wirkt Wunder für die Stimmung."

# game/script.rpy:744
translate ger ch2_48c6a187:

    # nvl clear
    # "This particular batch is meant to help with insomnia..."
    nvl clear
    "Diese Ladung ist dafür gedacht, bei Schlaflosigkeit zu helfen..."

# game/script.rpy:746
translate ger ch2_9bdec3ec:

    # "Which is ironic, considering how late I stayed up with Pastille 💙"
    "Was ironisch ist, wenn man bedenkt, wie lange Pastille und ich letzte Nacht wach waren 💙"

# game/script.rpy:747
translate ger ch2_e22fb32a:

    # nvl clear
    # w pj teehee "Whoops, can't be getting distracted now~ I really need to finish up these last few bottles..."
    nvl clear
    w pj teehee "Upps, jetzt nicht ablenken lassen~ Ich muss diese letzten paar Flaschen wirklich fertig kriegen..."

# game/script.rpy:750
translate ger ch2_e708ef33:

    # w calm "{nw}"
    w calm "{nw}"

# game/script.rpy:751
translate ger ch2_2dd620a3:

    # n "Periwinkle closes his eyes and draws his wand."
    n "Periwinkle schließt seine Augen und zieht seinen Zauberstab."

# game/script.rpy:753
translate ger ch2_3425d8a6:

    # n "Large drops form at its tip, falling into the empty bottle one by one."
    n "Große Tropfen bilden sich an der Spitze und fallen dann einer nach dem anderen in die leere Flasche."

# game/script.rpy:754
translate ger ch2_3222c5b9:

    # n "With each drip, the bottle's contents swell, and after only the fifth drop, it's completely filled."
    n "Mit jedem Tropfen schwillt der Inhalt an und nach nur dem fünften Tropfen war die Flasche gefüllt."

# game/script.rpy:757
translate ger ch2_fbaed311:

    # w innocent "Perfect! Ahh, it's so much easier to finish these with a clear mind..."
    w innocent "Perfekt! Aah, es ist so viel einfacher, das mit einem klaren Kopf fertig zu machen..."

# game/script.rpy:758
translate ger ch2_6e325112:

    # w shy "I can't help it if a refreshing night out is the only way to regain my focus 💙"
    w shy "Ich kann nichts dafür, dass ein erfrischender Abend auswärts der einzige Weg ist, meinen Fokus wiederherzustellen 💙"

# game/script.rpy:759
translate ger ch2_afd133a7:

    # w teehee "Although~ I probably could've gotten one of these done last night if Pastille hadn't been so impatient... 💙"
    w teehee "{size=-2}Obwohl~ Ich hätte wahrscheinlich einen davon letzte Nacht noch machen können, wenn Pastille nicht so ungeduldig gewesen wäre... 💙"

# game/script.rpy:760
translate ger ch2_44174832:

    # w calm "No, no, mustn't let my mind wander too far from work now."
    w calm "Nein, nein, ich darf meine Gedanken nicht zu sehr abschweifen lassen."

# game/script.rpy:762
translate ger ch2_67507517:

    # n "Periwinkle fills the remaining bottles, screwing the lids on as he goes."
    n "Periwinkle füllt die übrigen Flaschen und schraubt die Deckel drauf."

# game/script.rpy:764
translate ger ch2_5bd5f285:

    # w smile "There. Hmhm, now my house is going to smell like lavender..."
    w smile "So. Hmhm, jetzt wird mein Haus nach Lavendel riechen..."

# game/script.rpy:765
translate ger ch2_8bdf90ac:

    # w innocent "I'd better head out before I'm lulled to sleep by my own magic~"
    w innocent "Ich sollte besser los, bevor ich von meiner eigenen Magie in den Schlaf gelullt werde~"

# game/script.rpy:779
translate ger ch2_85bf7599:

    # "The apothecary is only a short walk away, but I've never managed to walk in its doors on time."
    "Die Apotheke ist nur einen kleinen Spaziergang entfernt, aber ich habe es nie geschafft, pünktlich dort zu sein."

# game/script.rpy:780
translate ger ch2_bd4b3ec4:

    # "Perhaps because it's so close, I always underestimate the time it takes to reach it..."
    "Vielleicht unterschätze ich die Zeit, die man dorthin braucht, eben weil es so nahe ist..."

# game/script.rpy:781
translate ger ch2_3b3d6df9:

    # "I can hear the owner tapping her foot with impatience as soon as I open the door."
    "Sobald ich die Tür öffne, kann ich hören, wie die Inhaberin ungeduldig mit dem Fuß tippt."

# game/script.rpy:782
translate ger ch2_76b2fe88:

    # nvl clear
    nvl clear

# game/script.rpy:785
translate ger ch2_a74c124f:

    # w happy "Astragalus~! I have that special order ready for you~"
    w happy "Astragalus~! Ich habe die Spezialbestellung für dich fertig~"

# game/script.rpy:786
translate ger ch2_318b7805:

    # a annoyed "You're late again, Periwinkle."
    a annoyed "Du bist wieder zu spät, Periwinkle."

# game/script.rpy:787
translate ger ch2_1019ebc0:

    # w innocent "Lost track of time 💙 You'll forgive me, won't you~?"
    w innocent "Hab die Zeit vergessen 💙 Du wirst mir vergeben, nicht~?"

# game/script.rpy:788
translate ger ch2_7862874c:

    # a "You are literally my only provider who has no respect for appointments."
    a "Du bist wirklich mein einziger Zulieferer, der keinen Respekt vor Terminen hat."

# game/script.rpy:789
translate ger ch2_2fb8a6f9:

    # w oh "That's simply not true! I never miss a date."
    w oh "Das ist einfach nicht wahr! Ich verpasse nie ein Treffen."

# game/script.rpy:790
translate ger ch2_acda7219:

    # a lol "There's the problem. You were out getting laid again, weren't you?"
    a lol "Da liegt das Problem. Du warst wieder unterwegs, um flachgelegt zu werden, oder?"

# game/script.rpy:791
translate ger ch2_dbeacd97:

    # w pout "How vulgar~ I had a romantic evening with a VERY cute boy..."
    w pout "Wie vulgär~ Ich hatte einen romantischen Abend mit einem SEHR süßen Jungen..."

# game/script.rpy:792
translate ger ch2_d7ebcbc7:

    # w innocent "Who then ended up sleeping over 💙"
    w innocent "Der dann halt bei mir übernachtet hat 💙"

# game/script.rpy:793
translate ger ch2_facdd2e0:

    # a whatever "Well, you had all week to fill the order. Try getting it done in advance next time."
    a whatever "Nun, du hattest die ganze Woche, die Bestellung abzufüllen. Versuch es beim nächsten Mal doch im Voraus zu machen."

# game/script.rpy:794
translate ger ch2_8de08278:

    # w calm "Yes, ma'am~"
    w calm "Jawohl~"

# game/script.rpy:795
translate ger ch2_e220bd55:

    # a closed "Now let's see what you brought..."
    a closed "Dann lass mal sehen, was du gebracht hast..."

# game/script.rpy:797
translate ger ch2_6aa2ff6b:

    # "I've worked with Astragalus for a few years now."
    "Ich arbeite jetzt schon seit ein paar Jahren mit Astragalus."

# game/script.rpy:798
translate ger ch2_88aee593:

    # "She's COMPLETLY immune to my charms. Shocking, to say the least."
    "Sie ist KOMPLETT immun gegen meinen Charme. Schockierend, mild ausgedrückt."

# game/script.rpy:799
translate ger ch2_f1139fde:

    # "But it's meant we've been able to remain good friends all this time~"
    "Aber es heißt, dass wir über all diese Zeit gute Freunde bleiben konnten~"

# game/script.rpy:800
translate ger ch2_4fc199f3:

    # "Or... hm. Let's see..."
    "Oder... hm. Mal sehen..."

# game/script.rpy:801
translate ger ch2_76b2fe88_1:

    # nvl clear
    nvl clear

# game/script.rpy:804
translate ger ch2_2c3696be:

    # w oh "Astragalus. Would you consider us to be good friends?"
    w oh "Astragalus. Würdest du uns als gute Freunde bezeichnen?"

# game/script.rpy:805
translate ger ch2_c86bbb5c:

    # a whatever "I put up with you."
    a whatever "Ich finde mich mit dir ab."

# game/script.rpy:806
translate ger ch2_373f7314:

    # w happy "My, but you don't put up with ANYONE! You must really like me 💙"
    w happy "Meine Güte, aber du findest dich mit NIEMANDEM ab! Du musst mich sehr mögen 💙"

# game/script.rpy:807
translate ger ch2_47067d4c:

    # a lol "You got a favor to ask or something? Is that what you're getting at?"
    a lol "Willst du mich um 'nen Gefallen bitten oder so? Bist du darauf aus?"

# game/script.rpy:808
translate ger ch2_df3d1bd8:

    # w calm "No, I was just thinking of how to categorize our relationship."
    w calm "Nein, ich hab nur drüber nachgedacht, wie man unsere Freundschaft einstufen kann."

# game/script.rpy:809
translate ger ch2_72e2a8ac:

    # a "\"Business associate\" works just fine, doesn't it?"
    a "\"Geschäftspartner\" passt doch, oder?"

# game/script.rpy:810
translate ger ch2_5f78763b:

    # w happy "Come now, surely you consider us to be closer than that!"
    w happy "Komm schon, sicherlich stehen wir uns näher als das!"

# game/script.rpy:811
translate ger ch2_ce50824a:

    # a sure "I know better than to get involved with you, Periwinkle."
    a sure "Ich hüte mich, mehr mit dir zu tun zu haben, Periwinkle."

# game/script.rpy:812
translate ger ch2_17ce8a61:

    # w my "Why, whatever do you mean?"
    w my "Warum, was meinst du denn nur?"

# game/script.rpy:813
translate ger ch2_0ac87123:

    # a whatever "You're too dazzling."
    a whatever "Du bist zu grell."

# game/script.rpy:814
translate ger ch2_4a6eea27:

    # w innocent "I take that as a compliment~"
    w innocent "Das nehme ich als Kompliment~"

# game/script.rpy:815
translate ger ch2_d60255a0:

    # a annoyed "Great, now will you stop distracting me? I'm trying to count."
    a annoyed "Großartig, wirst du dann aufhören, mich abzulenken? Ich versuche zu zählen."

# game/script.rpy:817
translate ger ch2_8c4a5641:

    # "Yes, we're definitely good friends."
    "Ja, wir waren definitiv gute Freunde."

# game/script.rpy:818
translate ger ch2_9ecc4a32:

    # "\"Too dazzling\" though... I'm not sure there IS such a thing."
    "Aber \"zu grell\"... Ich bin mir nicht sicher, ob DAS überhaupt geht."

# game/script.rpy:819
translate ger ch2_82c90c4f:

    # "And what would be wrong with it if there was? What point is there in not shining as brightly as one can?"
    "Und was wäre falsch daran, wenn es so wäre? Was hat man davon, nicht so hell wie nur möglich zu scheinen?"

# game/script.rpy:820
translate ger ch2_d0dcce99:

    # "Astragalus finishes counting the bottles, sighing in feigned exasperation as she marks them off her checklist..."
    "Astragalus hat die Flaschen fertig gezählt und seufzt in vorgetäuschter Verzweiflung, als sie sie auf der Checkliste abhakt..."

# game/script.rpy:821
translate ger ch2_529b0ff5:

    # nvl clear
    # a sure "You may always be late... but you deliver quality every time. You're consistent, if nothing else."
    nvl clear
    a sure "Du magst jedes Mal zu spät sein... aber du lieferst immer Qualität. Wenn du was bist, dann beständig."

# game/script.rpy:824
translate ger ch2_389bf1e7:

    # w teehee "The waiting is part of the fun. It builds excitement, wouldn't you say?"
    w teehee "Das Warten ist der spaßige Teil. Es baut Freude auf, meinst du nicht auch?"

# game/script.rpy:825
translate ger ch2_2f490664:

    # a whatever "Nope, just builds frustration for me. But at least you always come through."
    a whatever "Nö, baut bei mir nur Frust auf. Aber immerhin kommst du an."

# game/script.rpy:827
translate ger ch2_4251ed12:

    # n "She unlocks a small drawer behind the counter, and takes out an envelope with Periwinkle's name scribbled on it."
    n "Sie schließt eine kleine Schublade unter dem Tresen auf und holt einen Umschlag mit Periwinkles Namen darauf hervor."

# game/script.rpy:829
translate ger ch2_9104554e:

    # a closed "Here's the rest of your payment. Don't spend it all in one place."
    a closed "Hier ist die restliche Bezahlung. Gib nicht alles auf einmal aus."

# game/script.rpy:830
translate ger ch2_338d50e7:

    # w calm "Oh, I couldn't if I tried! Really, you're too generous..."
    w calm "Oh, das würde ich niemals schaffen. Wirklich, du bist zu großzügig..."

# game/script.rpy:833
translate ger ch2_8daa5982:

    # n "Astragalus rolls her eyes and begins stocking the shelves with her new inventory."
    n "Astragalus rollt mit ihren Augen und fängt an, die Regale mit der neuen Ware zu füllen."

# game/script.rpy:835
translate ger ch2_ffbdbe6c:

    # "Two or three orders a month... that's all it takes to support myself, entirely through this apothecary."
    "Zwei oder drei Bestellungen pro Monat... mehr braucht es nicht, um mich zu versorgen. Und alles nur über diese Apotheke."

# game/script.rpy:836
translate ger ch2_ba2406db:

    # "Hard to believe my magic is really worth so much, but who am I to complain?"
    "Schwer zu glauben, dass meine Magie wirklich so viel wert ist, aber ich werd' mich nicht beschweren."

# game/script.rpy:837
translate ger ch2_acb5044d:

    # "It's certainly a more favorable balance compared to the kind of work I was doing years ago."
    "Es ist im Vergleich zu dem, was ich noch vor ein paar Jahren gemacht habe, definitiv ein besseres Geschäft für mich."

# game/script.rpy:838
translate ger ch2_7acd925f:

    # nvl clear
    # "And I do enjoy the freedom, the excessive amounts of time I have for partying, for dates..."
    nvl clear
    "Und ich genieße die Freiheit, die außerordentliche Menge an Zeit, die ich fürs Ausgehen und für Dates habe..."

# game/script.rpy:840
translate ger ch2_a2058868:

    # "Ah, on that note~"
    "Ah, wo wir gerade davon reden~"

# game/script.rpy:841
translate ger ch2_0b1b7e93:

    # nvl clear
    # w happy "With all that business out of the way... would you like to hear about my date? 💙"
    nvl clear
    w happy "Nachdem das Geschäftliche nun aus dem Weg ist... möchtest du gerne wissen, wie mein Date war?"

# game/script.rpy:844
translate ger ch2_fa857f5d:

    # a sure "Would I LIKE to? Not necessarily."
    a sure "Ob ich das GERNE würde? Nicht unbedingt."

# game/script.rpy:845
translate ger ch2_95d8347d:

    # w teehee "Please, Astragalus, as someone with no romance in your OWN life, the least you can do is live vicariously through me~"
    w teehee "Bitte, Astragalus, als jemand ganz ohne Romantik in ihrem EIGENEN Leben, kannst du diese indirekt durch mich erleben~"

# game/script.rpy:846
translate ger ch2_8be11c8d:

    # a whatever "The no romance thing is by choice. I listen to you gush for your own damn sake."
    a whatever "Ich habe mich dafür entschieden. Ich höre mir deine Ergüsse nur dir zuliebe an."

# game/script.rpy:847
translate ger ch2_66b3a391:

    # w my "For MY sake?"
    w my "MIR zuliebe?"

# game/script.rpy:848
translate ger ch2_e2b9789b:

    # a sure "Yeah, I'm afraid you might actually implode if you had no one to talk to about this stuff."
    a sure "Jepp, ich fürchte, du könntest tatsächlich implodieren, wenn du niemanden hättest, mit dem du über so ein Zeug reden könntest."

# game/script.rpy:849
translate ger ch2_fdfc2ccd:

    # a lol "I'm actually making a noble sacrifice every day that you come in here with new tales of romantic conquest."
    a lol "Es ist meinerseits jedes Mal eine noble Aufopferung, deinen neuen Geschichten der romantischen Eroberung zu lauschen."

# game/script.rpy:850
translate ger ch2_b3b6ebb7:

    # w pout "Hmph. If you're truly suffering, I shall desist..."
    w pout "Hmpf! Wenn du wirklich so leidest, dann unterlass' ich es..."

# game/script.rpy:851
translate ger ch2_115b6d90:

    # a smile "That's the thing, though... I DO like seeing you all worked up over something, even if I don't understand it myself."
    a smile "Das ist halt das Ding... Ich MAG es, dich total über etwas aufgeregt zu sehen, auch wenn ich es selbst nicht verstehe."

# game/script.rpy:852
translate ger ch2_dfd74c02:

    # w happy "Ahh, so there IS a mutual benefit! You'll listen, then? 💙"
    w happy "Aah, dann GIBT es einen beidseitigen Nutzen! Du hörst mir also zu? 💙"

# game/script.rpy:853
translate ger ch2_e4b44b62:

    # a sure "Yeah, at least until I get all this put away. After that, I'm kicking you out for the day."
    a sure "Jepp, zumindest bis ich all das verstaut habe. Danach schmeiß ich dich für heute raus."

# game/script.rpy:855
translate ger ch2_aa202e59:

    # w calm "Fair enough. I'd better be brief, then..."
    w calm "Meinetwegen. Dann halte ich mich besser kurz..."

# game/script.rpy:857
translate ger ch2_c163a19e:

    # w teehee "He's the absolute cutest thing! I picked him up at a candy shop yesterday 💙"
    w teehee "Er ist der Allersüßeste! Ich hab ihn gestern in einem Süßwarenladen abgeschleppt 💙"

# game/script.rpy:858
translate ger ch2_7ea91466:

    # w happy "Fluffy pink hair, with golden eyes, naturally rosy cheeks that make him look as if he's always a little embarrassed by something..."
    w happy "{size=-2}Fluffiges, pinkes Haar und goldene Augen, natürlich rosige Wangen, die ihn aussehen lassen, als wäre er permanent durch irgendwas peinlich berührt..."

# game/script.rpy:859
translate ger ch2_78bc035b:

    # w shy "He's shy, but not the type that becomes paralyzed in the bedroom--"
    w shy "Er ist so schüchtern, aber nicht der Typ, der in Schockstarre verfällt, wenn wir im Schlafzimmer--"

# game/script.rpy:860
translate ger ch2_e6e9e69b:

    # a augh "Periwinkle, for the last time, I do NOT need to hear about bedroom stuff." with vpunch
    a augh "Periwinkle, zum letzten Mal, ich brauch NICHTS über deine Bettgeschichten hören." with vpunch

# game/script.rpy:861
translate ger ch2_91bce83e:

    # w my "I wasn't giving any details!"
    w my "Ich bin doch gar nicht ins Detail gegangen!"

# game/script.rpy:862
translate ger ch2_f28bb905:

    # w shy "Although, the details ARE the best part 💙"
    w shy "Obwohl.. die Details SIND dabei der beste Part 💙"

# game/script.rpy:863
translate ger ch2_6f8d4d69:

    # a annoyed "This is a \"safe for work\" zone only. Break that rule, and you're outta here."
    a annoyed "Das hier ist ausdrücklich ein Bereich für \"am Arbeitsplatz Angemessenes\". Brich diese Regel und du fliegst raus."

# game/script.rpy:864
translate ger ch2_91ce2d8b:

    # w innocent "My apologies~ I'll refrain."
    w innocent "Entschuldige~ Ich halte mich zurück."

# game/script.rpy:865
translate ger ch2_dc5be651:

    # w love "Anyway, my point is... he's EXTREMELY cute. Adorable, in fact!"
    w love "Jedenfalls will ich darauf hinaus... dass er EXTREM süß ist. Hinreißend sogar!"

# game/script.rpy:866
translate ger ch2_d8b497e3:

    # a eyeroll "Right, so, standard fare for you."
    a eyeroll "'kay, bisher also das Übliche für deine Verhältnisse."

# game/script.rpy:867
translate ger ch2_fc605430:

    # w my "Absolutely not! If he was just your average cutie, would I be emphasizing his cuteness so much?"
    w my "Überhaupt nicht! Wäre er bloß ein Standardsüßi, würde ich dann so sehr betonen, wie süß er ist?"

# game/script.rpy:868
translate ger ch2_a47387c2:

    # a sure "I don't meet these people, so it's all the same to me."
    a sure "Ich treffe diese Leute nicht, also sind alle gleich für mich."

# game/script.rpy:869
translate ger ch2_afb4034f:

    # w oh "How can it be~? The intensity is so drastically different... perhaps SO intense that I'm having trouble explaining it properly."
    w oh "Wie kann das sein~? Die Intensität ist so dermaßen anders..."
    w "Vielleicht SO intensiv, dass ich Probleme habe, es vernünftig zu beschreiben."

# game/script.rpy:870
translate ger ch2_3da682aa:

    # a closed "I'll say. All you've really told me so far is that he's cute and shy."
    a closed "So ist es. Bisher hast du mir lediglich gesagt, dass er süß und schüchtern ist."

# game/script.rpy:871
translate ger ch2_8e3642e4:

    # w shy "He's kind, as well! He saved the best part of our dessert for me without even asking!"
    w shy "Er ist auch höflich! Er hat mir einfach so die besten Teile des Desserts überlassen!"

# game/script.rpy:872
translate ger ch2_dfa9b85a:

    # a lol "Wow, I would've led with that one."
    a lol "Wow, ich hätte damit angefangen."

# game/script.rpy:873
translate ger ch2_fdbe174a:

    # w pout "Ohh, enough of your sarcasm. When all my favorite details are off-limits, what do you suppose I'm LEFT with?"
    w pout "Ooh, genug von deinem Sarkasmus. Wenn meine liebsten Details die Grenze überschreiten, was bleibt SONST zu erzählen?"

# game/script.rpy:874
translate ger ch2_ab7c305b:

    # a happy "Well, what really matters is that you had a good night. Even if it meant you couldn't get here on time like I asked."
    a happy "Nun, was wirklich zählt ist doch, dass du einen schönen Abend hattest."
    a "Auch wenn es bedeutet, dass du nicht rechtzeitig hier sein konntest."

# game/script.rpy:875
translate ger ch2_f5e62b00:

    # w love "Ahh~ I'm already hoping to see him again, to be honest..."
    w love "Aah~ Ich hoffe ehrlich gesagt jetzt schon, dass ich ihn wiedersehen werde..."

# game/script.rpy:876
translate ger ch2_0979287d:

    # a hm "Oh yeah? Don't hear that from you very often."
    a hm "Ach ja? Das hör ich nicht oft von dir."

# game/script.rpy:877
translate ger ch2_83be95f7:

    # w oh "Really? But I've gone on second dates all the time."
    w oh "Wirklich? Aber ich geh doch ständig auf zweite Dates."

# game/script.rpy:878
translate ger ch2_95f62998:

    # a lol2 "This guy got a name?"
    a lol2 "Hat der Typ 'nen Namen?"

# game/script.rpy:879
translate ger ch2_899be6dd:

    # w shy "Hmhm, I don't kiss and tell 💙"
    w shy "Mhm, ich verrate meine Bettgeschichten nicht 💙"

# game/script.rpy:880
translate ger ch2_7b70ce89:

    # a sure "No, actually, you tell me about everyone you kiss."
    a sure "Also eigentlich erzählst du mir von jedem, den du auch nur geküsst hast."

# game/script.rpy:881
translate ger ch2_44e74989:

    # a lol "C'mon, if he's really the absolute cutest, it's a shame to keep him anonymous, right? Not like I'm gonna tell anyone anyways."
    a lol "Komm schon, wenn er wirklich der Allersüßeste ist, dann ist es doch schade, ihn zu anonymisieren, oder?"
    a "Als würde ich das weitersagen."

# game/script.rpy:882
translate ger ch2_cb259e44:

    # w calm "Fine... his name is Pastille."
    w calm "Na gut... sein Name ist Pastille."

# game/script.rpy:883
translate ger ch2_ce121fd3:

    # a annoyed "Hmph. Even his name's cute."
    a annoyed "Hmpf. Sogar sein Name ist süß."

# game/script.rpy:884
translate ger ch2_b434ce04:

    # w happy "Right~?"
    w happy "Gell~?"

# game/script.rpy:885
translate ger ch2_2d463d2b:

    # w smile "Oh, that reminds me--he sold me some candies that share his name. Would you like to try?"
    w smile "Oh, das erinnert mich an was--er hat mir Süßigkeiten verkauft, die so wie er heißen. Magst du probieren?"

# game/script.rpy:886
translate ger ch2_628745c1:

    # a happy "Sure. How could a witch turn down free candy?"
    a happy "Klar. Wie könnte eine Hexe Süßigkeiten ablehnen?"

# game/script.rpy:887
translate ger ch2_2ac72dd0:

    # n "Periwinkle digs into his bag and pulls out one of the pastilles."
    n "Periwinkle wühlt in seiner Tasche herum und holt eine Pastille hervor."

# game/script.rpy:888
translate ger ch2_c90345e5:

    # n "He hands the candy to Astragalus, who promptly unwraps it and pops it into her mouth."
    n "Er überreicht die Süßigkeit Astragalus, die sie sofort auspackt und sich in den Mund schiebt."

# game/script.rpy:889
translate ger ch2_e3dc6cdf:

    # a hm "Mmf... Oh, these are GOOD. Where'd you say this candy shop was?"
    a hm "Mmf... Oh, die sind GUT. Wo, sagtest du, ist dieser Laden?"

# game/script.rpy:890
translate ger ch2_6e7c54dc:

    # w happy "Not far from here! I'll give you directions..."
    w happy "Nicht weit von hier! Ich kann dir sagen, wie du hin kommst..."

# game/script.rpy:897
translate ger ch2_58993334:

    # "Shortly after telling Astragalus where to find Atelier Sweets, she unceremoniously kicked me out..."
    "Kurz nachdem ich Astragalus gesagt habe, wie sie Atelier Sweets finden konnte, hat sie mich kurzerhand rausgeschmissen..."

# game/script.rpy:898
translate ger ch2_7f4ee160:

    # "She'd long finished putting all those bottles away, after all."
    "Schließlich war sie schon längst damit fertig gewesen, all die Flaschen einzuräumen."

# game/script.rpy:899
translate ger ch2_d635dbff:

    # "With money in my pocket, and no more work to be done for the moment... I'm free to begin pursuing my next date~"
    "Jetzt, wo ich das Geld in meiner Tasche habe und die Arbeit für heute beendet ist... kann ich anfangen, mein nächstes Date zu jagen~"

# game/script.rpy:900
translate ger ch2_a4f99886:

    # nvl clear
    # "But wherever shall I go? It's a weekday, too early for parties, too early for drinks..."
    nvl clear
    "Aber wo soll ich nur hin? Es ist unter der Woche. Zu früh für Partys, zu früh für Drinks..."

# game/script.rpy:902
translate ger ch2_1e5385aa:

    # "I suppose I could return home and straighten up the place. However..."
    "Ich könnte nach Hause gehen und mal aufräumen. Aber..."

# game/script.rpy:903
translate ger ch2_801baa18:

    # nvl clear
    # w calm "(Why would I busy myself with chores when I could be celebrating another order successfully filled?)"
    nvl clear
    w calm "{size=-2}(Wieso sollte ich mich mit Hausarbeiten beschäftigen, wenn ich das erfolgreiche Abfüllen einer weiteren Bestellung feiern könnte?)"

# game/script.rpy:906
translate ger ch2_7123d8ef:

    # n "Before Periwinkle can decide on where to go, a familiar witch approaches him."
    n "Bevor Periwinkle eine Entscheidung treffen kann, nähert sich ihm eine bekannte Hexe."

# game/script.rpy:909
translate ger ch2_a7e53e02:

    # c "Periwinkle...?"
    c "Periwinkle...?"

# game/script.rpy:910
translate ger ch2_ed8e4bc5:

    # w happy "Ohh, Cassia! So lovely to see you~"
    w happy "Ooh, Cassia! So schön, dich zu sehen~"

# game/script.rpy:911
translate ger ch2_cca6951a:

    # c happy "Yay, I'm so glad we ran into each other~"
    c happy "Yay, ich freu ich, dass wir uns über den Weg gelaufen sind~"

# game/script.rpy:913
translate ger ch2_18cfade9:

    # "How to describe Cassia..."
    "Wie kann ich Cassia beschreiben..."

# game/script.rpy:914
translate ger ch2_0c67f0a0:

    # "She's exceedingly cuddly. We met at a party one night, during which she latched onto my arm and never let go. Quite endearing!"
    "Sie ist überaus verschmust. Wir hatten uns mal auf einer Party kennengelernt, auf der sie sich an meinen Arm gehängt und nicht mehr losgelassen hatte. Ziemlich einnehmend!"

# game/script.rpy:915
translate ger ch2_6535f464:

    # "Since then, we've gone on little dates from time to time..."
    "Seitdem sind wir hin und wieder auf kleine Dates gegangen..."

# game/script.rpy:916
translate ger ch2_91a4c39c:

    # "She really loves my magic, so I tend to spoil her whenever we're together 💙"
    "Sie liebt meine Magie sehr, also habe ich den Hang, sie jedes Mal damit zu verwöhnen, wenn wir zusammen sind 💙"

# game/script.rpy:917
translate ger ch2_fc9d5dc6:

    # nvl clear
    # w smile "Did you need something, dear?"
    nvl clear
    w smile "Brauchst du etwas, Süße?"

# game/script.rpy:920
translate ger ch2_7206142c:

    # c aww "Ah, yes! I tried coming over last night, but you didn't seem to be home..."
    c aww "Ah, ja! Ich wollte gestern Abend vorbeikommen, aber du warst wohl nicht zuhause..."

# game/script.rpy:921
translate ger ch2_693e007a:

    # w shy "Aww, you came to visit me? I'm flattered 💙"
    w shy "Aww, du wolltest mich besuchen kommen? Ich fühle mich geschmeichelt 💙"

# game/script.rpy:922
translate ger ch2_399869f1:

    # w smile "I must've been out to dinner at the time... Sorry that I missed you~"
    w smile "Ich war zu dem Zeitpunkt wohl auswärts essen... Sorry, dass ich dich verpasst habe~"

# game/script.rpy:923
translate ger ch2_2f0adf6c:

    # c smile "Oh, it's okay~ I was mostly looking to talk..."
    c smile "Oh, schon okay~ Ich wollte eigentlich nur reden..."

# game/script.rpy:924
translate ger ch2_c9ba5380:

    # c aww "So, um, if you're available right now... do you wanna go to a café?"
    c aww "Also, ähm, wenn du jetzt gerade Zeit hast... magst du in ein Café gehen?"

# game/script.rpy:925
translate ger ch2_d5996b44:

    # w innocent "That sounds perfect! I would love to."
    w innocent "Das klingt perfekt! Sehr gerne."

# game/script.rpy:931
translate ger ch2_e516a126:

    # "We take our seats at the nearby café."
    "Wir nehmen in einem nahegelegenen Café Platz."

# game/script.rpy:932
translate ger ch2_07ec8f7d:

    # "It's a pleasant, sunny little place. I've come here often with all sorts of other witches."
    "Es ist ein angenehmer, sonniger kleiner Platz. Ich komme oft mit vielen verschiedenen Hexen her."

# game/script.rpy:933
translate ger ch2_798bacd1:

    # "Cassia orders her usual hot chocolate with extra marshmallows, while I decide on a simple rose tea."
    "Cassia bestellt ihre übliche heiße Schokolade mit extra Marshmallows, während ich mich für einen einfachen Rosenblütentee entscheide."

# game/script.rpy:934
translate ger ch2_13febc5a:

    # nvl clear
    # c oh "Ooh, Periwinkle, could you make my marshmallows smell like roses, too?"
    nvl clear
    c oh "Ooh, Periwinkle, kannst du meine Marshmallows auch nach Rosen duften lassen?"

# game/script.rpy:937
translate ger ch2_e1d1de4a:

    # w innocent "With pleasure 💙"
    w innocent "Mit Vergnügen 💙"

# game/script.rpy:938
translate ger ch2_d7d93e12:

    # n "Periwinkle's wand drops from his sleeve, and he gives Cassia's cup a quick little tap."
    n "Periwinkles Zauberstab plumpst aus seinem Ärmel und er tippt damit ganz leicht auf Cassias Tasse."

# game/script.rpy:939
translate ger ch2_9343669f:

    # c happy "Eheh, yay~ It really smells just like roses~!"
    c happy "Ehehe, yay~ Es duftet wirklich genau wie Rosen~!"

# game/script.rpy:940
translate ger ch2_790200db:

    # w smile "Just as you asked, dear. It may slightly affect the taste, so let me know if you'd like the spell undone."
    w smile "Wie gewünscht, Süße. Es könnte den Geschmack etwas beeinflussen, also sag Bescheid, wenn ich den Zauber aufheben soll."

# game/script.rpy:942
translate ger ch2_51b79206:

    # n "Cassia dips her spoon in and lifts a marshmallow to her lips, blowing on it lightly before popping it into her mouth."
    n "{size=-2}Cassia tunkt ihren Löffel hinein und hebt einen Marshmallow an ihre Lippen, dann pustet sie etwas, bevor sie ihn in den Mund steckt."

# game/script.rpy:943
translate ger ch2_bb00d05f:

    # c happy "Mmf... no, it's wonderful! Ehehe~ 🤎"
    c happy "Mmf... nein, es ist wunderbar! Ehehe~ 🤎"

# game/script.rpy:946
translate ger ch2_88501500:

    # "She truly can find the joy in any little moment. Such a delight..."
    "Sie kann sich wirklich an jedem kleinen Moment erfreuen. Wirklich entzückend..."

# game/script.rpy:947
translate ger ch2_28e04d59:

    # "Definitely a contender for the title of absolute cutest witch. Though I would call her... absolutely cute, rather than the absolute cutest."
    "Definitiv eine Anwärterin auf den Titel der allersüßesten Hexe. Wobei ich sie eher als... überaus süß bezeichnen würde, nicht allersüßeste."

# game/script.rpy:948
translate ger ch2_22a82a32:

    # "It takes more than cuteness alone to earn the title of absolute cutest witch! That's where the difference lies, of course."
    "Für diesen Titel reicht nicht aus, einfach nur süß zu sein. Da gibt es natürlich noch mehr als das."

# game/script.rpy:949
translate ger ch2_1167b98f:

    # nvl clear
    # "But what am I thinking? How rude it is, to begin ranking my dates in such a way."
    nvl clear
    "Aber was denke ich da? Es ist unhöflich, damit anzufangen, meine Dates so zu bewerten."

# game/script.rpy:951
translate ger ch2_89364570:

    # "I must be stuck on the thought from my earlier conversation with Astragalus... trying to put Pastille's cuteness into words."
    "Ich hänge wohl noch an dem Gedanken von vorhin beim Gespräch mit Astragalus fest... wie ich Pastilles Niedlichkeit in Worte fassen soll."

# game/script.rpy:952
translate ger ch2_f14542af:

    # "He really is something special... ah, it's all in the contrast! His polite, well-mannered and proper exterior, concealing such intense desire, begging you to make the first move, and then going ahead and taking it on his own as soon as you--"
    "Er ist wirklich was Besonderes... ah, es ist so ein Kontrast! Sein höfliches, vornehmes und angemessenes Äußeres kaschiert dieses intensive Verlangen, das um den ersten Schritt bettelt und dann einfach ausbricht und das Ruder an sich reißt, sobald man--"

# game/script.rpy:953
translate ger ch2_d02f8f43:

    # nvl clear
    # w oops "(...Enough of that! There's someone else in front of me now, isn't there?)" with vpunch
    nvl clear
    w oops "(...Genug davon! Da ist jemand anderes vor mir, oder?)" with vpunch

# game/script.rpy:956
translate ger ch2_84a03c6d:

    # n "Cassia continues happily sipping her hot chocolate before speaking up again."
    n "Cassia trinkt weiter fröhlich ihre heiße Schokolade, bevor sie weiterspricht."

# game/script.rpy:958
translate ger ch2_4958d936:

    # c aw "Ahh, I missed you, Periwinkle~ I've been so busy with packing, I haven't had a chance to see you at all..."
    c aw "Aah, ich hab dich vermisst, Periwinkle~ Ich war so beschäftigt mit packen, ich hatte gar keine Chance, dich zu treffen..."

# game/script.rpy:959
translate ger ch2_15a35145:

    # w my "Packing? And just where are you headed off to?"
    w my "Packen? Und wohin gedenkst du zu gehen?"

# game/script.rpy:960
translate ger ch2_959ab161:

    # c oh "Oh, that's right! I never had a chance to tell you~"
    c oh "Oh, stimmt ja! Ich hatte noch nicht die Gelegenheit, es dir zu sagen~"

# game/script.rpy:961
translate ger ch2_28a09411:

    # c happy "I'm finally moving in with my partners~! In two more days, the three of us will all be sleeping in the same bed~ 🤎"
    c happy "Ich ziehe endlich mit meinen Partnern zusammen~! Nur noch zwei Tage, dann liegen wir alle drei zusammen im selben Bett~ 🤎"

# game/script.rpy:962
translate ger ch2_1b9c5f18:

    # w happy "Ooh, that sounds cozy~ Congratulations!"
    w happy "Ooh, das klingt gemütlich~ Gratulation!"

# game/script.rpy:963
translate ger ch2_937fc8b0:

    # c aww "Ehe, thank you~ 🤎 I've looked forward to it for so long..."
    c aww "Ehehe, danke~ 🤎 Ich freue mich schon so lange darauf..."

# game/script.rpy:964
translate ger ch2_aae442de:

    # w smile "It sounds like you're about to enter a lovely domestic life. You deserve it!"
    w smile "Klingt, als stehst du kurz davor, ein liebenswertes Familienleben zu führen. Du verdienst es!"

# game/script.rpy:965
translate ger ch2_f5692979:

    # c "Aww, hehehe... I'm really happy."
    c "Aww, hehehe... ich bin wirklich glücklich."

# game/script.rpy:966
translate ger ch2_d2fabfa3:

    # c oh "But, um... speaking of my partners. You've still never even met them..."
    c oh "Aber, ähm... wo wir gerade von meinen Partnern reden. Du hast sie immer noch nicht einmal kennengelernt..."

# game/script.rpy:967
translate ger ch2_f5612c00:

    # w calm "True. But I can imagine they're wonderful, just from how you've talked about them."
    w calm "Stimmt. Aber ich kann mir vorstellen, wie wundervoll sie sind, so wie du immer von ihnen redest."

# game/script.rpy:968
translate ger ch2_f82c96ac:

    # c aww "Right~ but, um... what if you didn't have to imagine?"
    c aww "Stimmt~ aber, ähm... was, wenn du es dir nicht vorstellen müsstest?"

# game/script.rpy:969
translate ger ch2_add80a4e:

    # c smile "That's what I've been wanting to talk to you about. I was hoping... we might all be able to go on a group date sometime!"
    c smile "Das ist, worüber ich mit dir sprechen wollte. Ich hatte gehofft... wir könnten mal alle zusammen auf ein Gruppendate gehen!"

# game/script.rpy:970
translate ger ch2_c81c387b:

    # w oh "Oh~?"
    w oh "Oh~?"

# game/script.rpy:971
translate ger ch2_8b6f2fb7:

    # c aw "Yeah~! Because, like... I just think you're so wonderful, Periwinkle. I want them to know you, too!"
    c aw "Ja~! Weil, halt... Ich finde dich so wunderbar, Periwinkle. Ich möchte, dass sie dich auch kennen!"

# game/script.rpy:972
translate ger ch2_40b31e80:

    # w sorry "Mm... although it sounds like fun, I'm a bit..."
    w sorry "Mm... auch wenn das nach Spaß klingt, bin ich etwas..."

# game/script.rpy:973
translate ger ch2_7122e72f:

    # c please "W-wait, before you say no...!"
    c please "W-warte, bevor du nein sagst...!"

# game/script.rpy:974
translate ger ch2_b6456ff5:

    # c "They're both very easygoing, and so loving, and nice...! I can promise it won't be overwhelming..."
    c "Sie sind beide so unbeschwert und so liebevoll und nett...! Ich kann dir versprechen, es wird nicht überfordernd sein..."

# game/script.rpy:975
translate ger ch2_62b54e38:

    # w decline "That unfortunately isn't where the issue lies, my dear..."
    w decline "Das ist leider nicht das Problem bei dieser Sache, Liebes..."

# game/script.rpy:976
translate ger ch2_bb65f581:

    # c sad "I-I know you said you didn't want to get involved before... but I just know that we would all get along so well!"
    c sad "{size=-2}I-ich weiß, du hast schon mal gesagt, du willst da nicht mitmachen... aber ich weiß einfach, dass wir alle so gut miteinander auskommen würden!"

# game/script.rpy:977
translate ger ch2_9db7f2b9:

    # c "I'd like to reassure you however I can. But I understand if you still turn me down..."
    c "Das kann ich dir wirklich zusichern. Aber ich verstehe es, wenn du es trotzdem ablehnst..."

# game/script.rpy:979
translate ger ch2_99af5b21:

    # "Matters of love are so tricky, aren't they?"
    "Das mit der Liebe ist schon knifflig, nicht wahr?"

# game/script.rpy:980
translate ger ch2_b7229a67:

    # "I still recall the first time something like this was asked of me..."
    "Ich kann mich immer noch an das erste Mal erinnern, dass ich so was gefragt wurde..."
    nvl clear

# game/script.rpy:981
translate ger ch2_70f4d8cb:

    # "I had been nervous going in, but I had also never entered a group situation before. I attributed my anxiety solely to that."
    "Ich war nervös an die Sache rangegangen, aber ich hatte vorher auch noch nie so ein Gruppending. Ich dachte, meine Angst käme allein deshalb."

# game/script.rpy:982
translate ger ch2_5aaf6eab:

    # "However, it quickly became clear that I just wasn't suited to it at all..."
    "Allerdings wurde mir dann schnell klar, dass ich einfach überhaupt nicht dafür gemacht war..."

# game/script.rpy:983
translate ger ch2_92e49d6c:

    # nvl clear
    # "I do love to spoil each of my partners--but strictly one at a time."
    nvl clear
    "Ich liebe es, jeden meiner Partner zu verwöhnen--aber ausdrücklich nur einer zur selben Zeit."

# game/script.rpy:985
translate ger ch2_13099713:

    # "Perhaps I was left scarred by the breakdown in communication, the passionate fires of a long-established romance..."
    "Vielleicht bin ich noch gebrandmarkt vom Zerfall der Kommunikation, der leidenschaftlichen Flammen einer lange aufgebauten Romanze..."

# game/script.rpy:986
translate ger ch2_000f6a86:

    # "Surely Cassia and her partners are magnificent people. It may indeed be fun for a night."
    "Klar sind Cassia und ihre Partner wunderbare Leute. Es könnte durchaus ein Spaß für eine Nacht sein."

# game/script.rpy:987
translate ger ch2_e1d8cf3a:
    nvl clear
    # "But becoming entangled in committed relationships is something I've always avoided from the beginning, isn't it?"
    "Aber in feste Beziehungen verwickelt zu werden war etwas, was ich von Anfang an vermieden hatte, oder?"

# game/script.rpy:988
translate ger ch2_b61e07ce:

    # nvl clear
    # w neutral "This is all very sweet of you. But I do have to decline."
    nvl clear
    w neutral "Das ist alles sehr süß von dir. Aber ich muss ablehnen."

# game/script.rpy:991
translate ger ch2_d6eb3267:

    # c letdown "Aww... I can't help but feel a little broken-hearted."
    c letdown "Aww... Du brichst mir ein bisschen das Herz."

# game/script.rpy:992
translate ger ch2_02d40560:

    # w decline "I apologize... Truly, it's nothing personal."
    w decline "Tur mir leid... Es ist wirklich nichts Persönliches."

# game/script.rpy:993
translate ger ch2_cea46204:

    # c aww "Oh, I know~ I don't take offense or anything..."
    c aww "Ach, weiß ich doch~ Ich seh es nicht als Angriff oder so..."

# game/script.rpy:994
translate ger ch2_13fca6f4:

    # c letdown "It's just sad. Now that I'm going to be living with them... and, knowing you don't want to meet them..."
    c letdown "Es ist nur traurig. Jetzt, wo ich mit ihnen zusammen leben werde... und weiß, dass du sie nicht kennenlernen möchtest..."

# game/script.rpy:995
translate ger ch2_82188b3a:

    # c sad "I think it's best we just break things off...."
    c sad "Es wird wohl das Beste sein, wenn wir das ganz lassen...."

# game/script.rpy:996
translate ger ch2_9b7a5305:

    # w neutral "Yes, I agree. As you said, it's for the best."
    w neutral "Ja, ich stimme zu. Wie du sagst, wird es das Beste sein."

# game/script.rpy:997
translate ger ch2_22bfa56a:

    # c aww "I hope we can still be friends, though~"
    c aww "Aber ich hoffe, wir können wenigstens Freunde bleiben~"

# game/script.rpy:998
translate ger ch2_a119e9ad:

    # w smile "Of course~ 💙 I'm sure our paths will cross every now and again."
    w smile "Natürlich~ 💙 Ich bin sicher, dass wir uns hin und wieder begegnen werden."

# game/script.rpy:999
translate ger ch2_96818197:

    # c happy "Yeah~! Thank you for always treating me so well, Periwinkle."
    c happy "Ja~! Danke, dass du mich immer so gut behandelst, Periwinkle."

# game/script.rpy:1000
translate ger ch2_f9c0bf81:

    # w calm "Hmhm, it was my pleasure 💙"
    w calm "Hmhm, es war mir ein Vergnügen 💙"

# game/script.rpy:1003
translate ger ch2_482c7dd0:

    # "Even casual relationships can end in breakups like this."
    "Sogar lockere Beziehungen können in solchen Trennungen enden."

# game/script.rpy:1004
translate ger ch2_7fabf76c:

    # "This is largely why I tend to prefer one-night affairs. Things can just become so messy as needs evolve..."
    "Hauptsächlich deshalb bevorzuge ich Affären für eine Nacht. Dinge können einfach so durcheinander geraten, sobald sich Bedürfnisse entwickeln..."

# game/script.rpy:1005
translate ger ch2_e8be9790:

    # "As Cassia and I go our separate ways, I can't help feeling a little blue."
    "Als Cassia und ich getrennte Wege gehen, kann ich nicht anders, als schlechte Laune zu bekommen."

# game/script.rpy:1006
translate ger ch2_7b0bc9f1:

    # "Perhaps I'll return home for the day after all."
    "Vielleicht gehe ich doch einfach nach Hause."

# game/script.rpy:1007
translate ger ch2_76b2fe88_2:

    # nvl clear
    nvl clear

# game/script.rpy:1018
translate ger ch2_80d3118f:

    # n "Periwinkle quickly changes into something more comfortable, dropping his bag unceremoniously onto the couch."
    n "Periwinkle zieht sich schnell etwas gemütlicheres an und schmeißt seine Tasche kurzerhand auf die Couch."

# game/script.rpy:1019
translate ger ch2_a9ff1a56:

    # w pj neutral "(I could use an afternoon nap...)"
    w pj neutral "(Ich könnte ein Nickerchen vertragen...)"

# game/script.rpy:1020
translate ger ch2_10be0962:

    # w calm "(Yes, that's precisely what I need. I'll wake up feeling refreshed, and ready to go back out on the town~)"
    w calm "(Ja, das ist genau was ich brauche. Ich werde erfrischt aufwachen und bereit sein, wieder in die Stadt zu gehen~)"

# game/script.rpy:1022
translate ger ch2_47c6e3ec:

    # n "He shoves some blankets aside and collapses onto the couch--and when he does, the contents of his bag spills onto the floor."
    n "Er schiebt ein paar Decken zur Seite und lässt sich auf die Couch fallen--was dazu führt, dass die Sachen aus seiner Taschen fallen."

# game/script.rpy:1023
translate ger ch2_093623ac:

    # w oh "Ah..."
    w oh "Ah..."

# game/script.rpy:1024
translate ger ch2_189b671a:

    # n "Lazily leaning over to gather it up, he notices the candies from before..."
    n "Faul nach vorne lehnend, um sie aufzuheben, fallen ihm die Süßigkeiten von vorhin auf..."

# game/script.rpy:1025
translate ger ch2_cba66395:

    # w neutral "...."
    w neutral "...."

# game/script.rpy:1030
translate ger ch2_ed23994c:

    # "Was I too hasty in saying I'd hoped to see Pastille again?"
    "War ich zu voreilig damit zu sagen, ich würde Pastille gern wieder sehen?"

# game/script.rpy:1031
translate ger ch2_cad66722:

    # "I suppose I'd forgotten the feeling of not being enough for someone."
    "Ich hatte wohl das Gefühl vergessen, nicht genug für jemanden zu sein."

# game/script.rpy:1032
translate ger ch2_fc6603e2:

    # "Usually these things tend to dissipate naturally, without confrontation or notice."
    "Normalerweise lösen sich solche Sachen natürlich auf, ohne dass man es merkt."

# game/script.rpy:1033
translate ger ch2_e7803a00:

    # "So when they don't... it stings."
    "Wenn sie's also nicht tun... tut es weh."

# game/script.rpy:1034
translate ger ch2_fc4b9a1c:

    # nvl clear
    # n "Periwinkle scoops up the candies, dropping all but one of them back into his bag."
    nvl clear
    n "Periwinkle sammelt die Süßigkeiten auf und kippt sie alle bis auf eine zurück in seine Tasche."

# game/script.rpy:1037
translate ger ch2_f16117de:

    # n "He settles into place on the couch, nestled in a tangled mess of blankets and cushions... and unwraps his chosen pastille."
    n "Er macht es sich in einem Durcheinander aus Decken und Kissen bequem... und packt seine ausgewählte Pastille aus."

# game/script.rpy:1040
translate ger ch2_2fa75bdb:

    # w pj calm "(...It IS sweet, though.)"
    w pj calm "(...Aber es IST süß.)"

# game/script.rpy:1041
translate ger ch2_81ec8a05:

    # w shy "(What a shame that would be, if I never got to taste it again!)"
    w shy "(Wäre doch schade, nicht noch einmal in den Genuss zu kommen!)"

# game/script.rpy:1044
translate ger ch2_b429b989:

    # "That's right. I could never resist the promise of an entertaining night, no matter what may come down the line."
    "Das ist richtig. Ich konnte nie einem Spaß versprechenden Abend widerstehen, komme was wolle."

# game/script.rpy:1045
translate ger ch2_13b346ec:

    # "I'm a hopeless hedonist after all 💙 Nothing to be done about that!"
    "Ich bin immerhin ein hoffnungsloser Hedonist 💙 Da kann man nichts machen!"

# game/script.rpy:1046
translate ger ch2_b6d8bcd7:

    # "Let fate decide, then. If he comes, he comes."
    "Lassen wir das Schicksal entscheiden. Wenn er kommt, dann kommt er."

# game/script.rpy:1047
translate ger ch2_191d1d9c:

    # "And if we never meet again... I can always hold on to the memory of our perfect date 💙"
    "Und sollten wir uns nie wieder sehen... habe ich immer noch die Erinnerung an unser perfektes Date 💙"

# game/script.rpy:1048
translate ger ch2_76b2fe88_3:

    # nvl clear
    nvl clear

# game/script.rpy:1053
translate ger ch2_1a34cacc:

    # n "Several hours later..."
    n "Einige Stunden später..."

# game/script.rpy:1054
translate ger ch2_3688e7d8:

    # n "...there's a knock at the door."
    n "...klopft es an der Tür."

# game/script.rpy:1060
translate ger ch2_f9db6787:

    # n "And right there on his doorstep, Periwinkle is pleasantly surprised to find..."
    n "Und genau da auf der Türschwelle wartet eine erfreuliche Überraschung auf Periwinkle..."

# game/script.rpy:1062
translate ger ch2_40e54497:

    # w pj my "Pastille! I wasn't expecting to see you again so soon~"
    w pj my "Pastille! Ich habe nicht damit gerechnet, dich so früh wieder zu sehen~"

# game/script.rpy:1063
translate ger ch2_b15c4708:

    # w drool "(And treating me to another cute new look, no less! 💙)"
    w drool "(Und mit einem neuen süßen Anblick verwöhnt zu werden! 💙)"

# game/script.rpy:1064
translate ger ch2_99245a8a:

    # p "Sorry, I, um... I couldn't stop thinking about..."
    p "Sorry, ich, ähm... ich konnte nicht aufhören, daran zu denken..."

# game/script.rpy:1065
translate ger ch2_42189d4b:

    # p ehe2 "I-I mean--I realized, last night I never actually... got to sample your magic? The scents you mentioned..."
    p ehe2 "I-ich meine--mir ist aufgefallen, dass ich gar nicht dazu kam... deine Magie auszuprobieren!"

# game/script.rpy:1066
translate ger ch2_e2870f5e:

    # w oh "Oh, that's right..."
    w oh "Oh, stimmt ja..."

# game/script.rpy:1067
translate ger ch2_974aa600:

    # w love "We were quite preoccupied, hm? 💙"
    w love "Wir waren wohl zu beschäftigt, hm? 💙"

# game/script.rpy:1068
translate ger ch2_bddfdf51:

    # p seriously "Y-yes... so, th-that's why I'm here!"
    p seriously "J-ja... deshalb b-bin ich hier!"

# game/script.rpy:1069
translate ger ch2_688d44a5:

    # n "He finally manages to make eye contact, but quickly averts his gaze once more."
    n "Er schafft es endlich, Blickkontakt herzustellen, wendet seinen Blick aber wieder ganz schnell ab."

# game/script.rpy:1070
translate ger ch2_6ad797b9:

    # p shy "Ah--um, were you in bed? Sorry, I shouldn't have come so late...."
    p shy "Ah--ähm, warst du im Bett? Sorry, ich hätte nicht so spät kommen sollen..."

# game/script.rpy:1071
translate ger ch2_e453f11a:

    # w calm "Hmhm, these aren't even my sexiest pajamas..."
    w calm "Hmhm, das ist nicht mal mein heißester Pyjama..."

# game/script.rpy:1072
translate ger ch2_c0c9e69d:

    # p omg "I didn't say anything about that...!" with vpunch
    p omg "Dazu habe ich gar nichts gesagt...!" with vpunch

# game/script.rpy:1073
translate ger ch2_ac06f781:

    # w innocent "But to answer your question, no, I wasn't."
    w innocent "Aber um deine Frage zu beantworten, nein, war ich nicht."

# game/script.rpy:1074
translate ger ch2_1837215c:

    # w smile "Although I did take a nap earlier this afternoon, I've otherwise been enjoying a relaxing night in."
    w smile "Allerdings hab ich heute Nachmittag ein Nickerchen gemacht. Sonst hab ich mir einen entspannten Abend gemacht."

# game/script.rpy:1075
translate ger ch2_7eec0fd7:

    # w drool "(And I'm so very glad I didn't end up going out! I would've missed out on this flustered mess 💙)"
    w drool "(Und ich bin so froh, dass ich nicht doch ausgegangen bin! Ich hätte dieses nervöse Durcheinander verpasst 💙)"

# game/script.rpy:1076
translate ger ch2_dfa9333a:

    # p ehe2 "Ah... haha...."
    p ehe2 "Ah... haha...."

# game/script.rpy:1077
translate ger ch2_47eb90b7:

    # w innocent "...Would you like to come in?"
    w innocent "...Möchtest du reinkommen?"

# game/script.rpy:1079
translate ger ch2_18ec9e87:

    # n "Pastille nods vigorously in response."
    n "Pastille nickt heftig mit dem Kopf."

# game/script.rpy:1085
translate ger ch2_ee963e3c:

    # w pj calm "It's still a bit of a mess in here... I hope you don't mind~"
    w pj calm "Es ist immer noch etwas unaufgeräumt hier... Ich hoffe, das stört dich nicht~"

# game/script.rpy:1086
translate ger ch2_cd5e4835:

    # p oh "There's a path through. I've seen worse."
    p oh "Es gibt Durchgänge. Hab Schlimmeres gesehen."

# game/script.rpy:1087
translate ger ch2_6f4d78ac:

    # w happy "Oh~ maybe I'll let it spiral further into chaos, then! I'm just so competitive, you know? 💙"
    w happy "Oh~ dann lass ich es vielleicht total ausarten! Ich bin halt sehr kompetitiv, weißt du? 💙"

# game/script.rpy:1088
translate ger ch2_63398835:

    # p ehe "I'm not sure that's a competition you'd really want to win..."
    p ehe "Ich denke nicht, dass das ein Wettbewerb ist, den du wirklich gewinnen willst..."

# game/script.rpy:1089
translate ger ch2_8189bccf:

    # w calm "Hmhm, perhaps not."
    w calm "Hmhm, wahrscheinlich nicht."

# game/script.rpy:1091
translate ger ch2_165173b4:

    # n "Periwinkle carefully steps over some of his clutter to dig through one of the boxes in the far corner of the room."
    n "Periwinkle steigt vorsichtig über seine Unordnung, um in einer Kiste weit hinten in der Ecke des Zimmers zu wühlen."

# game/script.rpy:1093
translate ger ch2_843f2cc2:

    # w pj smile "Ah, here they are! My personal favorites..."
    w pj smile "Ah, hier sind sie! Meine persönlichen Lieblinge..."

# game/script.rpy:1096
translate ger ch2_2a6d3b75:

    # w calm "This row here contains some of the more potent scents... most of them for relaxation, things to calm the nerves."
    w calm "Diese Reihe hier beinhaltet die stärkeren Düfte... die meisten davon zum Entspannen. Zeug zum Runterkommen."

# game/script.rpy:1097
translate ger ch2_861a81ad:

    # w smile "The rest, I just happen to like. Sweet scents, like strawberry, banana, bubblegum, mango..."
    w smile "Den Rest mag ich einfach irgendwie. Süße Düfte wie Erdbeere, Banane, Kaugummi, Mango..."

# game/script.rpy:1098
translate ger ch2_25b75e0f:

    # p "I-is there a reason you're only naming candy flavors...?"
    p "G-gibt es einen Grund, wieso du nur süße Richtungen erwähnst...?"

# game/script.rpy:1099
translate ger ch2_0d95e3c3:

    # w innocent "Hm~ must be a coincidence 💙"
    w innocent "Hm~ muss ein Zufall sein 💙"

# game/script.rpy:1101
translate ger ch2_432e8e66:

    # n "Pastille picks out an unlabeled bottle, filled with a pale pink liquid..."
    n "Pastille nimmt eine unbeschriftete Flasche heraus, in der eine blass-pinken Flüssigkeit ist..."

# game/script.rpy:1104
translate ger ch2_b279bf05:

    # p "What's this?"
    p "Was ist das?"

# game/script.rpy:1105
translate ger ch2_51cf5f4c:

    # w teehee "Ahh, watch out~ that one's an aphrodisiac 💙"
    w teehee "Aah, pass auf~ das ist ein Aphrodisiakum 💙"

# game/script.rpy:1106
translate ger ch2_93475faa:

    # p calm "Hm. We'll see about that."
    p calm "Hm. Na, schauen wir mal."

# game/script.rpy:1108
translate ger ch2_e9e24a9f:

    # n "Pastille locks eyes with Periwinkle as he opens the vial without hesitation."
    n "Pastille hält Blickkontakt mit Periwinkle, während er das Fläschchen ohne zu zögern öffnet."

# game/script.rpy:1109
translate ger ch2_2fb76492:

    # w drool "(How bold...!)"
    w drool "(Wie frech...!)"

# game/script.rpy:1111
translate ger ch2_0042c176:

    # p ehe "...Oh, it's peach. Hah, I almost expected it to be overpowering..."
    p ehe "...Oh, es ist Pfirsich. Ich habe fast erwartet, dass es überwältigend sein wird..."

# game/script.rpy:1112
translate ger ch2_3da16e70:

    # w calm "Yes, well, the aphrodisiac bit was a lie. But I'm glad you like it."
    w calm "Ja, nun, das mit dem Aphrodisiakum war eine Lüge. Aber freut mich, dass es dir gefällt."

# game/script.rpy:1113
translate ger ch2_84afb1db:

    # p smile "You're really good at this type of magic--I've never done anything like it..."
    p smile "Du bist wirklich gut mit dieser Art Magie--ich habe so was noch nie gemacht..."

# game/script.rpy:1114
translate ger ch2_eac4cdca:

    # w smile "Would you like to try it on?"
    w smile "Möchtest du es mal auftragen?"

# game/script.rpy:1115
translate ger ch2_fa96959b:

    # p oh "Hm...?"
    p oh "Hm...?"

# game/script.rpy:1116
translate ger ch2_83bb61ec:

    # p shy "Oh, n-no, I don't do perfume or cologne or anything like that..."
    p shy "Oh, n-nein, ich verwende keine Parfums oder so..."

# game/script.rpy:1117
translate ger ch2_7df5f505:

    # w oh "You've never tried it? Ohh, so would you say..."
    w oh "Du hast es noch nie ausprobiert? Ooh, man könnte also sagen..."

# game/script.rpy:1118
translate ger ch2_cc464b9d:

    # w shy "You're a perfume virgin, then? 💙"
    w shy "Du bist eine Parfumjungfrau? 💙"

# game/script.rpy:1119
translate ger ch2_3db42423:

    # p seriously "I-I'M NOT...! Who even says things like that?!" with vpunch
    p seriously "B-BIN ICH NICHT...! Wer sagt so was überhaupt?!" with vpunch

# game/script.rpy:1120
translate ger ch2_2cfe21e1:

    # w happy "In my line of work, you'd be surprised~"
    w happy "In meinem Berufsfeld wärst du überrascht~"

# game/script.rpy:1121
translate ger ch2_ba67bd24:

    # p shy "It's probably just you...."
    p shy "Du bist bestimmt der einzige...."

# game/script.rpy:1122
translate ger ch2_27256bce:

    # w innocent "Hmhm, maybe so."
    w innocent "Hmhm, vielleicht."

# game/script.rpy:1123
translate ger ch2_adc8879b:

    # w calm "If you're not going to try it, I'll have it back now, please~"
    w calm "Wenn du es nicht auftragen willst, kann ich es dann bitte wiederhaben~?"

# game/script.rpy:1124
translate ger ch2_0d918745:

    # p anxious "I could.. try...."
    p anxious "Ich könnte... es ausprobieren...."

# game/script.rpy:1125
translate ger ch2_66c51016:

    # p ehe2 "I just don't know how I'm supposed to apply it."
    p ehe2 "Ich weiß nur nicht, wie ich das auftragen soll."

# game/script.rpy:1126
translate ger ch2_a2e4ac6c:

    # w smile "May I?"
    w smile "Darf ich?"

# game/script.rpy:1129
translate ger ch2_b631c2d3:

    # n "Pastille nods, handing over the small vial."
    n "Pastille nickt und überreicht das kleine Fläschchen."

# game/script.rpy:1130
translate ger ch2_6b5afd7c:

    # n "Periwinkle seals the opening with his fingertip and swiftly tilts the bottle over and back."
    n "Periwinkle verdeckt die Öffnung mit seiner Fingerspitze und kippt die Flasche schnell kopfüber und wieder zurück."

# game/script.rpy:1133
translate ger ch2_9dd67e5b:

    # w "Here..."
    w "Hier..."

# game/script.rpy:1134
translate ger ch2_f2f42b7a:

    # n "He lightly rubs a spot on Pastille's neck, engulfing them both in the pleasant scent of his magic."
    n "Er reibt eine Stelle an Pastilles Hals damit ein und der angenehme Duft seiner Magie hüllt beide ein."

# game/script.rpy:1136
translate ger ch2_56fbbf51:

    # n "Their eyes meet, neither of them daring to be the first to move."
    n "Ihre Blicke treffen sich. Keiner von beiden wagt den ersten Schritt."

# game/script.rpy:1137
translate ger ch2_054c8a20:

    # w "Hmm... maybe the aphrodisiac bit wasn't a lie after all?"
    w "Hmm... vielleicht war das mit dem Aphrodisiakum doch keine Lüge?"

# game/script.rpy:1139
translate ger ch2_f010b7c9:

    # n "Pastille breaks the spell, rushing forward with a sudden kiss."
    n "Pastille bricht den Zauber, indem er für einen plötzlichen Kuss nach vorne schnellt."

# game/script.rpy:1141
translate ger ch2_90f6a8aa:

    # n "...And then retreats just as quickly."
    n "...Und dann zieht er sich genauso schnell zurück."

# game/script.rpy:1144
translate ger ch2_e247d436:

    # p "Ah--um, sorry, I just--"
    p "Ah--ähm, sorry, ich hab nur--"

# game/script.rpy:1145
translate ger ch2_99717d55:

    # w pj yay "(He certainly is impulsive... not that I mind at all 💙)"
    w pj yay "(Er ist wirklich impulsiv... nicht dass mich das stört 💙)"

# game/script.rpy:1146
translate ger ch2_655f5b82:

    # w drool "(I'm more than happy to go along with your little game, Pastille...)"
    w drool "(Ich bin überaus erfreut, bei deinem kleinen Spielchen mitzuspielen, Pastille...)"

# game/script.rpy:1147
translate ger ch2_50096bca:

    # w shy "Ohh nooo~ my own magic is working too well~!"
    w shy "Ooh neeein~ meine eigene Magie funktioniert zu gut~!"

# game/script.rpy:1148
translate ger ch2_0bd2374d:

    # w teehee "I guess there's no choice but to have my way with you, my sweet 💙"
    w teehee "Ich glaube, ich habe keine andere Wahl als mit dir anzustellen, was ich will, mein Süßer 💙"

# game/script.rpy:1149
translate ger ch2_60a65ab5:

    # p dying "...O-oh nooo~"
    p dying "...O-oh neeein~"

# game/script.rpy:1153
translate ger ch2_de805c4f:

    # n "Pastille's halfhearted protests end there."
    n "Pastilles halbherziger Widerstand ist damit vorbei."

# game/script.rpy:1154
translate ger ch2_016f8419:

    # n "Periwinkle's hands were already upon him, and would continue to be for the rest of the night..."
    n "Periwinkles Hände lagen schon auf ihm und würden das auch noch die restliche Nacht tun..."

# game/script.rpy:1166
translate ger ch3_7b49a2da:

    # centered "{w=3}{nw}"
    centered "{w=3}{nw}"

# game/script.rpy:1173
translate ger ch3_7ed57a35:

    # "Over the next month or so, we fell into quite an enjoyable pattern."
    "In den nächsten paar Wochen sind wir in ein ziemlich angenehmes Muster verfallen."

# game/script.rpy:1174
translate ger ch3_4fb4a5d6:

    # "Pastille would show up at my doorstep maybe once or twice a week..."
    "Pastille stand so ein- oder zweimal die Woche vor der Tür..."

# game/script.rpy:1175
translate ger ch3_89332bf5:

    # "Sometimes we'd go out to dinner, but mostly he'd just spend the night 💙"
    "Manchmal sind wir abends ausgegangen, aber meistens hat er die Nacht hier verbracht 💙"

# game/script.rpy:1176
translate ger ch3_ea2c2997:

    # nvl clear
    # "It was starting to become almost routine--though each visit was somehow just as exciting as the last~"
    nvl clear
    "Es war schon fast zur Routine geworden--wobei jeder weitere Besuch irgendwie genauso spannend war wie der letzte~"

# game/script.rpy:1178
translate ger ch3_e1acc37c:

    # "The details of which... I'll choose to keep private, for Pastille's sake. That boy is insatiable, I WILL say that! 💙"
    "Die Details dazu... behalte ich mal lieber für mich, Pastille zuliebe. Dieser Junge ist unersättlich, SO VIEL kann ich sagen! 💙"

# game/script.rpy:1179
translate ger ch3_2ae57261:

    # nvl clear
    # "Inevitably, after seeing someone for long enough, one begins to pick up on their habits..."
    nvl clear
    "Wenn man lange genug mit jemandem Zeit verbringt, fallen einem unweigerlich die Angewohnheiten des anderen auf..."

# game/script.rpy:1181
translate ger ch3_308c6522:

    # "Cute habits. Like the way he kisses me on the cheek before rushing off to work in the early morning."
    "Süße Angewohnheiten. Wie die Art, wie er mich auf die Wange küsst, bevor er am frühen Morgen zur Arbeit huscht."

# game/script.rpy:1182
translate ger ch3_f8c37e9b:

    # "The way he runs his hand through his hair when he's thinking really hard about something."
    "Die Art, wie er mit seiner Hand durch sein Haar fährt, wenn er sehr angestrengt über etwas nachdenkt."

# game/script.rpy:1183
translate ger ch3_7f9de784:

    # nvl clear
    # "Even his knock is specific--once, lightly, to test the waters. A pause, as he gathers his courage. Then three, firm and evenly-spaced."
    nvl clear
    "Sogar sein Klopfen ist speziell-einmal leicht, um die Lage zu checken. Eine Pause, in der er seinen Mut sammelt. Dann dreimal fest und gleichmäßig."

# game/script.rpy:1185
translate ger ch3_13949e8f:

    # "I'm not sure which of these habits he's conscious of, but there's one I've decided he MUST be acting knowingly..."
    "Ich bin nicht sicher, welche dieser Angewohnheiten ihm bewusst sind, aber da ist eine, die er bewusst machen MUSS..."

# game/script.rpy:1186
translate ger ch3_05e82852:

    # "Which is, his habit of leaving one of his personal effects behind with each visit."
    "Und zwar seine Angewohnheit, bei jedem Besuch einen seiner persönlichen Gegenstände zu hinterlassen."

# game/script.rpy:1187
translate ger ch3_a1186f11:

    # nvl clear
    # "First, a barrette. Then an earring. His choker, a bracelet..."
    nvl clear
    "Zuerst eine Haarspange. Dann einen Ohrring. Sein Halsband, einen Armreif..."

# game/script.rpy:1189
translate ger ch3_72eea756:

    # "And then he returns after a few days with an apology, explaining he had just come to pick up whatever he'd left behind."
    "Und dann kommt er ein paar Tage später mit der Ausrede, er sei nur gekommen, um abzuholen, was auch immer er vergessen hatte."

# game/script.rpy:1190
translate ger ch3_13faa860:

    # nvl clear
    # w pj calm "Sure, Pastille. Keep creating your little excuses to come back here... I'll happily go along with them."
    nvl clear
    w pj calm "Klar, Pastille. Lass dir nur immer weitere Vorwände einfallen, nochmal herzukommen... Ich spiele gern mit."

# game/script.rpy:1193
translate ger ch3_80258f58:

    # w happy "Hmhm, what fun! I wonder what he'll come looking for THIS time~?"
    w happy "Hmhm, was für ein Spaß! Ich frage mich, wonach er DIESMAL suchen wollen wird~?"

# game/script.rpy:1195
translate ger ch3_5245ed5c:

    # n "Periwinkle gathers up the discarded garments that had been left strewn across his bedroom, tossing them into a pile to be dealt with later."
    n "{size=-4}Periwinkle sammelt die ausgezogene Kleidung ein, die über sein ganzes Schlafzimmer verteilt lagen, und schmiss sie auf einen Haufen, um den er sich später kümmern würde."

# game/script.rpy:1197
translate ger ch3_57dc11fb:

    # w oh "He couldn't possibly leave his underwear behind, could he...?"
    w oh "Er würde doch wohl nicht seine Unterwäsche hinterlassen, oder...?"

# game/script.rpy:1198
translate ger ch3_2577a914:

    # w calm "No, that would be impossible to explain. An earring, sure, but there's no way he'd walk out of here like THAT..."
    w calm "Nein, das könnte er unmöglich erklären. Ein Ohrring, klar, aber er würde doch niemals SO rausgehen..."

# game/script.rpy:1200
translate ger ch3_b4f5ffdc:

    # n "Periwinkle hums to himself as he makes the bed, double-checking between the sheets while he's at it..."
    n "Periwinkle summt vor sich hin, während er das Bett macht und sichergeht, ob auch wirklich nichts zwischen den Laken liegt..."

# game/script.rpy:1202
translate ger ch3_a6272f66:

    # w pout "...Hm. I'm almost disappointed."
    w pout "...Hm. Ich bin fast enttäuscht."

# game/script.rpy:1203
translate ger ch3_8b7cde78:

    # w oh "It's been so consistent, up until now. I suppose he could just be THAT forgetful..."
    w oh "Es war so konsequent bis jetzt. Vielleicht war er doch einfach SO vergesslich..."

# game/script.rpy:1206
translate ger ch3_fcb994ab:

    # "Unable to find anything of Pastille's in my bedroom, I decide to spend the rest of the morning cleaning up the place."
    "Nachdem ich nichts von Pastille in meinem Schlafzimmer gefunden habe, entscheide ich mich, den restlichen Morgen hier aufzuräumen."

# game/script.rpy:1207
translate ger ch3_c3a58deb:

    # "Now, mind you, I never let my house get DIRTY... only messy."
    "Und hey, denk dran, ich lasse mein Haus nie SCHMUTZIG werden... nur unordentlich."

# game/script.rpy:1208
translate ger ch3_03008cfa:

    # "Leaving garbage or food waste about is out of the question."
    "Müll oder Essensreste liegen zu lassen steht außer Frage."

# game/script.rpy:1209
translate ger ch3_a4f20100:

    # "Everything else, though..."
    "Alles andere jedoch..."

# game/script.rpy:1210
translate ger ch3_1b81cc77:

    # nvl clear
    # "It's simply that many things don't make it back to their proper place. Or rather, I can never decide on a proper place for many of my things..."
    nvl clear
    "Es ist einfach so, dass viele Sachen nicht an ihren richtigen Platz zurückfinden. Oder eher, dass ich mich nie für einen richtigen Platz für viele meiner Sachen entscheiden kann..."

# game/script.rpy:1212
translate ger ch3_e63b1b71:

    # "Toss them into boxes, shuffle the boxes around the room, and suddenly they've become unmanageable piles..."
    "Schmeiß sie in Kisten, sortier die Kisten im Zimmer um, und auf einmal sind sie unhandhabbare Stapel..."

# game/script.rpy:1213
translate ger ch3_fc7696d4:

    # "To truly put everything away, these would all have to be emptied and sorted... a daunting task, to be sure!"
    "Um wirklich alles wegzuräumen, müssten sie alle geleert und sortiert werden... eine beängstigende Aufgabe!"

# game/script.rpy:1214
translate ger ch3_88c3865d:

    # nvl clear
    # "But it HAS been a while since my last attempt. I may as well put in some effort..."
    nvl clear
    "Doch mein letzter Versuch WAR schon lange her. Ich kann mir also doch mal wieder Mühe geben..."

# game/script.rpy:1216
translate ger ch3_c56eb4b7:

    # nvl clear
    # w pj oops "But where to begin...?"
    nvl clear
    w pj oops "Aber wo soll ich nur anfangen...?"

# game/script.rpy:1219
translate ger ch3_c9432365:

    # w oh "I suppose my work supplies have been a little difficult to navigate as of late."
    w oh "In letzter Zeit war es etwas schwierig, an mein Arbeitsmaterial zu kommen."

# game/script.rpy:1220
translate ger ch3_6288f7b0:

    # w innocent "That's an achievable goal now, isn't it? And practical, as well!"
    w innocent "Das ist doch mal ein erreichbares Ziel, oder? Und praktisch ist es auch!"

# game/script.rpy:1222
translate ger ch3_bd454459:

    # n "Periwinkle begins with the box of his favorite perfumes, that had been sitting out since one of Pastille's first visits."
    n "Periwinkle fängt mit den Kisten mit seinen Lieblingsparfums an, die seit Pastilles ersten Besuch unaufgeräumt herumstehen."

# game/script.rpy:1223
translate ger ch3_de62bb1c:

    # w drool "Ahh, yes... the \"aphrodisiac\"... hmhm, that was a fun night 💙"
    w drool "Aah, ja... das \"Aphrodisiakum\"... hmhm, das war eine spaßige Nacht 💙"

# game/script.rpy:1224
translate ger ch3_44f1f072:

    # n "He packs the bottles back into their places, then closes the box, sealing them safely inside."
    n "Er stellt die Flaschen zurück an ihre Plätze, dann schließt er die Kiste, um den Inhalt zu schützen."

# game/script.rpy:1226
translate ger ch3_eaaa499e:

    # w oh "This should go... hm, perhaps it'd be better to set it high on the bookshelf?"
    w oh "Das sollte gehen... hm, vielleicht wäre es besser, sie weiter oben ins Bücherregal zu stellen?"

# game/script.rpy:1227
translate ger ch3_316ce3eb:

    # w calm "If I just rearrange things a bit, there should be room for everything...."
    w calm "Wenn ich das ein bisschen umsortiere, sollte genug Platz für alles sein...."

# game/script.rpy:1229
translate ger ch3_7430db52:

    # n "As Periwinkle begins setting things aside, a new pile is born, precariously teetering on the back of the couch."
    n "Als Periwinkle anfängt, Dinge zur Seite zu stellen, erhebt sich ein neuer Stapel, der unsicher hinter der Couch hin und her wippt."

# game/script.rpy:1230
translate ger ch3_5cf41d37:

    # n "He places the box just where he wants it, and then stacks his various books and knickknacks around it."
    n "Er platziert die Kiste dort, wo er sie haben will und stapelt dann verschiedene Bücher und Nippes drumherum."

# game/script.rpy:1231
translate ger ch3_fcaff70c:

    # n "Just as he's made his way through half of the pile, a small portion of it topples forward, bouncing safely onto the couch cushions."
    n "Gerade als er sich durch den halben Stapel gearbeitet hatte, kippt ein Teil davon nach vorne und landet auf den Couchkissen."

# game/script.rpy:1232
translate ger ch3_37943611:

    # w smile "Ha! Topple all you want. I was prepared..."
    w smile "Ha! Kippt um, so viel ihr wollt. Ich war vorbereitet..."

# game/script.rpy:1233
translate ger ch3_6bb6158a:

    # w oh "...Hm?"
    w oh "...Hm?"

# game/script.rpy:1236
translate ger ch3_04349ffb:

    # n "He finally notices Pastille's jacket, which had expertly blended into the blankets and cushions around it."
    n "Endlich entdeckt er Pastilles Jacke, die geschickt mit den umliegenden Decken und Kissen verschmolzen war."

# game/script.rpy:1237
translate ger ch3_b6d5bbbe:

    # w happy "Aha! Just when I'd finally worked up the energy to clean up around here, what do I find?"
    w happy "Aha! Gerade als ich endlich die Energie aufgebracht habe hier aufzuräumen, finde ich so was?"

# game/script.rpy:1238
translate ger ch3_e82a855f:

    # w shy "Yes, this is no mere case of forgetfulness... it was indeed a little game all along!"
    w shy "Jap, das ist kein einfacher Fall von Vergesslichkeit... es war tatsächlich die ganze Zeit ein kleines Spiel!"

# game/script.rpy:1240
translate ger ch3_1da6cefd:

    # n "Periwinkle giddily laughs to himself, excited to have been proven right."
    n "Periwinkle lachte erfreut in sich hinein, aufgeregt vom Fakt, dass er Recht behalten hatte."

# game/script.rpy:1243
translate ger ch3_4aed7301:

    # w love "You've escalated it too far, Pastille! To leave your jacket behind is just ridiculous 💙"
    w love "Du hast es zu weit getrieben, Pastille! Seine Jacke zu vergessen ist einfach nur lächerlich 💙"

# game/script.rpy:1244
translate ger ch3_ac8d902a:

    # w teehee "He leaves me no choice! I'll just have to return this myself~"
    w teehee "Er lässt mir keine Wahl! Ich werd' sie wohl selbst zurückgeben müssen~"

# game/script.rpy:1245
translate ger ch3_6f0e85f3:

    # n "Periwinkle abandons what he was doing, and skips off to his room to get dressed."
    n "Periwinkle gibt auf, was er gerade tat und hüpft in sein Zimmer, um sich anzuziehen."

# game/script.rpy:1257
translate ger ch3_3eb32547:

    # "I hadn't had a chance to return to Atelier Sweets since first meeting Pastille."
    "Ich hatte seit dem ersten Treffen mit Pastille nie die Möglichkeit, nochmal zum Atelier Sweets zu gehen."

# game/script.rpy:1258
translate ger ch3_88f3e23d:

    # "He was the one always showing up on MY doorstep, after all. There was no need."
    "Er war eben immer derjenige, der auf MEINER Türschwelle aufgetaucht ist. Ich musste nie hin."

# game/script.rpy:1259
translate ger ch3_928953dd:

    # "It's about time I paid him a visit, yes? I could restock on my favorite candies as well 💙"
    "Es war wohl an der Zeit, ihm einen Besuch abzustatten, oder? Ich könnte auch meine Lieblingssüßigkeiten wieder auffüllen 💙"

# game/script.rpy:1260
translate ger ch3_76b2fe88:

    # nvl clear
    nvl clear

# game/script.rpy:1263
translate ger ch3_8dc899ac:

    # "Upon reaching Atelier Sweets, though, I hesitate."
    "Als ich das Atelier Sweets erreiche, zögere ich aber doch."

# game/script.rpy:1264
translate ger ch3_803e31e4:

    # "Would it be rude to barge in while he's working? I just know I wouldn't be able to resist teasing him..."
    "Wäre es unhöflich, einfach so hereinzuplatzen, während er arbeitet? Ich weiß einfach, ich könnte nicht widerstehen, ihn zu necken..."

# game/script.rpy:1265
translate ger ch3_e56c2f10:

    # "Hm. As to not become a nuisance, I shall make my presence known from here!"
    "Hm. Um ihm keine Unannehmlichkeiten zu bereiten, sollte ich ihm von hier aus klarmachen, dass ich da bin!"

# game/script.rpy:1266
translate ger ch3_d6ac3282:

    # nvl clear
    # n "Periwinkle boldly approaches the bench directly in front of the candy shop, and sits down..."
    nvl clear
    n "Auffallend nähert sich Periwinkle der Sitzbank direkt vor dem Laden und setzt sich hin..."

# game/script.rpy:1269
translate ger ch3_d2fc93d8:

    # n "...all while wearing Pastille's \"forgotten\" jacket."
    n "...und all das, während er Pastilles \"vergessene\" Jacke trägt."

# game/script.rpy:1271
translate ger ch3_8cd95367:

    # w jacket calm "(And now, we wait 💙)"
    w jacket calm "(Und jetzt warten wir 💙)"

# game/script.rpy:1273
translate ger ch3_62dbec77:

    # "A few minutes pass."
    "Ein paar Minuten vergehen."

# game/script.rpy:1274
translate ger ch3_5822edc0:

    # "I can see Pastille through the shop window... he's currently preoccupied with a customer."
    "Ich kann Pastille durch die Ladenfenster sehen... er ist gerade mit einem Kunden beschäftigt."

# game/script.rpy:1275
translate ger ch3_ae539d34:

    # "Luckily, I brought a lunch 💙 A simple peanut butter and jelly sandwich."
    "Zum Glück hab' ich was zu essen dabei 💙 Ein einfaches Erdnussbutter-Marmeladen-Sandwich."

# game/script.rpy:1276
translate ger ch3_51d176a4:

    # "Hmhm, will he notice me before I finish it? The customer is walking out now..."
    "Hmhm, wird er mich bemerken, bevor ich damit fertig bin? Der Kunde geht jetzt raus..."

# game/script.rpy:1277
translate ger ch3_e963a0d1:

    # nvl clear
    # w jacket shy "(...Ah! Our eyes met 💙)"
    nvl clear
    w jacket shy "(...Ah! Unsere Blicke haben sich getroffen 💙)"

# game/script.rpy:1281
translate ger ch3_7d91d129:

    # "Pastille turns away, pacing a bit. I take another bite of my sandwich, still watching intently..."
    "Pastille dreht sich weg, schreitet ein bisschen. Ich beiße nochmal in mein Sandwich und schaue ihm angespannt zu..."

# game/script.rpy:1282
translate ger ch3_83d21bc8:

    # "He stops for a moment, in front of the door behind the register... until finally making his way out of the store, broom in hand."
    "Er hält hinter dem Tresen vor der Tür einen Moment an... bis er endlich mit Besen in der Hand nach draußen geht."

# game/script.rpy:1283
translate ger ch3_5f582295:

    # nvl clear
    # "But instead of coming over right away, he turns his back to me, sweeping the sidewalk in front of the entrance."
    nvl clear
    "Doch anstatt direkt hierher zu kommen, dreht er mir den Rücken zu und kehrt den Bürgersteig vor dem Eingang."

# game/script.rpy:1285
translate ger ch3_07c4f7e6:

    # "Perhaps he has a strict supervisor?"
    "Vielleicht hat er eine strenge Vorgesetzte?"

# game/script.rpy:1286
translate ger ch3_e8ccb9c2:

    # "Ah, he keeps glancing over his shoulder..."
    "Ah, er blickt ständig über seine Schulter..."

# game/script.rpy:1287
translate ger ch3_3f34efc0:

    # nvl clear
    # w jacket smile "(Just come over here, you silly boy...)"
    nvl clear
    w jacket smile "(Komm' einfach her, du alberner Junge...)"

# game/script.rpy:1291
translate ger ch3_07af808c:

    # "His face is quite red, so I can say with confidence that I've successfully overwhelmed him once again."
    "Sein Gesicht ist ziemlich rot, ich kann also mit Bestimmtheit sagen, dass ich ihn mal wieder erfolgreich überrumpelt hab."

# game/script.rpy:1292
translate ger ch3_3bd910eb:

    # "I've finished my sandwich by the time he approaches. He takes a seat on the opposite end of the bench."
    "Als er sich nähert, habe ich mein Sandwich schon aufgegessen. Er nimmt am anderen Ende der Bank Platz."

# game/script.rpy:1293
translate ger ch3_76b2fe88_1:

    # nvl clear
    nvl clear

# game/script.rpy:1296
translate ger ch3_3c3d8923:

    # w jacket happy "Hmhm, I thought you were ignoring me~"
    w jacket happy "Hmhm, ich dachte, du würdest mich ignorieren~"

# game/script.rpy:1297
translate ger ch3_421ea304:

    # p omgstop "N-no, I was just trying to decide what to do."
    p omgstop "N-nein, ich hab nur überlegt, was ich tun soll."

# game/script.rpy:1298
translate ger ch3_c04a6356:

    # w calm "Was this a bad time to return your jacket?"
    w calm "War das ein schlechter Zeitpunkt, deine Jacke zurückzugeben?"

# game/script.rpy:1299
translate ger ch3_04cd4412:

    # p shy "Not the WORST time...."
    p shy "Nicht die SCHLECHTESTE Zeit...."

# game/script.rpy:1300
translate ger ch3_4488af6d:

    # w smile "Hm~?"
    w smile "Hm~?"

# game/script.rpy:1304
translate ger ch3_f83add27:

    # n "Periwinkle unzips the jacket and shuffles out of it, casually folding it onto his lap."
    n "Periwinkle öffnet die Jacke und zieht sie aus, faltet sie beiläufig und legt sie auf seinen Schoß."

# game/script.rpy:1306
translate ger ch3_d9929887:

    # w cute smile "I found it whilst I was cleaning up the place."
    w cute smile "Ich habe sie gefunden, während ich aufgeräumt hatte."

# game/script.rpy:1307
translate ger ch3_83944680:

    # w calm "I suppose I could've waited for you to return, but since I was in the area..."
    w calm "Ich nehme an, ich hätte einfach warten können, bis du kommen würdest, aber weil ich eh in der Gegend war..."

# game/script.rpy:1308
translate ger ch3_41a02a3a:

    # p ehe2 "R-right... sorry, it's my fault for leaving it behind in the first place."
    p ehe2 "K-klar... sorry, es war mein Fehler, sie überhaupt dort liegen gelassen zu haben."

# game/script.rpy:1311
translate ger ch3_b8eb6db7:

    # "Pastille can barely look me in the eye."
    "Pastille kann mir kaum in die Augen schauen."

# game/script.rpy:1312
translate ger ch3_c5dbde65:

    # "It doesn't stop him from stealing glances at what I'm wearing..."
    "Was ihn nicht davon abhält, flüchtige Blicke auf meine Kleidung zu werfen..."

# game/script.rpy:1313
translate ger ch3_2d3465a6:

    # "But who could resist that? I wore my cutest dress for this."
    "Aber wer könnte auch widerstehen? Ich trug mein schönstes Kleid hierfür."

# game/script.rpy:1314
translate ger ch3_7a7605c3:

    # nvl clear
    # "Something seems a little off, though..."
    nvl clear
    "Aber irgendwas scheint nicht ganz zu stimmen..."

# game/script.rpy:1316
translate ger ch3_3b5bce35:

    # "He's usually a bundle of nerves, yes, but this is a bit much."
    "Er ist immer ein Nervenbündel, ja, aber das ist etwas viel."

# game/script.rpy:1317
translate ger ch3_949ca487:

    # "I'll get right to the point, then..."
    "Dann werd' ich mal direkt zum Punkt kommen..."

# game/script.rpy:1318
translate ger ch3_76b2fe88_2:

    # nvl clear
    nvl clear

# game/script.rpy:1322
translate ger ch3_3a7b6288:

    # w cute happy "Oh, Pastille. You know you don't have to plant excuses just to visit me~"
    w cute happy "Oh, Pastille. Du weißt, du brauchst nichts bei mir hinterlegen, nur um einen Vorwand zu haben, mich zu besuchen~"

# game/script.rpy:1323
translate ger ch3_3cd8d13c:

    # p "I-I wasn't... planting anything. I just forgot it on my way out."
    p "I-ich hab nichts... hinterlegt. Ich hab sie einfach beim Rausgehen vergessen."

# game/script.rpy:1324
translate ger ch3_528b5cc1:

    # w innocent "I find that hard to believe, considering you've forgotten exactly one thing each time you visit 💙 Really, you should be more honest!"
    w innocent "Schwer zu glauben, wenn man bedenkt, dass du bei jedem Besuch exakt eine Sache vergessen hast 💙"
    w "Wirklich, du solltest ehrlicher sein!"

# game/script.rpy:1325
translate ger ch3_c631c321:

    # p "...Sorry. Thank you, for returning it."
    p "...Sorry. Danke fürs Zurückbringen."

# game/script.rpy:1326
translate ger ch3_4428d35a:

    # w teehee "Oh, it's my pleasure 💙 It gave ME a good excuse to see your flustered little face again!"
    w teehee "Oh, es war mir eine Freude 💙 Dadurch hatte ICH einen Vorwand, dein nervöses Gesicht wiederzusehen!"

# game/script.rpy:1329
translate ger ch3_4f12e620:

    # n "Periwinkle sets the jacket on the empty space between them, and rises to take his leave..."
    n "Periwinkle legt die Jacke an die leere Stelle zwischen ihnen und steht auf, um zu gehen..."

# game/script.rpy:1330
translate ger ch3_c9072ea6:

    # n "But Pastille gently grasps his wrist before he goes."
    n "Aber Pastille ergreift sanft sein Handgelenk, bevor er geht."

# game/script.rpy:1333
translate ger ch3_4b4c0e76:

    # p ohno2 "Peri. I'm, um... Sorry I made you think I was ignoring you."
    p ohno2 "Peri. Ich, ähm... Sorry, dass ich dich denken lassen hab, ich würde dich ignorieren."

# game/script.rpy:1334
translate ger ch3_746feb0b:

    # w cute guilty "Hmhm, I was only teasing, my sweet..."
    w cute guilty "Hmhm, ich hab dich nur geärgert, mein Süßer..."

# game/script.rpy:1335
translate ger ch3_364bac5b:

    # p nervous "Still. I can't, um... I'm not ready to be open about who I see outside of work."
    p nervous "Trotzdem. Ich kann nicht, ähm... Ich bin noch nicht bereit, offen damit umzugehen, wen ich außerhalb der Arbeit treffe."

# game/script.rpy:1336
translate ger ch3_b4a86c3f:

    # p flustered2 "I like to keep things VERY discreet--I don't want to have to explain anything to my friends. I'd die of embarrassment."
    p flustered2 "Ich halte Dinge gern SEHR diskret--ich will meinen Freunden nichts erklären müssen. Ich würde vor Scham sterben."

# game/script.rpy:1337
translate ger ch3_af748ba9:

    # w neutral "(So that's why...)"
    w neutral "(Deshalb also...)"

# game/script.rpy:1338
translate ger ch3_a218c7e9:

    # w calm "Understood 💙 I'm actually used to being someone's little secret--"
    w calm "Verstanden 💙 Ich bin es tatsächlich gewohnt, jemandes kleines Geheimnis zu sein--"

# game/script.rpy:1339
translate ger ch3_eda2d17a:

    # w neutral "...Hm, that didn't sound quite right."
    w neutral "...Hm, das klang irgendwie nicht ganz richtig."

# game/script.rpy:1340
translate ger ch3_0c3f8324:

    # w guilty "What I'm trying to say is, I don't mind at all! From now on, I'll just continue to let you come to me 💙"
    w guilty "Was ich eigentlich sagen will, ist, es macht mir wirklich nichts aus! Ab jetzt lass ich dich einfach wieder zu mir kommen 💙"

# game/script.rpy:1341
translate ger ch3_a683dc07:

    # p nervous "Th-thank you... sorry."
    p nervous "Da-danke... sorry."

# game/script.rpy:1342
translate ger ch3_3eba0b21:

    # w smile "I don't know what you keep apologizing for, Pastille. I'll see you around, yes?"
    w smile "Ich weiß nicht, wofür du dich ständig entschuldigst, Pastille. Ich seh dich dann, ja?"

# game/script.rpy:1344
translate ger ch3_c525b41f:

    # n "Pastille nods... and finally lets go of his wrist."
    n "Pastille nickt... und lässt schließlich sein Handgelenk los."

# game/script.rpy:1347
translate ger ch3_60877f15:

    # "A misstep."
    "Ein Fehltritt."

# game/script.rpy:1348
translate ger ch3_0850fd13:

    # "A HUGE misstep..."
    "Ein RIESIGER Fehltritt..."

# game/script.rpy:1349
translate ger ch3_12ede38d:

    # "I should've guessed it, from the hints he's given--just a few things he's said here and there."
    "Ich hätte es durch seine Hinweise erahnen müssen--ein paar Dinge, die er hier und da gesagt hatte."

# game/script.rpy:1350
translate ger ch3_7808934e:

    # "It was enough to put it together, wasn't it?"
    "Es war genug, um eins und eins zusammenzuzählen, oder?"

# game/script.rpy:1351
translate ger ch3_b3bd1b1f:

    # "The most obvious one being that he always comes to me, and not the other way around."
    "Der Offensichtlichste war wohl, dass er immer nur zu mir kam, und nicht andersherum."

# game/script.rpy:1352
translate ger ch3_938f9378:

    # nvl clear
    # "Our comfortable pattern, that I recklessly interrupted..."
    nvl clear
    "Unser gemütliches Muster, das ich rücksichtslos unterbrochen habe..."

# game/script.rpy:1354
translate ger ch3_ec8d7b96:

    # "I should've known, from previous encounters with closeted individuals."
    "Ich hätte es wissen müssen. Von früheren Begegnungen mit verkappten Individuen."

# game/script.rpy:1355
translate ger ch3_de6c6bc1:

    # nvl clear
    # "What's supposed to be a fun, surprise appearance can turn so quickly into a desperate rally to cling to normalcy, carefully constructed lies to conceal the piece of yourself that may not be accepted..."
    nvl clear
    "Was eigentlich eine spaßige, überraschende Erscheinung sein soll, kann so schnell zu einem verzweifelten Festhalten an Normalität führen, zu sorgfältig konstruierten Lügen, um den Teil seiner Selbst zu verschleiern, der vielleicht nicht akzeptiert würde..."

# game/script.rpy:1357
translate ger ch3_21ce2d92:

    # "...whether it's by the individual themself, or by their loved ones."
    "...ob es von der Person selbst ist oder von ihr Nahestehenden."

# game/script.rpy:1358
translate ger ch3_b4dd5416:

    # "Certainly an unenviable position to find oneself in."
    "Auf jeden Fall keine zu beneidende Situation."

# game/script.rpy:1359
translate ger ch3_13b8ccf7:

    # nvl clear
    # "Pastille and I had been seeing a lot of each other during this past month. Was this the inevitable breaking point, then?"
    nvl clear
    "Pastille und ich hatten den vergangenen Monat über viel von uns gesehen. War dies jetzt der unausweichliche Bruchpunkt?"

# game/script.rpy:1361
translate ger ch3_6c9c44e5:

    # "It can only become more complicated from here..."
    "Von hier an kann es nur noch komplizierter werden..."

# game/script.rpy:1362
translate ger ch3_c8a0c4e8:

    # "Ah, but it was going so perfectly for so long! Perhaps I'm being overdramatic..."
    "Ah, aber es lief doch so lange so perfekt! Vielleicht bin ich auch überdramatisch..."

# game/script.rpy:1363
translate ger ch3_e10ad652:

    # "I haven't grown tired of him at all... which is precisely the problem."
    "Ich hab immer noch überhaupt nicht genug von ihm... was eben genau das Problem ist."

# game/script.rpy:1364
translate ger ch3_454f79c8:

    # nvl clear
    # "Unwilling to return home so soon, I walk in the direction of the apothecary."
    nvl clear
    "Ungewillt, so früh nach Hause zu gehen, laufe ich in Richtung der Apotheke."

# game/script.rpy:1366
translate ger ch3_3454f89c:

    # "Astragalus will be able to knock some sense in me. She always does."
    "Astragalus wird in der Lage sein, mir wieder etwas Vernunft einzutrichtern. Das schafft sie immer."

# game/script.rpy:1367
translate ger ch3_76b2fe88_3:

    # nvl clear
    nvl clear

# game/script.rpy:1376
translate ger ch3_91bceeeb:

