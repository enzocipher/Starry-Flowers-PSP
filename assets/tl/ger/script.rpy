translate ger ch3_28a5e162:

    # a neutral "If you wanna avoid things getting complicated, this is your sign to get out."
    a neutral "Wenn du verhindern willst, dass die Dinge kompliziert werden, dann ist das dein Zeichen für den Ausstieg."

# game/script.rpy:1397
translate ger ch3_5e7d2a22:

    # a lol "I gotta say, though... for two guys who AREN'T in a committed relationship, you sure do sound like you're in one."
    a lol "Ich muss schon wirklich sagen... für zwei Typen, die NICHT in einer festen Beziehung sind, klingt es aber voll so."

# game/script.rpy:1398
translate ger ch3_aa0b0ee9:

    # w pout "It's purely casual. I've still been seeing a few others in the midst of this!"
    w pout "Es ist nur was Lockeres. Ich habe trotzdem zwischenzeitlich auch andere getroffen!"

# game/script.rpy:1399
translate ger ch3_382e4d30:

    # a sure "Buuut all you talk about is Pastille. Every time you come in here--"
    a sure "Aaaber du redest immer nur von Pastille. Jedes Mal, wenn du hier bist--"

# game/script.rpy:1400
translate ger ch3_e8d058af:

