    # k smile "So! What ARE you here for, if not the witches?"
    k smile "Also! Nach WAS hältst du denn Ausschau, wenn nicht nach Hexen?"

# game/script.rpy:1514
translate ger ch3_f5eef97f:

    # w innocent "I had intended to find someone to spoil me... and incubi are rumored to be good for exactly that 💙"
    w innocent "Ich hatte vor, jemanden zu finden, der mich verwöhnt... und Inkubi sind genau dafür bekannt, heißt es 💙"

# game/script.rpy:1515
translate ger ch3_513f012e:

    # k shy "We are, we are..."
    k shy "Sind wir, sind wir..."

# game/script.rpy:1516
translate ger ch3_19ddae00:

    # w my "So the rumors are true~? I'm in luck, then!"
    w my "Es stimmt also~? Dann hab ich ja Glück!"

# game/script.rpy:1517
translate ger ch3_f89607ce:

    # w teehee "Would you happen to have any friends who would be interested in dancing with a cute little witch like me~?"
    w teehee "Hast du zufällig Freunde, die daran interessiert wären, mit einer süßen kleinen Hexe wie mir zu tanzen~?"

# game/script.rpy:1518
translate ger ch3_6d7a44bf:

    # k "Hmmmmmmm... I could ask around."
    k "Hmmmmmm... Ich könnte mal rumfragen."

# game/script.rpy:1519
translate ger ch3_5efc4a86:

    # k smile "Or! Better idea. You could just settle for me?"
    k smile "Oder! Bessere Idee. Du könntest einfach mit mir tanzen?"

# game/script.rpy:1520
translate ger ch3_c9017794:

    # w calm "Hmhm, I suppose you'll do 💙"
    w calm "Hmhm, ich denke, das könnte ich 💙"

# game/script.rpy:1523
translate ger ch3_50b7709f:

    # "I present my hand, and Kardaemon gives an exaggerated bow."
    "Ich präsentiere meine Hand und Kardaemon macht eine überspitzte Verbeugung."

# game/script.rpy:1524
translate ger ch3_084b6170:

    # "He pulls me in, albeit a little clumsily, with his gigantic demon hands. Always enjoyable to be swept up in the arms of a larger man 💙"
    "Er zieht mich mit seinen gigantischen Dämonenhänden heran, wenn auch etwas ungeschickt. Es macht mir immer eine Freude, von einem größeren Mann auf Händen getragen zu werden 💙"

# game/script.rpy:1525
translate ger ch3_272b335d:

    # "My own hand is almost entirely consumed by his. Unlike with Pastille's, which fit so--"
    "Meine eigene Hand verschwindet fast vollständig in seiner. Im Gegensatz zu Pastilles, welche so--"

# game/script.rpy:1526
translate ger ch3_36f5d814:

    # nvl clear
    # "...Pastille?"
    nvl clear
    "...Pastille?"

# game/script.rpy:1528
translate ger ch3_bd6489c5:

    # "Am I STILL comparing everyone to him?"
    "Vergleiche ich IMMER NOCH jeden mit ihm?"

# game/script.rpy:1529
translate ger ch3_c405272e:

    # "I shake the thought and return to the moment..."
    "Ich schüttele den Gedanken ab und kehre in diesen Moment zurück..."

# game/script.rpy:1530
translate ger ch3_76b2fe88_5:

    # nvl clear
    nvl clear

# game/script.rpy:1533
translate ger ch3_4dfd153d:

    # n "The pair twirls around the dance floor, losing themselves in the music."
    n "Das Paar wirbelt über die Tanzfläche, sich völlig in der Musik verlierend."

# game/script.rpy:1534
translate ger ch3_17b0a74e:

    # n "After a while, Kardaemon suddenly speaks up."
    n "Nach einer Weile fängt Kardaemon auf einmal an zu sprechen."

# game/script.rpy:1535
translate ger ch3_122eb838:

    # k "...OH! I think I just realized where I know you from!"
    k "...OH! Ich denke, mir ist gerade eingefallen, woher ich dich kenne!"

# game/script.rpy:1536
translate ger ch3_5a8eabf4:

    # w love "Really, now?"
    w love "Echt, jetzt?"

# game/script.rpy:1537
translate ger ch3_5ae9085a:

    # k "Yeah, you were in the magazine I work for!"
    k "Ja, du warst in dem Magazin, für das ich arbeite!"

# game/script.rpy:1538
translate ger ch3_a784e394:

    # k "I'm an editor. We used your photos for an issue a couple years back."
    k "Ich bin Redakteur. Wir haben für eine Ausgabe von vor ein paar Jahren deine Fotos benutzt."

# game/script.rpy:1539
translate ger ch3_efcb9510:

    # w oh "Ah... what a coincidence. I DID used to do some modeling, in the past..."
    w oh "Ah... was für ein Zufall. Ich HABE mal gemodelt. In der Vergangenheit.."

# game/script.rpy:1540
translate ger ch3_07b8e242:

    # w calm "And in the past it shall remain. I'm in a different line of work now."
    w calm "Und dort soll es auch bleiben. Ich bin jetzt in einem anderen Bereich tätig."

# game/script.rpy:1541
translate ger ch3_e86cb7f9:

    # k "Aww, really? That's too bad. I always thought you looked amazing."
    k "Aww, echt? Das ist sehr schade. Ich fand schon immer, dass du fantastisch aussiehst."

# game/script.rpy:1542
translate ger ch3_014598d5:

    # w smile "Hmhm, I appreciate that 💙"
    w smile "Hmhm, das freut mich 💙"

# game/script.rpy:1545
translate ger ch3_eac59ccf:

    # w neutral "(Well this certainly complicates things... I'd much prefer to have been complete strangers.)"
    w neutral "(Nun, das verkompliziert die Dinge etwas... Mir wäre es lieber gewesen, wir wären uns völlig fremd.)"

# game/script.rpy:1546
translate ger ch3_54236a36:

    # w decline "(How unfortunate... just when I was beginning to enjoy myself.)"
    w decline "(Wie unglücklich... gerade als ich angefangen habe, mich zu amüsieren.)"

# game/script.rpy:1549
translate ger ch3_7c244efe:

    # k "Haha, wow, I can't believe I ran into you like this. Maybe it's a sign...?"
    k "Haha, wow. Ich kann nicht glauben, dass wir so aufeinandertreffen. Vielleicht ist das ein Zeichen...?"

# game/script.rpy:1550
translate ger ch3_f26130c5:

    # w smile "A sign? Of what, dare I ask?"
    w smile "Ein Zeichen? Wofür, wenn ich fragen darf?"

# game/script.rpy:1551
translate ger ch3_41d59cda:

    # k smile "That you should come back to modeling! I can get you in our magazine again--if you're interested, that is."
    k smile "Dass du zum Modeln zurückkehren solltest! Ich kann dich wieder in unser Magazin bringen--Wenn du denn Interesse hast, natürlich."

# game/script.rpy:1552
translate ger ch3_24632a00:

    # w guilty "I appreciate the offer, but I've moved on. It put too much of a strain on my relationship with fashion, among other things..."
    w guilty "{size=-2}Ich schätze das Angebot, aber das lass ich hinter mir. Ich habe, unter anderem, zu viel Druck auf meine Beziehung zu Mode ausgeübt..."

# game/script.rpy:1553
translate ger ch3_9bbf2611:

    # k shy "Ah... well, at least take my card! In case you change your mind."
    k shy "Ah... nun, nimm wenigstens meine Visitenkarte! Für den Fall, dass du deine Meinung änderst."

# game/script.rpy:1554
translate ger ch3_1ae6e450:

    # w calm "No thank you. I don't see that happening."
    w calm "Nein, danke. Das wird nicht passieren."

# game/script.rpy:1555
translate ger ch3_12306026:

    # k laugh "Aww, come on... you'd be so great! It feels like such a waste of talent...."
    k laugh "Aww, komm schon... du wärst so großartig! Es wäre echt eine Verschwendung von Talent...."

# game/script.rpy:1556
translate ger ch3_51eac4d1:

    # w neutral "(Hm... I'm quickly growing tired of this.)"
    w neutral "(Hm... mir wird das gerade echt schnell zu blöd.)"

# game/script.rpy:1557
translate ger ch3_c4d486cb:

    # w smile "Thank you for the dance... but I really should be going now."
    w smile "Danke für den Tanz... aber ich sollte jetzt wirklich gehen."

# game/script.rpy:1558
translate ger ch3_33e9643f:

    # k huh "Huh? Ah, uh... sure."
    k huh "Hä? Ah, ähm... klar."

# game/script.rpy:1559
translate ger ch3_b30b1ced:

    # w innocent "This was fun. Perhaps we'll meet again sometime 💙"
    w innocent "Es hat Spaß gemacht. Vielleicht sehen wir uns mal wieder 💙"

# game/script.rpy:1560
translate ger ch3_0d5df227:

    # k sad "Y-yeah...."
    k sad "J-ja...."

# game/script.rpy:1567
translate ger ch3_ef15a56c:

    # "I didn't expect to be reminded of my modeling days of all things..."
    "Ich hatte nicht erwartet, ausgerechnet an meine Tage als Model erinnert zu werden..."

# game/script.rpy:1568
translate ger ch3_bad021ca:

    # "Although his excitement was understandable, the way he went about it certainly ruined the mood."
    "Obwohl seine Aufregung verständlich war, hat die Art, wie er damit umgegangen ist, die Stimmung verdorben."

# game/script.rpy:1569
translate ger ch3_72a95f04:

    # "I hate to admit it, but I'd gone into this night far too unstable to begin with. For such a small thing to get to me..."
    "Ich geb es ungern zu, aber ich bin von vornherein zu instabil in diesen Abend gestartet. Wenn mich so eine Kleinigkeit schon stört..."

# game/script.rpy:1570
translate ger ch3_5ad7ada1:

    # nvl clear
    # "I'm not even here on my own terms, am I?"
    nvl clear
    "Ich bin nicht mal wegen mir selbst hier, oder?"

# game/script.rpy:1572
translate ger ch3_2f4d44d7:

    # "This was all to prove a point. That's certainly not in the spirit of a friendly soirée..."
    "Das war nur, um einen Punkt klarzustellen. Das ist sicher nicht die richtige Einstellung für eine so nette Feier..."

# game/script.rpy:1573
translate ger ch3_d4b47508:

    # "It's best I just return home and--"
    "Es ist wohl das Beste, nach Hause zu gehen und--"

# game/script.rpy:1574
translate ger ch3_f36f833e:

    # nvl clear
    # k "Periwinkle, wait!"
    nvl clear
    k "Periwinkle, warte!"

# game/script.rpy:1577
translate ger ch3_f6a6af3b:

    # n "He turns his head to find that Kardaemon has chased after him, stumbling into the lonely night air."
    n "Er dreht seinen Kopf, um zu sehen, wie Kardaemon ihm nachgelaufen kommt und in die einsame Nachtluft stolpert."

# game/script.rpy:1579
translate ger ch3_29be8e4a:

    # k "Hey--I, uh... I'm sorry if I said anything to upset you."
    k "Hey--Es, ähm... es tut mir leid, wenn ich dich irgendwie beleidigt hab."

# game/script.rpy:1580
translate ger ch3_63733355:

    # w oh "...Upset me? Perish the thought!"
    w oh "...Mich beleidigt? Weg mit dem Gedanken!"

# game/script.rpy:1581
translate ger ch3_7415dc79:

    # w guilty "It's simply that I'm feeling a little off tonight. I realized I may have come here for the wrong reasons..."
    w guilty "Es ist einfach nur, dass ich mich heute etwas daneben fühle. Ich hab erkannt, dass ich wohl aus den falschen Gründen herkam..."

# game/script.rpy:1582
translate ger ch3_5567e155:

    # k pls "Look... I'm sorry that I suddenly started talking about work. That wasn't why I approached you at all."
    k pls "Schau mal... Es tut mir leid, dass ich auf einmal über Arbeit geredet hab. Deshalb hatte ich dich nicht angesprochen."

# game/script.rpy:1583
translate ger ch3_01a63751:

    # k sorry "You came here for a good time, right? Well, a party's definitely the place to find it!"
    k sorry "Du kamst für eine gute Zeit hierher, stimmt's? Nun, auf einer Party wirst du diese sicher finden!"

# game/script.rpy:1584
translate ger ch3_1e7ddd47:

    # k lookoff "Heck, it's what I'M here for, too... so, you're not wrong to come looking for that."
    k lookoff "Verdammt, dafür bin ICH doch auch hier... also ist es nicht falsch, dafür herzukommen."

# game/script.rpy:1585
translate ger ch3_3219922b:

    # w neutral "(He's completely misread the situation... Although, it IS starting to look salvageable from here.)"
    w neutral "(Er hat es komplett falsch interpretiert... Obwohl, da KÖNNTE doch noch was gerettet werden.)"

# game/script.rpy:1586
translate ger ch3_07c62861:

    # k sorry "Anyway, please forget about the magazine stuff--it doesn't matter. We were having fun before that right?"
    k sorry "Wie auch immer, bitte vergiss diesen Magazinkram--das ist egal. Davor hatten wir doch Spaß, oder?"

# game/script.rpy:1587
translate ger ch3_88dfd8df:

    # w calm "Dancing was nice, yes..."
    w calm "Tanzen war schön, ja..."

# game/script.rpy:1588
translate ger ch3_0e1aab5c:

    # k sad "I-I wanna do more than just dance with you."
    k sad "I-ich will mehr mit dir machen als nur tanzen."

# game/script.rpy:1589
translate ger ch3_80ca340f:

    # w drool "(Oho, there it is~ Now we're getting somewhere.)"
    w drool "(Oho, da ist es~ Jetzt nehmen wir wieder an Fahrt auf.)"

# game/script.rpy:1590
translate ger ch3_26564ac5:

    # w shy "More than dance? And what could that mean~?"
    w shy "Mehr als tanzen? Was meinst du denn bloß damit~?"

# game/script.rpy:1591
translate ger ch3_107e0d19:

    # k shy "Hah, well, don't make me spell it out..."
    k shy "Hah, nun, muss ich das wirklich aussprechen..."

# game/script.rpy:1592
translate ger ch3_70331591:

    # w smile "A kiss, perhaps?"
    w smile "Ein Kuss, vielleicht?"

# game/script.rpy:1593
translate ger ch3_1dbec082:

    # k smile "Sure. And, well, you know... whatever else you'd like to do! As an incubus, I live to please."
    k smile "Sicher. Und, nun, weißt schon... was auch immer du sonst machen willst. Als Inkubus lebe ich dafür, zu verwöhnen."

# game/script.rpy:1594
translate ger ch3_43a052fd:

    # w love "(Since he apologized, I may as well...)"
    w love "(Na, jetzt, wo er sich entschuldigt hat, kann ich ja auch...)"

# game/script.rpy:1595
translate ger ch3_d84e6f35:

    # w calm "Kissing is a fine start."
    w calm "Küssen ist ein guter Anfang."

# game/script.rpy:1598
translate ger ch3_91dabae0:

    # n "Kardaemon holds out his arms, inviting Periwinkle into a soft embrace."
    n "Kardaemon streckt seine Arme aus und lädt Periwinkle in eine zarte Umarmung ein."

# game/script.rpy:1599
translate ger ch3_890d5fb6:

    # n "Periwinkle's hands glide up his chest, and he wraps his arms around the demon's neck. Their faces just inches apart, he pauses..."
    n "{size=-2}Periwinkles Hand streift über seine Brust, dann legt er seine Arme um den Hals des Dämonen. Ihre Gesichter sind sich ganz nah, dann hält er inne..."

# game/script.rpy:1600
translate ger ch3_5db6b259:

    # k "...?"
    k "...?"

# game/script.rpy:1601
translate ger ch3_62b5b0bb:

    # w ah "(...Ah. I expected him to close the gap.)"
    w ah "(...Ah. Ich hab erwartet, dass er die Lücke schließt.)"

# game/script.rpy:1602
translate ger ch3_d0a1702b:

    # w conflicted "(Pastille would've kissed me. I've grown far too accustomed to that, so I automatically...)"
    w conflicted "(Pastille hätte mich geküsst. Ich bin viel zu sehr daran gewöhnt, sodass ich automatisch...)"

# game/script.rpy:1603
translate ger ch3_6c100ae0:

    # w oops "(Shit. This was a mistake...)"
    w oops "(Scheiße. Das war ein Fehler...)"

# game/script.rpy:1604
translate ger ch3_795ea425:

    # n "Periwinkle gives him a light peck on the cheek before pulling away."
    n "Periwinkle gibt ihm einen schnellen Kuss auf die Wange, bevor er sich zurückzieht."

# game/script.rpy:1607
translate ger ch3_01751b4a:

    # w decline "...My apologies. I do actually need to get going now."
    w decline "...Entschuldige. Ich muss jetzt doch wirklich gehen."

# game/script.rpy:1608
translate ger ch3_466c52d9:

    # k huh "Huh...?"
    k huh "Hä...?"

# game/script.rpy:1609
translate ger ch3_d3799d4c:

    # w neutral "I shouldn't have led you on. I'm terribly sorry."
    w neutral "Ich hätte dich nicht anleiten sollen. Es tut mir furchtbar leid."

# game/script.rpy:1610
translate ger ch3_e029c081:

    # k sorry "Oh--n-no, don't worry about that... If you don't want to, it's fine."
    k sorry "Oh--n-nein, mach dir keine Sorgen. Wenn du nicht willst, ist das okay."

# game/script.rpy:1611
translate ger ch3_c9e5ee71:

    # k sad "I'm, uh... a little confused, though... Did I do something wrong?"
    k sad "Ich bin, ähm... nur ein bisschen verwirrt... Hab ich was falsch gemacht?"

# game/script.rpy:1612
translate ger ch3_6e012f78:

    # w decline "It's not you--you're very nice. Very firm muscles."
    w decline "Nicht du--du bist sehr nett. Hast sehr starke Muskeln."

# game/script.rpy:1613
translate ger ch3_1de73ec5:

    # k shy "Hah, thanks."
    k shy "Hah, danke."

# game/script.rpy:1614
translate ger ch3_dc4c50ae:

    # w neutral "If it were any other night, things would've gone very differently. Please believe me when I say that."
    w neutral "Wäre es irgendein anderer Abend, wären die Dinge ganz anders verlaufen. Bitte glaub mir das."

# game/script.rpy:1615
translate ger ch3_7e78fb2a:

    # k lookoff "Seriously... is all this mysterious talk supposed to make me want you less...?"
    k lookoff "Ernsthaft... soll mich dieses mysteriöse Gerede dazu bringen, dich weniger zu wollen...?"

# game/script.rpy:1616
translate ger ch3_47a1fbc2:

    # w calm "I'm sure you'll have great luck with the witches inside. You're very charming."
    w calm "Ich bin sicher, dur wirst viel Glück bei den Hexen auf der Feier haben. Du bist sehr charmant."

# game/script.rpy:1617
translate ger ch3_c29eff2b:

    # k pls "...Damn. Well, alright..."
    k pls "...Verdammt. Na ja, in Ordnung..."

# game/script.rpy:1618
translate ger ch3_e35a87bd:

    # k sorry "Get home safe, Periwinkle. Hope to see you again... on any other night, like you said."
    k sorry "Komm gut nach Hause, Periwinkle. Hoffentlich sehen wir uns wieder... an einem anderen Abend, wie du meintest."

# game/script.rpy:1619
translate ger ch3_92af379d:

    # w innocent "Thank you for keeping me entertained. Farewell~"
    w innocent "Danke, dass du mich unterhalten hast. Mach's gut~"

# game/script.rpy:1622
translate ger ch3_3e90a2df:

    # "I shouldn't have come..."
    "Ich hätte nicht kommen sollen..."

# game/script.rpy:1623
translate ger ch3_eed2f11e:

    # "What exactly have I proven here tonight? That I'm willing to pursue the first pink-haired boy I come across, out of sheer desperation?"
    "Was genau habe ich heute Abend bewiesen? Dass ich gewillt bin, aus purer Verzweiflung dem erstbesten pinkhaarigen Jungen hinterherzujagen, dem ich begegne?"

# game/script.rpy:1624
translate ger ch3_e4b0829d:

    # "I wanted Astragalus to be wrong for once. To admit that I'm hung up on someone is just...!"
    "Ich wollte, dass Astragalus wenigstens einmal Unrecht hatte. Zugeben zu müssen, dass ich mich zu sehr an jemanden klammere, ist einfach...!"

# game/script.rpy:1625
translate ger ch3_0a84e19c:

    # "I don't feel like myself at all..."
    nvl clear
    "Ich fühle mich überhaupt nicht mehr wie ich selbst..."

# game/script.rpy:1626
translate ger ch3_76b2fe88_6:

    # nvl clear
    nvl clear

# game/script.rpy:1639
translate ger ch3_f6133343:

    # n "Periwinkle arrives home, lazily slipping out of his shoes and dress. He tosses his hat somewhere and collapses onto the couch."
    n "Periwinkle kommt zuhause an, wo er sich träge seiner Kleidung entledigt. Dann lässt er sich auf die Couch fallen."

# game/script.rpy:1640
translate ger ch3_bcd66a5f:

    # w lazy oops "(Ugh... I feel even more miserable than before.)"
    w lazy oops "(Ugh... Ich fühle mich noch mieser als vorher.)"

# game/script.rpy:1641
translate ger ch3_cba66395:

    # w neutral "...."
    w neutral "...."

# game/script.rpy:1642
translate ger ch3_b315e641:

    # n "Periwinkle finds himself staring at the front door, half-expecting to hear a familiar knock..."
    n "Periwinkle erwischt sich dabei, wie er die Tür anstarrt und insgeheim erwartet, ein vertrautes Klopfen zu hören..."

# game/script.rpy:1643
translate ger ch3_d186408e:

    # w guilty "(The state Pastille would find me in if he were to show up tonight...)"
    w guilty "(Der Zustand, in dem Pastille mich vorfände, würde er heute Nacht hier auftauchen...)"

# game/script.rpy:1644
translate ger ch3_db6282c6:

    # w empty "...."
    w empty "...."

# game/script.rpy:1645
translate ger ch3_3e0e2f15:

    # w oops "(...I should get in bed.)"
    w oops "(...Ich sollte ins Bett gehen.)"

# game/script.rpy:1647
translate ger ch3_f44ca24a:

    # n "But he doesn't. Instead, he buries his face in the cushions and falls asleep..."
    n "Doch das tut er nicht. Stattdessen vergräbt er sein Gesicht in die Kissen und schläft ein..."

# game/script.rpy:1658
translate ger ch4_7b49a2da:

    # centered "{w=3}{nw}"
    centered "{w=3}{nw}"

# game/script.rpy:1664
translate ger ch4_646d0d17:

    # n "Periwinkle bolts awake to the sound of a knock on his door."
    n "Durch ein Klopfen an der Tür schreckt Periwinkle aus dem Schlaf."

# game/script.rpy:1665
translate ger ch4_442e5a09:

    # w lazy sleepy "(Ugh, what time is it...?)"
    w lazy sleepy "(Ugh, wie spät ist es...?)"

# game/script.rpy:1666
translate ger ch4_eddf3c07:

    # n "He rises from the couch and lightly treads over to check who might be visiting him so early in the morning..."
    n "Er steht auf und schlurft zur Tür, um nachzusehen, wer ihn zu so früher Stunde besucht..."

# game/script.rpy:1667
translate ger ch4_451d8daa:

    # w ah "(Ah...)"
    w ah "(Ah...)"

# game/script.rpy:1669
translate ger ch4_ce446219:

    # "At first, I thought my eyes were playing tricks on me."
    "Erst dachte ich, meine Augen würden mir einen Streich spielen."

# game/script.rpy:1670
translate ger ch4_16ee5917:

    # "It took several moments to register the fact that Pastille was on my doorstep."
    "Es dauerte einige Momente, um zu erkennen, dass es tatsächlich Pastille war, der vor meiner Tür stand."

# game/script.rpy:1671
translate ger ch4_26279968:

    # "The knocking comes again, snapping me out of my stupor."
    "Als nochmal ein Klopfen ertönt, werde ich aus meiner Benommenheit gerissen."

# game/script.rpy:1672
translate ger ch4_c04c89fd:

    # nvl clear
    # w lazy guilty "*ahem* One moment, please~!"
    nvl clear
    w lazy guilty "*ähem* Einen Moment, bitte~!"

# game/script.rpy:1674
translate ger ch4_f1422f42:

    # n "Periwinkle gathers up the clothes he'd left on the floor and stuffs them out of sight."
    n "Periwinkle sammelt die auf dem Boden liegende Kleidung ein und verstaut sie so, dass man sie nicht mehr sehen kann."

# game/script.rpy:1675
translate ger ch4_f6a25d83:

    # n "Next, he scrambles into the bathroom to check his makeup."
    n "Danach kriecht er ins Badezimmer, um sein Makeup zu überprüfen."

# game/script.rpy:1676
translate ger ch4_18e27ee5:

    # w oh "(Passable, considering the circumstances...)"
    w oh "(Annehmbar, wenn man die Umstände bedenkt...)"

# game/script.rpy:1677
translate ger ch4_93c9bcce:

    # n "Wrapping a blanket around his shoulders in an attempt to look half-decent, he finally opens the door..."
