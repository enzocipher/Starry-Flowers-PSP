    w shutin happy "Wow~ die ganze Kavallerie ist da!"

# game/script.rpy:2642
translate ger ch5_ccfacf58:

    # w love "Unfortunately, I'm going to have to decline... tonight isn't going to work for me."
    w love "Unglücklicherweie werde ich ablehnen müssen... heute Abend passt es bei mir nicht."

# game/script.rpy:2643
