# game/script.rpy:1873
translate ger ch4_180fe63a:

    # p shy "Haha, I think that's just your competitive spirit again."
    p shy "Haha, ich glaube, das ist wieder nur dein kompetitiver Geist."

# game/script.rpy:1874
translate ger ch4_564ec052:

    # w happy "See, you truly understand me~!"
    w happy "Siehst du, du verstehst mich wirklich~!"

# game/script.rpy:1876
