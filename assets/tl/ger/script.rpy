translate ger ch4_8bd3c979:

    # w innocent "I brought Pastille! We're on a date 💙"
    w innocent "Ich habe Pastille mitgebracht! Wir sind auf einem Date 💙"

# game/script.rpy:1994
translate ger ch4_95b073e2:

    # a annoyed "...Okay."
    a annoyed "...Okay."

# game/script.rpy:1995
translate ger ch4_b2245627:

    # n "She looks over at Pastille, who waves when he notices he's being watched. Astragalus turns back to Periwinkle."
    n "Sie schaut rüber zu Pastille, der winkt, als er bemerkt, dass er beobachtet wird. Astragalus dreht sich wieder zu Periwinkle."

# game/script.rpy:1996
translate ger ch4_215220bc:

    # a whatever "I take it you decided NOT to heed my advice."
    a whatever "Ich nehme an, dass du meinem Ratschlag also NICHT gefolgt bist."

# game/script.rpy:1997
translate ger ch4_b3e20422:

    # w my "Hm? What advice?"
    w my "Hm? Welcher Ratschlag?"

# game/script.rpy:1998
translate ger ch4_e1925ef2:

    # a augh "Why bother coming to me if you're just gonna do whatever you want..."
    a augh "Wofür kommst du zu mir, wenn du dann eh nur das machst, was du willst..."

# game/script.rpy:1999
translate ger ch4_42d8b424:

    # a closed "Well, whatever. Is there a reason you're here?"
    a closed "Naja, wie auch immer. Gibt es einen Grund, dass ihr hier seid?"

# game/script.rpy:2000
translate ger ch4_cd2145bd:

    # w innocent "I thought I'd drop by to give you a little update! As you can see, everything is fine now."
    w innocent "Ich dachte, ich schau mal vorbei und geb dir ein kleines Update! Wie du sehen kannst, ist jetzt alles in Ordnung."

# game/script.rpy:2001
translate ger ch4_ac82b301:

    # a eyeroll "...Sure. Very normal of you to suddenly bring one of your dates here."
    a eyeroll "...Sicher. Sehr üblich von dir, plötzlich ein Date von dir hierher zu bringen."

# game/script.rpy:2002
translate ger ch4_d2135757:

    # w my "Is it not? I visit you all the time!"
    w my "Ist es nicht? Ich besuche dich die ganze Zeit!"

# game/script.rpy:2003
translate ger ch4_59449ce5:

    # a lol "Yeah, not for stuff like this."
    a lol "Joa, nicht dafür."

# game/script.rpy:2004
translate ger ch4_bfc9f6c6:

    # w happy "Anyway--I wanted you to meet Pastille!"
    w happy "Wie dem auch sei--ich wollte, dass du Pastille kennenlernst!"

# game/script.rpy:2005
translate ger ch4_479d8d54:

    # w "Pastille~! Come over here 💙"
    w "Pastille~! Komm mal her 💙"

# game/script.rpy:2007
translate ger ch4_347c886b:

    # n "Startled by suddenly being called upon, Pastille fumbles the bottle he was holding and it crashes onto the floor."
    n "Davon überrascht, plötzlich gerufen zu werden, fällt Pastille eine Flasche aus der Hand und zerschellt am Boden."

# game/script.rpy:2009
translate ger ch4_a645f843:

    # w ohdear "Ah--"
    w ohdear "Ah--"

# game/script.rpy:2010
translate ger ch4_da2d5595:

    # a augh "HEY, you break it, you buy it!" with vpunch
    a augh "HEY, wer's kaputt macht, zahlt's!" with vpunch

# game/script.rpy:2011
translate ger ch4_182e1ea6:

    # p "Sorry!! I-I can fix it--"
    p "Sorry!! I-ich kann es reparieren--"

# game/script.rpy:2013
translate ger ch4_96d34e8e:

    # n "Pastille sweeps the pieces of the bottle into a pile along with its powdered contents."
    n "Pastille kehrt die Teile der Flasche zusammen mit dem pudrigen Inhalt auf einen Haufen."

# game/script.rpy:2015
translate ger ch4_4e1d7957:

    # n "He holds his hands over the pile, now glowing with magic, and the three of them watch as it reassembles perfectly before them."
    n "Er hält seine Hände über den Haufen, der jetzt magisch aufleuchtet, und die drei schauen zu, wie sich alles wieder perfekt zusammensetzt."

# game/script.rpy:2016
translate ger ch4_0b2deec4:

    # w ah "(Impressive... He's done it so quickly....)"
    w ah "(Beeindruckend... Er hat es so schnell gemacht....)"

# game/script.rpy:2019
translate ger ch4_4b28fdb7:

    # p ehe2 "There... good as new."
    p ehe2 "Da... so gut wie neu."

# game/script.rpy:2020
translate ger ch4_0508b2ea:

    # a whatever "...Bring it here."
    a whatever "...Zeig mal her."

# game/script.rpy:2021
translate ger ch4_4fd60af9:

    # p um "Ah--um... sure. S-sorry...."
    p um "Ah--ähm... klar. S-sorry...."

# game/script.rpy:2022
translate ger ch4_62c15c89:

    # w guilty "(I can't help but feel I've put Pastille in yet another uncomfortable situation....)"
    w guilty "(Ich komm nicht drumherum zu denken, dass ich Pastille mal wieder in eine unangenehme Situation gebracht hab....)"

# game/script.rpy:2023
translate ger ch4_2664336a:

    # a hm "...Damn, can't even tell it was ever busted up. This kind of magic your specialty?"
    a hm "...Verdammt, ich kann nicht mal sagen, dass es jemals kaputt war. Diese Art Magie ist deine Spezialität?"

# game/script.rpy:2024
translate ger ch4_0b008a8e:

    # p ehe "Not really... I only learned it because I thought it'd come in handy."
    p ehe "Nicht wirklich... Ich habe sie nur gelernt, weil ich dachte, sie wäre irgendwann mal nützlich."

# game/script.rpy:2025
translate ger ch4_c184027e:

    # a closed "Huh."
    a closed "Ach so."

# game/script.rpy:2029
translate ger ch4_33a20748:

    # n "Astragalus continues inspecting the bottle, and then takes it into the back room without saying another word."
    n "Astragalus betrachtet weiter die Flasche und nimmt sie dann ohne ein weiteres Wort mit ins Hinterzimmer."

# game/script.rpy:2030
translate ger ch4_e17b00b3:

    # w date my "(Wow~ I suppose she was impressed, too!)"
    w date my "(Wow~ ich nehme an, sie war ebenfalls beeindruckt!)"

# game/script.rpy:2033
translate ger ch4_f3676b3b:

    # p "Is she mad at me...? I can't really tell...."
    p "Ist sie sauer auf mich...? Ich erkenn's nicht wirklich...."

# game/script.rpy:2034
translate ger ch4_a65c95b5:

    # w happy "It looks like you were spared today 💙 That spell really saved you."
    w happy "Sieht aus, als bleibst du heute verschont 💙 Der Zauber hat dich echt gerettet."

# game/script.rpy:2035
translate ger ch4_f977739a:

    # p flustered2 "I can't believe I did that... I'm not usually this clumsy, I swear."
    p flustered2 "Ich kann nicht glauben, dass mir das passiert ist... Ich bin eigentlich nicht so schusselig, ich schwör's."

# game/script.rpy:2036
translate ger ch4_ebece81c:

    # w love "Oh, but wouldn't it be adorable if you were? Pastille the klutz~! 💙"
    w love "Oh, aber wäre es nicht liebenswert, wenn du es wärst? Pastille, der Tollpatsch~! 💙"

# game/script.rpy:2037
translate ger ch4_b4268f28:

    # p scream "NO...! I-I'm just gonna go wait outside!!" with vpunch
    p scream "NEIN...! I-ich werde einfach draußen warten!!" with vpunch

# game/script.rpy:2038
translate ger ch4_83c29565:

    # w innocent "Hmhm, don't be too hard on yourself~ I promise you made a better impression than you think."
    w innocent "Hmhm, sei nicht so streng mit dir selbst~ Ich verspreche dir, du hast einen besseren Eindruck hinterlassen, als du denkst."

# game/script.rpy:2042
translate ger ch4_2175cd9e:

    # "Pastille walks out of the apothecary, and I lean against the counter, waiting for Astragalus to re-emerge from the back room."
    "Pastille verlässt die Apotheke und ich lehne mich an die Theke, darauf wartend, dass Astragalus wieder aus dem Hinterzimmer kommt."

# game/script.rpy:2043
translate ger ch4_e0cb17ac:

    # "But when she does, it's with a bag full of... well... I'm not quite sure."
    "Aber als sie kommt, hat sie einen Sack voller... nun... ich bin mir nicht sicher."

# game/script.rpy:2044
translate ger ch4_76b2fe88_9:

    # nvl clear
    nvl clear

# game/script.rpy:2047
translate ger ch4_e90d8861:

    # a "...Hm? Where'd your boyfriend go?"
    a "...Hm? Wo ist dein Freund hin?"

# game/script.rpy:2048
translate ger ch4_abadde12:

    # w date "You shouldn't call him that. Might I ask--what is it you're holding?"
    w date "Du solltest ihn nicht so nennen. Darf ich fragen--was du da hältst?"

# game/script.rpy:2049
translate ger ch4_4abab777:

    # a happy "Busted lamp. I've been meaning to glue it back together myself, until I saw the opportunity to save myself the trouble."
    a happy "Kaputte Lampe. Ich wollte sie selbst wieder zusammenkleben, bis ich eine Möglichkeit gesehen hab, die mir den Ärger erspart."

# game/script.rpy:2050
translate ger ch4_62e9d646:

    # w pout "How offensive. Take it to a repair shop, like everyone else."
    w pout "Wie anmaßend. Bring sie in die Reparatur, wie jeder andere auch."

# game/script.rpy:2051
translate ger ch4_d29f2200:

    # a lol "Nah, waste of money. You better keep that boy around--he's useful."
    a lol "Nee, Geldverschwendung. Du behältst den Jungen lieber bei dir--er ist nützlich."

# game/script.rpy:2052
translate ger ch4_88d15fb4:

    # w calm "You've certainly changed your tune...."
    w calm "Du hast wirklich deinen Ton verändert...."

# game/script.rpy:2053
translate ger ch4_d330e65c:

    # a happy "He's cute. I get a good vibe from him."
    a happy "Er ist süß. Ich hab ein gutes Gefühl bei ihm."

# game/script.rpy:2054
translate ger ch4_f8e67399:

    # a lol2 "Anyway, bring him back in sometime so I can get this lamp fixed. Got it?"
    a lol2 "Wie dem auch sei, bring ihn mal wieder mit, damit ich die Lampe repariert bekomme, verstanden?"

# game/script.rpy:2055
translate ger ch4_743dec44:

    # w happy "He won't be doing that!!"
    w happy "Er wird das nicht machen!!"

# game/script.rpy:2056
translate ger ch4_91bd044b:

    # a neutral "Seriously, though. Where I'm from, we were taught that you can tell a lot about a witch from their magic..."
    a neutral "Aber mal im Ernst. Wo ich herkomme, hat man uns beigebracht, dass man über deren Magie viel über eine Hexe sagen kann..."

# game/script.rpy:2057
translate ger ch4_f2f55ac5:

    # a closed "And his? Very empathetic. Sincere, compassionate."
    a closed "Und seine? Sehr empathisch. Ehrlich, leidenschaftlich."

# game/script.rpy:2058
translate ger ch4_7019ca7c:

    # w love "Well, you aren't wrong, but... how can you judge that sort of thing after witnessing one little spell?"
    w love "Nun, du liegst nicht falsch, aber... wie kannst du das nach nur einem kleinen Zauber beurteilen?"

# game/script.rpy:2059
translate ger ch4_bd2d025d:

    # a lol "Ha, wouldn't YOU like to know?"
    a lol "Ha, DAS wüsstest du wohl gern?"

# game/script.rpy:2060
translate ger ch4_768d16f3:

    # w calm "Hmhm, I don't need your superstitions. I have a date to get back to."
    w calm "Hmhm, ich brauch deinen Aberglauben nicht. Ich habe ein Date, zu dem ich zurück sollte."

# game/script.rpy:2061
translate ger ch4_dfa92959:

    # a smile "Heh, alright. Have fun, Periwinkle...."
    a smile "Heh, alles klar. Viel Spaß, Periwinkle...."

# game/script.rpy:2062
translate ger ch4_c2b45ec4:

    # w innocent "Oh, I very much intend to 💙"
    w innocent "Oh, den werde ich sicher haben 💙"

# game/script.rpy:2066
translate ger ch4_7cd4194b:

    # n "Smiling to himself, Periwinkle strides confidently out the door to where Pastille is waiting."
    n "Lächelnd schreitet Periwinkle selbstbewusst aus der Tür zu Pastille, der draußen wartet."

# game/script.rpy:2074
translate ger ch4_d3b6758e:

    # p "Hey--um... do I still need to pay for that bottle?"
    p "Hey--ähm... muss ich immer noch für die Flasche bezahlen?"

# game/script.rpy:2075
translate ger ch4_c189c5fa:

    # w date calm "She didn't mention it."
    w date calm "Sie hat nichts dazu gesagt."

# game/script.rpy:2076
translate ger ch4_3e5dc9da:

    # p calm "Phew. I'm glad I could fix it... I was worried it might be expensive."
    p calm "Puh. Ich bin froh, dass ich sie reparieren konnte... Ich hatte schon befürchtet, dass es teuer wird."

# game/script.rpy:2077
translate ger ch4_b7aae312:

    # w smile "You never told me you were so good with magic. As I recall, you said you had been living without it?"
    w smile "Du hast mir nie gesagt, dass du so gut mit Magie bist. Ich erinnere mich, dass du sagtest, du seist ohne aufgewachsen?"

# game/script.rpy:2078
translate ger ch4_ae7d5ce2:

    # p think "Yeah, mostly."
    p think "Joa, größtenteils."

# game/script.rpy:2079
translate ger ch4_d4e69b9f:

    # p ehe "I won't get into the reasons why... but I got back into studying it recently."
    p ehe "Die Gründe werde ich jetzt nicht nennen... aber ich bin letztens zum Magielernen zurückgekehrt."

# game/script.rpy:2080
translate ger ch4_b20c986a:

    # w happy "Astragalus certainly thought you were talented. I'm impressed too, of course."
    w happy "Astragalus meinte wirklich, du seist talentiert. Ich bin natürlich auch beeindruckt."

# game/script.rpy:2081
translate ger ch4_537846ba:

    # p shy "Th-thanks... haha, if only I could use magic to stop myself from being a klutz...."
    p shy "D-danke... haha, wenn ich nur Magie hätte, die mich davon abhält, so ein Tollpatsch zu sein...."

# game/script.rpy:2082
translate ger ch4_e7496cc5:

    # w teehee "Oh, are you embracing that nickname now?"
    w teehee "Oh, dir gefällt der Name jetzt also doch?"

# game/script.rpy:2083
translate ger ch4_32e4b18b:

    # p scream "N-no!! Please go back to saying \"my sweet\"!!!" with vpunch
    p scream "N-nein!! Sag bitte wieder \"mein Süßer\"!!!" with vpunch

# game/script.rpy:2084
translate ger ch4_e86c0674:

    # w love "Ah~ if you like that one so much, I suppose I have no choice! 💙"
    w love "Ah~ wenn du das so sehr magst, bleibt mir wohl keine Wahl! 💙"

# game/script.rpy:2085
translate ger ch4_419d487f:

    # p omgstop "I-I... I just meant...!"
    p omgstop "I-ich... Ich meinte nur...!"

# game/script.rpy:2086
translate ger ch4_8c34b708:

    # p flustered "N-Nevermind!! Don't call me anything...!" with vpunch
    p flustered "E-egal!! Gib mir gar keine Namen...!" with vpunch

# game/script.rpy:2087
translate ger ch4_58252808:

    # w shy "Hmhmhm 💙 Oh, Pastille...."
    w shy "Hmhmhm 💙 Oh, Pastille...."

# game/script.rpy:2090
translate ger ch4_5df76680:

    # "We resume our stroll around town..."
    "Wir setzen unseren Spaziergang durch die Stadt fort..."

# game/script.rpy:2091
translate ger ch4_df4e55af:

    # "This time, it's Pastille who takes the lead. He seems to have someplace in mind, but hasn't said as much."
    "Diesmal ist es Pastille, der die Führung übernimmt. Er scheint einen Ort im Kopf zu haben, hat aber nichts dazu gesagt."

# game/script.rpy:2092
translate ger ch4_5623091f:

    # "He merely takes my hand and leads me up a labyrinth of stairs..."
    "Er nimmt einfach nur meine Hand und führt mich ein Labyrinth aus Treppen hinauf..."

# game/script.rpy:2093
translate ger ch4_76b2fe88_10:

    # nvl clear
    nvl clear

# game/script.rpy:2097
translate ger ch4_fd97df8a:

    # "And once we reach the top..."
    "Und als wir die Spitze erreichen..."

# game/script.rpy:2098
translate ger ch4_37819467:

    # "A gust of wind swoops through the trees overhead, showering us in flower petals."
    "Fegt ein kleiner Windstoß durch die Bäume über uns und es regnet Blütenblätter."

# game/script.rpy:2099
translate ger ch4_af3d310d:

    # nvl clear
    # w date ah "Ah. Peach blossoms..."
    nvl clear
    w date ah "Ah. Pfirsichblüten."

# game/script.rpy:2103
translate ger ch4_bf824512:

    # p "It's nice, isn't it?"
    p "Es ist schön, oder?"

# game/script.rpy:2104
translate ger ch4_745730c3:

    # w love "Hmhm, I can't help but think you're trying to tell me something right now~"
    w love "Hmhm, ich kann nicht anders, als zu denken, dass du mir jetzt irgendetwas sagen willst~"

# game/script.rpy:2105
translate ger ch4_36d2e96b:

    # p oh "Huh...?"
    p oh "Hm...?"

# game/script.rpy:2106
translate ger ch4_7daf2c79:

    # w smile "Don't you remember? My \"aphrodisiac\" was also peach-scented..."
    w smile "Erinnerst du dich? Mein \"Aphrodisiakum\" war auch mit Pfirsichduft..."

# game/script.rpy:2107
translate ger ch4_290ca16a:

    # p wha "Ah..."
    p wha "Ah..."

# game/script.rpy:2108
translate ger ch4_d493bae3:

    # p kyaa "A-AH...! I WASN'T THINKING ABOUT THAT...!!!" with vpunch
    p kyaa "A-AH...! ICH HABE NICHT DARAN GEDACHT...!!!" with vpunch

# game/script.rpy:2109
translate ger ch4_d739c596:

    # p wow "I-I just, was trying to think of other places we could go, and this one came to mind..."
    p wow "I-ich habe nur versucht, mir einen Ort einfallen zu lassen, an den wir gehen könnten, und dieser hier kam mir in den Sinn."

# game/script.rpy:2110
translate ger ch4_eab2cf4c:

    # w happy "It's lovely. Very romantic 💙"
    w happy "Er ist schön. Sehr romantisch 💙"

# game/script.rpy:2111
translate ger ch4_2f1a8383:

    # w shy "(Straight out of a shoujo manga, honestly... how does he know I'm weak to such things?)"
    w shy "(Direkt aus einem Shoujo Manga, um ehrlich zu sein... woher weiß er, dass ich bei so was schwach werde?)"

# game/script.rpy:2112
translate ger ch4_9218331e:

    # p omg "We don't have to stay... I mean, we've already walked around so much--it's okay if you wanna head back now..."
    p omg "Wir müssen nicht bleiben... Ich meine, wir sind schon so viel rumgelaufen--es ist okay, wenn du jetzt zurück möchtest..."

# game/script.rpy:2113
translate ger ch4_18984878:

    # p omgstop "N-NOT TO... DO THINGS... I just meant...! I-I'm gonna stop talking......" with vpunch
    p omgstop "N-NICHT UM... DINGE ZU TUN... Ich meinte nur...! I-ich sag einfach gar nichts mehr......" with vpunch

# game/script.rpy:2114
translate ger ch4_6d760657:

    # w love "Pastille."
    w love "Pastille."

# game/script.rpy:2115
translate ger ch4_7a8b97fb:

    # p seriously "Y-yes...?"
    p seriously "J-ja...?"

# game/script.rpy:2116
translate ger ch4_ec1d1b34:

    # w calm "You've presented me quite the conundrum. If I kiss you now, you'll definitely want to return home with me as soon as possible..."
    w calm "Da hast du mich echt vor eine schwierige Entscheidung gestellt."
    w "Wenn ich dich jetzt küsste, würdest du definitiv so schnell wie möglich mit mir nach Hause kommen wollen..."

# game/script.rpy:2117
translate ger ch4_80145f9c:

    # w happy "But I wasn't done learning all about you. I'm not ready for our date to end 💙"
    w happy "Aber ich hab noch gar nicht alles über dich erfahren. Ich bin noch nicht bereit dazu, unser Date zu beenden 💙"

# game/script.rpy:2118
translate ger ch4_5974e4ff:

    # p embarrassed "O-oh... that IS a conundrum...."
    p embarrassed "O-oh... das IST eine schwierige Entscheidung...."

# game/script.rpy:2119
translate ger ch4_dbc74acd:

    # w love "Yes, you see? Both options are equally appealing. However can I decide~?"
    w love "Ja, siehst du? Beide Optionen sind gleichermaßen verlockend. Wie soll ich mich da nur entscheiden~?"

# game/script.rpy:2120
translate ger ch4_ec2c6956:

    # p shy "Haha, um, well... i-it's still light out! Maybe we can hold back until after dinner...."
    p shy "Haha, ähm, nun... e-es ist noch hell draußen! Vielleicht können wir uns bis nach dem Abendessen zurückhalten...."

# game/script.rpy:2121
translate ger ch4_584de9f1:

    # w teehee "Or I could have YOU for dinner 💙"
    w teehee "Oder ich könnte DICH zum Abendessen haben 💙"

# game/script.rpy:2122
translate ger ch4_31907a91:

    # p kyaa "A-AH...!" with vpunch
    p kyaa "A-AH...!" with vpunch

# game/script.rpy:2123
translate ger ch4_f4a3afbc:

    # w calm "On the other hand, you bring up a valid point. Holding back is fun in itself."
    w calm "Andererseits hast du da einen guten Punkt. Zurückhalten ist doch an sich auch spaßig."

# game/script.rpy:2124
translate ger ch4_9d41c26b:

    # p omgstop "Do you expect me to recover after what you just said...?!"
    p omgstop "Erwartest du, dass ich das noch kann, nach dem, was du gerade gesagt hast...?!"

# game/script.rpy:2125
translate ger ch4_32adccf0:

    # w happy "See~? This IS quite fun!"
    w happy "Siehst du~? Das IST recht spaßig!"

# game/script.rpy:2126
translate ger ch4_b5263d43:

    # w calm "It's decided, then. The date continues."
    w calm "Dann ist es entschieden. Das Date geht weiter."

# game/script.rpy:2130
translate ger ch4_98062818:

    # "I give Pastille a moment to calm himself."
    "Ich gebe Pastille einen Moment, um sich zu beruhigen."

# game/script.rpy:2131
translate ger ch4_43346300:

    # "We walk up to the railing and look out at the town..."
    "Wir laufen zum Geländer und schauen auf die Stadt..."

# game/script.rpy:2132
translate ger ch4_2e739e18:

    # nvl clear
    # "You can see Atelier Sweets from here. And the train station next to it."
    nvl clear
    "Man kann das Atelier Sweets von hier aus sehen. Und den Bahnhof daneben."

# game/script.rpy:2134
translate ger ch4_65c0b220:

    # "My house is... somewhere in a row of similarly built homes. Inconspicuous."
    "Mein Haus ist... irgendwo in einer Reihe ähnlich gebauter Häuser. Unauffällig."

# game/script.rpy:2135
translate ger ch4_140deac1:

    # "Fallen petals litter the bricks at our feet, with every little breeze carrying a few more over the railing to land somewhere unknown."
    "Gefallene Blütenblätter säumen die Pflastersteine unter unseren Füßen, und mit jedem Luftzug werden ein paar über das Geländer hinweg ins Unbekannte geweht."

# game/script.rpy:2136
translate ger ch4_9b3a7e5d:

    # "After watching them for a while, I turn back to Pastille."
    "Nachdem ich sie eine Weile beobachtet habe, wende ich mich wieder Pastille zu."

# game/script.rpy:2137
translate ger ch4_76b2fe88_11:

    # nvl clear
    nvl clear

# game/script.rpy:2140
translate ger ch4_6319f667:

    # w date "Tell me about your magic."
    w date "Erzähl mir was über deine Magie."

# game/script.rpy:2141
translate ger ch4_81ee26b5:

    # p um "O-okay... what do you want to know?"
    p um "O-okay... was möchtest du denn wissen?"

# game/script.rpy:2142
translate ger ch4_c829cbee:

    # w innocent "Your specialty, dear!"
