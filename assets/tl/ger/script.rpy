translate ger ch3_1b2b8580:

    # w oops "I just wish I hadn't gone to return the jacket. It was supposed to be fun, but now..."
    w oops "Ich wünschte nur, ich wäre nicht gegangen, um die Jacke zurückzugeben. Es sollte doch Spaß machen, aber jetzt..."

# game/script.rpy:1402
translate ger ch3_e4e99817:

    # a whatever "Yeah, honestly, I think he's being unfair. He shows up to your place whenever he wants, right?"
    a whatever "Joa, ehrlich gesagt denke ich, dass er unfair ist. Er taucht wann immer er will bei dir auf, oder?"

