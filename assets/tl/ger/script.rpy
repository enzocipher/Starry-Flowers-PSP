# game/script.rpy:3346
translate ger ch6_c5a565be:

    # n "Periwinkle collapses into bed, while Pastille sits down beside him."
    n "Periwinkle fällt ins Bett, während Pastille sich neben ihn setzt."

# game/script.rpy:3349
translate ger ch6_85981fc3:

    # w "I think I've preferred it, though. Keeping a healthy distance from others..."
    w "Ich denke, ich bevorzuge es aber so. Einen gesunden Abstand zu anderen zu halten..."

# game/script.rpy:3350
translate ger ch6_43989462:

    # p "Really? How come?"
    p "Wirklich? Wie kommt's?"

# game/script.rpy:3351
translate ger ch6_a40f3b27:

    # w "The alternative has been disastrous in my experience. I'm far too intense."
    w "Die Alternative war in meiner Erfahrung desaströs. Ich bin viel zu intensiv."

# game/script.rpy:3352
translate ger ch6_c4dfb99a:

    # p "Ha, what do you mean by THAT...?"
    p "Ha, was meinst du denn DAMIT...?"

# game/script.rpy:3353
translate ger ch6_d85fd387:

    # w "Goodness, my best example is the worst one..."
    w "Grundgütiger, mein bestes Beispiel ist auch das schlimmste..."

# game/script.rpy:3355
translate ger ch6_0c4b9b3e:

    # w "In my teenage years... there was a boy I would've done anything for."
    w "In meinen Teenage-Jahren... da gab es einen Jungen, für den ich alles getan hätte."

# game/script.rpy:3356
translate ger ch6_567cfdcb:

    # w "I wanted his approval so badly. I wanted to be loved."
    w "Ich wollte unbedingt seine Anerkennung. Ich wollte geliebt werden."

# game/script.rpy:3357
translate ger ch6_53f3ef0f:

    # w "...It's funny, I can't even think of what drew me to him."
    w "...Was witzig ist, ich weiß nicht mal, was mich zu ihm hingezogen hatte."

# game/script.rpy:3359
translate ger ch6_b214fa05:

    # w "I suppose he was just a vessel to project onto. An idealized boyfriend, this... shortcut to happiness."
    w "Ich vermute, er war einfach eine Projektionsfläche. Ein idealisierter Freund, eine... Abkürzung zum Glück."

# game/script.rpy:3360
translate ger ch6_1201679b:

    # w "Hmhm... poor guy. He didn't know what to do with the torrent of feelings I'd been forcing onto him. We were young."
    w "Hmhm... armer Typ. Er wusste nicht, was er mit der Flut an Gefühlen machen sollte, die ich ihm aufgezwungen hatte. Wir waren jung."

# game/script.rpy:3361
translate ger ch6_7ae36a53:

    # w "A love like that is much too painful. If it can even be called love...."
    w "Eine solche Liebe ist viel zu schmerzvoll. Wenn es überhaupt Liebe genannt werden konnte...."

# game/script.rpy:3363
translate ger ch6_4235f80c:

    # w "It took some practice to be able to separate the emotions out."
    w "Es hat einiges an Übung gebraucht, in der Lage zu sein, diese Emotionen voneinander zu trennen. "

# game/script.rpy:3364
translate ger ch6_094487a5:

    # w "To be able to indulge in the romantic and sexual energy I craved, while protecting my fragile heart..."
    w "In der Lage zu sein, der romantischen und sexuellen Energie nachzugeben und gleichzeitig mein fragiles Herz zu schützen..."

# game/script.rpy:3365
translate ger ch6_c9592a6d:

    # w "But, ever since I figured it out, I've gotten to experience all sorts of love through these casual flings~"
    w "Aber seit ich es geschafft habe, konnte ich jegliche Formen der Liebe durch diese oberflächlichen Affären erleben~"

# game/script.rpy:3366
translate ger ch6_bd22f0ce:

    # w "(What am I saying...?)"
    w "(Was sage ich da...?)"

# game/script.rpy:3367
translate ger ch6_b87e6b7a:

    # w "It's perfect for me 💙 The ideal life, really."
    w "Es ist perfekt für mich 💙 Wirklich das ideale Leben."

# game/script.rpy:3368
translate ger ch6_694c6d8c:

    # w "(Don't listen to me, Pastille....)"
    w "(Hör nicht auf mich, Pastille....)"

# game/script.rpy:3373
translate ger ch6_a29244df:

    # p "Hmm..."
    p "Hmm..."

# game/script.rpy:3374
translate ger ch6_884754a7:

    # p smile "I don't know if your heart is as fragile as you think."
    p smile "Ich weiß nicht, ob dein Herz so fragil ist, wie du denkst."

# game/script.rpy:3375
translate ger ch6_cb22988c:

    # w shutin love "You don't believe me? Despite what it seems, I have the heart of an innocent maiden~!"
    w shutin love "Du glaubst mir nicht? Dem Schein zum Trotze habe ich das Herz einer unschuldigen Jungfrau~!"

# game/script.rpy:3376
translate ger ch6_1dece50f:

    # p sure "Haha, I don't know about innocent, but..."
    p sure "Haha, unschuldig wohl kaum, aber..."

# game/script.rpy:3380
translate ger ch6_ea6c8d9d:

    # n "Pastille leans forward and lays his head on Periwinkle's chest."
    n "Pastille lehnt sich nach vorne und legt seinen Kopf auf Periwinkles Brust."

# game/script.rpy:3381
translate ger ch6_192176bb:

    # p "...Sounds pretty strong to me."
    p "...Es klingt sehr stark für mich."

# game/script.rpy:3382
translate ger ch6_075d682d:

    # w "...!!"
    w "...!!"

# game/script.rpy:3384
translate ger ch6_77261c10:

    # p "Ah, it's beating harder now."
    p "Ah, es schlägt jetzt härter."

# game/script.rpy:3386
translate ger ch6_51fe2183:

    # w "B-because you suddenly embraced me! See, this is what I mean by fragile...!" with vpunch
    w "W-weil du mich plötzlich umarmt hast! Siehst du, das meine ich mit fragil...!" with vpunch

# game/script.rpy:3389
translate ger ch6_afbec36c:

    # n "Periwinkle struggles out from under him, and the pair sits facing each other on the bed."
    n "Periwinkle kämpft sich unter ihm hervor und die beiden sitzen sich auf dem Bett gegenüber."

# game/script.rpy:3392
translate ger ch6_f8a67d56:

    # p "You know... at first, I thought romantic stuff was just a formality for you. But you actually love it, huh?"
    p "Weißt du... zunächst dachte ich, romantisches Zeug war nur eine Formalität für dich. Aber du liebst es wirklich, hm?"

# game/script.rpy:3393
translate ger ch6_9c15c768:

    # w shutin love "Are you only realizing that NOW?"
    w shutin love "Bemerkst du das erst JETZT?"

# game/script.rpy:3394
translate ger ch6_35b3829b:

    # p ehe "Haha, I guess not...."
    p ehe "Haha, ich denke nicht...."

# game/script.rpy:3398
translate ger ch6_d170010a:

    # "What are you trying to say, Pastille?"
    "Was versuchst du zu sagen, Pastille?"

# game/script.rpy:3399
translate ger ch6_736befba:

    # "That it's okay for me to love you...?"
    "Dass es in Ordnung geht, dich zu lieben...?"

# game/script.rpy:3400
translate ger ch6_310f8fb1:

    # "That I'll be safe?"
    "Dass ich sicher sein werde?"

# game/script.rpy:3401
translate ger ch6_76b2fe88_9:

    # nvl clear
    nvl clear

# game/script.rpy:3404
translate ger ch6_94871324:

    # w "Then, hurry up and kiss me."
    w "Dann beeil dich und küss mich."

# game/script.rpy:3406
translate ger ch6_4a8350ae:

    # p "Okay ❤ Sorry to keep you waiting."
    p "Okay ❤ Sorry, dass ich dich warten lassen habe."

# game/script.rpy:3408
translate ger ch6_d66b3318:

    # n "Pastille closes the distance between them..."
    n "Pastille schließt die Distanz zwischen ihnen..."

# game/script.rpy:3409
translate ger ch6_54a35ace:

    # "I'm too weak."
    "Ich bin zu schwach."

# game/script.rpy:3410
translate ger ch6_139334f1:

    # "The words won't come out..."
    "Die Worte kommen nicht raus..."

# game/script.rpy:3411
translate ger ch6_76b2fe88_10:

    # nvl clear
    nvl clear

# game/script.rpy:3413
translate ger ch6_0f7e6da5:

    # n "As they kiss, Periwinkle becomes more and more entangled in his thoughts..."
    n "Während sie sich küssen, verheddert sich Periwinkle mehr und mehr in seinen Gedanken..."

# game/script.rpy:3414
translate ger ch6_f42e65a6:

    # "Ahh, it hurts...!"
    "Aah, es tut weh...!"

# game/script.rpy:3415
translate ger ch6_d63ae36a:

    # "I want to be even closer...."
    "Ich will ihm noch näher sein...."

# game/script.rpy:3416
translate ger ch6_76b2fe88_11:

    # nvl clear
    nvl clear

# game/script.rpy:3418
translate ger ch6_341a3f02:

    # n "He lets himself fall backward, bringing Pastille down with him."
    n "Er lässt sich nach hinten fallen und zieht Pastille dabei mit sich."

# game/script.rpy:3419
translate ger ch6_443d47e5:

    # "This isn't nearly enough to satisfy me..."
    "Das ist nicht annähernd genug, um mich zufriedenzustellen..."

# game/script.rpy:3420
translate ger ch6_c8df87cf:

    # "Just, please, don't stop...."
    "Hör bitte nicht auf...."

# game/script.rpy:3421
translate ger ch6_76b2fe88_12:

    # nvl clear
    nvl clear

# game/script.rpy:3425
translate ger ch6_cb671a59:

    # n "Periwinkle's heart cried out..."
    n "Periwinkles Herz schreit auf..."

# game/script.rpy:3426
translate ger ch6_a66018f1:

    # n "His jumbled emotions caught in his throat, manifesting through his hands, clinging desperately to Pastille..."
    n "{size=-2}Seine durcheinandergeworfenen, im Hals feststeckenden Emotionen zeigen sich nun über seine Hände, die sich verzweifelt an Pastille festklammern..."

# game/script.rpy:3427
translate ger ch6_5f6ba41c:

    # n "...who continued to kiss him and hold him through the night."
    n "...der nicht damit aufhört, ihn zu küssen und die ganze Nacht zu halten."

# game/script.rpy:3438
translate ger ch7_7b49a2da:

    # centered "{w=3}{nw}"
    centered "{w=3}{nw}"

# game/script.rpy:3443
translate ger ch7_6f509ab8:

    # n "The next morning, Periwinkle steps out onto his doorstep with a heavy sigh."
    n "Am nächsten Morgen tritt Periwinkle mit einem schweren Seufzer vor die Tür."

# game/script.rpy:3445
translate ger ch7_a6ad8caa:

    # w hood empty "(If I lay around in bed all day, I'll only feel more miserable...)"
    w hood empty "(Wenn ich den ganzen Tag im Bett liege, werde ich mich nur noch mieser fühlen...)"

# game/script.rpy:3446
translate ger ch7_bfb25d37:

    # w oops "(I need to stop avoiding my work. I have to talk to Astragalus....)"
    w oops "(Ich muss aufhören, meiner Arbeit aus dem Weg zu gehen. Ich muss mit Astragalus reden....)"

# game/script.rpy:3447
translate ger ch7_3eb69f61:

    # w empty "(She isn't going to be pleased with me though....)"
    w empty "(Sie wird nicht sehr erfreut sein....)"

# game/script.rpy:3449
translate ger ch7_c0771f75:

    # n "Holding his mantle tightly, he makes his way to the apothecary..."
    n "Seinen Mantel fest im Griff, macht er sich auf den Weg zur Apotheke..."

# game/script.rpy:3457
translate ger ch7_ec45006e:

    # n "When he arrives, Astragalus is preoccupied with arranging some of her merchandise."
    n "Als er ankommt, ist Astragalus damit beschäftigt, ein paar ihrer Waren zu sortieren."

# game/script.rpy:3458
translate ger ch7_2eb737f5:

    # n "She turns abruptly at the unexpected sound of the door's chime."
    n "Sie dreht sich abrupt zum unerwarteten Geräusch der Türklingel um."

# game/script.rpy:3461
translate ger ch7_23102229:

    # a augh "Hey, we're not open yet--!" with vpunch
    a augh "Hey, wir haben noch nicht geöffnet--!" with vpunch

# game/script.rpy:3463
translate ger ch7_21ae3d6f:

    # a hm "...Huh? Periwinkle?"
    a hm "...Hä? Periwinkle?"

# game/script.rpy:3464
translate ger ch7_0cfdf83c:

    # w hood decline "Good morning, Astragalus."
    w hood decline "Guten Morgen, Astragalus."

# game/script.rpy:3465
translate ger ch7_ca42047f:

    # a uh "I haven't seen you all month--I barely recognized you under that hood!"
    a uh "Ich hab dich den ganzen Monat über nicht gesehen--hab dich unter der Kapuze fast gar nicht erkannt!"

# game/script.rpy:3466
translate ger ch7_a59d0c89:

    # a augh "I was about to come and knock on your damn door if you didn't show your face here soon. You've got a huge backlog of orders waiting!"
    a augh "Ich hatte schon vor, an deiner verdammten Tür zu klopfen, wenn du nicht bald hier auftauchen würdest."
    a "Du hast einen riesigen Rückstand an Bestellungen!"

# game/script.rpy:3467
translate ger ch7_6328fc6a:

    # w empty "...I can't take them. My magic is useless."
    w empty "...Ich kann sie nicht annehmen. Meine Magie ist nutzlos."

# game/script.rpy:3468
translate ger ch7_709a7b6c:

    # a uh "Whaddaya mean, \"useless\"?"
    a uh "Was meinst'n mit \"nutzlos\"?"

# game/script.rpy:3469
translate ger ch7_78308c9b:

    # n "Periwinkle meekly hands over one of his pale pink vials."
    n "Periwinkle übergibt ihr kleinlaut eine seiner blasspinken Phiolen."

# game/script.rpy:3470
translate ger ch7_e6a68b87:

    # w ohhh "This is all I can make... it's been this way for ages."
    w ohhh "Das ist alles, was ich machen kann... das geht schon seit Ewigkeiten so."

# game/script.rpy:3471
translate ger ch7_c42de9e7:

    # a whatever "*sigh* Let's see..."
    a whatever "*seufz* Lass mal sehen..."

# game/script.rpy:3472
translate ger ch7_60a7f254:

    # n "Astragalus unscrews the top, and eyes Periwinkle suspiciously before giving it a whiff..."
    n "Astragalus schraubt den Deckel ab und wirft Periwinkle einen verdächtigen Blick zu, bevor sie daran riecht..."

# game/script.rpy:3473
translate ger ch7_0d690c65:

    # a uh "Whew, that's powerful!!" with vpunch
    a uh "Uff, das ist kräftig!!" with vpunch

# game/script.rpy:3474
translate ger ch7_2b253749:

    # a think "Not bad, though... warms me right up. Could stand to be diluted a little, just to make it less overwhelming..."
    a think "Aber nicht schlecht... erwärmt mich direkt. Könnte noch etwas verdünnt werden, damit es nicht ganz so überwältigend ist..."

# game/script.rpy:3475
translate ger ch7_40f53860:

    # a lol "So. What's got you stuck on a scent like this?"
    a lol "Also. Was hat dich dazu gebracht, an einem solchen Duft hängenzubleiben?"

# game/script.rpy:3476
translate ger ch7_de42c61a:

    # w ohhh2 "...It's Pastille...."
    w ohhh2 "...Es ist Pastille...."

# game/script.rpy:3477
translate ger ch7_0381a0e1:

    # w whine2 "He's ruined me! I'll never be able to return to the way I was before...!"
    w whine2 "Er hat mich ruiniert! Ich werde nie mehr in der Lage sein, so zu werden wie ich vorher war...!"

# game/script.rpy:3478
translate ger ch7_4bd0f1d4:

    # a closed "I see. So things got complicated, just like I warned you."
    a closed "Verstehe. Die Dinge wurden also kompliziert, wie ich vorgewarnt hatte."

# game/script.rpy:3479
translate ger ch7_1fb3e795:

    # w cwy "Mhm... *sniffle*..."
    w cwy "Mhm... *schnief*..."

# game/script.rpy:3480
translate ger ch7_6be39aa2:

    # w cwy2 "I-I love him so much, I think I might die...."
    w cwy2 "I-ich liebe ihn so sehr, ich denke ich werde sterben...."

# game/script.rpy:3481
translate ger ch7_48204255:

    # a neutral "Come on... Back room. Now."
    a neutral "Komm mit... Hinterzimmer. Jetzt."

# game/script.rpy:3485
translate ger ch7_7d77e570:

    # n "Periwinkle nods and obediently follows Astragalus into her private office..."
    n "Periwinkle nickt und folgt Astragalus gehorsam in ihr Büro..."

# game/script.rpy:3490
translate ger ch7_1be0328f:

    # n "He quietly takes in his surroundings before she suddenly turns to him with a raised finger."
    n "Er nimmt ruhig seine Umgebung auf, bevor sie sich plötzlich mit erhobenem Finger zu ihm umdreht."

# game/script.rpy:3492
translate ger ch7_170b612d:

    # a "Don't touch anything."
    a "Fass' nichts an."

# game/script.rpy:3493
translate ger ch7_90a8c977:

    # w hood ohhh "...?"
    w hood ohhh "...?"

# game/script.rpy:3495
translate ger ch7_020bb483:

    # n "Astragalus drags a bean bag chair out from the corner and plops it in the middle of the room unceremoniously."
    n "Astragalus zerrt einen Sitzsack aus der Ecke und lässt ihn kurzerhand inmitten des Zimmers auf den Boden plumpsen."

# game/script.rpy:3497
translate ger ch7_507ec09a:

    # a "Sit."
    a "Setzen."

# game/script.rpy:3498
translate ger ch7_e6ea4d0e:

    # w hood ohhh "...It's dusty...."
    w hood ohhh "...Es ist staubig...."

# game/script.rpy:3499
translate ger ch7_44201857:

    # a augh "UGH, you're such a diva..."
    a augh "UGH, du bist so eine Diva..."

# game/script.rpy:3500
translate ger ch7_c4c193b3:

    # n "She gives it a couple good smacks, beating the dust into the air instead."
    n "Sie klopft ein paar Mal fest auf den Sitzsack, um den Staub aufzuwirbeln."

# game/script.rpy:3501
translate ger ch7_c411bd45:

    # a annoyed "...NOW sit."
    a annoyed "...JETZT setzen."

# game/script.rpy:3502
translate ger ch7_ca9dcc70:

    # w oops "Very well...."
    w oops "Nun gut...."

# game/script.rpy:3505
translate ger ch7_86603b28:

    # n "He complies, and Astragalus spins her office chair around to face him."
    n "Er gehorcht und Astragalus dreht sich in ihrem Bürostuhl zu ihm um."

# game/script.rpy:3508
translate ger ch7_46e11470:

    # a "Alright, Periwinkle. Here's what's gonna happen."
    a "Also gut, Periwinkle. Folgendes wird jetzt passieren."

# game/script.rpy:3509
translate ger ch7_89a00474:

    # a "I'm gonna brew us up some tea, and you're gonna explain everything. From the beginning."
    a "Ich werde uns etwas Tee machen und du wirst alles erklären. Von Anfang an."

# game/script.rpy:3510
translate ger ch7_0ccf1ed0:

    # w hood sorry "Explain what...?"
    w hood sorry "Was erklären...?"

# game/script.rpy:3511
translate ger ch7_0e7a98bb:

    # a "About Pastille. Even the stuff I already know. Everything, from the top."
    a "Wegen Pastille. Auch das Zeug, das ich schon weiß. Alles, von vorn bis hinten."

# game/script.rpy:3512
translate ger ch7_30cf76fb:

    # w ohhh "Everything...?"
    w ohhh "Alles...?"

# game/script.rpy:3513
translate ger ch7_4f05ba39:

    # a "Skip the bedroom details, obviously. Just walk me through anything important that happened since you met."
    a "Die Bettgeschichten kannst du ruhig auslassen. Klär mich nur über alles Wichtige auf, das seit eurem ersten Treffen passiert ist."

# game/script.rpy:3514
translate ger ch7_c147a5e1:

    # w whine "I-I don't want to! Reliving it all is only going to make things worse...!"
    w whine "I-ich will nicht! All das nochmal zu durchleben, wird alles nur noch schlimmer machen...!"

# game/script.rpy:3517
translate ger ch7_d617b2fd:

    # n "Astragalus stands and walks over to her kettle to start the tea."
    n "Astragalus steht auf und läuft zum Kessel rüber, um Tee zu machen."

# game/script.rpy:3519
translate ger ch7_c88d1b30:

    # a "Alright, you lovesick dolt..."
    a "Alles klar, du liebeskranker Depp..."

# game/script.rpy:3520
translate ger ch7_95976d4b:

    # a annoyed "You wanna know why exactly your magic's been stuck like that? It's because you don't have an outlet for all those emotions."
    a annoyed "Willst du wissen, wieso genau deine Magie so festhängt? Weil du kein Ventil für all diese Gefühle hast."

# game/script.rpy:3521
translate ger ch7_ea89bd51:

    # a closed "Instead, you keep bottling them up--literally, I guess. It's all that comes out because it's all there is inside you."
    a closed "Stattdessen staust du alles an--wie in deinen Flaschen. Das ist alles, was herauskommt, weil das alles ist, was in dir ist."

# game/script.rpy:3522
translate ger ch7_61f43815:

    # w hood ohhh "...."
    w hood ohhh "...."

# game/script.rpy:3523
translate ger ch7_4d08edac:

    # a lol2 "So, let it all out! What, you think I'm gonna judge you?"
    a lol2 "Also lass alles raus! Was, denkst du, ich verurteile dich?"

# game/script.rpy:3524
translate ger ch7_0e405e25:

    # w oops "No... I don't know."
    w oops "Nein... ich weiß nicht."

# game/script.rpy:3525
translate ger ch7_a2f71b21:

    # a lol "Would you rather spill it all to him instead?"
    a lol "Willst du das alles lieber ihm sagen?"

# game/script.rpy:3526
translate ger ch7_237d6381:

    # w cwy "I can't...! It's too much!"
    w cwy "Ich kann nicht...! Es ist zu viel!"

# game/script.rpy:3527
translate ger ch7_61ef0d5e:

    # a sure "Then tell it to me, a neutral third party."
    a sure "Dann sag es mir, einer neutralen Dritten."

# game/script.rpy:3528
translate ger ch7_5df175e3:

    # a uh "Actually, I can't say that I'm neutral... I'd need to find a new supplier if you couldn't fill my orders anymore."
    a uh "Obwohl, ich kann nicht sagen, ich sei neutral... Ich müsste einen neuen Zulieferer finden, wenn du nicht mehr kannst."

# game/script.rpy:3529
translate ger ch7_3a7ea07c:

    # w oops "I do feel a little more at ease imagining this is all a business matter for you...."
    w oops "Ich fühle mich tatsächlich etwas erleichtert bei der Vorstellung, dass das alles für dich nur geschäftlich ist...."

# game/script.rpy:3530
translate ger ch7_969f721a:

    # a smile "Then just think of it like that."
    a smile "Dann denk einfach nur daran."

# game/script.rpy:3532
translate ger ch7_e9b2e9b2:

    # n "Astragalus pours their tea and returns to her seat with two mugs in hand."
    n "Astragalus schenkt ihnen Tee ein und kehrt mit zwei Tassen in ihren Händen zu ihrem Platz zurück."

# game/script.rpy:3533
translate ger ch7_a98ff37d:

    # n "With a heavy sigh, Periwinkle finally relents and begins his story..."
    n "Mit einem schweren Seufzer gibt Periwinkle endlich nach und fängt an, seine Geschichte zu erzählen..."

# game/script.rpy:3539
translate ger ch7_d30066c5:

    # "I told her everything I could think of..."
    "Ich erzählte ihr alles, was mir eingefallen war..."

# game/script.rpy:3540
translate ger ch7_33d9f84f:

    # "My first impressions of him. How he continuously subverted my expectations."
    "Meine ersten Eindrücke von ihm. Wie er kontinuierlich meine Erwartungen unterminierte."

# game/script.rpy:3541
translate ger ch7_c5f52926:

    # "My mistakes. Appearing where I shouldn't have, then going into a desperate spiral as I tried to rid myself of the guilt over it."
    "Meine Fehler. Dort auftauchen, wo ich es nicht sollte, dann in eine verzweifelte Spirale geraten, in der ich versuchte, mich meiner Schuldgefühle zu entledigen."

# game/script.rpy:3542
translate ger ch7_1bbf690f:

    # "How he was the one to come to apologize afterward..."
    "Wie er dann derjenige war, der hinterher gekommen war, um sich zu entschuldigen..."

# game/script.rpy:3543
translate ger ch7_c5838a34:

    # nvl clear
    # "Our date that day, which was so, so wonderful... but which also laid bare the feelings I was too afraid to acknowledge."
    nvl clear
    "Unser Date an dem Tag, das so so wundervoll war... das aber auch die Gefühle offenlegte, vor deren Akzeptanz ich Angst hatte."

# game/script.rpy:3545
translate ger ch7_e6e49546:

    # "How I latched on to any alternative explanation I could in order to escape them."
    "Wie ich mich an jede alternative Erklärung klammerte, um diesen Gefühlen zu entfliehen."

# game/script.rpy:3546
translate ger ch7_4e84de73:

    # "The moment I could finally admit it to myself. All the ways he'd changed my life for the better."
    "Der Moment, in dem ich es mir endlich selbst eingestehen konnte. All die Arten, auf die er mein Leben zum Besseren verändert hatte."

# game/script.rpy:3547
translate ger ch7_6a07a020:

    # "How we grew closer and closer, while I held those feelings tighter to my chest..."
    "Wie wir uns immer näher und näher kamen, während ich diese Gefühle immer fester hielt..."

# game/script.rpy:3548
translate ger ch7_d4484d1e:

    # nvl clear
    # "I told her how he had finally worked up the courage to introduce me to his friends."
    nvl clear
    "Ich erzählte ihr, wie er endlich den Mut aufbrachte, mich seinen Freunden vorzustellen."

# game/script.rpy:3550
translate ger ch7_65da988b:

    # "How his hand trembled in mine as we walked out the door together."
    "Wie seine Hand in meiner zitterte, als wir zusammen aus der Tür gelaufen sind."

# game/script.rpy:3551
translate ger ch7_ee6b35c9:

    # "This point of contention, a far-off goal I had decided would have to be met before advancing..."
    "Vom strittigen Punkt, einem fernen Ziel, das zunächst erreicht werden musste, bevor es weitergehen kann..."

# game/script.rpy:3552
translate ger ch7_ca54ab44:

    # "Everything, up to the state I'm in now. Useless, paralyzed, and sobbing."
    "Alles, bis hin zum Zustand, in dem ich jetzt bin. Nutzlos, paralysiert und schluchzend."

# game/script.rpy:3553
translate ger ch7_92f40e14:

    # nvl clear
    # "Astragalus listened patiently through all of it."
    nvl clear
    "Astragalus hat sich alles geduldig angehört."

# game/script.rpy:3555
translate ger ch7_343d2423:

    # "She asked questions from time to time. Clarification on the timeframe, certain details..."
    "Von Zeit zu Zeit hatte sie Fragen gestellt. Klarstellungen zu den Zeitfenstern, bestimmte Details..."

# game/script.rpy:3556
translate ger ch7_87e644fe:

    # "Her reaffirming comments offered such comfort, such relief to this pain I'd kept confined to my own heart."
    "Ihre bestätigenden Kommentare taten gut und halfen, den Schmerz zu lindern, den ich in meinem Herzen behielt."

# game/script.rpy:3557
translate ger ch7_b69014f7:

    # "Until finally, I had nothing left to say."
    "Bis ich schließlich nichts mehr zu erzählen hatte."

# game/script.rpy:3558
translate ger ch7_d27b4990:

    # nvl clear
    # n "Astragalus sits back in her chair and heaves a sigh."
    nvl clear
    n "Astragalus lehnt sich in ihren Stuhl and stößt einen Seufzer aus."

# game/script.rpy:3562
translate ger ch7_a8670c2a:

    # a "So? How are you feeling?"
    a "Also? Wie fühlst du dich?"

# game/script.rpy:3563
translate ger ch7_04d072f1:

    # w hood oh2 "There's a certain clarity in laying it all out at once..."
    w hood oh2 "Da ist eine gewisse Klarheit, wenn man alles auf einmal rauslässt..."

# game/script.rpy:3564
translate ger ch7_547bdb80:

    # w ohhh "But, I still... don't know what I can do to push things forward... could I even handle the rejection...?"
    w ohhh "Aber ich weiß immer noch nicht... was ich machen kann, um die Dinge voranzutreiben..."
    w "Könnte ich mit einer Zurückweisung überhaupt klarkommen...?"

# game/script.rpy:3565
translate ger ch7_a359177e:

    # a eyeroll "He won't reject you."
    a eyeroll "Er wird dich nicht zurückweisen."

# game/script.rpy:3566
translate ger ch7_229785e7:

    # w sorry "What makes you so certain...?"
    w sorry "Wieso bist du da so sicher...?"

# game/script.rpy:3567
translate ger ch7_47ddd304:

    # a lmao "That boy is madly in love with you!! Why else would he devote all that time and energy to making you happy?"
    a lmao "Dieser Junge ist total verliebt in dich!! Wieso sonst sollte er all die Zeit und Energie aufbringen, um dich glücklich zu machen?"

# game/script.rpy:3568
translate ger ch7_a282e00e:

    # w pout "Because I'm great in bed! Obviously!!" with vpunch
    w pout "Weil ich großartig im Bett bin! Offensichtlich!!" with vpunch

# game/script.rpy:3569
translate ger ch7_7d78d80b:

    # a lol2 "Quit deflecting! You know that's not all it is."
    a lol2 "Hör auf abzulenken! Du weißt, dass das nicht alles ist."

# game/script.rpy:3570
translate ger ch7_c44bc880:

    # w nofair2 "I don't want to leave any room for doubt... if I were to confess now, and it didn't go well, I'd... I'd be destroyed beyond repair!"
    w nofair2 "Ich will keinen Raum für Zweifel lassen... wenn ich jetzt gestehen würde und es würde schiefgehen..."
    w "Ich würde... ich würde hoffnungslos daran zerbrechen!"

# game/script.rpy:3571
translate ger ch7_699f61db:

    # w nofair "That's why, if I'm going to say it, I want it to be a sure thing."
    w nofair "Deshalb will ich, wenn ich es sagen werde, dass es ein sicheres Ding ist."

# game/script.rpy:3572
translate ger ch7_70aa9f4c:

    # a sure "Life ain't about \"sure things\"."
    a sure "Im Leben geht's nicht um \"sichere Dinge\"."

# game/script.rpy:3573
translate ger ch7_1ce1b2b1:

    # w oops "Even so. I'm going to wait for the opportune moment before exposing my vulnerable heart...."
    w oops "Nichtsdestotrotz. Ich werde auf einen gelegenen Moment warten, bevor ich mein verletzliches Herz offenbare...."

# game/script.rpy:3574
translate ger ch7_67d2fe6a:

    # a eyeroll "As long as you've got a plan."
    a eyeroll "Solange du einen Plan hast."

# game/script.rpy:3576
translate ger ch7_5c6e9d30:

    # n "Astragalus leans down to pick up Periwinkle's empty mug, then holds it out in front of him."
    n "Astragalus lehnt sich nach unten, um Periwinkles leere Tasse aufzuheben, dann hält sie sie ihm entgegen."

# game/script.rpy:3577
translate ger ch7_05b45148:

    # a happy "Try your magic again. Whatever scent you want, just pour it right in the cup."
    a happy "Wende deine Magie an. Welchen Duft auch immer du magst, lass ihn in diese Tasse fließen."

# game/script.rpy:3578
translate ger ch7_61f43815_1:

    # w hood ohhh "...."
    w hood ohhh "...."

# game/script.rpy:3582
translate ger ch7_bffebb26:

    # n "Periwinkle nervously draws his wand, holds it out to the cup... then closes his eyes, and taps."
    n "Periwinkle zückt nervös seinen Zauberstab und streckt ihn zur Tasse... dann schließt er die Augen und tippt."

# game/script.rpy:3585
translate ger ch7_62bd9f4e:

    # w hood ohhh2 "...Is it...?"
    w hood ohhh2 "...Ist es...?"

# game/script.rpy:3586
translate ger ch7_31d796dc:

    # a "...."
    a "...."

# game/script.rpy:3587
translate ger ch7_a378f6db:

    # a hm "Chamomile?"
    a hm "Kamille?"

# game/script.rpy:3588
translate ger ch7_a5fd1669:

    # w my "It isn't peach...!"
    w my "Es ist nicht Pfirsich...!"

# game/script.rpy:3589
translate ger ch7_48779aee:

    # w happy "I-I'm cured!!" with vpunch
    w happy "I-ich bin geheilt!!" with vpunch

# game/script.rpy:3590
translate ger ch7_c8bd051e:

    # a lol2 "Yeah, dumbass! Did you forget this is an apothecary?"
    a lol2 "Ja, Blödmann! Hast du vergessen, dass das eine Apotheke ist?"

# game/script.rpy:3591
translate ger ch7_15718a3f:

    # w ohdear "Ah... it is, isn't it...."
    w ohdear "Ah... ja, ist es wohl...."

# game/script.rpy:3592
translate ger ch7_21466243:

    # a eyeroll "Next time you've got a problem with your magic, don't sit around crying about it on your own. Come straight to me, and I'll fix you up."
    a eyeroll "Das nächste Mal, wenn du ein Problem mit deiner Magie hast, hock' nicht rum und heul' ganz allein."
    a "Komm direkt zu mir und ich mach dich wieder fit."

# game/script.rpy:3593
translate ger ch7_ba5c6de9:

    # w love "Thank you... I..."
    w love "Danke... Ich..."

# game/script.rpy:3594
translate ger ch7_44e91ae4:

    # w shy "I'm truly glad that we're friends... I would be lost without you."
    w shy "Ich bin wirklich froh, dass wir Freunde sind... ich wäre verloren ohne dich."

# game/script.rpy:3595
translate ger ch7_4ffcdd35:

    # a sure "Business associates. Don't forget I've got loads of orders for you now that you're back to normal."
    a sure "Geschäftspartner. Vergiss nicht, dass ich eine Menge Bestellungen für dich hab, jetzt, wo du wieder normal bist."

# game/script.rpy:3596
translate ger ch7_b19f23d3:

    # w happy "I'll go home and fill them right away! But first..."
    w happy "Ich werde nach Hause gehen und sie direkt abfüllen! Aber zuerst..."

# game/script.rpy:3597
translate ger ch7_9d2c05b0:

    # w love "May I hug you?"
    w love "Darf ich dich umarmen?"

# game/script.rpy:3598
translate ger ch7_04792b09:

    # a augh "Not a chance!" with vpunch
    a augh "Keine Chance!" with vpunch

# game/script.rpy:3599
translate ger ch7_d733da0f:

    # w teehee "Hmhm, it was worth a shot. You'll accept my platonic affection one day~!"
    w teehee "Hmhm, war einen Versuch wert. Eines Tages wirst du meine platonische Zuneigung akzeptieren~!"

# game/script.rpy:3600
translate ger ch7_7f7593b0:

    # a happy "Yeah, yeah... get outta my office, Periwinkle."
    a happy "Ja, ja... raus aus meinem Büro, Periwinkle."

# game/script.rpy:3607
translate ger ch7_875a28a9:

    # n "The pair exits the back room, but they only make it a few steps out before Periwinkle turns on his heel."
    n "Die beiden verlassen das Hinterzimmer, aber nach nur wenigen Schritten macht Periwinkle eine Kehrtwende."

# game/script.rpy:3608
translate ger ch7_4d17f35d:

    # w hood oh "Ah, one more thing, before I go..."
    w hood oh "Ah, eine Sache noch, bevor ich gehe..."

# game/script.rpy:3610
translate ger ch7_3f808ca6:

    # a "Hm? What's up."
    a "Hm? Was ist los?"

# game/script.rpy:3611
translate ger ch7_faf56b4e:

    # w smile "I've been curious to ask. The last time I was here, you told me that magic can be interpreted as a judge of one's character..."
    w smile "{size=-2}Was ich noch fragen wollte--als ich das letzte Mal hier war, hast du mir gesagt, über die Magie kann man den Charakter der anwendenden Person erkennen..."

# game/script.rpy:3612
translate ger ch7_09ac5a27:

    # a think "Oh, right. When I changed my mind about Pastille."
    a think "Ah, stimmt. Als ich meine Meinung über Pastille geändert hatte."

# game/script.rpy:3613
translate ger ch7_e02f8699:

    # w calm "Yes, precisely. It's rather impressive that you could see through to his true nature, despite having only just met..."
    w calm "Ja, genau. Es ist echt beeindruckend, dass du seine wahre Natur erkannt hast, obwohl ihr euch zum ersten Mal gesehen habt..."

# game/script.rpy:3614
translate ger ch7_d75c0f1f:

    # a lol "Sure, but he was pretty easy to read. Don't be too impressed."
    a lol "Klar, er war ja aber auch leicht zu lesen. Sei nicht zu beeindruckt."

# game/script.rpy:3615
translate ger ch7_7bba75e2:

    # w love "...Well?"
    w love "...Also?"

# game/script.rpy:3616
translate ger ch7_21235aed:

    # a lol2 "Well what?"
    a lol2 "Also was?"

# game/script.rpy:3617
translate ger ch7_665ef7a8:

    # w happy "What does my magic say about me~? I'm dying to know 💙"
    w happy "Was sagt meine Magie über mich aus~? Meine Neugier bringt mich noch um 💙"

# game/script.rpy:3618
translate ger ch7_f33dfb60:

    # a sure "YOUR magic... was always lively and carefree. Compassionate, too. Like Pastille's."
    a sure "DEINE Magie... war schon immer lebhaft und sorglos. Auch leidenschaftlich. Wie Pastilles."

# game/script.rpy:3619
translate ger ch7_08b17c47:

    # w love "How can you possibly read something like \"carefree\" from perfume?"
    w love "Wie kannst du denn so was wie \"sorglos\" aus einem Parfum herauslesen?"

# game/script.rpy:3620
translate ger ch7_e94ff0db:

    # a lol "Hey, I'm just telling you the vibes I've gotten over the years."
    a lol "Hey, ich sag dir nur, welche Schwingungen ich über die Jahre so erhalten habe."

# game/script.rpy:3621
translate ger ch7_a2de6d44:

    # a think "Your aromas prioritize pleasure. But there was definitely a hint of loneliness in them, too..."
    a think "Deine Düfte zielen auf Vergnügen ab. Aber da war definitiv auch eine Note der Einsamkeit in ihnen..."

# game/script.rpy:3622
translate ger ch7_d8043053:

    # w teehee "Alright, now I KNOW you're making things up. I've always had someone to keep me company 💙"
    w teehee "Alles klar, jetzt WEIß ich, dass du dir das ausdenkst. Ich hatte immer jemanden an meiner Seite 💙"

# game/script.rpy:3623
translate ger ch7_15310979:

    # a smile "Just because you've always got someone around doesn't mean you can't be lonely."
    a smile "Nur weil du immer jemanden um dich hast, heißt das nicht, dass du nicht auch einsam sein kannst."

# game/script.rpy:3624
translate ger ch7_c61d8bb7:

    # w calm "And I suppose someone like you would know a thing or two about loneliness, hm?"
    w calm "Und ich nehme an, jemand wie du weiß das Eine oder Andere über Einsamkeit, hm?"

# game/script.rpy:3625
translate ger ch7_c94c969b:

    # a hm "I'm not lonely at all. In fact, I PREFER to be alone."
    a hm "Ich bin überhaupt nicht einsam. Ich BEVORZUGE es sogar, alleine zu sein."

# game/script.rpy:3626
translate ger ch7_adf9c46f:

    # a closed "YOU on the other hand... can't stand it even for a second. That's why you'd always run off chasing someone to fill the void."
    a closed "{size=-2}DU dagegen... kannst es nicht mal eine Sekunde aushalten. Deshalb rennst du ständig rum und suchst jemanden, der das Loch ausfüllt."

# game/script.rpy:3627
translate ger ch7_cd947219:

    # w ohdear "...Well THAT certainly isn't true."
    w ohdear "...Also DAS entspricht sicher nicht der Wahrheit."

# game/script.rpy:3628
translate ger ch7_be244ae7:

    # a lol "The peach stuff you gave me earlier was PURE loneliness. It was crying out, like \"Please, Pastille, never leave me~!\""
    a lol "Das Pfirsichzeug von vorhin war PURE Einsamkeit. Es schrie förmlich \"Bitte, Pastille, verlasse mich niemals~!\""

# game/script.rpy:3629
translate ger ch7_27338eed:

    # w pout "This isn't fun anymore. Forget that I asked!"
    w pout "Das ist nicht mehr lustig. Vergiss, dass ich gefragt hab!"

# game/script.rpy:3630
translate ger ch7_11cf638a:

    # a happy "Sorry. Couldn't resist."
    a happy "Sorry. Konnte nicht widerstehen."

# game/script.rpy:3631
translate ger ch7_7623f766:

    # w oops "...."
    w oops "...."

# game/script.rpy:3632
translate ger ch7_b80c39a5:

    # w ohhh "I suppose you're right, though... I haven't been able to tell him that in words."
    w ohhh "Ich denke aber du hast recht... Ich war nicht in der Lage, ihm das in Worten zu sagen."

# game/script.rpy:3633
translate ger ch7_ad5bdd9e:

    # w nofair2 "I can't keep holding back... he has to know. No matter the outcome."
    w nofair2 "Ich kann mich nicht zurückhalten... er muss es wissen. Egal, wie es ausgeht."

# game/script.rpy:3634
translate ger ch7_60359fd7:

    # a smile "Good luck, okay? I'm sure it'll turn out just fine."
    a smile "Viel Glück, okay? Ich bin sicher, es wird alles gut werden."

# game/script.rpy:3635
translate ger ch7_a4d8dbdf:

    # w ohhh "Yes... yes, it likely will."
    w ohhh "Ja... ja, wahrscheinlich wird es das."

# game/script.rpy:3636
translate ger ch7_0f7a9daf:

    # w shy "Thank you again... I'm truly grateful for all that you've done for me."
    w shy "Danke nochmal... Ich schätze es wirklich sehr, was du alles für mich getan hast."

# game/script.rpy:3641
translate ger ch7_47504267:

    # n "Astragalus waves him off, and Periwinkle leaves the apothecary with new resolve..."
    n "Astragalus winkt ihm zum Abschied und Periwinkle verlässt die Apotheke mit einem neuen Entschluss..."

# game/script.rpy:3651
translate ger ch7_8954e2f7:

    # "I spent the next several days catching up on my work."
    "Ich verbrachte die nächsten paar Tage damit, meine Arbeit nachzuholen."

# game/script.rpy:3652
translate ger ch7_c124ee6b:

    # "Magic truly does come so easily with a clear mind! If only I'd swallowed my pride sooner."
    "Magie kommt wirklich einfach so mit einem klaren Verstand! Wenn ich meinen Stolz doch nur früher geschluckt hätte."
    nvl clear

# game/script.rpy:3653
translate ger ch7_1e30c6c5:

    # "I completed batch after batch almost effortlessly, going down the long checklist Astragalus had given me..."
    "Die lange Liste von Astragalus durchgehend, stellte ich fast mühelos Charge nach Charge fertig."

# game/script.rpy:3654
translate ger ch7_ba772060:

    # "I hadn't even felt tired by the end of it. As if all this energy had been stored up inside me all along!"
    "Ich hatte mich am Ende nicht mal müde gefühlt. Als hätte sich alle Energie doch die ganze Zeit in mir angestaut!"

# game/script.rpy:3655
translate ger ch7_2d728c30:

    # nvl clear
    # "It was a relief to return to somewhat normalcy."
    nvl clear
    "Es war eine Erleichterung, wieder zu etwas Normalität zurückzukehren."

# game/script.rpy:3657
translate ger ch7_e65838f7:

    # "Thinking of Pastille no longer caused my heart to ache... at least, not enough to put me in a state of total despondence."
    "An Pastille zu denken hat nicht länger für Herzschmerz gesorgt... zumindest nicht genug, um mich in einen Zustand der Niedergeschlagenheit zu versetzen."

# game/script.rpy:3658
translate ger ch7_b8bdf17b:

    # "Instead, those thoughts served as motivation. The way forward was clear."
    "Stattdessen dienten diese Gedanken als Motivation. Der Weg nach vorne war klar."

# game/script.rpy:3659
translate ger ch7_975f7c4e:

    # "I would tell him how I felt... and surely..."
    "Ich würde ihm sagen, wie ich fühlte... und bestimmt..."

# game/script.rpy:3660
translate ger ch7_38f5635f:

    # nvl clear
    # w pj calm "Surely things will turn out just fine...."
    nvl clear
    w pj calm "Bestimmt wird am Ende alles gut...."

# game/script.rpy:3665
translate ger ch7_94b11f24:

    # n "The following night... Pastille shows up on Periwinkle's doorstep."
    n "In der folgenden Nacht... taucht Pastille vor Periwinkles Türschwelle auf."

# game/script.rpy:3667
translate ger ch7_1810d3ec:

    # p "Get dressed. I wanna take you somewhere."
    p "Zieh dich an. Ich will dich wohin mitnehmen."

# game/script.rpy:3668
translate ger ch7_89d40548:

    # w pj happy "Oh~ and where exactly am I being whisked away to? 💙"
    w pj happy "Oh~ und wohin genau werde ich geführt? 💙"

# game/script.rpy:3669
translate ger ch7_f5ebb1d6:

    # p happy "You'll see. Wear comfortable shoes, okay?"
    p happy "Wirst schon sehen. Zieh dir gemütliche Schuhe an, okay?"

# game/script.rpy:3670
translate ger ch7_cd6c9ac9:

    # w calm "How mysterious..."
    w calm "Wie mysteriös..."

# game/script.rpy:3671
translate ger ch7_c60adcac:

    # w smile "Hmhm, very well. I'll be ready momentarily 💙"
    w smile "Hmhm, also gut. Ich bin sofort bereit 💙"

# game/script.rpy:3674
translate ger ch7_98348ebf:

    # "This is it..."
    "Das ist es nun..."

# game/script.rpy:3675
translate ger ch7_09cbb0da:

    # "The dramatic confession scene is upon us!"
    "Die dramatische Geständnisszene steht kurz bevor!"

# game/script.rpy:3676
translate ger ch7_e135b4c9:

    # "I have to look my best! For good luck, of course."
    "Ich muss mich von meiner besten Seite zeigen! Für das Glück, natürlich."

# game/script.rpy:3677
translate ger ch7_572f99bc:

    # "And for confidence...."
    "Und für den Mut...."

# game/script.rpy:3678
translate ger ch7_76b2fe88:

    # nvl clear
    nvl clear

# game/script.rpy:3690
translate ger ch7_28d525bc:

    # n "Hand in hand, the pair makes their way to the train station."
    n "Hand in Hand machen sich die beiden auf den Weg zum Bahnhof."

# game/script.rpy:3691
translate ger ch7_931bcf8a:

    # w cute innocent "(Hmhm~ had he been planning something while I was sequestered away with my work?)"
    w cute innocent "(Hmhm~ hatte er etwas geplant, während ich mich zum Arbeiten zurückgezogen hatte?)"

# game/script.rpy:3692
translate ger ch7_db582720:

    # w love "(Pastille is always so full of surprises... how positively delightful 💙)"
    w love "(Pastille ist immer so voller Überraschungen... wie überaus entzückend 💙)"

# game/script.rpy:3695
translate ger ch7_b5146a9c:

    # p "I hope I didn't interrupt any plans you had for the night...."
    p "Ich hoffe, ich habe keine Pläne für den Abend durchkreuzt...."

# game/script.rpy:3696
translate ger ch7_028375c7:

    # w happy "Oh, not at all~! It was about time I got out of the house again."
    w happy "Oh, keineswegs~! Es war echt an der Zeit, mal wieder aus dem Haus zu gehen."

# game/script.rpy:3697
translate ger ch7_dd0f85ec:

    # w smile "I've actually had a very productive past several days, you know. Toiling away over my perfumes."
    w smile "Ich hatte tatsächlich mal ein paar sehr produktive Tage, weißt du? Mich mit meinen Parfums abgeschuftet."

# game/script.rpy:3698
translate ger ch7_dcf1b0e8:

    # p ehe "Haha, I thought that might be the case, since you hadn't dropped by in a while."
    p ehe "Haha, ich dachte mir, dass es das sein würde, da du seit einer Weile nicht mehr vorbeigeschaut hast."

# game/script.rpy:3699
translate ger ch7_fb3a840a:

    # w innocent "Did you miss me? 💙"
    w innocent "Hast du mich vermisst? 💙"

# game/script.rpy:3700
translate ger ch7_13104245:

    # p embarrassed "W-well...."
    p embarrassed "N-nun...."

# game/script.rpy:3702
translate ger ch7_b1056d27:

    # n "Periwinkle hugs Pastille's arm tightly as they continue their walk."
    n "Periwinkle umklammert Pastilles Arm fest, während sie ihren Spaziergang fortsetzen."

# game/script.rpy:3703
translate ger ch7_9e455bb5:

    # w cute shy "(I missed you, too...)"
    w cute shy "(Ich habe dich auch vermisst...)"

# game/script.rpy:3706
translate ger ch7_92a9892d:

    # "When Pastille and I step off the train, we're greeted by grassy fields and a sky full of luminous stars."
    "Als Pastille und ich aus dem Zug steigen, werden wir von grasigen Feldern und einem Himmel voll leuchtender Sterne begrüßt."

# game/script.rpy:3707
translate ger ch7_1242c23a:

    # "Just where has he taken me...?"
    "Wohin hat er mich nur gebracht...?"

# game/script.rpy:3708
translate ger ch7_924bc4f2:

    # "A trail of lanterns lights the lone path forward..."
    "Eine Reihe Laternen beleuchtet den einsamen Pfad vor uns..."

# game/script.rpy:3709
translate ger ch7_27428714:

    # "Pastille takes the lead."
    "Pastille übernimmt die Führung."

# game/script.rpy:3710
translate ger ch7_76b2fe88_1:

    # nvl clear
    nvl clear

# game/script.rpy:3713
translate ger ch7_794d51f4:

    # p "It's a bit of a walk from here... but I promise it'll be worth it."
    p "Es ist ein längerer Weg ab hier... aber ich verspreche dir, es wird es wert sein."

# game/script.rpy:3714
translate ger ch7_dd9f0107:

    # w cute love "A long walk, hm? Couldn't we take a ride on your broom together~?"
    w cute love "Ein langer Weg, hm? Können wir nicht zusammen auf deinem Besen fliegen~?"

# game/script.rpy:3715
translate ger ch7_6e405e15:

    # p sure "Nah, it'd defeat the purpose. It'll feel more rewarding getting there on foot."
    p sure "Nee, das würde den Zweck verfehlen. Es wird sich lohnender anfühlen, es zu Fuß dorthin geschafft zu haben."

# game/script.rpy:3716
translate ger ch7_ebba887b:

    # w calm "Hmhm... fair enough. Tragic, though, that you'd willingly pass on an opportunity for me to cling to you."
    w calm "Hmhm... Na gut. Dennoch tragisch, dass du auf eine Gelegenheit verzichtest, in der ich mich an dich geklammert hätte."

# game/script.rpy:3717
translate ger ch7_34a0afcc:

    # p ehe "Haha, we can fly on the way back if you want."
    p ehe "Haha, wir können auf dem Rückweg fliegen, wenn du magst."

# game/script.rpy:3719
translate ger ch7_4f263e5f:

    # n "Pastille offers his hand again, which Periwinkle takes with a smile."
    n "Pastille bietet wieder seine Hand an, die Periwinkle mit einem Lächeln annimmt."

# game/script.rpy:3724
translate ger ch7_59ddd814:

    # w "...Tell me more about your relationship with magic."
    w "...Erzähl mir mehr über deinen Bezug zur Magie."

# game/script.rpy:3725
translate ger ch7_2528ce76:

    # p "Hm? What do you mean?"
    p "Hm? Was meinst du?"

# game/script.rpy:3726
translate ger ch7_3c167982:

    # w "It was the same when we cleaned my house together. You insisted on doing things manually..."
    w "Es war das gleiche wie zusammen mein Haus zu reinigen. Du hast darauf bestanden, es manuell zu machen..."

# game/script.rpy:3727
translate ger ch7_7c5e0bd7:

    # w "Not that I minded at all. Seeing you lift so many heavy things was a treat in itself 💙"
    w "Nicht, dass ich was dagegen hatte. Dich so viele schwere Dinge heben zu sehen, war an sich schon eine Belohnung 💙"

# game/script.rpy:3728
translate ger ch7_4caf8895:

    # p "Hahaha, well..."
    p "Hahaha, na ja..."

# game/script.rpy:3729
translate ger ch7_10f7805a:

    # p "Ever since I was young... it was clear I was, um... \"ridiculously talented\", as they'd put it."
    p "Seit ich jung war... ist mir bewusst, dass ich, ähm... \"sautalentiert\" bin, wie sie es ausgedrückt haben."

# game/script.rpy:3730
translate ger ch7_e85247dc:

    # p "My moms wanted me to be a traditional witch. They enrolled me in one of the top schools, so I could learn from the best."
    p "Meine Mütter wollten, dass ich eine traditionelle Hexe werde."
    p "Sie haben mich in einer der besten Schulen angemeldet, damit ich von den Besten lernen konnte."

# game/script.rpy:3732
translate ger ch7_0b59e908:

    # p "I-it was an all-girls school, though... Guess I was young enough that no one realized I was a boy."
    p "{size=-2}E-es war allerdings eine reine Mädchenschule... Vermutlich war ich jung genug, sodass mich niemand für einen Jungen hielt."

# game/script.rpy:3733
translate ger ch7_c1703821:

    # p "I really... didn't belong there. On any level."
    p "Ich habe... da wirklich nicht reingepasst. Auf keine Weise."

# game/script.rpy:3734
translate ger ch7_fa8d2d79:

    # p "But, I kept at it as long as I could. Just enough to keep my parents happy, until I could go out and live on my own."
    p "Aber ich habe es so lange ich konnte aufrechterhalten."
    p "Gerade genug, um meine Eltern glücklich sein zu lassen, bis ich auf eigenen Beinen stehen konnte."

# game/script.rpy:3736
translate ger ch7_73d8e924:

    # p "Haha, I still don't understand exactly why... but I always felt uncomfortable using my magic."
    p "Haha, ich verstehe immer noch nicht genau warum... aber es war immer unangenehm, meine Magie zu benutzen."

# game/script.rpy:3737
translate ger ch7_b1a584dd:

    # p "It felt like cheating. Like... this kind of power shouldn't come so easily."
    p "Es fühlte sich wie schummeln an. Diese Art von Kraft sollte halt nicht so einfach da sein."

# game/script.rpy:3738
translate ger ch7_f94b0797:

    # p "Sy thought so, too. I guess that's why I latched onto her when we met..."
    p "Sy dachte auch so. Ich nehme an, das ist, warum ich mich an sie gehängt habe, als wir uns kennenlernten..."

# game/script.rpy:3739
translate ger ch7_b940b2af:

    # p "She used to really hate magic. Which worked out perfectly for me--it was a good excuse to pretend to be a regular human like her."
    p "Sie hat Magie mal wirklich gehasst. Was perfekt für mich war--"
    p "Es war ein guter Vorwand, um auf normaler Mensch zu machen, wie sie einer ist."

# game/script.rpy:3740
translate ger ch7_e058bb72:

    # p "So... that's what I did. For the past... seven years?"
    p "Und... das hab ich dann getan. Für die letzten... sieben Jahre?"

# game/script.rpy:3743
translate ger ch7_fe2bf237:

    # w cute my "Seven years... that's quite a long time!"
    w cute my "Sieben Jahre... das ist eine ganz schön lange Zeit!"

# game/script.rpy:3745
translate ger ch7_4d057338:

    # p "Yeah, but there was a lot to distract me back then... it took a while to get Atelier Sweets up and running."
    p "Joa, aber es gab damals eine Menge Ablenkungen... es dauerte eine Weile, das Atelier Sweets zum Laufen zu kriegen."

# game/script.rpy:3746
translate ger ch7_dc3c7909:

    # p calm "And... Sy did eventually find out. I thought she'd disown me when she did..."
    p calm "Und... Sy hatte es irgendwann herausgefunden. Ich dachte, sie würde mich rausschmeißen..."

# game/script.rpy:3747
translate ger ch7_c13fd2df:

    # p ehe "But instead... she told me I shouldn't have hid it. Even though I doubt we would've become friends if I told her from the beginning..."
    p ehe "Aber stattdessen... hat sie mir gesagt, ich hätte es nicht verstecken sollen."
    p "Auch wenn ich bezweifle, dass wir überhaupt Freunde geworden wären, hätte ich ihr von Anfang an davon erzählt..."

# game/script.rpy:3748
translate ger ch7_53e2aed6:

    # w calm "Quite impossible to please, hm?"
    w calm "Ziemlich unmöglich zufriedenzustellen, hm?"

# game/script.rpy:3749
translate ger ch7_03a0e69e:

    # p sure "You have no idea...."
    p sure "Du hast keine Ahnung...."

# game/script.rpy:3750
translate ger ch7_6dc476af:

    # p smile "But... ever since she said that, I've been able to start embracing magic again. On my own terms."
    p smile "Aber... seitdem war ich in der Lage, Magie wieder wertzuschätzen. Auf meine Weise."

# game/script.rpy:3751
translate ger ch7_3832c226:

    # w "(I'm beginning to grasp why he values her so highly...)"
    w "(Ich fange an zu begreifen, warum er sie so hoch schätzt...)"

# game/script.rpy:3752
translate ger ch7_ff5b5b21:

    # p ohno "Um, sorry that I just keep talking about myself...."
    p ohno "Ähm, sorry, dass ich nur über mich selbst rede...."

# game/script.rpy:3753
translate ger ch7_d3905dce:

    # w happy "Don't apologize~! I'm the one who asked."
    w happy "Entschuldige dich nicht~! Ich habe ja gefragt."

# game/script.rpy:3754
translate ger ch7_7c140cec:

    # w smile "Besides, I'm content to listen. Say as much as you like."
    w smile "Davon abgesehen bin ich zufrieden, einfach nur zuzuhören. Sag so viel du magst."

# game/script.rpy:3755
translate ger ch7_acb13031:

    # p embarrassed "Thanks...."
    p embarrassed "Danke...."

# game/script.rpy:3758
translate ger ch7_ea22c411:

    # n "Periwinkle gives Pastille's hand a reassuring squeeze."
    n "Periwinkle gibt Pastilles Hand einen versichernden Druck."

# game/script.rpy:3760
translate ger ch7_6ce8c1d1:

    # "I love him..."
    "Ich liebe ihn..."

# game/script.rpy:3761
translate ger ch7_aa288728:

    # "I have to find the right moment to tell him that."
    "Ich muss den richtigen Moment finden, es ihm zu sagen."

# game/script.rpy:3762
translate ger ch7_973b0143:

    # "Should it be now? During this romantic walk?"
    "Sollte es jetzt sein? Während des romantischen Spaziergangs?"

# game/script.rpy:3763
translate ger ch7_34c7c040:

    # "Ah, but he still has yet to reveal our destination..."
    "Ah, aber er hat immer noch nicht unser Ziel verraten..."

# game/script.rpy:3764
translate ger ch7_87cfcf28:

    # "What do you have in store for me, Pastille...?"
    "Was hast du da nur geplant, Pastille...?"

# game/script.rpy:3765
translate ger ch7_76b2fe88_2:

    # nvl clear
    nvl clear

# game/script.rpy:3768
translate ger ch7_cd548b59:

    # p "I think I might be too used to how Sy is... she's usually so preoccupied with her own stuff."
    p "Ich denke, ich bin zu sehr dran gewöhnt, wie Sy ist... sie ist immer so beschäftigt mit ihren eigenen Sachen."

# game/script.rpy:3769
translate ger ch7_e4e3ea32:

    # p smile "So it's nice... having someone who actually wants to listen to me."
    p smile "Es ist also schön... jemanden zu haben, der wirklich zuhören möchte."

# game/script.rpy:3770
translate ger ch7_63040b81:

    # p flustered2 "Agh, that makes her sound like such a horrible friend...! She's really not!!" with vpunch
    p flustered2 "Agh, das klingt so, als wäre sie eine schlechte Freundin...! Das ist sie wirklich nicht!!" with vpunch

# game/script.rpy:3771
translate ger ch7_0bd17d69:

    # w cute happy "You certainly haven't made a convincing case for her~!"
    w cute happy "Klingt jedenfalls nicht sehr überzeugend~!"

# game/script.rpy:3772
translate ger ch7_92bac40c:

    # p calm "*sigh* I know. But that wasn't the point I was trying to make..."
    p calm "*seufz* Ich weiß. Aber das war auch nicht, worauf ich hinaus wollte..."

# game/script.rpy:3773
translate ger ch7_cb1d6efd:

    # w oh "Oh?"
    w oh "Oh?"

# game/script.rpy:3774
translate ger ch7_6f213e95:

    # p ohno2 "I really...!"
    p ohno2 "Es ist wirklich...!"

# game/script.rpy:3775
translate ger ch7_2ddcc144:

    # p flustered2 "...."
    p flustered2 "...."

# game/script.rpy:3776
translate ger ch7_5793c0e9:

    # w love "Yes...?"
    w love "Ja...?"

# game/script.rpy:3777
translate ger ch7_bd8caf25:

    # p seriously "Let me start over."
    p seriously "Lass mich von vorn beginnen."

# game/script.rpy:3780
translate ger ch7_4457e2ee:

    # n "Pastille takes a deep breath before continuing..."
    n "Pastille atmet tief durch, bevor er fortfährt..."

# game/script.rpy:3781
translate ger ch7_3c52a2e3:

    # p wha "Going back to... what we were talking about before. With my magic and everything."
    p wha "Zurück zu dem... worüber wir vorher gesprochen haben. Mit meiner Magie und allem."

# game/script.rpy:3782
translate ger ch7_b651cf3a:

    # p think "I think I have trouble accepting myself for what I am... I tend to hide things, even when I don't need to."
    p think "{size=-2}Ich denke, ich habe Probleme mich für das zu akzeptieren, was ich bin... Ich tendiere dazu, Dinge zu verstecken, \"auch wenn ich\" gar nicht müsste."

# game/script.rpy:3783
translate ger ch7_8c631518:

    # p oh "Being with YOU feels like... it's better not to hide? Like, I'm allowed to just BE."
    p oh "Aber mit DIR ist es... besser, nichts zu verstecken? Ich meine, mir ist es gestattet, einfach zu SEIN."

# game/script.rpy:3784
translate ger ch7_bd2d007a:

    # p shy "Or, more like... celebrated? For being? I-I don't know, that feels weird to say."
    p shy "Oder eher... gefeiert? Fürs Sein? I-ich weiß nicht, fühlt sich komisch an, das zu sagen."

# game/script.rpy:3785
translate ger ch7_f3a624fa:

    # w cute wow "...."
    w cute wow "...."

# game/script.rpy:3786
translate ger ch7_a1e89604:

    # p ehe "Y-you can stop me if I'm being too much...."
    p ehe "D-du kannst mich unterbrechen, wenn es zu viel ist...."

# game/script.rpy:3787
translate ger ch7_cb9e5642:

    # w nofair2 "(IT'S BECAUSE I LOVE YOU...! Why can't I just say that...?!)" with vpunch
    w nofair2 "(ES IST SO, WEIL ICH DICH LIEBE...! Wieso kann ich das nicht einfach sagen...?!)" with vpunch

# game/script.rpy:3789
translate ger ch7_0e54bcb0:

    # p smile "Oh! We're here!"
    p smile "Oh! Wir sind da!"

# game/script.rpy:3790
translate ger ch7_f344f25d:

    # w my "W-we are...?"
    w my "S-sind wir...?"

# game/script.rpy:3799
translate ger ch7_01fc1362:

    # "When we came up over the hill..."
    "Als wir über den Hügel kamen..."

# game/script.rpy:3800
translate ger ch7_5d572078:

    # "The vastness of the night sky overwhelmed me."
    "Hat mich die Weite des Nachthimmels überwältigt."

# game/script.rpy:3801
translate ger ch7_38f127a1:

    # "But more than that..."
    "Aber viel mehr noch..."

# game/script.rpy:3802
translate ger ch7_6294189d:

    # "The field of small blue flowers, that stretched as far as the eye could see..."
    "Das Feld aus kleinen blauen Blumen, das sich ausbreitete, so weit das Auge reichte..."

# game/script.rpy:3803
translate ger ch7_69330f7d:

    # "Matched it so perfectly."
    "Passte perfekt dazu."

# game/script.rpy:3804
translate ger ch7_76b2fe88_3:

    # nvl clear
    nvl clear

# game/script.rpy:3808
translate ger ch7_c19eb018:

    # w cute shock "Pastille...!"
    w cute shock "Pastille...!"

# game/script.rpy:3811
translate ger ch7_00d275ec:

    # p "They're periwinkles. When I looked up where to find some... I found out about this place."
    p "Das sind Immergrün. Als ich geschaut habe, wo man welche finden kann... habe ich von diesem Ort erfahren."
    n "\[Anmerkung: Immergrün heißen auf englisch \"periwinkle(s)\"\]"

# game/script.rpy:3812
translate ger ch7_36ad9faf:

    # p doki "A-apparently it's a famous date spot... I thought you'd like to see it, so...."
    p doki "A-anscheinend ist das ein beliebter Ort für Dates... Ich dachte, vielleicht magst du ihn sehen, also...."

# game/script.rpy:3814
translate ger ch7_3d805e46:

    # w "I... I-I...!"
    w "Ich... I-ich...!"

# game/script.rpy:3815
translate ger ch7_8adde88a:

    # w whine2 "I shouldn't have told you I'm weak to romance...!! Pastille!!!" with vpunch
    w whine2 "Ich hätte dir nicht sagen sollen, dass Romantik meine Schwäche ist...!! Pastille!!!" with vpunch

# game/script.rpy:3819
translate ger ch7_05c9cbbc:

    # n "A glint catches Periwinkle's eye,{nw}"
    n "Ein Funkeln liegt in Periwinkles Auge,{nw}"

# game/script.rpy:3821
translate ger ch7_a8567a09:

    # extend " and he looks up to notice... a meteor shower has begun."
    extend " und er schaut nach oben, um zu bemerken... dass ein Sternschnuppenschauer zu sehen war."

# game/script.rpy:3823
translate ger ch7_73f1a48a:

    # w my "Ah...!"
    w my "Ah...!"

# game/script.rpy:3824
translate ger ch7_559af831:

    # p happy "Oh, good! It started just in time...."
    p happy "Oh, gut! Es hat genau richtig angefangen...."

# game/script.rpy:3825
translate ger ch7_060caff3:

    # w shock "You planned this, too?!" with vpunch
    w shock "Das hast du ebenfalls geplant?!" with vpunch

# game/script.rpy:3826
translate ger ch7_a08d1d6b:

    # p embarrassed "Well, I knew this was supposed to be happening tonight... so...."
    p embarrassed "Nun, ich wusste, dass es heute Nacht passieren soll... also...."

# game/script.rpy:3831
translate ger ch7_e01493c6:

    # w overwhelmed "PASTILLE!!!!!!!"
    w overwhelmed "PASTILLE!!!!!!!"

# game/script.rpy:3833
translate ger ch7_b1a81c31:

    # p "WAH--!!" with vpunch
    p "WAH--!!" with vpunch

# game/script.rpy:3838
translate ger ch7_e7ad4e10:

    # n "Periwinkle tackles Pastille to the ground, landing them in the field of flowers..."
    n "Periwinkle wirft sich auf Pastille, sodass beide im Meer aus Blumen landen..."

# game/script.rpy:3842
translate ger ch7_993f86f6:

    # w "This is perfect..."
    w "Das ist perfekt..."

# game/script.rpy:3843
translate ger ch7_29d90c6e:

    # w "I-I don't know what else to say...! I'm speechless...."
    w "I-ich weiß nicht, was ich sonst sagen soll...! Ich bin sprachlos...."

# game/script.rpy:3844
translate ger ch7_74dc2d6c:

    # p "Haha, I guess I went a little overboard...."
    p "Haha, ich bin wohl etwas übers Ziel hinausgeschossen...."

# game/script.rpy:3845
translate ger ch7_71a07f4f:

    # w "A little?! This is the most romantic thing anyone's ever done for me!!!" with vpunch
    w "Ein bisschen?! Das ist das Romantischste, was jemals irgendjemand für mich getan hat!!!" with vpunch

# game/script.rpy:3846
translate ger ch7_e978b8e5:

    # n "He buries his face in Pastille's chest, holding him close."
    n "Er vergräbt sein Gesicht in Pastilles Brust und hält ihn fest an sich gedrückt."

# game/script.rpy:3847
translate ger ch7_16aecb80:

    # p "Well... there's actually... one more thing I wanted to say."
    p "Nun... da ist tatsächlich... noch eine weitere Sache, die ich sagen wollte."

# game/script.rpy:3849
translate ger ch7_2f9a6199:

    # n "He can feel Pastille's heart pounding."
    n "Er kann fühlen, wie Pastilles Herz pocht."

# game/script.rpy:3850
translate ger ch7_3890f9c5:

    # p "Ahh, where do I start... um...."
    p "Aah, wo fang ich nur an... ähm...."

# game/script.rpy:3851
translate ger ch7_e74b39bd:

    # p "You know how... Sy and Gumdrop are really important to me?"
    p "Du weißt ja... dass Sy und Gumdrop mir wirklich wichtig sind?"

# game/script.rpy:3852
translate ger ch7_d67e120d:

    # p "I always thought that I needed to keep myself available for them. To take care of the store and everything."
    p "Ich dachte immer, ich dürfte mich nur diesen beiden verschreiben. Mich um den Laden kümmern und so."

# game/script.rpy:3853
translate ger ch7_2ebc1e5f:

    # p "But in practice, that just meant... I never really took any time for myself."
    p "Aber eigentlich hieß das immer nur... ich hatte mir nie wirklich Zeit für mich selbst genommen."

# game/script.rpy:3854
translate ger ch7_dc57cb02:

    # p "Like, my own needs were something I could just bury, and it would be fine... because it's for their sake."
    p "Als wären meine eigenen Bedürfnisse etwas, das ich einfach vergraben kann und es wäre in Ordnung... Weil es ja ihnen zuliebe ist."

# game/script.rpy:3856
translate ger ch7_3e7da720:

    # p "I guess that's part of why... I'd go out with random guys in secret. As something just for me, totally detached from everything else."
    p "Ich denke, das ist mit ein Grund... wieso ich heimlich mit beliebigen Typen ausgegangen bin."
    p "Als etwas, das nur für mich war, völlig losgelöst von allem anderen."

# game/script.rpy:3857
translate ger ch7_a24acfbd:

    # p "I tried... having a real relationship once. It didn't work out, obviously. I-I never told Sy about him..."
    p "Ich hab es mal... mit einer richtigen Beziehung probiert. Es hat offensichtlich nicht geklappt. I-ich habe Sy nie davon erzählt..."

# game/script.rpy:3858
translate ger ch7_4e3c6695:

    # p "But that made me think... that I was right to continue on the way I had been. Since I wasn't willing to let my priorities shift."
    p "Aber das brachte mich dazu, zu denken... dass es richtig war, so weiterzumachen wie bisher."
    p "Nachdem ich nicht dazu bereit war, an meinen Prioritäten irgendetwas zu ändern."

# game/script.rpy:3859
translate ger ch7_03dafb87:

    # n "Periwinkle grips Pastille's cloak a little tighter."
    n "Periwinkle greift Pastilles Umhang etwas fester."

# game/script.rpy:3860
translate ger ch7_8f89c97b:

    # w "Wh-what are you saying...?"
    w "Wa-was willst du damit sagen...?"

# game/script.rpy:3861
translate ger ch7_ed9ffa87:

    # p "I guess, um... that, with you... I don't mind it as much."
    p "Ich vermute, ähm... dass es mir mit dir... nicht so viel ausmacht."

# game/script.rpy:3868
translate ger ch7_1b31e9f8:

    # "H-he's... he's going to beat me to it at this rate!!"
    "E-er... wird es vor mir sagen, wenn das so weiter geht!!"

# game/script.rpy:3869
translate ger ch7_5760d7ef:

    # "I-I can't let that happen...!"
    "D-das kann ich nicht zulassen...!"

# game/script.rpy:3870
translate ger ch7_e860da44:

    # nvl clear
    # n "Periwinkle suddenly rolls himself on top of Pastille, pinning him down."
    nvl clear
    n "Periwinkle rollt sich plötzlich auf Pastille und hält ihn unten."

# game/script.rpy:3875
translate ger ch7_e3a3d605:

    # w "Pastille, I'm in love with you!!!"
    w "Pastille, ich bin in dich verliebt!!!"

# game/script.rpy:3876
translate ger ch7_3353d4b4:

    # p "Wh-wha--??!?!? S-since when?!" with vpunch
    p "W-wa--??!?!? S-seit wann?!" with vpunch

# game/script.rpy:3878
translate ger ch7_d08ef308:

    # w "I-I don't know, maybe this whole time?!"
    w "I-ich weiß nicht, vielleicht schon die ganze Zeit?!"

# game/script.rpy:3879
translate ger ch7_fc9fe40d:

    # w "I only admitted it to myself that morning you made me pancakes...."
    w "Ich hab es mir selbst erst eingestanden, als du an dem einen Morgen Pfannkuchen für mich gemacht hattest...."

# game/script.rpy:3881
translate ger ch7_69ecef14:

    # p "That's what it took..?"
    p "Das hat es also gebraucht..?"

# game/script.rpy:3882
translate ger ch7_72ea541b:

    # w "Why? How long have YOU felt this way?"
    w "Wieso? Wie lang fühlst DU schon so?"

# game/script.rpy:3884
translate ger ch7_1e470d14:

    # p "Since... having to carry you home, after spending the day together? I think that's when I first realized it..."
    p "Seit... ich dich nach Hause tragen musste, nachdem wir den Tag zusammen verbracht haben?"
    p "Ich denke, das war der Zeitpunkt, an dem ich es zum ersten Mal realisiert hatte..."

# game/script.rpy:3885
translate ger ch7_f1180398:

    # w "Then why didn't you say something?! I've been suffering in silence this entire time...!" with vpunch
    w "Warum hast du dann nichts gesagt?! Ich habe die ganze Zeit im Stillen gelitten...!" with vpunch

# game/script.rpy:3887
translate ger ch7_350e8d77:

    # p "I-I thought you wanted to keep it casual...?"
    p "I-ich dachte, du wolltest es locker bleiben lassen...?"

# game/script.rpy:3888
translate ger ch7_2ded0261:

    # w "We saw each other almost every day!! How is that casual?!"
    w "Wir haben uns fast täglich gesehen!! Wie ist das locker?!"

# game/script.rpy:3889
translate ger ch7_8f5651d3:

    # p "But you never acted any differently...! A-and I was busy sorting through my own feelings anyway...."
    p "Aber du hast dich nie anders verhalten...! U-und ich war sowieso damit beschäftigt, meine eigenen Gefühle einzuordnen...."

# game/script.rpy:3891
translate ger ch7_8cca7f14:

    # w "Mmmnnnnnn...!!!!!!! So was I...."
    w "Mmmmnnnn...!!!!! Also war ich...."

# game/script.rpy:3892
translate ger ch7_56b8e860:

    # w "But that's no excuse for how long you kept me waiting...! I-I won't forgive you!"
    w "Aber das ist keine Entschuldigung dafür, wie lang du mich hast warten lassen...! D-das werde ich dir nicht verzeihen!"

# game/script.rpy:3894
translate ger ch7_d5c67421:

    # p "...."
    p "...."

# game/script.rpy:3895
translate ger ch7_47bd51eb:

    # w "Wh-what...? Why are you smiling like that?"
    w "W-was...? Wieso lächelst du so?"

# game/script.rpy:3896
translate ger ch7_fbb1d3e9:

    # p "It's cute... seeing you all worked up like this."
    p "Es ist süß... dich so aufgeregt zu sehen."

# game/script.rpy:3897
translate ger ch7_ae85e999:

    # w "--!!"
    w "--!!"

# game/script.rpy:3900
translate ger ch7_ed75769f:

    # n "Periwinkle struggles to his feet and begins stomping away."
    n "Periwinkle rappelt sich auf und stapft davon."

# game/script.rpy:3902
translate ger ch7_f6c38887:

    # w cute nofair2 "Y-you could've saved me a lot of heartache, you know...!"
    w cute nofair2 "D-du hättest mir eine Menge Herzschmerz ersparen können, weißt du...!"

# game/script.rpy:3903
translate ger ch7_7dc24b88:

    # n "Pastille sits up, straightening out his cloak and retrieving his hat."
    n "Pastille setzt sich auf, glättet seinen Umhang und nimmt seinen Hut."

# game/script.rpy:3906
translate ger ch7_ff9468ab:

    # p "Where are you going...? Come back."
    p "Wo gehst du hin...? Komm zurück."

# game/script.rpy:3907
translate ger ch7_f6894d83:

    # w nofair "No!! I'm too upset!" with vpunch
    w nofair "Nein!! Ich bin zu sauer!" with vpunch

# game/script.rpy:3908
translate ger ch7_ff48b4a6:

    # p ehe "Peri...."
    p ehe "Peri...."

# game/script.rpy:3909
translate ger ch7_34963f72:

    # w yell "I was convinced... CONVINCED, that I'd cursed myself with some kind of love potion! My fake aphrodisiac turned real!"
    w yell "Ich war überzeugt... ÜBERZEUGT, dass ich mich selbst mit einer Art Liebestrank verflucht hatte!"
    w "Dass mein falsches Aphrodisiakum doch echt geworden war!"

# game/script.rpy:3910
translate ger ch7_c9c42113:

    # p "What in the world...?"
    p "Was um alles in der Welt...?"

# game/script.rpy:3911
translate ger ch7_ca056bf8:

    # w "Because we didn't fuck that day! Fucking was supposed to be the entire point of it!!" with vpunch
    w "Weil wir an diesem Tag nicht gefickt haben! Ficken war doch der Zweck davon!!" with vpunch

# game/script.rpy:3912
translate ger ch7_03d3511b:

    # p dying "P-PERI...!"
    p dying "P-PERI...!"

# game/script.rpy:3913
translate ger ch7_21cbb225:

    # w nofair2 "Everything spiraled out of control since then...! I couldn't stop thinking about you!!"
    w nofair2 "Alles ist seitdem außer Kontrolle geraten...! Ich konnte nicht aufhören, an dich zu denken!!"

# game/script.rpy:3914
translate ger ch7_c400f965:

    # w yell "You BROKE my magic! For weeks and weeks, all I could conjure was that stupid peach blossom scent...!"
    w yell "Du hast meine Magie KAPUTT gemacht! Über Wochen hinweg konnte ich nur diesen blöden Pfirsichduft herstellen...!"

# game/script.rpy:3915
translate ger ch7_b704fa44:

    # p woah "A-ah... really...?"
    p woah "A-ah... wirklich...?"

# game/script.rpy:3916
translate ger ch7_b58af626:

    # w nofair2 "Yes! Until just the other day... which I spent CRYING, in the dusty back room of the apothecary, telling Astragalus all about it...!"
    w nofair2 "Ja! Bis zu dem Tag vor kurzem... den ich HEULEND im staubigen Hinterzimmer der Apotheke zugebracht hab."
    w "Da habe ich Astragalus alles darüber erzählt...!"

# game/script.rpy:3917
translate ger ch7_03175381:

    # w nofair "After all that... everything I spent so long preparing my heart for... you have the NERVE to try to confess first...?!"
    w nofair "Nach all dem... worauf ich mein Herz so lange vorbereitet habe... hast du die NERVEN, zuerst gestehen zu wollen...?!"

# game/script.rpy:3918
translate ger ch7_ea73974b:

    # p aw "I'm sorry."
    p aw "Tut mir leid."

# game/script.rpy:3919
translate ger ch7_4abce74d:

    # w nofair2 "Don't apologize! I already said I won't forgive you!!" with vpunch
    w nofair2 "Entschuldige dich nicht! Ich sagte bereits, dass ich dir nicht vergeben werde!" with vpunch

# game/script.rpy:3920
translate ger ch7_937c48a8:

    # p ehe "What do you want me to do, then...?"
    p ehe "Was soll ich denn dann tun...?"

# game/script.rpy:3921
translate ger ch7_2af101c3:

    # w insulted "I don't know, fucking kiss me if you love me so much!!!"
    w insulted "Ich weiß nicht, küss mich, verdammt nochmal, wenn du mich so sehr liebst!!!"

# game/script.rpy:3929
translate ger ch7_71e3c067:

    # n "Pastille approaches, gently raising a hand to Periwinkle's cheek..."
    n "Pastille nähert sich, hebt seine Hand sanft an Periwinkles Wange..."

# game/script.rpy:3931
translate ger ch7_c2b3fc7a:

    # n "...and does exactly as he's told."
    n "...und macht genau das, was ihm gesagt wurde."

# game/script.rpy:3933
translate ger ch7_58024a15:

    # p "I love you."
    p "Ich liebe dich."

# game/script.rpy:3934
translate ger ch7_dde4b08e:

    # n "Periwinkle's heart skips a beat."
    n "Periwinkles Herz setzt einen Schlag aus."

# game/script.rpy:3936
translate ger ch7_2c91cb68:

    # w "I love you, too...!"
    w "Ich liebe dich auch...!"

# game/script.rpy:3937
translate ger ch7_ff617e74:

    # n "He hugs Pastille tightly, careful not to knock him over this time."
    n "Er umarmt Pastille fest und passt auf, ihn diesmal nicht umzureißen."

# game/script.rpy:3944
translate ger ch7_33de9d18:

    # "It takes everything I've got to keep myself from bursting into tears."
    "Es verlangt mir alles ab, jetzt nicht in Tränen auszubrechen."

# game/script.rpy:3945
translate ger ch7_57e13493:

    # "I won't ruin my makeup on this perfect date...!"
    "Ich werde auf diesem perfekten Date mein Make-Up nicht ruinieren...!"

# game/script.rpy:3946
translate ger ch7_1c5f0457:

    # "This beautiful place, that Pastille chose just for us..."
    "Dieser schöne Ort, den Pastille für uns ausgesucht hat..."

# game/script.rpy:3947
translate ger ch7_bc3b2ea7:

    # "I can't have my memory of this perfect night obscured by tears...."
    "Ich kann meine Erinnerung an diesen perfekten Abend nicht durch Tränen verschleiern lassen...."

# game/script.rpy:3948
translate ger ch7_76b2fe88_4:

    # nvl clear
    nvl clear

# game/script.rpy:3954
translate ger ch7_ec2dd684:

    # p "It looks like the meteor shower's over...."
    p "Sieht aus, als wäre der Sternschnuppenschauer vorbei...."

# game/script.rpy:3955
translate ger ch7_75d5ddf8:

    # w cute pout "...Take me home...."
    w cute pout "...Bring mich nach Hause...."

# game/script.rpy:3956
translate ger ch7_8bb2e9cd:

    # p ehe "A-are you still mad at me...?"
    p ehe "B-bist du immer noch sauer auf mich...?"

# game/script.rpy:3957
translate ger ch7_5b794844:

    # w oops "I'm not mad at you...."
    w oops "Ich bin nicht sauer auf dich..."

# game/script.rpy:3958
translate ger ch7_16f5b969:

    # p aw "I've never seen you like this. I don't know how else I should interpret it."
    p aw "Ich habe dich noch nie so gesehen. Ich weiß nicht, wie ich das sonst interpretieren soll."

# game/script.rpy:3959
translate ger ch7_f5a91280:

    # w conflicted "I'm overwhelmed. Elated... relieved... and frustrated...."
    w conflicted "Ich bin überwältigt. Beschwingt... erleichtert... und frustriert.... "

# game/script.rpy:3960
translate ger ch7_8b592c68:

    # w ohhh "I-I want to get in bed... so that you can hold me close all night..."
    w ohhh "I-ich will ins Bett... damit du mich die ganze Nacht ganz nah halten kannst..."

# game/script.rpy:3961
translate ger ch7_ad678a44:

    # w ohhh2 "I don't think I'll be convinced that this was real unless you do that. So... please...?"
    w ohhh2 "Ich denke nicht, dass ich überzeugt sein werde, dass das hier echt war, wenn du das nicht machst. Also... bitte...?"

# game/script.rpy:3962
translate ger ch7_9cd2e04f:

    # p doki "That sounds... really nice...."
    p doki "Das klingt... wirklich schön...."

# game/script.rpy:3963
translate ger ch7_23f5322d:

    # p happy "Okay ❤ If it's to convince you, I guess I have no choice...."
    p happy "Okay ❤ Wenn es dazu dient, dich zu überzeugen, dann hab ich wohl keine Wahl...."

