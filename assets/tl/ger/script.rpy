translate ger ch3_bf1c7745:

    # a think "Mm... Sounds like you just have less self-respect, and this guy isn't treating you right."
    a think "Mm... Klingt so, als hättest du weniger Selbstachtung, und dieser Typ behandelt dich nicht richtig."

# game/script.rpy:1405
translate ger ch3_ec693909:

    # w pout "Now THAT'S unfair. He simply said he wasn't READY--it doesn't mean..."
    w pout "DAS ist jetzt unfair. Er meinte einfach nur, er sei nicht BEREIT--das heißt nicht..."

# game/script.rpy:1406
