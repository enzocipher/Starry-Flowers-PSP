    w cute whine2 "Versehentlich!! Du lässt den wichtigsten Punkt immer aus..."

# game/script.rpy:1393
translate ger ch3_2ed789cb:

    # a whatever "And now you think it's over between you two."
    a whatever "Und jetzt denkst du, es ist aus zwischen euch."

# game/script.rpy:1394
translate ger ch3_bb6894dc:

    # w oops "When you put it like that, I really DO sound dramatic..."
    w oops "Wenn du es so sagst, klinge ich WIRKLICH dramatisch..."

# game/script.rpy:1395
