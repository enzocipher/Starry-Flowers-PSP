translate ger ch6_8abb953b:

    # p think "What do people normally do on the morning after...? I guess I should've made breakfast."
    p think "Was machen Leute normalerweise am Morgen danach...? Ich denke, ich hätte Frühstück machen sollen."

# game/script.rpy:2807
translate ger ch6_d9be9541:

    # w happy "Ohh~ I want to eat pancakes~!"
    w happy "Ooh~ Ich möchte Pfannkuchen essen~!"

# game/script.rpy:2808
translate ger ch6_602cfadd:

    # p happy "Great! I'll make some!!"
    p happy "Großartig! Ich mach welche!!"

# game/script.rpy:2810
translate ger ch6_7c1da6cd:

    # n "Pastille practically bolts from the room to get started on cooking."
    n "Pastille stürmt geradezu aus dem Zimmer, um damit anzufangen."

# game/script.rpy:2811
translate ger ch6_c9e53739:

    # w sleepy3 "Hmhm... oh, Pastille...."
    w sleepy3 "Hmhm... oh, Pastille...."

# game/script.rpy:2814
translate ger ch6_54d8e5dc:

    # "Looking around the room, he did much more than organize my closet..."
    "Wenn ich mich so im Zimmer umsehe, hat er viel mehr gemacht, als nur meinen Schrank zu sortieren..."

# game/script.rpy:2815
translate ger ch6_d495c413:

    # "The books I'd been reading were all tucked back into their proper places on the bookshelf."
    "Die Bücher, die ich gelesen hatte, waren alle wieder an ihren richtigen Platz im Bücherregal zurückgestellt."

# game/script.rpy:2816
translate ger ch6_ff59d209:

    # "The clothes that had been strewn across the floor, or otherwise left hanging in ridiculous places, now sat in the hamper waiting to be washed."
    "Die Kleidung, die über den Boden verteilt war oder anderweitig an absurden Plätzen zurückgelassen wurde, lag nun im Wäschekorb und wartete darauf, gewaschen zu werden."

# game/script.rpy:2817
translate ger ch6_0c0a8ef8:

    # nvl clear
    # "Even the pile of unfolded laundry I had previously abandoned was now absent--properly folded and placed into the appropriate drawers by Pastille."
    nvl clear
    "Sogar der Haufen nicht zusammengelegter Wäsche, die ich liegengelassen habe, war nun weg--von Pastille ordentlich zusammengelegt und in die richtigen Schubladen verstaut."

# game/script.rpy:2819
translate ger ch6_c62ed776:

    # "In a word, I'm in awe."
    "Ich einem Wort; Respekt!"

# game/script.rpy:2820
translate ger ch6_d9bb5a76:

    # "How long had he been at this? And all while I slept?"
    "Wie lang war er da dran? Und alles, während ich geschlafen habe?"

# game/script.rpy:2821
translate ger ch6_d234491a:

    # "It shouldn't even be possible."
    "Es sollte eigentlich gar nicht möglich sein."

# game/script.rpy:2822
translate ger ch6_58188605:

    # nvl clear
    # w bed neutral "...."
    nvl clear
    w bed neutral "...."

# game/script.rpy:2825
translate ger ch6_a12675e8:

    # w oh2 "(I have so much more floor space than I remembered... how did he manage to do that...?)"
    w oh2 "(Ich hab viel mehr Platz als ich dachte... wie ist ihm das nur gelungen...?)"

# game/script.rpy:2828
translate ger ch6_9f49ab7b:

    # n "Periwinkle puts on a fresh pair of pajamas and walks out to the kitchen in a daze."
    n "Periwinkle zieht sich einen frischen Pyjama an und läuft benommen in die Küche."

# game/script.rpy:2834
translate ger ch6_d0be8d4a:

    # p "Hey! Pancakes are ready."
    p "Hey! Pfannkuchen sind fertig."

# game/script.rpy:2836
translate ger ch6_2bbe66e9:

    # w pj happy "Oh~! Is it too soon to say I love you?"
    w pj happy "Oh~! Ist es zu früh, zu sagen, dass ich dich liebe?"

# game/script.rpy:2837
translate ger ch6_59343347:

    # p sure "Haha, please enjoy...."
    p sure "Haha, lass es dir schmecken...."

# game/script.rpy:2838
translate ger ch6_5c9fb064:

    # n "Periwinkle takes his seat at the table and digs in..."
    n "Periwinkle nimmt am Tisch Platz und haut rein..."

# game/script.rpy:2841
translate ger ch6_dba11a19:

    # "They're... delicious."
    "Sie sind... lecker."

# game/script.rpy:2842
translate ger ch6_ed24b619:

    # "Perfectly light and fluffy... the optimal amount of syrup and whipped cream..."
    "Wirklich leicht und fluffig... mit der optimalen Menge an Sirup und Schlagsahne..."

# game/script.rpy:2843
translate ger ch6_877ba230:

    # "Every bite is so heavenly, I could cry!"
    "Jeder Bissen ist so himmlisch, ich könnte heulen!"

# game/script.rpy:2844
translate ger ch6_534a3175:

    # "I've never felt so emotional over food...! What has this boy done to me?"
    "Ich war noch nie wegen Essen so emotional...! Was hat dieser Junge mit mir gemacht?"

# game/script.rpy:2845
translate ger ch6_d42fc5b3:

    # nvl clear
    # "I was right about him being the culinary type."
    nvl clear
    "Ich hatte recht damit, dass er der kulinarische Typ ist."

# game/script.rpy:2847
translate ger ch6_a846ccd2:

    # "I didn't think I would get to try his cooking so soon... this is a surprise attack."
    "Ich dachte nicht, dass ich seine Kochkünste so früh genießen würde... das ist ein Überraschungsangriff."

# game/script.rpy:2848
translate ger ch6_3495ef88:

    # "He even... ah, but how did those get there? I have to ask--"
    "Er hat sogar... ah, aber wo kommen die her? Ich muss ihn fragen--"

# game/script.rpy:2849
translate ger ch6_76b2fe88:

    # nvl clear
    nvl clear

# game/script.rpy:2853
translate ger ch6_1784b473:

    # w pj oh "Pastille... where did you get these strawberries?"
    w pj oh "Pastille... woher hast du diese Erdbeeren?"

# game/script.rpy:2854
translate ger ch6_cf3877d3:

    # p ehe "Oh, I saw you had some jam, so I used a little magic to change its form..."
    p ehe "Oh, ich hab gesehen, dass du Marmelade hast, also hab ich Magie benutzt, um die Form zu ändern..."

# game/script.rpy:2855
translate ger ch6_d1a90016:

    # p ohno2 "Um, is that okay? Maybe I should've asked first--I just remember you liked strawberries, so..."
    p ohno2 "Ähm, ist das okay? Vielleicht hätte ich erst fragen sollen--mir war nur eingefallen, dass du Erdbeeren magst, also..."

# game/script.rpy:2856
translate ger ch6_db20d73e:

    # w shy "(Is there any limit to how thoughtful one can be...?!)"
    w shy "(Gibt es irgendeine Grenze, wie aufmerksam jemand sein kann...?!)"

# game/script.rpy:2857
translate ger ch6_ced19f55:

    # w love "It's more than okay! This is the best breakfast I've ever had...!"
    w love "Es ist mehr als okay! Das ist das beste Frühstück, das ich je hatte...!"

# game/script.rpy:2858
translate ger ch6_3aa7941c:

    # p shy "I'm sure you're exaggerating... they're just pancakes."
    p shy "Ich bin sicher, du übertreibst... es sind nur Pfannkuchen."

# game/script.rpy:2859
translate ger ch6_12d8d8d4:

    # w teehee "Careful, my sweet... if you say it like that, I'm going to start asking you to cook my every meal."
    w teehee "Vorsicht, mein Süßer... wenn du es so formulierst, werd ich dich noch fragen, ob du mir jede Mahlzeit kochst."

# game/script.rpy:2860
translate ger ch6_c38947a1:

    # p sure "Fine, you got me. They're special gourmet pancakes I can only whip up every once in a while."
    p sure "Gut, du hast mich. Das sind spezielle Gourmet-Pfannkuchen, die ich nur dann und wann so machen kann."

# game/script.rpy:2861
translate ger ch6_4b7d60e9:

    # w happy "Lucky me~! 💙"
    w happy "Ich Glückspilz~! 💙"

# game/script.rpy:2864
translate ger ch6_9df71125:

    # n "Periwinkle finishes his pancakes while Pastille begins washing the dishes..."
    n "Periwinkle isst seine Pfannkuchen auf, während Pastille damit anfängt, das Geschirr zu spülen..."

# game/script.rpy:2866
translate ger ch6_395109a4:

    # "This may just be the most spoiled I've ever felt..."
    "Ich glaube, so verwöhnt hab ich mich noch nie gefühlt..."

# game/script.rpy:2867
translate ger ch6_76489d66:

    # "Being with Pastille is like getting caught in an endless whirlwind of positive feelings."
    "Mit Pastille zusammen zu sein ist wie in einen endlosen Wirbelwind aus positiven Gefühlen zu geraten."

# game/script.rpy:2868
translate ger ch6_0dbd129d:

    # "No wonder I've become obsessed with him. This boy is dangerously kind."
    "Kein Wunder, dass ich so besessen von ihm bin. Dieser Junge ist gefährlich freundlich."

# game/script.rpy:2869
translate ger ch6_c7414828:

    # "After these past few emotionally tumultuous days, I... how could I possibly turn away from his comfort...?"
    "Nach diesen paar emotional aufgewühlten Tagen... wie konnte ich mich nur von der Geborgenheit durch ihn abwenden...?"

# game/script.rpy:2870
translate ger ch6_7ab087e8:

    # nvl clear
    # n "Periwinkle rests his elbows on the table, head tilted into palm as he watches Pastille in his kitchen."
    nvl clear
    n "Periwinkle stützt seine Ellen auf den Tisch und legt seinen Kopf schief in seine Hände, während er Pastille in seiner Küche betrachtet."

# game/script.rpy:2873
translate ger ch6_59ce0cf4:

    # w pj oh "Out of curiosity..."
    w pj oh "Nur so aus Neugier..."

# game/script.rpy:2875
translate ger ch6_bdbd5257:

    # p "Hm?"
    p "Hm?"

# game/script.rpy:2876
translate ger ch6_d05db3f5:

    # w "Earlier, before I woke up. What made you ask to start cleaning my room?"
    w "Vorhin, bevor ich aufgewacht bin. Was hat dich dazu gebracht zu fragen, ob du mein Zimmer saubermachen kannst?"

# game/script.rpy:2877
translate ger ch6_2563590a:

    # p ehe "Oh, I noticed it was getting harder to walk around..."
    p ehe "Oh, mir ist nur aufgefallen, dass es immer schwieriger wurde, herumzulaufen..."

# game/script.rpy:2878
translate ger ch6_8bffd0df:

    # p shy "I think I stepped on some of your clothes when I, um... carried you in there last night. Sorry."
    p shy "Ich denke, ich bin auf ein paar deiner Klamotten getreten, als ich, ähm... dich letzte Nacht reingetragen hatte. Sorry."

# game/script.rpy:2879
translate ger ch6_32cb935a:

    # w calm "That's nothing to apologize for. It was fun."
    w calm "Das ist nichts, wofür du dich entschuldigen musst. Es hat Spaß gemacht."

# game/script.rpy:2880
translate ger ch6_a00c9b60:

    # p embarrassed "Eheh... a-anyway... I felt a little bad about it."
    p embarrassed "Ähehe... n-nun ja... ich hab mich ein bisschen schlecht gefühlt deshalb."

# game/script.rpy:2881
translate ger ch6_7219c855:

    # p ehe "So I figured, if I'm going to be coming back here so often, I might as well help clean."
    p ehe "Deshalb dachte ich, wenn ich schon so oft hierher kommen werde, kann ich auch beim Saubermachen helfen."

# game/script.rpy:2882
translate ger ch6_0d37e844:

    # w ah "Ah...!"
    w ah "Ah...!"

# game/script.rpy:2883
translate ger ch6_fd796632:

    # p nervous "I-I'm not getting ahead of myself, am I? Sorry, I didn't mean--"
    p nervous "I-ich bin doch nicht zu aufdringlich, oder? Sorry, ich wollte nicht--"

# game/script.rpy:2884
translate ger ch6_b8380aaf:

    # w shock "Not at all!" with vpunch
    w shock "Überhaupt nicht!" with vpunch

# game/script.rpy:2886
translate ger ch6_7d5763ee:

    # n "Startled by the sudden outburst, Pastille stops what he's doing."
    n "Erschrocken von der plötzlichen Lautstärke, hält Pastille inne."

# game/script.rpy:2887
translate ger ch6_cd303bbf:

    # w shy "Hmhm, silly Pastille..."
    w shy "Hmhm, törichter Pastille..."

# game/script.rpy:2888
translate ger ch6_fa84fa9d:

    # w love "You're always welcome here 💙"
    w love "Du bist hier jederzeit willkommen 💙"

# game/script.rpy:2889
translate ger ch6_265a51d5:

    # p doki "Ah...! W-well, thank you...."
    p doki "Ah...! N-na dann, danke...."

# game/script.rpy:2893
translate ger ch6_4bd430f5:

    # "Fine."
    "Na gut."

# game/script.rpy:2894
translate ger ch6_44596fc6:

    # "Okay! Enough... I'll admit it."
    "Okay! Genug... ich gestehe es."

# game/script.rpy:2895
translate ger ch6_66217057:

    # "I'm stupidly, desperately, absolutely ridiculously..."
    "Ich bin super-duper, absolut megamäßig Hals über Kopf..."

# game/script.rpy:2896
translate ger ch6_4b601189:

    # "...in love with Pastille."
    "...in Pastille verliebt."

# game/script.rpy:2897
translate ger ch6_b65603b6:

    # nvl clear
    # "There! I said it--or at least, I'm saying it to myself."
    nvl clear
    "So! Ich hab's gesagt--na ja, zumindest hab ich es in meinem Kopf gesagt."

# game/script.rpy:2899
translate ger ch6_8127d328:

    # "I'll accept this. Pastille is incredible! Who WOULDN'T fall for him?"
    "Ich werde das akzeptieren. Pastille ist unglaublich. Wer würde ihm NICHT verfallen?"

# game/script.rpy:2900
translate ger ch6_a7f8f6b4:

    # "I don't want anyone else anymore. I've been poisoned by this perfect boy."
    "Ich will niemand anderes mehr. Ich wurde von diesem perfekten Jungen vergiftet."

# game/script.rpy:2901
translate ger ch6_4d52c35b:

    # "The problem now is what to DO about it...."
    "Das Problem ist jetzt nur, wie ich damit nun UMGEHE...."

# game/script.rpy:2902
translate ger ch6_76b2fe88_1:

    # nvl clear
    nvl clear

# game/script.rpy:2905
translate ger ch6_b4d687b8:

    # p "Weird question, but..."
    p "Komische Frage, aber..."

# game/script.rpy:2906
translate ger ch6_36c7f47d:

    # p shy "Would you want to... um..."
    p shy "Würdest du gern... ähm..."

# game/script.rpy:2907
translate ger ch6_1e42307e:

    # w pj innocent "(Date you? Yes!!)"
    w pj innocent "(Mit dir zusammen sein? Ja!!)"

# game/script.rpy:2908
translate ger ch6_1977ea6f:

    # p seriously "...Clean the rest of your house together?" with vpunch
    p seriously "...den Rest des Hauses zusammen mit mir sauber machen?" with vpunch

# game/script.rpy:2909
translate ger ch6_4cd578fd:

    # w ohdear "...Hm?"
    w ohdear "...Hm?"

# game/script.rpy:2910
translate ger ch6_bdf3c1ab:

    # p shy "I-it'll be more fun than it sounds! And if you get bored, we can do something else..."
    p shy "E-es wird mehr Spaß machen als du denkst! Und wenn dir langweilig wird, können wir etwas anderes machen..."

# game/script.rpy:2911
translate ger ch6_a76308ac:

    # w calm "Pastille..."
    w calm "Pastille..."

# game/script.rpy:2912
translate ger ch6_80a12d07:

    # p embarrassed "I just thought if we did it together, you'd get a say in where everything goes, so nothing ends up getting lost...!"
    p embarrassed "Ich dachte nur, wenn wir es zusammen machen, kannst du sagen, wo alles hinkommt, dann geht nichts verloren...!"

# game/script.rpy:2913
translate ger ch6_ee213eff:

    # w love "Pastille...!"
    w love "Pastille...!"

# game/script.rpy:2914
translate ger ch6_c8b7db60:

    # p ehe2 "And it's totally fine if you don't want me going through your stuff anymore. We really don't have to--"
    p ehe2 "Und es ist wirklich okay, wenn du nicht mehr willst, dass ich durch deine Sachen gehe. Wir müssen wirklich nicht--"

# game/script.rpy:2915
translate ger ch6_38742bdf:

    # w happy "Pastille, it's fine! I think it's a lovely idea."
    w happy "Pastille, es ist okay! Es ist ein schöner Vorschlag."

# game/script.rpy:2916
translate ger ch6_d3b99301:

    # p wha "R-really...?"
    p wha "W-wirklich...?"

# game/script.rpy:2917
translate ger ch6_d5f25738:

    # w innocent "Yes. In fact, I'd appreciate your help."
    w innocent "Ja. Ehrlich gesagt, bin ich froh um deine Hilfe."

# game/script.rpy:2918
translate ger ch6_4ba187a4:

    # w love "One thing or another has always come up when I try to clean on my own. I'm simply useless at it."
    w love "Immer kam etwas dazwischen, wenn ich selbst sauber machen wollte. Ich bin einfach nutzlos, was das angeht."

# game/script.rpy:2919
translate ger ch6_c049910d:

    # p happy "Then... I'll take the lead! I wanted to start with these boxes by the couch..."
    p happy "Dann... übernehm ich die Führung! Ich wollte mit den Kisten bei der Couch anfangen..."

# game/script.rpy:2923
translate ger ch6_98446b5c:

    # "Pastille already had a plan for everything, it seemed."
    "Wie es schien, hatte Pastille schon für alles einen Plan."

# game/script.rpy:2924
translate ger ch6_80b953ec:

    # "His energy was contagious. He was right that it would be fun--it was entertaining even just watching him go."
    "Seine Energie war ansteckend. Er hatte recht damit, dass es Spaß machen würde--es war sogar unterhaltend, ihm einfach zuzusehen."

# game/script.rpy:2925
translate ger ch6_8e73e0b2:

    # "To see him dart around the room so energetically, finding the perfect place for every little thing..."
    "Ihn so voller Energie durch den Raum huschen zu sehen, für alles den perfekten Platz zu finden..."

# game/script.rpy:2926
translate ger ch6_f19b7285:

    # "He truly has a talent for organization."
    "Er ist wirklich ein Ordnungstalent."

# game/script.rpy:2927
translate ger ch6_8bb41e57:

    # nvl clear
    # "Meanwhile, I mostly played the role of assistant."
    nvl clear
    "In der Zwischenzeit habe ich hauptsächlich den Assistenten gespielt."

# game/script.rpy:2929
translate ger ch6_a1ad8874:

    # "He would ask for my input every now and then, or instruct me to place something he found somewhere across the room."
    "Er fragte hin und wieder nach meiner Meinung oder trug mir auf, etwas auf der anderen Seite des Zimmers zu verstauen."

# game/script.rpy:2930
translate ger ch6_092cda92:

    # "He made little decisions like that so easily. If it were me, I'd get stuck on every one..."
    "Er machte solche kleinen Entscheidungen einfach so. Ich würde bei jeder einzelnen hängenbleiben... "

# game/script.rpy:2931
translate ger ch6_48fd29c3:

    # "But he saw everything through, effortlessly. It was nothing short of amazing."
    "Aber er hatte mühelos den totalen Durchblick. Es war einfach unfassbar."

# game/script.rpy:2932
translate ger ch6_8d433bab:

    # nvl clear
    # n "And so, in a short few hours..."
    nvl clear
    n "Und so, nach ein paar wenigen Stunden..."

# game/script.rpy:2938
translate ger ch6_80154118:

    # n "...The entire house had become neat and tidy."
    n "...war das ganze Haus sauber und aufgeräumt."

# game/script.rpy:2941
translate ger ch6_fe44cae1:

    # p "Okay... I think I'm satisfied. You?"
    p "Okay... Ich denke, ich bin zufrieden. Du?"

# game/script.rpy:2942
translate ger ch6_9e685ed1:

    # w pj shy "Hmm~ don't you think you deserve to be rewarded for all your hard work? 💙"
    w pj shy "Hmm~ meinst du nicht, dass du dir für all die harte Arbeit eine Belohnung verdient hast? 💙"

# game/script.rpy:2943
translate ger ch6_876e21b0:

    # p uhoh "Ah--I-I should've seen that one coming...!"
    p uhoh "Ah--I-ich hätte das kommen sehen müssen...!"

# game/script.rpy:2944
translate ger ch6_09a70627:

    # p shy "But no, not right now! I should actually get going...."
    p shy "Aber nein, jetzt noch nicht! Ich muss nämlich mal los...."

# game/script.rpy:2945
translate ger ch6_4a104fcf:

    # w smile "You won't stay?"
    w smile "Du wirst nicht bleiben?"

# game/script.rpy:2946
translate ger ch6_7477ec63:

    # p smile "I promised Gumdrop I'd be back for the afternoon shift. She'll start to worry if I don't come back soon."
    p smile "{size=-2}Ich habe Gumdrop versprochen, zur Spätschicht zurück zu sein. Sie wird sich Sorgen machen, wenn ich nicht bald auftauche."

# game/script.rpy:2947
translate ger ch6_7efae89a:

    # w calm "Hmhm... I'll save your reward for next time, then."
    w calm "Hmhm... dann werde ich deine Belohnung fürs nächste Mal aufheben."

# game/script.rpy:2950
translate ger ch6_ebdb2310:

    # n "Pastille slips on his jacket and shoes."
    n "Pastille schlüpft in seine Jacke und Schuhe."

# game/script.rpy:2951
translate ger ch6_4a339e2c:

    # n "Just before he leaves, he turns back to face Periwinkle..."
    n "Kurz bevor er geht, dreht er sich nochmal zu Periwinkle um..."

# game/script.rpy:2954
translate ger ch6_931329ba:

    # p "By the way, um... I was thinking..."
    p "Ach übrigens, ähm... ich dachte..."

# game/script.rpy:2955
translate ger ch6_97a64bda:

    # w pj "Yes...?"
    w pj "Ja...?"

# game/script.rpy:2956
translate ger ch6_55b62f87:

    # p oh "There are some days my friends travel out of town. For alchemy stuff."
    p oh "Es gibt ein paar Tage, an denen meine Freunde außerhalb der Stadt unterwegs sind. Für Alchemiekram."

# game/script.rpy:2957
translate ger ch6_5634565b:

    # p shy "So if you ever wanted to drop by while I'm working on those days... I think that'd be okay..."
    p shy "Wenn du also an diesen Tagen mal auf meiner Arbeit vorbeikommen willst... denke ich, wäre das okay..."

# game/script.rpy:2958
translate ger ch6_9d4854d5:

    # p ehe "That's, um... the most I can do right now... sorry."
    p ehe "Das ist, ähm... alles, was ich momentan anbieten kann... sorry."

# game/script.rpy:2959
translate ger ch6_41c1209f:

    # w happy "I'll gladly take you up on that! I'd love to keep you company 💙"
    w happy "Dem werde ich sehr gern nachkommen! Ich werde dir gern Gesellschaft leisten 💙"

# game/script.rpy:2960
translate ger ch6_8fc6bb84:

    # p smile "Great! Okay, then...."
    p smile "Großartig! Okay, also dann...."

# game/script.rpy:2964
translate ger ch6_7cabd49b:

    # n "Pastille gives him a quick peck on the cheek..."
    n "Pastille gibt ihm einen kurzen Schmatzer auf den Hals..."

# game/script.rpy:2966
translate ger ch6_3305bee7:

    # n "...before saying goodbye, and walking out the door."
    n "...bevor er sich verabschiedet und durch die Tür geht."

# game/script.rpy:2971
translate ger ch6_7969eade:

    # w pj wow "...."
    w pj wow "...."

# game/script.rpy:2973
translate ger ch6_c71484d3:

    # "What... WAS all of that?"
    "Was... WAR all das?"

# game/script.rpy:2974
translate ger ch6_77393381:

    # "It was extremely domestic! I can't be imagining things, can I?"
    "Es war überaus häuslich! Das kann ich mir nicht nur eingebildet haben, oder?"

# game/script.rpy:2975
translate ger ch6_a79fc5b9:

    # "He said it was okay... to come and visit him...?"
    "Er sagte es war okay... vorbeizukommen und ihn zu besuchen...?"

# game/script.rpy:2976
translate ger ch6_3ed40c2c:

    # "That has to mean something, doesn't it?"
    "Das muss etwas bedeuten, oder?"

# game/script.rpy:2977
