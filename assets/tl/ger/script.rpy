    w cute whine "Astragalus~~ Bist du beschäftigt~~~?"

# game/script.rpy:1378
translate ger ch3_6043f839:

    # a "Ugh, I know that whine. You've shifted into dramatic bitch mode."
    a "Ugh, ich kenne dieses Heulen. Du bist in den Drama-Tussi-Modus gewechselt."

# game/script.rpy:1379
