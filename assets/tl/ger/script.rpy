# game/script.rpy:1863
translate ger ch4_403c728d:

    # n "Pastille sips his drink while Periwinkle continues."
    n "Pastille nippt an seinem Getränk, während Periwinkle fortfährt."

# game/script.rpy:1865
translate ger ch4_6a1d304f:

    # w calm "When I was young... I didn't have the confidence to dress so beautifully. Hmhm, can you even imagine it?"
    w calm "Als ich jung war... hatte ich gar nicht das Selbstvertrauen, mich so schön zu kleiden. Hmhm, kannst du dir das vorstellen?"

