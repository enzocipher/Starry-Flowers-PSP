translate kor ch4_adc44e53:

    # "I remember the choker. He wore it on our first date as well <3"
    "저 초커는 기억나. 우리 첫 데이트 때도 차고 있던 거였지. ♥"

# game/script.rpy:1810
translate kor ch4_1e8c7e1f:

    # "And that's the same barrette he left behind after one of our sleepovers~ Such pointed choice in accessories..."
    "그리고 저 머리핀은 우리 집에서 자고 갔을 때 남겨놨던 것 중에 하나였고~ 악세사리를 탁월하게 골랐는걸..."

# game/script.rpy:1812
translate kor ch4_1fd546cf:

    # "Ah, and now all my staring has embarrassed him. You're too easily flustered, my sweet <3"
    "아, 계속 쳐다보고 있으니까 부끄러워 하는 것 좀 봐. 우리 자기, 너무 쉽게 얼굴이 빨개진다니까. ♥"

# game/script.rpy:1813
translate kor ch4_0f78683c:

    # nvl clear
    # w date "Forgive me for staring; I was trying to intuit what you might have planned for us after this."
    nvl clear
    w date "빤히 쳐다봐서 미안해. 이거 다음에 뭘 준비해놨을지 네 얼굴을 보고 맞춰보려고 했거든."

# game/script.rpy:1815
translate kor ch4_bbf68c72:

    # p ehe "Oh, um, nothing in particular... wandering around town is enough for me."
    p ehe "아, 어, 딱히 준비한 건 없어요... 그냥 마을 산책 정도면 괜찮을 것 같네요."

# game/script.rpy:1816
translate kor ch4_0455f80a:

    # w calm "I see <3 Loitering does facilitate conversation quite well."
    w calm "그렇구나 ♥ 걷고 있으면 자연스레 대화도 할 수 있고 말이지."

# game/script.rpy:1817
translate kor ch4_39f199d8:

    # p shy "As long as we're out and about, we won't end up... um...."
    p shy "밖에 나와있으면, 그... 분위기 잡혀서 그... 할 일도 없고..."

# game/script.rpy:1818
translate kor ch4_db519a24:

    # w my "(Oh, is he going to say it~?)"
    w my "(오, 그 말을 꺼내려는 건가~?)"

# game/script.rpy:1819
translate kor ch4_ae3f626a:

    # p omg "Y-you know...."
    p omg "그... 그거 있잖아요..."

# game/script.rpy:1820
translate kor ch4_143046d9:

    # w innocent "(Hmhm, of course not <3)"
    w innocent "(후후, 안 하는 게 당연하겠구나. ♥)"

# game/script.rpy:1821
translate kor ch4_98697be5:

    # p wha "I actually like when we get to talk...!"
    p wha "저는 우리가 이야기하는 게 좋아서요...!"

# game/script.rpy:1822
translate kor ch4_09628e53:

    # p uhoh "I-I mean, not that we DON'T when I sleep over, it's just... a different kind...."
    p uhoh "그... 그게, 같이 잘 때가 싫다는 건 아닌데, 그냥... 다른 느낌이라서..."

# game/script.rpy:1823
translate kor ch4_c6264bf7:

    # w calm "True... <3"
    w calm "그렇지... ♥"

# game/script.rpy:1824
translate kor ch4_b63fac77:

