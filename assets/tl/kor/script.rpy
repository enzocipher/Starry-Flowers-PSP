    # w innocent "You, for one <3"
    w innocent "일단 너? ♥"

# game/script.rpy:585
translate kor start_adb706d7:

    # p ehe "Pfft--maybe they wouldn't be so good together..."
    p ehe "풉... 그럼 아마 잘 안 어울리지 않을까 싶네요..."

# game/script.rpy:586
translate kor start_43faf218:

    # w oh "My, am I supposed to take offense to that?"
    w oh "뭐야, 내 안목을 낮잡아보는 거야?"

# game/script.rpy:587
translate kor start_881b271e:

    # p smile "Nah, that guy was just kinda pushy."
    p smile "아뇨, 저 사람은 조금 막 달려드는 타입이었거든요."

# game/script.rpy:588
translate kor start_bbb521cf:

    # w happy "Hmhm... ahaha, you're too much, Pastille!"
    w happy "후후... 아하하, 널 보고 있으면 정말 재밌다니까, 파스틸!"

# game/script.rpy:594
translate kor start_4554f13a:

    # "We eventually made our way out of the restaurant that night..."
    "우리는 그날 밤 늦게까지 레스토랑에 앉아 있었어."

# game/script.rpy:595
translate kor start_7211b97d:

    # "It had gotten quite late already. When's the last time I stayed until closing...?"
    "늦은 시간이 됐었지. 레스토랑 마감 시간까지 앉아 있었던 게 얼마만이지...?"

# game/script.rpy:596
translate kor start_bc63f4b9:

    # "There was never a moment of awkward silence between us. Only Pastille's embarrassed pauses--clear attempts to steer his mind away from debauchery <3"
    "우리가 앉아있었던 동안 대화가 어색하게 끊기는 틈이 없었어. 가끔 파스틸이 부끄러워서 입을 닫은 것만 빼면 말이지... 분명 자기도 방탕한 생각에 빠져 있었을 거야. ♥"

# game/script.rpy:597
translate kor start_1f9c5254:

    # "As we wander back into the night air, he's the first to speak up again..."
    "우리가 차가운 밤 공기를 다시 맡을 무렵 파스틸이 먼저 입을 열었어..."

# game/script.rpy:598
translate kor start_76b2fe88_7:

    # nvl clear
    nvl clear

# game/script.rpy:601
translate kor start_a046c557:

    # p "You could've at least let me cover the tip..."
    p "최소한 팁은 제가 내게 해주시지..."

# game/script.rpy:602
translate kor start_bbd42092:

    # w innocent "Nonsense. I'm the one who asked you out tonight, you don't have to cover a thing."
