    # p uhoh "Th-the guy sitting across from them... I'm pretty sure I've been with him before."
    p uhoh "저... 저기 저 사람 건너편에 앉아있는 사람 있잖아요... 저도 저 사람이랑 같이 있었던 적이 있는 거 같아요."

# game/script.rpy:569
translate kor start_9590f34f:

    # w my "NO... surely, you're joking, Pastille!"
    w my "뭐라고...? 장난치지 마, 파스틸!"

# game/script.rpy:570
translate kor start_d1b5f16c:

    # p omgstop "SH-SHHHH!!! Don't say my name so loudly...!"
    p omgstop "쉬... 쉬이이잇!!! 제 이름 그렇게 크게 부르지 마요...!"

# game/script.rpy:571
translate kor start_2eb04fd0:

    # w happy "Just keep your head low, I'm sure he won't notice."
    w happy "고개 조금 숙이고 있어. 아마 눈치 못 챌 거야."

# game/script.rpy:572
translate kor start_ffe0c64f:

    # w oh "...Oh, he's just looked this way."
    w oh "...아, 방금 이쪽 봤다."

# game/script.rpy:573
translate kor start_50c22d14:

    # p scream "AAAAAHH...!!!" with vpunch
    p scream "아아아아악...!!!" with vpunch

# game/script.rpy:574
translate kor start_f4ea47ed:

    # w teehee "Only kidding <3"
    w teehee "농담이야 ♥"

# game/script.rpy:575
translate kor start_e2427086:

    # p flustered "P-Peri...!!"
    p flustered "페... 페리...!!"

# game/script.rpy:576
translate kor start_fc329306:

    # w shy "Ooh, a nickname already? We're moving so fast..."
    w shy "아, 벌써부터 별명으로 부르는 거야? 진도가 참 빠른걸..."

# game/script.rpy:577
translate kor start_212fa4c4:

    # p seriously "You're the one who's been calling me \"my sweet\" all night...!"
    p seriously "페리야말로 오늘밤 내내 계속 절 \"자기\" 라고 불렀잖아요...!"

