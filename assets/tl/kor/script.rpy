    p wha "아..."

# game/script.rpy:2108
translate kor ch4_d493bae3:

    # p kyaa "A-AH...! I WASN'T THINKING ABOUT THAT...!!!" with vpunch
    p kyaa "아... 앗...! 그 생각은 하지도 못 했어요...!!!" with vpunch

# game/script.rpy:2109
translate kor ch4_d739c596:

    # p wow "I-I just, was trying to think of other places we could go, and this one came to mind..."
    p wow "그... 그냥, 어딜 갈지 생각하다가, 여기가 생각나서..."

# game/script.rpy:2110
translate kor ch4_eab2cf4c:

    # w happy "It's lovely. Very romantic <3"
    w happy "정말 사랑스럽고 로맨틱한 곳이네 ♥"

# game/script.rpy:2111
translate kor ch4_2f1a8383:

    # w shy "(Straight out of a shoujo manga, honestly... how does he know I'm weak to such things?)"
    w shy "(순정 만화에서 그대로 가지고 온 것 같은 분위기야... 정말, 어떻게 이렇게 내가 원하는 걸 잘 알까?)"

# game/script.rpy:2112
translate kor ch4_9218331e:

    # p omg "We don't have to stay... I mean, we've already walked around so much--it's okay if you wanna head back now..."
    p omg "여기 오래 있을 필요는 없어요... 정말 많이 걷기도 했고... 지금 내려가고 싶으면 내려가도 돼요..."

# game/script.rpy:2113
translate kor ch4_18984878:

    # p omgstop "N-NOT TO... DO THINGS... I just meant...! I-I'm gonna stop talking......" with vpunch
    p omgstop "그... 그렇고 그런 걸... 하려는 건 아니라...! 그... 그냥 입 다물고 있을게요......" with vpunch

# game/script.rpy:2114
translate kor ch4_6d760657:

    # w love "Pastille."
    w love "파스틸."

# game/script.rpy:2115
translate kor ch4_7a8b97fb:

    # p seriously "Y-yes...?"
    p seriously "ㄴ... 네...?"

# game/script.rpy:2116
translate kor ch4_ec1d1b34:

    # w calm "You've presented me quite the conundrum. If I kiss you now, you'll definitely want to return home with me as soon as possible..."
    w calm "날 난제에 빠트리는구나. 만약 내가 널 지금 키스한다면, 넌 분명 최대한 빨리 내 집으로 가고 싶어하겠지..."

# game/script.rpy:2117
translate kor ch4_80145f9c:

    # w happy "But I wasn't done learning all about you. I'm not ready for our date to end <3"
    w happy "하지만 난 아직 너에 대해 배우는 걸 그만둘 생각이 없어. 벌써 우리 데이트를 끝낼 생각도 없고 말이야 ♥"

# game/script.rpy:2118
translate kor ch4_5974e4ff:

    # p embarrassed "O-oh... that IS a conundrum...."
    p embarrassed "아... 아... 확실히 난제네요...."

# game/script.rpy:2119
translate kor ch4_dbc74acd:

    # w love "Yes, you see? Both options are equally appealing. However can I decide~?"
    w love "그래, 그치? 두 개의 선택지 모두 너무나도 끌린단 말이지. 어떤 선택을 해야 한담~?"

# game/script.rpy:2120
translate kor ch4_ec2c6956:

    # p shy "Haha, um, well... i-it's still light out! Maybe we can hold back until after dinner...."
    p shy "하하, 음, 뭐... 아... 아직 해도 안 졌고! 저녁 먹을 때까지만 버텨보죠..."

# game/script.rpy:2121
translate kor ch4_584de9f1:

    # w teehee "Or I could have YOU for dinner <3"
    w teehee "아니면 널 저녁으로 먹어도 되고 ♥"

# game/script.rpy:2122
translate kor ch4_31907a91:

    # p kyaa "A-AH...!" with vpunch
    p kyaa "아... 앗...!" with vpunch

# game/script.rpy:2123
translate kor ch4_f4a3afbc:

    # w calm "On the other hand, you bring up a valid point. Holding back is fun in itself."
    w calm "하지만 확실히, 네 말이 맞아. 버티는 것도 즐거움의 일부지."

# game/script.rpy:2124
translate kor ch4_9d41c26b:

    # p omgstop "Do you expect me to recover after what you just said...?!"
    p omgstop "아까 그런 말을 하고도 제가 진정하기를 바라는 거예요...!?"

# game/script.rpy:2125
translate kor ch4_32adccf0:

    # w happy "See~? This IS quite fun!"
    w happy "봐~? 정말 재밌다니까!"

# game/script.rpy:2126
translate kor ch4_b5263d43:

    # w calm "It's decided, then. The date continues."
    w calm "그럼 데이트는 계속 하는 걸로 정해진 거네."

# game/script.rpy:2130
translate kor ch4_98062818:

    # "I give Pastille a moment to calm himself."
    "나는 파스틸이 진정할 시간을 조금 줬어."

# game/script.rpy:2131
translate kor ch4_43346300:

    # "We walk up to the railing and look out at the town..."
    "우리는 철도 앞으로 가 마을을 내려다봤어..."

# game/script.rpy:2132
translate kor ch4_2e739e18:

    # nvl clear
    # "You can see Atelier Sweets from here. And the train station next to it."
    nvl clear
    "여기서는 아틀리에 과자점이 보여. 바로 옆에 있는 기차역도."

# game/script.rpy:2134
translate kor ch4_65c0b220:

    # "My house is... somewhere in a row of similarly built homes. Inconspicuous."
    "내 집은... 비슷하게 생긴 집들의 열 중에 눈에 안 띄게 끼어있어."

# game/script.rpy:2135
translate kor ch4_140deac1:

    # "Fallen petals litter the bricks at our feet, with every little breeze carrying a few more over the railing to land somewhere unknown."
    "떨어진 꽃잎들은 우리 발 밑의 벽돌길에 쌓였고, 새로운 산들바람이 불 때마다 더 많은 꽃잎들이 바람을 타고 철도를 넘어 멀리멀리 날아갔어."

# game/script.rpy:2136
translate kor ch4_9b3a7e5d:

    # "After watching them for a while, I turn back to Pastille."
    "그 모습을 한동안 지켜본 나는 파스틸을 바라봤어."

# game/script.rpy:2137
translate kor ch4_76b2fe88_11:

    # nvl clear
    nvl clear

# game/script.rpy:2140
translate kor ch4_6319f667:

    # w date "Tell me about your magic."
    w date "네 마법에 대해서 더 알려줘."

# game/script.rpy:2141
translate kor ch4_81ee26b5:

    # p um "O-okay... what do you want to know?"
    p um "조... 좋아요... 뭘 알고 싶으세요?"

# game/script.rpy:2142
translate kor ch4_c829cbee:

    # w innocent "Your specialty, dear!"
    w innocent "네 주특기!"

# game/script.rpy:2143
translate kor ch4_9847abef:

    # w smile "If you were that good at reconstruction, I imagine it must fall somewhere in that category...?"
    w smile "만약 재구축에 그렇게 재능이 있다면, 그쪽이랑 연관이 되어있는 걸라나...?"

# game/script.rpy:2144
translate kor ch4_b09961bf:

    # p ehe "Um, not really... I'm actually an astral witch."
    p ehe "아, 그건 아니에요... 제 주특기는 사실 별이랑 관련이 있어요."

# game/script.rpy:2145
translate kor ch4_443121bc:

    # w my "My, how rare! And what exactly does that entail for you?"
    w my "어머, 희귀하기도 해라! 그건 정확히 무슨 의미인데?"

# game/script.rpy:2146
translate kor ch4_44c2df3e:

    # p shy "Ahh, well, I mostly use it for fire spells, like anyone else..."
    p shy "아아, 그게, 제 마법은 보통 남들처럼 불 피우는 데에 쓰죠..."

# game/script.rpy:2147
translate kor ch4_bcabe313:

    # w oh "Forgive me, I'm not well-versed in magic theory... but doesn't astral magic have something to do with creation?"
    w oh "미안, 나는 마법 이론에 대해서는 그렇게 잘 아는 게 아니라서... 하지만 별 마법은 창조랑 연관돼있는 거 아니니?"

# game/script.rpy:2148
translate kor ch4_ac2d501e:

    # p ehe2 "It does... but that stuff is pretty advanced. I haven't been able to find any books explaining how to use it."
    p ehe2 "맞아요... 그래도 그건 좀 어려운 거예요. 사용하는 법이 제대로 설명돼있는 책을 찾지를 못하겠더라고요."

# game/script.rpy:2149
translate kor ch4_02f8bfe1:

    # p embarrassed "...Which is probably for the best, actually. No one should be allowed to go around creating souls spontaneously...!"
    p embarrassed "...사실 그게 더 나을지도 몰라요. 아무나 그렇게 막 영혼을 만들어내서는 안 되니까요...!"

# game/script.rpy:2150
translate kor ch4_29508975:

    # w neutral "Hm..."
    w neutral "흐음..."

# game/script.rpy:2152
translate kor ch4_1b5322bf:

    # "Pastille rubs the back of his neck, looking off into the distance."
    "파스틸은 목 뒤를 긁적이더니, 먼 곳을 바라봤어."

# game/script.rpy:2153
translate kor ch4_309805fa:

    # "He seems so troubled by the subject..."
    "이 주제가 조금 난처한 모양이네..."

# game/script.rpy:2154
translate kor ch4_9604342e:

    # "I suppose because he had been living without magic, it may feel strange to openly discuss it?"
    "아마 마법을 사용하지 않은 지 오래 돼서, 마법에 대해 공개적으로 이야기하는 게 어색한 걸까?"

# game/script.rpy:2155
translate kor ch4_48123bf8:

    # nvl clear
    # "An astral witch, though... I wouldn't have guessed."
    nvl clear
    "하지만 별 마법사라니... 말해주지 않았더라면 못 맞췄을 거야."

# game/script.rpy:2157
translate kor ch4_c8d56a68:

    # "Putting two and two together, ONE thing makes perfect sense now..."
    "하지만 들은 내용을 종합해보면, 하나는 확실하게 알겠네..."

# game/script.rpy:2158
translate kor ch4_551942a5:

    # nvl clear
    # w ah "So the famous Atelier Sweets golem was YOUR creation?"
    nvl clear
    w ah "그럼 아틀리에 과자점의 유명한 사탕 골렘은 네가 만든 거였구나?"

# game/script.rpy:2161
translate kor ch4_2c8fd31f:

    # p ehe2 "Haha, is she really that famous? I'd expect our sales to be a little better if that were the case..."
    p ehe2 "하하, 그렇게 유명한가요? 그렇게까지 잘 알려졌으면 매출이 조금이라도 늘었으면 좋았을 텐데..."

# game/script.rpy:2162
translate kor ch4_fd97e90a:

    # p flustered2 "But... yeah. Just don't go around telling everyone--I didn't know what I was doing when I made her."
    p flustered2 "하지만... 맞아요. 그래도 돌아다니면서 막 얘기하고 다니진 말아주세요... 걔를 만들었을 때는 제가 뭘 잘 몰랐거든요."

# game/script.rpy:2163
translate kor ch4_e7fb158c:

    # w my "What an amazing feat... and yet you sound almost ashamed of it!"
    w my "정말 대단한 위업인데... 네가 말하는 걸 들으니 거의 후회하는 것처럼 들리는걸!"

# game/script.rpy:2164
translate kor ch4_0bf92251:

    # p ohno "I-it's not like I regret it or anything... Gumdrop is really great! I just..."
    p ohno "후... 후회하거나 그런 건 아니에요... 검드롭은 정말 멋지죠! 하지만..."

# game/script.rpy:2165
translate kor ch4_2ed99bc8:

    # p nervous "I feel bad that she's stuck in a body with so many limitations. Like, she didn't ask to be made that way..."
    p nervous "그렇게 제한이 많은 몸으로 살아야 한다는 게 정말 미안해서요. 본인도 그렇게 만들어지길 원하지 않았을 텐데..."

# game/script.rpy:2166
translate kor ch4_8694e630:

    # p flustered2 "I didn't know you could even make golems that felt real emotions, so of course I never considered any of that."
    p flustered2 "저는 진짜 감정을 느끼는 골렘을 만들 수 있는 줄도 몰랐어요. 그래서 아무런 신경을 안 썼죠."

# game/script.rpy:2167
translate kor ch4_cde66f06:

    # p shy "...Sorry to go off about it. I-I've just been feeling guilty lately--kind of a heavy topic."
    p shy "...저 혼자만 이렇게 얘기해서 미안해요. 최근 들어 더 죄책감을 느끼고 있었거든요... 무거운 주제죠."

# game/script.rpy:2168
translate kor ch4_9931704c:

    # w ah "No, no... thank you for telling me."
    w ah "아냐, 아냐... 나한테 말해줘서 고마워."

# game/script.rpy:2169
translate kor ch4_b7df5332:

    # w calm "It's as if I've discovered a whole new side of you today. I'm grateful to know it."
    w calm "오늘 너의 완전 새로운 부분을 알게 된 것 같아서 오히려 감사할 따름이야."

# game/script.rpy:2170
translate kor ch4_d2da19ee:

    # p ehe "Thanks for listening... I don't get many chances to talk about things like this, so I'm grateful for it, too."
    p ehe "들어주셔서 고마워요... 이런 주제로 이야기할 기회가 많이 없어서, 저도 털어놓을 수 있다는 사실에 고맙네요."

# game/script.rpy:2171
translate kor ch4_2f822c09:

    # w love "Hmhm, hearing you speak of her though, I'd love to meet this golem of yours one day."
    w love "후후, 그 애에 대해서 이야기하는 걸 들으니, 나중에 한번 제대로 만나보고 싶은걸."

# game/script.rpy:2172
translate kor ch4_87960f32:

    # p sure "Sure. Maybe one day."
    p sure "그래요. 언제 한번 만날 수 있겠죠."

# game/script.rpy:2175
translate kor ch4_e955de1d:

    # "Pastille is amazing."
    "파스틸은 대단해."

# game/script.rpy:2176
translate kor ch4_dd1b4e98:

    # "I've never met anyone who would downplay their talents this much--I could ask a thousand questions and still only scratch the surface..."
    "이렇게 자신의 재능을 대단치 않게 생각하는 사람은 만나본 적이 없어... 질문을 몇 천 개를 해도 파스틸을 제대로 알기에는 모자랄 판이야..."

# game/script.rpy:2177
translate kor ch4_034046bb:

    # "My, now I'M the insatiable one. How the tables have turned!"
    "어머, 이젠 내가 목마른 쪽이 됐네. 이렇게 판이 뒤집어질 수가!"

# game/script.rpy:2178
translate kor ch4_aa528040:

    # nvl clear
    # "We decide it's time to move on, and descend the stairs from whence we came..."
    nvl clear
    "우리는 이제 움직일 시간이 됐다고 생각해 우리가 올랐던 계단을 내려갔어..."

# game/script.rpy:2180
translate kor ch4_5310cd5c:

    # "...Still chatting endlessly as we decide where we'll wander to next."
    "...다음으로는 어딜 가야 할지 계속 얘기하면서 말이지."

# game/script.rpy:2181
translate kor ch4_76b2fe88_12:

    # nvl clear
    nvl clear

# game/script.rpy:2184
translate kor ch4_ab4f864b:

    # "Over dinner, Pastille opens up a little more."
    "저녁을 먹으면서 파스틸은 자기에 대해 더 많은 얘기를 해줬어."

# game/script.rpy:2185
translate kor ch4_2a1a4890:

    # "We trade anecdotes, listening intently to each others' stories no matter how unremarkable the events told within them."
    "우린 사소한 얘기에도 귀를 기울여가며 서로의 옛날 이야기를 공유했지."

# game/script.rpy:2186
translate kor ch4_a504ab29:

    # "I could never tire of it~ I was hooked by his every word."
    "질리지가 않아~ 파스틸이 하는 모든 말이 즐거웠어."

# game/script.rpy:2187
translate kor ch4_efbe6e4c:

    # nvl clear
    # "Alas, the hours flew by, and our day together was quickly approaching its end..."
    nvl clear
    "하지만 결국, 시간은 흘렀고, 우리가 함께 한 날은 거의 끝에 달했지..."

# game/script.rpy:2189
translate kor ch4_d04a4349:

    # "But now we had the whole night to look forward to <3"
    "하지만 온 하룻밤을 기다렸으니, 기대하고 있던 걸 해야지 ♥"

# game/script.rpy:2190
translate kor ch4_b7200d05:

    # "The sun was on its way down as we emerged back onto the street, the atmosphere so different than it had been just a short while ago."
    "우리가 거리로 나올 무렵에 해는 지고 있었고, 바깥의 분위기는 조금 전과는 사뭇 달라져 있었어."

# game/script.rpy:2191
translate kor ch4_d4905e0a:

    # "Pastille brushes his bangs aside and asks..."
    "파스틸은 머리가락을 옆으로 넘기면서 물었어..."

# game/script.rpy:2192
translate kor ch4_76b2fe88_13:

    # nvl clear
    nvl clear

# game/script.rpy:2194
translate kor ch4_b2bdea1d:

    # p "Do you wanna head back? It's starting to get late...."
    p "이제 돌아갈까요? 시간도 늦어지는데..."

# game/script.rpy:2195
translate kor ch4_843a037d:

    # w date shy "Hmhm, you've waited so patiently to be able to say that."
    w date shy "후후, 그 말을 하기까지 참을성 있게 잘 기다렸어."

# game/script.rpy:2196
translate kor ch4_8b799080:

    # p embarrassed "I-it's not like you aren't thinking of it too..."
    p embarrassed "그... 그러는 페리윙클도 생각하고 있었잖아요..."

# game/script.rpy:2197
translate kor ch4_6cca094e:

    # w innocent "Let's go through the park. It's a shorter walk <3"
    w innocent "공원을 가로질러서 가자. 거기가 지름길이야 ♥"

# game/script.rpy:2198
translate kor ch4_027952fc:

    # p ehe "Sure...! A-after you...."
    p ehe "네...! 아... 앞장서세요...."

# game/script.rpy:2200
translate kor ch4_7984db30:

    # n "Periwinkle extends his hand, which Pastille takes without hesitation."
    n "파스틸은 페리윙클이 뻗은 손을 주저 없이 잡습니다."

# game/script.rpy:2201
translate kor ch4_93861845:

    # n "Under cover of dusk, they walk toward the park with fingers gently intertwined..."
    n "황혼 아래에서 둘은 손을 다정하게 깍지 낀 채로 공원을 따라 걷습니다..."

# game/script.rpy:2205
translate kor ch4_25bb3367:

    # "This park, during twilight hours, is nearly always deserted."
    "이 공원은 항상 해가 질 시간이 되면 사람들의 발길이 끊겨."

# game/script.rpy:2206
translate kor ch4_df0cd7c9:

    # "Tonight was no exception. We had the entire place to ourselves <3"
    "오늘밤도 다름 없었어. 온 공원이 우리 차지였지 ♥"

# game/script.rpy:2207
translate kor ch4_6ecf5db9:

    # "This way I can cling to Pastille all I want~! And on top of that..."
    "내가 원하는 만큼 파스틸에게 안길 수 있단 말이야~! 그리고 무엇보다..."

# game/script.rpy:2208
translate kor ch4_76b2fe88_14:

    # nvl clear
