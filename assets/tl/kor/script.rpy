translate kor start_4a82f0a6:

    # w calm "My line of WORK, then... hmhm, I suppose I can tell you."
    w calm "내 직업을 말하는 거구나... 후후, 말해도 괜찮겠지."

# game/script.rpy:487
translate kor start_0c6c18ec:

    # w smile "I'm an aromagician. I specialize in creating pleasant scents."
    w smile "나는 아로마법사야. 기분 좋은 향기를 만드는 사람."

# game/script.rpy:492
translate kor start_8154e712:

    # n "Periwinkle tugs his wand out from his sleeve and lightly taps the candle on the table."
    n "페리윙클이 소매에서 지팡이를 꺼내 테이블에 있는 양초를 가볍게 톡 칩니다."

# game/script.rpy:493
translate kor start_d54b5a73:

    # n "In a small burst, the atmosphere shifts around the pair..."
    n "작은 파동이 일고, 페리윙클과 파스틸 주변의 공기가 바뀝니다."

# game/script.rpy:494
translate kor start_508d0c25:

    # n "The candle's original aroma is quickly forgotten as it's replaced by something new and cozier."
    n "양초에서 나던 원래 향기가 사라지고 다른, 포근한 향기가 그 자리를 메꿉니다."

# game/script.rpy:496
translate kor start_47abf8af:

    # p oh "Oh... that IS nice."
    p oh "아... 정말 좋네요."

# game/script.rpy:497
translate kor start_66fd115e:

    # p smile "What smell is that? I'm no good at pinpointing stuff like this..."
    p smile "이건 어떤 향인가요? 저는 무슨 냄새인지 맞추는 데에 재주가 없나봐요..."

# game/script.rpy:498
translate kor start_67b12735:

    # w oh "Vanilla. I thought it suited you. Although..."
    w oh "바닐라야. 너랑 어울릴 거 같았거든. 아니면..."

# game/script.rpy:499
translate kor start_86dccb51:

    # w shy "I'm starting to think a more lustful scent might've been a better fit."
    w shy "조금 더 도발적인 향기로 바꿔도 괜찮았을 것 같기도 하고."

# game/script.rpy:500
translate kor start_a5d894c0:

    # p omgstop "Wh-what does that even mean...?!" with vpunch
    p omgstop "그... 그건 무슨 말이에요...!?" with vpunch

# game/script.rpy:501
translate kor start_f5e481ca:

    # w teehee "Just that you've done nothing but exceed my expectations <3"
    w teehee "그냥 네가 내 예상을 계속해서 뛰어넘고 있다는 말이지. ♥"

# game/script.rpy:502
translate kor start_857b0c55:

    # p flustered "I-I'm not... doing anything...."
    p flustered "저... 저는... 아무것도 안 하고 있는 걸요...."

# game/script.rpy:504
translate kor start_51513c28:

    # n "Pastille retreats behind his glass of water, overwhelmed by embarrassment once again."
    n "파스틸은 얼굴까지 차오른 부끄러움을 가라앉히기 위해 찬 물을 한 잔 들이킵니다."

# game/script.rpy:505
translate kor start_0c12172a:

    # w love "(I did say I'd go a little easier on him, didn't I...? Ah, he's just too irresistible <3)"
    w love "(조금은 가볍게 가겠다고 약속했는데, 아, 참을 수가 없네. ♥)"

# game/script.rpy:507
translate kor start_41bfaa4f:

    # w calm "Anywho... I bottle and sell scents like this one. It's fairly lucrative work, once you build a reputation for yourself."
    w calm "어쨌든... 나는 이런 향을 병에 담아서 팔고 있어. 명성이 생기면 안정적인 직업이지."

# game/script.rpy:508
translate kor start_9b95030e:

    # p oh "Ah... sounds fulfilling."
    p oh "아... 되게 성취감이 생기겠네요."

# game/script.rpy:509
translate kor start_df636102:

    # w smile "What about you, Pastille? What kind of magic do you specialize in?"
    w smile "너는, 파스틸? 너는 어떤 마법이 특기야?"

# game/script.rpy:510
translate kor start_acfb287e:

    # p shy "Oh, I... I had mostly been living without magic, until recently."
    p shy "아, 저는... 저는 최근까지는 마법을 안 쓰고 살고 있었어요."

# game/script.rpy:511
translate kor start_ba1cda83:

    # w oh "Without magic...? I can't imagine."
    w oh "마법을 안 쓴다고...? 상상도 안 되는데."

# game/script.rpy:512
translate kor start_39cda655:

    # p smile "It's not so bad. I mean, humans do it, so why not?"
    p smile "그렇게 나쁘진 않아요. 인간들은 원래 그렇게 살잖아요, 안 될게 뭐가 있겠어요?"

# game/script.rpy:513
translate kor start_1b160ca1:

    # w "I suppose that's true."
    w "맞는 말인 거 같네."

# game/script.rpy:514
translate kor start_a901b988:

    # w smile "I very directly make a living off of mine, so I'd find myself in quite a bind if I wasn't able to use it!"
    w smile "나는 마법이 생계랑 직결되기 때문에, 사용하지 못 한다면 발이 묶인 것 같을 거야."

# game/script.rpy:515
translate kor start_a5adf706:

    # w teehee "Not that I mind being bound from time to time, you know <3"
    w teehee "가끔 묶이는 것도 그리 나쁘진 않지만 말이야. ♥"

# game/script.rpy:516
translate kor start_49904814:

    # p omgstop "H-how do you keep doing that...?! Every time I think we're talking about something innocent..."
    p omgstop "어... 어떻게 계속 그러는 거예요...!? 건전한 이야기 잘 하고 있으면 계속..."

# game/script.rpy:517
translate kor start_cbd9ddf7:

    # w love "(Ah, I just can't help myself, can I?)"
    w love "(아, 정말 못 참겠다니까?)"

# game/script.rpy:518
translate kor start_5f36b5b8:

    # w teehee "Deliberate word choice, my sweet~ would you like me to hold back a little more?"
    w teehee "세심한 단어의 선택이라는 거야, 자기~ 조금 자제하는 편이 좋을까?"

# game/script.rpy:519
translate kor start_04132ea6:

    # p um "N-no, it's okay... I was just..."
    p um "아... 아뇨... 괜찮아요... 그냥..."

# game/script.rpy:520
translate kor start_89193a14:

    # p embarrassed "Kinda impressed...."
    p embarrassed "좀 대단하다 싶어서...."

# game/script.rpy:526
translate kor start_ca622856:

    # "We finish up our meals, and decide on sharing a slice of strawberry cheesecake for dessert."
    "우리는 식사를 끝내고, 나는 디저트로 파스틸과 함께 딸기 치즈케이크를 먹기로 결정했어."

# game/script.rpy:527
translate kor start_d1910196:

    # "Pastille deliberately leaves the larger bits of strawberries for me..."
    "파스틸은 나에게 일부러 더 큰 딸기를 남겨줬지..."

# game/script.rpy:528
translate kor start_014b42bb:

    # "I wonder, is it because he doesn't like them? Or is he just THAT kind?"
    "궁금하다. 딸기를 별로 좋아하지 않는 걸까, 아니면 정말 그 정도로 착한 걸까?"

# game/script.rpy:529
translate kor start_a37124b7:

    # "Either way, this has quickly become my most favorite date of the past few months <3"
    "뭐가 정답이든, 근래 몇 달 간 데이트 중에 이 데이트가 제일인 걸로 판명났네 ♥"

# game/script.rpy:530
translate kor start_76b2fe88_5:

    # nvl clear
    nvl clear

# game/script.rpy:534
translate kor start_a47a6a63:

    # w smile "Tell me more about yourself, Pastille. I'm afraid the only thing I know is that you work at the renowned Atelier Sweets..."
    w smile "너에 대해서 더 알려줘, 파스틸. 나는 너에 대해서 알고 있는 게 그 유명한 아틀리에 과자점에서 일하고 있다는 것밖에 없단 말이야..."

# game/script.rpy:535
translate kor start_a256d276:

    # p ehe "Oh, um... there's not much else to know...."
    p ehe "아, 어... 그거 말고 딱히 이야기할만한 건 없는걸요...."

# game/script.rpy:536
translate kor start_b5d5581a:

    # w happy "Surely there's plenty more than just that! Any hobbies, perhaps?"
    w happy "그거 말고도 많겠지! 그럼 취미는 있어?"

# game/script.rpy:537
translate kor start_ff0c91f6:

    # p shy "C...cleaning, maybe?"
    p shy "처... 청소려나요?"

# game/script.rpy:538
translate kor start_323445d9:

    # w calm "Any NON work-related hobbies, dear."
    w calm "일이랑 관련된 거는 빼고."

# game/script.rpy:539
translate kor start_452a98f0:

    # p ehe2 "Sorry, I never know how to answer these types of questions..."
    p ehe2 "죄송해요, 이런 질문은 어떻게 대답해야 하는지 몰라서..."

# game/script.rpy:540
translate kor start_bd8b2307:

    # p smile "My best friend is an alchemist, so I've recently been going on little adventures to help gather ingredients for her craft."
    p smile "저랑 가장 친한 친구가 연금술사거든요. 그래서 연금술에 쓸 재료를 찾아 최근까지 같이 모험을 다니고 있었어요."

# game/script.rpy:541
translate kor start_6c670493:

    # w my "Now THERE'S something interesting!"
    w my "그건 꽤 흥미로운 이야기인걸!"

# game/script.rpy:542
translate kor start_e955536c:

    # p shy "Other than that, I honestly don't get out much... I have my hands full running the store."
    p shy "그거 말고는, 잘 나가지도 않아서... 상점을 운영하는 것만으로도 많이 바쁘거든요."

# game/script.rpy:543
translate kor start_d04e37c7:

    # w smile "So diligent <3 Does that mean this is your first night out in a while?"
    w smile "정말 열심이라니까. ♥ 그럼 바깥에 이렇게 나온 건 오래간만이라는 거야?"

# game/script.rpy:544
translate kor start_03f245f3:

    # p oh "Ah... yeah, I guess it is."
    p oh "아... 네, 그런 셈이죠."

# game/script.rpy:545
translate kor start_97012fb5:

    # w innocent "I'm honored you were willing to share it with me, then~"
    w innocent "나랑 같이 그 시간을 써준다니, 너무 기쁜데~"

# game/script.rpy:546
translate kor start_8c01ab99:

    # p shy "Yeah! I don't think I ever would've tried this place if you hadn't brought me in..."
    p shy "네! 저도 페리윙클이 아니었다면 이런 곳에는 오지 않았을지도 몰라요..."

# game/script.rpy:547
translate kor start_ddcf714a:

    # p ehe "So... it's been worth it so far. Thanks, Periwinkle."
    p ehe "그러니까... 아직까지는 정말 값진 시간인 거 같아요. 고마워요, 페리윙클."

# game/script.rpy:553
translate kor start_79c59f28:

    # "The table had long been cleared, and yet our conversation continued through the night."
    "테이블 위는 깨끗해졌지만, 우리의 대화는 밤 늦게까지 이어졌어."

# game/script.rpy:554
translate kor start_1efc9d29:

    # "This place is never too busy, which always leaves me free to linger here without the guilt of taking up any much-needed table space."
    "이 곳은 항상 한산해서, 다른 사람이 앉을 수도 있는 자리를 차지하고 있다는 죄책감에 시달리지 않아도 돼서 좋아."

# game/script.rpy:555
translate kor start_b7237054:

    # "The longer the date, the more satisfying the finale <3 That's something I live by."
    "이 데이트가 길어질수록, 피날레가 더 만족스러워지겠지. ♥ 나는 이 맛에 산다니까."

# game/script.rpy:556
translate kor start_6ec3835a:

    # "Rushing straight to the climax inevitably gets a bit dull after a while. I want to enjoy this night to its fullest <3"
    "곧바로 클라이맥스로 건너뛰어버리는 건 조금 해보면 질린단 말이지. 오늘밤은 최대한으로 즐기고 싶어. ♥"

# game/script.rpy:557
translate kor start_76b2fe88_6:

    # nvl clear
    nvl clear

