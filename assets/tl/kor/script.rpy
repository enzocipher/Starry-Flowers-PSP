translate kor ch2_1019ebc0:

    # w innocent "Lost track of time <3 You'll forgive me, won't you~?"
    w innocent "언제 시간이 이렇게 빨리 갔는지, 용서해줄거지~? ♥"

# game/script.rpy:788
translate kor ch2_7862874c:

    # a "You are literally my only provider who has no respect for appointments."
    a "내가 쓰는 업체 중에 약속 시간을 이렇게 안 지키는 업체는 너밖에 없다."

# game/script.rpy:789
translate kor ch2_2fb8a6f9:

    # w oh "That's simply not true! I never miss a date."
    w oh "틀린 말씀! 난 데이트 약속은 확실하게 지킨다고."

# game/script.rpy:790
translate kor ch2_acda7219:

    # a lol "There's the problem. You were out getting laid again, weren't you?"
    a lol "그게 문제라는 말이야. 너 또 떡치고 다녔지?"

# game/script.rpy:791
translate kor ch2_dbeacd97:

    # w pout "How vulgar~ I had a romantic evening with a VERY cute boy..."
    w pout "어쩜 입이 그렇게 험할까~ 난 아주 귀여운 남자애랑 같이 로맨틱한 저녁을 보낸 거란 말이야."

# game/script.rpy:792
translate kor ch2_d7ebcbc7:

    # w innocent "Who then ended up sleeping over <3"
    w innocent "물론 같이 잠까지 잤지만. ♥"

# game/script.rpy:793
translate kor ch2_facdd2e0:

    # a whatever "Well, you had all week to fill the order. Try getting it done in advance next time."
    a whatever "주문 물량 채우라고 일주일이나 줬잖아. 다음에는 미리 채워놓도록 해."

# game/script.rpy:794
translate kor ch2_8de08278:

    # w calm "Yes, ma'am~"
    w calm "네, 알겠습니다~"

# game/script.rpy:795
translate kor ch2_e220bd55:

    # a closed "Now let's see what you brought..."
    a closed "그럼 가지고 온 거나 좀 볼까..."

# game/script.rpy:797
translate kor ch2_6aa2ff6b:

    # "I've worked with Astragalus for a few years now."
    "아스트라갈루스와 내가 함께 일한 건 벌써 몇 년째야."

# game/script.rpy:798
translate kor ch2_88aee593:

    # "She's COMPLETLY immune to my charms. Shocking, to say the least."
    "내 매력에 완전히 면역을 가진 인간이지. 아주 충격적이야."

# game/script.rpy:799
translate kor ch2_f1139fde:

    # "But it's meant we've been able to remain good friends all this time~"
    "하지만 그 덕에 우리 둘은 아직까지 좋은 친구로 남아있을 수 있게 됐지~"

# game/script.rpy:800
translate kor ch2_4fc199f3:

    # "Or... hm. Let's see..."
    "아니면... 흠. 어디 보자..."

# game/script.rpy:801
translate kor ch2_76b2fe88_1:

    # nvl clear
    nvl clear

# game/script.rpy:804
translate kor ch2_2c3696be:

    # w oh "Astragalus. Would you consider us to be good friends?"
    w oh "아스트라갈루스, 너는 우리가 좋은 친구 사이라고 생각해?"

# game/script.rpy:805
translate kor ch2_c86bbb5c:

    # a whatever "I put up with you."
    a whatever "난 널 견뎌주는 것 뿐이다."

# game/script.rpy:806
translate kor ch2_373f7314:

    # w happy "My, but you don't put up with ANYONE! You must really like me <3"
    w happy "어머, 하지만 넌 그 누구도 견뎌주지 않잖아! 내가 정말 좋은가본데? ♥"

# game/script.rpy:807
translate kor ch2_47067d4c:

    # a lol "You got a favor to ask or something? Is that what you're getting at?"
    a lol "뭐 필요한 거라도 있어? 뭐 부탁하려고 지금 그러는 거야?"

# game/script.rpy:808
translate kor ch2_df3d1bd8:

    # w calm "No, I was just thinking of how to categorize our relationship."
    w calm "아니, 그냥 우리의 관계를 어떻게 정의하면 좋을까 생각하고 있었던 것 뿐이야."

# game/script.rpy:809
translate kor ch2_72e2a8ac:

    # a "\"Business associate\" works just fine, doesn't it?"
    a "\'동업자\'로 충분하지 않아?"

# game/script.rpy:810
translate kor ch2_5f78763b:

    # w happy "Come now, surely you consider us to be closer than that!"
    w happy "에이, 우리 사이는 그것보다는 가깝지 않아?"

# game/script.rpy:811
translate kor ch2_ce50824a:

    # a sure "I know better than to get involved with you, Periwinkle."
    a sure "너랑 꼬여봤자 되는 일 없다는 거 정도는 알고 있다, 페리윙클."

# game/script.rpy:812
translate kor ch2_17ce8a61:

    # w my "Why, whatever do you mean?"
    w my "어머, 그게 무슨 말이니?"

# game/script.rpy:813
translate kor ch2_0ac87123:

    # a whatever "You're too dazzling."
    a whatever "넌 너무 빛나."

# game/script.rpy:814
translate kor ch2_4a6eea27:

    # w innocent "I take that as a compliment~"
    w innocent "칭찬으로 받아들을게~"

# game/script.rpy:815
translate kor ch2_d60255a0:

    # a annoyed "Great, now will you stop distracting me? I'm trying to count."
    a annoyed "그래. 그럼 나 그만 방해해줄래? 나 지금 물량 세고 있잖아."

# game/script.rpy:817
translate kor ch2_8c4a5641:

    # "Yes, we're definitely good friends."
    "우리는 확실히 좋은 친구야."

# game/script.rpy:818
translate kor ch2_9ecc4a32:

    # "\"Too dazzling\" though... I'm not sure there IS such a thing."
    "\"너무 빛나\" 라니... 그런 게 이 세상에 있을까?"

# game/script.rpy:819
translate kor ch2_82c90c4f:

    # "And what would be wrong with it if there was? What point is there in not shining as brightly as one can?"
    "그런 게 있다면 그게 뭐가 나쁘다는 거지? 빛날 수 있는 최대한으로 빛나지 않으면 무슨 소용이 있는 거지?"

# game/script.rpy:820
translate kor ch2_d0dcce99:

    # "Astragalus finishes counting the bottles, sighing in feigned exasperation as she marks them off her checklist..."
    "아스트라갈루스는 병을 세는 것을 끝내고 힘든 척 한숨을 쉬며 체크리스트에 표시를 하고 있어."

# game/script.rpy:821
translate kor ch2_529b0ff5:

    # nvl clear
    # a sure "You may always be late... but you deliver quality every time. You're consistent, if nothing else."
    nvl clear
    a sure "항상 늦긴 하지만... 매번 물건 상태는 좋네. 일관적이라 다행인 건지."

# game/script.rpy:824
translate kor ch2_389bf1e7:

    # w teehee "The waiting is part of the fun. It builds excitement, wouldn't you say?"
    w teehee "기다리는 것도 즐거움의 일부야. 신나지 않니?"

# game/script.rpy:825
translate kor ch2_2f490664:

    # a whatever "Nope, just builds frustration for me. But at least you always come through."
    a whatever "별로. 그냥 짜증만 날 뿐인데. 최소한 결국에는 오니까 상관 없다만."

# game/script.rpy:827
translate kor ch2_4251ed12:

    # n "She unlocks a small drawer behind the counter, and takes out an envelope with Periwinkle's name scribbled on it."
    n "아스트라갈루스는 카운터 뒤에 있는 작은 서랍을 열고, 페리윙클의 이름이 적힌 봉투를 꺼냅니다."

# game/script.rpy:829
translate kor ch2_9104554e:

    # a closed "Here's the rest of your payment. Don't spend it all in one place."
    a closed "여기 나머지 금액이야. 한 곳에 다 써버리지 말라고."

# game/script.rpy:830
translate kor ch2_338d50e7:

    # w calm "Oh, I couldn't if I tried! Really, you're too generous..."
    w calm "어머, 그럴래야 못 쓸 금액인걸! 정말, 넌 손이 너무 크다니까..."

# game/script.rpy:833
translate kor ch2_8daa5982:

    # n "Astragalus rolls her eyes and begins stocking the shelves with her new inventory."
    n "아스트라갈루스는 눈을 굴리고 새로 들어온 물건들을 서랍에 채우기 시작합니다."

# game/script.rpy:835
translate kor ch2_ffbdbe6c:

    # "Two or three orders a month... that's all it takes to support myself, entirely through this apothecary."
    "한 달에 주문 두세개... 이 약제상 주문만으로도 먹고 살 돈은 생겨."

# game/script.rpy:836
translate kor ch2_ba2406db:

    # "Hard to believe my magic is really worth so much, but who am I to complain?"
    "내 마법이 이렇게 값어치가 높다니, 뭐, 불평은 안 하지만!"

# game/script.rpy:837
translate kor ch2_acb5044d:

    # "It's certainly a more favorable balance compared to the kind of work I was doing years ago."
    "내가 몇 년 전까지 했던 일이랑 비교했을 때 확실히 더 마음에 드는 급여인 거 같아."

# game/script.rpy:838
translate kor ch2_7acd925f:

    # nvl clear
    # "And I do enjoy the freedom, the excessive amounts of time I have for partying, for dates..."
    nvl clear
    "그리고 자유로운 것도, 파티에 쓸 시간이 남아도는 것도, 데이트에 갈 시간이 남아도는 것도 좋아."

# game/script.rpy:840
translate kor ch2_a2058868:

    # "Ah, on that note~"
    "아, 그러고 보니~"

# game/script.rpy:841
translate kor ch2_0b1b7e93:

    # nvl clear
    # w happy "With all that business out of the way... would you like to hear about my date? <3"
    nvl clear
    w happy "일도 다 끝났겠다... 내 데이트 이야기 듣고 싶어? ♥"

# game/script.rpy:844
translate kor ch2_fa857f5d:

    # a sure "Would I LIKE to? Not necessarily."
    a sure "듣고 싶냐고? 딱히."

# game/script.rpy:845
translate kor ch2_95d8347d:

    # w teehee "Please, Astragalus, as someone with no romance in your OWN life, the least you can do is live vicariously through me~"
    w teehee "제발, 아스트라갈루스. 네 인생에는 로맨스가 없잖아. 내 경험을 통해 간접적으로라도 체험하라구~"

# game/script.rpy:846
translate kor ch2_8be11c8d:

    # a whatever "The no romance thing is by choice. I listen to you gush for your own damn sake."
    a whatever "로맨스가 없는 건 내 결정이야. 나는 너 좋으라고 네 얘기를 들어주는 거라고."

# game/script.rpy:847
translate kor ch2_66b3a391:

    # w my "For MY sake?"
    w my "나 좋으라고라고?"

# game/script.rpy:848
translate kor ch2_e2b9789b:

    # a sure "Yeah, I'm afraid you might actually implode if you had no one to talk to about this stuff."
    a sure "그래, 네 이야기를 들어줄 사람이 없었으면 너는 지금쯤이면 무너지고 있었을 거 아니야."

# game/script.rpy:849
translate kor ch2_fdfc2ccd:

    # a lol "I'm actually making a noble sacrifice every day that you come in here with new tales of romantic conquest."
    a lol "매일 여기에서 네 로맨스 정복 이야기를 들어주는 건 나의 숭고한 희생이라고."

# game/script.rpy:850
translate kor ch2_b3b6ebb7:

    # w pout "Hmph. If you're truly suffering, I shall desist..."
    w pout "흥, 그렇게 고통받고 있으면, 관두고 말지..."

# game/script.rpy:851
translate kor ch2_115b6d90:

    # a smile "That's the thing, though... I DO like seeing you all worked up over something, even if I don't understand it myself."
    a smile "그게 또 말이지... 네가 뭔가에 열정적인 모습은 보기 좋아. 나는 잘 이해 안 되지만."

# game/script.rpy:852
translate kor ch2_dfd74c02:

    # w happy "Ahh, so there IS a mutual benefit! You'll listen, then? <3"
    w happy "아, 그럼 상호간에 이익이 있다는 말이네! 그럼 내 얘기 들어줄 거지? ♥"

# game/script.rpy:853
translate kor ch2_e4b44b62:

    # a sure "Yeah, at least until I get all this put away. After that, I'm kicking you out for the day."
    a sure "그래. 이거 다 치우기 전까지는. 그 이후에는 널 여기서 추방시킬 거야."

# game/script.rpy:855
translate kor ch2_aa202e59:

    # w calm "Fair enough. I'd better be brief, then..."
    w calm "좋아. 그럼 간단하게 말해야겠네."

# game/script.rpy:857
translate kor ch2_c163a19e:

    # w teehee "He's the absolute cutest thing! I picked him up at a candy shop yesterday <3"
    w teehee "그 애는 너무 귀여워! 어제 사탕 가게에서 주워왔다구. ♥"

# game/script.rpy:858
translate kor ch2_7ea91466:

    # w happy "Fluffy pink hair, with golden eyes, naturally rosy cheeks that make him look as if he's always a little embarrassed by something..."
    w happy "복슬한 분홍 머리에, 금색 눈동자, 그리고 항상 부끄러운 듯이 자연스레 빨개져있는 두 뺨..."

# game/script.rpy:859
translate kor ch2_78bc035b:

    # w shy "He's shy, but not the type that becomes paralyzed in the bedroom--"
    w shy "부끄러움이 많은 애인데, 얘가 또 침대에서 얼어붙지는 않더라구--"

# game/script.rpy:860
translate kor ch2_e6e9e69b:

    # a augh "Periwinkle, for the last time, I do NOT need to hear about bedroom stuff." with vpunch
    a augh "페리윙클, 마지막으로 말하는데, 난 네 침대 얘기는 듣고 싶지 않아." with vpunch

# game/script.rpy:861
translate kor ch2_91bce83e:

    # w my "I wasn't giving any details!"
    w my "자세하게는 안 말했잖아!"

# game/script.rpy:862
translate kor ch2_f28bb905:

    # w shy "Although, the details ARE the best part <3"
    w shy "물론 그 자세한 부분이 최고였지만. ♥"

# game/script.rpy:863
translate kor ch2_6f8d4d69:

    # a annoyed "This is a \"safe for work\" zone only. Break that rule, and you're outta here."
    a annoyed "여기는 \"19금 안전 지대\" 라고. 그 규칙을 깨면, 넌 바로 퇴장이야."

# game/script.rpy:864
translate kor ch2_91ce2d8b:

    # w innocent "My apologies~ I'll refrain."
    w innocent "미안~ 자제할게."

# game/script.rpy:865
translate kor ch2_dc5be651:

    # w love "Anyway, my point is... he's EXTREMELY cute. Adorable, in fact!"
    w love "어쨌든, 결론은... 그 애가 완전 귀엽다는 거야. 너무 사랑스러워!"

# game/script.rpy:866
translate kor ch2_d8b497e3:

    # a eyeroll "Right, so, standard fare for you."
    a eyeroll "그래, 네 평소 이야기랑 다를 바 없네."

# game/script.rpy:867
translate kor ch2_fc605430:

    # w my "Absolutely not! If he was just your average cutie, would I be emphasizing his cuteness so much?"
    w my "그렇지 않거든! 만약 걔가 평범한 귀염둥이였으면, 걔가 귀여운 걸 내가 이렇게까지 설명하고 있었을 거 같아?"

# game/script.rpy:868
translate kor ch2_a47387c2:

    # a sure "I don't meet these people, so it's all the same to me."
    a sure "네가 보는 사람이지 내가 보는 사람이냐. 내 눈엔 다 똑같아보여."

# game/script.rpy:869
translate kor ch2_afb4034f:

    # w oh "How can it be~? The intensity is so drastically different... perhaps SO intense that I'm having trouble explaining it properly."
    w oh "어떻게 그럴 수가~? 그 강렬함은 격이 다르다고... 너무 달라서 제대로 설명하는 것조차 힘든가봐."

# game/script.rpy:870
translate kor ch2_3da682aa:

    # a closed "I'll say. All you've really told me so far is that he's cute and shy."
    a closed "네가 나한테 한 이야기라고는 그 애가 귀엽고 부끄러움이 많다는 것밖에 없는데."

# game/script.rpy:871
translate kor ch2_8e3642e4:

    # w shy "He's kind, as well! He saved the best part of our dessert for me without even asking!"
    w shy "그 애는 친절하기도 해! 물어보지도 않고 디저트의 가장 맛있는 부분을 남겨줬단 말이야!"

# game/script.rpy:872
translate kor ch2_dfa9b85a:

    # a lol "Wow, I would've led with that one."
    a lol "오, 나였으면 그걸로 오케이였겠는데."

# game/script.rpy:873
translate kor ch2_fdbe174a:

    # w pout "Ohh, enough of your sarcasm. When all my favorite details are off-limits, what do you suppose I'm LEFT with?"
    w pout "네 빈정거림은 됐거든. 내가 제일 좋아하는 부분은 말하지도 못하는데, 대체 무슨 이야기를 해야 하는 거야?"

# game/script.rpy:874
translate kor ch2_ab7c305b:

    # a happy "Well, what really matters is that you had a good night. Even if it meant you couldn't get here on time like I asked."
    a happy "뭐, 가장 중요한 건 네가 좋은 밤을 보냈다는 거 아니겠어? 내가 말한대로 제시간에 도착하지 못하긴 했지만 말이야."

# game/script.rpy:875
translate kor ch2_f5e62b00:

    # w love "Ahh~ I'm already hoping to see him again, to be honest..."
    w love "아~ 사실 벌써부터 그 애가 다시 보고 싶어..."

# game/script.rpy:876
translate kor ch2_0979287d:

    # a hm "Oh yeah? Don't hear that from you very often."
    a hm "아, 그래? 그건 너한테서 자주 못 듣는 말이네."

# game/script.rpy:877
translate kor ch2_83be95f7:

    # w oh "Really? But I've gone on second dates all the time."
    w oh "정말? 하지만 난 애프터도 자주 가곤 하는걸."

# game/script.rpy:878
translate kor ch2_95f62998:

    # a lol2 "This guy got a name?"
    a lol2 "걔 이름이 뭔데?"

# game/script.rpy:879
translate kor ch2_899be6dd:

    # w shy "Hmhm, I don't kiss and tell <3"
    w shy "후후, 난 내 관계 공유는 잘 안 한다구. ♥"

# game/script.rpy:880
translate kor ch2_7b70ce89:

    # a sure "No, actually, you tell me about everyone you kiss."
    a sure "아니, 평소에 너랑 입 한 번 맞춘 애 신상은 다 털어놓으면서."

# game/script.rpy:881
translate kor ch2_44e74989:

    # a lol "C'mon, if he's really the absolute cutest, it's a shame to keep him anonymous, right? Not like I'm gonna tell anyone anyways."
    a lol "야, 그렇게 귀여운 녀석이면 익명으로 남기기 아깝지 않아? 어차피 내가 뭐 다른 사람한테 까발리고 다니는 것도 아닌데."

# game/script.rpy:882
translate kor ch2_cb259e44:

    # w calm "Fine... his name is Pastille."
    w calm "좋아... 걔 이름은 파스틸이야."

# game/script.rpy:883
translate kor ch2_ce121fd3:

    # a annoyed "Hmph. Even his name's cute."
    a annoyed "흐응. 이름도 귀엽네."

# game/script.rpy:884
translate kor ch2_b434ce04:

    # w happy "Right~?"
    w happy "그치~?"

# game/script.rpy:885
translate kor ch2_2d463d2b:

    # w smile "Oh, that reminds me--he sold me some candies that share his name. Would you like to try?"
    w smile "아, 생각해보니... 걔가 걔 이름이랑 같은 이름의 사탕을 나한테 줬거든. 한번 먹어볼래?"

# game/script.rpy:886
translate kor ch2_628745c1:

    # a happy "Sure. How could a witch turn down free candy?"
    a happy "좋아. 공짜 사탕은 못 배기지."

# game/script.rpy:887
translate kor ch2_2ac72dd0:

    # n "Periwinkle digs into his bag and pulls out one of the pastilles."
    n "페리윙클은 가방 안에 손을 넣어 파스틸 사탕을 꺼냅니다."

# game/script.rpy:888
translate kor ch2_c90345e5:

    # n "He hands the candy to Astragalus, who promptly unwraps it and pops it into her mouth."
    n "아스트라갈루스는 페리윙클로부터 사탕을 받아 포장을 풀고 입 안에 넣습니다."

# game/script.rpy:889
translate kor ch2_e3dc6cdf:

    # a hm "Mmf... Oh, these are GOOD. Where'd you say this candy shop was?"
    a hm "음... 오, 이거 진짜 맛있는데. 그 사탕 가게, 어디 있다고 했지?"

# game/script.rpy:890
translate kor ch2_6e7c54dc:

    # w happy "Not far from here! I'll give you directions..."
    w happy "여기서 멀지 않아! 어디인지 알려줄게..."

# game/script.rpy:897
translate kor ch2_58993334:

    # "Shortly after telling Astragalus where to find Atelier Sweets, she unceremoniously kicked me out..."
    "아스트라갈루스에게 아틀리에 과자점이 어디 있는지 알려주고 나서 얼마 지나지 않아 난 배응망덕하게도 내쫓겼어..."

# game/script.rpy:898
translate kor ch2_7f4ee160:

    # "She'd long finished putting all those bottles away, after all."
    "확실히 아스트라갈루스는 병을 정리한지 꽤 시간이 지난 상태였지."

# game/script.rpy:899
translate kor ch2_d635dbff:

    # "With money in my pocket, and no more work to be done for the moment... I'm free to begin pursuing my next date~"
    "돈으로 두툼해진 내 주머니, 그리고 할 일의 부재... 다음 데이트를 하기에는 딱인걸~"

# game/script.rpy:900
translate kor ch2_a4f99886:

    # nvl clear
    # "But wherever shall I go? It's a weekday, too early for parties, too early for drinks..."
    nvl clear
    "하지만 어디로 가야 할까? 평일이고, 파티에 가기에도, 술을 마시기에도 너무 이른 시간이고..."

# game/script.rpy:902
translate kor ch2_1e5385aa:

    # "I suppose I could return home and straighten up the place. However..."
    "집으로 돌아가서 청소를 할 수도 있겠지만..."

# game/script.rpy:903
translate kor ch2_801baa18:

    # nvl clear
    # w calm "(Why would I busy myself with chores when I could be celebrating another order successfully filled?)"
    nvl clear
    w calm "(주문을 성공적으로 마친 걸 축하할 수도 있는데, 왜 굳이 귀찮게 또 일을 해야 해?)"

# game/script.rpy:906
translate kor ch2_7123d8ef:

    # n "Before Periwinkle can decide on where to go, a familiar witch approaches him."
    n "페리윙클이 어디로 갈 수 있기 정하기 전에, 어디서 본 마녀가 페리윙클에게 접근해 옵니다."

# game/script.rpy:909
translate kor ch2_a7e53e02:

    # c "Periwinkle...?"
    c "페리윙클...?"

# game/script.rpy:910
translate kor ch2_ed8e4bc5:

    # w happy "Ohh, Cassia! So lovely to see you~"
    w happy "어머, 카시아! 만나서 너무 반갑다~"

# game/script.rpy:911
translate kor ch2_cca6951a:

    # c happy "Yay, I'm so glad we ran into each other~"
    c happy "야호, 이렇게 만나서 정말 기뻐~"

# game/script.rpy:913
translate kor ch2_18cfade9:

    # "How to describe Cassia..."
    "카시아는 어떤 아이냐면..."

# game/script.rpy:914
translate kor ch2_0c67f0a0:

    # "She's exceedingly cuddly. We met at a party one night, during which she latched onto my arm and never let go. Quite endearing!"
    "스킨쉽을 아주 좋아하는 아이야. 어느 한 밤중에 파티에서 만났는데, 내 팔에 안기더니 놓아주지를 않더라고. 정말 사랑스럽다니까!"

# game/script.rpy:915
translate kor ch2_6535f464:

    # "Since then, we've gone on little dates from time to time..."
    "그 뒤로 때때로 작은 데이트를 가곤 했지..."

# game/script.rpy:916
translate kor ch2_91a4c39c:

    # "She really loves my magic, so I tend to spoil her whenever we're together <3"
    "카시아는 내 마법을 정말 좋아해. 그래서 같이 있을 때는 잔뜩 내 향기를 맡게 해주지. ♥"

# game/script.rpy:917
translate kor ch2_fc9d5dc6:

    # nvl clear
    # w smile "Did you need something, dear?"
    nvl clear
    w smile "필요한 거 있어, 자기?"

# game/script.rpy:920
translate kor ch2_7206142c:

    # c aww "Ah, yes! I tried coming over last night, but you didn't seem to be home..."
    c aww "아, 응! 어제 네 집에 찾아갔는데, 집에 없는 거 같더라고..."

# game/script.rpy:921
translate kor ch2_693e007a:

    # w shy "Aww, you came to visit me? I'm flattered <3"
    w shy "아, 날 보러 와준 거니? 너무 기쁜데. ♥"

# game/script.rpy:922
translate kor ch2_399869f1:

    # w smile "I must've been out to dinner at the time... Sorry that I missed you~"
    w smile "그날은 저녁을 먹으러 나갔던 날이었을 거야... 널 붙잡지 못해서 미안해~"

# game/script.rpy:923
translate kor ch2_2f0adf6c:

    # c smile "Oh, it's okay~ I was mostly looking to talk..."
    c smile "아, 괜찮아~ 그냥 이야기나 좀 하고 싶어서..."

# game/script.rpy:924
translate kor ch2_c9ba5380:

    # c aww "So, um, if you're available right now... do you wanna go to a café?"
    c aww "그러니까, 음, 혹시 지금 시간 나면... 같이 카페 갈래?"

# game/script.rpy:925
translate kor ch2_d5996b44:

    # w innocent "That sounds perfect! I would love to."
    w innocent "완벽한걸! 같이 갈게."

# game/script.rpy:931
translate kor ch2_e516a126:

    # "We take our seats at the nearby café."
    "우리는 근처 카페에 자리를 잡았어."

# game/script.rpy:932
translate kor ch2_07ec8f7d:

    # "It's a pleasant, sunny little place. I've come here often with all sorts of other witches."
    "분위기 좋고 햇빛이 잘 들어오는 곳이야. 여기에는 갖가지 다른 마녀들과 함께 온 적이 있지."

# game/script.rpy:933
translate kor ch2_798bacd1:

    # "Cassia orders her usual hot chocolate with extra marshmallows, while I decide on a simple rose tea."
    "카시아는 평소에 마시는 마시멜로가 들어있는 핫초코를 시켰고, 나는 간단하게 로즈 티를 골랐어."

# game/script.rpy:934
translate kor ch2_13febc5a:

    # nvl clear
    # c oh "Ooh, Periwinkle, could you make my marshmallows smell like roses, too?"
    nvl clear
    c oh "오, 페리윙클, 내 마시멜로도 장미 향이 나게 해 줄 수 있어?"

# game/script.rpy:937
translate kor ch2_e1d1de4a:

    # w innocent "With pleasure <3"
    w innocent "기꺼이. ♥"

# game/script.rpy:938
translate kor ch2_d7d93e12:

    # n "Periwinkle's wand drops from his sleeve, and he gives Cassia's cup a quick little tap."
    n "페리윙클은 소매에서 지팡이를 꺼내 카시아의 컵을 가볍게 두드립니다."

# game/script.rpy:939
translate kor ch2_9343669f:

    # c happy "Eheh, yay~ It really smells just like roses~!"
    c happy "에헤헤, 야호~ 진짜 장미 향이 나잖아~!"

# game/script.rpy:940
translate kor ch2_790200db:

    # w smile "Just as you asked, dear. It may slightly affect the taste, so let me know if you'd like the spell undone."
    w smile "부탁했던 대로야, 자기. 맛에도 조금 영향이 있을지 모르니까, 주문을 풀고 싶으면 말해."

# game/script.rpy:942
translate kor ch2_51b79206:

    # n "Cassia dips her spoon in and lifts a marshmallow to her lips, blowing on it lightly before popping it into her mouth."
    n "카시아는 숟가락으로 마시멜로를 꺼내 입술로 가져가 호호 불고 입 안에 넣습니다."

# game/script.rpy:943
translate kor ch2_bb00d05f:

    # c happy "Mmf... no, it's wonderful! Ehehe~ <3"
    c happy "으음... 아니, 정말 최고야! 에헤헤~ ♥"

# game/script.rpy:946
translate kor ch2_88501500:

    # "She truly can find the joy in any little moment. Such a delight..."
    "정말 작은 일 하나하나에서도 즐거움을 찾는구나. 어쩜 저리 행복할 수가..."

# game/script.rpy:947
translate kor ch2_28e04d59:

    # "Definitely a contender for the title of absolute cutest witch. Though I would call her... absolutely cute, rather than the absolute cutest."
    "확실히 가장 귀여운 마녀 중 순위에 오르겠어. 나라면 카시아를... 가장 귀여운 마녀는 아니지만 완전히 귀여운 마녀라고 하겠지만."

# game/script.rpy:948
translate kor ch2_22a82a32:

    # "It takes more than cuteness alone to earn the title of absolute cutest witch! That's where the difference lies, of course."
    "가장 귀여운 마녀라는 칭호를 위해서는 단순히 귀여운 것만으로는 부족해! 당연히 그 부분에서 순위가 갈리는 거라고."

# game/script.rpy:949
translate kor ch2_1167b98f:

    # nvl clear
    # "But what am I thinking? How rude it is, to begin ranking my dates in such a way."
    nvl clear
    "나도 참, 무슨 생각을 하고 있는 거람? 내 데이트에 순위를 매기다니, 무례하기도 하지."

# game/script.rpy:951
translate kor ch2_89364570:

    # "I must be stuck on the thought from my earlier conversation with Astragalus... trying to put Pastille's cuteness into words."
    "아까 전 아스트라갈루스와 함께 한 대화에서 빠져나오고 있질 못 한가 봐... 파스틸의 귀여움을 말로 표현하려고 하다 보니 그만."

# game/script.rpy:952
translate kor ch2_f14542af:

    # "He really is something special... ah, it's all in the contrast! His polite, well-mannered and proper exterior, concealing such intense desire, begging you to make the first move, and then going ahead and taking it on his own as soon as you--"
    "정말 특별한 사람이라니까... 아, 모든 부분이 비교돼! 깔끔하게 잘 정돈된 옷매무새, 자기 욕망을 숨기는 점, 내가 첫 걸음을 이끌어주기를 바라는 점, 그리고 때에 따라서 바로 자기가 리드하는 모습까지..."

# game/script.rpy:953
translate kor ch2_d02f8f43:

    # nvl clear
    # w oops "(...Enough of that! There's someone else in front of me now, isn't there?)" with vpunch
    nvl clear
    w oops "(...이 생각은 여기까지! 지금 눈앞에 다른 사람을 두고 있잖아?)" with vpunch

# game/script.rpy:956
translate kor ch2_84a03c6d:

    # n "Cassia continues happily sipping her hot chocolate before speaking up again."
    n "카시아는 다시 입을 열기 전에 행복한 모습으로 코코아를 홀짝입니다."

# game/script.rpy:958
translate kor ch2_4958d936:

    # c aw "Ahh, I missed you, Periwinkle~ I've been so busy with packing, I haven't had a chance to see you at all..."
    c aw "아, 정말 보고 싶었어, 페리윙클~ 이사하느라 바빠서 널 볼 기회가 좀처럼 나질 않지 뭐야.."

# game/script.rpy:959
translate kor ch2_15a35145:

    # w my "Packing? And just where are you headed off to?"
    w my "이사? 어디로 가는 거야?"

# game/script.rpy:960
translate kor ch2_959ab161:

    # c oh "Oh, that's right! I never had a chance to tell you~"
    c oh "아, 맞아! 그러고 보니 말할 기회가 없었구나~"

# game/script.rpy:961
translate kor ch2_28a09411:

    # c happy "I'm finally moving in with my partners~! In two more days, the three of us will all be sleeping in the same bed~ <3"
    c happy "나 드디어 내 파트너들이랑 같이 살게 됐어~! 이틀 뒤면 셋이서 같은 침대에서 잘 수 있을 거라구~ ♥"

# game/script.rpy:962
translate kor ch2_1b9c5f18:

    # w happy "Ooh, that sounds cozy~ Congratulations!"
    w happy "어머, 정말 아늑하겠는걸~ 축하해!"

# game/script.rpy:963
translate kor ch2_937fc8b0:

    # c aww "Ehe, thank you~ <3 I've looked forward to it for so long..."
    c aww "에헤헤, 고마워~ ♥ 나 정말 오랫동안 기대하고 있었잖아?"

# game/script.rpy:964
translate kor ch2_aae442de:

    # w smile "It sounds like you're about to enter a lovely domestic life. You deserve it!"
    w smile "사랑스러운 가정 생활에 접어들게 되겠네. 축하해!"

# game/script.rpy:965
translate kor ch2_f5692979:

    # c "Aww, hehehe... I'm really happy."
    c "에이, 히히히... 정말 기뻐."

# game/script.rpy:966
translate kor ch2_d2fabfa3:

    # c oh "But, um... speaking of my partners. You've still never even met them..."
    c oh "그러고 보니, 어... 내 파트너 얘기가 나와서 말인데, 아직 한 번도 안 만나봤었지...?"

# game/script.rpy:967
translate kor ch2_f5612c00:

    # w calm "True. But I can imagine they're wonderful, just from how you've talked about them."
    w calm "그렇지. 하지만 네가 했던 이야기들을 들어보면, 전부 정말 멋진 사람들임에는 의심할 여지 없어."

# game/script.rpy:968
translate kor ch2_f82c96ac:

    # c aww "Right~ but, um... what if you didn't have to imagine?"
    c aww "그렇지~ 하지만, 음... 직접 경험해보는 거는 어떻게 생각해?"

# game/script.rpy:969
translate kor ch2_add80a4e:

    # c smile "That's what I've been wanting to talk to you about. I was hoping... we might all be able to go on a group date sometime!"
    c smile "전부터 꺼내고 싶었던 말이었어. 혹시... 우리 다같이 그룹 데이트를 나가보는 건 어떨까 싶어서!"

# game/script.rpy:970
translate kor ch2_c81c387b:

    # w oh "Oh~?"
    w oh "오호~?"

# game/script.rpy:971
translate kor ch2_8b6f2fb7:

    # c aw "Yeah~! Because, like... I just think you're so wonderful, Periwinkle. I want them to know you, too!"
    c aw "그니까, 그러니까, 왜냐면... 나는 너도 정말 멋지다고 생각하거든, 페리윙클. 내 파트너들도 그걸 알아줬으면 좋겠어!"

# game/script.rpy:972
translate kor ch2_40b31e80:

    # w sorry "Mm... although it sounds like fun, I'm a bit..."
    w sorry "음... 재미있을 것 같긴 하지만, 나는 조금..."

# game/script.rpy:973
translate kor ch2_7122e72f:

    # c please "W-wait, before you say no...!"
    c please "자.... 잠깐, 거절하기 전에...!"

# game/script.rpy:974
translate kor ch2_b6456ff5:

    # c "They're both very easygoing, and so loving, and nice...! I can promise it won't be overwhelming..."
    c "둘 다 되게 유순하고 사랑스럽고 착한 사람이야...! 전혀 부담스럽지 않을 거라고 장담할 수 있어..."

# game/script.rpy:975
translate kor ch2_62b54e38:

    # w decline "That unfortunately isn't where the issue lies, my dear..."
    w decline "유감스럽지만 내 걱정은 그게 아니야, 자기..."

# game/script.rpy:976
translate kor ch2_bb65f581:

    # c sad "I-I know you said you didn't want to get involved before... but I just know that we would all get along so well!"
    c sad "나... 나도 네가 관여하고 싶지 않다고 한 거 알아... 하지만 우리 모두 함께 정말 잘 어울릴 거라고 확신하는걸!"

# game/script.rpy:977
translate kor ch2_9db7f2b9:

    # c "I'd like to reassure you however I can. But I understand if you still turn me down..."
    c "내가 할 수 있는 만큼 널 안심시키고 싶어. 그래도 거절한다면 이해할게..."

# game/script.rpy:979
translate kor ch2_99af5b21:

    # "Matters of love are so tricky, aren't they?"
    "사랑의 문제라는 건 참 어려워, 안 그래?"

# game/script.rpy:980
translate kor ch2_b7229a67:

    # "I still recall the first time something like this was asked of me..."
    "이런 일과 비슷한 일이 처음 나에게 닥쳤을 때가 아직도 기억나네..."

# game/script.rpy:981
translate kor ch2_70f4d8cb:

    # "I had been nervous going in, but I had also never entered a group situation before. I attributed my anxiety solely to that."
    "참여하는 게 떨렸지만, 그런 여러 명이 모인 곳에 들어가는 것도 처음이었지. 오로지 그것 하나 때문에 불안했었어."

# game/script.rpy:982
translate kor ch2_5aaf6eab:

    # "However, it quickly became clear that I just wasn't suited to it at all..."
    "하지만, 그냥 내가 그런 관계에 맞지 않았다는 걸 깨닫는 데까지는 그리 긴 시간이 걸리지 않았지..."

# game/script.rpy:983
translate kor ch2_92e49d6c:

    # nvl clear
    # "I do love to spoil each of my partners--but strictly one at a time."
    nvl clear
    "내 파트너들을 즐겁게 하는 건 나도 좋지만... 그건 무조건 한 번에 한 명씩이 될 거야."

# game/script.rpy:985
translate kor ch2_13099713:

    # "Perhaps I was left scarred by the breakdown in communication, the passionate fires of a long-established romance..."
    "어쩌면 나는 소통의 오류나 길게 유지된 로맨스에 끼어드는 것에 상처를 받았던 걸지도 모르지."

# game/script.rpy:986
translate kor ch2_000f6a86:

    # "Surely Cassia and her partners are magnificent people. It may indeed be fun for a night."
    "카시아와 카시아의 파트너들은 멋진 사람인 것이 분명해. 하룻밤 정도는 나쁘지 않겠지."

# game/script.rpy:987
translate kor ch2_e1d8cf3a:

    # "But becoming entangled in committed relationships is something I've always avoided from the beginning, isn't it?"
    "하지만 헌신적인 관계에 꼬이는 것은 내가 처음부터 항상 피해왔던 것이지 않았나?"

# game/script.rpy:988
translate kor ch2_b61e07ce:

    # nvl clear
    # w neutral "This is all very sweet of you. But I do have to decline."
    nvl clear
    w neutral "정말 친절하구나. 하지만 역시 거절해야겠어."

# game/script.rpy:991
translate kor ch2_d6eb3267:

    # c letdown "Aww... I can't help but feel a little broken-hearted."
    c letdown "아... 조금 가슴이 아픈 건 어쩔 수 없네."

# game/script.rpy:992
translate kor ch2_02d40560:

    # w decline "I apologize... Truly, it's nothing personal."
    w decline "내 사과를 받아줘... 정말 개인적인 이유는 아니야."

# game/script.rpy:993
translate kor ch2_cea46204:

    # c aww "Oh, I know~ I don't take offense or anything..."
    c aww "아, 그건 나도 알아~ 나도 화가 나거나 그런 건 아니야..."

# game/script.rpy:994
translate kor ch2_13fca6f4:

    # c letdown "It's just sad. Now that I'm going to be living with them... and, knowing you don't want to meet them..."
    c letdown "그냥 슬퍼서 그래. 그 사람들과 함께 살게 되고... 그리고, 네가 그 사람들을 만나고 싶지 않아한다는 게..."

# game/script.rpy:995
translate kor ch2_82188b3a:

    # c sad "I think it's best we just break things off...."
    c sad "그냥 내가 포기하는 게 최선이라고 생각해..."

# game/script.rpy:996
translate kor ch2_9b7a5305:

    # w neutral "Yes, I agree. As you said, it's for the best."
    w neutral "맞아, 나도 동의해. 네 말대로, 이게 최선의 선택이야."

# game/script.rpy:997
translate kor ch2_22bfa56a:

    # c aww "I hope we can still be friends, though~"
    c aww "그래도 같이 친구로 남아줬으면 좋겠어~"

# game/script.rpy:998
translate kor ch2_a119e9ad:

    # w smile "Of course~ <3 I'm sure our paths will cross every now and again."
    w smile "물론이지~ ♥ 우리의 길은 언젠가는 다시 만나게 될 거야."

# game/script.rpy:999
translate kor ch2_96818197:

    # c happy "Yeah~! Thank you for always treating me so well, Periwinkle."
    c happy "응~! 항상 나 잘 챙겨줘서 고마워, 페리윙클."

# game/script.rpy:1000
translate kor ch2_f9c0bf81:

    # w calm "Hmhm, it was my pleasure <3"
    w calm "후후, 내가 좋아서 하는 건데 뭘 ♥"

# game/script.rpy:1003
translate kor ch2_482c7dd0:

    # "Even casual relationships can end in breakups like this."
    "간단한 관계도 이렇게 깨질 수 있지."

# game/script.rpy:1004
translate kor ch2_7fabf76c:

    # "This is largely why I tend to prefer one-night affairs. Things can just become so messy as needs evolve..."
    "그렇기 때문에 나는 하룻밤 사이의 관계를 조금 더 선호하는 거야. 욕구가 늘어나면 관계가 지저분해질 수도 있지..."

# game/script.rpy:1005
translate kor ch2_e8be9790:

    # "As Cassia and I go our separate ways, I can't help feeling a little blue."
    "카시아와 내가 다른 길로 향했을 때, 나도 조금 울적한 걸 참을 수 없었어."

# game/script.rpy:1006
translate kor ch2_7b0bc9f1:

    # "Perhaps I'll return home for the day after all."
    "그냥 나 역시 집으로 돌아가야겠어."

# game/script.rpy:1007
translate kor ch2_76b2fe88_2:

    # nvl clear
    nvl clear

# game/script.rpy:1018
translate kor ch2_80d3118f:

    # n "Periwinkle quickly changes into something more comfortable, dropping his bag unceremoniously onto the couch."
    n "페리윙클은 편한 옷으로 갈아입은 뒤, 자신의 가방을 무신경하게 소파에 떨굽니다."

# game/script.rpy:1019
translate kor ch2_a9ff1a56:

    # w pj neutral "(I could use an afternoon nap...)"
    w pj neutral "(늦은 낮잠이나 자볼까...)"

# game/script.rpy:1020
translate kor ch2_10be0962:

    # w calm "(Yes, that's precisely what I need. I'll wake up feeling refreshed, and ready to go back out on the town~)"
    w calm "(그래, 지금 내가 필요한 건 낮잠이야. 정신 차리고 일어나서, 바깥에 나갈 준비를 해야겠어~)"

# game/script.rpy:1022
translate kor ch2_47c6e3ec:

    # n "He shoves some blankets aside and collapses onto the couch--and when he does, the contents of his bag spills onto the floor."
    n "페리윙클은 이불을 치운 뒤 소파에 드러눕습니다. 페리윙클이 드러눕자, 가방 안에 있던 내용물이 바닥으로 흘러 떨어집니다."

# game/script.rpy:1023
translate kor ch2_093623ac:

    # w oh "Ah..."
    w oh "아..."

# game/script.rpy:1024
translate kor ch2_189b671a:

    # n "Lazily leaning over to gather it up, he notices the candies from before..."
    n "게으르게 몸을 굽혀 떨어진 물건을 줍는 도중, 페리윙클은 이전에 받은 사탕을 발견합니다."

# game/script.rpy:1025
translate kor ch2_cba66395:

    # w neutral "...."
    w neutral "...."

# game/script.rpy:1030
translate kor ch2_ed23994c:

    # "Was I too hasty in saying I'd hoped to see Pastille again?"
    "다시 파스틸을 보고 싶다고 한 게 너무 일렀나?"

# game/script.rpy:1031
translate kor ch2_cad66722:

    # "I suppose I'd forgotten the feeling of not being enough for someone."
    "어쩌면 누군가에게 충분하지 않다는 느낌을 받은 지 너무 오래 됐는지도 모르겠어."

# game/script.rpy:1032
translate kor ch2_fc6603e2:

    # "Usually these things tend to dissipate naturally, without confrontation or notice."
    "대체로 이런 기분은 자연스럽게 사라지곤 하지. 아무런 예고나 징조도 없이."

# game/script.rpy:1033
translate kor ch2_e7803a00:

    # "So when they don't... it stings."
    "그래서 이런 기분이 사라지지 않을 때 더 아픈 거야."

# game/script.rpy:1034
translate kor ch2_fc4b9a1c:

    # nvl clear
    # n "Periwinkle scoops up the candies, dropping all but one of them back into his bag."
    nvl clear
    n "페리윙클은 사탕들을 집어들어 한 개를 제외하고 전부 가방 안으로 쏟아넣습니다."

# game/script.rpy:1037
translate kor ch2_f16117de:

    # n "He settles into place on the couch, nestled in a tangled mess of blankets and cushions... and unwraps his chosen pastille."
    n "그런 페리윙클은 소파에 자리를 잡고 담요와 쿠션들이 뒤엉킨 곳에 둥지를 튼 뒤... 파스틸 사탕의 포장을 벗깁니다."

# game/script.rpy:1040
translate kor ch2_2fa75bdb:

    # w pj calm "(...It IS sweet, though.)"
    w pj calm "(...확실히 달긴 하네.)"

# game/script.rpy:1041
translate kor ch2_81ec8a05:

    # w shy "(What a shame that would be, if I never got to taste it again!)"
    w shy "(내가 이 맛을 다시 보지 못한다면 정말 유감이겠지!)"

# game/script.rpy:1044
translate kor ch2_b429b989:

    # "That's right. I could never resist the promise of an entertaining night, no matter what may come down the line."
    "맞아. 즐거운 밤을 약속한 건 무슨 일이 있어도 절대로 파투낼 수 없어."

# game/script.rpy:1045
translate kor ch2_13b346ec:

    # "I'm a hopeless hedonist after all <3 Nothing to be done about that!"
    "난 어쩔 수 없는 쾌락주의자인걸 ♥ 내가 그런 걸 어떻게 바꾸겠어!"

# game/script.rpy:1046
translate kor ch2_b6d8bcd7:

    # "Let fate decide, then. If he comes, he comes."
    "그럼 운명에 맡기도록 해야지. 걔가 오면, 오는 거고."

# game/script.rpy:1047
translate kor ch2_191d1d9c:

    # "And if we never meet again... I can always hold on to the memory of our perfect date <3"
    "그리고 만약 다시는 못 만난다고 해도... 언제든 우리의 완벽한 데이트를 돌아볼 수 있겠지 ♥"

# game/script.rpy:1048
translate kor ch2_76b2fe88_3:

    # nvl clear
    nvl clear

# game/script.rpy:1053
translate kor ch2_1a34cacc:

    # n "Several hours later..."
    n "몇 시간 후..."

# game/script.rpy:1054
translate kor ch2_3688e7d8:

    # n "...there's a knock at the door."
    n "...문을 두드리는 소리가 들립니다."

# game/script.rpy:1060
translate kor ch2_f9db6787:

    # n "And right there on his doorstep, Periwinkle is pleasantly surprised to find..."
    n "그리고 기분 좋게 놀란 페리윙클의 문 앞에 기다리고 있던 사람은..."

# game/script.rpy:1062
translate kor ch2_40e54497:

    # w pj my "Pastille! I wasn't expecting to see you again so soon~"
    w pj my "파스틸! 널 이렇게 금방 다시 만나게 될 줄이야~"

# game/script.rpy:1063
translate kor ch2_b15c4708:

    # w drool "(And treating me to another cute new look, no less! <3)"
    w drool "(그리고 이렇게 예쁜 옷까지 입고 오다니, 어머! ♥)"

# game/script.rpy:1064
translate kor ch2_99245a8a:

    # p "Sorry, I, um... I couldn't stop thinking about..."
    p "죄송해요, 저, 음... 그, 생각하는 걸 멈출 수가 없어서..."

# game/script.rpy:1065
translate kor ch2_42189d4b:

    # p ehe2 "I-I mean--I realized, last night I never actually... got to sample your magic? The scents you mentioned..."
    p ehe2 "제... 제 말은... 어제 저녁에 제가... 페리윙클의 마법을 본 적이 없는 거 같아서요? 페리윙클이 말해줬던 향 말이에요..."

# game/script.rpy:1066
translate kor ch2_e2870f5e:

    # w oh "Oh, that's right..."
    w oh "아, 그렇구나..."

# game/script.rpy:1067
translate kor ch2_974aa600:

    # w love "We were quite preoccupied, hm? <3"
    w love "그때는 우리가 좀 바빴었지, 안 그래? ♥"

# game/script.rpy:1068
translate kor ch2_bddfdf51:

    # p seriously "Y-yes... so, th-that's why I'm here!"
    p seriously "그... 그렇죠... 그러니까 제가 여기 온 거 아니겠어요!"

# game/script.rpy:1069
translate kor ch2_688d44a5:

    # n "He finally manages to make eye contact, but quickly averts his gaze once more."
    n "파스틸은 마침내 페리윙클과 눈을 마주치지만, 금세 다시 눈을 굴려 피합니다."

# game/script.rpy:1070
translate kor ch2_6ad797b9:

    # p shy "Ah--um, were you in bed? Sorry, I shouldn't have come so late...."
    p shy "아... 음, 침대에 누워있었나요? 죄송해요, 제가 너무 늦게 왔죠...?"

# game/script.rpy:1071
translate kor ch2_e453f11a:

    # w calm "Hmhm, these aren't even my sexiest pajamas..."
    w calm "후후, 이것보다 섹시한 파자마도 더 있다구..."

# game/script.rpy:1072
translate kor ch2_c0c9e69d:

    # p omg "I didn't say anything about that...!" with vpunch
    p omg "그런 거는 안 얘기했거든요...!" with vpunch

# game/script.rpy:1073
translate kor ch2_ac06f781:

    # w innocent "But to answer your question, no, I wasn't."
    w innocent "네 질문에 대답하자면, 아니, 침대에 누워있던 건 아니야."

# game/script.rpy:1074
translate kor ch2_1837215c:

    # w smile "Although I did take a nap earlier this afternoon, I've otherwise been enjoying a relaxing night in."
    w smile "오늘 오후에 낮잠을 자긴 했지만, 그것만 제외하면 집에서 편안한 밤을 즐기고 있었어."

# game/script.rpy:1075
translate kor ch2_7eec0fd7:

    # w drool "(And I'm so very glad I didn't end up going out! I would've missed out on this flustered mess <3)"
    w drool "(오늘 밖에 안 나가서 정말 다행이야! 그랬더라면 이 부끄럼쟁이를 스쳐지나갈 뻔했잖아 ♥)"

# game/script.rpy:1076
translate kor ch2_dfa9333a:

    # p ehe2 "Ah... haha...."
    p ehe2 "아... 하하...."

# game/script.rpy:1077
translate kor ch2_47eb90b7:

    # w innocent "...Would you like to come in?"
    w innocent "...안에 들어올래?"

# game/script.rpy:1079
translate kor ch2_18ec9e87:

    # n "Pastille nods vigorously in response."
    n "파스틸은 세차게 고개를 끄덕입니다."

# game/script.rpy:1085
translate kor ch2_ee963e3c:

    # w pj calm "It's still a bit of a mess in here... I hope you don't mind~"
    w pj calm "아직 조금 청소가 덜 됐는데... 괜찮지?"

# game/script.rpy:1086
translate kor ch2_cd5e4835:

    # p oh "There's a path through. I've seen worse."
    p oh "최소한에 지나갈 수 있는 길은 있잖아요. 이것보다 더 심한 집도 봤어요."

# game/script.rpy:1087
translate kor ch2_6f4d78ac:

    # w happy "Oh~ maybe I'll let it spiral further into chaos, then! I'm just so competitive, you know? <3"
    w happy "오~ 그럼 나중에 더 어지럽혀 볼까? 난 경쟁심이 세다구, 알아? ♥"

# game/script.rpy:1088
translate kor ch2_63398835:

    # p ehe "I'm not sure that's a competition you'd really want to win..."
    p ehe "딱히 이기고 싶은 경쟁이라고는 생각이 들지 않는데요..."

# game/script.rpy:1089
translate kor ch2_8189bccf:

    # w calm "Hmhm, perhaps not."
    w calm "후후, 그럴지도 모르지."

# game/script.rpy:1091
translate kor ch2_165173b4:

    # n "Periwinkle carefully steps over some of his clutter to dig through one of the boxes in the far corner of the room."
    n "페리윙클은 조심스레 잡동사니를 넘어 방 구석에 있는 상자 하나를 파냅니다."

# game/script.rpy:1093
translate kor ch2_843f2cc2:

    # w pj smile "Ah, here they are! My personal favorites..."
    w pj smile "아, 여기 있네! 내가 개인적으로 좋아하는 것들이야..."

# game/script.rpy:1096
translate kor ch2_2a6d3b75:

    # w calm "This row here contains some of the more potent scents... most of them for relaxation, things to calm the nerves."
    w calm "이 줄에 있는 건 더 강한 향들이 들어있어... 대부분 휴식에 쓰지. 마음을 안정시켜주거든."

# game/script.rpy:1097
translate kor ch2_861a81ad:

    # w smile "The rest, I just happen to like. Sweet scents, like strawberry, banana, bubblegum, mango..."
    w smile "나머지는 그냥 내가 좋아하는 것들이야. 딸기나 바나나, 풍선껌, 망고 같은 단 향들이지..."

# game/script.rpy:1098
translate kor ch2_25b75e0f:

    # p "I-is there a reason you're only naming candy flavors...?"
    p "드... 들어보니 전부 사탕 맛 같은데, 이유라도 있나요...?"

# game/script.rpy:1099
translate kor ch2_0d95e3c3:

    # w innocent "Hm~ must be a coincidence <3"
    w innocent "음~ 그냥 우연이겠지. ♥"

# game/script.rpy:1101
translate kor ch2_432e8e66:

    # n "Pastille picks out an unlabeled bottle, filled with a pale pink liquid..."
    n "파스틸은 희무룩한 분홍색의 액체가 담긴 이름이 적히지 않은 병을 꺼냅니다."

# game/script.rpy:1104
translate kor ch2_b279bf05:

    # p "What's this?"
    p "이건 뭔가요?"

# game/script.rpy:1105
translate kor ch2_51cf5f4c:

    # w teehee "Ahh, watch out~ that one's an aphrodisiac <3"
    w teehee "아, 조심해~ 그건 사랑의 묘약이라구. ♥"

# game/script.rpy:1106
translate kor ch2_93475faa:

    # p calm "Hm. We'll see about that."
    p calm "음. 그건 두고 봐야죠."

# game/script.rpy:1108
translate kor ch2_e9e24a9f:

    # n "Pastille locks eyes with Periwinkle as he opens the vial without hesitation."
    n "파스틸은 페리윙클과 눈을 마주친 채로 주저없이 병을 엽니다."

# game/script.rpy:1109
translate kor ch2_2fb76492:

    # w drool "(How bold...!)"
    w drool "(대담한데...!)"

# game/script.rpy:1111
translate kor ch2_0042c176:

    # p ehe "...Oh, it's peach. Hah, I almost expected it to be overpowering..."
    p ehe "...아, 그냥 복숭아 향이네요. 하하, 되게 셀 줄 알았는데..."

# game/script.rpy:1112
translate kor ch2_3da16e70:

    # w calm "Yes, well, the aphrodisiac bit was a lie. But I'm glad you like it."
    w calm "뭐, 그렇지. 사랑의 묘약이라는 말은 거짓말이었지만, 네가 좋아해서 다행이야."

# game/script.rpy:1113
translate kor ch2_84afb1db:

    # p smile "You're really good at this type of magic--I've never done anything like it..."
    p smile "이런 마법을 되게 잘 쓰시네요... 전 이런 건 한 번도 해본 적 없어요..."

# game/script.rpy:1114
translate kor ch2_eac4cdca:

    # w smile "Would you like to try it on?"
    w smile "한번 뿌려볼래?"

# game/script.rpy:1115
translate kor ch2_fa96959b:

    # p oh "Hm...?"
    p oh "네...?"

# game/script.rpy:1116
translate kor ch2_83bb61ec:

    # p shy "Oh, n-no, I don't do perfume or cologne or anything like that..."
    p shy "아, 아뇨. 저는 향수나 콜로뉴 같은 건 안 해서..."

# game/script.rpy:1117
translate kor ch2_7df5f505:

    # w oh "You've never tried it? Ohh, so would you say..."
    w oh "한 번도 써본 적 없는 거야? 오오, 파스틸 너는..."

# game/script.rpy:1118
translate kor ch2_cc464b9d:

    # w shy "You're a perfume virgin, then? <3"
    w shy "향수 동정이네, 그럼? ♥"

# game/script.rpy:1119
translate kor ch2_3db42423:

    # p seriously "I-I'M NOT...! Who even says things like that?!" with vpunch
    p seriously "그... 그런 거 아니거든요...! 그런 말은 또 누가 한다고 그래요!?" with vpunch

# game/script.rpy:1120
translate kor ch2_2cfe21e1:

    # w happy "In my line of work, you'd be surprised~"
    w happy "우리 쪽에서 일하는 사람들 말하는 거 보면 깜짝 놀랄걸~"

# game/script.rpy:1121
translate kor ch2_ba67bd24:

    # p shy "It's probably just you...."
    p shy "그냥 페리윙클 뿐이겠죠...."

# game/script.rpy:1122
translate kor ch2_27256bce:

    # w innocent "Hmhm, maybe so."
    w innocent "후후, 그럴지도 모르지."

# game/script.rpy:1123
translate kor ch2_adc8879b:

    # w calm "If you're not going to try it, I'll have it back now, please~"
    w calm "그거 쓸 거 아니면, 다시 돌려받을게~"

# game/script.rpy:1124
translate kor ch2_0d918745:

    # p anxious "I could.. try...."
    p anxious "한번... 써보죠...."

# game/script.rpy:1125
translate kor ch2_66c51016:

    # p ehe2 "I just don't know how I'm supposed to apply it."
    p ehe2 "어떻게 써야 될지 잘 모르겠는 것 뿐이에요."

# game/script.rpy:1126
translate kor ch2_a2e4ac6c:

    # w smile "May I?"
    w smile "내가 도와줄게."

# game/script.rpy:1129
translate kor ch2_b631c2d3:

    # n "Pastille nods, handing over the small vial."
    n "파스틸은 고개를 끄덕이며 작은 병을 페리윙클에게 넘깁니다."

# game/script.rpy:1130
translate kor ch2_6b5afd7c:

    # n "Periwinkle seals the opening with his fingertip and swiftly tilts the bottle over and back."
    n "페리윙클은 병의 입구를 손가락으로 막은 뒤 빠르게 병을 한 번 뒤집고 다시 세웁니다."

# game/script.rpy:1133
translate kor ch2_9dd67e5b:

    # w "Here..."
    w "자..."

# game/script.rpy:1134
translate kor ch2_f2f42b7a:

    # n "He lightly rubs a spot on Pastille's neck, engulfing them both in the pleasant scent of his magic."
    n "페리윙클은 파스틸의 목을 가볍게 문지르고, 향기로운 마법의 향은 둘을 감쌉니다."

# game/script.rpy:1136
translate kor ch2_56fbbf51:

    # n "Their eyes meet, neither of them daring to be the first to move."
    n "파스틸과 페리윙클의 눈이 맞지만, 둘 다 먼저 움직일 용기는 없는 듯 합니다."

# game/script.rpy:1137
translate kor ch2_054c8a20:

    # w "Hmm... maybe the aphrodisiac bit wasn't a lie after all?"
    w "흐음... 내가 말한 사랑의 묘약이 완전 거짓말은 아니었나 보네?"

# game/script.rpy:1139
translate kor ch2_f010b7c9:

    # n "Pastille breaks the spell, rushing forward with a sudden kiss."
    n "파스틸이 먼저 앞으로 달려들며 갑작스러운 키스를 합니다."

# game/script.rpy:1141
translate kor ch2_90f6a8aa:

    # n "...And then retreats just as quickly."
    n "...그리고선 빠르게 다시 제자리로 돌아옵니다."

# game/script.rpy:1144
translate kor ch2_e247d436:

    # p "Ah--um, sorry, I just--"
    p "아... 음, 죄송해요, 그냥..."

# game/script.rpy:1145
translate kor ch2_99717d55:

    # w pj yay "(He certainly is impulsive... not that I mind at all <3)"
    w pj yay "(정말 충동적이라니까... 내가 생각했던 것과는 전혀 다른데. ♥)"

# game/script.rpy:1146
translate kor ch2_655f5b82:

    # w drool "(I'm more than happy to go along with your little game, Pastille...)"
    w drool "(파스틸, 네 귀여운 놀이에 놀아나는 건 더할 나위 없이 즐겁단 말이지...)"

# game/script.rpy:1147
translate kor ch2_50096bca:

    # w shy "Ohh nooo~ my own magic is working too well~!"
    w shy "안 돼애~ 내 마법이 이렇게까지 잘 들 줄이야~!"

# game/script.rpy:1148
translate kor ch2_0bd2374d:

    # w teehee "I guess there's no choice but to have my way with you, my sweet <3"
    w teehee "어쩌면 나는 처음부터 너를 꼬실 운명이었나 보다, 자기 ♥"

# game/script.rpy:1149
translate kor ch2_60a65ab5:

    # p dying "...O-oh nooo~"
    p dying "...아... 안 돼~"

# game/script.rpy:1153
translate kor ch2_de805c4f:

    # n "Pastille's halfhearted protests end there."
    n "파스틸의 미약한 저항이 멈춥니다."

# game/script.rpy:1154
translate kor ch2_016f8419:

    # n "Periwinkle's hands were already upon him, and would continue to be for the rest of the night..."
    n "페리윙클은 이미 파스틸의 몸에 손을 대고 있었고, 그 손은 밤새도록 파스틸을 붙잡고 있었습니다."

# game/script.rpy:1166
translate kor ch3_7b49a2da:

    # centered "{w=3}{nw}"
    centered "{w=3}{nw}"

# game/script.rpy:1173
translate kor ch3_7ed57a35:

    # "Over the next month or so, we fell into quite an enjoyable pattern."
    "그러고선 한두달 정도 우리는 꽤 즐거운 관계를 형성하게 됐어."

# game/script.rpy:1174
translate kor ch3_4fb4a5d6:

    # "Pastille would show up at my doorstep maybe once or twice a week..."
    "파스틸은 한 주에 한두 번씩 내 집 앞에 찾아오곤 했고..."

# game/script.rpy:1175
translate kor ch3_89332bf5:

    # "Sometimes we'd go out to dinner, but mostly he'd just spend the night <3"
    "가끔은 저녁을 먹으러 나가곤 했지만, 대부분 같이 밤을 지새우기 위해서였어 ♥"

# game/script.rpy:1176
translate kor ch3_ea2c2997:

    # nvl clear
    # "It was starting to become almost routine--though each visit was somehow just as exciting as the last~"
    nvl clear
    "우리의 관계는 거의 일상이 되었는데... 파스틸이 방문할 때면 언제나 새롭고 신나는 기분이었지~"

# game/script.rpy:1178
translate kor ch3_e1acc37c:

    # "The details of which... I'll choose to keep private, for Pastille's sake. That boy is insatiable, I WILL say that! <3"
    "자세한 내용은... 파스틸을 위해서 비밀로 할래. 하지만 정말, 지칠 줄 모르는 남자였다니까!"

# game/script.rpy:1179
translate kor ch3_2ae57261:

    # nvl clear
    # "Inevitably, after seeing someone for long enough, one begins to pick up on their habits..."
    nvl clear
    "그렇게 자주 만나는 사이라면, 상대의 버릇을 배우는 건 피할 수 없는 일이지..."

# game/script.rpy:1181
translate kor ch3_308c6522:

    # "Cute habits. Like the way he kisses me on the cheek before rushing off to work in the early morning."
    "귀여운 버릇들. 파스틸이 아침에 일하러 도망가기 전에 내 볼에 키스를 하는 거라든지..."

# game/script.rpy:1182
translate kor ch3_f8c37e9b:

    # "The way he runs his hand through his hair when he's thinking really hard about something."
    "뭔가를 골똘히 생각하고 있을 때 머리를 손으로 넘기는 버릇이라든지."

# game/script.rpy:1183
translate kor ch3_7f9de784:

    # nvl clear
    # "Even his knock is specific--once, lightly, to test the waters. A pause, as he gathers his courage. Then three, firm and evenly-spaced."
    nvl clear
    "파스틸은 문을 두드리는 방법도 독특해. 한 번 물에 발 담가보듯 약하게 두드린 다음 멈췄다가, 용기를 모아 확실하고 일정하게 세 번 문을 두드리지."

# game/script.rpy:1185
translate kor ch3_13949e8f:

    # "I'm not sure which of these habits he's conscious of, but there's one I've decided he MUST be acting knowingly..."
    "이런 버릇들을 본인이 알고 있는지는 모르겠지만, 한 가지 파스틸이 일부러 하는 버릇이 있다면..."

# game/script.rpy:1186
translate kor ch3_05e82852:

    # "Which is, his habit of leaving one of his personal effects behind with each visit."
    "내 집에 방문할 때마다 자기 물건을 하나씩 두고가는 거야."

# game/script.rpy:1187
translate kor ch3_a1186f11:

    # nvl clear
    # "First, a barrette. Then an earring. His choker, a bracelet..."
    nvl clear
    "처음에는 머리핀이었지. 그리고는 귀걸이였고, 다음은 초커, 그리고는 팔찌..."

# game/script.rpy:1189
translate kor ch3_72eea756:

    # "And then he returns after a few days with an apology, explaining he had just come to pick up whatever he'd left behind."
    "그런 물건을 남겨두고는 며칠 뒤에 사과하면서 놓고 간 물건을 찾아가곤 하지."

# game/script.rpy:1190
translate kor ch3_13faa860:

    # nvl clear
    # w pj calm "Sure, Pastille. Keep creating your little excuses to come back here... I'll happily go along with them."
    nvl clear
    w pj calm "그래, 파스틸. 계속 그렇게 우리 집에 올 핑계를 만들도록 해... 어울려주는 거라면 언제든 기쁘게 할 수 있으니까."

# game/script.rpy:1193
translate kor ch3_80258f58:

    # w happy "Hmhm, what fun! I wonder what he'll come looking for THIS time~?"
    w happy "후후, 정말 재밌어! 이번에는 뭘 찾으러 올까~?"

# game/script.rpy:1195
translate kor ch3_5245ed5c:

    # n "Periwinkle gathers up the discarded garments that had been left strewn across his bedroom, tossing them into a pile to be dealt with later."
    n "페리윙클은 자신의 침실에 널부러져 있던 옷들을 모아 나중에 처리할 생각으로 침대에 던져놓습니다."

# game/script.rpy:1197
translate kor ch3_57dc11fb:

    # w oh "He couldn't possibly leave his underwear behind, could he...?"
    w oh "혹시 속옷을 두고 간 건 아니겠지...?"

# game/script.rpy:1198
translate kor ch3_2577a914:

    # w calm "No, that would be impossible to explain. An earring, sure, but there's no way he'd walk out of here like THAT..."
    w calm "아니야, 그런 거라면 설명을 어떻게 해. 귀걸이야 그럴 수 있다고 쳐도, 그런 꼴로 여기를 나가는 건 상상도 안 되는걸..."

# game/script.rpy:1200
translate kor ch3_b4f5ffdc:

    # n "Periwinkle hums to himself as he makes the bed, double-checking between the sheets while he's at it..."
    n "페리윙클은 콧노래를 부르며 이불을 개고, 다시 침대를 샅샅이 확인합니다."

# game/script.rpy:1202
translate kor ch3_a6272f66:

    # w pout "...Hm. I'm almost disappointed."
    w pout "...흠, 조금 실망인데."

# game/script.rpy:1203
translate kor ch3_8b7cde78:

    # w oh "It's been so consistent, up until now. I suppose he could just be THAT forgetful..."
    w oh "지금까지는 되게 일정했는데 말이지. 어쩌면 그 정도로 기억력이 안 좋은 걸지도 모르겠다."

# game/script.rpy:1206
translate kor ch3_fcb994ab:

    # "Unable to find anything of Pastille's in my bedroom, I decide to spend the rest of the morning cleaning up the place."
    "내 방에서 파스틸의 물건을 찾지 못한 나는 오늘 하루를 청소하는 데에 쓰기로 결심했어."

# game/script.rpy:1207
translate kor ch3_c3a58deb:

    # "Now, mind you, I never let my house get DIRTY... only messy."
    "나는 내 집을 더럽게 쓰지 않아. 어질러 놓을 뿐이지."

# game/script.rpy:1208
translate kor ch3_03008cfa:

    # "Leaving garbage or food waste about is out of the question."
    "쓰레기나 음식물 쓰레기가 널부러져 있는 건 우리 집에선 상상할 수도 없어."

# game/script.rpy:1209
translate kor ch3_a4f20100:

    # "Everything else, though..."
    "하지만 나머지는..."

# game/script.rpy:1210
translate kor ch3_1b81cc77:

    # nvl clear
    # "It's simply that many things don't make it back to their proper place. Or rather, I can never decide on a proper place for many of my things..."
    nvl clear
    "제자리에 돌아가지 못하는 물건이 너무 많아서 문제야. 애초에, 물건이 있어야 할 제자리라는 것 자체가 없다고 해도 과언이 아니지."

# game/script.rpy:1212
translate kor ch3_e63b1b71:

    # "Toss them into boxes, shuffle the boxes around the room, and suddenly they've become unmanageable piles..."
    "상자에 던져넣고, 상자를 방에 돌아다니며 옮기다 보면, 손쓸 수 없는 난리가 되어버리지만..."

# game/script.rpy:1213
translate kor ch3_fc7696d4:

    # "To truly put everything away, these would all have to be emptied and sorted... a daunting task, to be sure!"
    "모든 걸 정리하려면, 그 많은 상자들을 다 비우고 정리해야겠지... 확실히 어려운 일이야!"

# game/script.rpy:1214
translate kor ch3_88c3865d:

    # nvl clear
    # "But it HAS been a while since my last attempt. I may as well put in some effort..."
    nvl clear
    "하지만 마지막으로 시도해봤을 때로부터 좀 되긴 했지. 노력이라도 조금 해볼까..."

# game/script.rpy:1216
translate kor ch3_c56eb4b7:

    # nvl clear
    # w pj oops "But where to begin...?"
    nvl clear
    w pj oops "어디서부터 시작하지...?"

# game/script.rpy:1219
translate kor ch3_c9432365:

    # w oh "I suppose my work supplies have been a little difficult to navigate as of late."
    w oh "생각해보면 내 일에 쓰는 물건들을 찾는 게 조금 힘들었지."

# game/script.rpy:1220
translate kor ch3_6288f7b0:

    # w innocent "That's an achievable goal now, isn't it? And practical, as well!"
    w innocent "지금 수행할 수 있는 목표겠지? 실용적이기도 하고 말이야!"

# game/script.rpy:1222
translate kor ch3_bd454459:

    # n "Periwinkle begins with the box of his favorite perfumes, that had been sitting out since one of Pastille's first visits."
    n "페리윙클은 파스틸의 처음 방문 이후로부터 바깥에 꺼내져있던, 자신이 가장 좋아하는 향수들이 든 상자부터 정리를 시작합니다."

# game/script.rpy:1223
translate kor ch3_de62bb1c:

    # w drool "Ahh, yes... the \"aphrodisiac\"... hmhm, that was a fun night <3"
    w drool "아, 맞아... 그 \"사랑의 묘약\"... 후후, 정말 재미있는 밤이었지 ♥"

# game/script.rpy:1224
translate kor ch3_44f1f072:

    # n "He packs the bottles back into their places, then closes the box, sealing them safely inside."
    n "페리윙클은 병들을 원위치에 두고, 상자를 닫아 안에 안전하게 보관합니다."

# game/script.rpy:1226
translate kor ch3_eaaa499e:

    # w oh "This should go... hm, perhaps it'd be better to set it high on the bookshelf?"
    w oh "이 상자는... 흠, 책꽂이 높은 곳에 올려두는 게 좋으려나?"

# game/script.rpy:1227
translate kor ch3_316ce3eb:

    # w calm "If I just rearrange things a bit, there should be room for everything...."
    w calm "물건을 조금 옮기면, 다 들어갈 공간은 나오겠지...."

# game/script.rpy:1229
translate kor ch3_7430db52:

    # n "As Periwinkle begins setting things aside, a new pile is born, precariously teetering on the back of the couch."
    n "페리윙클이 물건들을 옮기기 시작하자, 다른 물건 더미가 소파 뒤에 쌓입니다."

# game/script.rpy:1230
translate kor ch3_5cf41d37:

    # n "He places the box just where he wants it, and then stacks his various books and knickknacks around it."
    n "페리윙클은 자기가 원하는 곳에 상자를 둔 뒤, 책과 잡다한 것들을 주변에 쌓아둡니다."

# game/script.rpy:1231
translate kor ch3_fcaff70c:

    # n "Just as he's made his way through half of the pile, a small portion of it topples forward, bouncing safely onto the couch cushions."
    n "페리윙클이 물건 더미를 반절 정도 정리하자, 물건이 앞으로 넘어져 안전하게 소파 쿠션 위에 안착합니다."

# game/script.rpy:1232
translate kor ch3_37943611:

    # w smile "Ha! Topple all you want. I was prepared..."
    w smile "하! 넘어지라면 넘어지라지. 난 준비가 돼있었..."

# game/script.rpy:1233
translate kor ch3_6bb6158a:

    # w oh "...Hm?"
    w oh "...음?"

# game/script.rpy:1236
translate kor ch3_04349ffb:

    # n "He finally notices Pastille's jacket, which had expertly blended into the blankets and cushions around it."
    n "페리윙클은 이불과 쿠션들 사이에 숨어있던 파스틸의 외투를 찾아냅니다."

# game/script.rpy:1237
translate kor ch3_b6d5bbbe:

    # w happy "Aha! Just when I'd finally worked up the energy to clean up around here, what do I find?"
    w happy "아하! 열심히 내 집을 청소하니 이런 것도 나오네?"

# game/script.rpy:1238
translate kor ch3_e82a855f:

    # w shy "Yes, this is no mere case of forgetfulness... it was indeed a little game all along!"
    w shy "그래, 이건 단순히 잊어버린 물건에 대한 게 아니야... 틀림없이 처음부터 파스틸이 이끄는 놀이였다고!"

# game/script.rpy:1240
translate kor ch3_1da6cefd:

    # n "Periwinkle giddily laughs to himself, excited to have been proven right."
    n "페리윙클은 자신의 생각이 맞아떨어진 것에 기쁜 듯 혼자 웃습니다."

# game/script.rpy:1243
translate kor ch3_4aed7301:

    # w love "You've escalated it too far, Pastille! To leave your jacket behind is just ridiculous <3"
    w love "너무 멀리 간 거 아니야, 파스틸? 이렇게 외투까지 남겨버리다니, 이건 좀 너무한 거 아니냐구. ♥"

# game/script.rpy:1244
translate kor ch3_ac8d902a:

    # w teehee "He leaves me no choice! I'll just have to return this myself~"
    w teehee "어쩔 수 없네! 이건 내가 직접 돌려주는 수밖에~"

# game/script.rpy:1245
translate kor ch3_6f0e85f3:

    # n "Periwinkle abandons what he was doing, and skips off to his room to get dressed."
    n "페리윙클은 하던 짓을 그만두고, 옷을 입기 위해 방 안으로 뛰어들어갑니다."

# game/script.rpy:1257
translate kor ch3_3eb32547:

    # "I hadn't had a chance to return to Atelier Sweets since first meeting Pastille."
    "난 처음 파스틸을 만났던 날 이후로 아틀리에 과자점에 갈 일이 없었어."

# game/script.rpy:1258
translate kor ch3_88f3e23d:

    # "He was the one always showing up on MY doorstep, after all. There was no need."
    "어차피 파스틸이 항상 내 문 앞까지 와줬는걸. 거기까지 갈 필요가 없었지."

# game/script.rpy:1259
translate kor ch3_928953dd:

    # "It's about time I paid him a visit, yes? I could restock on my favorite candies as well <3"
    "하지만 이제 슬슬 내가 방문을 해야 할 때겠지? 내가 제일 좋아하는 사탕도 잔뜩 쟁여놓을 겸 ♥"

# game/script.rpy:1260
translate kor ch3_76b2fe88:

    # nvl clear
    nvl clear

# game/script.rpy:1263
translate kor ch3_8dc899ac:

    # "Upon reaching Atelier Sweets, though, I hesitate."
    "하지만 아틀리에 과자점에 도착한 나는 머뭇거렸어."

# game/script.rpy:1264
translate kor ch3_803e31e4:

    # "Would it be rude to barge in while he's working? I just know I wouldn't be able to resist teasing him..."
    "일하고 있는 도중에 갑자기 들어가는 건 무례한 행동이려나? 장난치는 걸 참을 수 없을 것 같은데..."

# game/script.rpy:1265
translate kor ch3_e56c2f10:

    # "Hm. As to not become a nuisance, I shall make my presence known from here!"
    "흥. 방해가 되진 않게 노력하겠지만, 여기 사람들도 내 존재를 깨달을 수 있게 하겠어!"

# game/script.rpy:1266
translate kor ch3_d6ac3282:

    # nvl clear
    # n "Periwinkle boldly approaches the bench directly in front of the candy shop, and sits down..."
    nvl clear
    n "페리윙클은 사탕 가게 바로 앞에 있는 벤치에 서슴없이 걸어나가고, 자리에 앉습니다."

# game/script.rpy:1269
translate kor ch3_d2fc93d8:

    # n "...all while wearing Pastille's \"forgotten\" jacket."
    n "...파스틸이 \'까먹고\' 두고 간 자켓을 입은 채로."

# game/script.rpy:1271
translate kor ch3_8cd95367:

    # w jacket calm "(And now, we wait <3)"
    w jacket calm "(자, 이제 기다려볼까? ♥)"

# game/script.rpy:1273
translate kor ch3_62dbec77:

    # "A few minutes pass."
    "몇 분이 흘렀어."

# game/script.rpy:1274
translate kor ch3_5822edc0:

    # "I can see Pastille through the shop window... he's currently preoccupied with a customer."
    "창문을 통해 파스틸이 보여... 지금은 손님이랑 얘기하느라 바쁘네."

# game/script.rpy:1275
translate kor ch3_ae539d34:

    # "Luckily, I brought a lunch <3 A simple peanut butter and jelly sandwich."
    "다행히도, 난 점심을 가져왔지 ♥ 간단한 땅콩 버터 젤리 샌드위치야."

# game/script.rpy:1276
translate kor ch3_51d176a4:

    # "Hmhm, will he notice me before I finish it? The customer is walking out now..."
    "후후, 내가 다 먹기 전에 내가 있는 걸 알아챌까? 손님은 문 밖으로 나가고 있는데..."

# game/script.rpy:1277
translate kor ch3_e963a0d1:

    # nvl clear
    # w jacket shy "(...Ah! Our eyes met <3)"
    nvl clear
    w jacket shy "(...아! 눈 마주쳤다 ♥)"

# game/script.rpy:1281
translate kor ch3_7d91d129:

    # "Pastille turns away, pacing a bit. I take another bite of my sandwich, still watching intently..."
    "나는 고개를 돌려 샌드위치를 한 입 베어물었어. 그러는 와중에도 눈은 진득하게 마주쳤지..."

# game/script.rpy:1282
translate kor ch3_83d21bc8:

    # "He stops for a moment, in front of the door behind the register... until finally making his way out of the store, broom in hand."
    "파스틸은 계산대 뒤에 있는 문 앞에 잠깐 멈추더니, 마침내 한 손에 빗자루를 들고 가게 밖으로 나왔어."

# game/script.rpy:1283
translate kor ch3_5f582295:

    # nvl clear
    # "But instead of coming over right away, he turns his back to me, sweeping the sidewalk in front of the entrance."
    nvl clear
    "하지만 내가 있는 곳으로 곧장 달려오는 대신, 등을 돌리고 가게 앞을 쓸기 시작했지."

# game/script.rpy:1285
translate kor ch3_07c4f7e6:

    # "Perhaps he has a strict supervisor?"
    "상사가 엄격한 걸까?"

# game/script.rpy:1286
translate kor ch3_e8ccb9c2:

    # "Ah, he keeps glancing over his shoulder..."
    "아, 계속 어깨 너머로 날 쳐다보네."

# game/script.rpy:1287
translate kor ch3_3f34efc0:

    # nvl clear
    # w jacket smile "(Just come over here, you silly boy...)"
    nvl clear
    w jacket smile "(그냥 여기로 오지, 바보 같으니라구...)"

# game/script.rpy:1291
translate kor ch3_07af808c:

    # "His face is quite red, so I can say with confidence that I've successfully overwhelmed him once again."
    "얼굴이 새빨갛게 바뀐 걸 확인한 나는 파스틸이 완전히 함락당했다고 선언할 수 있어."

# game/script.rpy:1292
translate kor ch3_3bd910eb:

    # "I've finished my sandwich by the time he approaches. He takes a seat on the opposite end of the bench."
    "파스틸이 나한테 올 쯤 내 샌드위치는 전부 사라져 있었어. 내가 앉은 벤치 반대편에 가서 앉더라고."

# game/script.rpy:1293
translate kor ch3_76b2fe88_1:

    # nvl clear
    nvl clear

# game/script.rpy:1296
translate kor ch3_3c3d8923:

    # w jacket happy "Hmhm, I thought you were ignoring me~"
    w jacket happy "후후, 나 무시하는 줄 알았잖아~"

# game/script.rpy:1297
translate kor ch3_421ea304:

    # p omgstop "N-no, I was just trying to decide what to do."
    p omgstop "아... 아뇨, 그냥 어떻게 해야 할지 고민하던 참이었어요."

# game/script.rpy:1298
translate kor ch3_c04a6356:

    # w calm "Was this a bad time to return your jacket?"
    w calm "자켓 돌려주기에는 별로인 시간인가?"

# game/script.rpy:1299
translate kor ch3_04cd4412:

    # p shy "Not the WORST time...."
    p shy "그렇게까지 별로인 건 아니고요..."

# game/script.rpy:1300
translate kor ch3_4488af6d:

    # w smile "Hm~?"
    w smile "흐응~?"

# game/script.rpy:1304
translate kor ch3_f83add27:

    # n "Periwinkle unzips the jacket and shuffles out of it, casually folding it onto his lap."
    n "페리윙클은 자켓의 지퍼를 열고 벗은 뒤 곱게 접어 무릎 위에 올려둡니다."

# game/script.rpy:1306
translate kor ch3_d9929887:

    # w cute smile "I found it whilst I was cleaning up the place."
    w cute smile "내 방 치우다가 발견한 거야."

# game/script.rpy:1307
translate kor ch3_83944680:

    # w calm "I suppose I could've waited for you to return, but since I was in the area..."
    w calm "네가 올 때까지 기다리는 방법도 있었겠지만, 여기 오는 김에 말이지..."

# game/script.rpy:1308
translate kor ch3_41a02a3a:

    # p ehe2 "R-right... sorry, it's my fault for leaving it behind in the first place."
    p ehe2 "그... 그렇죠... 죄송해요. 남겨두고 가면 안 됐었는데."

# game/script.rpy:1311
translate kor ch3_b8eb6db7:

    # "Pastille can barely look me in the eye."
    "파스틸은 나랑 눈을 마주치지도 못 하고 있어."

# game/script.rpy:1312
translate kor ch3_c5dbde65:

    # "It doesn't stop him from stealing glances at what I'm wearing..."
    "하지만 내가 무슨 옷을 입고 있는지 힐끗힐끗 보는 건 멈추지 않네..."

# game/script.rpy:1313
translate kor ch3_2d3465a6:

    # "But who could resist that? I wore my cutest dress for this."
    "어떻게 안 그러겠어? 가장 귀여운 드레스를 입고 나왔는걸."

# game/script.rpy:1314
translate kor ch3_7a7605c3:

    # nvl clear
    # "Something seems a little off, though..."
    nvl clear
    "하지만 뭔가 이상한 점이 있는데..."

# game/script.rpy:1316
translate kor ch3_3b5bce35:

    # "He's usually a bundle of nerves, yes, but this is a bit much."
    "물론 파스틸이 잘 떤다지만, 이번에는 조금 심하네."

# game/script.rpy:1317
translate kor ch3_949ca487:

    # "I'll get right to the point, then..."
    "그럼 바로 본론으로 들어가볼까..."

# game/script.rpy:1318
translate kor ch3_76b2fe88_2:

    # nvl clear
    nvl clear

# game/script.rpy:1322
translate kor ch3_3a7b6288:

    # w cute happy "Oh, Pastille. You know you don't have to plant excuses just to visit me~"
    w cute happy "오, 파스틸. 내 집에 오려고 이렇게 계속 핑곗거리 만들 필요는 없다구~"

# game/script.rpy:1323
translate kor ch3_3cd8d13c:

    # p "I-I wasn't... planting anything. I just forgot it on my way out."
    p "따... 딱히 뭘 만들고 그런 건 아니고요, 그냥 까먹고 두고 간 것 뿐이에요."

# game/script.rpy:1324
translate kor ch3_528b5cc1:

    # w innocent "I find that hard to believe, considering you've forgotten exactly one thing each time you visit <3 Really, you should be more honest!"
    w innocent "그거 좀 믿기 어려운데, 너 항상 내 집 올 때마다 이렇게 정확히 한 개씩 두고 가잖아 ♥ 조금 더 솔직해지면 안 돼?"

# game/script.rpy:1325
translate kor ch3_c631c321:

    # p "...Sorry. Thank you, for returning it."
    p "...죄송해요. 돌려줘서 고마워요."

# game/script.rpy:1326
translate kor ch3_4428d35a:

    # w teehee "Oh, it's my pleasure <3 It gave ME a good excuse to see your flustered little face again!"
    w teehee "에이, 나야말로지 ♥ 네가 부끄러워하는 모습을 볼 좋은 핑곗거리가 되잖아!"

# game/script.rpy:1329
translate kor ch3_4f12e620:

    # n "Periwinkle sets the jacket on the empty space between them, and rises to take his leave..."
    n "페리윙클은 자켓을 벤치 한가운데에 두고 돌아가기 위해 일어서지만..."

# game/script.rpy:1330
translate kor ch3_c9072ea6:

    # n "But Pastille gently grasps his wrist before he goes."
    n "페리윙클이 떠나기 전 파스틸이 페리윙클의 손목을 잡습니다."

# game/script.rpy:1333
translate kor ch3_4b4c0e76:

    # p ohno2 "Peri. I'm, um... Sorry I made you think I was ignoring you."
    p ohno2 "페리, 저, 그... 페리를 무시하는 것처럼 행동해서 미안해요."

# game/script.rpy:1334
translate kor ch3_746feb0b:

    # w cute guilty "Hmhm, I was only teasing, my sweet..."
    w cute guilty "후후, 그냥 놀리려고 한 말이야, 자기..."

# game/script.rpy:1335
translate kor ch3_364bac5b:

    # p nervous "Still. I can't, um... I'm not ready to be open about who I see outside of work."
    p nervous "그래도요. 저는, 음... 일 외적인 곳에서 누굴 만나는지 아직 주변에 밝히고 싶지 않거든요."

# game/script.rpy:1336
translate kor ch3_b4a86c3f:

    # p flustered2 "I like to keep things VERY discreet--I don't want to have to explain anything to my friends. I'd die of embarrassment."
    p flustered2 "저는 비밀을 지키는 걸 아주 중요하게 생각해요. 제 친구들한테 이런 걸 설명했다가는 부끄러워서 죽어버리고 말 거예요."

# game/script.rpy:1337
translate kor ch3_af748ba9:

    # w neutral "(So that's why...)"
    w neutral "(그런 이유였구나...)"

# game/script.rpy:1338
translate kor ch3_a218c7e9:

    # w calm "Understood <3 I'm actually used to being someone's little secret--"
    w calm "좋아 ♥ 다른 사람의 비밀 친구가 되는 건 익숙하니까~"

# game/script.rpy:1339
translate kor ch3_eda2d17a:

    # w neutral "...Hm, that didn't sound quite right."
    w neutral "...흠, 뭔가 말이 이상한데."

# game/script.rpy:1340
translate kor ch3_0c3f8324:

    # w guilty "What I'm trying to say is, I don't mind at all! From now on, I'll just continue to let you come to me <3"
    w guilty "내 말은, 걱정하지 말라구! 네가 내 집으로 오는 걸 기다리고 있을게 ♥"

# game/script.rpy:1341
translate kor ch3_a683dc07:

    # p nervous "Th-thank you... sorry."
    p nervous "고... 고마워요... 죄송해요."

# game/script.rpy:1342
translate kor ch3_3eba0b21:

    # w smile "I don't know what you keep apologizing for, Pastille. I'll see you around, yes?"
    w smile "왜 계속 사과를 하는 건지 모르겠다, 파스틸. 나중에 보자구, 알겠지?"

# game/script.rpy:1344
translate kor ch3_c525b41f:

    # n "Pastille nods... and finally lets go of his wrist."
    n "파스틸은 고개를 끄덕이고, 마침내 페리윙클의 손목을 놓습니다."

# game/script.rpy:1347
translate kor ch3_60877f15:

    # "A misstep."
    "잘못 움직였어."

# game/script.rpy:1348
translate kor ch3_0850fd13:

    # "A HUGE misstep..."
    "정말 크게 잘못 움직였어..."

# game/script.rpy:1349
translate kor ch3_12ede38d:

    # "I should've guessed it, from the hints he's given--just a few things he's said here and there."
    "파악했어야 했는데, 걔가 남겨놓은 단서들... 이때저때 말했던 것들..."

# game/script.rpy:1350
translate kor ch3_7808934e:

    # "It was enough to put it together, wasn't it?"
    "그걸로 충분히 파악할 수 있었는데 말이지."

# game/script.rpy:1351
translate kor ch3_b3bd1b1f:

    # "The most obvious one being that he always comes to me, and not the other way around."
    "가장 눈에 띄는 부분은 항상 그 애가 나한테 오는 거지, 내가 걔한테 간 적은 없었다는 거."

# game/script.rpy:1352
translate kor ch3_938f9378:

    # nvl clear
    # "Our comfortable pattern, that I recklessly interrupted..."
    nvl clear
    "우리 사이의 편안했던 관계를 내가 흐트러트려놓은 거야..."

# game/script.rpy:1354
translate kor ch3_ec8d7b96:

    # "I should've known, from previous encounters with closeted individuals."
    "이런 일에 대해선 자신을 밝히기 싫어했던 사람들과 교류하면서 배웠어야 했는데."

# game/script.rpy:1355
translate kor ch3_de6c6bc1:

    # nvl clear
    # "What's supposed to be a fun, surprise appearance can turn so quickly into a desperate rally to cling to normalcy, carefully constructed lies to conceal the piece of yourself that may not be accepted..."
    nvl clear
    "재밌으라고 한 깜짝 등장은 곧바로 평범함을 갈망하는 절박함으로 바뀌어버릴 수도 있지. 평범함이라는 건 누군가의 한 부분을 숨기게 하기 위한 거짓말일 뿐..."

# game/script.rpy:1357
translate kor ch3_21ce2d92:

    # "...whether it's by the individual themself, or by their loved ones."
    "...그 평범함은 자기 자신이 만든 짐일 수도 있지만, 사랑하는 사람이 쥐어준 짐일 수도 있어."

# game/script.rpy:1358
translate kor ch3_b4dd5416:

    # "Certainly an unenviable position to find oneself in."
    "누구라도 그런 상황에 빠지는 건 피하려고 하겠지."

# game/script.rpy:1359
translate kor ch3_13b8ccf7:

    # nvl clear
    # "Pastille and I had been seeing a lot of each other during this past month. Was this the inevitable breaking point, then?"
    nvl clear
    "파스틸과 나는 지난 달동안 종종 보곤 했어. 그럼 이게 피할 수 없는 우리들의 끝인 걸까?"

# game/script.rpy:1361
translate kor ch3_6c9c44e5:

    # "It can only become more complicated from here..."
    "여기서부터는 우리 관계가 더 복잡해지는 일만 남았겠지..."

# game/script.rpy:1362
translate kor ch3_c8a0c4e8:

    # "Ah, but it was going so perfectly for so long! Perhaps I'm being overdramatic..."
    "아, 하지만 여태까지 정말 완벽한 관계였는데! 어쩌면 내가 지나치게 생각하고 있는 걸지도 몰라..."

# game/script.rpy:1363
translate kor ch3_e10ad652:

    # "I haven't grown tired of him at all... which is precisely the problem."
    "난 파스틸이 질리지 않는걸... 그게 문제지만."

# game/script.rpy:1364
translate kor ch3_454f79c8:

    # nvl clear
    # "Unwilling to return home so soon, I walk in the direction of the apothecary."
    nvl clear
    "집으로 가기 싫은 나는, 약제상이 있는 방향으로 걸어갔어."

# game/script.rpy:1366
translate kor ch3_3454f89c:

    # "Astragalus will be able to knock some sense in me. She always does."
    "아스트라갈루스가 나 정신 차리는 걸 좀 도와주겠지. 항상 그래왔으니까."

# game/script.rpy:1367
translate kor ch3_76b2fe88_3:

    # nvl clear
    nvl clear

# game/script.rpy:1376
translate kor ch3_91bceeeb:

    # w cute whine "Astragalus~~ Are you busy~~~?"
    w cute whine "아스트라갈루스~~ 지금 바빠~~~?"

# game/script.rpy:1378
translate kor ch3_6043f839:

    # a "Ugh, I know that whine. You've shifted into dramatic bitch mode."
    a "으, 그 목소리, 듣기만 해도 알겠다. 또 찡찡대려고 하지?"

# game/script.rpy:1379
translate kor ch3_b9bb5e72:

    # w pout "Take pity on me. I'm having a bad day."
    w pout "날 좀 가엽게 여겨봐. 오늘 기분 진짜 안 좋단 말이야."

# game/script.rpy:1380
translate kor ch3_637bc98d:

    # a whatever "Alright, ya baby, tell me what happened. (Things are slow today anyhow...)"
    a whatever "그래, 이 징징아. 뭔 일이 있었는지 말이나 해봐. (어차피 일도 여유있고...)"

# game/script.rpy:1386
translate kor ch3_06ace653:

    # "Astragalus listened patiently as I explained the events of the day..."
    "아스트라갈루스는 오늘 있었던 일을 참을성 있게 들어줬어..."

# game/script.rpy:1387
translate kor ch3_4ad450d5:

    # "I've learned to come straight to her whenever I find myself unable to make a decision."
    "내가 갈팡질팡하고 있을 때, 아스트라갈루스는 항상 내게 방향을 제시해줬지."

# game/script.rpy:1388
translate kor ch3_fcc6a442:

    # "Although she often puts things far too bluntly, I DO always end up feeling more grounded after her consolation..."
    "가끔 너무 모나게 얘기하곤 하지만, 해주는 위안을 듣고 있다보면 결국 마음이 편해지긴 해."

# game/script.rpy:1389
translate kor ch3_c8e8adb4:

    # nvl clear
    # a annoyed "So... you're upset, because you overstepped his bounds."
    nvl clear
    a annoyed "그러니까... 네가 그 사람 선을 넘은 거 때문에 기분이 상한 거지?"

# game/script.rpy:1392
translate kor ch3_67e72a49:

    # w cute whine2 "Accidentally!! You always leave out key information..."
    w cute whine2 "그건 실수였어!! 넌 항상 중요한 부분은 빼고 말하더라..."

# game/script.rpy:1393
translate kor ch3_2ed789cb:

    # a whatever "And now you think it's over between you two."
    a whatever "그래서 이제 너희 둘 사이가 끝이라고 생각하는 거고."

# game/script.rpy:1394
translate kor ch3_bb6894dc:

    # w oops "When you put it like that, I really DO sound dramatic..."
    w oops "그렇게 말하니까, 내가 조금 지나치게 생각했던 것 같기도 하네..."

# game/script.rpy:1395
translate kor ch3_c1b6eb3c:

    # a think "I mean, you are. But you also have a point."
    a think "맞긴 한데, 너도 제대로 생각한 부분이 있긴 해."

# game/script.rpy:1396
translate kor ch3_28a5e162:

    # a neutral "If you wanna avoid things getting complicated, this is your sign to get out."
    a neutral "상황이 복잡해지는 게 싫으면, 지금이 때려치기 좋은 기회야."

# game/script.rpy:1397
translate kor ch3_5e7d2a22:

    # a lol "I gotta say, though... for two guys who AREN'T in a committed relationship, you sure do sound like you're in one."
    a lol "그래도 말이야... 사내 놈 둘이 연애 안 하는 거 치고는, 누가 보면 진짜 사귀는 줄 알겠어."

# game/script.rpy:1398
translate kor ch3_aa0b0ee9:

    # w pout "It's purely casual. I've still been seeing a few others in the midst of this!"
    w pout "가벼운 만남일 뿐이야. 파스틸과 만나는 와중에도 다른 사람들이랑 만나곤 했거든!"

# game/script.rpy:1399
translate kor ch3_382e4d30:

    # a sure "Buuut all you talk about is Pastille. Every time you come in here--"
    a sure "하지만 맨날 파스틸 얘기만 하잖아. 항상 여기 들어올 때면..."

# game/script.rpy:1400
translate kor ch3_e8d058af:

    # w conflicted "Ugh, I know! I know..."
    w conflicted "으, 나도 알아! 안다구..."

# game/script.rpy:1401
translate kor ch3_1b2b8580:

    # w oops "I just wish I hadn't gone to return the jacket. It was supposed to be fun, but now..."
    w oops "그냥 그때 자켓을 돌려주지 말 걸 그랬어. 재미있으라고 내린 결정이었는데, 이제는..."

# game/script.rpy:1402
translate kor ch3_e4e99817:

    # a whatever "Yeah, honestly, I think he's being unfair. He shows up to your place whenever he wants, right?"
    a whatever "그래, 솔직히, 좀 불공평하긴 하네. 그 인간은 지가 원할 때 너희 집에 오는 거 아냐, 안 그래?"

# game/script.rpy:1403
translate kor ch3_d71e409e:

    # w sorry "Yes, but I don't have anything else going on! He has a respectable job and all..."
    w sorry "그렇긴 하지, 하지만 나도 달리 할 게 없는걸! 파스틸은 반반한 일자리도 있는데..."

# game/script.rpy:1404
translate kor ch3_bf1c7745:

    # a think "Mm... Sounds like you just have less self-respect, and this guy isn't treating you right."
    a think "흐음... 보면 네 자존심만 까일 대로 까이고, 그 인간이 널 제대로 못 대해주는 거 같다."

# game/script.rpy:1405
translate kor ch3_ec693909:

    # w pout "Now THAT'S unfair. He simply said he wasn't READY--it doesn't mean..."
    w pout "그건 좀 심한 말이다. 파스틸은 준비만 안 됐다고 했지, 그렇다고..."

# game/script.rpy:1406
translate kor ch3_8014452b:

    # a lmao "Hah, making excuses now? You are REALLY hung up on him! This is too hilarious to watch!" with vpunch
    a lmao "이젠 걔 변호까지 해주려고? 너 진짜 걔한테 매달려서 사는 모양이네! 이거 참 진귀한 광경인걸?" with vpunch

# game/script.rpy:1407
translate kor ch3_7d2a4c03:

    # w yell "Enough!! I-I...!"
    w yell "그만 해!! 그... 그...!"

# game/script.rpy:1408
translate kor ch3_2092e4fa:

    # w whine "I simply cannot help it if he's just the cutest thing! Of course I don't want to stop seeing him!"
    w whine "걔가 그렇게 귀여운 걸 내가 어떻게 참아! 당연히 그만 보고 싶지 않지!"

# game/script.rpy:1413
translate kor ch3_94eb88e1:

    # "At that moment, a familiar chime sounded, marking a customer's arrival."
    "그 순간, 손님이 들어올 때 나는 익숙한 종소리가 들려왔어."

# game/script.rpy:1414
translate kor ch3_6f5dcd39:

    # "I turn my head instinctively to see..."
    "본능적으로 고개를 돌린 내 눈에 들어온 사람은..."

# game/script.rpy:1415
translate kor ch3_76b2fe88_4:

    # nvl clear
    nvl clear

# game/script.rpy:1418
translate kor ch3_5c881dad:

    # j "Periwinkle? Omg, you look so cute today!"
    j "페리윙클? 오, 너 오늘 좀 귀여워 보인다?"

# game/script.rpy:1419
translate kor ch3_64869387:

    # w cute innocent "Why, thank you! I certainly didn't expect to see you here, Jam!"
    w cute innocent "어머, 고마워! 널 여기에서 보게 될 줄이야, 잼!"

# game/script.rpy:1421
translate kor ch3_d980971d:

    # n "Astragalus walks into the back room, still laughing at Periwinkle's expense."
    n "아스트라갈루스는 페리윙클의 슬픔에 깔깔 웃으며 뒷방으로 들어갑니다."

# game/script.rpy:1423
translate kor ch3_d4d720aa:

    # j ehe "I've been coming here to buy your magic!"
    j ehe "나 여기 자주 와서 네가 만든 마법 사는데!"

# game/script.rpy:1424
translate kor ch3_85592859:

    # j wink "Remember when you did a little demo for everyone at that one party? You totally sold me on it back then."
    j wink "너 그때 파티에 와서 슬쩍 네 솜씨 보여줬던 거 기억나? 그때 보고 확 반했다니까."

# game/script.rpy:1425
translate kor ch3_4e79c9b8:

    # w calm "Hm, I've done a few, so I can't recall... but I'm happy to hear it regardless!"
    w calm "흠, 그런 걸 한 적이 좀 많아서 기억은 잘 안 나지만... 그래도 그랬다니 다행이네!"

# game/script.rpy:1426
translate kor ch3_f9bf92a0:

    # j oh "So what are YOU doing here? On a date, or on the job?"
    j oh "너는 여기서 뭐 해? 데이트? 일?"

# game/script.rpy:1427
translate kor ch3_b4e34e50:

    # w decline "No date today. I ruined my chance at THAT..."
    w decline "오늘은 데이트 같은 거 없어. 그럴 기회는 내가 내 손으로 날려버렸지..."

# game/script.rpy:1428
translate kor ch3_cd4e936d:

    # j whaaat "Aww man, what?! That's such a bummer..."
    j whaaat "아이고, 뭐!? 그거 진짜 안 됐는데..."

# game/script.rpy:1429
translate kor ch3_97e4a9ca:

    # j think "Really never thought I'd hear of the day YOU of all people couldn't get a date, though. You date, like, EVERYONE..."
    j think "네가 데이트가 없는 날이라니 상상도 못 했다, 진짜. 너는 뭐, 누구든간에 일단 사귀고 보잖아."

# game/script.rpy:1430
translate kor ch3_05e71c7d:

    # w smile "It'd be more accurate to say I \"go on dates\" with everyone, rather than ACTUALLY date them."
    w smile "\'데이트를 나가는 것\'과 \'사귀는 것\'은 차이가 있다고 생각하는데."

# game/script.rpy:1431
translate kor ch3_634602b5:

    # j smile "Aww, same diff. You're like, the thirstmaster."
    j smile "그거나 그거나. 일단 너는 정욕에 목마른 자 아니냐구."

# game/script.rpy:1432
translate kor ch3_f2f6583a:

    # w neutral "(Mm... she's right. It's not as if Pastille is my only option if I'm looking for a good time.)"
    w neutral "(음... 잼 말이 맞아. 내가 좋은 시간을 즐기는 데에 파스틸이 유일한 선택지인 것도 아니고.)"

# game/script.rpy:1433
translate kor ch3_31a53245:

    # j ehe "Anyway, are you going to Chirval's party tonight?"
    j ehe "어쨌든, 오늘 치르발이 여는 파티 올 거야?"

# game/script.rpy:1434
translate kor ch3_033d403f:

    # w oh "No, this is the first I've heard of it! He's throwing yet another soirée?"
    w oh "아니, 방금 처음 들었는데? 또 야회 파티인 거야?"

# game/script.rpy:1435
translate kor ch3_be55c58e:

    # j oh "Yeah, I'm surprised you didn't know!"
    j oh "어, 네가 몰랐다니 좀 놀랐는데?"

# game/script.rpy:1436
translate kor ch3_a54aaec3:

    # w guilty "I suppose I've been more out of the loop on these things than usual..."
    w guilty "내가 최근 들어 그런 거에 신경을 못 쓰긴 한 것 같아..."

# game/script.rpy:1437
translate kor ch3_de488a64:

    # w oops "(I haven't bothered with as many parties, since...)"
    w oops "(최근엔 파티에 신경을 잘 안 썼었지. 언제부터였더라...)"

# game/script.rpy:1438
translate kor ch3_7188d2a4:

    # j smile "Well, you should come! They're good luck. Like, in terms of love~ and romance~!"
    j smile "그래도 와! 좋을 거라고. 사~랑과 로~맨스가 살아있는 곳이니까~!"

# game/script.rpy:1439
translate kor ch3_3aa62bce:

    # j embarrassed "I mean, I'm finally dating my best friend, thanks to that last one...!"
    j embarrassed "아니, 나도 마지막으로 갔던 파티 덕분에 드디어 절친이랑 사귀기 시작했다고...!"

# game/script.rpy:1440
translate kor ch3_61645db5:

    # w oh "Ah--Marzipan, wasn't it? You weren't together before that?"
    w oh "아... 이름이 마지팬이었었지? 너희 둘 이미 사귀고 있던 거 아니었어?"

# game/script.rpy:1441
translate kor ch3_a063a141:

    # j whaaat "AHHHH, I knew everyone thought we were...! Ugh, so embarrassing..." with vpunch
    j whaaat "아아악, 다들 그렇게 생각하고 있었다는 게 진짜 짜증난다니까...!" with vpunch

# game/script.rpy:1442
translate kor ch3_949360b6:

    # j embarrassed2 "I guess what matters is we could finally be totally honest with each other, though... Ahh, I'm really happy...."
    j embarrassed2 "그래도 결국엔 드디어 서로한테 솔직해질 수 있다는 게 중요한 거 같다... 아, 진짜 기쁘다니까...."

# game/script.rpy:1443
translate kor ch3_c9023fe1:

    # w happy "Well, congratulations! You deserve that happiness."
    w happy "축하해! 너라면 그 행복을 누릴 자격이 있어."

# game/script.rpy:1444
translate kor ch3_802b14e9:

    # j wink "Yeah!! So like, if you ever need relationship advice, I'm your gal!"
    j wink "맞아!! 그러니까, 뭐, 연애 관계 때문에 조언이 필요해지면, 나한테 와!"

# game/script.rpy:1445
translate kor ch3_f17415bb:

    # j think "Oh--but I guess you wouldn't, since you don't actually date anyone..."
    j think "아... 근데 남들이랑 안 사귀는 너는 내 조언이 필요 없긴 하겠다."

# game/script.rpy:1447
translate kor ch3_3f2cc2ed:

    # n "Periwinkle hears Astragalus snorting with laughter in the back room."
    n "페리윙클은 웃음 때문에 숨 쉬는 것도 힘들어하는 아스트라갈루스의 소리를 듣습니다."

# game/script.rpy:1449
translate kor ch3_18044365:

    # w insulted "(How dare she! I came here to be comforted, not ridiculed...!)" with vpunch
    w insulted "(어떻게 저럴 수가! 난 여기 위로받으려고 왔지, 비웃음당하려고 온 게 아니란 말이야...!)" with vpunch

# game/script.rpy:1450
translate kor ch3_d074eaf6:

    # w innocent "Jam, dear. What time did you say that party started?"
    w innocent "잼, 그 파티는 언제 시작한다고 했지?"

# game/script.rpy:1451
translate kor ch3_79b12204:

    # j oh "Oh, like... a few hours from now? I think?"
    j oh "아, 한... 몇 시간 뒤일걸?"

# game/script.rpy:1452
translate kor ch3_26dd1657:

    # j embarrassed "Sorry, I can never remember the time difference between here and the Netherworld...."
    j embarrassed "미안, 여기랑 지옥 시차는 기억하기가 진짜 힘들다니까...."

# game/script.rpy:1453
translate kor ch3_b3aad0af:

    # w calm "No matter. These things tend to go all night, and I prefer to arrive fashionably late."
    w calm "상관 없어, 어차피 파티는 밤 내내 계속되니까. 그리고 난 적당히 느지막이 오는 걸 선호한단 말이지."

# game/script.rpy:1454
translate kor ch3_08184ed7:

    # w smile "Now if you'll excuse me, I'm going to return home to freshen up before the soirée."
    w smile "그럼 난 이제 집으로 돌아가 야회 파티에 가기 전에 좀 개운하게 쉬고 있겠어."

# game/script.rpy:1455
translate kor ch3_fc7b2769:

    # j ehe "Sure! See ya there~"
    j ehe "그래! 그럼 거기서 봐~"

# game/script.rpy:1461
translate kor ch3_bbcb516d:

    # n "Periwinkle marches home in a huff."
    n "페리윙클은 한순간에 집으로 총총 걸어갑니다."

# game/script.rpy:1462
translate kor ch3_61c2becd:

    # w cute pout "(Hmph... Astragalus thinks I'm lacking in self-respect.)"
    w cute pout "(흥... 아스트라갈루스는 내가 자존감이 낮아졌다고 생각하는가 보네.)"

# game/script.rpy:1463
translate kor ch3_68f32e6f:

    # w "(I'll show her...!)"
    w "(틀렸다는 걸 보여주겠어...!)"

# game/script.rpy:1465
translate kor ch3_dcc6e26c:

    # "I'm going to find someone to spoil me tonight!"
    "오늘밤은 나와 제대로 놀아줄 사람을 만날 거야!"

# game/script.rpy:1466
translate kor ch3_c3ca6d80:

    # "Netherworld parties happen to be the perfect venue--always filled with cute faces I haven't yet encountered."
    "지옥의 파티는 이럴 때 딱 맞는 장소야. 내가 만나보지 못한 귀여운 얼굴들로 가득 차있으니까."

# game/script.rpy:1467
translate kor ch3_439ac636:

    # "Plenty of incubi as well... they LIVE to please their partners."
    "인큐버스도 많고... 인큐버스는 파트너를 위해서라면 뭐든 할 존재들이지."

# game/script.rpy:1468
translate kor ch3_8e765de2:

    # "It's been a while since I've slept with a demon... <3 I'm looking forward to this now~!"
    "악마랑 자본 건 오랜만인데...♥ 이번에는 좀 기대가 되는걸~?"

# game/script.rpy:1469
translate kor ch3_078fe372:

    # nvl clear
    # centered "{nw}"
    nvl clear
    centered "{nw}"

# game/script.rpy:1481
translate kor ch3_fb133186:

    # n "And so, a few hours later..."
    n "몇 시간 뒤..."

# game/script.rpy:1487
translate kor ch3_09c7b9d1:

    # n "Periwinkle arrives at the soirée."
    n "페리윙클은 야회 파티에 도착합니다."

# game/script.rpy:1490
translate kor ch3_a3391362:

    # w drool "(Let's see... who looks available~?)"
    w drool "(어디 보자... 누구를 잡아볼까~?)"

# game/script.rpy:1491
translate kor ch3_fdd167fd:

    # n "Scanning the room, he spots both Jam and Chirval happily chatting with the other guests."
    n "방 안을 둘러보는 중, 페리윙클은 잼과 치르발이 다른 손님들과 기쁘게 대화하고 있는 모습을 봅니다."

# game/script.rpy:1492
translate kor ch3_56343088:

    # w shy "(Chirval himself certainly isn't a bad lay... but I couldn't go stealing the host of the party~!)"
    w shy "(치르발도 절대로 나쁘지 않은 상대지만... 내가 어떻게 파티의 호스트를 훔칠 수 있겠어~?)"

# game/script.rpy:1494
translate kor ch3_cbeff3b4:

    # n "Periwinkle begins to gravitate toward the snack table, still scoping out the various party-goers."
    n "페리윙클은 파티광들을 훑으며 간식 테이블로 천천히 걸어가기 시작합니다."

# game/script.rpy:1495
translate kor ch3_200cad0c:

    # w smile "(Plenty of candidates to choose from... however will I decide? <3)"
    w smile "(후보가 너무 많은데... 어떻게 정한담? ♥)"

# game/script.rpy:1496
translate kor ch3_70adf595:

    # n "Before he can make up his mind about who to approach, a taller demon slides into the empty space beside him to start a conversation."
    n "페리윙클이 누구에게 다가갈지 결정할 수 있기 전에, 키가 큰 악마 한 명이 페리윙클의 옆 비어있는 편에 끼어들어 대화를 시작합니다."

# game/script.rpy:1499
translate kor ch3_404ac1b2:

    # k "Lotsa cute witches at this soirée, huh?"
    k "이 파티엔 귀여운 마녀들이 많네요, 그쵸?"

# game/script.rpy:1500
translate kor ch3_356d9a00:

    # w drool "(Oh, so it's been decided FOR me~! I'm ALREADY being spoiled <3)"
    w drool "(아, 알아서 정해졌구나~! )"

# game/script.rpy:1501
translate kor ch3_2c4909af:

    # w calm "I didn't come here for the witches."
    w calm "전 여기 마녀를 찾으러 온 게 아니랍니다."

# game/script.rpy:1502
translate kor ch3_4245e0f8:

    # k happy "Hah! ...I'm Kardaemon."
    k happy "하하! ...전 카데몬이에요."

# game/script.rpy:1503
translate kor ch3_02708700:

    # w smile "Periwinkle."
    w smile "페리윙클입니다."

# game/script.rpy:1504
translate kor ch3_f4579e3e:

    # k shy "Periwinkle... So, this is gonna sound weird, but..."
    k shy "페리윙클... 그, 좀 이상하게 들릴 수도 있는데요..."

# game/script.rpy:1505
translate kor ch3_8c6f158c:

    # k ask "Do I... know you from somewhere?"
    k ask "저희 어디서... 본 적이 있나요?"

# game/script.rpy:1506
translate kor ch3_c35e243b:

    # w teehee "Your dreams, perhaps?"
    w teehee "어쩌면 꿈에서 아닐까요?"

# game/script.rpy:1507
translate kor ch3_51d2fdbc:

    # k laugh "Naww, for real! Something about your face is just so familiar..."
    k laugh "아뇨, 진짜로요! 어디서 많이 본 얼굴이셔서..."

# game/script.rpy:1508
translate kor ch3_1dab2d42:

    # w smile "I frequent these type of events, so it's likely we've crossed paths at some point."
    w smile "전 이런 파티에 자주 가니까, 어쩌면 스쳐봤을지도 모르겠군요."

# game/script.rpy:1509
translate kor ch3_97371c3b:

    # k shy "Hmmmm... that's not it. I woulda tried hitting on you if we did."
    k shy "흐으음... 아뇨, 그건 아닌 거 같아요. 만약에 전에 만났더라면 분명 제가 작업을 걸었을 테니까요."

# game/script.rpy:1510
translate kor ch3_9e11e78c:

    # w happy "Hmhm, well, you're certainly free to do so now <3"
    w happy "후후, 뭐, 지금 그러셔도 전혀 상관 없답니다 ♥"

# game/script.rpy:1511
translate kor ch3_7862bf1b:

    # k happy "I'll give it a shot! With your permission, haha..."
    k happy "한번 도전해볼게요! 물론, 그쪽만 괜찮으시다면야, 하하..."

# game/script.rpy:1512
translate kor ch3_96386f57:

    # w smile "(This one isn't bad... I do appreciate how straightforward he's being.)"
    w smile "(이 사람 나쁘지 않은데... 직설적으로 말하는 게 마음에 들어.)"

# game/script.rpy:1513
translate kor ch3_c4cc7630:

    # k smile "So! What ARE you here for, if not the witches?"
    k smile "그래서! 마녀들을 보러 오신 게 아니면 여기는 어쩐 일로 오셨나요?"

# game/script.rpy:1514
translate kor ch3_f5eef97f:

    # w innocent "I had intended to find someone to spoil me... and incubi are rumored to be good for exactly that <3"
    w innocent "저랑 좀 놀아줄 사람을 찾고 있었는데... 듣자하니 인큐버스들이 그런 걸 좀 잘 한다면서요? ♥"

# game/script.rpy:1515
translate kor ch3_513f012e:

    # k shy "We are, we are..."
    k shy "우리가 좀 그런 편이죠."

# game/script.rpy:1516
translate kor ch3_19ddae00:

    # w my "So the rumors are true~? I'm in luck, then!"
    w my "그럼 그 소문들이 사실이라는 건가요~? 운도 좋아라!"

# game/script.rpy:1517
translate kor ch3_f89607ce:

    # w teehee "Would you happen to have any friends who would be interested in dancing with a cute little witch like me~?"
    w teehee "저같이 작고 귀여운 마법사랑 한바탕 춤추고 싶어하는 친구들이 있을까요~?"

# game/script.rpy:1518
translate kor ch3_6d7a44bf:

    # k "Hmmmmmmm... I could ask around."
    k "흐으으으음... 한번 물어볼게요."

# game/script.rpy:1519
translate kor ch3_5efc4a86:

    # k smile "Or! Better idea. You could just settle for me?"
    k smile "아니면! 더 좋은 생각이 있는데요, 혹시 저는 어떠실까요?"

# game/script.rpy:1520
translate kor ch3_c9017794:

    # w calm "Hmhm, I suppose you'll do <3"
    w calm "후후, 그럼 그렇게 할까요? ♥"

# game/script.rpy:1523
translate kor ch3_50b7709f:

    # "I present my hand, and Kardaemon gives an exaggerated bow."
    "내가 손을 내밀자 카데몬은 과장되게 몸을 숙여 인사했어."

# game/script.rpy:1524
translate kor ch3_084b6170:

    # "He pulls me in, albeit a little clumsily, with his gigantic demon hands. Always enjoyable to be swept up in the arms of a larger man <3"
    "카데몬은 커다란 악마 손으로, 조금은 서툴게 날 끌어당겼어. 항상 몸집이 큰 남자 팔에 휘둘리는 건 기분 좋단 말이지 ♥"

# game/script.rpy:1525
translate kor ch3_272b335d:

    # "My own hand is almost entirely consumed by his. Unlike with Pastille's, which fit so--"
    "내 손은 카데몬의 손 안에 쏙 들어갔어. 파스틸과는 다르게 말이지. 파스틸 손은..."

# game/script.rpy:1526
translate kor ch3_36f5d814:

    # nvl clear
    # "...Pastille?"
    nvl clear
    "...파스틸?"

# game/script.rpy:1528
translate kor ch3_bd6489c5:

    # "Am I STILL comparing everyone to him?"
    "나 또 이 사람 저 사람 걔랑 비교하고 있는 거니?"

# game/script.rpy:1529
translate kor ch3_c405272e:

    # "I shake the thought and return to the moment..."
    "나는 생각을 떨쳐내고 이 순간에 집중하기로 했어."

# game/script.rpy:1530
translate kor ch3_76b2fe88_5:

    # nvl clear
    nvl clear

# game/script.rpy:1533
translate kor ch3_4dfd153d:

    # n "The pair twirls around the dance floor, losing themselves in the music."
    n "카데몬과 페리윙클은 연회장을 돌며 음악에 취합니다."

# game/script.rpy:1534
translate kor ch3_17b0a74e:

    # n "After a while, Kardaemon suddenly speaks up."
    n "시간이 흐른 뒤, 카데몬이 갑자기 입을 엽니다."

# game/script.rpy:1535
translate kor ch3_122eb838:

    # k "...OH! I think I just realized where I know you from!"
    k "...아! 어디서 봤는지 알 거 같아요!"

# game/script.rpy:1536
translate kor ch3_5a8eabf4:

    # w love "Really, now?"
    w love "정말인가요?"

# game/script.rpy:1537
translate kor ch3_5ae9085a:

    # k "Yeah, you were in the magazine I work for!"
    k "네, 제가 일하는 곳 잡지에 나오신 분이죠?"

# game/script.rpy:1538
translate kor ch3_a784e394:

    # k "I'm an editor. We used your photos for an issue a couple years back."
    k "전 편집가거든요. 몇 년 전에 페리윙클 씨 사진을 쓴 적이 있었어요."

# game/script.rpy:1539
translate kor ch3_efcb9510:

    # w oh "Ah... what a coincidence. I DID used to do some modeling, in the past..."
    w oh "아... 우연이네요. 확실히 제가 모델 일을 했던 적이 있었죠. 과거에는..."

# game/script.rpy:1540
translate kor ch3_07b8e242:

    # w calm "And in the past it shall remain. I'm in a different line of work now."
    w calm "그 과거는 과거로 남겨두려고요. 저는 이제 다른 직종에 종사한답니다."

# game/script.rpy:1541
translate kor ch3_e86cb7f9:

    # k "Aww, really? That's too bad. I always thought you looked amazing."
    k "아아, 진짜요? 아쉽네요. 전 항상 페리윙클 씨가 정말 예쁘다고 생각했거든요."

# game/script.rpy:1542
translate kor ch3_014598d5:

    # w smile "Hmhm, I appreciate that <3"
    w smile "후후, 감사합니다 ♥"

# game/script.rpy:1545
translate kor ch3_eac59ccf:

    # w neutral "(Well this certainly complicates things... I'd much prefer to have been complete strangers.)"
    w neutral "(복잡하게 됐네... 차라리 완전히 모르는 사람인 편이 더 나은데.)"

# game/script.rpy:1546
translate kor ch3_54236a36:

    # w decline "(How unfortunate... just when I was beginning to enjoy myself.)"
    w decline "(아쉬워라... 한창 즐기고 있던 때에 말이지.)"

# game/script.rpy:1549
translate kor ch3_7c244efe:

    # k "Haha, wow, I can't believe I ran into you like this. Maybe it's a sign...?"
    k "하하, 우와, 이렇게 만나뵙게 될 줄은 상상도 못 했네요. 뭔가의 징조인 걸까요...?"

# game/script.rpy:1550
translate kor ch3_f26130c5:

    # w smile "A sign? Of what, dare I ask?"
    w smile "징조요? 어떤 징조일지 물어봐도 될까요?"

# game/script.rpy:1551
translate kor ch3_41d59cda:

    # k smile "That you should come back to modeling! I can get you in our magazine again--if you're interested, that is."
    k smile "페리윙클 씨가 모델 일에 돌아올 징조요! 다시 잡지에 나올 수 있게 해드릴게요... 아, 물론 원하신다면요."

# game/script.rpy:1552
translate kor ch3_24632a00:

    # w guilty "I appreciate the offer, but I've moved on. It put too much of a strain on my relationship with fashion, among other things..."
    w guilty "그거 참 감사하지만, 전 이제 다른 사람이에요. 패션과 제 관계는 무거워져만 갔죠. 다른 일도 많이 있었고요..."

# game/script.rpy:1553
translate kor ch3_9bbf2611:

    # k shy "Ah... well, at least take my card! In case you change your mind."
    k shy "아... 그럼 제 명함이라도 가져가세요! 마음이 바뀔 때를 대비해서요."

# game/script.rpy:1554
translate kor ch3_1ae6e450:

    # w calm "No thank you. I don't see that happening."
    w calm "필요 없습니다. 그런 일 없을 거 같아요."

# game/script.rpy:1555
translate kor ch3_12306026:

    # k laugh "Aww, come on... you'd be so great! It feels like such a waste of talent...."
    k laugh "아, 아쉬운데... 진짜 잘 하실 거예요! 재능 썩혀두고 계신 거 같은데...."

# game/script.rpy:1556
translate kor ch3_51eac4d1:

    # w neutral "(Hm... I'm quickly growing tired of this.)"
    w neutral "(흠... 이거 지치는걸.)"

# game/script.rpy:1557
translate kor ch3_c4d486cb:

    # w smile "Thank you for the dance... but I really should be going now."
    w smile "춤은 감사드리지만... 이젠 가봐야 할 것 같군요."

# game/script.rpy:1558
translate kor ch3_33e9643f:

    # k huh "Huh? Ah, uh... sure."
    k huh "네? 아, 어... 그래요."

# game/script.rpy:1559
translate kor ch3_b30b1ced:

    # w innocent "This was fun. Perhaps we'll meet again sometime <3"
    w innocent "재밌었어요. 나중에 다시 만날지도 모르겠네요 ♥"

# game/script.rpy:1560
translate kor ch3_0d5df227:

    # k sad "Y-yeah...."
    k sad "ㄴ...네...."

# game/script.rpy:1567
translate kor ch3_ef15a56c:

    # "I didn't expect to be reminded of my modeling days of all things..."
    "여기서 모델 일 한 게 다시 떠오르게 될 줄이야..."

# game/script.rpy:1568
translate kor ch3_bad021ca:

    # "Although his excitement was understandable, the way he went about it certainly ruined the mood."
    "그 사람이 신이 난 건 이해할 수 있지만, 태도가 완전히 분위기를 망쳐버렸어."

# game/script.rpy:1569
translate kor ch3_72a95f04:

    # "I hate to admit it, but I'd gone into this night far too unstable to begin with. For such a small thing to get to me..."
    "인정하기는 싫지만, 난 처음부터 너무 불안정한 상태로 이 파티에 왔어. 그런 사소한 게 나를 자극하다니..."

# game/script.rpy:1570
translate kor ch3_5ad7ada1:

    # nvl clear
    # "I'm not even here on my own terms, am I?"
    nvl clear
    "생각해보면 내 스스로를 위해서 여기 온 것도 아니잖아?"

# game/script.rpy:1572
translate kor ch3_2f4d44d7:

    # "This was all to prove a point. That's certainly not in the spirit of a friendly soirée..."
    "아스트라갈루스에게 한 방 먹이려고 온 거였지. 이런 야회 파티의 분위기와는 전혀 맞지 않는 동기야..."

# game/script.rpy:1573
translate kor ch3_d4b47508:

    # "It's best I just return home and--"
    "그냥 집으로 돌아가서..."

# game/script.rpy:1574
translate kor ch3_f36f833e:

    # nvl clear
    # k "Periwinkle, wait!"
    nvl clear
    k "페리윙클 씨, 잠시만요!"

# game/script.rpy:1577
translate kor ch3_f6a6af3b:

    # n "He turns his head to find that Kardaemon has chased after him, stumbling into the lonely night air."
    n "페리윙클이 고개를 돌리자, 페리윙클을 따라오기 위해 외로운 밤 공기를 뚫고 들어오는 카데몬이 있었습니다."

# game/script.rpy:1579
translate kor ch3_29be8e4a:

    # k "Hey--I, uh... I'm sorry if I said anything to upset you."
    k "저... 제가 무슨 말실수를 했다면 정말 죄송해요."

# game/script.rpy:1580
translate kor ch3_63733355:

    # w oh "...Upset me? Perish the thought!"
    w oh "...말실수요? 그런 생각 마세요!"

# game/script.rpy:1581
translate kor ch3_7415dc79:

    # w guilty "It's simply that I'm feeling a little off tonight. I realized I may have come here for the wrong reasons..."
    w guilty "그냥 오늘은 기분이 조금 좋지 않아서 그런 거랍니다. 여기에 잘못된 동기를 가지고 찾아왔다는 걸 깨달았어요..."

# game/script.rpy:1582
translate kor ch3_5567e155:

    # k pls "Look... I'm sorry that I suddenly started talking about work. That wasn't why I approached you at all."
    k pls "그... 일에 대해서 갑자기 이야기한 거는 정말 죄송해요. 그런 것 때문에 접근한 건 절대로 아니에요."

# game/script.rpy:1583
translate kor ch3_01a63751:

    # k sorry "You came here for a good time, right? Well, a party's definitely the place to find it!"
    k sorry "여기 좋은 시간 보내려고 오신 거잖아요? 그럼 당연히 이런 파티같은 곳에 오셔야죠."

# game/script.rpy:1584
translate kor ch3_1e7ddd47:

    # k lookoff "Heck, it's what I'M here for, too... so, you're not wrong to come looking for that."
    k lookoff "저도 그럴려고 왔는 걸요... 그러니까 그런 걸 찾고 계신 거라면 절대로 페리윙클 씨가 틀린 게 아니에요."

# game/script.rpy:1585
translate kor ch3_3219922b:

    # w neutral "(He's completely misread the situation... Although, it IS starting to look salvageable from here.)"
    w neutral "(상황을 전혀 다른 방향으로 해석하고 있네... 그래도 여기서부터 분위기를 재기시킬 수 있을 거 같아.)"

# game/script.rpy:1586
translate kor ch3_07c62861:

    # k sorry "Anyway, please forget about the magazine stuff--it doesn't matter. We were having fun before that right?"
    k sorry "어쨌든, 제가 잡지 이야기 했던 건 잊어주세요... 상관 없는 이야기니까요. 저희 둘 다 즐기러 온 거잖아요?"

# game/script.rpy:1587
translate kor ch3_88dfd8df:

    # w calm "Dancing was nice, yes..."
    w calm "춤추는 건 좋긴 했죠..."

# game/script.rpy:1588
translate kor ch3_0e1aab5c:

    # k sad "I-I wanna do more than just dance with you."
    k sad "그... 춤추는 거 이상을 해보고 싶어요."

# game/script.rpy:1589
translate kor ch3_80ca340f:

    # w drool "(Oho, there it is~ Now we're getting somewhere.)"
    w drool "(오호라, 이제 좀 뭐가 되려고 하네.)"

# game/script.rpy:1590
translate kor ch3_26564ac5:

    # w shy "More than dance? And what could that mean~?"
    w shy "춤 이상이요? 어머, 그게 무슨 말일까요~?"

# game/script.rpy:1591
translate kor ch3_107e0d19:

    # k shy "Hah, well, don't make me spell it out..."
    k shy "하하, 꼭 제 입으로 말해야 하나요?"

# game/script.rpy:1592
translate kor ch3_70331591:

    # w smile "A kiss, perhaps?"
    w smile "어쩌면 키스려나요?"

# game/script.rpy:1593
translate kor ch3_1dbec082:

    # k smile "Sure. And, well, you know... whatever else you'd like to do! As an incubus, I live to please."
    k smile "그럼요. 그리고, 뭐, 음... 원하시는 거 뭐든요! 저 같은 인큐버스는 쾌락을 드리는 데에 삶을 바치거든요."

# game/script.rpy:1594
translate kor ch3_43a052fd:

    # w love "(Since he apologized, I may as well...)"
    w love "(사과까지 했으니까, 이대로 가볼까...)"

# game/script.rpy:1595
translate kor ch3_d84e6f35:

    # w calm "Kissing is a fine start."
    w calm "키스가 좋은 시작점이 되겠네요."

# game/script.rpy:1598
translate kor ch3_91dabae0:

    # n "Kardaemon holds out his arms, inviting Periwinkle into a soft embrace."
    n "카데몬은 손을 뻗어 페리윙클을 따듯하게 감싸안습니다."

# game/script.rpy:1599
translate kor ch3_890d5fb6:

    # n "Periwinkle's hands glide up his chest, and he wraps his arms around the demon's neck. Their faces just inches apart, he pauses..."
    n "페리윙클의 손이 카데몬의 가슴을 타고 올르고, 카데몬의 목에 페리윙클의 팔이 걸립니다. 둘의 얼굴이 거의 맞닿을 때, 카데몬이 멈춥니다."

# game/script.rpy:1600
translate kor ch3_5db6b259:

    # k "...?"
    k "...?"

# game/script.rpy:1601
translate kor ch3_62b5b0bb:

    # w ah "(...Ah. I expected him to close the gap.)"
    w ah "(...아, 거리를 좁힐 줄 알았는데.)"

# game/script.rpy:1602
translate kor ch3_d0a1702b:

    # w conflicted "(Pastille would've kissed me. I've grown far too accustomed to that, so I automatically...)"
    w conflicted "(파스틸이었다면 날 곧장 키스해줬겠지. 그게 너무 익숙한 나머지 자동으로...)"

# game/script.rpy:1603
translate kor ch3_6c100ae0:

    # w oops "(Shit. This was a mistake...)"
    w oops "(젠장. 이거 실수였네...)"

# game/script.rpy:1604
translate kor ch3_795ea425:

    # n "Periwinkle gives him a light peck on the cheek before pulling away."
    n "페리윙클은 카데몬의 뺨에 가벼운 키스를 하고 뒤로 물러납니다."

# game/script.rpy:1607
translate kor ch3_01751b4a:

    # w decline "...My apologies. I do actually need to get going now."
    w decline "...죄송합니다. 이제 정말로 가봐야 할 것 같아요."

# game/script.rpy:1608
translate kor ch3_466c52d9:

    # k huh "Huh...?"
    k huh "네...?"

# game/script.rpy:1609
translate kor ch3_d3799d4c:

    # w neutral "I shouldn't have led you on. I'm terribly sorry."
    w neutral "이렇게 이끌어선 안 됐는데. 사과드립니다."

# game/script.rpy:1610
translate kor ch3_e029c081:

    # k sorry "Oh--n-no, don't worry about that... If you don't want to, it's fine."
    k sorry "아... 아... 아뇨. 그건 걱정하지 마세요... 안 하고 싶으면 안 하는 거죠."

# game/script.rpy:1611
translate kor ch3_c9e5ee71:

    # k sad "I'm, uh... a little confused, though... Did I do something wrong?"
    k sad "그냥... 조금 혼란스러워서요... 제가 뭘 잘못했나요?"

# game/script.rpy:1612
translate kor ch3_6e012f78:

    # w decline "It's not you--you're very nice. Very firm muscles."
    w decline "당신 탓이 아니에요... 당신은 착하고 근육도 멋진 사람이에요."

# game/script.rpy:1613
translate kor ch3_1de73ec5:

    # k shy "Hah, thanks."
    k shy "하하, 감사합니다."

# game/script.rpy:1614
translate kor ch3_dc4c50ae:

    # w neutral "If it were any other night, things would've gone very differently. Please believe me when I say that."
    w neutral "다른 날 밤이었다면, 오늘이 다르게 흘러갔을 거예요. 진심으로 하는 말이에요."

# game/script.rpy:1615
translate kor ch3_7e78fb2a:

    # k lookoff "Seriously... is all this mysterious talk supposed to make me want you less...?"
    k lookoff "그렇게 말해놓으시고는 홀연히 사라져버리시는 건가요?"

# game/script.rpy:1616
translate kor ch3_47a1fbc2:

    # w calm "I'm sure you'll have great luck with the witches inside. You're very charming."
    w calm "파티로 돌아가시면 더 좋은 마녀들과 만날 수 있을 거예요. 당신은 매력적인 사람이에요."

# game/script.rpy:1617
translate kor ch3_c29eff2b:

    # k pls "...Damn. Well, alright..."
    k pls "...쩝. 뭐, 알겠습니다..."

# game/script.rpy:1618
translate kor ch3_e35a87bd:

    # k sorry "Get home safe, Periwinkle. Hope to see you again... on any other night, like you said."
    k sorry "조심해서 들어가세요, 페리윙클. 나중에 만나요... 당신이 말한 것처럼 다른 날 밤에 또 보자구요."

# game/script.rpy:1619
translate kor ch3_92af379d:

    # w innocent "Thank you for keeping me entertained. Farewell~"
    w innocent "놀아줘서 고마워요. 안녕~"

# game/script.rpy:1622
translate kor ch3_3e90a2df:

    # "I shouldn't have come..."
    "여기 오는 게 아니었어..."

# game/script.rpy:1623
translate kor ch3_eed2f11e:

    # "What exactly have I proven here tonight? That I'm willing to pursue the first pink-haired boy I come across, out of sheer desperation?"
    "내가 여기서 뭘 증명하려고 했던 거야? 절박한 나머지 눈에 처음으로 들어오는 아무 분홍 머리의 남자나 쫓아가겠다는 거?"

# game/script.rpy:1624
translate kor ch3_e4b0829d:

    # "I wanted Astragalus to be wrong for once. To admit that I'm hung up on someone is just...!"
    "아스트라갈루스가 틀린 말을 했길 바랐는데. 내가 다른 사람한테 의존하려고 한다니 정말...!"

# game/script.rpy:1625
translate kor ch3_0a84e19c:

    # "I don't feel like myself at all..."
    "나답지 않은 기분이 드는걸..."

# game/script.rpy:1626
translate kor ch3_76b2fe88_6:

    # nvl clear
    nvl clear

# game/script.rpy:1639
translate kor ch3_f6133343:

    # n "Periwinkle arrives home, lazily slipping out of his shoes and dress. He tosses his hat somewhere and collapses onto the couch."
    n "페리윙클은 집으로 돌아와 꾸물대며 신발과 드레스를 벗은 다음, 모자는 대충 던져두고 소파에 그대로 쓰러집니다."

# game/script.rpy:1640
translate kor ch3_bcd66a5f:

    # w lazy oops "(Ugh... I feel even more miserable than before.)"
    w lazy oops "(으... 저번보다 더 끔찍한 기분이야.)"

# game/script.rpy:1641
translate kor ch3_cba66395:

    # w neutral "...."
    w neutral "...."

# game/script.rpy:1642
translate kor ch3_b315e641:

    # n "Periwinkle finds himself staring at the front door, half-expecting to hear a familiar knock..."
    n "페리윙클은 익숙한 노크 소리를 기다리며 앞문을 계속 바라보는 자신을 의식합니다."

# game/script.rpy:1643
translate kor ch3_d186408e:

    # w guilty "(The state Pastille would find me in if he were to show up tonight...)"
    w guilty "(오늘밤에 파스틸이 날 봤다면 내 꼴을 보고 뭐라고 생각했을지...)"

# game/script.rpy:1644
translate kor ch3_db6282c6:

    # w empty "...."
    w empty "..."

# game/script.rpy:1645
translate kor ch3_3e0e2f15:

    # w oops "(...I should get in bed.)"
    w oops "(...침대로 가서 자기나 해야겠다.)"

# game/script.rpy:1647
translate kor ch3_f44ca24a:

    # n "But he doesn't. Instead, he buries his face in the cushions and falls asleep..."
    n "하지만 페리윙클은 침대 대신, 쿠션에 얼굴을 파묻고 그대로 잠들어버립니다..."

# game/script.rpy:1658
translate kor ch4_7b49a2da:

    # centered "{w=3}{nw}"
    centered "{w=3}{nw}"

# game/script.rpy:1664
translate kor ch4_646d0d17:

    # n "Periwinkle bolts awake to the sound of a knock on his door."
    n "페리윙클은 문을 두드리는 소리에 잠에서 화들짝 깹니다."

# game/script.rpy:1665
translate kor ch4_442e5a09:

    # w lazy sleepy "(Ugh, what time is it...?)"
    w lazy sleepy "(으, 지금 몇 시야...?)"

# game/script.rpy:1666
translate kor ch4_eddf3c07:

    # n "He rises from the couch and lightly treads over to check who might be visiting him so early in the morning..."
    n "페리윙클은 소파에서 일어나 이런 이른 아침에 대체 누가 자길 방문한 건지 확인하기 위해 총총 뛰어갑니다."

# game/script.rpy:1667
translate kor ch4_451d8daa:

    # w ah "(Ah...)"
    w ah "(아...)"

# game/script.rpy:1669
translate kor ch4_ce446219:

    # "At first, I thought my eyes were playing tricks on me."
    "처음에는 내가 헛것을 보고 있는 게 아닐까 생각했어."

# game/script.rpy:1670
translate kor ch4_16ee5917:

    # "It took several moments to register the fact that Pastille was on my doorstep."
    "파스틸이 내 문 앞에 서 있는 걸 내 머리가 인지하기까지는 시간이 조금 걸렸지."

# game/script.rpy:1671
translate kor ch4_26279968:

    # "The knocking comes again, snapping me out of my stupor."
    "다시 들려오는 노크 소리가 멍해진 나를 깨웠어."

# game/script.rpy:1672
translate kor ch4_c04c89fd:

    # nvl clear
    # w lazy guilty "*ahem* One moment, please~!"
    nvl clear
    w lazy guilty "에헴, 잠시만요~!"

# game/script.rpy:1674
translate kor ch4_f1422f42:

    # n "Periwinkle gathers up the clothes he'd left on the floor and stuffs them out of sight."
    n "페리윙클은 바닥에 던져뒀던 옷가지를 모아 눈에 안 보이는 곳으로 치워버립니다."

# game/script.rpy:1675
translate kor ch4_f6a25d83:

    # n "Next, he scrambles into the bathroom to check his makeup."
    n "그런 다음, 화장실로 후다닥 뛰어가 화장 상태를 확인합니다."

# game/script.rpy:1676
translate kor ch4_18e27ee5:

    # w oh "(Passable, considering the circumstances...)"
    w oh "(상황만 봤을 때 이 정도면 양호한 편이지...)"

# game/script.rpy:1677
translate kor ch4_93c9bcce:

    # n "Wrapping a blanket around his shoulders in an attempt to look half-decent, he finally opens the door..."
    n "조금이라도 더 단정하게 보이려고 담요를 어깨에 두른 페리윙클은 마침내 문을 엽니다."

# game/script.rpy:1683
translate kor ch4_9c6ed696:

    # p "Hi! I took the day off, so I..."
    p "안녕하세요! 오늘은 월차를 내서..."

# game/script.rpy:1684
translate kor ch4_1d0b3106:

    # p ohno2 "Sorry, did I wake you up?"
    p ohno2 "아, 혹시 제가 깨운 건가요? 죄송해요."

# game/script.rpy:1685
translate kor ch4_4ce7e2ad:

    # w decent my "Yes... yes, I had a late night. Um..."
    w decent my "응... 어. 어제 좀 늦게 자서. 음..."

# game/script.rpy:1686
translate kor ch4_6ca14993:

    # w guilty "Come in, come in! I'll be ready in just a moment."
    w guilty "안으로 들어와! 금방 준비할게."

# game/script.rpy:1690
translate kor ch4_09875e01:

    # "Pastille is here."
    "파스틸이 왔어."

# game/script.rpy:1691
translate kor ch4_af7a5d1a:

    # "But WHY is he here--a day off...? Not that he HAS the day off, but that he chose to TAKE it... and then came here...?"
    "근데 왜...? 월차...? 월차를 받은 게 아니라 내고 온 다음... 여기로 왔다니...?"

# game/script.rpy:1692
translate kor ch4_075c02d6:

    # "...Let's just put that aside for now. I need to get dressed."
    "...그 생각은 일단 치워두자. 옷부터 입어야지."

# game/script.rpy:1693
translate kor ch4_76b2fe88:

    # nvl clear
    nvl clear

# game/script.rpy:1696
translate kor ch4_4f79473d:

    # n "Periwinkle scurries back to his bedroom to change, while Pastille waits politely by the door."
    n "페리윙클이 침실로 들어가 옷을 주워입는 동안, 파스틸은 문 앞에서 참을성 있게 기다리고 있습니다."

# game/script.rpy:1698
translate kor ch4_75f30f98:

    # w decent guilty "So, your day off, hm...? And you chose to visit ME? I'm flattered <3"
    w decent guilty "그래, 월차라고...? 그런데 나를 보러 와준 거야? 너무 황송한데 ♥"

# game/script.rpy:1699
translate kor ch4_1fb7729e:

    # p ehe "Well, it's not just to visit... I was hoping to, um... take you on a date?"
    p ehe "아, 그냥 보기만 하려고 온 건 아니고요... 혹시 저랑, 어... 데이트 안 가시겠어요?"

# game/script.rpy:1700
translate kor ch4_e40ce8d7:

    # w my "Ooh, a date~? Usually we've reserved those for dinnertime, haven't we?"
    w my "오오, 데이트라고~? 확실히 평소에는 저녁만 같이 먹었었지?"

# game/script.rpy:1701
translate kor ch4_bd8f092f:

    # p shy "I-I wanted to make up for yesterday."
    p shy "어... 어제 일을 만회하고 싶어서요."

# game/script.rpy:1702
translate kor ch4_072a72f7:

    # p smile "So, if you didn't have any other plans... I was thinking we could just... hang out for a while?"
    p smile "그럼, 다른 예정 없으시다면... 그냥 같이... 시간 보내는 건 어떤가요?"

# game/script.rpy:1703
translate kor ch4_c6dcddca:

    # w oh "Sure. I don't mind, but..."
    w oh "좋아, 상관 없어. 하지만..."

# game/script.rpy:1704
translate kor ch4_dee387e1:

    # w guilty "What exactly is there to make up for, my sweet?"
    w guilty "뭘 만회하려고 하는 건데, 자기?"

# game/script.rpy:1705
translate kor ch4_a90e46d0:

    # p nervous "Y-you know... how I told you not to come back to the shop, even though you only showed up to do me a favor?"
    p nervous "그... 있잖아요... 그냥 절 도와주러 온 것 뿐인데도 제가 가게로 오지 말라고 한 거요."

# game/script.rpy:1706
translate kor ch4_048cc125:

    # w ah "(He... has it completely backwards.)"
    w ah "(얘 완전... 잘못 알고 있는데.)"

# game/script.rpy:1707
translate kor ch4_b8322e5c:

    # n "Periwinkle pokes his head out from the bedroom to look Pastille in the eye."
    n "페리윙클은 파스틸을 대면하기 위해 침실에서 문을 열고 빼꼼 고개를 내밉니다."

# game/script.rpy:1708
translate kor ch4_15e38cb2:

    # w oh "Au contraire, Pastille, I should be the one to apologize for putting you in such an uncomfortable position!"
    w oh "틀린 말씀이야, 파스틸. 그런 불편한 자리에 널 서게 한 나야말로 사과해야 마땅하지!"

# game/script.rpy:1709
translate kor ch4_5d652605:

    # w decline "I shouldn't have shown up unannounced. It wasn't my intention to cause you any ACTUAL discomfort..."
    w decline "내가 미리 얘기도 없이 나타났으면 안 됐어. 너에게 진짜로 불편함을 주려고 했던 의도는 전혀 없었으니까..."

# game/script.rpy:1710
translate kor ch4_96acaede:

    # p ohno2 "N-no, I...! I don't think I clarified my boundaries from the beginning, so..."
    p ohno2 "아... 아니에요, 제가...! 제가 어디까지 해도 되는지에 대해 얘기를 한 적이 없는 것 같으니까..."

# game/script.rpy:1711
translate kor ch4_fd2511e1:

    # p ehe "That's... not your fault at all."
    p ehe "완전히... 페리윙클 잘못은 아니에요."

# game/script.rpy:1712
translate kor ch4_dccde7da:

    # w ah "(Then it seems... everything is fine now?)"
    w ah "(그럼... 이걸로 괜찮아진 건가?)"

# game/script.rpy:1713
translate kor ch4_a8cb5d95:

    # w innocent "Hm~ perhaps I could get to know those boundaries better during our date, then?"
    w innocent "흐음~ 그럼 그 어디까지 해도 되고 안 되는지에 대한 경계는 오늘 데이트에서 차근차근 알아봐야겠네, 안 그래?"

# game/script.rpy:1714
translate kor ch4_f037abcc:

    # p uhoh "Wh-why does it sound suggestive you when you say it...?"
    p uhoh "ㅇ... 왜 페리윙클이 말하니까 그렇게 외설적으로 들리는 거죠...?"

# game/script.rpy:1715
translate kor ch4_f9ad8445:

    # n "Periwinkle retreats back to his room with a smile."
    n "페리윙클은 웃으며 방 안으로 쏙 들어갑니다."

# game/script.rpy:1720
translate kor ch4_7d42dba1:

    # "This boy has truly caught me off guard."
    "이 애는 확실히 예상 밖이란 말이지."

# game/script.rpy:1721
translate kor ch4_aaac7486:

    # "I'm almost frustrated that the spiral of guilt and confusion I lost myself in yesterday could be resolved so quickly..."
    "내가 어제 느꼈던 죄책감과 혼란의 소용돌이가 이렇게 쉽게 누그러질 수 있다니, 화가 날 지경이야..."

# game/script.rpy:1722
translate kor ch4_05d347aa:

    # nvl clear
    # "Ah, that's all it was!"
    nvl clear
    "아, 그게 다였구나!"

# game/script.rpy:1724
translate kor ch4_2325265a:

    # "I had merely been fixating on my mistake. It had nothing to do with Pastille, per se..."
    "난 내 실수에 스스로를 묶어놨던 것 뿐이었구나. 파스틸이랑은 직접적인 관계가 없었다고도 할 수 있지..."

# game/script.rpy:1725
translate kor ch4_3c6c1592:

    # "He just happened to be the one at the center of it, so of course all of my attention was unnecessarily directed toward him."
    "그냥 그 중앙에 우연히 있었을 뿐이니, 당연히 내 관심이 그 쪽으로 치우쳐질 수밖에."

# game/script.rpy:1726
translate kor ch4_0de1a9a6:

    # nvl clear
    # "There's no problem, then!"
    nvl clear
    "그럼 아무 문제 없는 거네!"

# game/script.rpy:1728
translate kor ch4_707ce886:

    # "Which means, as usual, I can enjoy our date to the fullest extent <3"
    "그 말은 즉, 평소처럼 데이트를 최대한 즐길 수 있다는 말이야 ♥"

# game/script.rpy:1729
translate kor ch4_76b2fe88_1:

    # nvl clear
    nvl clear

# game/script.rpy:1735
translate kor ch4_de5012be:

    # w lazy happy "Well, DO tell me where we're headed! I'll need to know if I'm going to pick something to wear."
    w lazy happy "그럼, 어디로 가는지 부디 알려줘! 어딜 가는지 알아야 뭘 입을지 정하지."

# game/script.rpy:1736
translate kor ch4_1310ae91:

    # p oh "Oh, um..."
    p oh "아, 음..."

# game/script.rpy:1737
translate kor ch4_f3d9d02a:

    # p smile "You haven't had breakfast yet, have you? Let's get something to eat first."
    p smile "아직 아침 안 드셨죠? 그럼 먼저 뭐 좀 먹을까요?"

# game/script.rpy:1738
translate kor ch4_126b25dc:

    # w calm "Mm...."
    w calm "흠...."

# game/script.rpy:1739
translate kor ch4_da1157e0:

    # w smile "Actually, could you come in here a moment?"
    w smile "저기, 여기 잠깐 들어와볼래?"

# game/script.rpy:1746
translate kor ch4_a84618d5:

    # p "...Yes?"
    p "...네?"

# game/script.rpy:1747
translate kor ch4_cdf2c363:

    # w lazy innocent "I thought it might be fun to have you choose what outfit I wear!"
    w lazy innocent "내가 뭘 입을지 네가 정해주는 게 재미있을 것 같아서 말이야!"

# game/script.rpy:1748
translate kor ch4_e73fa110:

    # p wha "Ah--um... are you sure?"
    p wha "아... 어... 정말 괜찮으시겠어요?"

# game/script.rpy:1749
translate kor ch4_984480e0:

    # w smile "The clean clothes are in that pile, dear."
    w smile "깨끗한 옷은 저 뭉텅이에 있어, 자기."

# game/script.rpy:1750
translate kor ch4_1acf3f3c:

    # p anxious "O-okay... um...."
    p anxious "아... 알았어요... 어...."

# game/script.rpy:1753
translate kor ch4_62e21cd4:

    # n "Pastille begins to sort through the pile of skirts and dresses, taking extra care to fold the ones he sets aside."
    n "파스틸은 치마와 드레스들을 차곡차곡 개 옆에 치우면서 솎아내기 시작합니다."

# game/script.rpy:1755
translate kor ch4_1ff8d837:

    # p oh "How about... these?"
    p oh "그럼... 이건 어때요?"

# game/script.rpy:1756
translate kor ch4_99abddd9:

    # n "He approaches the folding screen, and holds the clothes out to the side for Periwinkle to take."
