translate kor start_3e500425:

    # w oh "Well, you are, aren't you? Whose fault is it that you share a name with candy?"
    w oh "하지만 너무 귀여운걸. 이름도 사탕이랑 같은 걸로 지어놓고서 말이야."

# game/script.rpy:579
translate kor start_54dcfd58:

    # p shout "Not mine!!"
    p shout "제가 지은 이름 아니거든요!!"

# game/script.rpy:580
translate kor start_bb5f7312:

    # w smile "Still. Do you think those two make a good couple?"
    w smile "그래도. 저 둘이 잘 어울릴 거라고 생각해?"

# game/script.rpy:581
translate kor start_831b1ea7:

    # p flustered2 "How should I know...?!"
    p flustered2 "그걸 제가 어떻게 알아요...!?"

# game/script.rpy:582
translate kor start_b2b6228d:

    # w happy "Just imagine the kind of person I'd go on a date with, and pair them with the other!"
    w happy "그냥 내가 데이트 할 법한 사람을 생각해서 네가 알고 있는 사람이랑 엮어보면 되는 거 아니야?"

# game/script.rpy:583
translate kor start_9fb1f04a:

    # p shy "And what kind of person is that...?"
    p shy "페리윙클이 데이트 할 법한 사람이 어떤 사람인데요...?"

# game/script.rpy:584
