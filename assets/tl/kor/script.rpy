    p happy "아, 좋았어! 딱 맞춰서 시작했네요...."

# game/script.rpy:3825
translate kor ch7_060caff3:

    # w shock "You planned this, too?!" with vpunch
    w shock "이것도 계획한 거야!?" with vpunch

# game/script.rpy:3826
