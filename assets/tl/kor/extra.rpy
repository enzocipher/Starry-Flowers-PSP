    a sure "봤지? 자기가 하고 싶어서 하는 거잖아."

# game/extra.rpy:227
translate kor ex1_b84787f0:

    # w oops "Stop exploiting his kindness...!"
    w oops "파스틸의 친절함을 악용하지 마...!"

# game/extra.rpy:228
translate kor ex1_4ed37b10:

    # p smile "Let me know if there's anything else I can fix for you, ma'am."
    p smile "또 고칠 게 있다면 저한테 알려주세요, 선생님."

# game/extra.rpy:229
translate kor ex1_348687bf:

    # a lol2 "Now that you mention it... I'm sure there were a few other things... I'll be right back!"
    a lol2 "생각해보니까... 고쳐야 하는 물건이 몇 개 더 있었던 거 같은데... 금방 다시 올게!"

# game/extra.rpy:233
translate kor ex1_69bdc642:

    # n "Astragalus takes her repaired lamp and heads into her office to retrieve the next broken object."
    n "아스트라갈루스는 고쳐진 전등을 들고 다음 망가진 물건을 가지고 나오기 위해 사무실로 향합니다."

# game/extra.rpy:235
translate kor ex1_55ef291f:

    # w pout "...."
    w pout "...."

# game/extra.rpy:236
translate kor ex1_d987ce1f:

    # p ehe "Peri... it's really nothing to get upset over. This is just an excuse for us to get to know each other better."
    p ehe "페리... 화낼 필요 없어요. 그냥 저희가 서로를 더 잘 알아갈 핑계일 뿐이니까요."

# game/extra.rpy:237
translate kor ex1_0cd94a1a:

    # w decline "I would rather you not be categorized as a tool in her mind... but, if you insist...."
    w decline "나는 아스트라갈루스가 너를 도구로 생각하지 않았으면 좋겠지만... 네가 그렇게 자처한다면...."

# game/extra.rpy:238
translate kor ex1_8cf86b71:

    # p smile "I'll let her know if she starts asking too much of me. So, no more pouting, okay?"
    p smile "너무 많은 걸 요구하기 시작한다면 제대로 얘기할게요. 그러니까 이제 삐지지 마요, 알겠죠?"

# game/extra.rpy:239
translate kor ex1_9b1bf24b:

    # w shy "...Hmhm, how could I refuse such a gentle command? <3"
    w shy "...후후, 어떻게 이런 정중한 부탁을 거절할 수 있겠어? ♥"

# game/extra.rpy:240
translate kor ex1_bc049cda:

    # p doki "A-as long as you're in a better mood now...."
    p doki "ㅍ... 페리 기분이 더 나아졌다면 된 거겠죠...."

# game/extra.rpy:241
translate kor ex1_51c5f1c4:

    # w love "I am. Besides... it was quite hilarious to hear you call her \"ma'am\" in earnest."
    w love "그럼. 그리고... 네가 진심으로 \"선생님\"이라는 단어를 썼을 때 꽤 웃겼어."

# game/extra.rpy:242
translate kor ex1_7bb2ffcf:

    # p oh "Huh...? She's older than us, isn't she? We should respect our elders."
    p oh "네...? 저희보다 연상이시지 않아요? 어른은 공경해야죠."

# game/extra.rpy:243
translate kor ex1_c77122e3:

    # w happy "Ahaha, Pastille...! If you call her an elder to her face, she'll go absolutely ballistic~!"
    w happy "아하하, 파스틸...! 공경이라는 말을 아스트라갈루스 앞에서 했다가는, 완전 화낼걸~!"

# game/extra.rpy:251
translate kor ex1_e01ac24a:

    # a "Turns out there WERE a few things! I've got 'em right here--"
    a "찾아보니까 더 있더라고! 여기 가져왔는..."

# game/extra.rpy:252
translate kor ex1_a7b03b4f:

    # a lmao "Hm? Oh, look at that, you really DID fix his face! Damn, nice work!"
    a lmao "응? 오, 이것 보소. 벌써 남친 얼굴 고쳐놨네! 잘했어!"

# game/extra.rpy:253
translate kor ex1_1d9f3a18:

    # w happy "Listen, Astragalus~! You'll never guess what Pastille just said! <3"
    w happy "아스트라갈루스, 들어봐~! 방금 파스틸이 무슨 말을 했게? ♥"

# game/extra.rpy:254
translate kor ex1_414b617b:

    # p kyaa "W-wait, you're telling her?! Didn't you just say she'll get mad...?!" with vpunch
    p kyaa "자... 잠깐만요, 말할 거예요!? 방금 말하면 화낼 거라고 하지 않았어요...!?" with vpunch

# game/extra.rpy:255
translate kor ex1_f2e8179c:

    # a annoyed "What am I about to get mad at? Were you saying something behind my back?"
    a annoyed "내가 뭘 화를 내? 혹시 내가 안 보고 있을 때 뒷담이라도 깠어?"

# game/extra.rpy:256
translate kor ex1_096bdb21:

    # p scream "PERI!!! P-please, I'm innocent!!" with vpunch
    p scream "페리!!! 제... 제발요, 전 무고해요!!" with vpunch

# game/extra.rpy:272
translate kor ex2_ffc8e5df:

    # n "Periwinkle walks into Atelier Sweets to pick up Pastille for a date. But instead, he's greeted by an enthusiastic golem..."
    n "페리윙클이 파스틸과 함께 데이트를 가기 위해 아틀리에 과자점으로 들어섭니다. 하지만 파스틸 대신, 혈기왕성한 골렘이 페리윙클을 반깁니다..."

# game/extra.rpy:274
translate kor ex2_428e9253:

    # g "Periwinkle is here! Welcome!!"
    g "페리윙클이 왔다! 안녕하세요!!"

# game/extra.rpy:275
translate kor ex2_790fa654:

    # w happy "Gumdrop~ How lovely to see you. I've come to retrieve my boyfriend <3"
    w happy "검드롭~ 만나서 정말 반가워. 나는 남자친구를 데려가려고 왔어 ♥"

# game/extra.rpy:276
translate kor ex2_6b1c9de1:

    # g smile "Master Pastille is downstairs with Syrup right now! He will return soon if you do not mind waiting."
    g smile "파스틸 주인님이라면 지금 아랫층에 시럽과 함께 있어요! 기다리는 게 괜찮다면 금방 돌아올 거예요."

# game/extra.rpy:277
translate kor ex2_587a64c5:

    # w innocent "Certainly~ I'm in no rush."
    w innocent "그래~ 급할 거 없지."

# game/extra.rpy:278
translate kor ex2_a206cc3a:

    # g "...."
    g "...."

# game/extra.rpy:279
translate kor ex2_699c22c4:

    # w smile "......"
    w smile "......"

# game/extra.rpy:280
translate kor ex2_fd80ae45:

    # g "........"
    g "........"

# game/extra.rpy:281
translate kor ex2_5d731a04:

    # w calm "You aren't one for small talk, are you, Gumdrop?"
    w calm "너 확실히 스몰 토크 하는 성격은 아니구나, 검드롭?"

# game/extra.rpy:282
translate kor ex2_6d783ade:

    # g oh "Small talk...? Yes, I think talking at a normal volume is best."
    g oh "스몰 토크...? 네, 저는 적당히 큰 목소리로 대화하는 게 제일이라고 생각해요."

# game/extra.rpy:283
translate kor ex2_0140899b:

    # w happy "How funny! Pastille's given you quite the sense of humor."
    w happy "재미있어라! 파스틸이 너에게 괜찮은 유머 감각도 준 모양이네."

# game/extra.rpy:284
translate kor ex2_f3bcb407:

    # g yay "Master Pastille is wonderful! I love him very much."
    g yay "파스틸 주인님은 대단해요! 저는 파스틸 주인님을 사랑한답니다."

# game/extra.rpy:285
translate kor ex2_53d7b708:

    # w calm "Hmhm, I feel the same <3"
    w calm "후후, 나도 그래 ♥"

# game/extra.rpy:286
translate kor ex2_3d9a78e9:

    # g happy "He is always so happy when he comes back from visiting you. Thank you for always taking care of him!"
    g happy "페리윙클이랑 만나고 온 파스틸 주인님은 정말 기뻐보여요. 항상 파스틸 주인님을 챙겨주셔서 감사합니다!"

# game/extra.rpy:287
translate kor ex2_2de16658:

    # w drool "Ohh, it's my pleasure~! I was hoping to \"take care of him\" tonight as well...."
    w drool "아, 내가 좋아서 하는 거인걸~! 오늘밤도 파스틸을 \"챙겨줄\" 생각이었는데...."

# game/extra.rpy:288
translate kor ex2_e8d86e39:

    # g yay "Please do! It is fun to watch his face turn pink, like mine!"
    g yay "부디 그래주세요! 파스틸 주인님의 얼굴이 저처럼 분홍색으로 바뀌는 걸 보는 건 재미있어요!"

# game/extra.rpy:290
translate kor ex2_531a8cd8:

    # p "Gumdrop?! What are you telling him...?!" with vpunch
    p "검드롭!? 무슨 말을 하고 있는 거야...!?" with vpunch

# game/extra.rpy:291
translate kor ex2_0e50da78:

    # g "Yes, pink! Just like that!"
    g "네, 분홍색! 지금처럼요!"

# game/extra.rpy:292
translate kor ex2_c3c7c8cb:

    # w innocent "Ahh, there you are, my sweet! Are you ready to spend a lovely evening with me? <3"
    w innocent "아, 거기 있었구나, 자기! 나랑 같이 황홀한 저녁을 맞을 준비는 됐어? ♥"

# game/extra.rpy:293
translate kor ex2_395e0bb5:

    # p flustered "I can't believe I let this happen... you two should never be allowed to speak to each other unsupervised."
    p flustered "이런 일이 일어나게 두다니, 믿을 수가 없네요... 둘은 제가 안 보고 있을 때 대화하지 마세요."

# game/extra.rpy:294
translate kor ex2_5899dd9d:

    # g oh "Oh! If it is not allowed, I will refrain from greeting him next time."
    g oh "아! 만약 말하는 것을 금지하신다면, 다음부터는 페리윙클을 반기지 않을게요."

# game/extra.rpy:295
translate kor ex2_c0a26fd0:

    # w pout "Don't listen to him, Gumdrop. He just doesn't want us trading information."
    w pout "파스틸 말은 무시해, 검드롭. 그냥 우리가 정보를 공유하는 걸 원하지 않는 것 뿐이니까."

# game/extra.rpy:296
translate kor ex2_2d457e9a:

    # w teehee "Please, tell me more about how Pastille acts on the mornings after he's slept over~!"
    w teehee "파스틸이 내 집에서 자고 난 다음날 아침에 돌아와서 어떤 반응을 보이는지 나한테 더 알려줘~!"

# game/extra.rpy:297
translate kor ex2_fbd13c0c:

    # p scream "PERI, NO! W-WE'RE LEAVING, RIGHT NOW!!" with vpunch
    p scream "페리, 안 돼요! 빠... 빨리 가죠, 지금 당장!!" with vpunch

# game/extra.rpy:313
translate kor ex3_fe48e0d0:

    # n "Periwinkle and Pastille are out on a date when they run into a familiar face...."
    n "페리윙클과 파스틸이 데이트를 하던 도중, 익숙한 얼굴을 보게 됩니다...."

# game/extra.rpy:316
translate kor ex3_f8cee923:

    # c "Oh! It's Periwinkle!"
    c "아, 페리윙클이다!"

# game/extra.rpy:317
translate kor ex3_14664804:

    # w date happy "Cassia~! It's been a while, how have you been?"
    w date happy "카시아~! 오랜만이야, 어떻게 지냈어?"

# game/extra.rpy:318
translate kor ex3_3994fb9e:

    # c happy "I've been just perfect! Moving in with my partners went really well~!"
    c happy "정말 완벽한 날들이었어! 파트너들이랑 같이 이사하는 게 정말 잘 풀렸거든~!"

# game/extra.rpy:319
translate kor ex3_7a1f6722:

    # c "Every single night I get to fall asleep while snuggling the both of them <3 Ahh~ life really couldn't be better..."
    c "이제 매일 밤마다 둘 다 껴안고 잘 수 있게 됐어 ♥ 아~ 이것보다 더 좋은 삶은 상상도 안 돼..."

# game/extra.rpy:320
translate kor ex3_960d2e6e:

    # c smile "Anyway, I hope things have been going just as well for you, Periwinkle!"
    c smile "어쨌든, 너도 나만큼 잘 지내고 있었으면 좋겠다, 페리윙클!"

# game/extra.rpy:321
translate kor ex3_cbf92a17:

    # w calm "Hmhm, they have indeed! But first, introductions..."
    w calm "후후, 잘 지내고 있지! 하지만 먼저, 소개부터 제대로 해야겠네..."

# game/extra.rpy:323
translate kor ex3_a20f9be9:

    # w smile "Pastille, this is Cassia! She's a very sweet and cuddly witch, as you've probably gathered."
    w smile "파스틸, 이쪽은 카시아야! 이미 눈치 챘겠지만 정말 친절하고 스킨쉽을 좋아하는 마녀지."

# game/extra.rpy:324
translate kor ex3_b60ee949:

    # p smile "Nice to meet you."
    p smile "만나서 반가워요."

# game/extra.rpy:325
translate kor ex3_6f8559b4:

    # w shy "And Cassia, this is my boyfriend, Pastille! Can you believe I've finally settled down~? <3"
    w shy "그리고 카시아, 이쪽은 내 남자친구 파스틸이야! 내가 드디어 한 명한테 정착했다는 거, 믿기니~? ♥"

# game/extra.rpy:326
translate kor ex3_4557a20f:

    # c oh "*gasp* Really...?! I never would've guessed!"
    c oh "헉... 정말...!? 상상도 못 했어!"

# game/extra.rpy:327
translate kor ex3_a5ce115b:

    # c happy "But, wow...! I'm so happy for you~! You look so cute together~! <3"
    c happy "우와...! 정말 잘됐다~! 너희 둘 정말 잘 어울려~! ♥"

# game/extra.rpy:328
translate kor ex3_b75f7932:

    # w happy "I know, right~? We're a perfect match <3"
    w happy "그렇지~? 완벽한 짝이라고 ♥"

# game/extra.rpy:329
translate kor ex3_43544170:

    # c yay "Hehehe~ I'm so glad I don't have to worry about you anymore, Periwinkle~!"
    c yay "히히히~ 이제 너에 대해서 걱정할 필요가 없어져서 정말 다행이야, 페리윙클~!"

# game/extra.rpy:330
translate kor ex3_f95a126c:

    # c letdown "You always used to be so closed off... it made me want to cuddle you lots and lots, so that you didn't feel lonely."
    c letdown "항상 마음을 닫고 사는 네가 외롭지 않게 많이, 많이 안아주고 싶었거든."

# game/extra.rpy:331
translate kor ex3_56a40746:

    # w ohdear "A-ah, is that how it was...?"
    w ohdear "아... 아, 그랬던 거였니...?"

# game/extra.rpy:332
translate kor ex3_81e3da45:

    # w oops "(To think her affections were only given out of pity...! Is that why she attempted to pull me into her relationship back then...?)"
    w oops "(카시아의 애정이 동정심 때문에 나온 거였다니...! 그래서 저번에 나를 자기 연애관계에 끌어들이려고 했던 건가...?)"

# game/extra.rpy:333
translate kor ex3_9b2a81ef:

    # c happy "I'm glad there was someone out there who could open your heart! Good job, Pastille~!"
    c happy "네 마음을 열어줄 수 있는 사람이 있어서 정말 다행이야! 잘 했어요, 파스틸~!"

# game/extra.rpy:334
translate kor ex3_52394784:

    # p ehe "Haha, it sounds like you tried your best to take care of him. I appreciate it."
    p ehe "하하, 듣고 있으니 카시아 씨도 페리를 챙겨주려고 많이 노력하신 거 같은걸요. 고마워요."

# game/extra.rpy:335
translate kor ex3_c66ef868:

    # c aww "I really did! But he wouldn't let me in at all~! I had to give up in the end."
    c aww "많이 노력했죠! 하지만 페리윙클은 저를 마음에 들여보내주지 않았어요~! 끝내 포기했어야만 했죠."

# game/extra.rpy:336
translate kor ex3_a28ed646:

    # c smile "At least we can be friends now, right Periwinkle~?"
    c smile "그래도 최소한에 친구로 지낼 수 있으니까 괜찮아요. 그치, 페리윙클~?"

# game/extra.rpy:337
translate kor ex3_7600c5d0:

    # w guilty "Yes, of course. I apologize for having worried you so."
    w guilty "그럼, 물론이지. 너에게 걱정을 끼쳐서 정말 미안해."

# game/extra.rpy:338
translate kor ex3_fc8cdb11:

    # c yay "That's okay~! As long as you promise to come over for dinner sometime..."
    c yay "괜찮아~! 언젠가 우리 집에서 같이 저녁 먹기로 약속만 해준다면..."

# game/extra.rpy:339
translate kor ex3_59c08c31:

    # c happy "You can bring Pastille, and it'll be like a double date~! Doesn't that sound fun~?"
    c happy "파스틸도 데려와도 돼, 그럼 더블 데이트 같을 거야~! 재밌을 거 같지 않아~?"

# game/extra.rpy:340
translate kor ex3_68fbdeea:

    # w my "A double date...? That certainly does sound like an entertaining night~!"
    w my "더블 데이트라...? 확실히 재미있을 거 같은 밤이네~!"

# game/extra.rpy:341
translate kor ex3_b66dc322:

    # w innocent "What do you think, Pastille? Will you accompany me to dinner with Cassia and her partners~?"
    w innocent "어때, 파스틸? 카시아랑 파트너들과의 저녁 식사에 나랑 함께 참여하겠어?"

# game/extra.rpy:342
translate kor ex3_192e5d96:

    # p aw "Yeah, that sounds really nice! I'd love to."
    p aw "네, 재밌겠네요! 정말 좋을 것 같아요."

# game/extra.rpy:343
translate kor ex3_3a4507f5:

    # c "Then it's settled~! I have to get back to my errands, but I'll contact you the next time I'm free, okay~?"
    c "그럼 결정이야~! 나는 이제 하던 일 마저 하러 가야 하지만, 나중에 한가해지면 그때 연락할게, 알았지~?"

# game/extra.rpy:344
translate kor ex3_f0f464d6:

    # w happy "Lovely~ <3 It was nice seeing you again~!"
    w happy "멋진데~♥ 다시 보게 되서 반가웠어~!"

# game/extra.rpy:350
translate kor ex3_81cc4f56:

    # p "...Pink hair...."
    p "...분홍 머리...."

# game/extra.rpy:351
translate kor ex3_e82421ec:

    # w date oh "Hm~?"
    w date oh "응~?"

# game/extra.rpy:352
translate kor ex3_b7b1420a:

    # p shy "Oh, nothing. I just noticed... you kinda have a type, don't you?"
    p shy "아, 아니에요. 그냥... 페리도 이상형이 있죠?"

# game/extra.rpy:353
translate kor ex3_7af0f1d5:

    # w love "And what type would that be, exactly?"
    w love "어떤 이상형?"

# game/extra.rpy:354
translate kor ex3_b131b1ec:

    # p ehe "Cute and pink."
    p ehe "귀엽고 분홍색이 어울리는 사람이요."

