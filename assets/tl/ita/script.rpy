    # n "Pastille closes the distance between them..."
    n "Pastille chiude la distanza tra loro..."

# game/script.rpy:3409
translate ita ch6_54a35ace:

    # "I'm too weak."
    "Sono troppo debole."

# game/script.rpy:3410
translate ita ch6_139334f1:

    # "The words won't come out..."
    "Le parole non vogliono uscire..."

# game/script.rpy:3411
translate ita ch6_76b2fe88_10:

    # nvl clear
    nvl clear

# game/script.rpy:3413
translate ita ch6_0f7e6da5:

    # n "As they kiss, Periwinkle becomes more and more entangled in his thoughts..."
    n "Mentre si baciano, Periwinkle diventa sempre più perso nei suoi pensieri..."

# game/script.rpy:3414
translate ita ch6_f42e65a6:

    # "Ahh, it hurts...!"
    "Ahh, fa male...!"

# game/script.rpy:3415
translate ita ch6_d63ae36a:

    # "I want to be even closer...."
    "Voglio essere ancora più vicini...."

# game/script.rpy:3416
translate ita ch6_76b2fe88_11:

    # nvl clear
    nvl clear

# game/script.rpy:3418
translate ita ch6_341a3f02:

    # n "He lets himself fall backward, bringing Pastille down with him."
    n "Si lascia cadere all'indietro, portando Pastille con sé."

# game/script.rpy:3419
translate ita ch6_443d47e5:

    # "This isn't nearly enough to satisfy me..."
    "Non è neache lontanamente abbastanza per soddisfarmi..."

# game/script.rpy:3420
translate ita ch6_c8df87cf:

    # "Just, please, don't stop...."
    "Solo, ti prego, non fermarti...."

# game/script.rpy:3421
translate ita ch6_76b2fe88_12:

    # nvl clear
    nvl clear

# game/script.rpy:3425
translate ita ch6_cb671a59:

    # n "Periwinkle's heart cried out..."
    n "Il cuore di Periwinkle si lamentò..."

# game/script.rpy:3426
translate ita ch6_a66018f1:

    # n "His jumbled emotions caught in his throat, manifesting through his hands, clinging desperately to Pastille..."
    n "{size=-2}Le sue emozioni confuse gli causavano un nodo alla gola, e si manifestavano attraverso le sue mani, aggrappandosi disperatamente a Pastille...{/size}"

# game/script.rpy:3427
translate ita ch6_5f6ba41c:

    # n "...who continued to kiss him and hold him through the night."
    n "...che continuò a baciarlo e abbracciarlo per tutta la notte."

# game/script.rpy:3438
translate ita ch7_7b49a2da:

    # centered "{w=3}{nw}"
    centered "{w=3}{nw}"

# game/script.rpy:3443
translate ita ch7_6f509ab8:

    # n "The next morning, Periwinkle steps out onto his doorstep with a heavy sigh."
    n "La mattina dopo, Periwinkle esce di casa con un grosso sospiro."

# game/script.rpy:3445
translate ita ch7_a6ad8caa:

    # w hood empty "(If I lay around in bed all day, I'll only feel more miserable...)"
    w hood empty "(Se me ne sto a letto tutto il giorno, mi sentirò ancora peggio...)"

# game/script.rpy:3446
translate ita ch7_bfb25d37:

    # w oops "(I need to stop avoiding my work. I have to talk to Astragalus....)"
    w oops "(Devo smetterla di evitare il lavoro. Devo parlare con Astragalus....)"

# game/script.rpy:3447
translate ita ch7_3eb69f61:

    # w empty "(She isn't going to be pleased with me though....)"
    w empty "(Non ne sarà contenta però...)"

# game/script.rpy:3449
translate ita ch7_c0771f75:

    # n "Holding his mantle tightly, he makes his way to the apothecary..."
    n "Tenendo stretto il suo mantello, si incammina verso la farmacia..."

# game/script.rpy:3457
translate ita ch7_ec45006e:

    # n "When he arrives, Astragalus is preoccupied with arranging some of her merchandise."
    n "Quando arriva, Astragalus è occupata a sistemare alcuni articoli."

# game/script.rpy:3458
translate ita ch7_2eb737f5:

    # n "She turns abruptly at the unexpected sound of the door's chime."
    n "Si gira bruscamente non appena sente il suono improvviso della campanella."

# game/script.rpy:3461
translate ita ch7_23102229:

    # a augh "Hey, we're not open yet--!" with vpunch
    a augh "Hey, non siamo ancora aperti--!" with vpunch

# game/script.rpy:3463
translate ita ch7_21ae3d6f:

    # a hm "...Huh? Periwinkle?"
    a hm "...Huh? Periwinkle?"

# game/script.rpy:3464
translate ita ch7_0cfdf83c:

    # w hood decline "Good morning, Astragalus."
    w hood decline "Buongiorno, Astragalus."

# game/script.rpy:3465
translate ita ch7_ca42047f:

    # a uh "I haven't seen you all month--I barely recognized you under that hood!"
    a uh "Non ti sei fatto vedere per tutto il mese--quasi non ti riconoscevo con quel mantello!"

# game/script.rpy:3466
translate ita ch7_a59d0c89:

    # a augh "I was about to come and knock on your damn door if you didn't show your face here soon. You've got a huge backlog of orders waiting!"
    a augh "Sarei venuta a bussare sulla tua cazzo di porta se non ti fossi fatto vedere. Hai un sacco di ordini arretrati!"

# game/script.rpy:3467
translate ita ch7_6328fc6a:

    # w empty "...I can't take them. My magic is useless."
    w empty "...Non posso completarli. La mia magia è rotta."

# game/script.rpy:3468
translate ita ch7_709a7b6c:

    # a uh "Whaddaya mean, \"useless\"?"
    a uh "Che significa, \"rotta\"?"

# game/script.rpy:3469
translate ita ch7_78308c9b:

    # n "Periwinkle meekly hands over one of his pale pink vials."
    n "Periwinkle porge umilmente una delle sue bottiglie di liquido roseo."

# game/script.rpy:3470
translate ita ch7_e6a68b87:

    # w ohhh "This is all I can make... it's been this way for ages."
    w ohhh "Questo è tutto quello che riesco a produrre... è così da un secolo."

# game/script.rpy:3471
translate ita ch7_c42de9e7:

    # a whatever "*sigh* Let's see..."
    a whatever "*sigh* Vediamo..."

# game/script.rpy:3472
translate ita ch7_60a7f254:

    # n "Astragalus unscrews the top, and eyes Periwinkle suspiciously before giving it a whiff..."
    n "Astragalus svita il tappo, e guarda Periwinkle sospettosamente prima di annusare..."

# game/script.rpy:3473
translate ita ch7_0d690c65:

    # a uh "Whew, that's powerful!!" with vpunch
    a uh "Whew, è forte!!" with vpunch

# game/script.rpy:3474
translate ita ch7_2b253749:

    # a think "Not bad, though... warms me right up. Could stand to be diluted a little, just to make it less overwhelming..."
    a think "Non male, però... mi scalda proprio. Sarebbe meglio diluirlo un pochino, solo per renderlo meno intenso..."

# game/script.rpy:3475
translate ita ch7_40f53860:

    # a lol "So. What's got you stuck on a scent like this?"
    a lol "Quindi. Cos'è che ti ha fatto rimanere bloccato su un aroma del genere."

# game/script.rpy:3476
translate ita ch7_de42c61a:

    # w ohhh2 "...It's Pastille...."
    w ohhh2 "...È Pastille...."

# game/script.rpy:3477
translate ita ch7_0381a0e1:

    # w whine2 "He's ruined me! I'll never be able to return to the way I was before...!"
    w whine2 "Mi ha rovinato! Non riuscirò mai a tornare come prima...!"

# game/script.rpy:3478
translate ita ch7_4bd0f1d4:

    # a closed "I see. So things got complicated, just like I warned you."
    a closed "Capisco. Quindi le cose si sono complicate, proprio come ti avevo avvertito."

# game/script.rpy:3479
translate ita ch7_1fb3e795:

    # w cwy "Mhm... *sniffle*..."
    w cwy "Mhm... *sniff*..."

# game/script.rpy:3480
translate ita ch7_6be39aa2:

    # w cwy2 "I-I love him so much, I think I might die...."
    w cwy2 "L-lo amo così tanto, che potrei morire...."

# game/script.rpy:3481
translate ita ch7_48204255:

    # a neutral "Come on... Back room. Now."
    a neutral "Vieni... Stanza sul retro. Adesso."

# game/script.rpy:3485
translate ita ch7_7d77e570:

    # n "Periwinkle nods and obediently follows Astragalus into her private office..."
    n "Periwinkle annuisce e segue Astragalus obbedientemente nel suo ufficio privato..."

# game/script.rpy:3490
translate ita ch7_1be0328f:

    # n "He quietly takes in his surroundings before she suddenly turns to him with a raised finger."
    n "Si abitua silenziosamente all'ambiente prima che lei si giri verso di lui con un dito alzato."

# game/script.rpy:3492
translate ita ch7_170b612d:

    # a "Don't touch anything."
    a "Non toccare nulla."

# game/script.rpy:3493
translate ita ch7_90a8c977:

    # w hood ohhh "...?"
    w hood ohhh "...?"

# game/script.rpy:3495
translate ita ch7_020bb483:

    # n "Astragalus drags a bean bag chair out from the corner and plops it in the middle of the room unceremoniously."
    n "Astragalus prende un pouf da dietro l'angolo e lo sbatte in mezzo alla stanza in maniera brusca."

# game/script.rpy:3497
translate ita ch7_507ec09a:

    # a "Sit."
    a "Siediti."

# game/script.rpy:3498
translate ita ch7_e6ea4d0e:

    # w hood ohhh "...It's dusty...."
    w hood ohhh "...È pieno di polvere...."

# game/script.rpy:3499
translate ita ch7_44201857:

    # a augh "UGH, you're such a diva..."
    a augh "UGH, sei proprio una primadonna..."

# game/script.rpy:3500
translate ita ch7_c4c193b3:

    # n "She gives it a couple good smacks, beating the dust into the air instead."
    n "Dà un paio di colpi al pouf, facendo saltare via la polvere."

# game/script.rpy:3501
translate ita ch7_c411bd45:

    # a annoyed "...NOW sit."
    a annoyed "...ORA siediti."

# game/script.rpy:3502
translate ita ch7_ca9dcc70:

    # w oops "Very well...."
    w oops "Molto bene...."

# game/script.rpy:3505
translate ita ch7_86603b28:

    # n "He complies, and Astragalus spins her office chair around to face him."
    n "Si siede, e Astragalus gira la sua sedia da ufficio in modo da poterlo guardare in faccia."

# game/script.rpy:3508
translate ita ch7_46e11470:

    # a "Alright, Periwinkle. Here's what's gonna happen."
    a "E va bene, Periwinkle. Ecco cosa succederà."

# game/script.rpy:3509
translate ita ch7_89a00474:

    # a "I'm gonna brew us up some tea, and you're gonna explain everything. From the beginning."
    a "Preparerò del tè, e mi spiegherai tutto. Dall'inizio."

# game/script.rpy:3510
translate ita ch7_0ccf1ed0:

    # w hood sorry "Explain what...?"
    w hood sorry "Spiegare cosa...?"

# game/script.rpy:3511
translate ita ch7_0e7a98bb:

    # a "About Pastille. Even the stuff I already know. Everything, from the top."
    a "Su Pastille. Anche le cose che so già. Tutto, dall'inizio."

# game/script.rpy:3512
translate ita ch7_30cf76fb:

    # w ohhh "Everything...?"
    w ohhh "Tutto...?"

# game/script.rpy:3513
translate ita ch7_4f05ba39:

    # a "Skip the bedroom details, obviously. Just walk me through anything important that happened since you met."
    a "Salta i dettagli sul sesso, ovviamente. Parlami di tutto ciò di importante che è successo dal vostro primo incontro."

# game/script.rpy:3514
translate ita ch7_c147a5e1:

    # w whine "I-I don't want to! Reliving it all is only going to make things worse...!"
    w whine "I-io non voglio! Rivivere tutto peggiorerà solamente le cose...!"

# game/script.rpy:3517
translate ita ch7_d617b2fd:

    # n "Astragalus stands and walks over to her kettle to start the tea."
    n "Astragalus si alza e si avvicina alla teiera per preparare il tè."

# game/script.rpy:3519
translate ita ch7_c88d1b30:

    # a "Alright, you lovesick dolt..."
    a "Ok, zuccone innamorato..."

# game/script.rpy:3520
translate ita ch7_95976d4b:

    # a annoyed "You wanna know why exactly your magic's been stuck like that? It's because you don't have an outlet for all those emotions."
    a annoyed "Vuoi sapere il motivo esatto per cui la tua magia è bloccata in quello stato? È perché non hai un modo di sfogare quelle emozioni."

# game/script.rpy:3521
translate ita ch7_ea89bd51:

    # a closed "Instead, you keep bottling them up--literally, I guess. It's all that comes out because it's all there is inside you."
    a closed "Invece, continui a imbottigliarle--letteralmente, suppongo."
    a "È tutto quello che esce dalla tua bacchetta perché è tutto quello che hai dentro."

# game/script.rpy:3522
translate ita ch7_61f43815:

    # w hood ohhh "...."
    w hood ohhh "...."

# game/script.rpy:3523
translate ita ch7_4d08edac:

    # a lol2 "So, let it all out! What, you think I'm gonna judge you?"
    a lol2 "Quindi, sfogati! Di cosa hai paura, credi che io possa giudicarti?"

# game/script.rpy:3524
translate ita ch7_0e405e25:

    # w oops "No... I don't know."
    w oops "No... non lo so."

# game/script.rpy:3525
translate ita ch7_a2f71b21:

    # a lol "Would you rather spill it all to him instead?"
    a lol "Preferiresti raccontare tutto a lui?"

# game/script.rpy:3526
translate ita ch7_237d6381:

    # w cwy "I can't...! It's too much!"
    w cwy "Non posso...! È troppo!"

# game/script.rpy:3527
translate ita ch7_61ef0d5e:

    # a sure "Then tell it to me, a neutral third party."
    a sure "Allora dillo a me, una terza parte neutrale."

# game/script.rpy:3528
translate ita ch7_5df175e3:

    # a uh "Actually, I can't say that I'm neutral... I'd need to find a new supplier if you couldn't fill my orders anymore."
    a uh "In realtà, non posso dire di essere neutrale... dovrei trovarmi un nuovo fornitore se tu non potessi più completare i miei ordini."

# game/script.rpy:3529
translate ita ch7_3a7ea07c:

    # w oops "I do feel a little more at ease imagining this is all a business matter for you...."
    w oops "Mi sento un po' meglio pensando a tutto questo come un incontro d'affari...."

# game/script.rpy:3530
translate ita ch7_969f721a:

    # a smile "Then just think of it like that."
    a smile "Allora immaginalo così."

# game/script.rpy:3532
translate ita ch7_e9b2e9b2:

    # n "Astragalus pours their tea and returns to her seat with two mugs in hand."
    n "Astragalus versa il tè e torna a sedersi con due tazze in mano."

# game/script.rpy:3533
translate ita ch7_a98ff37d:

    # n "With a heavy sigh, Periwinkle finally relents and begins his story..."
    n "Con un profondo sospiro, Periwinkle finalmente si arrende e inizia a raccontare tutto..."

# game/script.rpy:3539
translate ita ch7_d30066c5:

    # "I told her everything I could think of..."
    "Le dissi tutto quello che mi veniva in mente..."

# game/script.rpy:3540
translate ita ch7_33d9f84f:

    # "My first impressions of him. How he continuously subverted my expectations."
    "La mia prima impressione di lui. Come ha sempre superato le mie aspettative."

# game/script.rpy:3541
translate ita ch7_c5f52926:

    # "My mistakes. Appearing where I shouldn't have, then going into a desperate spiral as I tried to rid myself of the guilt over it."
    "I miei errori. L'essere apparso nel posto sbagliato, per poi discendere una spirale di disperazione cercando i liberarmi dai sensi di colpa."

# game/script.rpy:3542
translate ita ch7_1bbf690f:

    # "How he was the one to come to apologize afterward..."
    "Come fu lui a scusarsi alla fine..."

# game/script.rpy:3543
translate ita ch7_c5838a34:

    # nvl clear
    # "Our date that day, which was so, so wonderful... but which also laid bare the feelings I was too afraid to acknowledge."
    nvl clear
    "Il nostro appuntamente di quel giorno, che fu così, così magnifico... ma che mise anche a nudo i sentimenti che avevo troppa paura di accettare."

# game/script.rpy:3545
translate ita ch7_e6e49546:

    # "How I latched on to any alternative explanation I could in order to escape them."
    "Come mi aggrappai ad ogni spiegazione alternativa possibile per evitarli."

# game/script.rpy:3546
translate ita ch7_4e84de73:

    nvl clear
    # "The moment I could finally admit it to myself. All the ways he'd changed my life for the better."
    "Il momento in cui riuscii finalmente ad ammetterlo a me stesso. Tutte le cose che lui ha migliorato nella mia vita."

# game/script.rpy:3547
translate ita ch7_6a07a020:

    # "How we grew closer and closer, while I held those feelings tighter to my chest..."
    "Come diventammo sempre più vicini, mentre tenevo quei sentimenti stretti al petto..."

# game/script.rpy:3548
translate ita ch7_d4484d1e:

    # nvl clear
    # "I told her how he had finally worked up the courage to introduce me to his friends."
    nvl clear
    "Le dissi di come riuscii finalmente a raccogliere il coraggio di presentarmi ai suoi amici."

# game/script.rpy:3550
translate ita ch7_65da988b:

    # "How his hand trembled in mine as we walked out the door together."
    "Come le sue mani tremarono nelle mie mentre uscivamo dalla porta del negozio."

# game/script.rpy:3551
translate ita ch7_ee6b35c9:

    # "This point of contention, a far-off goal I had decided would have to be met before advancing..."
    "Quel punto di contesa, un obiettivo lontano che avevo deciso di raggiungere prima di far avanzare le cose..."

# game/script.rpy:3552
translate ita ch7_ca54ab44:

    # "Everything, up to the state I'm in now. Useless, paralyzed, and sobbing."
    "Tutto, fino al mio stato attuale."

# game/script.rpy:3553
translate ita ch7_92f40e14:

    # nvl clear
    # "Astragalus listened patiently through all of it."
    nvl clear
    "Astragalus ascoltò tutto con pazienza."

# game/script.rpy:3555
translate ita ch7_343d2423:

    # "She asked questions from time to time. Clarification on the timeframe, certain details..."
    "A volte faceva domande. Chiarimenti sul tempo, alcuni dettagli..."

# game/script.rpy:3556
translate ita ch7_87e644fe:

    # "Her reaffirming comments offered such comfort, such relief to this pain I'd kept confined to my own heart."
    "I suoi commenti rassicuranti mi offrirono così tanto conforto, un sollievo per questo dolore che avevo sigillato nel mio cuore."

# game/script.rpy:3557
translate ita ch7_b69014f7:

    # "Until finally, I had nothing left to say."
    "Finché finalmente, non avevo altro da dire."

# game/script.rpy:3558
translate ita ch7_d27b4990:

    # nvl clear
    # n "Astragalus sits back in her chair and heaves a sigh."
    nvl clear
    n "Astragalus sprofonda nella sua sedia e sospira."

# game/script.rpy:3562
translate ita ch7_a8670c2a:

    # a "So? How are you feeling?"
    a "Allora? Come ti senti?"

# game/script.rpy:3563
translate ita ch7_04d072f1:

    # w hood oh2 "There's a certain clarity in laying it all out at once..."
    w hood oh2 "C'è una certa trasparenza nel dire tutto in una volta..."

# game/script.rpy:3564
translate ita ch7_547bdb80:

    # w ohhh "But, I still... don't know what I can do to push things forward... could I even handle the rejection...?"
    w ohhh "Ma, ancora... non so come far andare avanti le cose... potrei sopportare il rifiuto...?"

# game/script.rpy:3565
translate ita ch7_a359177e:

    # a eyeroll "He won't reject you."
    a eyeroll "Non ti rifiuterà."

# game/script.rpy:3566
translate ita ch7_229785e7:

    # w sorry "What makes you so certain...?"
    w sorry "Come fai ad esserne certa...?"

# game/script.rpy:3567
translate ita ch7_47ddd304:

    # a lmao "That boy is madly in love with you!! Why else would he devote all that time and energy to making you happy?"
    a lmao "Quel ragazzo è follemente innamorato di te!! Per quale altro motivo avrebbe dedicato tutto quel tempo e quelle energie a renderti felice?"

# game/script.rpy:3568
translate ita ch7_a282e00e:

    # w pout "Because I'm great in bed! Obviously!!" with vpunch
    w pout "Perché sono bravissimo a letto! Ovvio!!" with vpunch

# game/script.rpy:3569
translate ita ch7_7d78d80b:

    # a lol2 "Quit deflecting! You know that's not all it is."
    a lol2 "Smettila di deviare! Sai che non è solo quello."

# game/script.rpy:3570
translate ita ch7_c44bc880:

    # w nofair2 "I don't want to leave any room for doubt... if I were to confess now, and it didn't go well, I'd... I'd be destroyed beyond repair!"
    w nofair2 "Non voglio avere alcun dubbio... se dichiarassi i miei sentimenti ora, e non andasse bene, io... sarei totalmente distrutto!"

# game/script.rpy:3571
translate ita ch7_699f61db:

    # w nofair "That's why, if I'm going to say it, I want it to be a sure thing."
    w nofair "Per questo, se devo dirlo, voglio essere sicuro."

# game/script.rpy:3572
translate ita ch7_70aa9f4c:

    # a sure "Life ain't about \"sure things\"."
    a sure "La vita non è fatta di cose \"sicure\"."

# game/script.rpy:3573
translate ita ch7_1ce1b2b1:

    # w oops "Even so. I'm going to wait for the opportune moment before exposing my vulnerable heart...."
    w oops "Fa lo stesso. Aspetterò il momento opportuno prima di esporre il mio fragile cuoricino...."

# game/script.rpy:3574
translate ita ch7_67d2fe6a:

    # a eyeroll "As long as you've got a plan."
    a eyeroll "Finché hai un piano."

# game/script.rpy:3576
translate ita ch7_5c6e9d30:

    # n "Astragalus leans down to pick up Periwinkle's empty mug, then holds it out in front of him."
    n "Astragalus si abbassa per raccogliere la tazza di Periwinkle, e poi gliela porge."

# game/script.rpy:3577
translate ita ch7_05b45148:

    # a happy "Try your magic again. Whatever scent you want, just pour it right in the cup."
    a happy "Prova ad usare la tua magia ora. Qualunque aroma vuoi, versalo nella tazza."

# game/script.rpy:3578
translate ita ch7_61f43815_1:

    # w hood ohhh "...."
    w hood ohhh "...."

# game/script.rpy:3582
translate ita ch7_bffebb26:

    # n "Periwinkle nervously draws his wand, holds it out to the cup... then closes his eyes, and taps."
    n "Periwinkle afferra la bacchetta nervosamente, la tiene verso la tazza... chiude gli occhi, e le dà un colpetto."

# game/script.rpy:3585
translate ita ch7_62bd9f4e:

    # w hood ohhh2 "...Is it...?"
    w hood ohhh2 "...È...?"

# game/script.rpy:3586
translate ita ch7_31d796dc:

    # a "...."
    a "...."

# game/script.rpy:3587
translate ita ch7_a378f6db:

    # a hm "Chamomile?"
    a hm "Camomilla?"

# game/script.rpy:3588
translate ita ch7_a5fd1669:

    # w my "It isn't peach...!"
    w my "Non è pesca...!"

# game/script.rpy:3589
translate ita ch7_48779aee:

    # w happy "I-I'm cured!!" with vpunch
    w happy "M-mi hai curato!!" with vpunch

# game/script.rpy:3590
translate ita ch7_c8bd051e:

    # a lol2 "Yeah, dumbass! Did you forget this is an apothecary?"
    a lol2 "Sì, coglione! Ti sei forse dimenticato che questa è una farmacia?"

# game/script.rpy:3591
translate ita ch7_15718a3f:

    # w ohdear "Ah... it is, isn't it...."
    w ohdear "Ah... già, vero...."

# game/script.rpy:3592
translate ita ch7_21466243:

    # a eyeroll "Next time you've got a problem with your magic, don't sit around crying about it on your own. Come straight to me, and I'll fix you up."
    a eyeroll "La prossima volta che hai un problema con la magia, non startene a casa a piangere da solo. Vieni dritto dritto da me, ti sistemerò io."

# game/script.rpy:3593
translate ita ch7_ba5c6de9:

    # w love "Thank you... I..."
    w love "Grazie... io..."

# game/script.rpy:3594
translate ita ch7_44e91ae4:

    # w shy "I'm truly glad that we're friends... I would be lost without you."
    w shy "Sono davvero contento che siamo amici... sarei perso senza di te."

# game/script.rpy:3595
translate ita ch7_4ffcdd35:

    # a sure "Business associates. Don't forget I've got loads of orders for you now that you're back to normal."
    a sure "Soci d'affari. Non dimenticarti che hai un sacco di ordini da completare ora che sei tornato normale."

# game/script.rpy:3596
translate ita ch7_b19f23d3:

    # w happy "I'll go home and fill them right away! But first..."
    w happy "Andro a casa e mi metterò subito a lavoro! Ma prima..."

# game/script.rpy:3597
translate ita ch7_9d2c05b0:

    # w love "May I hug you?"
    w love "Posso abbracciarti?"

# game/script.rpy:3598
translate ita ch7_04792b09:

    # a augh "Not a chance!" with vpunch
    a augh "Neanche per sogno!" with vpunch

# game/script.rpy:3599
translate ita ch7_d733da0f:

    # w teehee "Hmhm, it was worth a shot. You'll accept my platonic affection one day~!"
    w teehee "Hmhm, valeva la pena provare. Un giorno accetterai il mio affetto~!"

# game/script.rpy:3600
translate ita ch7_7f7593b0:

    # a happy "Yeah, yeah... get outta my office, Periwinkle."
    a happy "Sì, sì... fuori dal mio ufficio, Periwinkle."

# game/script.rpy:3607
translate ita ch7_875a28a9:

    # n "The pair exits the back room, but they only make it a few steps out before Periwinkle turns on his heel."
    n "Il duo esce dalla stanza, ma dopo pochi passi Periwinkle si gira."

# game/script.rpy:3608
translate ita ch7_4d17f35d:

    # w hood oh "Ah, one more thing, before I go..."
    w hood oh "Ah, un'ultima cosa, prima che vada..."

# game/script.rpy:3610
translate ita ch7_3f808ca6:

    # a "Hm? What's up."
    a "Hm? Che c'è."

# game/script.rpy:3611
translate ita ch7_faf56b4e:

    # w smile "I've been curious to ask. The last time I was here, you told me that magic can be interpreted as a judge of one's character..."
    w smile "Ero curioso di chiederti una cosa--"
    w "L'ultima volta che sono stato qui, hai detto che la magia può aiutare a capire la personalità di qualcuno..."

# game/script.rpy:3612
translate ita ch7_09ac5a27:

    # a think "Oh, right. When I changed my mind about Pastille."
    a think "Oh, giusto. Quando ho cambiato idea su Pastille."

# game/script.rpy:3613
translate ita ch7_e02f8699:

    # w calm "Yes, precisely. It's rather impressive that you could see through to his true nature, despite having only just met..."
    w calm "Sì, precisamente. È impressionante che tu sia riuscita a capire la sua vera natura, nonostante vi foste appena incontrati..."

# game/script.rpy:3614
translate ita ch7_d75c0f1f:

    # a lol "Sure, but he was pretty easy to read. Don't be too impressed."
    a lol "Già, ma lui era abbastanza semplice da leggere. Non stupirti troppo."

# game/script.rpy:3615
translate ita ch7_7bba75e2:

    # w love "...Well?"
    w love "...Beh?"

# game/script.rpy:3616
translate ita ch7_21235aed:

    # a lol2 "Well what?"
    a lol2 "Beh cosa?"

# game/script.rpy:3617
translate ita ch7_665ef7a8:

    # w happy "What does my magic say about me~? I'm dying to know 💙"
    w happy "Che cosa dice la mia magia su di me? Muoio dalla voglia di saperlo 💙"

# game/script.rpy:3618
translate ita ch7_f33dfb60:

    # a sure "YOUR magic... was always lively and carefree. Compassionate, too. Like Pastille's."
    a sure "La tua magia... è sempre stata vivace e spensierata. Come quella di Pastille."

# game/script.rpy:3619
translate ita ch7_08b17c47:

    # w love "How can you possibly read something like \"carefree\" from perfume?"
    w love "Come fai a leggere qualcosa come \"spensierato\" da del semplice profumo?"

# game/script.rpy:3620
translate ita ch7_e94ff0db:

    # a lol "Hey, I'm just telling you the vibes I've gotten over the years."
    a lol "Hey, ti sto solo descrivendo le vibrazioni che mi hai dato negli anni."

# game/script.rpy:3621
translate ita ch7_a2de6d44:

    # a think "Your aromas prioritize pleasure. But there was definitely a hint of loneliness in them, too..."
    a think "I tuoi aromi danno la priorità al piacere. Ma hanno anche un tocco di solitudine..."

# game/script.rpy:3622
translate ita ch7_d8043053:

    # w teehee "Alright, now I KNOW you're making things up. I've always had someone to keep me company 💙"
    w teehee "Ok, ora SO che ti stai inventando le cose. Ho sempre avuto qualcuno che mi tenesse compagnia 💙"

# game/script.rpy:3623
translate ita ch7_15310979:

    # a smile "Just because you've always got someone around doesn't mean you can't be lonely."
    a smile "Avere qualcuno vicino non vuol dire che non puoi sentirti solo."

# game/script.rpy:3624
translate ita ch7_c61d8bb7:

    # w calm "And I suppose someone like you would know a thing or two about loneliness, hm?"
    w calm "E suppongo che qualcuno come te sappia due cosette sulla solitudine, hm?"

# game/script.rpy:3625
translate ita ch7_c94c969b:

    # a hm "I'm not lonely at all. In fact, I PREFER to be alone."
    a hm "Non mi sento affatto sola. Anzi, PREFERISCO esserlo."

# game/script.rpy:3626
translate ita ch7_adf9c46f:

    # a closed "YOU on the other hand... can't stand it even for a second. That's why you'd always run off chasing someone to fill the void."
    a closed "TU d'altra parte... non riesci a sopportarlo nemmeno per un secondo. Per questo correvi sempre dietro a qualcuno per riempire il vuoto."

# game/script.rpy:3627
translate ita ch7_cd947219:

    # w ohdear "...Well THAT certainly isn't true."
    w ohdear "...Beh non è AFFATTO vero."

# game/script.rpy:3628
translate ita ch7_be244ae7:

    # a lol "The peach stuff you gave me earlier was PURE loneliness. It was crying out, like \"Please, Pastille, never leave me~!\""
    a lol "La roba alla pesca che mi hai dato prima era solitudine PURA. Stava piangendo, tipo \"Per favore, Pastille, non lasciarmi mai~!\""

# game/script.rpy:3629
translate ita ch7_27338eed:

    # w pout "This isn't fun anymore. Forget that I asked!"
    w pout "Non è più divertente. Dimentica quello che ti ho chiesto!"

# game/script.rpy:3630
translate ita ch7_11cf638a:

    # a happy "Sorry. Couldn't resist."
    a happy "Scusa. Non sono riuscita a resistere."

# game/script.rpy:3631
translate ita ch7_7623f766:

    # w oops "...."
    w oops "...."

# game/script.rpy:3632
translate ita ch7_b80c39a5:

    # w ohhh "I suppose you're right, though... I haven't been able to tell him that in words."
    w ohhh "Immagino tu abbia ragione, però... non sono riuscito a dirglielo a parole."

# game/script.rpy:3633
translate ita ch7_ad5bdd9e:

    # w nofair2 "I can't keep holding back... he has to know. No matter the outcome."
    w nofair2 "Non posso continuare a trattenermi... deve saperlo. Non importa quale sarà il risultato."

# game/script.rpy:3634
translate ita ch7_60359fd7:

    # a smile "Good luck, okay? I'm sure it'll turn out just fine."
    a smile "Buona fortuna, okay? Sono sicura che andrà tutto bene."

# game/script.rpy:3635
translate ita ch7_a4d8dbdf:

    # w ohhh "Yes... yes, it likely will."
    w ohhh "Sì... sì, probabilmente sarà così."

# game/script.rpy:3636
translate ita ch7_0f7a9daf:

    # w shy "Thank you again... I'm truly grateful for all that you've done for me."
    w shy "Grazie ancora... sono davvero grato per tutto quello che hai fatto per me."

# game/script.rpy:3641
translate ita ch7_47504267:

    # n "Astragalus waves him off, and Periwinkle leaves the apothecary with new resolve..."
    n "Astragalus lo saluta, e Periwinkle lascia la farmacia rinvigorito..."

# game/script.rpy:3651
translate ita ch7_8954e2f7:

    # "I spent the next several days catching up on my work."
    "Passai i giorni seguenti a portarmi in pari col lavoro."

# game/script.rpy:3652
translate ita ch7_c124ee6b:

    # "Magic truly does come so easily with a clear mind! If only I'd swallowed my pride sooner."
    "La magia esce così facilmente con la mente sgombra! Se solo avessi ingoiato prima il mio orgoglio."

# game/script.rpy:3653
translate ita ch7_1e30c6c5:

    nvl clear
    # "I completed batch after batch almost effortlessly, going down the long checklist Astragalus had given me..."
    "Ho riempito ordine dopo ordine senza alcuno sforzo, completando la lunga lista di Astragalus..."

# game/script.rpy:3654
translate ita ch7_ba772060:

    # "I hadn't even felt tired by the end of it. As if all this energy had been stored up inside me all along!"
    "Non mi sentivo nemmeno stanco alla fine. Come se fosse tutta energia che avevo tenuto dentro di me!"

# game/script.rpy:3655
translate ita ch7_2d728c30:

    # nvl clear
    # "It was a relief to return to somewhat normalcy."
    nvl clear
    "Era un sollievo tornare ad una quasi-normalità."

# game/script.rpy:3657
translate ita ch7_e65838f7:

    # "Thinking of Pastille no longer caused my heart to ache... at least, not enough to put me in a state of total despondence."
    "Pensare a Pastille non mi faceva più male al cuore... o almeno, non abbastanza da lanciarmi nello sconforto totale."

# game/script.rpy:3658
translate ita ch7_b8bdf17b:

    # "Instead, those thoughts served as motivation. The way forward was clear."
    "Invece, quei pensieri mi motivavano. Il da farsi era chiaro."

# game/script.rpy:3659
translate ita ch7_975f7c4e:

    # "I would tell him how I felt... and surely..."
    "Dovevo dirgli come mi sentivo... e sicuramente..."

# game/script.rpy:3660
translate ita ch7_38f5635f:

    # nvl clear
    # w pj calm "Surely things will turn out just fine...."
    nvl clear
    w pj calm "Sicuramente le cose andranno bene...."

# game/script.rpy:3665
translate ita ch7_94b11f24:

    # n "The following night... Pastille shows up on Periwinkle's doorstep."
    n "La sera seguente... Pastille si presenta alla porta di Periwinkle."

# game/script.rpy:3667
translate ita ch7_1810d3ec:

    # p "Get dressed. I wanna take you somewhere."
    p "Vestiti. Voglio portarti in un posto."

# game/script.rpy:3668
translate ita ch7_89d40548:

    # w pj happy "Oh~ and where exactly am I being whisked away to? 💙"
    w pj happy "Oh~ e qual è la destinazione esattamente? 💙"

# game/script.rpy:3669
translate ita ch7_f5ebb1d6:

    # p happy "You'll see. Wear comfortable shoes, okay?"
    p happy "Vedrai. Mettiti delle scarpe comode, okay?"

# game/script.rpy:3670
translate ita ch7_cd6c9ac9:

    # w calm "How mysterious..."
    w calm "Che misterioso..."

# game/script.rpy:3671
translate ita ch7_c60adcac:

    # w smile "Hmhm, very well. I'll be ready momentarily 💙"
    w smile "Hmhm, molto bene. Sarò pronto a momenti 💙"

# game/script.rpy:3674
translate ita ch7_98348ebf:

    # "This is it..."
    "Eccoci..."

# game/script.rpy:3675
translate ita ch7_09cbb0da:

    # "The dramatic confession scene is upon us!"
    "Manca poco alla scena della confessione drammatica!"

# game/script.rpy:3676
translate ita ch7_e135b4c9:

    # "I have to look my best! For good luck, of course."
    "Dovrò apparire al meglio! Per buon auspicio, ovviamente."

# game/script.rpy:3677
translate ita ch7_572f99bc:

    # "And for confidence...."
    "E per l'autostima...."

# game/script.rpy:3678
translate ita ch7_76b2fe88:

    # nvl clear
    nvl clear

# game/script.rpy:3690
translate ita ch7_28d525bc:

    # n "Hand in hand, the pair makes their way to the train station."
    n "Mano nella mano, il duo arriva alla stazione dei treni."

# game/script.rpy:3691
translate ita ch7_931bcf8a:

    # w cute innocent "(Hmhm~ had he been planning something while I was sequestered away with my work?)"
    w cute innocent "(Hmhm~ Stava pianificando qualcosa mentre ero occupato col lavoro?)"

# game/script.rpy:3692
translate ita ch7_db582720:

    # w love "(Pastille is always so full of surprises... how positively delightful 💙)"
    w love "(Pastille è sempre pieno di sorprese... assolutamente delizioso 💙)"

# game/script.rpy:3695
translate ita ch7_b5146a9c:

    # p "I hope I didn't interrupt any plans you had for the night...."
    p "Spero di non aver interrotto i tuoi piani per la serata...."

# game/script.rpy:3696
translate ita ch7_028375c7:

    # w happy "Oh, not at all~! It was about time I got out of the house again."
    w happy "Oh, per niente~! Era ora che uscissi nuovamente di casa."

# game/script.rpy:3697
translate ita ch7_dd0f85ec:

    # w smile "I've actually had a very productive past several days, you know. Toiling away over my perfumes."
    w smile "In realtà gli ultimi giorni sono stati molto produttivi. Li ho passati a lavorare ai miei profumi."

# game/script.rpy:3698
translate ita ch7_dcf1b0e8:

    # p ehe "Haha, I thought that might be the case, since you hadn't dropped by in a while."
    p ehe "Haha, pensavo fosse così, dato che era un po' che non ti facevi vedere."

# game/script.rpy:3699
translate ita ch7_fb3a840a:

    # w innocent "Did you miss me? 💙"
    w innocent "Ti sono mancato? 💙"

# game/script.rpy:3700
translate ita ch7_13104245:

    # p embarrassed "W-well...."
    p embarrassed "B-beh...."

# game/script.rpy:3702
translate ita ch7_b1056d27:

    # n "Periwinkle hugs Pastille's arm tightly as they continue their walk."
    n "Periwinkle stringe forte il braccio di Pastille mentre continuano la loro passeggiata."

# game/script.rpy:3703
translate ita ch7_9e455bb5:

    # w cute shy "(I missed you, too...)"
    w cute shy "(Mi sei mancato anche tu...)"

# game/script.rpy:3706
translate ita ch7_92a9892d:

    # "When Pastille and I step off the train, we're greeted by grassy fields and a sky full of luminous stars."
    "Quando io e Pastille scendiamo dal treno, siamo accolti da campi erbosi e un cielo stellato."

# game/script.rpy:3707
translate ita ch7_1242c23a:

    # "Just where has he taken me...?"
    "Ma dove mi avrà portato...?"

# game/script.rpy:3708
translate ita ch7_924bc4f2:

    # "A trail of lanterns lights the lone path forward..."
    "Una scia di lanterne illumina il sentiero dinanzi a loro..."

# game/script.rpy:3709
translate ita ch7_27428714:

    # "Pastille takes the lead."
    "Pastille fa strada."

# game/script.rpy:3710
translate ita ch7_76b2fe88_1:

    # nvl clear
    nvl clear

# game/script.rpy:3713
translate ita ch7_794d51f4:

    # p "It's a bit of a walk from here... but I promise it'll be worth it."
    p "È un po' lontano... ma ti prometto che ne varrà la pena."

# game/script.rpy:3714
translate ita ch7_dd9f0107:

    # w cute love "A long walk, hm? Couldn't we take a ride on your broom together~?"
    w cute love "Lontano, hm? Non potremmo andarci insieme sulla tua scopa~?"

# game/script.rpy:3715
translate ita ch7_6e405e15:

    # p sure "Nah, it'd defeat the purpose. It'll feel more rewarding getting there on foot."
    p sure "Nah, rovinerebbe la sorpresa. Sarà più gratificante arrivarci a piedi."

# game/script.rpy:3716
translate ita ch7_ebba887b:

    # w calm "Hmhm... fair enough. Tragic, though, that you'd willingly pass on an opportunity for me to cling to you."
    w calm "Hmhm... giusto. Tragico, però, che sei disposto a rinunciare all'opportunità di sentire che mi aggrappo a te."

# game/script.rpy:3717
translate ita ch7_34a0afcc:

    # p ehe "Haha, we can fly on the way back if you want."
    p ehe "Haha, possiamo volare al ritorno se vuoi."

# game/script.rpy:3719
translate ita ch7_4f263e5f:

    # n "Pastille offers his hand again, which Periwinkle takes with a smile."
    n "Pastille porge la mano, che Periwinkle prende con un sorriso."

# game/script.rpy:3724
translate ita ch7_59ddd814:

    # w "...Tell me more about your relationship with magic."
    w "...Dimmi di più sulla tua relazione con la magia."

# game/script.rpy:3725
translate ita ch7_2528ce76:

    # p "Hm? What do you mean?"
    p "Hm? Che vuoi dire?"

# game/script.rpy:3726
translate ita ch7_3c167982:

    # w "It was the same when we cleaned my house together. You insisted on doing things manually..."
    w "Anche quando hai pulito casa mia. Hai voluto farlo manualmente..."

# game/script.rpy:3727
translate ita ch7_7c5e0bd7:

    # w "Not that I minded at all. Seeing you lift so many heavy things was a treat in itself 💙"
    w "Non che mi sia dispiaciuto. Vederti sollevare così tante cose pesanti è stata una delizia 💙"

# game/script.rpy:3728
translate ita ch7_4caf8895:

    # p "Hahaha, well..."
    p "Hahaha, beh..."

# game/script.rpy:3729
translate ita ch7_10f7805a:

    # p "Ever since I was young... it was clear I was, um... \"ridiculously talented\", as they'd put it."
    p "Sin da quando ero piccolo... era chiaro che fossi, um... \"assurdamente talentuoso\", parole loro."

# game/script.rpy:3730
translate ita ch7_e85247dc:

    # p "My moms wanted me to be a traditional witch. They enrolled me in one of the top schools, so I could learn from the best."
    p "Le mie due mamme volevano diventassi una strega tradizionale."
    p "Mi iscrissero ad una delle migliori scuole, così che potessi imparare dai migliori."

# game/script.rpy:3732
translate ita ch7_0b59e908:

    # p "I-it was an all-girls school, though... Guess I was young enough that no one realized I was a boy."
    p "E-era una scuola per ragazze, però... Suppongo che quando ero piccolo nessuno avesse capito fossi un ragazzo."

# game/script.rpy:3733
translate ita ch7_c1703821:

    # p "I really... didn't belong there. On any level."
    p "Non... appartenevo a quel luogo. Affatto."

# game/script.rpy:3734
translate ita ch7_fa8d2d79:

    # p "But, I kept at it as long as I could. Just enough to keep my parents happy, until I could go out and live on my own."
    p "Ma, ci rimasi il più possibile. Abbastanza per rendere i miei genitori felici, finché non fui in grado di andare a vivere da solo."

# game/script.rpy:3736
translate ita ch7_73d8e924:

    # p "Haha, I still don't understand exactly why... but I always felt uncomfortable using my magic."
    p "Haha, non capisco ancora il perché... ma mi sono sempre sentito a disagio ad usare la mia magia."

# game/script.rpy:3737
translate ita ch7_b1a584dd:

    # p "It felt like cheating. Like... this kind of power shouldn't come so easily."
    p "Era come barare. Come... se questo tipo di potere non dovesse essere così facile da ottenere."

# game/script.rpy:3738
translate ita ch7_f94b0797:

    # p "Sy thought so, too. I guess that's why I latched onto her when we met..."
    p "Anche Sy lo pensava. Quindi immagino sia per questo che legai con lei quando ci incontrammo."

# game/script.rpy:3739
translate ita ch7_b940b2af:

    # p "She used to really hate magic. Which worked out perfectly for me--it was a good excuse to pretend to be a regular human like her."
    p "Odiava davvero la magia. Cosa che a me andava più che bene--era una scusa per far finta di essere un semplice umano come lei."

# game/script.rpy:3740
translate ita ch7_e058bb72:

    # p "So... that's what I did. For the past... seven years?"
    p "Quindi... ho fatto così. Per gli ultimi... sette anni?"

# game/script.rpy:3743
translate ita ch7_fe2bf237:

    # w cute my "Seven years... that's quite a long time!"
    w cute my "Sette anni... è molto tempo!"

# game/script.rpy:3745
translate ita ch7_4d057338:

    # p "Yeah, but there was a lot to distract me back then... it took a while to get Atelier Sweets up and running."
    p "Già, ma avevo un sacco di distrazioni al tempo... ci volle un po' per metter in piedi l'Atelier Sweets."

# game/script.rpy:3746
translate ita ch7_dc3c7909:

    # p calm "And... Sy did eventually find out. I thought she'd disown me when she did..."
    p calm "E... Sy alla fine lo scoprì. Pensavo che mi avrebbe cacciato..."

# game/script.rpy:3747
translate ita ch7_c13fd2df:

    # p ehe "But instead... she told me I shouldn't have hid it. Even though I doubt we would've become friends if I told her from the beginning..."
    p ehe "Ma invece... mi disse che non avrei dovuto nasconderglielo."
