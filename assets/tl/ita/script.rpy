    n "Lancia il suo cappello da qualche parte e collassa sul divano."

# game/script.rpy:1640
translate ita ch3_bcd66a5f:

    # w lazy oops "(Ugh... I feel even more miserable than before.)"
    w lazy oops "(Ugh... mi sento anche peggio di prima.)"

