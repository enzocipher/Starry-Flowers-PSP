# game/script.rpy:371
translate ita start_3670944d:

    # "He was so delightfully flustered. Which, of course, only made him that much cuter..."
    "Era così deliziosamente imbarazzato. Cosa che, ovviamente, non ha fatto altro che renderlo ancora più carino ai miei occhi..."

# game/script.rpy:372
translate ita start_3201de99:

    # "When I told him to meet me here, he could only manage to nod in response."
    "Quando gli ho detto di incontrarmi qui, è riuscito soltanto ad annuire come risposta."

# game/script.rpy:373
translate ita start_de85fd75:

    # nvl clear
    # w happy "(So cute... ah, my favorite type to pursue!)"
    nvl clear
    w happy "(Troppo carino... ah, il mio tipo preferito!)"

# game/script.rpy:376
translate ita start_fbd81c6f:

    # w smile "(Ah! There he is now~)"
    w smile "(Ah! Eccolo che arriva~)"

# game/script.rpy:385
translate ita start_3578f0d2:

    # p ehe "Hey! I hope I didn't keep you waiting too long..."
    p ehe "Hey! Spero di non averti fatto aspettare troppo..."

# game/script.rpy:386
translate ita start_db24a8d5:

    # w my "Pastille! Look at you~"
    w my "Pastille! Ma guardati~"

# game/script.rpy:387
translate ita start_f197d905:

    # w happy "And here I thought you looked plenty good in that uniform! My heart was unprepared 💙"
    w happy "E pensare che credevo stessi già benissimo con quell'uniforme addosso! Il mio cuore non era pronto 💙"

# game/script.rpy:388
translate ita start_5b504872:

    # p ohno "S-sorry, is it too much? I can change..."
    p ohno "M-mi dispiace, è troppo? Posso sempre cambiarmi..."

# game/script.rpy:389
translate ita start_ee51ebde:

    # w drool "My, but I haven't even fully seen what's under that cloak of yours! It'd be such a waste to change prematurely..."
    w drool "Cielo, non ho nemmeno visto cosa c'è sotto quel tuo mantello! Sarebbe proprio uno spreco cambiarsi così presto..."

# game/script.rpy:390
translate ita start_1f1b24bf:

    # p shy "Ah... r-right! Forget it, then."
    p shy "Ah... g-già! Fa nulla, allora."

# game/script.rpy:391
translate ita start_ebcee129:

    # w calm "Besides..."
    w calm "D'altronde..."

# game/script.rpy:392
translate ita start_fa697933:

    # w teehee "It'll be my pleasure to unwrap you later on, my sweet 💙"
    w teehee "Sarà un mio piacere scartarti più tardi, dolcezza 💙"

# game/script.rpy:393
translate ita start_31907a91:

    # p kyaa "A-AH...!" with vpunch
    p kyaa "A-AH...!" with vpunch

# game/script.rpy:394
translate ita start_308ba70d:

    # w innocent "Now, shall we head to dinner?"
    w innocent "Ora, andiamo a cena?"

# game/script.rpy:395
