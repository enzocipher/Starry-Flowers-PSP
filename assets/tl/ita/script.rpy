# game/script.rpy:3946
translate ita ch7_1c5f0457:

    # "This beautiful place, that Pastille chose just for us..."
    "Questo posto bellissimo, che Pastille ha scelto solo per noi..."

# game/script.rpy:3947
translate ita ch7_bc3b2ea7:

    # "I can't have my memory of this perfect night obscured by tears...."
    "Non posso lasciare che il ricordo di questa serata perfetta sia oscurato dalle lacrime...."

