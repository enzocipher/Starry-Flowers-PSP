    # w guilty "Come in, come in! I'll be ready in just a moment."
    w guilty "Entra, entra! Un momento e sono pronto."

# game/script.rpy:1690
translate ita ch4_09875e01:

    # "Pastille is here."
    "Pastille è qui."

# game/script.rpy:1691
translate ita ch4_af7a5d1a:

    # "But WHY is he here--a day off...? Not that he HAS the day off, but that he chose to TAKE it... and then came here...?"
    "Ma PERCHÈ è qui--un giorno libero...? E non è che HA il giorno libero, ha scelto di PRENDERSENE uno... e poi è venuto qui...?"

# game/script.rpy:1692
