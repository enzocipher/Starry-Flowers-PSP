    # centered "{w=3}{nw}"
    centered "{w=3}{nw}"

# game/script.rpy:727
translate ita ch2_420c2aa2:

    # "It took me ages to get out of bed that morning."
    "Ci misi una vita ad alzarmi dal letto quella mattina."

# game/script.rpy:728
translate ita ch2_d9e096c6:

    # "After all... I just couldn't stop thinking about how absolutely adorable Pastille was! 💙"
    "Dopotutto... non riuscivo a smettere di pensare a quanto fosse stato adorabile Pastille! 💙"

# game/script.rpy:729
translate ita ch2_7c711ce7:

    # "He scrambled out of here almost as soon as he woke up, saying he couldn't be late for work..."
    "È corso via appena si è svegliato, dicendo che non poteva fare tardi a lavoro..."

# game/script.rpy:730
translate ita ch2_e5f82cff:

    nvl clear
    # "Such a shame. Would've been nice to get one last round in~"
    "Proprio un peccato. Mi sarebbe piaciuto un ultimo round~"

# game/script.rpy:731
translate ita ch2_a69cdafc:

    # "...I did get a kiss goodbye, though 💙"
    "...Ho ricevuto un bacio d'addio, però 💙"

# game/script.rpy:732
translate ita ch2_79c07e86:

    # nvl clear
    # w bed shy "Ahh, it's nice to feel like a housewife for a moment~"
    nvl clear
    w bed shy "Ahh, è bello sentirsi come una casalinga per un momento~"

# game/script.rpy:734
translate ita ch2_369e7bdd:

    # w smile "But I should get to work, too..."
    w smile "Ma anche io dovrei mettermi al lavoro..."

# game/script.rpy:735
translate ita ch2_a95a50d1:

    # w happy "I have an order to fill, don't I~?"
    w happy "Ho un ordine da completare, giusto~?"

# game/script.rpy:738
translate ita ch2_3c76f5d0:

    # n "Periwinkle finally rolls out of bed and gets ready for the day..."
    n "Finalmente Periwinkle si alza dal letto e si prepara per la giornata..."

# game/script.rpy:741
translate ita ch2_5a13e7e9:

    # "The order in question is for a nearby apothecary."
    "L'ordine in questione è per una farmacia nelle vicinanze."

# game/script.rpy:742
translate ita ch2_35f25f34:

    # "Did you know? Aromagic like mine is actually quite good for you~"
    "Lo sapevate? L'aromagia in realtà ha diversi effetti salutari~"

# game/script.rpy:743
translate ita ch2_8f79525a:

    # "It's got nothing on actual healing magic, but the calming atmosphere it creates does wonders for one's mood."
    "Non si avvicina neanche alla magia di cura, ma l'atmosfera che crea fa miracoli per l'umore."

# game/script.rpy:744
translate ita ch2_48c6a187:

    # nvl clear
    # "This particular batch is meant to help with insomnia..."
    nvl clear
    "Questo lotto in particolare dovrebbe aiutare contro l'insonnia..."

# game/script.rpy:746
translate ita ch2_9bdec3ec:

    # "Which is ironic, considering how late I stayed up with Pastille 💙"
    "Ironico, considerando fino a che ora sono stato sveglio insieme a Pastille 💙"

# game/script.rpy:747
translate ita ch2_e22fb32a:

    # nvl clear
    # w pj teehee "Whoops, can't be getting distracted now~ I really need to finish up these last few bottles..."
    nvl clear
    w pj teehee "Whoops, non posso distrarmi adesso~ Devo assolutamente riempire queste ultime bottiglie..."

# game/script.rpy:750
translate ita ch2_e708ef33:

    # w calm "{nw}"
    w calm "{nw}"

# game/script.rpy:751
translate ita ch2_2dd620a3:

    # n "Periwinkle closes his eyes and draws his wand."
    n "Periwinkle chiude gli occhi e afferra la sua bacchetta."

# game/script.rpy:753
translate ita ch2_3425d8a6:

    # n "Large drops form at its tip, falling into the empty bottle one by one."
    n "Grosse gocce si formano sulla punta, e infine cadono nella bottiglia vuota una alla volta."

# game/script.rpy:754
translate ita ch2_3222c5b9:

    # n "With each drip, the bottle's contents swell, and after only the fifth drop, it's completely filled."
    n "Con ogni goccia, il contenuto della bottiglia cresce, e dopo soltanto la quinta, è completamente piena."

# game/script.rpy:757
translate ita ch2_fbaed311:

    # w innocent "Perfect! Ahh, it's so much easier to finish these with a clear mind..."
    w innocent "Perfetto! Ahh, è molto più semplice finirle con la mente sgombra..."

# game/script.rpy:758
translate ita ch2_6e325112:

    # w shy "I can't help it if a refreshing night out is the only way to regain my focus 💙"
    w shy "Non posso farci nulla se una rinfrescante serata fuori è l'unico modo che ho per concentrarmi 💙"

# game/script.rpy:759
translate ita ch2_afd133a7:

    # w teehee "Although~ I probably could've gotten one of these done last night if Pastille hadn't been so impatient... 💙"
    w teehee "Anche se~ Probabilmente avrei potuto riempirne una la scorsa notte se Pastille non fosse stato così impaziente... 💙"

# game/script.rpy:760
translate ita ch2_44174832:

    # w calm "No, no, mustn't let my mind wander too far from work now."
    w calm "No, no, non posso distrarmi dal lavoro ora."

# game/script.rpy:762
translate ita ch2_67507517:

    # n "Periwinkle fills the remaining bottles, screwing the lids on as he goes."
    n "Periwinkle riempie le bottiglie rimaste, e poi avvita i rispettivi tappi."

# game/script.rpy:764
translate ita ch2_5bd5f285:

    # w smile "There. Hmhm, now my house is going to smell like lavender..."
    w smile "Ecco fatto. Hmhm, ora la casa profumerà di lavanda..."

# game/script.rpy:765
translate ita ch2_8bdf90ac:

    # w innocent "I'd better head out before I'm lulled to sleep by my own magic~"
    w innocent "Sarà meglio uscire prima che la mia stessa magia mi faccia addormentare~"

# game/script.rpy:779
translate ita ch2_85bf7599:

    # "The apothecary is only a short walk away, but I've never managed to walk in its doors on time."
    "La farmacia dista pochi minuti a piedi, ma non sono mai riuscito ad arrivare in orario."

# game/script.rpy:780
translate ita ch2_bd4b3ec4:

    # "Perhaps because it's so close, I always underestimate the time it takes to reach it..."
    "Forse dato che è così vicina, sottovaluto sempre il tempo che ci vuole per raggiungerla..."

# game/script.rpy:781
translate ita ch2_3b3d6df9:

    # "I can hear the owner tapping her foot with impatience as soon as I open the door."
    "Non appena apro la porta, posso sentire la proprietaria battere il piede a terra con impazienza."

# game/script.rpy:782
translate ita ch2_76b2fe88:

    # nvl clear
    nvl clear

# game/script.rpy:785
translate ita ch2_a74c124f:

    # w happy "Astragalus~! I have that special order ready for you~"
    w happy "Astragalus~! Quel tuo ordine speciale è pronto~"

# game/script.rpy:786
translate ita ch2_318b7805:

    # a annoyed "You're late again, Periwinkle."
    a annoyed "Sei di nuovo in ritardo, Periwinkle."

# game/script.rpy:787
translate ita ch2_1019ebc0:

    # w innocent "Lost track of time 💙 You'll forgive me, won't you~?"
    w innocent "Ho perso la cognizione del tempo 💙 Mi perdonerai, non è vero~?"

# game/script.rpy:788
translate ita ch2_7862874c:

    # a "You are literally my only provider who has no respect for appointments."
    a "Sei letteralmente il mio unico fornitore che non ha alcun rispetto per gli appuntamenti."

# game/script.rpy:789
translate ita ch2_2fb8a6f9:

    # w oh "That's simply not true! I never miss a date."
    w oh "Questa è una bugia bella e buona! Non manco mai agli appuntamenti."

# game/script.rpy:790
translate ita ch2_acda7219:

    # a lol "There's the problem. You were out getting laid again, weren't you?"
    a lol "Ed ecco lì il problema. Eri di nuovo fuori a scopare, non è vero?"

# game/script.rpy:791
translate ita ch2_dbeacd97:

    # w pout "How vulgar~ I had a romantic evening with a VERY cute boy..."
    w pout "Ma che volgare~ Ho condiviso una serata romantica con un ragazzo MOLTO carino..."

# game/script.rpy:792
translate ita ch2_d7ebcbc7:

    # w innocent "Who then ended up sleeping over 💙"
    w innocent "Che poi ha dormito da me 💙"

# game/script.rpy:793
translate ita ch2_facdd2e0:

    # a whatever "Well, you had all week to fill the order. Try getting it done in advance next time."
    a whatever "Beh, hai avuto l'intera settimana per completare l'ordine. Prova a finirlo prima la prossima volta."

# game/script.rpy:794
translate ita ch2_8de08278:

    # w calm "Yes, ma'am~"
    w calm "Sissignora~"

# game/script.rpy:795
translate ita ch2_e220bd55:

    # a closed "Now let's see what you brought..."
    a closed "Ora vediamo che cosa mi hai portato..."

# game/script.rpy:797
translate ita ch2_6aa2ff6b:

    # "I've worked with Astragalus for a few years now."
    "Lavoro con Astragalus da un paio d'anni ormai."

# game/script.rpy:798
translate ita ch2_88aee593:

    # "She's COMPLETLY immune to my charms. Shocking, to say the least."
    "È COMPLETAMENTE immune al mio carisma. Scioccante, a dir poco."

# game/script.rpy:799
translate ita ch2_f1139fde:

    # "But it's meant we've been able to remain good friends all this time~"
    "Ma grazie a ciò siamo rimasti buoni amici per tutto questo tempo~"

# game/script.rpy:800
translate ita ch2_4fc199f3:

    # "Or... hm. Let's see..."
    "O almeno... hm. Vediamo..."

# game/script.rpy:801
translate ita ch2_76b2fe88_1:

    # nvl clear
    nvl clear

# game/script.rpy:804
translate ita ch2_2c3696be:

    # w oh "Astragalus. Would you consider us to be good friends?"
    w oh "Astragalus. Tu ci considereresti buoni amici?"

# game/script.rpy:805
translate ita ch2_c86bbb5c:

    # a whatever "I put up with you."
    a whatever "Ti sopporto."

# game/script.rpy:806
translate ita ch2_373f7314:

    # w happy "My, but you don't put up with ANYONE! You must really like me 💙"
    w happy "Cielo, eppure tu non sopporti NESSUNO! Devo proprio piacerti 💙"

# game/script.rpy:807
translate ita ch2_47067d4c:

    # a lol "You got a favor to ask or something? Is that what you're getting at?"
    a lol "Devi chiedermi un favore per caso? È questo il motivo della domanda?"

# game/script.rpy:808
translate ita ch2_df3d1bd8:

    # w calm "No, I was just thinking of how to categorize our relationship."
    w calm "No, stavo solo pensando a come chiamare il nostro rapporto."

# game/script.rpy:809
translate ita ch2_72e2a8ac:

    # a "\"Business associate\" works just fine, doesn't it?"
    a "\"Soci d'affari\" va più che bene, non trovi?"

# game/script.rpy:810
translate ita ch2_5f78763b:

    # w happy "Come now, surely you consider us to be closer than that!"
    w happy "Eddai, sicuramente ci consideri più intimi di così!"

# game/script.rpy:811
translate ita ch2_ce50824a:

    # a sure "I know better than to get involved with you, Periwinkle."
    a sure "Non sono così ingenua da farmi coinvolgere nelle tue cose, Periwinkle."

# game/script.rpy:812
translate ita ch2_17ce8a61:

    # w my "Why, whatever do you mean?"
    w my "Oh, che cosa intendi?"

# game/script.rpy:813
translate ita ch2_0ac87123:

    # a whatever "You're too dazzling."
    a whatever "Sei troppo \"abbagliante\""

# game/script.rpy:814
translate ita ch2_4a6eea27:

    # w innocent "I take that as a compliment~"
    w innocent "Lo prenderò come un complimento~"

# game/script.rpy:815
translate ita ch2_d60255a0:

    # a annoyed "Great, now will you stop distracting me? I'm trying to count."
    a annoyed "Grande, ora la smetti di distrarmi? Sto contando."

# game/script.rpy:817
translate ita ch2_8c4a5641:

    # "Yes, we're definitely good friends."
    "Sì, siamo ottimi amici."

# game/script.rpy:818
translate ita ch2_9ecc4a32:

    # "\"Too dazzling\" though... I'm not sure there IS such a thing."
    "\"Troppo abbagliante\" però... non credo nemmeno che ESISTA una cosa del genere."

# game/script.rpy:819
translate ita ch2_82c90c4f:

    # "And what would be wrong with it if there was? What point is there in not shining as brightly as one can?"
    "E cosa ci sarebbe di sbagliato se esistesse? Che senso c'è nel non brillare il più possibile?"

# game/script.rpy:820
translate ita ch2_d0dcce99:

    # "Astragalus finishes counting the bottles, sighing in feigned exasperation as she marks them off her checklist..."
    "Astragalus finisce di contare le bottiglie, e sospira esasperata mentre le spunta dalla sua lista..."

# game/script.rpy:821
translate ita ch2_529b0ff5:

    # nvl clear
    # a sure "You may always be late... but you deliver quality every time. You're consistent, if nothing else."
    nvl clear
    a sure "Sarai anche sempre in ritardo... ma consegni roba di qualità ogni volta. Sei consistente, se non altro."

# game/script.rpy:824
translate ita ch2_389bf1e7:

    # w teehee "The waiting is part of the fun. It builds excitement, wouldn't you say?"
    w teehee "L'attesa è parte del divertimento. Fa crescere l'emozione, non trovi?"

# game/script.rpy:825
translate ita ch2_2f490664:

    # a whatever "Nope, just builds frustration for me. But at least you always come through."
    a whatever "Nah, a me crea solo frustrazione. Ma almeno col lavoro te la cavi sempre."

# game/script.rpy:827
translate ita ch2_4251ed12:

    # n "She unlocks a small drawer behind the counter, and takes out an envelope with Periwinkle's name scribbled on it."
    n "Astragalus apre un piccolo cassetto dietro di lei, e ne tira fuori una busta col nome di Periwinkle scarabocchiato sopra."

# game/script.rpy:829
translate ita ch2_9104554e:

    # a closed "Here's the rest of your payment. Don't spend it all in one place."
    a closed "Ecco qui il resto della tua paga. Non spenderlo tutto in una volta."

# game/script.rpy:830
translate ita ch2_338d50e7:

    # w calm "Oh, I couldn't if I tried! Really, you're too generous..."
    w calm "Oh, non ci riuscirei neanche volendo! Davvero, sei troppo generosa..."

# game/script.rpy:833
translate ita ch2_8daa5982:

    # n "Astragalus rolls her eyes and begins stocking the shelves with her new inventory."
    n "Astragalus alza gli occhi al cielo e inizia a mettere via le bottiglie sulle sue mensole."

# game/script.rpy:835
translate ita ch2_ffbdbe6c:

    # "Two or three orders a month... that's all it takes to support myself, entirely through this apothecary."
    "Due o tre ordini al mese... basta questo per supportarmi economicamente, tutto grazie a questa farmacia."

# game/script.rpy:836
translate ita ch2_ba2406db:

    # "Hard to believe my magic is really worth so much, but who am I to complain?"
    "È difficile credere che la mia magia valga davvero così tanto, ma non me ne lamento mica."

# game/script.rpy:837
translate ita ch2_acb5044d:

    # "It's certainly a more favorable balance compared to the kind of work I was doing years ago."
    "È certamente un salario preferible a quello del lavoro che praticavo anni fa."

# game/script.rpy:838
translate ita ch2_7acd925f:

    # nvl clear
    # "And I do enjoy the freedom, the excessive amounts of time I have for partying, for dates..."
    nvl clear
    "E adoro la libertà, Le quantità eccessive di tempo libero che ho per far festa, per gli appuntamenti..."

# game/script.rpy:840
translate ita ch2_a2058868:

    # "Ah, on that note~"
    "Ah, a proposito~"

# game/script.rpy:841
translate ita ch2_0b1b7e93:

    # nvl clear
    # w happy "With all that business out of the way... would you like to hear about my date? 💙"
    nvl clear
    w happy "Con gli affari conclusi... ti piacerebbe sapere del mio appuntamento? 💙"

# game/script.rpy:844
translate ita ch2_fa857f5d:

    # a sure "Would I LIKE to? Not necessarily."
    a sure "Mi PIACEREBBE? Non per forza."

# game/script.rpy:845
translate ita ch2_95d8347d:

    # w teehee "Please, Astragalus, as someone with no romance in your OWN life, the least you can do is live vicariously through me~"
    w teehee "Eddai, Astragalus, essendo la TUA vita priva di romanticismo, il minimo che puoi fare è viverlo attraverso i miei racconti~"

# game/script.rpy:846
translate ita ch2_8be11c8d:

    # a whatever "The no romance thing is by choice. I listen to you gush for your own damn sake."
    a whatever "Priva di romanticismo per scelta, prego. Ti ascolto solo e soltanto per il tuo bene."

# game/script.rpy:847
translate ita ch2_66b3a391:

    # w my "For MY sake?"
    w my "Per il MIO bene?"

# game/script.rpy:848
translate ita ch2_e2b9789b:

    # a sure "Yeah, I'm afraid you might actually implode if you had no one to talk to about this stuff."
    a sure "Già, ho paura che potresti implodere se non avessi nessuno con cui parlare di questa roba."

# game/script.rpy:849
translate ita ch2_fdfc2ccd:

    # a lol "I'm actually making a noble sacrifice every day that you come in here with new tales of romantic conquest."
    a lol "Compio un nobile sacrificio ogni volta che entri qui dentro con nuove storie di conquiste romantiche."

# game/script.rpy:850
translate ita ch2_b3b6ebb7:

    # w pout "Hmph. If you're truly suffering, I shall desist..."
    w pout "Hmph. Se ti faccio soffrire tanto, credo proprio che la smetterò..."

# game/script.rpy:851
translate ita ch2_115b6d90:

    # a smile "That's the thing, though... I DO like seeing you all worked up over something, even if I don't understand it myself."
    a smile "Eppure, sai... mi piace vederti emozionato mentre parli di qualcosa, anche se non ne capisco esattamente il perché."

# game/script.rpy:852
translate ita ch2_dfd74c02:

    # w happy "Ahh, so there IS a mutual benefit! You'll listen, then? 💙"
    w happy "Ahh, allora È piacevole per entrambi! Mi ascolterai, quindi? 💙"

# game/script.rpy:853
translate ita ch2_e4b44b62:

    # a sure "Yeah, at least until I get all this put away. After that, I'm kicking you out for the day."
    a sure "Sì, sì, o almeno finché non avrò finito di mettere a posto queste cose. A quel punto ti toccherà andar via."

# game/script.rpy:855
translate ita ch2_aa202e59:

    # w calm "Fair enough. I'd better be brief, then..."
    w calm "E va bene. Farò meglio ad essere conciso, allora..."

# game/script.rpy:857
translate ita ch2_c163a19e:

    # w teehee "He's the absolute cutest thing! I picked him up at a candy shop yesterday 💙"
    w teehee "È carinissimo! L'ho rimorchiato ieri al negozio di caramelle 💙"

# game/script.rpy:858
translate ita ch2_7ea91466:

    # w happy "Fluffy pink hair, with golden eyes, naturally rosy cheeks that make him look as if he's always a little embarrassed by something..."
    w happy "Capelli rosa e soffici, occhi dorati, guance rosee che lo fanno sembrare sempre in imbarazzo..."

# game/script.rpy:859
translate ita ch2_78bc035b:

    # w shy "He's shy, but not the type that becomes paralyzed in the bedroom--"
    w shy "È timido, ma non il tipo da diventare immobile a letto--"

# game/script.rpy:860
translate ita ch2_e6e9e69b:

    # a augh "Periwinkle, for the last time, I do NOT need to hear about bedroom stuff." with vpunch
    a augh "Periwinkle, per l'ultima volta, non ho DAVVERO bisogno di sapere dei dettagli sul sesso." with vpunch

# game/script.rpy:861
translate ita ch2_91bce83e:

    # w my "I wasn't giving any details!"
    w my "Non stavo rivelando alcun dettaglio!"

# game/script.rpy:862
translate ita ch2_f28bb905:

    # w shy "Although, the details ARE the best part 💙"
    w shy "Anche se, a dire il vero, quei dettagli sono proprio la mia parte preferita 💙"

# game/script.rpy:863
translate ita ch2_6f8d4d69:

    # a annoyed "This is a \"safe for work\" zone only. Break that rule, and you're outta here."
    a annoyed "Questo posto è rigorosamente \"safe for work\". Infrangi questa regola e sei fuori."

# game/script.rpy:864
translate ita ch2_91ce2d8b:

    # w innocent "My apologies~ I'll refrain."
    w innocent "Le mie scuse~ Mi tratterrò."

# game/script.rpy:865
translate ita ch2_dc5be651:

    # w love "Anyway, my point is... he's EXTREMELY cute. Adorable, in fact!"
    w love "Comunque, quello che sto cercando di dire è che... è ESTREMAMENTE carino. Adorabile, infatti!"

# game/script.rpy:866
translate ita ch2_d8b497e3:

    # a eyeroll "Right, so, standard fare for you."
    a eyeroll "Già, quindi, normale per i tuoi standard."

# game/script.rpy:867
translate ita ch2_fc605430:

    # w my "Absolutely not! If he was just your average cutie, would I be emphasizing his cuteness so much?"
    w my "Assolutamente no! Se fosse così, credi che starei enfatizzando così tanto quanto è carino?"

# game/script.rpy:868
translate ita ch2_a47387c2:

    # a sure "I don't meet these people, so it's all the same to me."
    a sure "Beh io non le incontro mica queste persone, quindi per me è lo stesso."

# game/script.rpy:869
translate ita ch2_afb4034f:

    # w oh "How can it be~? The intensity is so drastically different... perhaps SO intense that I'm having trouble explaining it properly."
    w oh "Ma come~? L'intensità è drasticamenta diversa... forse COSÌ diversa che sto avendo problemi a spiegarmi."

# game/script.rpy:870
translate ita ch2_3da682aa:

    # a closed "I'll say. All you've really told me so far is that he's cute and shy."
    a closed "Hm. Tutto ciò che mi hai detto finora è che è carino e timido."

# game/script.rpy:871
translate ita ch2_8e3642e4:

    # w shy "He's kind, as well! He saved the best part of our dessert for me without even asking!"
    w shy "È anche gentile! Ha lasciato a me le parti migliori del nostro dessert senza che glielo chiedessi!"

# game/script.rpy:872
translate ita ch2_dfa9b85a:

    # a lol "Wow, I would've led with that one."
    a lol "Wow, ma che eroe."

# game/script.rpy:873
translate ita ch2_fdbe174a:

    # w pout "Ohh, enough of your sarcasm. When all my favorite details are off-limits, what do you suppose I'm LEFT with?"
    w pout "Ohh, e finiscila col sarcasmo. Quando tutti i miei dettagli preferiti sono off-limits, che cosa credi mi rimanga?"

# game/script.rpy:874
translate ita ch2_ab7c305b:

    # a happy "Well, what really matters is that you had a good night. Even if it meant you couldn't get here on time like I asked."
    a happy "Beh, l'importante è che tu ti sia divertito. Anche se hai dovuto fare tardi."

# game/script.rpy:875
translate ita ch2_f5e62b00:

    # w love "Ahh~ I'm already hoping to see him again, to be honest..."
    w love "Ahh~ Spero già di poterlo vedere di nuovo, ad essere onesti... "

# game/script.rpy:876
translate ita ch2_0979287d:

    # a hm "Oh yeah? Don't hear that from you very often."
    a hm "Oh, è così? Non è una cosa che ti sento dire spesso."

# game/script.rpy:877
translate ita ch2_83be95f7:

    # w oh "Really? But I've gone on second dates all the time."
    w oh "Davvero? Eppure sono andato a molti secondi appuntamenti."

# game/script.rpy:878
translate ita ch2_95f62998:

    # a lol2 "This guy got a name?"
    a lol2 "Questo tipo ha un nome?"

# game/script.rpy:879
translate ita ch2_899be6dd:

    # w shy "Hmhm, I don't kiss and tell 💙"
    w shy "Hmhm, non ho mica la lingua lunga, sai 💙"

# game/script.rpy:880
translate ita ch2_7b70ce89:

    # a sure "No, actually, you tell me about everyone you kiss."
    a sure "No, ma mi racconti di tutti quelli a cui la metti in bocca, la lingua."

# game/script.rpy:881
translate ita ch2_44e74989:

    # a lol "C'mon, if he's really the absolute cutest, it's a shame to keep him anonymous, right? Not like I'm gonna tell anyone anyways."
    a lol "Eddai, se è davvero così carino, è un peccato tenerlo anonimo, no? E poi non lo andrò mica a dire in giro."

# game/script.rpy:882
translate ita ch2_cb259e44:

    # w calm "Fine... his name is Pastille."
    w calm "E va bene... il suo nome è Pastille."

# game/script.rpy:883
translate ita ch2_ce121fd3:

    # a annoyed "Hmph. Even his name's cute."
    a annoyed "Hmph. Persino il suo nome è carino."

# game/script.rpy:884
translate ita ch2_b434ce04:

    # w happy "Right~?"
    w happy "Vero~?"

# game/script.rpy:885
translate ita ch2_2d463d2b:

    # w smile "Oh, that reminds me--he sold me some candies that share his name. Would you like to try?"
    w smile "Oh, mi sono ricordato di una cosa--mi ha venduto delle caramelle col suo stesso nome. Vorresti provarle?"

# game/script.rpy:886
translate ita ch2_628745c1:

    # a happy "Sure. How could a witch turn down free candy?"
    a happy "Certo. Come potrebbe una strega rifiutare delle caramelle?"

# game/script.rpy:887
translate ita ch2_2ac72dd0:

    # n "Periwinkle digs into his bag and pulls out one of the pastilles."
    n "Periwinkle scava nella sua borsa e tira fuori una pastiglia."

# game/script.rpy:888
translate ita ch2_c90345e5:

    # n "He hands the candy to Astragalus, who promptly unwraps it and pops it into her mouth."
    n "Porge la caramelle ad Astragalus, che la scarta e se la mette in bocca."

# game/script.rpy:889
translate ita ch2_e3dc6cdf:

    # a hm "Mmf... Oh, these are GOOD. Where'd you say this candy shop was?"
    a hm "Mmf... Oh, sono OTTIME. Dove hai detto che si trova questo negozio?"

# game/script.rpy:890
translate ita ch2_6e7c54dc:

    # w happy "Not far from here! I'll give you directions..."
    w happy "Non troppo lontano da qui! Posso darti delle indicazioni..."

# game/script.rpy:897
translate ita ch2_58993334:

    # "Shortly after telling Astragalus where to find Atelier Sweets, she unceremoniously kicked me out..."
    "Poco dopo aver detto ad Astragalus dove trovare l' Atelier Sweets, mi cacciò fuori bruscamente..."

# game/script.rpy:898
translate ita ch2_7f4ee160:

    # "She'd long finished putting all those bottles away, after all."
    "Aveva finito da un bel po' di mettere le bottiglie a posto, dopotutto."

# game/script.rpy:899
translate ita ch2_d635dbff:

    # "With money in my pocket, and no more work to be done for the moment... I'm free to begin pursuing my next date~"
    "Coi soldi in tasca, e niente più lavoro da svolgere per il momento... sono libero di iniziare a cercare il mio prossimo appuntamento~"

# game/script.rpy:900
translate ita ch2_a4f99886:

    # nvl clear
    # "But wherever shall I go? It's a weekday, too early for parties, too early for drinks..."
    nvl clear
    "Ma dove? È un giorno lavorativo, troppo presto per le feste, troppo presto per andare a bere..."

# game/script.rpy:902
translate ita ch2_1e5385aa:

    # "I suppose I could return home and straighten up the place. However..."
    "Suppongo di poter tornare a casa e mettermi a riordinare. Però..."

# game/script.rpy:903
translate ita ch2_801baa18:

    # nvl clear
    # w calm "(Why would I busy myself with chores when I could be celebrating another order successfully filled?)"
    nvl clear
    w calm "(Perché dovrei preoccuparmi delle faccende domestiche quando potrei star festeggiando un altro ordine consegnato con successo?)"

# game/script.rpy:906
translate ita ch2_7123d8ef:

    # n "Before Periwinkle can decide on where to go, a familiar witch approaches him."
    n "Prima che Periwinkle possa decidere dove andare, una strega familiare gli si avvicina."

# game/script.rpy:909
translate ita ch2_a7e53e02:

    # c "Periwinkle...?"
    c "Periwinkle...?"

# game/script.rpy:910
translate ita ch2_ed8e4bc5:

    # w happy "Ohh, Cassia! So lovely to see you~"
    w happy "Ohh, Cassia! Che bello vederti~"

# game/script.rpy:911
translate ita ch2_cca6951a:

    # c happy "Yay, I'm so glad we ran into each other~"
    c happy "Yay, sono così contenta di averti incontrato~"

# game/script.rpy:913
translate ita ch2_18cfade9:

    # "How to describe Cassia..."
    "Come si potrebbe descrivere Cassia..."

# game/script.rpy:914
translate ita ch2_0c67f0a0:

    # "She's exceedingly cuddly. We met at a party one night, during which she latched onto my arm and never let go. Quite endearing!"
    "È eccessivamente affettuosa. Ci siamo incontrati ad una festa una sera, e per tutto il tempo si è aggrappata al mio braccio e non lo ha lasciato andare. Molto carina!"

# game/script.rpy:915
translate ita ch2_6535f464:

    # "Since then, we've gone on little dates from time to time..."
    "Da allora, Siamo usciti insieme di tanto in tanto..."

# game/script.rpy:916
translate ita ch2_91a4c39c:

    # "She really loves my magic, so I tend to spoil her whenever we're together 💙"
    "Adora la mia magia, quindi mi piace viziarla quando siamo insieme 💙"

# game/script.rpy:917
translate ita ch2_fc9d5dc6:

    # nvl clear
    # w smile "Did you need something, dear?"
    nvl clear
    w smile "Ti serviva qualcosa, cara?"

# game/script.rpy:920
translate ita ch2_7206142c:

    # c aww "Ah, yes! I tried coming over last night, but you didn't seem to be home..."
    c aww "Ah, sì! Sono venuta a trovarti ieri sera, ma non eri a casa..."

# game/script.rpy:921
translate ita ch2_693e007a:

    # w shy "Aww, you came to visit me? I'm flattered 💙"
    w shy "Aww, sei venuta a trovarmi? Sono lusingato 💙"

# game/script.rpy:922
translate ita ch2_399869f1:

    # w smile "I must've been out to dinner at the time... Sorry that I missed you~"
    w smile "Mi sa che ero fuori a cena a quell'ora... Mi dispiace essermi perso la tua visita~"

# game/script.rpy:923
translate ita ch2_2f0adf6c:

    # c smile "Oh, it's okay~ I was mostly looking to talk..."
    c smile "Oh, non fa nulla~ Volevo solo parlare..."

# game/script.rpy:924
translate ita ch2_c9ba5380:

    # c aww "So, um, if you're available right now... do you wanna go to a café?"
    c aww "Quindi, um, se sei libero ora... ti va di andare a un café?"

# game/script.rpy:925
translate ita ch2_d5996b44:

    # w innocent "That sounds perfect! I would love to."
    w innocent "Ma certo! Mi farebbe molto piacere."

# game/script.rpy:931
translate ita ch2_e516a126:

    # "We take our seats at the nearby café."
    "Ci sediamo ad un café nelle vicinanze."

# game/script.rpy:932
translate ita ch2_07ec8f7d:

    # "It's a pleasant, sunny little place. I've come here often with all sorts of other witches."
    "È un posto piacevole e soleggiato. Ci sono venuto spesso insieme ad altre streghe."

# game/script.rpy:933
translate ita ch2_798bacd1:

    # "Cassia orders her usual hot chocolate with extra marshmallows, while I decide on a simple rose tea."
    "Cassia ordina la sua solita cioccolata calda con marshmallow extra, mentre io un semplice tè alle rose."

# game/script.rpy:934
translate ita ch2_13febc5a:

    # nvl clear
    # c oh "Ooh, Periwinkle, could you make my marshmallows smell like roses, too?"
    nvl clear
    c oh "Ooh, Periwinkle, potresti far profumare i miei marshmallow di rose?"

# game/script.rpy:937
translate ita ch2_e1d1de4a:

    # w innocent "With pleasure 💙"
    w innocent "Ma con piacere 💙"

# game/script.rpy:938
translate ita ch2_d7d93e12:

    # n "Periwinkle's wand drops from his sleeve, and he gives Cassia's cup a quick little tap."
    n "Periwinkle tira fuori la bacchetta dalla manicha, e batte un colpetto sulla tazza di Cassia."

# game/script.rpy:939
translate ita ch2_9343669f:

    # c happy "Eheh, yay~ It really smells just like roses~!"
    c happy "Eheh, yay~ Sa proprio di rose ora~!"

# game/script.rpy:940
translate ita ch2_790200db:

    # w smile "Just as you asked, dear. It may slightly affect the taste, so let me know if you'd like the spell undone."
    w smile "Proprio come mi hai chiesto, cara. Potrebbe cambiare un pochino il sapore, quindi fammi sapere se vuoi che sciolga l'incantesimo."

# game/script.rpy:942
translate ita ch2_51b79206:

    # n "Cassia dips her spoon in and lifts a marshmallow to her lips, blowing on it lightly before popping it into her mouth."
    n "Cassia prende un marshmallow col cucchiaio e se lo porta alle labbra, ci soffia sopra e infine se lo mette in bocca."

# game/script.rpy:943
translate ita ch2_bb00d05f:

    # c happy "Mmf... no, it's wonderful! Ehehe~ 🤎"
    c happy "Mmf... no, è delizioso! Ehehe~ 🤎"

# game/script.rpy:946
translate ita ch2_88501500:

    # "She truly can find the joy in any little moment. Such a delight..."
    "Riesce veramente a trovare gioia in ogni piccolo momento. È davvero un tesoro..."

# game/script.rpy:947
translate ita ch2_28e04d59:

    # "Definitely a contender for the title of absolute cutest witch. Though I would call her... absolutely cute, rather than the absolute cutest."
    "Direi che è una concorrente per il titolo di strega assolutamente più carina. Anche se la chiamerei...assolutamente carina, invece di assolutamente più carina."

# game/script.rpy:948
translate ita ch2_22a82a32:

    # "It takes more than cuteness alone to earn the title of absolute cutest witch! That's where the difference lies, of course."
    "Ci vuole più della carineria e basta per guadagnarsi un titolo del genere! È lì che sta la differenza."

# game/script.rpy:949
translate ita ch2_1167b98f:

    # nvl clear
    # "But what am I thinking? How rude it is, to begin ranking my dates in such a way."
    nvl clear
    "Ma a cosa sto pensando? È davvero scortese da parte mia, comparare gli appuntamenti in modo simile."

# game/script.rpy:951
translate ita ch2_89364570:

    # "I must be stuck on the thought from my earlier conversation with Astragalus... trying to put Pastille's cuteness into words."
    "Devo essere ancora fissato sulla mia conversazione di prima con Astragalus... quando ho provato a descrivere la carineria di Pastille a parole."

# game/script.rpy:952
translate ita ch2_f14542af:

    # "He really is something special... ah, it's all in the contrast! His polite, well-mannered and proper exterior, concealing such intense desire, begging you to make the first move, and then going ahead and taking it on his own as soon as you--"
    "È davvero speciale... ah, sta tutto nel contrasto! Il suo esterno educato e cortese, che nasconde una voglia talmente intensa, ti prega di fare la prima mossa, per poi prendersela da sé non appena--"

# game/script.rpy:953
translate ita ch2_d02f8f43:

    # nvl clear
    # w oops "(...Enough of that! There's someone else in front of me now, isn't there?)" with vpunch
    nvl clear
    w oops "(...Basta pensare a quello! C'è qualcun altro proprio davanti a me, giusto?)" with vpunch

# game/script.rpy:956
translate ita ch2_84a03c6d:

    # n "Cassia continues happily sipping her hot chocolate before speaking up again."
    n "Cassia continua a sorseggiare con gioia la sua cioccolata, prima di riprendere a parlare."

# game/script.rpy:958
translate ita ch2_4958d936:

    # c aw "Ahh, I missed you, Periwinkle~ I've been so busy with packing, I haven't had a chance to see you at all..."
    c aw "Ahh, mi sei mancato, Periwinkle~ Sono stata così occupata col trasloco, che non ho avuto proprio tempo per vederti..."

# game/script.rpy:959
translate ita ch2_15a35145:

    # w my "Packing? And just where are you headed off to?"
    w my "Trasloco? E dov'è che te ne vai?"

# game/script.rpy:960
translate ita ch2_959ab161:

    # c oh "Oh, that's right! I never had a chance to tell you~"
    c oh "Oh, giusto! Non ho avuto occasione di dirtelo~"

# game/script.rpy:961
translate ita ch2_28a09411:

    # c happy "I'm finally moving in with my partners~! In two more days, the three of us will all be sleeping in the same bed~ 🤎"
    c happy "Vado finalmente a vivere coi miei partner~! Altri due giorni, e poi dormiremo tutti e tre nello stesso letto~ 🤎"

# game/script.rpy:962
translate ita ch2_1b9c5f18:

    # w happy "Ooh, that sounds cozy~ Congratulations!"
    w happy "Ooh, sembra bello~ Congratulazioni!"

# game/script.rpy:963
translate ita ch2_937fc8b0:

    # c aww "Ehe, thank you~ 🤎 I've looked forward to it for so long..."
    c aww "Ehe, grazie~ 🤎 Ho aspettato così tanto di poterlo fare..."

# game/script.rpy:964
translate ita ch2_aae442de:

    # w smile "It sounds like you're about to enter a lovely domestic life. You deserve it!"
    w smile "Sembra che tu stia per iniziare un'ottima vita domestica. Te lo meriti proprio!"

# game/script.rpy:965
translate ita ch2_f5692979:

    # c "Aww, hehehe... I'm really happy."
    c "Aww, hehehe... sono proprio felice."

# game/script.rpy:966
translate ita ch2_d2fabfa3:

    # c oh "But, um... speaking of my partners. You've still never even met them..."
    c oh "Ma, um... a proposito dei miei partner. Devi ancora incontrarli..."

# game/script.rpy:967
translate ita ch2_f5612c00:

    # w calm "True. But I can imagine they're wonderful, just from how you've talked about them."
    w calm "Vero. Ma posso già immaginare che siano fantastici, da come me li hai descritti."

# game/script.rpy:968
translate ita ch2_f82c96ac:

    # c aww "Right~ but, um... what if you didn't have to imagine?"
    c aww "Già~ ma, um... e se non dovessi immaginare?"

# game/script.rpy:969
translate ita ch2_add80a4e:

    # c smile "That's what I've been wanting to talk to you about. I was hoping... we might all be able to go on a group date sometime!"
    c smile "Volevo parlarti di questo. Speravo... che saremmo potuti andare ad un appuntamento di gruppo qualche volta!"

# game/script.rpy:970
translate ita ch2_c81c387b:

    # w oh "Oh~?"
    w oh "Oh~?"

# game/script.rpy:971
translate ita ch2_8b6f2fb7:

    # c aw "Yeah~! Because, like... I just think you're so wonderful, Periwinkle. I want them to know you, too!"
    c aw "Già~! Perchè, tipo... credo che tu sia davvero fantastico, Periwinkle. Voglio che ti conoscano anche loro!"

# game/script.rpy:972
translate ita ch2_40b31e80:

    # w sorry "Mm... although it sounds like fun, I'm a bit..."
    w sorry "Mm... anche se sembra divertente, sono un po'..."

# game/script.rpy:973
translate ita ch2_7122e72f:

    # c please "W-wait, before you say no...!"
    c please "A-aspetta, prima che tu dica di no...!"

# game/script.rpy:974
translate ita ch2_b6456ff5:

    # c "They're both very easygoing, and so loving, and nice...! I can promise it won't be overwhelming..."
    c "Sono entrambi molto accomodanti, e amorevoli, e magnifici...! Ti prometto che non sarà soffocante..."

# game/script.rpy:975
translate ita ch2_62b54e38:

    # w decline "That unfortunately isn't where the issue lies, my dear..."
    w decline "Sfortunatamente non è lì il problema, cara..."

# game/script.rpy:976
translate ita ch2_bb65f581:

    # c sad "I-I know you said you didn't want to get involved before... but I just know that we would all get along so well!"
    c sad "S-so che hai già detto di non volerti farti coinvolgere... ma sono sicura che andremmo tutti davvero d'accordo insieme!"

# game/script.rpy:977
translate ita ch2_9db7f2b9:

    # c "I'd like to reassure you however I can. But I understand if you still turn me down..."
    c "Voglio rassicurarti in ogni modo che posso. Ma capirò se mi rifiuterai lo stesso..."

# game/script.rpy:979
translate ita ch2_99af5b21:

    # "Matters of love are so tricky, aren't they?"
    "Le faccende d'amore sono proprio complicate, non è vero?"

# game/script.rpy:980
translate ita ch2_b7229a67:

    # "I still recall the first time something like this was asked of me..."
    "Mi ricordo ancora della prima volta che mi venne chiesta una cosa del genere..."

# game/script.rpy:981
translate ita ch2_70f4d8cb:

    # "I had been nervous going in, but I had also never entered a group situation before. I attributed my anxiety solely to that."
    "Ero nervoso, ma non ero mai stato in una situazione di gruppo prima. Quindi attribuì la mia ansia a quello."

# game/script.rpy:982
translate ita ch2_5aaf6eab:

    # "However, it quickly became clear that I just wasn't suited to it at all..."
    "Tuttavia, divenne subito chiaro che semplicemente non faceva affatto per me..."

# game/script.rpy:983
translate ita ch2_92e49d6c:

    # nvl clear
    # "I do love to spoil each of my partners--but strictly one at a time."
    nvl clear
    "Amo viziare ognuno dei miei partner--ma rigorosamente uno alla volta."

# game/script.rpy:985
translate ita ch2_13099713:

    # "Perhaps I was left scarred by the breakdown in communication, the passionate fires of a long-established romance..."
    "Forse rimasi traumatizzato dalla mancanza di comunicazione, dal fuoco di una relazione già di lunga durata..."

# game/script.rpy:986
translate ita ch2_000f6a86:

    # "Surely Cassia and her partners are magnificent people. It may indeed be fun for a night."
    "Sono sicuro che Cassia e i suoi partner siano fantastici. Potrebbe essere divertente per una notte."

# game/script.rpy:987
translate ita ch2_e1d8cf3a:

    # "But becoming entangled in committed relationships is something I've always avoided from the beginning, isn't it?"
    "Ma farmi coinvolgere in una relazione seria è qualcosa che ho evitato sin dall'inizio, no?"

# game/script.rpy:988
translate ita ch2_b61e07ce:

    # nvl clear
    # w neutral "This is all very sweet of you. But I do have to decline."
    nvl clear
    w neutral "Sono davvero lusingato. Ma devo rifiutare."

# game/script.rpy:991
translate ita ch2_d6eb3267:

    # c letdown "Aww... I can't help but feel a little broken-hearted."
    c letdown "Aww... mi sento il cuore un po' spezzato."

# game/script.rpy:992
translate ita ch2_02d40560:

    # w decline "I apologize... Truly, it's nothing personal."
    w decline "Mi dispiace... Davvero, non è nulla di personale."

# game/script.rpy:993
translate ita ch2_cea46204:

    # c aww "Oh, I know~ I don't take offense or anything..."
    c aww "Oh, lo so~ Non mi offendo mica..."

# game/script.rpy:994
translate ita ch2_13fca6f4:

    # c letdown "It's just sad. Now that I'm going to be living with them... and, knowing you don't want to meet them..."
    c letdown "Sono solo un po' triste. Ora che andrò a vivere con loro... sapendo che non vuoi incontrarli..."

# game/script.rpy:995
translate ita ch2_82188b3a:

    # c sad "I think it's best we just break things off...."
    c sad "Credo sia meglio se noi due rompiamo...."

# game/script.rpy:996
translate ita ch2_9b7a5305:

    # w neutral "Yes, I agree. As you said, it's for the best."
    w neutral "Sì, concordo. Come hai detto, è meglio così."

# game/script.rpy:997
translate ita ch2_22bfa56a:

    # c aww "I hope we can still be friends, though~"
    c aww "Spero di poter rimanere amici, però~"

# game/script.rpy:998
translate ita ch2_a119e9ad:

    # w smile "Of course~ 💙 I'm sure our paths will cross every now and again."
    w smile "Ma certo~ 💙 Sono sicuro che le nostre strade si incroceranno di nuovo qualche volta."

# game/script.rpy:999
translate ita ch2_96818197:

    # c happy "Yeah~! Thank you for always treating me so well, Periwinkle."
    c happy "Sì~! Grazie per avermi trattata così bene, Periwinkle."

# game/script.rpy:1000
translate ita ch2_f9c0bf81:

    # w calm "Hmhm, it was my pleasure 💙"
    w calm "Hmhm, è stato un piacere 💙"

# game/script.rpy:1003
translate ita ch2_482c7dd0:

    # "Even casual relationships can end in breakups like this."
    "Anche relazioni aperte posso finire con rotture del genere"

# game/script.rpy:1004
translate ita ch2_7fabf76c:

    # "This is largely why I tend to prefer one-night affairs. Things can just become so messy as needs evolve..."
    "Ed è per questo che preferisco incontri da una notte. Più i bisogni si evolvono più le cose si fanno complicate..."

# game/script.rpy:1005
translate ita ch2_e8be9790:

    # "As Cassia and I go our separate ways, I can't help feeling a little blue."
    "Mentre io e Cassia ci separiamo, non riesco a non sentirmi un po' giù di morale."

# game/script.rpy:1006
translate ita ch2_7b0bc9f1:

    # "Perhaps I'll return home for the day after all."
    "Mi sa proprio che tornerò a casa dopotutto."

# game/script.rpy:1007
translate ita ch2_76b2fe88_2:

    # nvl clear
    nvl clear

# game/script.rpy:1018
translate ita ch2_80d3118f:

    # n "Periwinkle quickly changes into something more comfortable, dropping his bag unceremoniously onto the couch."
    n "Periwinkle si cambia rapidamente e indossa qualcosa di più comodo, lasciando cadere bruscamente la sua borsa sul divano."

# game/script.rpy:1019
translate ita ch2_a9ff1a56:

    # w pj neutral "(I could use an afternoon nap...)"
    w pj neutral "(Un pisolino mi farebbe proprio bene...)"

# game/script.rpy:1020
translate ita ch2_10be0962:

    # w calm "(Yes, that's precisely what I need. I'll wake up feeling refreshed, and ready to go back out on the town~)"
    w calm "(Sì, è esattamente ciò di cui ho bisogno. Mi sveglierò riposato, e pronto per tornare in città~)"

# game/script.rpy:1022
