    # w guilty "(The state Pastille would find me in if he were to show up tonight...)"
    w guilty "(Lo stato in cui mi vedrebbe Pastille se si facesse vivo ora...)"

# game/script.rpy:1644
translate ita ch3_db6282c6:

    # w empty "...."
    w empty "...."

