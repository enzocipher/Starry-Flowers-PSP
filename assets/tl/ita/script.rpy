    # centered "{w=3}{nw}"
    centered "{w=3}{nw}"

# game/script.rpy:369
translate ita start_ab7ee487:

    # "Today I met a boy at a candy shop."
    "Oggi ho incontrato un ragazzo in un negozio di caramelle."

# game/script.rpy:370
translate ita start_085c93f7:

    # "The moment I saw him, I just knew I couldn't leave without flirting a little~"
