    # n "Wrapping a blanket around his shoulders in an attempt to look half-decent, he finally opens the door..."
    n "Si avvolge una coperta attorno alle spalle in modo da avere un aspetto decente, e infine apre la porta..."

# game/script.rpy:1683
translate ita ch4_9c6ed696:

    # p "Hi! I took the day off, so I..."
    p "Ciao! Mi sono preso un giorno libero, quindi..."

