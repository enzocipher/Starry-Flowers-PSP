    # "I shake the thought and return to the moment..."
    "Smetto di pensarci e torno a godermi il momento..."

# game/script.rpy:1530
translate ita ch3_76b2fe88_5:

    # nvl clear
    nvl clear

# game/script.rpy:1533
translate ita ch3_4dfd153d:

    # n "The pair twirls around the dance floor, losing themselves in the music."
    n "Il duo volteggia sulla pista da ballo, perdendosi nella musica."

# game/script.rpy:1534
translate ita ch3_17b0a74e:

    # n "After a while, Kardaemon suddenly speaks up."
    n "Dopo un po', Kardaemon rompe il silenzio."

# game/script.rpy:1535
translate ita ch3_122eb838:

    # k "...OH! I think I just realized where I know you from!"
    k "...OH! Penso di aver capito dove ti ho visto prima!"

# game/script.rpy:1536
translate ita ch3_5a8eabf4:

    # w love "Really, now?"
    w love "Ma davvero?"

# game/script.rpy:1537
translate ita ch3_5ae9085a:

    # k "Yeah, you were in the magazine I work for!"
    k "Sì, eri sulla rivista per la quale lavoro!"

# game/script.rpy:1538
translate ita ch3_a784e394:

    # k "I'm an editor. We used your photos for an issue a couple years back."
    k "Sono un editor. Usammo delle tue foto per un numero di qualche anno fa."

# game/script.rpy:1539
translate ita ch3_efcb9510:

    # w oh "Ah... what a coincidence. I DID used to do some modeling, in the past..."
    w oh "Ah... che coincidenza. È vero che ho fatto per un po' il modello, in passato..."

# game/script.rpy:1540
translate ita ch3_07b8e242:

    # w calm "And in the past it shall remain. I'm in a different line of work now."
    w calm "Ed è meglio che rimanga nel passato. Sono in un settore lavorativo diverso ora."

# game/script.rpy:1541
translate ita ch3_e86cb7f9:

    # k "Aww, really? That's too bad. I always thought you looked amazing."
    k "Aww, davvero? Che peccato. Ho sempre pensato che fossi stupendo."

# game/script.rpy:1542
translate ita ch3_014598d5:

    # w smile "Hmhm, I appreciate that 💙"
    w smile "Hmhm, lo apprezzo 💙"

# game/script.rpy:1545
translate ita ch3_eac59ccf:

    # w neutral "(Well this certainly complicates things... I'd much prefer to have been complete strangers.)"
    w neutral "(Beh questo complica un po' le cose... Avrei preferito essere completi estranei."

# game/script.rpy:1546
translate ita ch3_54236a36:

    # w decline "(How unfortunate... just when I was beginning to enjoy myself.)"
    w decline "(Che sfortuna... proprio ora che stavo cominciando a divertirmi.)"

# game/script.rpy:1549
translate ita ch3_7c244efe:

    # k "Haha, wow, I can't believe I ran into you like this. Maybe it's a sign...?"
    k "Haha, wow, non posso credere di averti incontrato qui. Forse è un segno...?"

# game/script.rpy:1550
translate ita ch3_f26130c5:

    # w smile "A sign? Of what, dare I ask?"
    w smile "Un segno? E di cosa, se posso chiedere?"

# game/script.rpy:1551
translate ita ch3_41d59cda:

    # k smile "That you should come back to modeling! I can get you in our magazine again--if you're interested, that is."
    k smile "Che dovresti tornare a fare il modello! Posso farti inserire di nuovo nella nostra rivista--se sei interessato, ovviamente."

# game/script.rpy:1552
translate ita ch3_24632a00:

    # w guilty "I appreciate the offer, but I've moved on. It put too much of a strain on my relationship with fashion, among other things..."
    w guilty "Apprezzo l'offerta, ma ho voltato pagina. Causava troppa tensione nella mia relazione con la moda, tra l'altro..."

# game/script.rpy:1553
translate ita ch3_9bbf2611:

    # k shy "Ah... well, at least take my card! In case you change your mind."
    k shy "Ah... beh, almeno prendi il mio biglietto da visita! In caso cambiassi idea."

# game/script.rpy:1554
translate ita ch3_1ae6e450:

    # w calm "No thank you. I don't see that happening."
    w calm "No grazie. Non credo succederà."

# game/script.rpy:1555
translate ita ch3_12306026:

    # k laugh "Aww, come on... you'd be so great! It feels like such a waste of talent...."
    k laugh "Aww, eddai... saresti perfetto! Mi sembra proprio uno spreco di talento...."

# game/script.rpy:1556
translate ita ch3_51eac4d1:

    # w neutral "(Hm... I'm quickly growing tired of this.)"
    w neutral "(Hm... sto iniziando a stufarmi.)"

# game/script.rpy:1557
translate ita ch3_c4d486cb:

    # w smile "Thank you for the dance... but I really should be going now."
    w smile "Grazie per il ballo... ma devo proprio andare ora."

# game/script.rpy:1558
translate ita ch3_33e9643f:

    # k huh "Huh? Ah, uh... sure."
    k huh "Huh? Ah, uh... va bene."

# game/script.rpy:1559
translate ita ch3_b30b1ced:

    # w innocent "This was fun. Perhaps we'll meet again sometime 💙"
    w innocent "È stato bello. Forse ci incontreremo di nuovo qualche volta 💙"

# game/script.rpy:1560
translate ita ch3_0d5df227:

    # k sad "Y-yeah...."
    k sad "G-già...."

# game/script.rpy:1567
translate ita ch3_ef15a56c:

    # "I didn't expect to be reminded of my modeling days of all things..."
    "Non mi aspettavo che mi venissero ricordati proprio i miei giorni da modello..."

# game/script.rpy:1568
translate ita ch3_bad021ca:

    # "Although his excitement was understandable, the way he went about it certainly ruined the mood."
    "Anche se la sua emozione era comprensibile, il modo in cui l'ha espressa ha proprio rovinato l'atmosfera."

# game/script.rpy:1569
translate ita ch3_72a95f04:

    # "I hate to admit it, but I'd gone into this night far too unstable to begin with. For such a small thing to get to me..."
    "Odio ammetterlo, ma son venuto qui già troppo instabile. Che una cosa così piccola mi dia fastidio..."

# game/script.rpy:1570
translate ita ch3_5ad7ada1:

    # nvl clear
    # "I'm not even here on my own terms, am I?"
    nvl clear
    "Non sono nemmeno qui per me stesso, non è vero?"

# game/script.rpy:1572
translate ita ch3_2f4d44d7:

    # "This was all to prove a point. That's certainly not in the spirit of a friendly soirée..."
    "Era tutto per dimostrare qualcosa. Non è certo lo spirito di un soirée amichevole..."

# game/script.rpy:1573
translate ita ch3_d4b47508:

    # "It's best I just return home and--"
    "È meglio che me ne torni a casa e--"

# game/script.rpy:1574
translate ita ch3_f36f833e:

    # nvl clear
    # k "Periwinkle, wait!"
    nvl clear
    k "Periwinkle, aspetta!"

# game/script.rpy:1577
translate ita ch3_f6a6af3b:

    # n "He turns his head to find that Kardaemon has chased after him, stumbling into the lonely night air."
    n "Si volta per vedere che Kardaemon lo aveva seguito, entrando nella solitudine dell'aria notturna."

# game/script.rpy:1579
translate ita ch3_29be8e4a:

    # k "Hey--I, uh... I'm sorry if I said anything to upset you."
    k "Hey--io, uh... mi dispiace se ho detto qualcosa che ti ha offeso."

# game/script.rpy:1580
translate ita ch3_63733355:

    # w oh "...Upset me? Perish the thought!"
    w oh "...Offeso? Non pensarlo nemmeno!"

# game/script.rpy:1581
translate ita ch3_7415dc79:

    # w guilty "It's simply that I'm feeling a little off tonight. I realized I may have come here for the wrong reasons..."
    w guilty "Mi sento soltanto un po' strano stasera. Mi sono reso conto di eessere venuto qui per le ragioni sbagliate..."

# game/script.rpy:1582
translate ita ch3_5567e155:

    # k pls "Look... I'm sorry that I suddenly started talking about work. That wasn't why I approached you at all."
    k pls "Senti... mi spiace se ho iniziato all'improvviso a parlare di lavoro. Non è per quello che mi sono avvicinato a te."

# game/script.rpy:1583
translate ita ch3_01a63751:

    # k sorry "You came here for a good time, right? Well, a party's definitely the place to find it!"
    k sorry "Sei venuto qui per divertirti un po' con qualcuno, no? Beh una festa è il posto perfetto per farlo!"

# game/script.rpy:1584
translate ita ch3_1e7ddd47:

    # k lookoff "Heck, it's what I'M here for, too... so, you're not wrong to come looking for that."
    k lookoff "Cacchio, anche IO sono qui per quello... quindi, non è sbagliato che tu lo voglia."

# game/script.rpy:1585
translate ita ch3_3219922b:

    # w neutral "(He's completely misread the situation... Although, it IS starting to look salvageable from here.)"
    w neutral "(Non ha compreso per nulla la situazione... Anche se, le cose sembrano recuperabili da qui.)"

# game/script.rpy:1586
translate ita ch3_07c62861:

    # k sorry "Anyway, please forget about the magazine stuff--it doesn't matter. We were having fun before that right?"
    k sorry "Ad ogni modo, per favore dimenticati della roba sulla rivista--non importa. Ci stavamo divertendo prima, giusto?"

# game/script.rpy:1587
translate ita ch3_88dfd8df:

    # w calm "Dancing was nice, yes..."
    w calm "È stato bello ballare, sì..."

# game/script.rpy:1588
translate ita ch3_0e1aab5c:

    # k sad "I-I wanna do more than just dance with you."
    k sad "V-voglio fare di più che ballare e basta con te."

# game/script.rpy:1589
translate ita ch3_80ca340f:

    # w drool "(Oho, there it is~ Now we're getting somewhere.)"
    w drool "(Oho, eccoci qui~ Ora sì che si ragiona.)"

# game/script.rpy:1590
translate ita ch3_26564ac5:

    # w shy "More than dance? And what could that mean~?"
    w shy "Più che ballare? Che cosa potrà mai significare~"

# game/script.rpy:1591
translate ita ch3_107e0d19:

    # k shy "Hah, well, don't make me spell it out..."
    k shy "Hah, beh, non farmelo dire così..."

# game/script.rpy:1592
translate ita ch3_70331591:

    # w smile "A kiss, perhaps?"
    w smile "Un bacio, forse?"

# game/script.rpy:1593
translate ita ch3_1dbec082:

    # k smile "Sure. And, well, you know... whatever else you'd like to do! As an incubus, I live to please."
    k smile "Certo. E, beh, sai... qualsiasi altra cosa tu voglia! Essendo un incubus, vivo per soddisfare."

# game/script.rpy:1594
translate ita ch3_43a052fd:

    # w love "(Since he apologized, I may as well...)"
    w love "(Dato che si è scusato, potrei anche...)"

# game/script.rpy:1595
translate ita ch3_d84e6f35:

    # w calm "Kissing is a fine start."
    w calm "Un bacio è un buon inizio."

# game/script.rpy:1598
translate ita ch3_91dabae0:

    # n "Kardaemon holds out his arms, inviting Periwinkle into a soft embrace."
    n "Kardaemon allunga le braccia, invitando Periwinkle in un soffice abbraccio."

# game/script.rpy:1599
translate ita ch3_890d5fb6:

    # n "Periwinkle's hands glide up his chest, and he wraps his arms around the demon's neck. Their faces just inches apart, he pauses..."
    n "Le mani di Periwinkle gli scivolano sul petto, e le sue braccia si avvolgono attorno al collo del demone."
    n "Quando i loro visi sono separati da pochi centimetri, si ferma..."

# game/script.rpy:1600
translate ita ch3_5db6b259:

    # k "...?"
    k "...?"

# game/script.rpy:1601
translate ita ch3_62b5b0bb:

    # w ah "(...Ah. I expected him to close the gap.)"
    w ah "(...Ah. Mi aspettavo fosse lui a baciarmi.)"

# game/script.rpy:1602
translate ita ch3_d0a1702b:

    # w conflicted "(Pastille would've kissed me. I've grown far too accustomed to that, so I automatically...)"
    w conflicted "(Pastille lo avrebbe fatto. Mi ci sono abituato, e quindi...)"

# game/script.rpy:1603
translate ita ch3_6c100ae0:

    # w oops "(Shit. This was a mistake...)"
    w oops "(Cazzo. Tutto questo è stato un errore...)"

# game/script.rpy:1604
translate ita ch3_795ea425:

    # n "Periwinkle gives him a light peck on the cheek before pulling away."
    n "Periwinkle gli dà un bacio sulla guancia prima di allontanarsi."

# game/script.rpy:1607
translate ita ch3_01751b4a:

    # w decline "...My apologies. I do actually need to get going now."
    w decline "...Le mie scuse. Devo davvero andare ora."

# game/script.rpy:1608
translate ita ch3_466c52d9:

    # k huh "Huh...?"
    k huh "Huh...?"

# game/script.rpy:1609
translate ita ch3_d3799d4c:

    # w neutral "I shouldn't have led you on. I'm terribly sorry."
    w neutral "Non avrei dovuto illuderti. Mi dispiace terribilmente."

# game/script.rpy:1610
translate ita ch3_e029c081:

    # k sorry "Oh--n-no, don't worry about that... If you don't want to, it's fine."
    k sorry "Oh--n-no, non preoccuparti... se non vuoi, va bene."

# game/script.rpy:1611
translate ita ch3_c9e5ee71:

    # k sad "I'm, uh... a little confused, though... Did I do something wrong?"
    k sad "Sono solo, uh... un po' confuso, però... Ho fatto qualcosa di sbagliato?"

# game/script.rpy:1612
translate ita ch3_6e012f78:

    # w decline "It's not you--you're very nice. Very firm muscles."
    w decline "Oh non sei tu--sei molto simpatico. Ottimi muscoli."

# game/script.rpy:1613
translate ita ch3_1de73ec5:

    # k shy "Hah, thanks."
    k shy "Hah, grazie."

# game/script.rpy:1614
translate ita ch3_dc4c50ae:

    # w neutral "If it were any other night, things would've gone very differently. Please believe me when I say that."
    w neutral "Fosse stata una qualsiasi altra notte, le cose sarebbero andate in modo molto diverso. Ti prego di credermi quando lo dico."

# game/script.rpy:1615
translate ita ch3_7e78fb2a:

    # k lookoff "Seriously... is all this mysterious talk supposed to make me want you less...?"
    k lookoff "Seriamente... questa parlata misteriosa dovrebbe fare in modo che io ti voglia di meno...?"

# game/script.rpy:1616
translate ita ch3_47a1fbc2:

    # w calm "I'm sure you'll have great luck with the witches inside. You're very charming."
    w calm "Sono sicuro che avrai fortuna con le altre streghe alla festa. Sei molto affascinante."

# game/script.rpy:1617
translate ita ch3_c29eff2b:

    # k pls "...Damn. Well, alright..."
    k pls "...Merda. Beh, e va bene..."

# game/script.rpy:1618
translate ita ch3_e35a87bd:

    # k sorry "Get home safe, Periwinkle. Hope to see you again... on any other night, like you said."
    k sorry "Torna a casa sano e salvo, Periwinkle. Spero di vederti di nuovo... durante una qualsiasi altra notte, come hai detto tu."

# game/script.rpy:1619
translate ita ch3_92af379d:

    # w innocent "Thank you for keeping me entertained. Farewell~"
    w innocent "Grazie per avermi intrattenuto. Arrivederci~"

# game/script.rpy:1622
translate ita ch3_3e90a2df:

    # "I shouldn't have come..."
    "Non sarei dovuto venire..."

# game/script.rpy:1623
translate ita ch3_eed2f11e:

    # "What exactly have I proven here tonight? That I'm willing to pursue the first pink-haired boy I come across, out of sheer desperation?"
    "Cosa ho dimostrato stasera esattamente? Che sono disposto a buttarmi tra le braccia del primo ragazzo dai capelli rosa che incontro, per pure disperazione?"

# game/script.rpy:1624
translate ita ch3_e4b0829d:

    # "I wanted Astragalus to be wrong for once. To admit that I'm hung up on someone is just...!"
    "Volevo che Astragalus si sbagliasse per una volta. Ammettere che sono fissato con qualcuno è semplicemente...!"

# game/script.rpy:1625
translate ita ch3_0a84e19c:

    # "I don't feel like myself at all..."
    "Non mi sento per niente me stesso..."

# game/script.rpy:1626
translate ita ch3_76b2fe88_6:

    # nvl clear
    nvl clear

