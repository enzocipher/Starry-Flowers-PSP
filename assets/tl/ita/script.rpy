    p ehe "È, um... il massimo che posso fare per ora... scusa."

# game/script.rpy:2959
translate ita ch6_41c1209f:

    # w happy "I'll gladly take you up on that! I'd love to keep you company 💙"
    w happy "Accetto volentieri! Amerei farti compagnia 💙"

# game/script.rpy:2960
