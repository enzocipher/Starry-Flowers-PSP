    p embarrassed "Pensavo solo che facendolo insieme, avresti potuto decidere tu dove mettere le cose, e così nulla sarebbe stato perso...!"

# game/script.rpy:2913
translate ita ch6_ee213eff:

    # w love "Pastille...!"
    w love "Pastille...!"

