# game/script.rpy:3204
translate ita ch6_6537e332:

    # "Pastille walks me home, and promises to return later tonight."
    "Pastille mi accompagna a casa, e mi promette di tornare più tardi."

# game/script.rpy:3205
translate ita ch6_49b208d4:

    # "Things will move forward from there, won't they? Or is it too soon...?"
    "Le cose progrediranno da questo punto, vero? O è troppo presto...?"

# game/script.rpy:3206
translate ita ch6_2cc88408:

    # "Maybe it's too much for one day! I don't want to add to his stress...."
    "Forse è tropppo per un giorno solo! Non voglio aumentare il suo stress...."

# game/script.rpy:3207
translate ita ch6_1dc0c4c0:

    # nvl clear
    # w oops "(Ugh... why is this so difficult...?)"
    nvl clear
    w oops "(Ugh... ma perché è così difficile...?)"

# game/script.rpy:3209
translate ita ch6_b84eb580:

    # w conflicted "(His perception of me could be completely destroyed! Tarnished!)"
    w conflicted "(La sua percezione di me potrebbe essere completamente distrutta! Rovinata!)"

# game/script.rpy:3210
translate ita ch6_d13ffbb7:

    # w sorry "(But that's a risk worth taking... isn't it...?)"
    w sorry "(Ma è un rischio che vale la pena prendere... giusto...?)"

# game/script.rpy:3219
translate ita ch6_dad1a362:

    # n "That night... Periwinkle laid on the floor in the middle of his living room and waited."
    n "Quella sera... Periwinkle resta disteso sul pavimento nel mezzo del suo salotto ad aspettare."

# game/script.rpy:3221
translate ita ch6_83701cac:

    # w shutin neutral "...."
    w shutin neutral "...."

# game/script.rpy:3222
translate ita ch6_82a844cb:

    # w empty "(I'd expected this night to come eventually, and yet... I still don't feel any more prepared for it.)"
    w empty "(Mi aspettavo che sarebbe venuto stasera, eppure... non mi sento ancora pronto.)"

# game/script.rpy:3224
translate ita ch6_0b065d30:

    # n "Periwinkle idly taps his wand to one of the candles on the table."
    n "Periwinkle dà un colpetto pigro con la bacchetta alla candela sul tavolo."

# game/script.rpy:3225
translate ita ch6_b971b49b:

    # w shutin oops "...Still peachy. The curse is not yet lifted."
    w shutin oops "...Ancora pesca. La maledizione non è stata rimossa."

# game/script.rpy:3227
translate ita ch6_b7ed660b:

    # n "Pastille's knock finally comes, and Periwinkle rises to answer."
    n "Pastille finalmente bussa alla porta, e Periwinkle si alza per rispondere."

# game/script.rpy:3233
translate ita ch6_7f645bd4:

    # p "Oh, it smells nice in here. Is that your magic?"
    p "Oh, che buon odore qui dentro. È la tua magia?"

# game/script.rpy:3234
translate ita ch6_c6202711:

    # w shutin innocent "You like it? It's my latest specialty 💙"
    w shutin innocent "Ti piace? È la mia ultima specialità 💙"

# game/script.rpy:3235
translate ita ch6_d842efac:

    # p happy "Aww, what a treat!"
    p happy "Aww, che delizia!"

# game/script.rpy:3237
translate ita ch6_2d39236d:

    # p smile "Have you eaten yet? I could make us a special dinner."
    p smile "Hai già mangiato? Potrei preparare una cenetta speciale."

# game/script.rpy:3238
translate ita ch6_43c03053:

    # w my "Oh~ what's the occasion?"
    w my "Oh~ cosa festeggiamo?"

# game/script.rpy:3239
translate ita ch6_cdb2e25e:

    # p ehe "Celebrating the fact nothing went horribly wrong today. I brought a few things, if I could just borrow your stove..."
    p ehe "Il fatto che nulla è andato storto oggi. Ho portato un paio di cose, mi servirebbe solo prendere in prestito il tuo piano cottura..."

# game/script.rpy:3240
translate ita ch6_ccea5b7d:

    # w innocent "By all means~"
    w innocent "Accomodati~"

# game/script.rpy:3243
translate ita ch6_b1a59605:

    # "I once again found myself in the excruciatingly domestic situation of watching Pastille prepare a meal in my kitchen."
    "Mi trovavo ancora una volta nella situazione dannatamente domestica di guardar Pastille preparare da mangiare nella mia cucina."

# game/script.rpy:3244
translate ita ch6_27f276dd:

    # "There's no way he doesn't realize it, right? That we've been acting as a couple for a long time now..."
    "Non è possibile che non se ne sia accorto, vero? Che è da un bel po' che ci comportiamo come una coppia ormai..."

# game/script.rpy:3245
translate ita ch6_64b1117b:

    # "It's just that neither of us have bothered to address it."
    "È che nessuno di noi si è preoccupato di affrontare il problema."

# game/script.rpy:3246
translate ita ch6_11c05150:

    # "Shouldn't it be properly acknowledged...?"
    "Non dovremmo prenderne atto come si deve...?"

# game/script.rpy:3247
translate ita ch6_a15243f7:

    # nvl clear
    # "Pastille chats with me as he cooks, but I'm admittedly distracted by these thoughts."
    nvl clear
    "Pastille chiacchiera con me mentre cucina, ma ammetto di essere distratto da questi pensieri."

# game/script.rpy:3249
translate ita ch6_8b6ec33b:

    # "Perhaps putting a name to it would only cause it to unravel..."
    "Forse dare un nome alla relazione rovinerebbe tutto e basta..."

# game/script.rpy:3250
translate ita ch6_fed127ba:

    # "Currently, there's no expectation. We're free to see whoever else we like."
    "Al momento, non ci sono aspettative. Siamo liberi di vederci con chiunque altro ci piaccia."

# game/script.rpy:3251
translate ita ch6_588f3995:

    # "Though... it doesn't seem either of us are doing that."
    "Anche se... sembra che nessuno dei due lo stia facendo."

# game/script.rpy:3252
translate ita ch6_7d13798e:

    # nvl clear
    # n "Pastille approaches the table where Periwinkle sits, holding a plate in each hand."
    nvl clear
    n "Pastille si avvicina al tavolo dove è seduto Periwinkle, tenendo un piatto in ogni mano."

# game/script.rpy:3258
translate ita ch6_45d7faef:

    # p "Ta-da~ Pasta's ready."
    p "Ta-da~ La pasta è pronta."

# game/script.rpy:3259
translate ita ch6_10cdcc29:

    # w shutin happy "Ooh, bon appétit 💙"
    w shutin happy "Ooh, bon appétit 💙"

# game/script.rpy:3262
translate ita ch6_0e94caa2:

    # "Maybe he's already decided we're a couple, and I'm just obsessing over formalities."
    "Forse ha già deciso che siamo una coppia, e mi sto solo fissando su delle formalità."

# game/script.rpy:3263
translate ita ch6_b80eb0a1:

    # "What does it matter, so long as the two of us are happy?"
    "E che importa, finché siamo entrambi felici?"

# game/script.rpy:3264
translate ita ch6_e81d99d4:

    # "And I really AM happy..."
    "E io sono DAVVERO felice..."

# game/script.rpy:3265
translate ita ch6_a91d3dfd:

    # "His cooking... tastes wonderful...."
    "La sua cucina... è fantastica...."

# game/script.rpy:3266
translate ita ch6_76b2fe88_8:

    # nvl clear
    nvl clear

# game/script.rpy:3269
translate ita ch6_41880f7f:

    # p "...Peri? You okay?"
    p "...Peri? Stai bene?"

# game/script.rpy:3270
translate ita ch6_94ce811b:

    # w shutin ah "Hm? Yes...?"
    w shutin ah "Hm? Sì...?"

# game/script.rpy:3271
translate ita ch6_a057a474:

    # p ehe "You were being so quiet, I started to worry that I messed up our dinner somehow..."
    p ehe "Eri così silenzioso, che ho iniziato a preoccuparmi di aver incasinato la cena in qualche modo... "

# game/script.rpy:3272
translate ita ch6_05d526a2:

    # w guilty "No, no... it's delicious!"
    w guilty "No, no... è delizioso!"

# game/script.rpy:3273
translate ita ch6_8f95049d:

    # w smile "I was just lost in the pasta, is all. Forgive me, I didn't mean to worry you."
    w smile "Mi ero solamente perso nella pasta. Perdonami, non volevo farti preoccupare."

# game/script.rpy:3276
translate ita ch6_bc3ffb32:

    # "I need to get out of my own head."
    "Devo uscire dalla mia testa."

# game/script.rpy:3277
translate ita ch6_4781f2a1:

    # "Pastille is here in front of me! And I'm too distracted to savor it...!"
    "Pastille è qui davanti a me! E sono troppo distratto per godermelo...!"

# game/script.rpy:3278
translate ita ch6_36793aff:

    # "Forget my doubts. We'll just have to see where the night takes us..."
    "Dimenticherò i miei dubbi. Dovremo soltanto vedere dove ci porta la notte..."

# game/script.rpy:3279
translate ita ch6_8abc74f1:

    # nvl clear
    # n "Periwinkle takes his plate to the sink and begins to wash up."
    nvl clear
    n "Periwinkle porta il suo piatto al lavandino e inizia a lavarlo."

# game/script.rpy:3283
translate ita ch6_3e0f9893:

    # p wha "Ah--I can take care of that!"
    p wha "Ah--posso occuparmene io!"

# game/script.rpy:3284
translate ita ch6_e738bebe:

    # w love "Nonsense, you just cooked us dinner! It's your turn to relax, my sweet 💙"
    w love "Che sciocchezza, hai appena cucinato! È il tuo turno di rilassarti, dolcezza 💙"

# game/script.rpy:3285
translate ita ch6_56c4b6d1:

    # p shy "Are you sure I can't help...? I wouldn't mind at all...."
    p shy "Sicuro che non possa aiutarti...? Non mi darebbe affatto fastidio...."

# game/script.rpy:3286
translate ita ch6_bc36cfb7:

    # w calm "You can help by bringing me your plate when you're finished."
    w calm "Puoi aiutarmi portandomi il tuo piatto quando hai finito."

# game/script.rpy:3287
translate ita ch6_c83acea9:

    # p ehe "Okaaay...."
    p ehe "Okaaay...."

# game/script.rpy:3290
translate ita ch6_4911fe5a:

    # n "Pastille does as he's told, then wanders over to the couch."
    n "Pastille fa come gli è stato detto, e poi cammina fino al divano."

# game/script.rpy:3293
translate ita ch6_e34ed609:

    # p "Hey, um..."
    p "Hey, um..."

# game/script.rpy:3294
translate ita ch6_fe1d1ce2:

    # p "If you have anyone you want to introduce me to, I'd be happy to meet them. Return the favor, sort of thing."
    p "Se hai qualcuno a cui vuoi presentarmi, sarei felice di conoscerli. Per ricambiare il favore, tipo."

# game/script.rpy:3296
translate ita ch6_bbf226dc:

    # p "I-I know it can be awkward though, so... if not, that's okay too...."
    p "S-so che può essere imbarazzante però, quindi... se non ne hai, va bene lo stesso...."

# game/script.rpy:3297
translate ita ch6_6753e7b3:

    # w "Hm... no, no one comes to mind."
    w "Hm... no, non mi viene nessuno in mente."

# game/script.rpy:3298
translate ita ch6_a367466f:

    # p "...Huh? Really?"
    p "...Huh? Davvero?"

# game/script.rpy:3299
translate ita ch6_6e2dd70d:

    # w "Sure, I know a lot of people. But I couldn't say I'm particularly close with any of them..."
    w "Certo, conosco molte persone. Ma non direi di essere particolarmente vicino a nessuna di esse..."

# game/script.rpy:3301
translate ita ch6_8585d2d5:

    # w "Except maybe one? But you've already met my business partner."
    w "A parte una, forse? Ma hai già incontrato la mia socia d'affari."

# game/script.rpy:3302
translate ita ch6_0aad42dd:

    # p "Oh! At the apothecary, right?"
    p "Oh! Alla farmacia, giusto?"

# game/script.rpy:3304
translate ita ch6_05485f5a:

    # w "Precisely."
    w "Precisamente."

# game/script.rpy:3305
translate ita ch6_d5c67421_1:

    # p "...."
    p "...."

# game/script.rpy:3307
translate ita ch6_01f6d082:

    # w "Hm~? What's with that look."
    w "Hm~? Come mai quella faccia."

# game/script.rpy:3309
translate ita ch6_c50b5f2b:

    # p "N-no, nothing... I just don't know what to say now."
    p "N-no, nulla... non so cosa dire ora."

# game/script.rpy:3310
translate ita ch6_1af14dea:

    # w "Hmhm, you expected someone as charismatic as me to have all sorts of new people to introduce you to, then?"
    w "Hmhm, ti aspettavi che qualcuno di carismatico come me avesse ogni sorta di persone nuove a cui presentarti, allora?"

# game/script.rpy:3311
translate ita ch6_9e2f690d:

    # p "I guess so. I'm just surprised..."
    p "Suppongo di sì. Sono solo sorpreso..."

# game/script.rpy:3312
translate ita ch6_e3fe1cd7:

    # p "I, um, really like... being around you... so I expected that to be true for your other friends, too."
    p "Mi, um, piace molto... stare con te... quindi mi aspettavo lo stesso dagli altri tuoi amici."

# game/script.rpy:3313
translate ita ch6_81608c29:

    # w "Hmm..."
    w "Hmm..."

# game/script.rpy:3315
translate ita ch6_04156cdb:

    # w "I'd say you're probably the closest I've ever been with someone."
    w "Direi che tu sei il più vicino che sia mai stato con qualcuno."

# game/script.rpy:3316
translate ita ch6_291e005a:

    # w "...Literally speaking."
    w "...Letteralmente parlando."

# game/script.rpy:3320
translate ita ch6_ba9915e5:

    # n "They laugh together, then fall into a comfortable silence..."
    n "Ridono insieme, e poi cadono in un dolce silenzio..."

# game/script.rpy:3321
translate ita ch6_34bec6e3:

    # n "With their heads leaned together, Periwinkle nuzzles his face into Pastille's shoulder affectionately."
    n "Con le loro teste una contro l'altra, Periwinkle strofina la faccia sulla spalla di Pastille in modo affettuoso."

# game/script.rpy:3322
translate ita ch6_7680a727:

    # n "After a few moments, Pastille asks..."
    n "Dopo qualche momento, Pastille chiede..."

# game/script.rpy:3325
translate ita ch6_7e4e52b8:

    # p "Do you... wanna get in bed?"
    p "Vuoi... andare a letto?"

# game/script.rpy:3326
translate ita ch6_08b40548:

    # w shutin teehee "For sleep, or for pleasure?"
    w shutin teehee "Per sonno, o per piacere?"

# game/script.rpy:3327
translate ita ch6_275c3be8:

    # p omg "U-um, that's up to you...!" with vpunch
    p omg "U-um, questo spetta a te...!" with vpunch

# game/script.rpy:3329
translate ita ch6_1609c48e:

    # n "Periwinkle stands, then turns around to take Pastille's hands."
    n "Periwinkle si alza, poi si gira per prendere la mano di Pastille."

# game/script.rpy:3330
translate ita ch6_a6d0b21a:

    # w shutin "Come, then."
    w shutin "Vieni, allora."

# game/script.rpy:3335
translate ita ch6_e0c4b6a5:

    # n "He leads him into the bedroom, closing the door behind them."
    n "Lo porta in camera da letto, chiudendo la porta dietro di loro."

# game/script.rpy:3336
translate ita ch6_17bd39fe:

    # n "When he does, Pastille speaks up again..."
    n "Quando lo fa, Pastille parla di nuovo..."

# game/script.rpy:3339
translate ita ch6_90e29b25:

    # p "You know... I'm still finding it hard to believe there's no one else you're close to."
    p "Sai... trovo ancora difficile da credere che non c'è nessun'altro a cui sei vicino."

# game/script.rpy:3340
translate ita ch6_25de1dd0:

    # w shutin "Hm~? Two is a reasonable number."
    w shutin "Hm~? Due è un buon numero."

# game/script.rpy:3341
translate ita ch6_48ef453d:

    # w calm "You had two friends as well, did you not? Syrup and Gumdrop."
    w calm "Anche tu hai due amici, no? Syrup e Gumdrop."

# game/script.rpy:3342
translate ita ch6_dcd034df:

    # p sure "Fair point... but counting YOU makes three."
    p sure "Giusta osservazione... ma contando TE sono tre."

# game/script.rpy:3343
translate ita ch6_1da53c55:

    # w love "Ah, you have me beat. Perhaps I should try harder to catch up."
    w love "Ah, mi hai battuto. Forse dovrei impegnarmi di più per raggiungerti."

# game/script.rpy:3346
translate ita ch6_c5a565be:

    # n "Periwinkle collapses into bed, while Pastille sits down beside him."
    n "Periwinkle collassa sul letto, mentre Pastille si siede vicino a lui."

# game/script.rpy:3349
translate ita ch6_85981fc3:

    # w "I think I've preferred it, though. Keeping a healthy distance from others..."
    w "Penso di preferirlo, però. Mantenere una distanza salutare dagli altri..."

# game/script.rpy:3350
translate ita ch6_43989462:

    # p "Really? How come?"
    p "Davvero? Come mai?"

# game/script.rpy:3351
translate ita ch6_a40f3b27:

    # w "The alternative has been disastrous in my experience. I'm far too intense."
    w "L'alternativa è stata disastrosa nella mia esperienza. Sono troppo intenso."

# game/script.rpy:3352
translate ita ch6_c4dfb99a:

    # p "Ha, what do you mean by THAT...?"
    p "Ha, cosa intendi con QUELLO...?"

# game/script.rpy:3353
translate ita ch6_d85fd387:

    # w "Goodness, my best example is the worst one..."
    w "Santo cielo, il mio migliore esempio è il peggiore..."

# game/script.rpy:3355
translate ita ch6_0c4b9b3e:

    # w "In my teenage years... there was a boy I would've done anything for."
    w "Nei miei anni da teenager... c'era un ragazzo per il quale avrei fatto di tutto."

# game/script.rpy:3356
translate ita ch6_567cfdcb:

    # w "I wanted his approval so badly. I wanted to be loved."
    w "Volevo la sua approvazione così disperatamente. Volevo essere amato."

# game/script.rpy:3357
translate ita ch6_53f3ef0f:

    # w "...It's funny, I can't even think of what drew me to him."
    w "...È ironico, non mi ricordo nemmeno che cosa mi attrasse a lui."

# game/script.rpy:3359
translate ita ch6_b214fa05:

    # w "I suppose he was just a vessel to project onto. An idealized boyfriend, this... shortcut to happiness."
    w "Suppongo fosse solo un contenitore su cui proiettare quello che volevo. Un fidanzato idealizzato, questa... scorciatoia per la felicità."

# game/script.rpy:3360
translate ita ch6_1201679b:

    # w "Hmhm... poor guy. He didn't know what to do with the torrent of feelings I'd been forcing onto him. We were young."
    w "Hmhm... poverino. Non sapeva che fare del fiume di sentimenti che gli stavo imponendo. Eravamo giovani."

# game/script.rpy:3361
translate ita ch6_7ae36a53:

    # w "A love like that is much too painful. If it can even be called love...."
    w "Un amore come quello è davvero troppo doloroso. Se può essere chiamato amore...."

# game/script.rpy:3363
translate ita ch6_4235f80c:

    # w "It took some practice to be able to separate the emotions out."
    w "Ci volle del tempo per imparare a separare le emozioni."

# game/script.rpy:3364
translate ita ch6_094487a5:

    # w "To be able to indulge in the romantic and sexual energy I craved, while protecting my fragile heart..."
    w "Per essere capace di assecondare la mia brama di energia romantica e sessuale, proteggendo nel mentre il mio cuore fragile..."

# game/script.rpy:3365
translate ita ch6_c9592a6d:

    # w "But, ever since I figured it out, I've gotten to experience all sorts of love through these casual flings~"
    w "Ma, da quando ho capito come riuscirci, Ho potuto sperimentare ogni sorta di amore attraverso queste scappatelle~"

# game/script.rpy:3366
translate ita ch6_bd22f0ce:

    # w "(What am I saying...?)"
    w "(Che sto dicendo...?)"

# game/script.rpy:3367
translate ita ch6_b87e6b7a:

    # w "It's perfect for me 💙 The ideal life, really."
    w "È perfetto per me 💙 La vita ideale, davvero."

# game/script.rpy:3368
translate ita ch6_694c6d8c:

    # w "(Don't listen to me, Pastille....)"
    w "(Non ascoltarmi, Pastille....)"

# game/script.rpy:3373
translate ita ch6_a29244df:

    # p "Hmm..."
    p "Hmm..."

# game/script.rpy:3374
translate ita ch6_884754a7:

    # p smile "I don't know if your heart is as fragile as you think."
    p smile "Non sono sicuro che il tuo cuore sia fragile come dici."

# game/script.rpy:3375
translate ita ch6_cb22988c:

    # w shutin love "You don't believe me? Despite what it seems, I have the heart of an innocent maiden~!"
    w shutin love "Non mi credi? Nonostante quello che può sembrare, ho il cuore di una damigella innocente~!"

# game/script.rpy:3376
translate ita ch6_1dece50f:

    # p sure "Haha, I don't know about innocent, but..."
    p sure "Haha, non so sull'\"innocente\", ma..."

# game/script.rpy:3380
translate ita ch6_ea6c8d9d:

    # n "Pastille leans forward and lays his head on Periwinkle's chest."
    n "Pastille si piega in avanti e poggia la testa sul petto di Periwinkle."

# game/script.rpy:3381
translate ita ch6_192176bb:

    # p "...Sounds pretty strong to me."
    p "...A me sembra abbastanza forte."

# game/script.rpy:3382
translate ita ch6_075d682d:

    # w "...!!"
    w "...!!"

# game/script.rpy:3384
translate ita ch6_77261c10:

    # p "Ah, it's beating harder now."
    p "Ah, sta accelerando."

# game/script.rpy:3386
translate ita ch6_51fe2183:

    # w "B-because you suddenly embraced me! See, this is what I mean by fragile...!" with vpunch
    w "P-perché mi hai abbracciato improvvisamente! Vedi, è questo che intendo per fragile...!" with vpunch

# game/script.rpy:3389
translate ita ch6_afbec36c:

    # n "Periwinkle struggles out from under him, and the pair sits facing each other on the bed."
    n "Periwinkle si libera da sotto di lui, e il duo si siede sul letto guardandosi l'un l'altro in faccia."

# game/script.rpy:3392
translate ita ch6_f8a67d56:

    # p "You know... at first, I thought romantic stuff was just a formality for you. But you actually love it, huh?"
    p "Sai... all'inizio, pensavo che la roba romantica fosse solo una formalità per te. Ma la adori davvero, huh?"

# game/script.rpy:3393
translate ita ch6_9c15c768:

    # w shutin love "Are you only realizing that NOW?"
    w shutin love "E lo stai capendo solo ORA?"

# game/script.rpy:3394
translate ita ch6_35b3829b:

    # p ehe "Haha, I guess not...."
    p ehe "Haha, immagino di no...."

# game/script.rpy:3398
translate ita ch6_d170010a:

    # "What are you trying to say, Pastille?"
    "Cosa stai cercando di dirmi, Pastille?"

# game/script.rpy:3399
translate ita ch6_736befba:

    # "That it's okay for me to love you...?"
    "Che va bene per me amarti...?"

# game/script.rpy:3400
translate ita ch6_310f8fb1:

    # "That I'll be safe?"
    "Che sarò al sicuro?"

# game/script.rpy:3401
translate ita ch6_76b2fe88_9:

    # nvl clear
    nvl clear

# game/script.rpy:3404
translate ita ch6_94871324:

    # w "Then, hurry up and kiss me."
    w "Allora sbrigati e baciami."

# game/script.rpy:3406
translate ita ch6_4a8350ae:

    # p "Okay ❤ Sorry to keep you waiting."
    p "Okay ❤ Mi scuso per l'attesa."

# game/script.rpy:3408
