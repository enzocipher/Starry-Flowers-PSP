translate ita ch4_9b3a7e5d:

    # "After watching them for a while, I turn back to Pastille."
    "Dopo averli osservati per un po', mi giro verso Pastille."

# game/script.rpy:2137
translate ita ch4_76b2fe88_11:

    # nvl clear
    nvl clear

