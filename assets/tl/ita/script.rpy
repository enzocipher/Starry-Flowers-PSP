    # n "Periwinkle scurries back to his bedroom to change, while Pastille waits politely by the door."
    n "Periwinkle corre in camera sua per cambiarsi, mentre Pastille attende davanti alla porta."

# game/script.rpy:1698
translate ita ch4_75f30f98:

    # w decent guilty "So, your day off, hm...? And you chose to visit ME? I'm flattered 💙"
    w decent guilty "Quindi, il tuo giorno libero, hm...? E hai deciso di venire a trovare ME? Sono lusingato 💙"

# game/script.rpy:1699
translate ita ch4_1fb7729e:

    # p ehe "Well, it's not just to visit... I was hoping to, um... take you on a date?"
    p ehe "Beh, non è solo per farti visita... Speravo di poter, um... uscire con te?"

# game/script.rpy:1700
translate ita ch4_e40ce8d7:

    # w my "Ooh, a date~? Usually we've reserved those for dinnertime, haven't we?"
    w my "Ooh, un appuntamento~? Di solito usciamo solo per andare a cena, no?"

# game/script.rpy:1701
translate ita ch4_bd8f092f:

    # p shy "I-I wanted to make up for yesterday."
    p shy "V-volevo compensare per ieri."

# game/script.rpy:1702
