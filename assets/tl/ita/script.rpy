    # n "But he doesn't. Instead, he buries his face in the cushions and falls asleep..."
    n "Ma non lo fa. Invece, affonda la faccia nei cuscini del divano e si addormenta..."

# game/script.rpy:1658
translate ita ch4_7b49a2da:

    # centered "{w=3}{nw}"
    centered "{w=3}{nw}"

