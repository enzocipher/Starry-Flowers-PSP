    # n "Periwinkle begins pacing around the room."
    n "Periwinkle inizia a fare avanti e indietro per la stanza."

# game/script.rpy:2982
translate ita ch6_ee66677e:

    # "Now, now... let's not get carried away."
    "Ok, ok... non facciamoci trascinare."

# game/script.rpy:2983
translate ita ch6_da436e71:

    # "This is a delicate situation. Dropping these intense feelings onto him out of nowhere may only serve to scare him off."
    "È una situazione delicata. Lanciargli addosso tutti questi sentimenti intensi dal nulla potrebbe spaventarlo e basta."

# game/script.rpy:2984
translate ita ch6_9440b0fe:

    # "Neither of us was looking for a committed relationship from the beginning--that was made explicitly clear early on!"
    "Nessuno di noi due era alla ricerca di una relazione seria--l'abbiamo detto esplicitamente sin dall'inizio!"

# game/script.rpy:2985
translate ita ch6_43ab76b1:

    # "And yet... and yet...!"
    "Eppure... eppure...!"

# game/script.rpy:2986
translate ita ch6_6333e45c:

    # nvl clear
    # w nofair2 "He isn't playing fair...! My heart can't take this!"
    nvl clear
    w nofair2 "Non è giusto...! Il mio cuore non può sopportarlo!"

# game/script.rpy:2989
translate ita ch6_027ff050:

    # n "Periwinkle throws himself onto the couch dramatically."
    n "Periwinkle si butta sul divano drammaticamente."

# game/script.rpy:2990
translate ita ch6_e25e9729:

    # w pj yell "There's no way I'll be able to stop thinking of him now... even being at home has become a reminder in and of itself...!"
    w pj yell "Non c'è modo di smettere di pensarci ora... anche stare a casa è diventato qualcosa che mi ricorda di lui...!"

# game/script.rpy:2991
translate ita ch6_08637e4e:

    # w nofair "Everything is nice because of him! And now I'm suffering...!!"
    w nofair "È tutto così bello per colpa sua!! E ora soffro...!!"

# game/script.rpy:2993
translate ita ch6_c2595cfb:

    # "This is simply too much..."
    "È davvero troppo..."

# game/script.rpy:2994
translate ita ch6_b7a26f25:

    # "There has to be a way for me to safely indulge in these romantic feelings."
    "Ci dev'essere un modo di assecondare questi sentimenti romantici in modo sicuro."

# game/script.rpy:2995
translate ita ch6_f0e953fa:

    # "Things are fine as they are. Progressing, even."
    "Le cose vanno bene come sono ora. Stanno anche progredendo."

# game/script.rpy:2996
translate ita ch6_8a9f8371:

    # "If I just let it run its natural course, then maybe we'll end up..."
    "Se lascio che seguano il loro corso naturale, forse finiremo..."

# game/script.rpy:2997
translate ita ch6_74c39862:

    # nvl clear
    # "Ah... what do I want out of this?"
    nvl clear
    "Ah... che cosa voglio da tutto questo?"

# game/script.rpy:2999
translate ita ch6_d0086124:

    # "To be with him forever? ME?!"
    "Stare con lui per sempre? ME?!"

# game/script.rpy:3000
translate ita ch6_54531ff3:

    # "I haven't had a single healthy long-term relationship in my entire life! Love isn't in the cards for someone like me..."
    "Non ho avuto una singola relazione salutare a lungo termine in tutta la mia vita! L'amore non fa per qualcuno come me... "

# game/script.rpy:3001
translate ita ch6_de6de606:

    # "Ugh, I... I can't even recognize myself right now...!"
    "Ugh, io... non mi riconosco nemmeno ora...!"

# game/script.rpy:3002
translate ita ch6_c71bbc8b:

    # nvl clear
    # w decline "*sigh* ...Calm down."
    nvl clear
    w decline "*sigh* ...Calmati."

# game/script.rpy:3004
translate ita ch6_e31dafc0:

    # w neutral "I'm overreacting again. Nothing has effectively changed just yet."
    w neutral "Sto esagerando di nuovo. Niente è cambiato per ora."

# game/script.rpy:3006
translate ita ch6_ac683799:

    # "I can't keep fighting myself on this..."
    "Non posso continuare a combattermi su tutto questo..."

# game/script.rpy:3007
translate ita ch6_58b7973a:

    # "I'm in love with Pastille--No matter what it entails, that's the reality."
    "Sono innamorato di Pastille--Non importa cosa possa comportare, è questa la realtà."

# game/script.rpy:3008
translate ita ch6_77ae6378:

    # "He still isn't quite ready for me to meet his friends, which means... there isn't any room to advance further at the moment."
    "Non è ancora pronto per farmi incontrare i suoi amici, il che significa... che non c'è spazio per far avanzare la nostra relazione al momento."

# game/script.rpy:3009
translate ita ch6_82b36bbd:

    # "I have to be patient."
    "Devo essere paziente."

# game/script.rpy:3010
translate ita ch6_1b1e1fde:

    # nvl clear
    # w empty "At the very least, I hope accepting all this lets my magic return to normal..."
    nvl clear
    w empty "Come minimo, spero che l'averlo accettato faccia in modo che la mia magia torni normale..."

# game/script.rpy:3012
