    # p omg "O-okay...! Lead the way...."
    p omg "O-okay...! Fai strada..."

# game/script.rpy:399
translate ita start_a3c06338:

    # "I truly didn't expect it..."
    "Non me lo aspettavo affatto..."

# game/script.rpy:400
translate ita start_f7e871b8:

    # "He definitely seemed the type to have a more modest sense of style."
    "Sembrava davvero il tipo da avere uno stile un po' più modesto."

# game/script.rpy:401
translate ita start_92955daf:

    # "Thigh highs, with such a short skirt? Or was it a dress...? I only briefly glimpsed it."
    "Calze lunghe, con una gonna così corta? O sarà un vestito...? L'ho intravisto soltanto per un secondo."

# game/script.rpy:402
translate ita start_da91d2ff:

    # "I'm quite looking forward to seeing more tonight 💙"
    "Sono davvero impaziente di vederne di più stasera 💙"

# game/script.rpy:403
translate ita start_76b2fe88:

    # nvl clear
    nvl clear

# game/script.rpy:411
translate ita start_f9685e80:

    # "The restaurant I decided on is one in my usual rotation. Good for a quiet, comfortable evening."
    "Il ristorante che ho scelto è nella mia solita rotazione. Ottimo per una serata calma e confortevole."

# game/script.rpy:412
translate ita start_ec15e064:

    # "For a variety of dates, you must have a variety of locations in mind! Tonight's mood is... ~Romantic Rendezvous~"
    "Per un'ampia scelta di appuntamenti, devi avere diverse location in mente! Il tema di stasera è... ~Incontro romantico~ "

# game/script.rpy:413
translate ita start_86384255:

    # "It's a little high-end, though not overtly so. Just enough to make the night feel special 💙"
    "É un po' raffinato, ma non troppo. Quanto basta per far sì che la serata sia speciale 💙"

# game/script.rpy:414
translate ita start_76b2fe88_1:

    # nvl clear
    nvl clear

# game/script.rpy:417
translate ita start_95b9df83:

    # n "Pastille slides into the booth, following Periwinkle's lead."
    n "Pastille scivola nel suo posto, seguendo Periwinkle."

# game/script.rpy:418
translate ita start_ac7632e0:

    # n "One hand holds his mantle in place, while the other brushes his bangs aside anxiously..."
    n "Con una mano si mantiene il mantiello, mentre con l'altra si sposta ansiosamente la frangia sul lato..."

# game/script.rpy:419
translate ita start_21398492:

    # w smile "Is this your first time?"
    w smile "É la tua prima volta?"

# game/script.rpy:420
translate ita start_db90c8f0:

    # p wha "Huh...?"
    p wha "Huh...?"

# game/script.rpy:421
translate ita start_c33cac40:

    # w happy "Coming here, I mean. What did you think I was asking~?"
    w happy "A venire qui, dico. Cos'altro pensavi stessi chiedendo~?"

# game/script.rpy:422
translate ita start_6a4783ff:

    # p embarrassed "Ah--! Haha... no, nothing...."
    p embarrassed "Ah--! Haha... no, nulla..."

# game/script.rpy:423
translate ita start_00f05a14:

    # p neutral "I've never been here before. It seems fancy."
    p neutral "Non sono mai stato qui prima. Sembra elegante."

# game/script.rpy:424
translate ita start_f4e0eba9:

    # w calm "I'm a fan of the atmosphere. The food isn't bad, either."
    w calm "Mi piace l'atmosfera. E nemmeno il cibo è male."

# game/script.rpy:426
translate ita start_db213eb7:

    # w smile "Now, let's get a few formalities out of the way, shall we? First and foremost... your pronouns?"
    w smile "Ora, liberiamoci di alcune formalità, che ne pensi? Prima di tutto... i tuoi pronomi?"

# game/script.rpy:427
translate ita start_a5b368da:

    # p oh "Oh, um, I just use he/him. What about you?"
    p oh "Oh, um, Uso quelli maschili. E tu?"

# game/script.rpy:428
translate ita start_e13d1dc4:

    # w calm "The same. Though I don't necessarily mind being called by others... especially considering my presentation."
    w calm "Lo stesso. Anche se non mi da fastidio che ci si riferisca a me usandone altri... specialmente considerando la mia presentazione."

# game/script.rpy:429
translate ita start_22814ee5:

    # p ehe "Aha, understandable..."
    p ehe "Aha, comprensibile..."

# game/script.rpy:430
translate ita start_1fb598dd:

    # w smile "Next, expectations. I consider clarity in this regard to be a key part of ensuring we both enjoy ourselves to the fullest."
    w smile "Poi, aspettative. Considero far chiarezza su queste fondamentale affinché possiamo divertirci entrambi al massimo."

# game/script.rpy:431
translate ita start_9ddac06c:

    # w "I do this sort of thing often, you see. As such, I have a couple of ground rules to establish."
    w "Vedi, faccio questo genere di cosa spesso. E quindi, ho un paio di regole da stabilire."

# game/script.rpy:433
translate ita start_d94542f4:

    # p smile "Sure. I'm actually glad you brought it up..."
    p smile "Ma certo. In realtà sono contento che tu l'abbia detto..."

# game/script.rpy:434
translate ita start_cb1d6efd:

    # w oh "Oh?"
    w oh "Oh?"

# game/script.rpy:435
translate ita start_140c840a:

    # p ehe "I'm not looking for anything serious. In fact, I kinda prefer when it's just a one-night thing..."
    p ehe "Non cerco niente di serio. Difatti, Preferisco quando è solo una cosa da una notte..."

# game/script.rpy:436
translate ita start_4711c7fe:

    # w innocent "Hmhm, we're on the very same page then!"
    w innocent "Hmhm, siamo d'accordo allora!"

# game/script.rpy:437
translate ita start_c6c6b93b:

    # p shy "Um, not that I mind if... y'know. We end up wanting to do this again some other time."
    p shy "Um, non che mi dia fastidio se... sai. Finisce che vogliamo farlo di nuovo qualche altra volta."

# game/script.rpy:438
translate ita start_8df12252:

    # w drool "(That's quite likely for me, in this case...)"
    w drool "(Ed è molto probabile per me, in questo caso...)"

# game/script.rpy:439
translate ita start_3f4a3176:

    # w happy "Certainly! I'm open to that as well."
    w happy "Certamente! Sono aperto anche a quello."

# game/script.rpy:440
translate ita start_d287ebe0:

    # p um "Did you have... any other ground rules? Sorry, I didn't mean to cut you off..."
    p um "Hai... altre regole? Perdonami, non volevo interromperti..."

# game/script.rpy:441
translate ita start_0c30cc41:

    # w smile "Are you nervous?"
    w smile "Sei nervoso?"

# game/script.rpy:442
translate ita start_275debba:

    # p nervous "Y...yes...."
    p nervous "S...sì...."

# game/script.rpy:443
translate ita start_715412b4:

    # w calm "You can tell me to stop if you're ever feeling too overwhelmed. That's the other rule."
    w calm "Puoi dirmi di fermarmi se ti senti troppo agitato. Questa è l'altra regola."

# game/script.rpy:444
translate ita start_62d8969b:

    # p ohno "I, um..."
    p ohno "Io, um..."

# game/script.rpy:445
translate ita start_2a3aa3d6:

    # w smile "...?"
    w smile "...?"

# game/script.rpy:446
translate ita start_b1edeb82:

    # p embarrassed "I like... feeling overwhelmed. T-to an extent."
    p embarrassed "Mi piace... sentirmi agitato. F-fino a un certo punto."

# game/script.rpy:447
translate ita start_2164c6c3:

    # w love "(I had assumed as much, but to hear you admit it outright...! Ah, Pastille! 💙)"
    w love "(Lo avevo già intuito, ma sentirtelo ammettere così...! Ah, Pastille! 💙)"

# game/script.rpy:448
translate ita start_d8ad86c7:

    # w teehee "In that case, I'll do my best to overwhelm you, my sweet~"
    w teehee "In questo caso, farò del mio meglio per agitarti, dolcezza~"

# game/script.rpy:449
translate ita start_a9e27c65:

    # p omg "A-AH...." with vpunch
    p omg "A-AH...." with vpunch

# game/script.rpy:454
translate ita start_35081bb5:

    # "Yes, this was shaping up to be a wonderful night indeed."
    "Sì, si preannunciava essere proprio una serata stupenda."

# game/script.rpy:455
translate ita start_cf4b36ae:

    # "The waiter came to take our order. I went first, to give my sweet date a chance to compose himself."
    "Il cameriere venne a prendere il nostro ordine. Io andai per primo, per dare al mio dolce accompagnatore il tempo di ricomporsi."

# game/script.rpy:456
translate ita start_d9753442:

    # "With our food ordered, Pastille finally drops his mantle to reveal..."
    "Una volta ordinati i nostri piatti, Pastille finalmente si toglie il mantello, rivelando..."

# game/script.rpy:457
translate ita start_76b2fe88_2:

    # nvl clear
    nvl clear

# game/script.rpy:460
translate ita start_462aa618:

    # w drool "(My, my...! So it was a cute little dress after all!)"
    w drool "(Oh cielo...! E quindi alla fine era un vestitino!)"

# game/script.rpy:462
translate ita start_17819f40:

    # w happy "Oh~ and here I thought you were saving the surprise for AFTER dinner!"
    w happy "Oh~ e io che pensavo volessi lasciare la sorpresa per DOPO cena!"

# game/script.rpy:463
translate ita start_2fff06b6:

    # p ehe "Sorry, um... I started feeling awkward with the extra layer...."
    p ehe "Scusa, um... mi sentivo un po' a disagio con tutto quello addosso..."

# game/script.rpy:464
translate ita start_6210c123:

    # w love "Don't apologize~ My only lament is not getting to take it off you myself 💙"
    w love "Non scusarti~ Il mio unico rimpianto è non essere stato io a togliertelo 💙"

# game/script.rpy:465
translate ita start_31907a91_1:

    # p kyaa "A-AH...!" with vpunch
    p kyaa "A-AH...!" with vpunch

# game/script.rpy:466
translate ita start_0a043ff2:

    # w teehee "You'll save the last few layers for me, won't you?"
    w teehee "Lascerai gli ultimi strati di vestiti a me, vero?"

# game/script.rpy:467
translate ita start_02d73954:

    # p dying "M...MHM...!"
    p dying "M...MHM...!"

# game/script.rpy:468
translate ita start_a79b9707:

    # w innocent "That's all that matters, then 💙"
    w innocent "Va bene così, allora 💙"

# game/script.rpy:470
translate ita start_e98f0bac:

    # "I'm having the time of my life. And by the looks of it, so is Pastille!"
    "Mi sto divertendo un mondo. E a quanto pare, vale lo stesso per Pastille!"

# game/script.rpy:471
translate ita start_86f73f34:

    # "Ahh, I LIVE to tease cute witch boys... how fortunate that I came across the sweetest one today!"
    "Ahh, stuzzicare ragazzi strega carini è la mia ragione di VITA... sono stato proprio fortunato ad aver incontrato il più dolce oggi!"

# game/script.rpy:472
translate ita start_76b2fe88_3:

    # nvl clear
    nvl clear

# game/script.rpy:474
translate ita start_b1b75f8a:

    # "Our food arrives before Pastille is able to recover."
    "Il nostro cibo arriva prima che Pastille è in grado di riprendersi."

# game/script.rpy:475
translate ita start_e9d06f67:

    # "He can't even look the waiter in the eye... 💙 How adorable!"
    "Non riesce nemmeno a guardare il cameriere negli occhi... 💙 Adorabile!"

# game/script.rpy:476
translate ita start_bb6e6224:

    # "No, I mustn't overindulge before we've even eaten our meal..."
    "No, non devo esagerare prima di aver persino cenato..."

# game/script.rpy:477
translate ita start_813dd076:

    # "There will be plenty of time after dessert~"
    "Ci sarà tempo a sufficienza dopo il dessert~"

# game/script.rpy:478
translate ita start_76b2fe88_4:

    # nvl clear
    nvl clear

# game/script.rpy:480
translate ita start_c8daa5b3:

    # n "Pastille takes a few bites of his food before speaking up."
    n "Pastille assaggia un paio di forchettate del suo piatto, prima di parlare."

# game/script.rpy:482
translate ita start_b83133bb:

    # p ehe2 "S-so, Periwinkle... what do you do for a living?"
    p ehe2 "Q-quindi, Periwinkle... cosa fai nella vita?"

# game/script.rpy:483
translate ita start_a835dd10:

    # w smile "Besides tease you until you're barely able to speak?"
    w smile "A parte stuzzicarti finché sei appena in grado di parlare?"

# game/script.rpy:484
translate ita start_91a58fff:

    # p flustered "Yes, besides that!"
    p flustered "Si, a parte quello!"

# game/script.rpy:485
translate ita start_4a82f0a6:

    # w calm "My line of WORK, then... hmhm, I suppose I can tell you."
    w calm "Il mio LAVORO, dunque... hmh, suppongo di potertelo dire."

# game/script.rpy:487
translate ita start_0c6c18ec:

    # w smile "I'm an aromagician. I specialize in creating pleasant scents."
    w smile "Sono un aromago. Mi specializzo nella creazione di aromi piacevoli."

# game/script.rpy:492
translate ita start_8154e712:

    # n "Periwinkle tugs his wand out from his sleeve and lightly taps the candle on the table."
    n "Periwinkle fa uscire la sua bacchetta da sotto la manica e dà un dolce colpetto alla candela sul tavolo."

# game/script.rpy:493
translate ita start_d54b5a73:

    # n "In a small burst, the atmosphere shifts around the pair..."
    n "In un momento, l'atmosfera attorno ai due cambia..."

# game/script.rpy:494
translate ita start_508d0c25:

    # n "The candle's original aroma is quickly forgotten as it's replaced by something new and cozier."
    n "L'aroma originale della candela viene subito dimenticato ed è rimpiazzato da qualcosa di nuovo e accogliente."

# game/script.rpy:496
translate ita start_47abf8af:

    # p oh "Oh... that IS nice."
    p oh "Oh... che buono."

# game/script.rpy:497
translate ita start_66fd115e:

    # p smile "What smell is that? I'm no good at pinpointing stuff like this..."
    p smile "Che odore è? Non sono bravo a indicare con esattezza cose del genere..."

# game/script.rpy:498
translate ita start_67b12735:

    # w oh "Vanilla. I thought it suited you. Although..."
    w oh "Vaniglia. Pensavo fosse adatto a te. Anche se..."

# game/script.rpy:499
translate ita start_86dccb51:

    # w shy "I'm starting to think a more lustful scent might've been a better fit."
    w shy "Inizio a pensare che un aroma più lussurioso ti sarebbe calzato meglio."

# game/script.rpy:500
translate ita start_a5d894c0:

    # p omgstop "Wh-what does that even mean...?!" with vpunch
    p omgstop "Ch-che cosa vuol dire...?!" with vpunch

# game/script.rpy:501
translate ita start_f5e481ca:

    # w teehee "Just that you've done nothing but exceed my expectations 💙"
    w teehee "Soltanto che non hai fatto altro che stupirmi 💙"

# game/script.rpy:502
translate ita start_857b0c55:

    # p flustered "I-I'm not... doing anything...."
    p flustered "N-non sto... facendo nulla...."

# game/script.rpy:504
translate ita start_51513c28:

    # n "Pastille retreats behind his glass of water, overwhelmed by embarrassment once again."
    n "Pastille si ritira dietro il suo bicchiere d'acqua, travolto di nuovo dall'imbarazzo."

# game/script.rpy:505
translate ita start_0c12172a:

    # w love "(I did say I'd go a little easier on him, didn't I...? Ah, he's just too irresistible 💙)"
    w love "(Mi sono ripromesso di andarci un po' più piano con lui, giusto...? Ah, ma è così irresistibile 💙)"

# game/script.rpy:507
translate ita start_41bfaa4f:

    # w calm "Anywho... I bottle and sell scents like this one. It's fairly lucrative work, once you build a reputation for yourself."
    w calm "In ogni caso... imbottiglio e vendo aromi del genere. É un lavoro che paga abbastanza bene, una volta che ti sei fatto una reputazione."

# game/script.rpy:508
translate ita start_9b95030e:

    # p oh "Ah... sounds fulfilling."
    p oh "Ah... sembra appagante."

# game/script.rpy:509
translate ita start_df636102:

    # w smile "What about you, Pastille? What kind of magic do you specialize in?"
    w smile "E tu, Pastille? In che tipo di magia ti specializzi?"

# game/script.rpy:510
translate ita start_acfb287e:

    # p shy "Oh, I... I had mostly been living without magic, until recently."
    p shy "Oh io... io ho vissuto senza magia per la maggior parte, fino a poco tempo fa."

# game/script.rpy:511
translate ita start_ba1cda83:

    # w oh "Without magic...? I can't imagine."
    w oh "Senza magia...? Non riesco a immaginarlo."

# game/script.rpy:512
translate ita start_39cda655:

    # p smile "It's not so bad. I mean, humans do it, so why not?"
    p smile "Non è così male. Cioè, lo fanno gli umani, quindi perché no?"

# game/script.rpy:513
translate ita start_1b160ca1:

    # w "I suppose that's true."
    w "Suppongo sia così."

# game/script.rpy:514
translate ita start_a901b988:

    # w smile "I very directly make a living off of mine, so I'd find myself in quite a bind if I wasn't able to use it!"
    w smile "Io mi guadagno da vivere grazie alla magia, quindi mi troverei con le mani legate dietro la schiena se non fossi in grado di usarla!"

# game/script.rpy:515
translate ita start_a5adf706:

    # w teehee "Not that I mind being bound from time to time, you know 💙"
    w teehee "Non che mi dispiaccia essere legato di tanto in tanto, sai 💙"

# game/script.rpy:516
translate ita start_49904814:

    # p omgstop "H-how do you keep doing that...?! Every time I think we're talking about something innocent..."
    p omgstop "C-come ci riesci...?! Ogni volta che credo stiamo parlando di cose innocenti..."

# game/script.rpy:517
translate ita start_cbd9ddf7:

    # w love "(Ah, I just can't help myself, can I?)"
    w love "(Ah, non riesco proprio a trattenermi, eh?)"

