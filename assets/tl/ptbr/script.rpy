translate ptbr ch4_6319f667:

    # w date "Tell me about your magic."
    w date "Me fale sobre a sua magia."

# game/script.rpy:2141
translate ptbr ch4_81ee26b5:

    # p um "O-okay... what do you want to know?"
    p um "T-tá bom... O que você quer saber?"

