    # w oh2 "(I have so much more floor space than I remembered... how did he manage to do that...?)"
    w oh2 "(Eu tenho muito mais chão nesse quarto do que eu me lembro... como isso é possível...?)"

# game/script.rpy:2828
translate ptbr ch6_9f49ab7b:

    # n "Periwinkle puts on a fresh pair of pajamas and walks out to the kitchen in a daze."
    n "Periwinkle veste um par limpo de pijamas e caminha meio dormindo até a cozinha."

# game/script.rpy:2834
translate ptbr ch6_d0be8d4a:

    # p "Hey! Pancakes are ready."
    p "Oi! As panquecas estão prontas."

# game/script.rpy:2836
translate ptbr ch6_2bbe66e9:

    # w pj happy "Oh~! Is it too soon to say I love you?"
    w pj happy "Oh~! Ainda é cedo demais para dizer que eu te amo?"

# game/script.rpy:2837
translate ptbr ch6_59343347:

    # p sure "Haha, please enjoy...."
    p sure "Haha, aproveite...."

# game/script.rpy:2838
translate ptbr ch6_5c9fb064:

    # n "Periwinkle takes his seat at the table and digs in..."
    n "Periwinkle assume seu lugar na mesa e começa a comer..."

# game/script.rpy:2841
translate ptbr ch6_dba11a19:

    # "They're... delicious."
    "Isso está... uma delícia."

# game/script.rpy:2842
translate ptbr ch6_ed24b619:

    # "Perfectly light and fluffy... the optimal amount of syrup and whipped cream..."
    "Perfeitamente leves e fofinhas... a quantidade perfeita de xarope e chantili..."

# game/script.rpy:2843
translate ptbr ch6_877ba230:

    # "Every bite is so heavenly, I could cry!"
    "Cada mordida é perfeita, eu poderia até chorar!"

# game/script.rpy:2844
