    # w innocent "By all means~"
    w innocent "É claro~"

# game/script.rpy:3243
translate ptbr ch6_b1a59605:

    # "I once again found myself in the excruciatingly domestic situation of watching Pastille prepare a meal in my kitchen."
    "E mais uma vez eu me encontro na situação de vida doméstica na qual eu assisto enquanto Pastille preparar uma refeição na minha cozinha."

# game/script.rpy:3244
translate ptbr ch6_27f276dd:

    # "There's no way he doesn't realize it, right? That we've been acting as a couple for a long time now..."
    "Ele deve ter percebido, não é? Ele deve saber que nós estamos agindo como um casal já faz tempo..."

# game/script.rpy:3245
translate ptbr ch6_64b1117b:

    # "It's just that neither of us have bothered to address it."
    "É só que nenhum de nós falou a respeito ainda."

# game/script.rpy:3246
translate ptbr ch6_11c05150:

    # "Shouldn't it be properly acknowledged...?"
    "Nós não devíamos falar sobre isso...?"

# game/script.rpy:3247
translate ptbr ch6_a15243f7:

    # nvl clear
    # "Pastille chats with me as he cooks, but I'm admittedly distracted by these thoughts."
    nvl clear
    "Pastille fala comigo enquanto cozinha, mas esses pensamentos me deixam distraído."

# game/script.rpy:3249
translate ptbr ch6_8b6ec33b:

    # "Perhaps putting a name to it would only cause it to unravel..."
    "Talvez dar um nome ao nosso tipo de relacionamento faria com ele acabasse..."

# game/script.rpy:3250
translate ptbr ch6_fed127ba:

    # "Currently, there's no expectation. We're free to see whoever else we like."
    "Atualmente, nós não temos expectativas. Estamos livres para sair com outras pessoas."

# game/script.rpy:3251
translate ptbr ch6_588f3995:

    # "Though... it doesn't seem either of us are doing that."
    "Mas... não parece que nenhum de nós está fazendo isso."

# game/script.rpy:3252
translate ptbr ch6_7d13798e:

    # nvl clear
    # n "Pastille approaches the table where Periwinkle sits, holding a plate in each hand."
    nvl clear
    n "Pastille caminha em direção a mesa, segurando um prato em cada mão."

# game/script.rpy:3258
translate ptbr ch6_45d7faef:

    # p "Ta-da~ Pasta's ready."
    p "Tcharan~ A massa está pronta."

# game/script.rpy:3259
translate ptbr ch6_10cdcc29:

    # w shutin happy "Ooh, bon appétit 💙"
    w shutin happy "Ooh, bon appétit 💙"

# game/script.rpy:3262
translate ptbr ch6_0e94caa2:

    # "Maybe he's already decided we're a couple, and I'm just obsessing over formalities."
    "Talvez nós já sejamos um casal e eu só estou obcecado com formalidades."

# game/script.rpy:3263
translate ptbr ch6_b80eb0a1:

    # "What does it matter, so long as the two of us are happy?"
    "Que diferença isso faz contanto que nós sejamos felizes?"

# game/script.rpy:3264
translate ptbr ch6_e81d99d4:

    # "And I really AM happy..."
    "E eu estou MUITO feliz..."

# game/script.rpy:3265
translate ptbr ch6_a91d3dfd:

    # "His cooking... tastes wonderful...."
    "A comida dele... tem um gosto tão bom...."

# game/script.rpy:3266
translate ptbr ch6_76b2fe88_8:

    # nvl clear
    nvl clear

# game/script.rpy:3269
