    # p "...Peri? You okay?"
    p "...Peri? Tudo bem?"

# game/script.rpy:3270
translate ptbr ch6_94ce811b:

    # w shutin ah "Hm? Yes...?"
    w shutin ah "Hm? Sim...?"

# game/script.rpy:3271
translate ptbr ch6_a057a474:

    # p ehe "You were being so quiet, I started to worry that I messed up our dinner somehow..."
    p ehe "Você estava tão quieto, eu fiquei com medo que a comida não estivesse boa..."

# game/script.rpy:3272
translate ptbr ch6_05d526a2:

    # w guilty "No, no... it's delicious!"
    w guilty "Não, não... está uma delícia!"

# game/script.rpy:3273
translate ptbr ch6_8f95049d:

    # w smile "I was just lost in the pasta, is all. Forgive me, I didn't mean to worry you."
    w smile "Eu só estava perdido nos meus pensamentos. Perdão, eu não quis preocupá-lo."

# game/script.rpy:3276
translate ptbr ch6_bc3ffb32:

    # "I need to get out of my own head."
    "Eu tenho que parar de pensar nisso."

# game/script.rpy:3277
translate ptbr ch6_4781f2a1:

    # "Pastille is here in front of me! And I'm too distracted to savor it...!"
    "Pastille está aqui comigo! E eu estou distraído demais para aproveitar...!"

# game/script.rpy:3278
translate ptbr ch6_36793aff:

    # "Forget my doubts. We'll just have to see where the night takes us..."
    "Esqueça essas dúvidas. Só vamos ver onde a noite nos leva..."

# game/script.rpy:3279
translate ptbr ch6_8abc74f1:

    # nvl clear
    # n "Periwinkle takes his plate to the sink and begins to wash up."
    nvl clear
    n "Periwinkle leva seu prato até a pia e começa a lavar."

# game/script.rpy:3283
translate ptbr ch6_3e0f9893:

    # p wha "Ah--I can take care of that!"
    p wha "Ah--Eu posso fazer isso!"

# game/script.rpy:3284
translate ptbr ch6_e738bebe:

    # w love "Nonsense, you just cooked us dinner! It's your turn to relax, my sweet 💙"
    w love "Bobagem, você fez o jantar! Agora é sua vez de descansar, meu doce 💙"

# game/script.rpy:3285
translate ptbr ch6_56c4b6d1:

    # p shy "Are you sure I can't help...? I wouldn't mind at all...."
    p shy "Tem certeza de que não quer ajuda...? Eu não me importo de lavar...."

# game/script.rpy:3286
translate ptbr ch6_bc36cfb7:

    # w calm "You can help by bringing me your plate when you're finished."
    w calm "Você pode ajudar trazendo o seu prato quando terminar."

# game/script.rpy:3287
translate ptbr ch6_c83acea9:

    # p ehe "Okaaay...."
    p ehe "Tá booooom...."

# game/script.rpy:3290
translate ptbr ch6_4911fe5a:

    # n "Pastille does as he's told, then wanders over to the couch."
    n "Pastille faz o que é mandado e depois vai até o sofá."

# game/script.rpy:3293
translate ptbr ch6_e34ed609:

    # p "Hey, um..."
    p "Então, uh..."

# game/script.rpy:3294
translate ptbr ch6_fe1d1ce2:

    # p "If you have anyone you want to introduce me to, I'd be happy to meet them. Return the favor, sort of thing."
    p "Se tem alguém que você gostaria de me apresentar, eu ficaria feliz em conhecê-los. Retribuir o favor, sabe."

# game/script.rpy:3296
translate ptbr ch6_bbf226dc:

    # p "I-I know it can be awkward though, so... if not, that's okay too...."
    p "E-eu sei que pode não ser fácil, então... se não quiser, também não tem problema...."

# game/script.rpy:3297
translate ptbr ch6_6753e7b3:

    # w "Hm... no, no one comes to mind."
    w "Hm... não, não consigo pensar em ninguém."

# game/script.rpy:3298
translate ptbr ch6_a367466f:

    # p "...Huh? Really?"
    p "...Huh? Mesmo?"

# game/script.rpy:3299
translate ptbr ch6_6e2dd70d:

    # w "Sure, I know a lot of people. But I couldn't say I'm particularly close with any of them..."
    w "Claro, eu conheço muita gente. Mas eu não diria que a maioria deles são meus bons amigos..."

# game/script.rpy:3301
translate ptbr ch6_8585d2d5:

    # w "Except maybe one? But you've already met my business partner."
    w "Exceto um? Mas você já conheceu minha parceira de negócios."

# game/script.rpy:3302
translate ptbr ch6_0aad42dd:

    # p "Oh! At the apothecary, right?"
    p "Ah! A dona da botica, não é?"

# game/script.rpy:3304
translate ptbr ch6_05485f5a:

    # w "Precisely."
    w "Exatamente."

# game/script.rpy:3305
translate ptbr ch6_d5c67421_1:

    # p "...."
    p "...."

# game/script.rpy:3307
translate ptbr ch6_01f6d082:

    # w "Hm~? What's with that look."
    w "Hm~? Que cara é essa."

# game/script.rpy:3309
translate ptbr ch6_c50b5f2b:

    # p "N-no, nothing... I just don't know what to say now."
    p "N-não, nada... Eu só não sei o que dizer."

# game/script.rpy:3310
translate ptbr ch6_1af14dea:

    # w "Hmhm, you expected someone as charismatic as me to have all sorts of new people to introduce you to, then?"
    w "Hmhm, você esperava que alguém tão carismático como eu teria todo tipo de pessoa para lhe apresentar, não é?"

# game/script.rpy:3311
translate ptbr ch6_9e2f690d:

    # p "I guess so. I'm just surprised..."
    p "Acho que sim. Eu só fico surpreso..."

# game/script.rpy:3312
translate ptbr ch6_e3fe1cd7:

    # p "I, um, really like... being around you... so I expected that to be true for your other friends, too."
    p "Eu, uh, gosto muito de... ficar perto de você... então achei que os seus outros amigos também fossem assim."

# game/script.rpy:3313
translate ptbr ch6_81608c29:

    # w "Hmm..."
    w "Hmm..."

# game/script.rpy:3315
translate ptbr ch6_04156cdb:

    # w "I'd say you're probably the closest I've ever been with someone."
    w "Eu diria que você é a pessoa da qual eu mais me aproximei."

# game/script.rpy:3316
translate ptbr ch6_291e005a:

    # w "...Literally speaking."
    w "...Literalmente."

# game/script.rpy:3320
translate ptbr ch6_ba9915e5:

    # n "They laugh together, then fall into a comfortable silence..."
    n "Os dois dão risada, e então um silêncio confortável recai sobre eles..."

# game/script.rpy:3321
translate ptbr ch6_34bec6e3:

    # n "With their heads leaned together, Periwinkle nuzzles his face into Pastille's shoulder affectionately."
    n "Inclinados um contra o outro, Periwinkle se aconchega encostando sua cabeça de forma afetuosa no ombro de Pastille."

# game/script.rpy:3322
translate ptbr ch6_7680a727:

    # n "After a few moments, Pastille asks..."
    n "Depois de alguns segundos, Pastille pergunta..."

# game/script.rpy:3325
translate ptbr ch6_7e4e52b8:

    # p "Do you... wanna get in bed?"
    p "Você quer... ir pra cama?"

# game/script.rpy:3326
translate ptbr ch6_08b40548:

    # w shutin teehee "For sleep, or for pleasure?"
    w shutin teehee "Para dormir ou para se divertir?"

# game/script.rpy:3327
translate ptbr ch6_275c3be8:

    # p omg "U-um, that's up to you...!" with vpunch
    p omg "A-ah, aí é você quem sabe...!" with vpunch

# game/script.rpy:3329
translate ptbr ch6_1609c48e:

    # n "Periwinkle stands, then turns around to take Pastille's hands."
    n "Periwinkle se levanta, ele então se vira e agarra a mão de Pastille."

# game/script.rpy:3330
translate ptbr ch6_a6d0b21a:

    # w shutin "Come, then."
    w shutin "Então, vamos."

# game/script.rpy:3335
translate ptbr ch6_e0c4b6a5:

    # n "He leads him into the bedroom, closing the door behind them."
    n "Ele o leva até o quarto, fechando a porta depois que os dois entram."

# game/script.rpy:3336
translate ptbr ch6_17bd39fe:

    # n "When he does, Pastille speaks up again..."
    n "Em seguida, Pastille começa a falar novamente..."

# game/script.rpy:3339
translate ptbr ch6_90e29b25:

    # p "You know... I'm still finding it hard to believe there's no one else you're close to."
    p "Sabe... Eu ainda acho difícil de acreditar que você não se considera próximo de mais ninguém."

# game/script.rpy:3340
translate ptbr ch6_25de1dd0:

    # w shutin "Hm~? Two is a reasonable number."
    w shutin "Hm~? Dois é um número razoável."

# game/script.rpy:3341
translate ptbr ch6_48ef453d:

    # w calm "You had two friends as well, did you not? Syrup and Gumdrop."
    w calm "Você também só tem dois amigos, não é? Syrup e Gumdrop."

# game/script.rpy:3342
translate ptbr ch6_dcd034df:

    # p sure "Fair point... but counting YOU makes three."
    p sure "Verdade... mas contando com VOCÊ eu tenho três."

# game/script.rpy:3343
translate ptbr ch6_1da53c55:

    # w love "Ah, you have me beat. Perhaps I should try harder to catch up."
    w love "Ah, você venceu. Talvez eu deva tentar igualar os números. "

# game/script.rpy:3346
translate ptbr ch6_c5a565be:

    # n "Periwinkle collapses into bed, while Pastille sits down beside him."
    n "Periwinkle cai na cama, enquanto Pastille senta ao seu lado."

# game/script.rpy:3349
translate ptbr ch6_85981fc3:

    # w "I think I've preferred it, though. Keeping a healthy distance from others..."
    w "Mas eu acho que eu prefiro como as coisas estão. Mantendo uma distância saudável dos outros..."

# game/script.rpy:3350
translate ptbr ch6_43989462:

    # p "Really? How come?"
    p "Mesmo? Por quê?"

# game/script.rpy:3351
translate ptbr ch6_a40f3b27:

    # w "The alternative has been disastrous in my experience. I'm far too intense."
    w "Com base na minha experiência, a alternativa nunca dá certo. Eu sou muito intenso."

# game/script.rpy:3352
translate ptbr ch6_c4dfb99a:

    # p "Ha, what do you mean by THAT...?"
    p "Ha, o que ISSO quer dizer...?"

# game/script.rpy:3353
translate ptbr ch6_d85fd387:

    # w "Goodness, my best example is the worst one..."
    w "Ah bem, o meu melhor exemplo é o pior..."

# game/script.rpy:3355
translate ptbr ch6_0c4b9b3e:

    # w "In my teenage years... there was a boy I would've done anything for."
    w "Quando eu era um adolecente... tinha um garoto pelo qual eu faria qualquer coisa."

# game/script.rpy:3356
translate ptbr ch6_567cfdcb:

    # w "I wanted his approval so badly. I wanted to be loved."
    w "Eu queria que ele gostasse de mim. Eu queria ser amado."

# game/script.rpy:3357
translate ptbr ch6_53f3ef0f:

    # w "...It's funny, I can't even think of what drew me to him."
    w "...Engraçado, eu nem lembro do que eu gostava nele."

# game/script.rpy:3359
translate ptbr ch6_b214fa05:

    # w "I suppose he was just a vessel to project onto. An idealized boyfriend, this... shortcut to happiness."
    w "{size=-2}Eu acho que ele era só um recipiente no qual eu podia projetar meus desejos. Um namorado idealizado, um tipo de... atalho para a felicidade.{/size}"

# game/script.rpy:3360
translate ptbr ch6_1201679b:

    # w "Hmhm... poor guy. He didn't know what to do with the torrent of feelings I'd been forcing onto him. We were young."
    w "Hmhm... pobre rapaz. Ele não sabia o que fazer com todos os sentimentos que eu estava forçando ele a aceitar. Nós éramos tão jovens."

# game/script.rpy:3361
translate ptbr ch6_7ae36a53:

    # w "A love like that is much too painful. If it can even be called love...."
    w "Um amor como esse é muito doloroso. Não se pode nem chamar de amor...."

# game/script.rpy:3363
translate ptbr ch6_4235f80c:

    # w "It took some practice to be able to separate the emotions out."
    w "Eu precisei aprender a separar minhas emoções das minhas relações."

# game/script.rpy:3364
translate ptbr ch6_094487a5:

    # w "To be able to indulge in the romantic and sexual energy I craved, while protecting my fragile heart..."
    w "{size=-2}Para que assim eu pudesse aproveitar os sentimentos românticos e sexuais que eu desejo, enquanto meu frágil coração continua protegido...{/size}"

# game/script.rpy:3365
translate ptbr ch6_c9592a6d:

    # w "But, ever since I figured it out, I've gotten to experience all sorts of love through these casual flings~"
    w "Mas, desde que eu aprendi, eu tive a chance de aproveitar todos os tipos de amor através desses encontros casuais~"

# game/script.rpy:3366
translate ptbr ch6_bd22f0ce:

    # w "(What am I saying...?)"
    w "(O que eu estou dizendo...?)"

# game/script.rpy:3367
translate ptbr ch6_b87e6b7a:

    # w "It's perfect for me 💙 The ideal life, really."
   w  "É o jeito perfeito de ser 💙 O estilo de vida ideal para mim."

# game/script.rpy:3368
translate ptbr ch6_694c6d8c:

    # w "(Don't listen to me, Pastille....)"
    w "(Não escute o que eu estou dizendo, Pastille....)"

# game/script.rpy:3373
translate ptbr ch6_a29244df:

    # p "Hmm..."
    p "Hm..."

# game/script.rpy:3374
translate ptbr ch6_884754a7:

    # p smile "I don't know if your heart is as fragile as you think."
    p smile "Eu não sei se o seu coração é tão frágil como você pensa."

# game/script.rpy:3375
translate ptbr ch6_cb22988c:

    # w shutin love "You don't believe me? Despite what it seems, I have the heart of an innocent maiden~!"
    w shutin love "Você não acredita em mim? Apesar das aparências, eu tenho o coração de uma donzela inocente~!"

# game/script.rpy:3376
translate ptbr ch6_1dece50f:

    # p sure "Haha, I don't know about innocent, but..."
    p sure "Haha, eu não sei se eu acredito na parte inocente, mas..."

# game/script.rpy:3380
translate ptbr ch6_ea6c8d9d:

    # n "Pastille leans forward and lays his head on Periwinkle's chest."
    n "Pastille se aproxima e coloca as mãos no peito de Periwinkle."

# game/script.rpy:3381
translate ptbr ch6_192176bb:

    # p "...Sounds pretty strong to me."
    p "...Para mim ele parece bem forte."

# game/script.rpy:3382
translate ptbr ch6_075d682d:

    # w "...!!"
    w "...!!"

# game/script.rpy:3384
translate ptbr ch6_77261c10:

    # p "Ah, it's beating harder now."
    p "Ah, começou a bater ainda mais forte."

# game/script.rpy:3386
translate ptbr ch6_51fe2183:

    # w "B-because you suddenly embraced me! See, this is what I mean by fragile...!" with vpunch
    w "I-isso é porque você me agarrou tão de repente! Viu, é isso que eu quero dizer com frágil...!" with vpunch

# game/script.rpy:3389
translate ptbr ch6_afbec36c:

    # n "Periwinkle struggles out from under him, and the pair sits facing each other on the bed."
    n "Periwinkle tenta se desvencilhar de Pastille, e o par acaba sentado na cama de frente um para o outro."

# game/script.rpy:3392
translate ptbr ch6_f8a67d56:

    # p "You know... at first, I thought romantic stuff was just a formality for you. But you actually love it, huh?"
    p "Sabe... a princípio, eu achei que toda a parte romântica fosse só uma formalidade pra você. Mas você adora essa parte, não é?"

# game/script.rpy:3393
translate ptbr ch6_9c15c768:

    # w shutin love "Are you only realizing that NOW?"
    w shutin love "Você só percebeu AGORA?"

# game/script.rpy:3394
translate ptbr ch6_35b3829b:

    # p ehe "Haha, I guess not...."
    p ehe "Haha, acho que não...."

# game/script.rpy:3398
translate ptbr ch6_d170010a:

    # "What are you trying to say, Pastille?"
    "O que você está tentando dizer, Pastille?"

# game/script.rpy:3399
translate ptbr ch6_736befba:

    # "That it's okay for me to love you...?"
    "Que não tem nada de errado em eu amar você...?"

# game/script.rpy:3400
translate ptbr ch6_310f8fb1:

    # "That I'll be safe?"
    "Que eu não vou sofrer?"

# game/script.rpy:3401
translate ptbr ch6_76b2fe88_9:

    # nvl clear
    nvl clear

# game/script.rpy:3404
translate ptbr ch6_94871324:

    # w "Then, hurry up and kiss me."
    w "Então anda logo e me beija."

# game/script.rpy:3406
translate ptbr ch6_4a8350ae:

    # p "Okay ❤ Sorry to keep you waiting."
    p "É claro ❤ Desculpe por fazer você esperar."

# game/script.rpy:3408
translate ptbr ch6_d66b3318:

    # n "Pastille closes the distance between them..."
    n "Pastille se aproxima de Periwinkle..."

# game/script.rpy:3409
translate ptbr ch6_54a35ace:

    # "I'm too weak."
    "Eu sou fraco."

# game/script.rpy:3410
translate ptbr ch6_139334f1:

    # "The words won't come out..."
    "As palavras não querem sair..."

# game/script.rpy:3411
translate ptbr ch6_76b2fe88_10:

    # nvl clear
    nvl clear

# game/script.rpy:3413
translate ptbr ch6_0f7e6da5:

    # n "As they kiss, Periwinkle becomes more and more entangled in his thoughts..."
    n "Enquanto eles se beijam, Periwinkle se afunda mais e mais em seus pensamentos..."

# game/script.rpy:3414
translate ptbr ch6_f42e65a6:

    # "Ahh, it hurts...!"
    "Ahh, como dói...!"

# game/script.rpy:3415
translate ptbr ch6_d63ae36a:

    # "I want to be even closer...."
    "Eu quero me aproximar ainda mais...."

# game/script.rpy:3416
translate ptbr ch6_76b2fe88_11:

    # nvl clear
    nvl clear

# game/script.rpy:3418
translate ptbr ch6_341a3f02:

    # n "He lets himself fall backward, bringing Pastille down with him."
    n "Periwinkle se deixa cair de costas, trazendo Pastille com ele."

# game/script.rpy:3419
translate ptbr ch6_443d47e5:

    # "This isn't nearly enough to satisfy me..."
    "Isso não é o bastante para me satisfazer..."

# game/script.rpy:3420
translate ptbr ch6_c8df87cf:

    # "Just, please, don't stop...."
    "Só, por favor, não pare...."

# game/script.rpy:3421
translate ptbr ch6_76b2fe88_12:

    # nvl clear
    nvl clear

# game/script.rpy:3425
translate ptbr ch6_cb671a59:

    # n "Periwinkle's heart cried out..."
    n "O coração de Periwinkle estava aos gritos..."

# game/script.rpy:3426
translate ptbr ch6_a66018f1:

    # n "His jumbled emotions caught in his throat, manifesting through his hands, clinging desperately to Pastille..."
    n "{size=-2}Suas emoções tão complicadas estavam presas, se manifestando através de suas mãos, se agarrando desesperadamente a Pastille...{/size}"

# game/script.rpy:3427
translate ptbr ch6_5f6ba41c:

    # n "...who continued to kiss him and hold him through the night."
    n "...que continuou a beijá-lo e segurá-lo noite adentro."

# game/script.rpy:3438
translate ptbr ch7_7b49a2da:

    # centered "{w=3}{nw}"
    centered "{w=3}{nw}"

# game/script.rpy:3443
translate ptbr ch7_6f509ab8:

    # n "The next morning, Periwinkle steps out onto his doorstep with a heavy sigh."
    n "Na manhã seguinte, Periwinkle deixa escapar um suspiro ao sair de casa."

# game/script.rpy:3445
translate ptbr ch7_a6ad8caa:

    # w hood empty "(If I lay around in bed all day, I'll only feel more miserable...)"
    w hood empty "(Se eu ficar na cama o dia todo eu só vou acabar me sentindo pior...)"

# game/script.rpy:3446
translate ptbr ch7_bfb25d37:

    # w oops "(I need to stop avoiding my work. I have to talk to Astragalus....)"
    w oops "(Eu preciso parar de evitar o trabalho. Eu tenho que falar com a Astragalus....)"

# game/script.rpy:3447
translate ptbr ch7_3eb69f61:

    # w empty "(She isn't going to be pleased with me though....)"
    w empty "(Ela não vai gostar nada disso...)"

# game/script.rpy:3449
translate ptbr ch7_c0771f75:

    # n "Holding his mantle tightly, he makes his way to the apothecary..."
    n "Segurando seu manto, ele começa a caminhar em direção a botica..."

# game/script.rpy:3457
translate ptbr ch7_ec45006e:

    # n "When he arrives, Astragalus is preoccupied with arranging some of her merchandise."
    n "Quando ele chega, Astragalus está ocupada colocando seus produtos em ordem."

# game/script.rpy:3458
translate ptbr ch7_2eb737f5:

    # n "She turns abruptly at the unexpected sound of the door's chime."
    n "Ela se vira abruptamente ao ouvir o sino na porta tocar."

# game/script.rpy:3461
translate ptbr ch7_23102229:

    # a augh "Hey, we're not open yet--!" with vpunch
    a augh "Ei, nós ainda não abrimos--!" with vpunch

# game/script.rpy:3463
translate ptbr ch7_21ae3d6f:

    # a hm "...Huh? Periwinkle?"
    a hm "...Huh? Periwinkle?"

# game/script.rpy:3464
translate ptbr ch7_0cfdf83c:

    # w hood decline "Good morning, Astragalus."
    w hood decline "Bom dia, Astragalus."

# game/script.rpy:3465
translate ptbr ch7_ca42047f:

    # a uh "I haven't seen you all month--I barely recognized you under that hood!"
    a uh "Eu não te vi o mês todo--Eu quase não te reconheci de capuz!"

# game/script.rpy:3466
translate ptbr ch7_a59d0c89:

    # a augh "I was about to come and knock on your damn door if you didn't show your face here soon. You've got a huge backlog of orders waiting!"
    a augh "{size=-2}Eu estava quase chegando ao ponto de ir bater na sua porta se você não aparecesse logo. Você tem uma lista enorme de pedidos pra cumprir!{/size}"

# game/script.rpy:3467
translate ptbr ch7_6328fc6a:

    # w empty "...I can't take them. My magic is useless."
    w empty "...Eu não posso cumpri-los. Minha magia é inútil."

# game/script.rpy:3468
translate ptbr ch7_709a7b6c:

    # a uh "Whaddaya mean, \"useless\"?"
    a uh "Explica melhor aí esse \"inútil\"."

# game/script.rpy:3469
translate ptbr ch7_78308c9b:

    # n "Periwinkle meekly hands over one of his pale pink vials."
    n "Periwinkle entrega a ela uma garrafa com um liquido rosa pálido."

# game/script.rpy:3470
translate ptbr ch7_e6a68b87:

    # w ohhh "This is all I can make... it's been this way for ages."
    w ohhh "Eu só consigo fazer isso... tem sido assim a dias."

# game/script.rpy:3471
translate ptbr ch7_c42de9e7:

    # a whatever "*sigh* Let's see..."
    a whatever "*suspira* Vamos ver..."

# game/script.rpy:3472
translate ptbr ch7_60a7f254:

    # n "Astragalus unscrews the top, and eyes Periwinkle suspiciously before giving it a whiff..."
    n "Astragalus remove a tampa e olha para Periwinkle com desconfiança antes de sentir o cheiro do conteúdo..."

# game/script.rpy:3473
translate ptbr ch7_0d690c65:

    # a uh "Whew, that's powerful!!" with vpunch
    a uh "Caramba, isso é forte!!" with vpunch

# game/script.rpy:3474
translate ptbr ch7_2b253749:

    # a think "Not bad, though... warms me right up. Could stand to be diluted a little, just to make it less overwhelming..."
    a think "Não que isso seja ruim... me deu até um calor. Dá pra diluir um pouco, deixar um pouco menos potente..."

# game/script.rpy:3475
translate ptbr ch7_40f53860:

    # a lol "So. What's got you stuck on a scent like this?"
    a lol "Então. O que te fez ficar preso nesse cheiro?"

# game/script.rpy:3476
translate ptbr ch7_de42c61a:

    # w ohhh2 "...It's Pastille...."
    w ohhh2 "...É o Pastille...."

# game/script.rpy:3477
translate ptbr ch7_0381a0e1:

    # w whine2 "He's ruined me! I'll never be able to return to the way I was before...!"
    w whine2 "Ele me arruinou! Eu nunca mais vou conseguir voltar a vida como era antes...!"

# game/script.rpy:3478
translate ptbr ch7_4bd0f1d4:

    # a closed "I see. So things got complicated, just like I warned you."
    a closed "Entendi. As coisas ficaram complicadas, olha que eu te avisei."

# game/script.rpy:3479
translate ptbr ch7_1fb3e795:

    # w cwy "Mhm... *sniffle*..."
    w cwy "Mhm... *funga*..."

# game/script.rpy:3480
translate ptbr ch7_6be39aa2:

    # w cwy2 "I-I love him so much, I think I might die...."
    w cwy2 "E-eu amo tanto ele, que eu sinto que vou morrer...."

# game/script.rpy:3481
translate ptbr ch7_48204255:

    # a neutral "Come on... Back room. Now."
    a neutral "Vamos... Quarto dos fundos. Agora."

# game/script.rpy:3485
translate ptbr ch7_7d77e570:

    # n "Periwinkle nods and obediently follows Astragalus into her private office..."
    n "Periwinkle acena com a cabeça e obedientemente segue Astragalus até seu escritório nos fundos..."

# game/script.rpy:3490
translate ptbr ch7_1be0328f:

    # n "He quietly takes in his surroundings before she suddenly turns to him with a raised finger."
    n "Ele silenciosamente olha ao seu redor antes de Astragalus se virar com um dedo erguido."

# game/script.rpy:3492
translate ptbr ch7_170b612d:

    # a "Don't touch anything."
    a "Não toque em nada."

# game/script.rpy:3493
translate ptbr ch7_90a8c977:

    # w hood ohhh "...?"
    w hood ohhh "...?"

# game/script.rpy:3495
translate ptbr ch7_020bb483:

    # n "Astragalus drags a bean bag chair out from the corner and plops it in the middle of the room unceremoniously."
    n "Astragalus tira um pufe de algum canto do escritório e, sem cerimônia, o larga na frente de Periwinkle."

# game/script.rpy:3497
translate ptbr ch7_507ec09a:

    # a "Sit."
    a "Senta."

# game/script.rpy:3498
translate ptbr ch7_e6ea4d0e:

    # w hood ohhh "...It's dusty...."
    w hood ohhh "...Está empoeirado...."

# game/script.rpy:3499
translate ptbr ch7_44201857:

    # a augh "UGH, you're such a diva..."
    a augh "UGH, você é tão cheio de frescura..."

# game/script.rpy:3500
translate ptbr ch7_c4c193b3:

    # n "She gives it a couple good smacks, beating the dust into the air instead."
    n "Ela dá alguns tapas no pufe, só servindo para levantar poeira."

# game/script.rpy:3501
translate ptbr ch7_c411bd45:

    # a annoyed "...NOW sit."
    a annoyed "...AGORA senta."

# game/script.rpy:3502
translate ptbr ch7_ca9dcc70:

    # w oops "Very well...."
    w oops "Muito bem...."

# game/script.rpy:3505
translate ptbr ch7_86603b28:

    # n "He complies, and Astragalus spins her office chair around to face him."
    n "Ele obedece e Astragalus vira a sua cadeira de escritório para que fiquem frente a frente."

# game/script.rpy:3508
translate ptbr ch7_46e11470:

    # a "Alright, Periwinkle. Here's what's gonna happen."
    a "Tá bom, Periwinkle. Eu vou te falar o que vai acontecer."

# game/script.rpy:3509
translate ptbr ch7_89a00474:

    # a "I'm gonna brew us up some tea, and you're gonna explain everything. From the beginning."
    a "Eu vou fazer um chá e você vai me contar tudo, tintim por tintim. Desde o começo."

# game/script.rpy:3510
translate ptbr ch7_0ccf1ed0:

    # w hood sorry "Explain what...?"
    w hood sorry "Contar o quê...?"

# game/script.rpy:3511
translate ptbr ch7_0e7a98bb:

    # a "About Pastille. Even the stuff I already know. Everything, from the top."
    a "Sobre o Pastille. Até o que eu já sei sobre ele. Tudo, agora fala."

# game/script.rpy:3512
translate ptbr ch7_30cf76fb:

    # w ohhh "Everything...?"
    w ohhh "Tudo mesmo...?"

# game/script.rpy:3513
translate ptbr ch7_4f05ba39:

    # a "Skip the bedroom details, obviously. Just walk me through anything important that happened since you met."
    a "Pula as coisas que acontecem no quarto. Vamos repassar as coisas importantes que aconteceram desde que vocês se conheceram."

# game/script.rpy:3514
translate ptbr ch7_c147a5e1:

    # w whine "I-I don't want to! Reliving it all is only going to make things worse...!"
    w whine "E-eu não sei se devemos! Reviver tudo que aconteceu só vai piorar as coisas...!"

# game/script.rpy:3517
translate ptbr ch7_d617b2fd:

    # n "Astragalus stands and walks over to her kettle to start the tea."
    n "Astragalus se levanta e caminha até sua chaleira para preparar o chá."

# game/script.rpy:3519
translate ptbr ch7_c88d1b30:

    # a "Alright, you lovesick dolt..."
    a "Tá bom, seu idiota apaixonado..."

# game/script.rpy:3520
translate ptbr ch7_95976d4b:

    # a annoyed "You wanna know why exactly your magic's been stuck like that? It's because you don't have an outlet for all those emotions."
    a annoyed "Você quer saber por que a sua magia está do jeito que está? Porque você não tem um escape pras suas emoções."

# game/script.rpy:3521
translate ptbr ch7_ea89bd51:

    # a closed "Instead, you keep bottling them up--literally, I guess. It's all that comes out because it's all there is inside you."
    a closed "Bem o contrário, você fica engarrafando essas emoções--literalmente, nesse caso. É só isso que sai porque é só o que tem dentro de você."

# game/script.rpy:3522
translate ptbr ch7_61f43815:

    # w hood ohhh "...."
    w hood ohhh "...."

# game/script.rpy:3523
translate ptbr ch7_4d08edac:

    # a lol2 "So, let it all out! What, you think I'm gonna judge you?"
    a lol2 "Então, fala tudo! O quê? Você acha que eu vou te julgar?"

# game/script.rpy:3524
translate ptbr ch7_0e405e25:

    # w oops "No... I don't know."
    w oops "Não... Eu não sei."

# game/script.rpy:3525
translate ptbr ch7_a2f71b21:

    # a lol "Would you rather spill it all to him instead?"
    a lol "Você prefere contar tudo pra ele, então?"

# game/script.rpy:3526
translate ptbr ch7_237d6381:

    # w cwy "I can't...! It's too much!"
    w cwy "Eu não posso...! Isso seria demais!"

# game/script.rpy:3527
translate ptbr ch7_61ef0d5e:

    # a sure "Then tell it to me, a neutral third party."
    a sure "Então conta pra mim, eu não tenho nada haver com essa história."

# game/script.rpy:3528
translate ptbr ch7_5df175e3:

    # a uh "Actually, I can't say that I'm neutral... I'd need to find a new supplier if you couldn't fill my orders anymore."
    a uh "{size=-2}Na realidade, eu não posso dizer que não tenho nada haver... Eu vou precisar encontrar um novo fornecedor se você não trabalhar mais.{/size}"

# game/script.rpy:3529
translate ptbr ch7_3a7ea07c:

    # w oops "I do feel a little more at ease imagining this is all a business matter for you...."
    w oops "Eu me sinto um pouco melhor quando penso que tudo isso é só uma questão de negócios para você..."

# game/script.rpy:3530
translate ptbr ch7_969f721a:

    # a smile "Then just think of it like that."
    a smile "Então continue a pensar assim."

# game/script.rpy:3532
translate ptbr ch7_e9b2e9b2:

    # n "Astragalus pours their tea and returns to her seat with two mugs in hand."
    n "Astragalus serve o chá e volta ao seu assento com duas canecas em mãos."

# game/script.rpy:3533
translate ptbr ch7_a98ff37d:

    # n "With a heavy sigh, Periwinkle finally relents and begins his story..."
    n "Com um suspiro, Periwinkle finalmente desiste e começa a contar suas história..."

# game/script.rpy:3539
translate ptbr ch7_d30066c5:

    # "I told her everything I could think of..."
    "Eu contei tudo que eu conseguia lembrar..."

# game/script.rpy:3540
translate ptbr ch7_33d9f84f:

    # "My first impressions of him. How he continuously subverted my expectations."
    "Minha primeira impressão dele. Como ele constantemente subverte as minhas expectativas."

# game/script.rpy:3541
translate ptbr ch7_c5f52926:

    # "My mistakes. Appearing where I shouldn't have, then going into a desperate spiral as I tried to rid myself of the guilt over it."
    "Meus erros. Aparecer onde eu não devia, e a espiral de desespero na qual eu cai enquanto tentava me livrar da culpa."

# game/script.rpy:3542
translate ptbr ch7_1bbf690f:

    # "How he was the one to come to apologize afterward..."
    "E que foi ele quem veio se desculpar comigo..."

# game/script.rpy:3543
translate ptbr ch7_c5838a34:

    # nvl clear
    # "Our date that day, which was so, so wonderful... but which also laid bare the feelings I was too afraid to acknowledge."
    nvl clear
    "{size=-2}Nosso encontro naquele dia, que foi tão, tão incrível... mas que também me expôs aos sentimentos que eu tinha tanto medo de sentir.{/size}"

# game/script.rpy:3545
translate ptbr ch7_e6e49546:

    # "How I latched on to any alternative explanation I could in order to escape them."
    "{size=-2}A forma como eu me agarrei a uma explicação fantasiosa para escapar desses sentimentos.{/size}"

# game/script.rpy:3546
translate ptbr ch7_4e84de73:

    # "The moment I could finally admit it to myself. All the ways he'd changed my life for the better."
    "{size=-2}O momento em que eu finalmente consegui aceitá-los. Todas as formas como ele mudou a minha vida para melhor.{/size}"

# game/script.rpy:3547
translate ptbr ch7_6a07a020:

    # "How we grew closer and closer, while I held those feelings tighter to my chest..."
    "{size=-2}Como nós nos tornamos tão próximos, mas ainda assim eu mantinha meus sentimentos em segredo...{/size}"

# game/script.rpy:3548
translate ptbr ch7_d4484d1e:

    # nvl clear
    # "I told her how he had finally worked up the courage to introduce me to his friends."
    nvl clear
    "Eu contei sobre como ele finalmente criou coragem para me apresentar aos amigos dele."

# game/script.rpy:3550
translate ptbr ch7_65da988b:

    # "How his hand trembled in mine as we walked out the door together."
    "O jeito como a mão dele tremia quando entramos na loja."

# game/script.rpy:3551
translate ptbr ch7_ee6b35c9:

    # "This point of contention, a far-off goal I had decided would have to be met before advancing..."
    "Falei sobre meu problema, esse objetivo que teria de ser atingido antes que nossa relação conseguisse avançar..."

# game/script.rpy:3552
translate ptbr ch7_ca54ab44:

    # "Everything, up to the state I'm in now. Useless, paralyzed, and sobbing."
    "Falei tudo, até sobre o estado em que me encontro agora. Inútil, paralizado e aos prantos."

# game/script.rpy:3553
translate ptbr ch7_92f40e14:

    # nvl clear
    # "Astragalus listened patiently through all of it."
    nvl clear
    "Astragalus ouviu tudo com a paciência de uma santa."

# game/script.rpy:3555
translate ptbr ch7_343d2423:

    # "She asked questions from time to time. Clarification on the timeframe, certain details..."
    "De vez em quando ela fazia uma pergunta. Querendo saber sobre horários ou alguns detalhes..."

# game/script.rpy:3556
translate ptbr ch7_87e644fe:

    # "Her reaffirming comments offered such comfort, such relief to this pain I'd kept confined to my own heart."
    "Os comentários positivos dela eram muito reconfortantes, oferecendo uma alívio a essa dor que estava confinada no meu coração."

# game/script.rpy:3557
translate ptbr ch7_b69014f7:

    # "Until finally, I had nothing left to say."
    "Até que finalmente, eu não tinha mais nada para contar."

# game/script.rpy:3558
translate ptbr ch7_d27b4990:

    # nvl clear
    # n "Astragalus sits back in her chair and heaves a sigh."
    nvl clear
    n "Astragalus se acomoda na cadeira e deixa escapar um suspiro."

# game/script.rpy:3562
translate ptbr ch7_a8670c2a:

    # a "So? How are you feeling?"
    a "Então? Como você se sente?"

# game/script.rpy:3563
translate ptbr ch7_04d072f1:

    # w hood oh2 "There's a certain clarity in laying it all out at once..."
    w hood oh2 "Tem um certo alívio em falar tudo de uma vez só..."

# game/script.rpy:3564
translate ptbr ch7_547bdb80:

    # w ohhh "But, I still... don't know what I can do to push things forward... could I even handle the rejection...?"
    w ohhh "Mas, eu ainda... não sei o que fazer para que as coisas avancem... eu aguentaria a rejeição...?"

# game/script.rpy:3565
translate ptbr ch7_a359177e:

    # a eyeroll "He won't reject you."
    a eyeroll "Ele não vai te rejeitar."

# game/script.rpy:3566
translate ptbr ch7_229785e7:

    # w sorry "What makes you so certain...?"
    w sorry "Como você sabe disso...?"

# game/script.rpy:3567
translate ptbr ch7_47ddd304:

    # a lmao "That boy is madly in love with you!! Why else would he devote all that time and energy to making you happy?"
    a lmao "O rapaz está completamente apaixonado por você!! Por que outra razão ele passaria tanto tempo tentando te fazer feliz?"

# game/script.rpy:3568
translate ptbr ch7_a282e00e:

    # w pout "Because I'm great in bed! Obviously!!" with vpunch
    w pout "Porque eu sou um transa fantástica! É óbvio!!" with vpunch

# game/script.rpy:3569
translate ptbr ch7_7d78d80b:

    # a lol2 "Quit deflecting! You know that's not all it is."
    a lol2 "Para de inventar desculpas! Você sabe que não é só isso."

# game/script.rpy:3570
translate ptbr ch7_c44bc880:

    # w nofair2 "I don't want to leave any room for doubt... if I were to confess now, and it didn't go well, I'd... I'd be destroyed beyond repair!"
    w nofair2 "Eu não quero fazer isso sem ter certeza... se eu confessar o que eu sinto e não der certo, eu... eu vou acabar destruído e sem concerto!"

# game/script.rpy:3571
translate ptbr ch7_699f61db:

    # w nofair "That's why, if I'm going to say it, I want it to be a sure thing."
    w nofair "Por isso, se eu for falar, eu quero ter certeza absoluta."

# game/script.rpy:3572
translate ptbr ch7_70aa9f4c:

    # a sure "Life ain't about \"sure things\"."
    a sure "Nessa vida não existe \"certeza absoluta\"."

# game/script.rpy:3573
translate ptbr ch7_1ce1b2b1:

    # w oops "Even so. I'm going to wait for the opportune moment before exposing my vulnerable heart...."
    w oops "Mesmo assim. Eu vou esperar o momento certo antes de expor meu coração tão vulnerável...."

# game/script.rpy:3574
translate ptbr ch7_67d2fe6a:

    # a eyeroll "As long as you've got a plan."
    a eyeroll "Contanto que você tenha um plano."

# game/script.rpy:3576
translate ptbr ch7_5c6e9d30:

    # n "Astragalus leans down to pick up Periwinkle's empty mug, then holds it out in front of him."
    n "Astragalus se abaixa para pegar a caneca vazia de Periwinkle, ela então segura a caneca na frente dele."

# game/script.rpy:3577
translate ptbr ch7_05b45148:

    # a happy "Try your magic again. Whatever scent you want, just pour it right in the cup."
    a happy "Tenta fazer magia de novo. Qualquer cheiro que você quiser, faz direto na caneca."

# game/script.rpy:3578
translate ptbr ch7_61f43815_1:

    # w hood ohhh "...."
    w hood ohhh "...."

# game/script.rpy:3582
translate ptbr ch7_bffebb26:

    # n "Periwinkle nervously draws his wand, holds it out to the cup... then closes his eyes, and taps."
    n "Periwinkle puxa sua varinha, nervoso ele a segura perto da caneca... ele então fecha os olhos e dá uma batida leve."

# game/script.rpy:3585
translate ptbr ch7_62bd9f4e:

    # w hood ohhh2 "...Is it...?"
    w hood ohhh2 "...Isso é...?"

# game/script.rpy:3586
translate ptbr ch7_31d796dc:

    # a "...."
    a "...."

# game/script.rpy:3587
translate ptbr ch7_a378f6db:

    # a hm "Chamomile?"
    a hm "Camomila?"

# game/script.rpy:3588
translate ptbr ch7_a5fd1669:

    # w my "It isn't peach...!"
    w my "Não é pessêgo...!"

# game/script.rpy:3589
translate ptbr ch7_48779aee:

    # w happy "I-I'm cured!!" with vpunch
    w happy "E-eu estou curado!!" with vpunch

# game/script.rpy:3590
translate ptbr ch7_c8bd051e:

    # a lol2 "Yeah, dumbass! Did you forget this is an apothecary?"
    a lol2 "Claro, seu imbecil! Você esqueceu que isso aqui é uma botica?"

# game/script.rpy:3591
translate ptbr ch7_15718a3f:

    # w ohdear "Ah... it is, isn't it...."
    w ohdear "Ah... é mesmo, não é...."

# game/script.rpy:3592
translate ptbr ch7_21466243:

    # a eyeroll "Next time you've got a problem with your magic, don't sit around crying about it on your own. Come straight to me, and I'll fix you up."
    a eyeroll "Da próxima vez que você tiver um problema com magia, não fica em casa choramingando. Vem falar comigo que eu dou um jeito."

# game/script.rpy:3593
translate ptbr ch7_ba5c6de9:

    # w love "Thank you... I..."
    w love "Obrigado... Eu..."

# game/script.rpy:3594
translate ptbr ch7_44e91ae4:

    # w shy "I'm truly glad that we're friends... I would be lost without you."
    w shy "Eu fico muito feliz por sermos amigos... Eu estaria perdido sem você."

# game/script.rpy:3595
translate ptbr ch7_4ffcdd35:

    # a sure "Business associates. Don't forget I've got loads of orders for you now that you're back to normal."
    a sure "Parceiros de negócios. Não esquece que agora eu tenho um monte de encomendas pra você fazer."

# game/script.rpy:3596
translate ptbr ch7_b19f23d3:

    # w happy "I'll go home and fill them right away! But first..."
    w happy "Eu vou para casa e vou começar a trabalhar nelas agora mesmo! Mas antes..."

# game/script.rpy:3597
translate ptbr ch7_9d2c05b0:

    # w love "May I hug you?"
    w love "Posso lhe dar um abraço?"

# game/script.rpy:3598
translate ptbr ch7_04792b09:

    # a augh "Not a chance!" with vpunch
    a augh "Nem pensar!" with vpunch

# game/script.rpy:3599
translate ptbr ch7_d733da0f:

    # w teehee "Hmhm, it was worth a shot. You'll accept my platonic affection one day~!"
    w teehee "Hmhm, valeu a tentativa. Um dia desse você vai aceitar minha afeição platónica~!"

# game/script.rpy:3600
translate ptbr ch7_7f7593b0:

    # a happy "Yeah, yeah... get outta my office, Periwinkle."
    a happy "Sei, sei... cai fora do meu escritório, Periwinkle."

# game/script.rpy:3607
translate ptbr ch7_875a28a9:

    # n "The pair exits the back room, but they only make it a few steps out before Periwinkle turns on his heel."
    n "O par deixa o quarto dos fundos, mas antes de se afastarem muito Periwinkle se vira para Astragalus."

# game/script.rpy:3608
translate ptbr ch7_4d17f35d:

    # w hood oh "Ah, one more thing, before I go..."
    w hood oh "Ah, mais uma coisa, antes de eu ir..."

# game/script.rpy:3610
translate ptbr ch7_3f808ca6:

    # a "Hm? What's up."
    a "Hm? Fala."

# game/script.rpy:3611
translate ptbr ch7_faf56b4e:

    # w smile "I've been curious to ask. The last time I was here, you told me that magic can be interpreted as a judge of one's character..."
    w smile "{size=-4}Eu queria perguntar. Da última vez em que eu estive aqui, você disse que você pode julgar o caráter de alguém com base no seu tipo de magia...{/size}"

# game/script.rpy:3612
translate ptbr ch7_09ac5a27:

    # a think "Oh, right. When I changed my mind about Pastille."
    a think "Ah, isso. Quando eu mudei de ideia sobre o Pastille."

# game/script.rpy:3613
translate ptbr ch7_e02f8699:

    # w calm "Yes, precisely. It's rather impressive that you could see through to his true nature, despite having only just met..."
    w calm "Sim, exatamente. É bastante impressionante que você pode perceber que tipo de pessoa ele é sem nem conhecê-lo..."

# game/script.rpy:3614
translate ptbr ch7_d75c0f1f:

    # a lol "Sure, but he was pretty easy to read. Don't be too impressed."
    a lol "Claro, mas ele é muito fácil de entender. Não fica muito impressionado."

# game/script.rpy:3615
translate ptbr ch7_7bba75e2:

    # w love "...Well?"
    w love "...E então?"

# game/script.rpy:3616
translate ptbr ch7_21235aed:

    # a lol2 "Well what?"
    a lol2 "Então o que?"

# game/script.rpy:3617
translate ptbr ch7_665ef7a8:

    # w happy "What does my magic say about me~? I'm dying to know 💙"
    w happy "O que a minha magia diz sobre mim~? Eu estou morrendo de curiosidade 💙"

# game/script.rpy:3618
translate ptbr ch7_f33dfb60:

    # a sure "YOUR magic... was always lively and carefree. Compassionate, too. Like Pastille's."
    a sure "A SUA magia... sempre foi vivaz e despreocupada. Cheia de compaixão. Assim como a do Pastille."

# game/script.rpy:3619
translate ptbr ch7_08b17c47:

    # w love "How can you possibly read something like \"carefree\" from perfume?"
    w love "Como você pode saber que alguém é \"despreocupado\" só com perfume?"

# game/script.rpy:3620
translate ptbr ch7_e94ff0db:

    # a lol "Hey, I'm just telling you the vibes I've gotten over the years."
    a lol "Ei, eu só estou falando a impressão que eu tive com o passar dos anos."

# game/script.rpy:3621
translate ptbr ch7_a2de6d44:

    # a think "Your aromas prioritize pleasure. But there was definitely a hint of loneliness in them, too..."
    a think "Seus aromas dão prioridade ao prazer. Mas eles também tem uma pitada de solidão..."

# game/script.rpy:3622
translate ptbr ch7_d8043053:

    # w teehee "Alright, now I KNOW you're making things up. I've always had someone to keep me company 💙"
    w teehee "Tá bom, agora eu SEI que você está inventando. Eu sempre tive alguém para me manter companhia 💙"

# game/script.rpy:3623
translate ptbr ch7_15310979:

    # a smile "Just because you've always got someone around doesn't mean you can't be lonely."
    a smile "Só porque você está com alguém não significa que você não possa estar solitário."

# game/script.rpy:3624
translate ptbr ch7_c61d8bb7:

    # w calm "And I suppose someone like you would know a thing or two about loneliness, hm?"
    w calm "E eu imagino que alguém como você deve saber várias coisas sobre solidão, não é?"

# game/script.rpy:3625
translate ptbr ch7_c94c969b:

    # a hm "I'm not lonely at all. In fact, I PREFER to be alone."
    a hm "Eu não sou solitária. Eu ESCOLHO ficar sozinha."

# game/script.rpy:3626
translate ptbr ch7_adf9c46f:

    # a closed "YOU on the other hand... can't stand it even for a second. That's why you'd always run off chasing someone to fill the void."
    a closed "VOCÊ por outro lado... não aguenta ficar sozinho um segundo. É por isso que você está sempre procurando algo pra preencher o vazio."

# game/script.rpy:3627
translate ptbr ch7_cd947219:

    # w ohdear "...Well THAT certainly isn't true."
    w ohdear "...Bom, ISSO certamente não é verdade."

# game/script.rpy:3628
translate ptbr ch7_be244ae7:

    # a lol "The peach stuff you gave me earlier was PURE loneliness. It was crying out, like \"Please, Pastille, never leave me~!\""
    a lol "Aquele treco de pêssego que você me deu antes era solidão DESTILADA."
    a "Pelo amor de deus, aquilo gritava \"Por favor, Pastille, não me abandone~!\""

# game/script.rpy:3629
translate ptbr ch7_27338eed:

    # w pout "This isn't fun anymore. Forget that I asked!"
    w pout "Isso já perdeu a graça. Esqueça que eu perguntei!"

# game/script.rpy:3630
translate ptbr ch7_11cf638a:

    # a happy "Sorry. Couldn't resist."
    a happy "Desculpa. Não deu pra resistir."

# game/script.rpy:3631
translate ptbr ch7_7623f766:

    # w oops "...."
    w oops "...."

# game/script.rpy:3632
translate ptbr ch7_b80c39a5:

    # w ohhh "I suppose you're right, though... I haven't been able to tell him that in words."
    w ohhh "Mas acho que você tem razão... Eu ainda não consegui falar para ele o que eu sinto."

# game/script.rpy:3633
translate ptbr ch7_ad5bdd9e:

    # w nofair2 "I can't keep holding back... he has to know. No matter the outcome."
    w nofair2 "Eu não posso ficar me segurando... ele tem que saber. Não importa o que aconteça."

# game/script.rpy:3634
translate ptbr ch7_60359fd7:

    # a smile "Good luck, okay? I'm sure it'll turn out just fine."
    a smile "Boa sorte, tá? Tenho certeza de que tudo vai dar certo."

# game/script.rpy:3635
translate ptbr ch7_a4d8dbdf:

    # w ohhh "Yes... yes, it likely will."
    w ohhh "Sim... sim, eu acho que vai."

# game/script.rpy:3636
translate ptbr ch7_0f7a9daf:

    # w shy "Thank you again... I'm truly grateful for all that you've done for me."
    w shy "Mais uma vez, obrigado... Eu sou muito grato por tudo que você já fez por mim."

# game/script.rpy:3641
translate ptbr ch7_47504267:

    # n "Astragalus waves him off, and Periwinkle leaves the apothecary with new resolve..."
    n "Astragalus lhe dá adeus e Periwinkle deixa a botica com sua determinação restaurada..."

# game/script.rpy:3651
translate ptbr ch7_8954e2f7:

    # "I spent the next several days catching up on my work."
    "Eu passo os próximos dias terminando o meu trabalho atrasado."

# game/script.rpy:3652
translate ptbr ch7_c124ee6b:

    # "Magic truly does come so easily with a clear mind! If only I'd swallowed my pride sooner."
    "A magia realmente flui mais facilmente com uma mente limpa! Se ao menos eu tivesse procurado ajuda antes."
    nvl clear

# game/script.rpy:3653
translate ptbr ch7_1e30c6c5:

    # "I completed batch after batch almost effortlessly, going down the long checklist Astragalus had given me..."
    "Eu termino encomenda atrás de encomenda sem problema algum, eu preparo todos os pedidos da longa lista que Astragalus me deu..."

# game/script.rpy:3654
translate ptbr ch7_ba772060:

    # "I hadn't even felt tired by the end of it. As if all this energy had been stored up inside me all along!"
    "Eu não estava nem cansando quando terminei. Era como se tivesse dias de energia presos dentro de mim!"

# game/script.rpy:3655
translate ptbr ch7_2d728c30:

    # nvl clear
    # "It was a relief to return to somewhat normalcy."
    nvl clear
    "Como é bom voltar a normalidade."

# game/script.rpy:3657
translate ptbr ch7_e65838f7:

    # "Thinking of Pastille no longer caused my heart to ache... at least, not enough to put me in a state of total despondence."
    "Pensar no Pastille não faz mais o meu coração doer... ou pelo menos, não o bastante para que eu entrasse em um estado de depressão."

# game/script.rpy:3658
translate ptbr ch7_b8bdf17b:

    # "Instead, those thoughts served as motivation. The way forward was clear."
    "Pelo contrário, isso serviu como motivação. O caminho a seguir estava claro."

# game/script.rpy:3659
translate ptbr ch7_975f7c4e:

    # "I would tell him how I felt... and surely..."
    "Eu iria contar a ele como eu me sinto... e certamente..."

# game/script.rpy:3660
translate ptbr ch7_38f5635f:

    # nvl clear
    # w pj calm "Surely things will turn out just fine...."
    nvl clear
    w pj calm "Certamente tudo acabaria bem..."

# game/script.rpy:3665
translate ptbr ch7_94b11f24:

    # n "The following night... Pastille shows up on Periwinkle's doorstep."
    n "Na noite seguinte... Pastille apareceu na porta de Periwinkle."

# game/script.rpy:3667
translate ptbr ch7_1810d3ec:

    # p "Get dressed. I wanna take you somewhere."
    p "Se vista. Eu quero levar você a um lugar."

# game/script.rpy:3668
translate ptbr ch7_89d40548:

    # w pj happy "Oh~ and where exactly am I being whisked away to? 💙"
    w pj happy "Oh~ e para onde é que eu vou ser levado? 💙"

# game/script.rpy:3669
translate ptbr ch7_f5ebb1d6:

    # p happy "You'll see. Wear comfortable shoes, okay?"
    p happy "Você vai ver. Vista sapatos confortáveis, tá bom?"

# game/script.rpy:3670
translate ptbr ch7_cd6c9ac9:

    # w calm "How mysterious..."
    w calm "Tão misterioso..."

# game/script.rpy:3671
translate ptbr ch7_c60adcac:

    # w smile "Hmhm, very well. I'll be ready momentarily 💙"
    w smile "Hmhm, muito bem. Eu vou estar pronto em um momentinho 💙"

# game/script.rpy:3674
translate ptbr ch7_98348ebf:

    # "This is it..."
    "É agora..."

# game/script.rpy:3675
translate ptbr ch7_09cbb0da:

    # "The dramatic confession scene is upon us!"
    "A cena da confissão dramática se aproxima!"

# game/script.rpy:3676
translate ptbr ch7_e135b4c9:

    # "I have to look my best! For good luck, of course."
    "Eu tenho que vestir as minhas melhores roupas! Para dar boa sorte, é claro."

# game/script.rpy:3677
translate ptbr ch7_572f99bc:

    # "And for confidence...."
    "E para me dar confiança...."

# game/script.rpy:3678
translate ptbr ch7_76b2fe88:

    # nvl clear
    nvl clear

# game/script.rpy:3690
translate ptbr ch7_28d525bc:

    # n "Hand in hand, the pair makes their way to the train station."
    n "De mãos dadas, o par caminha até a estação de trem."

# game/script.rpy:3691
translate ptbr ch7_931bcf8a:

    # w cute innocent "(Hmhm~ had he been planning something while I was sequestered away with my work?)"
    w cute innocent "(Hmhm~ ele planejou alguma coisa enquanto eu estava ocupado com o trabalho?)"

# game/script.rpy:3692
translate ptbr ch7_db582720:

    # w love "(Pastille is always so full of surprises... how positively delightful 💙)"
    w love "(Pastille é sempre tão cheio de surpresas... Tão incrivelmente encantador 💙)"

# game/script.rpy:3695
translate ptbr ch7_b5146a9c:

    # p "I hope I didn't interrupt any plans you had for the night...."
    p "Espero que não ter interrompido seus planos pra hoje...."

# game/script.rpy:3696
translate ptbr ch7_028375c7:

    # w happy "Oh, not at all~! It was about time I got out of the house again."
    w happy "Ah, de forma alguma~! Já era hora de eu sair um pouco de casa."

# game/script.rpy:3697
translate ptbr ch7_dd0f85ec:

    # w smile "I've actually had a very productive past several days, you know. Toiling away over my perfumes."
    w smile "Eu fui bastante produtivo nesses últimos dias, sabia. Trabalhando nos meus perfumes."

# game/script.rpy:3698
translate ptbr ch7_dcf1b0e8:

    # p ehe "Haha, I thought that might be the case, since you hadn't dropped by in a while."
    p ehe "Haha, eu pensei que fosse o caso, você não aparece na loja já tem um tempo."

# game/script.rpy:3699
translate ptbr ch7_fb3a840a:

    # w innocent "Did you miss me? 💙"
    w innocent "Ficou com saudades? 💙"

# game/script.rpy:3700
translate ptbr ch7_13104245:

    # p embarrassed "W-well...."
    p embarrassed "B-Bem...."

# game/script.rpy:3702
translate ptbr ch7_b1056d27:

    # n "Periwinkle hugs Pastille's arm tightly as they continue their walk."
    n "Periwinkle se agarra no braço de Pastille enquanto eles caminham juntos."

# game/script.rpy:3703
translate ptbr ch7_9e455bb5:

    # w cute shy "(I missed you, too...)"
    w cute shy "(Eu também fiquei com saudades...)"

# game/script.rpy:3706
translate ptbr ch7_92a9892d:

    # "When Pastille and I step off the train, we're greeted by grassy fields and a sky full of luminous stars."
    "Quando Pastille e eu deixamos o trem, nos deparamos com um campo aberto e um céu cheio de estrelas luminosas."

# game/script.rpy:3707
translate ptbr ch7_1242c23a:

    # "Just where has he taken me...?"
    "Onde é que ele está me levando...?"

# game/script.rpy:3708
translate ptbr ch7_924bc4f2:

    # "A trail of lanterns lights the lone path forward..."
    "Uma trilha de lanternas ilumina o caminho a seguir..."

# game/script.rpy:3709
translate ptbr ch7_27428714:

    # "Pastille takes the lead."
    "Pastille assume o papel de guia."

# game/script.rpy:3710
translate ptbr ch7_76b2fe88_1:

    # nvl clear
    nvl clear

# game/script.rpy:3713
translate ptbr ch7_794d51f4:

    # p "It's a bit of a walk from here... but I promise it'll be worth it."
    p "A caminhada é longa... mas eu prometo que vai valer a pena."

# game/script.rpy:3714
translate ptbr ch7_dd9f0107:

    # w cute love "A long walk, hm? Couldn't we take a ride on your broom together~?"
    w cute love "Uma caminhada, hm? Por que não voamos juntos em uma vassoura~?"

# game/script.rpy:3715
translate ptbr ch7_6e405e15:

    # p sure "Nah, it'd defeat the purpose. It'll feel more rewarding getting there on foot."
    p sure "Nem, isso estragaria o plano. Vai ser ainda mais recompensador se formos a pé."

# game/script.rpy:3716
translate ptbr ch7_ebba887b:

    # w calm "Hmhm... fair enough. Tragic, though, that you'd willingly pass on an opportunity for me to cling to you."
    w calm "Hmhm... que assim seja. É trágico pensar que você recusaria uma oportunidade de me ter agarrado em você."

# game/script.rpy:3717
translate ptbr ch7_34a0afcc:

    # p ehe "Haha, we can fly on the way back if you want."
    p ehe "Haha, podemos voar quando estivermos voltando."

# game/script.rpy:3719
translate ptbr ch7_4f263e5f:

    # n "Pastille offers his hand again, which Periwinkle takes with a smile."
    n "Pastille oferece sua mão novamente, e Periwinkle a segura com um sorriso."

# game/script.rpy:3724
translate ptbr ch7_59ddd814:

    # w "...Tell me more about your relationship with magic."
    w "...Me fale sobre a sua relação com a magia."

# game/script.rpy:3725
translate ptbr ch7_2528ce76:

    # p "Hm? What do you mean?"
    p "Hm? Como assim?"

# game/script.rpy:3726
translate ptbr ch7_3c167982:

    # w "It was the same when we cleaned my house together. You insisted on doing things manually..."
    w "Você fez a mesma coisa quando limpamos a minha casa juntos. Você insiste em fazer tudo a mão..."

# game/script.rpy:3727
translate ptbr ch7_7c5e0bd7:

    # w "Not that I minded at all. Seeing you lift so many heavy things was a treat in itself 💙"
    w "Não que eu me importe. Ver você levantar tantas coisas pesadas em si já fez valer a pena 💙"

# game/script.rpy:3728
translate ptbr ch7_4caf8895:

    # p "Hahaha, well..."
    p "Hahaha, bom..."

# game/script.rpy:3729
translate ptbr ch7_10f7805a:

    # p "Ever since I was young... it was clear I was, um... \"ridiculously talented\", as they'd put it."
    p "Desde que eu era pequeno... era óbvio que eu era, uh... \"ridiculamente talentoso\", foi o que disseram."

# game/script.rpy:3730
translate ptbr ch7_e85247dc:

    # p "My moms wanted me to be a traditional witch. They enrolled me in one of the top schools, so I could learn from the best."
    p "{size=-4}Minhas mães queriam que eu fosse um bruxo tradicional. Então elas me colocaram nas melhores escolas, pra que eu aprendesse com os melhores.{/size}"

# game/script.rpy:3732
translate ptbr ch7_0b59e908:

    # p "I-it was an all-girls school, though... Guess I was young enough that no one realized I was a boy."
    p "M-mas era uma escola só pra meninas... Acho que eu era jovem o bastante pra ninguém perceber que eu era um menino."

# game/script.rpy:3733
translate ptbr ch7_c1703821:

    # p "I really... didn't belong there. On any level."
    p "Eu realmente... não me encaixava lá. De todas as formas."

# game/script.rpy:3734
translate ptbr ch7_fa8d2d79:

    # p "But, I kept at it as long as I could. Just enough to keep my parents happy, until I could go out and live on my own."
    p "Mas, eu aguentei o máximo que eu consegui. Foi só por tempo o bastante para deixar elas felizes e até que eu conseguisse me sustentar."

# game/script.rpy:3736
translate ptbr ch7_73d8e924:

    # p "Haha, I still don't understand exactly why... but I always felt uncomfortable using my magic."
    p "Haha, eu ainda não sei a razão... mas eu nunca me senti confortável usando magia."

# game/script.rpy:3737
translate ptbr ch7_b1a584dd:

    # p "It felt like cheating. Like... this kind of power shouldn't come so easily."
    p "Parece trapaça. Tipo... ter esse tipo de poder não deveria ser fácil. "

# game/script.rpy:3738
translate ptbr ch7_f94b0797:

    # p "Sy thought so, too. I guess that's why I latched onto her when we met..."
    p "A Sy também pensa assim. Acho que é por isso que eu me apeguei a ela quando nos conhecemos..."

# game/script.rpy:3739
translate ptbr ch7_b940b2af:

    # p "She used to really hate magic. Which worked out perfectly for me--it was a good excuse to pretend to be a regular human like her."
    p "Ela costumava odiar a magia. O que foi bom pra mim--era a desculpa perfeita pra fingir ser uma pessoa normal como ela."

# game/script.rpy:3740
translate ptbr ch7_e058bb72:

    # p "So... that's what I did. For the past... seven years?"
    p "Então.. foi isso que eu fiz. Pelos últimos... sete anos?"

# game/script.rpy:3743
translate ptbr ch7_fe2bf237:

    # w cute my "Seven years... that's quite a long time!"
    w cute my "Sete anos... isso é bastante tempo!"

# game/script.rpy:3745
translate ptbr ch7_4d057338:

    # p "Yeah, but there was a lot to distract me back then... it took a while to get Atelier Sweets up and running."
    p "É, mas eu tinha muito com o que me manter ocupado na época... foi bem complicado fazer a Atelier Sweets funcionar."

# game/script.rpy:3746
translate ptbr ch7_dc3c7909:

    # p calm "And... Sy did eventually find out. I thought she'd disown me when she did..."
    p calm "E... a Sy acabou descobrindo. Eu pensei que ela fosse me odiar quando aconteceu..."

# game/script.rpy:3747
translate ptbr ch7_c13fd2df:

    # p ehe "But instead... she told me I shouldn't have hid it. Even though I doubt we would've become friends if I told her from the beginning..."
    p ehe "{size=-4}Mas não... ela disse que eu não devia ter escondido. Mas eu ainda acho que nós não teríamos virado amigos se ela soubesse desde o início...{/size}"

# game/script.rpy:3748
translate ptbr ch7_53e2aed6:

    # w calm "Quite impossible to please, hm?"
    w calm "Ela parece impossível de agradar, hm?"

# game/script.rpy:3749
translate ptbr ch7_03a0e69e:

    # p sure "You have no idea...."
    p sure "Você não tem ideia...."

# game/script.rpy:3750
translate ptbr ch7_6dc476af:

    # p smile "But... ever since she said that, I've been able to start embracing magic again. On my own terms."
    p smile "Mas... desde que ela disse isso, eu fui capaz de aceitar a magia de novo. Do meu próprio jeito."

# game/script.rpy:3751
translate ptbr ch7_3832c226:

    # w "(I'm beginning to grasp why he values her so highly...)"
    w "(Estou começando a entender porque ele tem tanto apreço por ela..)"

# game/script.rpy:3752
translate ptbr ch7_ff5b5b21:

    # p ohno "Um, sorry that I just keep talking about myself...."
    p ohno "Uh, desculpe, eu só fico falando de mim mesmo...."

# game/script.rpy:3753
translate ptbr ch7_d3905dce:

    # w happy "Don't apologize~! I'm the one who asked."
    w happy "Não se desculpe~! Fui eu quem perguntei."

# game/script.rpy:3754
translate ptbr ch7_7c140cec:

    # w smile "Besides, I'm content to listen. Say as much as you like."
    w smile "Além disso, eu fico feliz em ouvir. Fale o quanto você quiser."

# game/script.rpy:3755
translate ptbr ch7_acb13031:

    # p embarrassed "Thanks...."
    p embarrassed "Valeu...."

# game/script.rpy:3758
translate ptbr ch7_ea22c411:

    # n "Periwinkle gives Pastille's hand a reassuring squeeze."
    n "Periwinkle aperta a mão de Pastille para tranquilizá-lo."

# game/script.rpy:3760
translate ptbr ch7_6ce8c1d1:

    # "I love him..."
