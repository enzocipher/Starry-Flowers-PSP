# game/script.rpy:730
translate ptbr ch2_e5f82cff:

    # "Such a shame. Would've been nice to get one last round in~"
    "Que pena. Eu queria transar uma última vez antes de ele ir~"

# game/script.rpy:731
translate ptbr ch2_a69cdafc:

    # "...I did get a kiss goodbye, though 💙"
    "...Mas ele me deu um beijo de despedida 💙"

# game/script.rpy:732
translate ptbr ch2_79c07e86:

    # nvl clear
    # w bed shy "Ahh, it's nice to feel like a housewife for a moment~"
    nvl clear
    w bed shy "Ahh, como é bom se sentir como uma dona de casa por um momento~"

# game/script.rpy:734
translate ptbr ch2_369e7bdd:

    # w smile "But I should get to work, too..."
    w smile "Mas eu também tenho que trabalhar..."

# game/script.rpy:735
translate ptbr ch2_a95a50d1:

    # w happy "I have an order to fill, don't I~?"
    w happy "Eu tenho pedidos para entregar, não tenho~?"

# game/script.rpy:738
translate ptbr ch2_3c76f5d0:

    # n "Periwinkle finally rolls out of bed and gets ready for the day..."
    n "Periwinkle finalmente rola para fora da cama e se prepara para o dia..."

# game/script.rpy:741
translate ptbr ch2_5a13e7e9:

    # "The order in question is for a nearby apothecary."
    "O pedido em questão é para uma botica local."

# game/script.rpy:742
translate ptbr ch2_35f25f34:

    # "Did you know? Aromagic like mine is actually quite good for you~"
    "Você sabia? Aromagia como a minha faz muito bem para você~"

# game/script.rpy:743
translate ptbr ch2_8f79525a:

    # "It's got nothing on actual healing magic, but the calming atmosphere it creates does wonders for one's mood."
    "Não é uma magia curativa, mas ajuda a criar uma atmosfera de calma que faz maravilhas para os nervos."

# game/script.rpy:744
translate ptbr ch2_48c6a187:

    # nvl clear
    # "This particular batch is meant to help with insomnia..."
    nvl clear
    "Esse pedido é para ajudar com insônia..."

# game/script.rpy:746
translate ptbr ch2_9bdec3ec:

    # "Which is ironic, considering how late I stayed up with Pastille 💙"
    "O que é irônico, considerando que eu fiquei acordado até tarde com o Pastille 💙"

# game/script.rpy:747
translate ptbr ch2_e22fb32a:

    # nvl clear
    # w pj teehee "Whoops, can't be getting distracted now~ I really need to finish up these last few bottles..."
    nvl clear
    w pj teehee "Oops, não posso me distrair~ Preciso terminar estas últimas garrafas..."

# game/script.rpy:750
translate ptbr ch2_e708ef33:

    # w calm "{nw}"
    w calm "{nw}"

# game/script.rpy:751
translate ptbr ch2_2dd620a3:

    # n "Periwinkle closes his eyes and draws his wand."
    n "Periwinkle fecha seus olhos e saca sua varinha."

# game/script.rpy:753
translate ptbr ch2_3425d8a6:

    # n "Large drops form at its tip, falling into the empty bottle one by one."
    n "Grandes gotas se formam na ponta, caindo na garrafa vazia uma por uma."

# game/script.rpy:754
translate ptbr ch2_3222c5b9:

    # n "With each drip, the bottle's contents swell, and after only the fifth drop, it's completely filled."
    n "A cada gota, a garrafa se enche e depois da quinta gota, está completamente cheia."

# game/script.rpy:757
translate ptbr ch2_fbaed311:

    # w innocent "Perfect! Ahh, it's so much easier to finish these with a clear mind..."
    w innocent "Perfeito! Ahh, é tão mais fácil fazer isso com uma mente clara..."

# game/script.rpy:758
translate ptbr ch2_6e325112:

    # w shy "I can't help it if a refreshing night out is the only way to regain my focus 💙"
    w shy "Não posso evitar de pensar que uma noitada é a única forma de recuperar meu foco 💙"

# game/script.rpy:759
translate ptbr ch2_afd133a7:

    # w teehee "Although~ I probably could've gotten one of these done last night if Pastille hadn't been so impatient... 💙"
    w teehee "A pesar de que~ Eu provavelmente poderia ter terminado uma dessas garrafas ontem se o Pastille não fosse tão impaciente... 💙"

# game/script.rpy:760
translate ptbr ch2_44174832:

    # w calm "No, no, mustn't let my mind wander too far from work now."
    w calm "Não, não, não posso deixar minha mente vagar para longe do trabalho."

# game/script.rpy:762
translate ptbr ch2_67507517:

    # n "Periwinkle fills the remaining bottles, screwing the lids on as he goes."
    n "Periwinkle enche as outras garrafas, colocando as tampas conforme ele termina."

# game/script.rpy:764
translate ptbr ch2_5bd5f285:

    # w smile "There. Hmhm, now my house is going to smell like lavender..."
    w smile "Pronto. Hmhm, agora minha casa está cheirando a lavanda..."

# game/script.rpy:765
translate ptbr ch2_8bdf90ac:

    # w innocent "I'd better head out before I'm lulled to sleep by my own magic~"
    w innocent "É melhor sair antes que minha própria magia me faça cair no sono~"

# game/script.rpy:779
translate ptbr ch2_85bf7599:

    # "The apothecary is only a short walk away, but I've never managed to walk in its doors on time."
    "A botica não fica longe, mas eu nunca consigo chegar lá na hora combinada."

# game/script.rpy:780
translate ptbr ch2_bd4b3ec4:

    # "Perhaps because it's so close, I always underestimate the time it takes to reach it..."
    "Talvez por ser tão perto eu acabo subestimando o tempo necessário para chegar lá..."

# game/script.rpy:781
translate ptbr ch2_3b3d6df9:

    # "I can hear the owner tapping her foot with impatience as soon as I open the door."
    "Eu posso ouvir a dona batendo o pé de forma impaciente quando eu abro a porta."

# game/script.rpy:782
translate ptbr ch2_76b2fe88:

    # nvl clear
    nvl clear

# game/script.rpy:785
translate ptbr ch2_a74c124f:

    # w happy "Astragalus~! I have that special order ready for you~"
    w happy "Astragalus~! Eu tenho seu pedido especial prontinho~"

# game/script.rpy:786
translate ptbr ch2_318b7805:

    # a annoyed "You're late again, Periwinkle."
    a annoyed "Você está atrasado de novo, Periwinkle."

# game/script.rpy:787
translate ptbr ch2_1019ebc0:

    # w innocent "Lost track of time 💙 You'll forgive me, won't you~?"
    w innocent "Eu perdi a noção do tempo 💙 Mas você me perdoa, não é~?"

# game/script.rpy:788
translate ptbr ch2_7862874c:

    # a "You are literally my only provider who has no respect for appointments."
    a "Você é o meu único fornecedor que não tem respeito por horas marcadas."

# game/script.rpy:789
translate ptbr ch2_2fb8a6f9:

    # w oh "That's simply not true! I never miss a date."
    w oh "Isso não é verdade! Eu nunca perdi um encontro."

# game/script.rpy:790
translate ptbr ch2_acda7219:

    # a lol "There's the problem. You were out getting laid again, weren't you?"
    a lol "Esse é o problema. Você estava transando de novo, não estava?"

# game/script.rpy:791
translate ptbr ch2_dbeacd97:

    # w pout "How vulgar~ I had a romantic evening with a VERY cute boy..."
    w pout "Que vulgar~ Eu tive uma noite romântica com um rapaz MUITO bonitinho..."

# game/script.rpy:792
translate ptbr ch2_d7ebcbc7:

    # w innocent "Who then ended up sleeping over 💙"
    w innocent "Que acabou passando a noite comigo 💙"

# game/script.rpy:793
translate ptbr ch2_facdd2e0:

    # a whatever "Well, you had all week to fill the order. Try getting it done in advance next time."
    a whatever "Bom, você tinha a semana toda pra terminar o pedido. Tente terminar mais cedo da próxima vez."

# game/script.rpy:794
translate ptbr ch2_8de08278:

    # w calm "Yes, ma'am~"
    w calm "Sim, senhora~"

# game/script.rpy:795
translate ptbr ch2_e220bd55:

    # a closed "Now let's see what you brought..."
    a closed "Agora vamos ver o que você preparou..."

# game/script.rpy:797
translate ptbr ch2_6aa2ff6b:

    # "I've worked with Astragalus for a few years now."
    "Já faz alguns anos que eu trabalho com a Astragalus."

# game/script.rpy:798
translate ptbr ch2_88aee593:

    # "She's COMPLETLY immune to my charms. Shocking, to say the least."
    "Ela é COMPLETAMENTE imune aos meus charmes. O que é um choque, para dizer o mínimo."

# game/script.rpy:799
translate ptbr ch2_f1139fde:

    # "But it's meant we've been able to remain good friends all this time~"
    "Mas isso quer dizer que nós fomos capazes de permanecer amigos por todo esse tempo~"

# game/script.rpy:800
translate ptbr ch2_4fc199f3:

    # "Or... hm. Let's see..."
    "Ou... hm. Vamos ver..."

# game/script.rpy:801
translate ptbr ch2_76b2fe88_1:

    # nvl clear
    nvl clear

# game/script.rpy:804
translate ptbr ch2_2c3696be:

    # w oh "Astragalus. Would you consider us to be good friends?"
    w oh "Astragalus. Você diria que somos bons amigos?"

# game/script.rpy:805
translate ptbr ch2_c86bbb5c:

    # a whatever "I put up with you."
    a whatever "Eu aturo você."

# game/script.rpy:806
translate ptbr ch2_373f7314:

    # w happy "My, but you don't put up with ANYONE! You must really like me 💙"
    w happy "Meu bem, você não atura NINGUÉM! Você deve gostar muito de mim 💙"

# game/script.rpy:807
translate ptbr ch2_47067d4c:

    # a lol "You got a favor to ask or something? Is that what you're getting at?"
    a lol "Você quer pedir um favor ou alguma coisa assim? Onde quer chegar com isso?"

# game/script.rpy:808
translate ptbr ch2_df3d1bd8:

    # w calm "No, I was just thinking of how to categorize our relationship."
    w calm "Não, só estava pensando em como categorizar nosso relacionamento."

# game/script.rpy:809
translate ptbr ch2_72e2a8ac:

    # a "\"Business associate\" works just fine, doesn't it?"
    a "\"Parceiros de negócios\" funciona, não é?"

# game/script.rpy:810
translate ptbr ch2_5f78763b:

    # w happy "Come now, surely you consider us to be closer than that!"
    w happy "Vamos, tenho certeza de que você nos considera mais que isso!"

# game/script.rpy:811
translate ptbr ch2_ce50824a:

    # a sure "I know better than to get involved with you, Periwinkle."
    a sure "Eu sei muito bem que não devo me envolver com você, Periwinkle."

# game/script.rpy:812
translate ptbr ch2_17ce8a61:

    # w my "Why, whatever do you mean?"
    w my "Ora, o que quer dizer com isso?"

# game/script.rpy:813
translate ptbr ch2_0ac87123:

    # a whatever "You're too dazzling."
    a whatever "Você é muito chamativo."

# game/script.rpy:814
translate ptbr ch2_4a6eea27:

    # w innocent "I take that as a compliment~"
    w innocent "Eu vou interpretar isso como um elogio~"

# game/script.rpy:815
translate ptbr ch2_d60255a0:

    # a annoyed "Great, now will you stop distracting me? I'm trying to count."
    a annoyed "Ótimo, agora você pode parar de me distrair? Estou tentando contar."

# game/script.rpy:817
translate ptbr ch2_8c4a5641:

    # "Yes, we're definitely good friends."
    "Sim, com certeza somos bons amigos."

# game/script.rpy:818
translate ptbr ch2_9ecc4a32:

    # "\"Too dazzling\" though... I'm not sure there IS such a thing."
    "\"Muito chamativo\" ora essa... Eu não acho que tal coisa exista."

# game/script.rpy:819
translate ptbr ch2_82c90c4f:

    # "And what would be wrong with it if there was? What point is there in not shining as brightly as one can?"
    "E qual o problema se existir? Qual o propósito de brilhar se você não chamar toda a atenção possível?"

# game/script.rpy:820
translate ptbr ch2_d0dcce99:

    # "Astragalus finishes counting the bottles, sighing in feigned exasperation as she marks them off her checklist..."
    "Astragalus termina de contar as garrafas, deixando escapar um suspiro fingido enquanto ela marca o pedido como entregue..."

# game/script.rpy:821
translate ptbr ch2_529b0ff5:

    # nvl clear
    # a sure "You may always be late... but you deliver quality every time. You're consistent, if nothing else."
    nvl clear
    a sure "Você pode estar sempre atrasado... mas a qualidade sempre é boa. Pelo menos você é consistente. "

# game/script.rpy:824
translate ptbr ch2_389bf1e7:

    # w teehee "The waiting is part of the fun. It builds excitement, wouldn't you say?"
    w teehee "Esperar é parte da diversão. Esperar cria expectativa, você não concorda?"

# game/script.rpy:825
translate ptbr ch2_2f490664:

    # a whatever "Nope, just builds frustration for me. But at least you always come through."
    a whatever "Não, pra mim só cria frustração. Mas pelo menos você sempre entrega."

# game/script.rpy:827
translate ptbr ch2_4251ed12:

    # n "She unlocks a small drawer behind the counter, and takes out an envelope with Periwinkle's name scribbled on it."
    n "Ela destranca uma pequena gaveta atrás do balcão e pega um envelope com o nome de Periwinkle escrito."

# game/script.rpy:829
translate ptbr ch2_9104554e:

    # a closed "Here's the rest of your payment. Don't spend it all in one place."
    a closed "Aqui está o resto do pagamento. Não gaste tudo de uma vez só."

# game/script.rpy:830
translate ptbr ch2_338d50e7:

    # w calm "Oh, I couldn't if I tried! Really, you're too generous..."
    w calm "Ah, eu não conseguiria nem se tentasse! Você é generosa demais..."

# game/script.rpy:833
translate ptbr ch2_8daa5982:

    # n "Astragalus rolls her eyes and begins stocking the shelves with her new inventory."
    n "Astragalus rola os olhos e começa a encher a prateleira com o novo estoque."

# game/script.rpy:835
translate ptbr ch2_ffbdbe6c:

    # "Two or three orders a month... that's all it takes to support myself, entirely through this apothecary."
    "Dois ou três pedidos por mês... é tudo que eu preciso para me sustentar, e tudo através dessa botica. "

# game/script.rpy:836
translate ptbr ch2_ba2406db:

    # "Hard to believe my magic is really worth so much, but who am I to complain?"
    "É difícil de acreditar que a minha magia vale tanto, mas quem sou eu para reclamar?"

# game/script.rpy:837
translate ptbr ch2_acb5044d:

    # "It's certainly a more favorable balance compared to the kind of work I was doing years ago."
    "É certamente favorável quando comparado ao tipo de trabalho que eu fazia alguns anos atrás."

# game/script.rpy:838
translate ptbr ch2_7acd925f:

    # nvl clear
    # "And I do enjoy the freedom, the excessive amounts of time I have for partying, for dates..."
    nvl clear
    "E eu gosto da liberdade, da quantidade excessiva de tempo para festas, para encontros..."

# game/script.rpy:840
translate ptbr ch2_a2058868:

    # "Ah, on that note~"
    "Ah, falando nisso~"

# game/script.rpy:841
translate ptbr ch2_0b1b7e93:

    # nvl clear
    # w happy "With all that business out of the way... would you like to hear about my date? 💙"
    nvl clear
    w happy "Agora que o trabalho está feito... você quer ouvir sobre o meu encontro? 💙"

# game/script.rpy:844
translate ptbr ch2_fa857f5d:

    # a sure "Would I LIKE to? Not necessarily."
    a sure "Se eu QUERO ouvir? Na verdade não."

# game/script.rpy:845
translate ptbr ch2_95d8347d:

    # w teehee "Please, Astragalus, as someone with no romance in your OWN life, the least you can do is live vicariously through me~"
    w teehee "Por favor, Astragalus, já que você não tem romance nenhum na SUA vida, você pode viver vicariamente através de mim~"

# game/script.rpy:846
translate ptbr ch2_8be11c8d:

    # a whatever "The no romance thing is by choice. I listen to you gush for your own damn sake."
    a whatever "Eu escolho não ter romance. E eu ouço você falar porque você precisa."

# game/script.rpy:847
translate ptbr ch2_66b3a391:

    # w my "For MY sake?"
    w my "Por que EU preciso?"

# game/script.rpy:848
translate ptbr ch2_e2b9789b:

    # a sure "Yeah, I'm afraid you might actually implode if you had no one to talk to about this stuff."
    a sure "É, eu acho que se você não falar dessas coisas você vai acabar explodindo."

# game/script.rpy:849
translate ptbr ch2_fdfc2ccd:

    # a lol "I'm actually making a noble sacrifice every day that you come in here with new tales of romantic conquest."
    a lol "Eu faço um sacrifício pelo bem de todos quando você vem aqui falar de uma nova conquista romântica."

# game/script.rpy:850
translate ptbr ch2_b3b6ebb7:

    # w pout "Hmph. If you're truly suffering, I shall desist..."
    w pout "Hmph. Se você está sofrendo tanto, eu vou parar..."

# game/script.rpy:851
translate ptbr ch2_115b6d90:

    # a smile "That's the thing, though... I DO like seeing you all worked up over something, even if I don't understand it myself."
    a smile "Apesar de tudo... Eu REALMENTE gosto de ver você animado com alguma coisa, mesmo que eu não entenda."

# game/script.rpy:852
translate ptbr ch2_dfd74c02:

    # w happy "Ahh, so there IS a mutual benefit! You'll listen, then? 💙"
    w happy "Ahh, então EXISTE um benefício mútuo! Então você vai ouvir? 💙"

# game/script.rpy:853
translate ptbr ch2_e4b44b62:

    # a sure "Yeah, at least until I get all this put away. After that, I'm kicking you out for the day."
    a sure "Tá, vou, mas só até eu terminar de guardar as coisas. Depois disso, você está expulso pelo resto do dia."

# game/script.rpy:855
translate ptbr ch2_aa202e59:

    # w calm "Fair enough. I'd better be brief, then..."
    w calm "Justo. Então vou ser rápido..."

# game/script.rpy:857
translate ptbr ch2_c163a19e:

    # w teehee "He's the absolute cutest thing! I picked him up at a candy shop yesterday 💙"
    w teehee "Ele é a maior gracinha de todas! Eu achei ele em uma loja de doces ontem 💙"

# game/script.rpy:858
translate ptbr ch2_7ea91466:

    # w happy "Fluffy pink hair, with golden eyes, naturally rosy cheeks that make him look as if he's always a little embarrassed by something..."
    w happy "{size=-4}Cabelo macio e cor de rosa, olhos dourados, bochechas rosadas que fazem com que ele sempre pareça um pouco envergonhado com alguma coisa...{/size}"

# game/script.rpy:859
translate ptbr ch2_78bc035b:

    # w shy "He's shy, but not the type that becomes paralyzed in the bedroom--"
    w shy "Ele é tímido, mas não é do tipo que não sabe o que fazer no quarto--"

# game/script.rpy:860
translate ptbr ch2_e6e9e69b:

    # a augh "Periwinkle, for the last time, I do NOT need to hear about bedroom stuff." with vpunch
    a augh "Periwinkle, pela última vez, eu NÃO quero saber o que você faz no quarto." with vpunch

# game/script.rpy:861
translate ptbr ch2_91bce83e:

    # w my "I wasn't giving any details!"
    w my "Eu não ia dar detalhes!"

# game/script.rpy:862
translate ptbr ch2_f28bb905:

    # w shy "Although, the details ARE the best part 💙"
    w shy "Apesar de que os detalhes SÃO a melhor parte 💙"

# game/script.rpy:863
translate ptbr ch2_6f8d4d69:

    # a annoyed "This is a \"safe for work\" zone only. Break that rule, and you're outta here."
    a annoyed "Aqui não é uma loja \"só para maiores\". Você quebra essa regra e você não volta mais aqui."

# game/script.rpy:864
translate ptbr ch2_91ce2d8b:

    # w innocent "My apologies~ I'll refrain."
    w innocent "Minhas desculpas~ Não vou falar disso."

# game/script.rpy:865
translate ptbr ch2_dc5be651:

    # w love "Anyway, my point is... he's EXTREMELY cute. Adorable, in fact!"
    w love "De qualquer forma, o que eu quero dizer é... ele é EXTREMAMENTE bonitinho. Adorável, na verdade."

# game/script.rpy:866
translate ptbr ch2_d8b497e3:

    # a eyeroll "Right, so, standard fare for you."
    a eyeroll "Certo, então, o normal pra você."

# game/script.rpy:867
translate ptbr ch2_fc605430:

    # w my "Absolutely not! If he was just your average cutie, would I be emphasizing his cuteness so much?"
    w my "Claro que não! Se ele fosse bonitinho como a maioria, eu colocaria tanto ênfase em como ele é bonitinho?"

# game/script.rpy:868
translate ptbr ch2_a47387c2:

    # a sure "I don't meet these people, so it's all the same to me."
    a sure "Eu não conheço as pessoas de quem você fala, então não faz diferença pra mim."

# game/script.rpy:869
translate ptbr ch2_afb4034f:

    # w oh "How can it be~? The intensity is so drastically different... perhaps SO intense that I'm having trouble explaining it properly."
    w oh "Como pode ser isso~?"
    w "A intensidade é completamente diferente dos outros... talvez ele seja TÃO intenso que eu não estou conseguindo descrever direito."

# game/script.rpy:870
translate ptbr ch2_3da682aa:

    # a closed "I'll say. All you've really told me so far is that he's cute and shy."
    a closed "Falando sério. Tudo que você disse até agora é que ele é bonitinho e tímido."

# game/script.rpy:871
translate ptbr ch2_8e3642e4:

    # w shy "He's kind, as well! He saved the best part of our dessert for me without even asking!"
    w shy "Ele também é muito gentil! Ele guardou a melhor parte da sobremesa para mim sem que eu pedisse!"

# game/script.rpy:872
translate ptbr ch2_dfa9b85a:

    # a lol "Wow, I would've led with that one."
    a lol "Uau, eu teria começado a história por aí."

# game/script.rpy:873
translate ptbr ch2_fdbe174a:

    # w pout "Ohh, enough of your sarcasm. When all my favorite details are off-limits, what do you suppose I'm LEFT with?"
    w pout "Ohh, chega desse seu sarcasmo. Quando você não me deixa falar das minhas partes favoritas, o que você acha que SOBRA?"

# game/script.rpy:874
translate ptbr ch2_ab7c305b:

    # a happy "Well, what really matters is that you had a good night. Even if it meant you couldn't get here on time like I asked."
    a happy "Bom, o importante é que você teve uma boa noite. Mesmo que isso tenha feito você se atrasar. "

# game/script.rpy:875
translate ptbr ch2_f5e62b00:

    # w love "Ahh~ I'm already hoping to see him again, to be honest..."
    w love "Ahh~ Para ser sincero, eu espero vê-lo novamente..."

# game/script.rpy:876
translate ptbr ch2_0979287d:

    # a hm "Oh yeah? Don't hear that from you very often."
    a hm "Ah é? Você não diz esse tipo de coisa com frequência."

# game/script.rpy:877
translate ptbr ch2_83be95f7:

    # w oh "Really? But I've gone on second dates all the time."
    w oh "Mesmo? Mas eu vou em segundos encontros o tempo todo."

# game/script.rpy:878
translate ptbr ch2_95f62998:

    # a lol2 "This guy got a name?"
    a lol2 "Esse rapaz tem nome?"

# game/script.rpy:879
translate ptbr ch2_899be6dd:

    # w shy "Hmhm, I don't kiss and tell 💙"
    w shy "Hmhm, comigo é sigilo total 💙"

# game/script.rpy:880
translate ptbr ch2_7b70ce89:

    # a sure "No, actually, you tell me about everyone you kiss."
    a sure "Não, não é mesmo, você me conta tudo o tempo todo."

# game/script.rpy:881
translate ptbr ch2_44e74989:

    # a lol "C'mon, if he's really the absolute cutest, it's a shame to keep him anonymous, right? Not like I'm gonna tell anyone anyways."
    a lol "Qualé, se ele é tão bonitinho assim, é uma pena mantê-lo no anonimato, não é? Não é como se eu fosse contar pra alguém."

# game/script.rpy:882
translate ptbr ch2_cb259e44:

    # w calm "Fine... his name is Pastille."
    w calm "Tá bom... o nome dele é Pastille."

# game/script.rpy:883
translate ptbr ch2_ce121fd3:

    # a annoyed "Hmph. Even his name's cute."
    a annoyed "Hmph. Até o nome é bonitinho."

# game/script.rpy:884
translate ptbr ch2_b434ce04:

    # w happy "Right~?"
    w happy "Não é~?"

# game/script.rpy:885
translate ptbr ch2_2d463d2b:

    # w smile "Oh, that reminds me--he sold me some candies that share his name. Would you like to try?"
    w smile "Ah, falando nisso--ele me vendeu alguns doces com o nome dele. Você quer experimentar um?"

# game/script.rpy:886
translate ptbr ch2_628745c1:

    # a happy "Sure. How could a witch turn down free candy?"
    a happy "Claro. Que bruxa neste mundo recusa doce de graça?"

# game/script.rpy:887
translate ptbr ch2_2ac72dd0:

    # n "Periwinkle digs into his bag and pulls out one of the pastilles."
    n "Periwinkle abre sua bolsa e pega uma das pastilhas doce."

# game/script.rpy:888
translate ptbr ch2_c90345e5:

    # n "He hands the candy to Astragalus, who promptly unwraps it and pops it into her mouth."
    n "Ele entrega o doce para Astragalus, que prontamente o tira da embalagem e coloca na boca."

# game/script.rpy:889
translate ptbr ch2_e3dc6cdf:

    # a hm "Mmf... Oh, these are GOOD. Where'd you say this candy shop was?"
    a hm "Mmf... Ah, isso é BOM. Onde fica essa loja de doces de que você falou?"

# game/script.rpy:890
translate ptbr ch2_6e7c54dc:

    # w happy "Not far from here! I'll give you directions..."
    w happy "Não é longe daqui! Eu ensino como chegar..."

# game/script.rpy:897
translate ptbr ch2_58993334:

    # "Shortly after telling Astragalus where to find Atelier Sweets, she unceremoniously kicked me out..."
    "Logo depois de contar para Astragalus como chegar na Atelier Sweets, ela me expulsou sem cerimônia..."

# game/script.rpy:898
translate ptbr ch2_7f4ee160:

    # "She'd long finished putting all those bottles away, after all."
    "Afinal, já fazia tempo que ele tinha terminado de guardar as garrafas."

# game/script.rpy:899
translate ptbr ch2_d635dbff:

    # "With money in my pocket, and no more work to be done for the moment... I'm free to begin pursuing my next date~"
    "Com dinheiro no bolso e sem mais trabalho no momento... Estou livre para procurar pelo meu próximo encontro~"

# game/script.rpy:900
translate ptbr ch2_a4f99886:

    # nvl clear
    # "But wherever shall I go? It's a weekday, too early for parties, too early for drinks..."
    nvl clear
    "Mas onde eu posso ir? É um dia útil, ainda é cedo demais para festas e bebidas..."

# game/script.rpy:902
translate ptbr ch2_1e5385aa:

    # "I suppose I could return home and straighten up the place. However..."
    "Eu suponho que eu posso voltar para casa e arrumar as coisas. No entanto..."

# game/script.rpy:903
translate ptbr ch2_801baa18:

    # nvl clear
    # w calm "(Why would I busy myself with chores when I could be celebrating another order successfully filled?)"
    nvl clear
    w calm "(Por que encher minhas agenda de afazeres domésticos, quando eu posso celebrar outro pedido bem feito?)"

# game/script.rpy:906
translate ptbr ch2_7123d8ef:

    # n "Before Periwinkle can decide on where to go, a familiar witch approaches him."
    n "Antes que Periwinkle possa decidir para onde ir, uma bruxa familiar se aproxima."

# game/script.rpy:909
translate ptbr ch2_a7e53e02:

    # c "Periwinkle...?"
    c "Periwinkle...?"

# game/script.rpy:910
translate ptbr ch2_ed8e4bc5:

    # w happy "Ohh, Cassia! So lovely to see you~"
    w happy "Ahh, Cassia! Como é bom ver você~"

# game/script.rpy:911
translate ptbr ch2_cca6951a:

    # c happy "Yay, I'm so glad we ran into each other~"
    c happy "Oba, eu fico feliz de ter encontrado com você~"

# game/script.rpy:913
translate ptbr ch2_18cfade9:

    # "How to describe Cassia..."
    "Como posso descrever a Cassia..."

# game/script.rpy:914
translate ptbr ch2_0c67f0a0:

    # "She's exceedingly cuddly. We met at a party one night, during which she latched onto my arm and never let go. Quite endearing!"
    "Ela é extremamente fofinha. Nos conhecemos em uma festa, durante a qual ela se agarrou no meu braço e não largou mais. Foi bastante cativante!"

# game/script.rpy:915
translate ptbr ch2_6535f464:

    # "Since then, we've gone on little dates from time to time..."
    "Desde então nós saímos em encontros de vez em quando..."

# game/script.rpy:916
translate ptbr ch2_91a4c39c:

    # "She really loves my magic, so I tend to spoil her whenever we're together 💙"
    "Ela adora magia, então quando nos encontramos eu acabo mimando ela 💙 "

# game/script.rpy:917
translate ptbr ch2_fc9d5dc6:

    # nvl clear
    # w smile "Did you need something, dear?"
    nvl clear
    w smile "Você precisava de alguma coisa, querida?"

# game/script.rpy:920
translate ptbr ch2_7206142c:

    # c aww "Ah, yes! I tried coming over last night, but you didn't seem to be home..."
    c aww "Ah, sim! Eu passei na sua casa ontem a noite, mas você não parecia estar..."

# game/script.rpy:921
translate ptbr ch2_693e007a:

    # w shy "Aww, you came to visit me? I'm flattered 💙"
    w shy "Aww, você foi me visitar? Eu me sinto lisonjeado 💙"

# game/script.rpy:922
translate ptbr ch2_399869f1:

    # w smile "I must've been out to dinner at the time... Sorry that I missed you~"
    w smile "Eu devia estar jantando fora quando você foi... Eu sinto muito por não estar lá~"

# game/script.rpy:923
translate ptbr ch2_2f0adf6c:

    # c smile "Oh, it's okay~ I was mostly looking to talk..."
    c smile "Ah, não tem problema~ Eu só queria conversar..."

# game/script.rpy:924
translate ptbr ch2_c9ba5380:

    # c aww "So, um, if you're available right now... do you wanna go to a café?"
    c aww "Então, ah, se você não estiver fazendo nada... você quer ir tomar um café?"

# game/script.rpy:925
translate ptbr ch2_d5996b44:

    # w innocent "That sounds perfect! I would love to."
    w innocent "Parece perfeito! Eu adoraria."

# game/script.rpy:931
translate ptbr ch2_e516a126:

    # "We take our seats at the nearby café."
    "Nós nos sentamos em um café nas proximidades."

# game/script.rpy:932
translate ptbr ch2_07ec8f7d:

    # "It's a pleasant, sunny little place. I've come here often with all sorts of other witches."
    "É um lugarzinho ensolarado e agradável. Eu já vim aqui com todos os tipos de bruxos e bruxas."

# game/script.rpy:933
translate ptbr ch2_798bacd1:

    # "Cassia orders her usual hot chocolate with extra marshmallows, while I decide on a simple rose tea."
    "Cassia pede seu habitual chocolate-quente com marshmallows, enquanto eu decido pedir um simples chá de rosas."

# game/script.rpy:934
translate ptbr ch2_13febc5a:

    # nvl clear
    # c oh "Ooh, Periwinkle, could you make my marshmallows smell like roses, too?"
    nvl clear
    c oh "Aah, Periwinkle, você pode fazer os meus marshmallows ficarem com cheiro de rosa?"

# game/script.rpy:937
translate ptbr ch2_e1d1de4a:

    # w innocent "With pleasure 💙"
    w innocent "Com prazer 💙"

# game/script.rpy:938
translate ptbr ch2_d7d93e12:

    # n "Periwinkle's wand drops from his sleeve, and he gives Cassia's cup a quick little tap."
    n "Periwinkle puxa a varinha de sua manga e com ela toca de leve a caneca de Cassia."

# game/script.rpy:939
translate ptbr ch2_9343669f:

    # c happy "Eheh, yay~ It really smells just like roses~!"
    c happy "Eheh, oba~ Tem mesmo cheiro de rosas~!"

# game/script.rpy:940
translate ptbr ch2_790200db:

    # w smile "Just as you asked, dear. It may slightly affect the taste, so let me know if you'd like the spell undone."
    w smile "Como você pediu, querida. Pode ter um leve efeito no gosto, então me avise se quiser que eu desfaça o feitiço."

# game/script.rpy:942
translate ptbr ch2_51b79206:

    # n "Cassia dips her spoon in and lifts a marshmallow to her lips, blowing on it lightly before popping it into her mouth."
    n "Cassia afunda sua colher no chocolate e pesca um marshmallow, soprando nele antes de colocá-lo na boca."

# game/script.rpy:943
translate ptbr ch2_bb00d05f:

    # c happy "Mmf... no, it's wonderful! Ehehe~ 🤎"
    c happy "Mmf... não, está ótimo! Ehehe~ 🤎"

# game/script.rpy:946
translate ptbr ch2_88501500:

    # "She truly can find the joy in any little moment. Such a delight..."
    "Ela sempre encontra a felicidade nos pequenos momentos. Tão fofa..."

# game/script.rpy:947
translate ptbr ch2_28e04d59:

    # "Definitely a contender for the title of absolute cutest witch. Though I would call her... absolutely cute, rather than the absolute cutest."
    "Ela é uma ótima candidata ao título de bruxo ou bruxa mais adorável de todos. Apesar de que eu diria que ela é... toda adorável, mas não mais a adorável de todos."

# game/script.rpy:948
translate ptbr ch2_22a82a32:

    # "It takes more than cuteness alone to earn the title of absolute cutest witch! That's where the difference lies, of course."
    "É preciso mais do que ser só adorável para ser merecedor do título de mais adorável de todos! É aí que mora a diferença."

# game/script.rpy:949
translate ptbr ch2_1167b98f:

    # nvl clear
    # "But what am I thinking? How rude it is, to begin ranking my dates in such a way."
    nvl clear
    "Mas o que é que eu estou pensando? Categorizando meus encontros dessa forma é muita falta de educação."

# game/script.rpy:951
translate ptbr ch2_89364570:

    # "I must be stuck on the thought from my earlier conversation with Astragalus... trying to put Pastille's cuteness into words."
    "Eu ainda devo estar pensando na minha conversa com a Astragalus... tentando descrever com palavras o quão adorável o Pastille é."
    nvl clear

# game/script.rpy:952
translate ptbr ch2_f14542af:

    # "He really is something special... ah, it's all in the contrast! His polite, well-mannered and proper exterior, concealing such intense desire, begging you to make the first move, and then going ahead and taking it on his own as soon as you--"
    "Ele realmente é único... ah, mas é tudo graças aos contrastes! Ele é educado e tem boas maneiras por fora, mas tudo isso esconde um desejo intenso, implorando para que você dê o primeiro passo só para ele fazer isso antes de você no momento em que--"

# game/script.rpy:953
translate ptbr ch2_d02f8f43:

    # nvl clear
    # w oops "(...Enough of that! There's someone else in front of me now, isn't there?)" with vpunch
    nvl clear
    w oops "(...Já chega disso! Tem outra pessoa na minha frente nesse momento, não é?)" with vpunch

# game/script.rpy:956
translate ptbr ch2_84a03c6d:

    # n "Cassia continues happily sipping her hot chocolate before speaking up again."
    n "Cassia continua contente tomando seu chocolate-quente antes de falar novamente."

# game/script.rpy:958
translate ptbr ch2_4958d936:

    # c aw "Ahh, I missed you, Periwinkle~ I've been so busy with packing, I haven't had a chance to see you at all..."
    c aw "Ahh, eu estava com saudades, Periwinkle~ Eu estive tão ocupada fazendo as malas que nem tive tempo de ver você..."

# game/script.rpy:959
translate ptbr ch2_15a35145:

    # w my "Packing? And just where are you headed off to?"
    w my "Malas? E para onde é que você está indo?"

# game/script.rpy:960
translate ptbr ch2_959ab161:

    # c oh "Oh, that's right! I never had a chance to tell you~"
    c oh "Ah, isso mesmo! Eu não tive a chance de contar~"

# game/script.rpy:961
translate ptbr ch2_28a09411:

    # c happy "I'm finally moving in with my partners~! In two more days, the three of us will all be sleeping in the same bed~ 🤎"
    c happy "Eu finalmente vou morar com os meus parceiros~! Em dois dias, nós três vamos estar dormindo na mesma cama~ 🤎"

# game/script.rpy:962
translate ptbr ch2_1b9c5f18:

    # w happy "Ooh, that sounds cozy~ Congratulations!"
    w happy "Aah, parece aconchegando~ Meus parabéns!"

# game/script.rpy:963
translate ptbr ch2_937fc8b0:

    # c aww "Ehe, thank you~ 🤎 I've looked forward to it for so long..."
    c aww "Ehe, obrigada~ 🤎 Eu espero por isso há bastante tempo..."

# game/script.rpy:964
translate ptbr ch2_aae442de:

    # w smile "It sounds like you're about to enter a lovely domestic life. You deserve it!"
    w smile "Parece que você vai começar a viver uma adorável vida doméstica. Você merece!"

# game/script.rpy:965
translate ptbr ch2_f5692979:

    # c "Aww, hehehe... I'm really happy."
    c "Aww, hehehe... Eu estou muito feliz."

# game/script.rpy:966
translate ptbr ch2_d2fabfa3:

    # c oh "But, um... speaking of my partners. You've still never even met them..."
    c oh "Mas, ah... falando nos meus parceiros. Você ainda não os conheceu..."

# game/script.rpy:967
translate ptbr ch2_f5612c00:

    # w calm "True. But I can imagine they're wonderful, just from how you've talked about them."
    w calm "Verdade. Mas eu posso imaginar que eles são ótimos só pela forma como você fala deles."

# game/script.rpy:968
translate ptbr ch2_f82c96ac:

    # c aww "Right~ but, um... what if you didn't have to imagine?"
    c aww "Sim~ mas, uh... e se você não tivesse que imaginar?"

# game/script.rpy:969
translate ptbr ch2_add80a4e:

    # c smile "That's what I've been wanting to talk to you about. I was hoping... we might all be able to go on a group date sometime!"
    c smile "É sobre isso que eu queria falar. Eu estava pensando... que talvez todos nós pudéssemos sair em um encontro uma hora dessas!"

# game/script.rpy:970
translate ptbr ch2_c81c387b:

    # w oh "Oh~?"
    w oh "Oh~?"

# game/script.rpy:971
translate ptbr ch2_8b6f2fb7:

    # c aw "Yeah~! Because, like... I just think you're so wonderful, Periwinkle. I want them to know you, too!"
    c aw "É~! Porque, tipo... eu acho que você é incrível, Periwinkle. E eu quero que eles também conheçam você!"

# game/script.rpy:972
translate ptbr ch2_40b31e80:

    # w sorry "Mm... although it sounds like fun, I'm a bit..."
    w sorry "Mm... parece bastante divertido, mas eu..."

# game/script.rpy:973
translate ptbr ch2_7122e72f:

    # c please "W-wait, before you say no...!"
    c please "E-espera, antes que você diga não...!"

# game/script.rpy:974
translate ptbr ch2_b6456ff5:

    # c "They're both very easygoing, and so loving, and nice...! I can promise it won't be overwhelming..."
    c "Eles são tranquilos, amáveis e gentis...! Eu prometo que você não vai se sentir sobrecarregado..."

# game/script.rpy:975
translate ptbr ch2_62b54e38:

    # w decline "That unfortunately isn't where the issue lies, my dear..."
    w decline "Infelizmente esse não é o problema, minha querida..."

# game/script.rpy:976
translate ptbr ch2_bb65f581:

    # c sad "I-I know you said you didn't want to get involved before... but I just know that we would all get along so well!"
    c sad "E-eu sei que você já tinha dito que não tem interesse... mas eu tenho certeza de que todos nós nos daríamos super bem!"

# game/script.rpy:977
translate ptbr ch2_9db7f2b9:

    # c "I'd like to reassure you however I can. But I understand if you still turn me down..."
    c "Eu quero fazer o possível pra isso acontecer. Mas eu entendo se você ainda quiser recusar..."

# game/script.rpy:979
translate ptbr ch2_99af5b21:

    # "Matters of love are so tricky, aren't they?"
    "Os caprichos do coração são tão complicados, não é?"

# game/script.rpy:980
translate ptbr ch2_b7229a67:

    # "I still recall the first time something like this was asked of me..."
    "Eu ainda lembro da primeira vez que pediram que eu participasse de algo parecido..."

# game/script.rpy:981
translate ptbr ch2_70f4d8cb:

    # "I had been nervous going in, but I had also never entered a group situation before. I attributed my anxiety solely to that."
    "Eu estava bastante nervoso, já que eu nunca havia estado em uma situação em grupo. Eu achei que essa era a fonte da ansiedade."

# game/script.rpy:982
translate ptbr ch2_5aaf6eab:

    # "However, it quickly became clear that I just wasn't suited to it at all..."
    "No entanto, eu rapidamente percebi que isso não era para mim..."

# game/script.rpy:983
translate ptbr ch2_92e49d6c:

    # nvl clear
    # "I do love to spoil each of my partners--but strictly one at a time."
    nvl clear
    "Eu gosto de mimar os meus parceiros-- mas só um por vez."

# game/script.rpy:985
translate ptbr ch2_13099713:

    # "Perhaps I was left scarred by the breakdown in communication, the passionate fires of a long-established romance..."
    "Talvez eu tenha sido traumatizado pelos problemas de comunicação, queimado pelo fogo da paixão de um relacionamento que já existia antes..."

# game/script.rpy:986
translate ptbr ch2_000f6a86:

    # "Surely Cassia and her partners are magnificent people. It may indeed be fun for a night."
    "Tenho certeza de que Cassia e seus parceiros são pessoas fantásticas. Pode até ser divertido por uma noite."
    nvl clear

# game/script.rpy:987
translate ptbr ch2_e1d8cf3a:

    # "But becoming entangled in committed relationships is something I've always avoided from the beginning, isn't it?"
    "Mas ficar preso a relacionamentos de longo prazo é algo que eu sempre procurei evitar, não é?"

# game/script.rpy:988
translate ptbr ch2_b61e07ce:

    # nvl clear
    # w neutral "This is all very sweet of you. But I do have to decline."
    nvl clear
    w neutral "Isso é muito amável da sua parte. Mas eu vou ter que recusar."

# game/script.rpy:991
translate ptbr ch2_d6eb3267:

    # c letdown "Aww... I can't help but feel a little broken-hearted."
    c letdown "Aww... Não posso dizer que não fiquei um pouco triste."

# game/script.rpy:992
translate ptbr ch2_02d40560:

    # w decline "I apologize... Truly, it's nothing personal."
    w decline "Eu sinto muito... Sinceramente, não é nada pessoal."

# game/script.rpy:993
translate ptbr ch2_cea46204:

    # c aww "Oh, I know~ I don't take offense or anything..."
    c aww "Ah, eu sei~ Eu não me ofendi nem nada..."

# game/script.rpy:994
translate ptbr ch2_13fca6f4:

    # c letdown "It's just sad. Now that I'm going to be living with them... and, knowing you don't want to meet them..."
    c letdown "Eu só fico triste. Eu vou estar vivendo com eles... e sabendo que você não quer conhecê-los..."

# game/script.rpy:995
translate ptbr ch2_82188b3a:

    # c sad "I think it's best we just break things off...."
    c sad "Acho que é melhor terminar a nossa relação..."

# game/script.rpy:996
translate ptbr ch2_9b7a5305:

    # w neutral "Yes, I agree. As you said, it's for the best."
    w neutral "Sim, eu concordo. É como você diz, é o melhor a se fazer."

# game/script.rpy:997
translate ptbr ch2_22bfa56a:

    # c aww "I hope we can still be friends, though~"
    c aww "Espero que ainda possamos ser amigos~"

# game/script.rpy:998
translate ptbr ch2_a119e9ad:

    # w smile "Of course~ 💙 I'm sure our paths will cross every now and again."
    w smile "Mas é claro~ 💙 Tenho certeza de que nossos caminhos vão se cruzar novamente."

# game/script.rpy:999
translate ptbr ch2_96818197:

    # c happy "Yeah~! Thank you for always treating me so well, Periwinkle."
    c happy "Isso~! Obrigada por sempre me tratar tão bem, Periwinkle."

# game/script.rpy:1000
translate ptbr ch2_f9c0bf81:

    # w calm "Hmhm, it was my pleasure 💙"
    w calm "Hmhm, o prazer foi todo meu 💙"

# game/script.rpy:1003
translate ptbr ch2_482c7dd0:

    # "Even casual relationships can end in breakups like this."
    "Até relacionamentos casuais pode acabar com términos como esse."

# game/script.rpy:1004
translate ptbr ch2_7fabf76c:

    # "This is largely why I tend to prefer one-night affairs. Things can just become so messy as needs evolve..."
    "Eu normalmente prefiro relacionamentos de uma noite. As coisas podem ficar complicadas se passar disso..."

# game/script.rpy:1005
translate ptbr ch2_e8be9790:

    # "As Cassia and I go our separate ways, I can't help feeling a little blue."
    "Agora que Cassia e eu nos separamos, eu não posso evitar de ficar um pouco triste."

# game/script.rpy:1006
translate ptbr ch2_7b0bc9f1:

    # "Perhaps I'll return home for the day after all."
    "Talvez seja mesmo hora de voltar para casa."

# game/script.rpy:1007
translate ptbr ch2_76b2fe88_2:

    # nvl clear
    nvl clear

# game/script.rpy:1018
translate ptbr ch2_80d3118f:

    # n "Periwinkle quickly changes into something more comfortable, dropping his bag unceremoniously onto the couch."
    n "Periwinkle rapidamente veste algo mais confortável e joga sua bolsa no sofá."

# game/script.rpy:1019
translate ptbr ch2_a9ff1a56:

    # w pj neutral "(I could use an afternoon nap...)"
    w pj neutral "(Acho que uma soneca me faria bem...)"

# game/script.rpy:1020
translate ptbr ch2_10be0962:

    # w calm "(Yes, that's precisely what I need. I'll wake up feeling refreshed, and ready to go back out on the town~)"
    w calm "(Sim, é disso que eu preciso. Eu vou acordar me sentido melhor e pronto para uma noite de festa~)"

# game/script.rpy:1022
translate ptbr ch2_47c6e3ec:

    # n "He shoves some blankets aside and collapses onto the couch--and when he does, the contents of his bag spills onto the floor."
    n "Ele joga alguns cobertores para o lado e se joga no sofá--nesse momento, o conteúdo de sua bolsa cai no chão."

# game/script.rpy:1023
translate ptbr ch2_093623ac:

    # w oh "Ah..."
    w oh "Ah..."

# game/script.rpy:1024
translate ptbr ch2_189b671a:

    # n "Lazily leaning over to gather it up, he notices the candies from before..."
    n "Preguiçosamente, ele tenta juntar suas coisa, e acaba por ver os doces que haviam sobrado..."

# game/script.rpy:1025
translate ptbr ch2_cba66395:

    # w neutral "...."
    w neutral "...."

# game/script.rpy:1030
translate ptbr ch2_ed23994c:

    # "Was I too hasty in saying I'd hoped to see Pastille again?"
    "Será que eu fui muito precipitado quando disse que queria ver o Pastille novamente?"

# game/script.rpy:1031
translate ptbr ch2_cad66722:

    # "I suppose I'd forgotten the feeling of not being enough for someone."
    "Acho que eu tinha esquecido a sensação de não ser o bastante para alguém."

# game/script.rpy:1032
translate ptbr ch2_fc6603e2:

    # "Usually these things tend to dissipate naturally, without confrontation or notice."
    "Normalmente essas coisas somem com o tempo, sem precisar fazer alarde."

# game/script.rpy:1033
translate ptbr ch2_e7803a00:

