# game/script.rpy:1136
translate ptbr ch2_56fbbf51:

    # n "Their eyes meet, neither of them daring to be the first to move."
    n "Seus olhos se encontram, nenhum dos dois se atreve a fazer o primeiro movimento."

# game/script.rpy:1137
