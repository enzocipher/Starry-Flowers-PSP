    # "I've never felt so emotional over food...! What has this boy done to me?"
    "Eu nunca me senti tão emocionado por comida...! O que esse rapaz fez comigo?"

# game/script.rpy:2845
translate ptbr ch6_d42fc5b3:

    # nvl clear
    # "I was right about him being the culinary type."
    nvl clear
    "Eu estava certo sobre ele ser o tipo que é bom na cozinha."

# game/script.rpy:2847
translate ptbr ch6_a846ccd2:

    # "I didn't think I would get to try his cooking so soon... this is a surprise attack."
    "Eu não pensei que iria experimentar a comida dele tão cedo... e ainda por cima sem aviso prévio."

# game/script.rpy:2848
translate ptbr ch6_3495ef88:

    # "He even... ah, but how did those get there? I have to ask--"
    "Ele até... ah, mas como foi que ele conseguiu isso? Eu tenho que perguntar--"

# game/script.rpy:2849
translate ptbr ch6_76b2fe88:

    # nvl clear
    nvl clear

# game/script.rpy:2853
translate ptbr ch6_1784b473:

    # w pj oh "Pastille... where did you get these strawberries?"
    w pj oh "Pastille... de onde você pegou esses morangos?"

# game/script.rpy:2854
translate ptbr ch6_cf3877d3:

    # p ehe "Oh, I saw you had some jam, so I used a little magic to change its form..."
    p ehe "Ah, eu vi que você tinha geléia, então eu usei um pouco de magia para mudar a forma dela..."

# game/script.rpy:2855
translate ptbr ch6_d1a90016:

    # p ohno2 "Um, is that okay? Maybe I should've asked first--I just remember you liked strawberries, so..."
    p ohno2 "Uh, tem algum problema? Acho que era melhor ter perguntado antes--eu só lembrei que você gostava de morangos, aí eu..."

# game/script.rpy:2856
translate ptbr ch6_db20d73e:

    # w shy "(Is there any limit to how thoughtful one can be...?!)"
    w shy "(A consideração desse rapaz não tem limites...?!)"

# game/script.rpy:2857
translate ptbr ch6_ced19f55:

    # w love "It's more than okay! This is the best breakfast I've ever had...!"
    w love "Não tem problema! É o melhor café da manhã que eu já comi...!"

# game/script.rpy:2858
translate ptbr ch6_3aa7941c:

    # p shy "I'm sure you're exaggerating... they're just pancakes."
    p shy "Você está exagerando... são só panquecas."

# game/script.rpy:2859
translate ptbr ch6_12d8d8d4:

    # w teehee "Careful, my sweet... if you say it like that, I'm going to start asking you to cook my every meal."
    w teehee "Cuidado, meu doce... se você falar desse jeito, eu vou começar a pedir que você cozinhe todas as minhas refeições."

# game/script.rpy:2860
translate ptbr ch6_c38947a1:

    # p sure "Fine, you got me. They're special gourmet pancakes I can only whip up every once in a while."
    p sure "Tá, você me pegou. São panquecas gourmet especiais que eu só consigo fazer de vez em quando."

# game/script.rpy:2861
translate ptbr ch6_4b7d60e9:

    # w happy "Lucky me~! 💙"
    w happy "Que sorte a minha~! 💙"

# game/script.rpy:2864
translate ptbr ch6_9df71125:

    # n "Periwinkle finishes his pancakes while Pastille begins washing the dishes..."
    n "Periwinkle termina suas panquecas enquanto Pastille começa a lavar a louça..."

# game/script.rpy:2866
translate ptbr ch6_395109a4:

    # "This may just be the most spoiled I've ever felt..."
    "Eu nunca me senti tão mimado..."

# game/script.rpy:2867
translate ptbr ch6_76489d66:

    # "Being with Pastille is like getting caught in an endless whirlwind of positive feelings."
    "Estar com o Pastille é como estar preso em um ciclo infinito de sentimentos positivos."

# game/script.rpy:2868
translate ptbr ch6_0dbd129d:

    # "No wonder I've become obsessed with him. This boy is dangerously kind."
    "Agora eu sei porque eu estou obcecado com ele. Esse rapaz é uma ameaça de tão bom."

# game/script.rpy:2869
translate ptbr ch6_c7414828:

    # "After these past few emotionally tumultuous days, I... how could I possibly turn away from his comfort...?"
    "Depois das dificuldades emocionais desses últimos dias... como é que eu poderia dizer não para esse conforto...?"

# game/script.rpy:2870
translate ptbr ch6_7ab087e8:

    # nvl clear
    # n "Periwinkle rests his elbows on the table, head tilted into palm as he watches Pastille in his kitchen."
    nvl clear
    n "Periwinkle apoia os cotovelos na mesa, cabeça inclinada entre as mãos enquanto ele assiste Pastille na cozinha."

# game/script.rpy:2873
translate ptbr ch6_59ce0cf4:

    # w pj oh "Out of curiosity..."
    w pj oh "Só por curiosidade..."

# game/script.rpy:2875
translate ptbr ch6_bdbd5257:

    # p "Hm?"
    p "Hm?"

# game/script.rpy:2876
translate ptbr ch6_d05db3f5:

    # w "Earlier, before I woke up. What made you ask to start cleaning my room?"
    w "Mais cedo, antes de eu acordar. Por que você pediu para limpar o meu quarto?"

# game/script.rpy:2877
translate ptbr ch6_2563590a:

    # p ehe "Oh, I noticed it was getting harder to walk around..."
    p ehe "Ah, eu percebi que estava ficando mais difícil andar por aí..."

# game/script.rpy:2878
translate ptbr ch6_8bffd0df:

    # p shy "I think I stepped on some of your clothes when I, um... carried you in there last night. Sorry."
    p shy "Acho que eu pisei em algumas das suas roupas quando eu, uh... carreguei você até a cama noite passada. Desculpe."

# game/script.rpy:2879
translate ptbr ch6_32cb935a:

    # w calm "That's nothing to apologize for. It was fun."
    w calm "Não tem porque se desculpar. Foi divertido."

# game/script.rpy:2880
translate ptbr ch6_a00c9b60:

    # p embarrassed "Eheh... a-anyway... I felt a little bad about it."
    p embarrassed "Eheh... m-mas então... eu me senti meio mal sobre isso."

# game/script.rpy:2881
translate ptbr ch6_7219c855:

    # p ehe "So I figured, if I'm going to be coming back here so often, I might as well help clean."
    p ehe "Então eu pensei, se eu vou ficar voltando aqui, acho melhor arrumar logo as coisas."

# game/script.rpy:2882
translate ptbr ch6_0d37e844:

    # w ah "Ah...!"
    w ah "Ah...!"

# game/script.rpy:2883
translate ptbr ch6_fd796632:

    # p nervous "I-I'm not getting ahead of myself, am I? Sorry, I didn't mean--"
    p nervous "E-eu não estou me precipitando, não é? Desculpe, eu quis dizer--"

# game/script.rpy:2884
translate ptbr ch6_b8380aaf:

    # w shock "Not at all!" with vpunch
    w shock "De forma alguma!" with vpunch

# game/script.rpy:2886
translate ptbr ch6_7d5763ee:

    # n "Startled by the sudden outburst, Pastille stops what he's doing."
    n "Assustado pela reação de Periwinkle, Pastille para o que estava fazendo."

# game/script.rpy:2887
translate ptbr ch6_cd303bbf:

    # w shy "Hmhm, silly Pastille..."
    w shy "Hmhm, Pastille, seu bobo..."

# game/script.rpy:2888
translate ptbr ch6_fa84fa9d:

    # w love "You're always welcome here 💙"
    w love "Você é sempre bem-vindo 💙"

# game/script.rpy:2889
translate ptbr ch6_265a51d5:

    # p doki "Ah...! W-well, thank you...."
    p doki "Ah...! B-bom, obrigado...."

# game/script.rpy:2893
translate ptbr ch6_4bd430f5:

    # "Fine."
    "Tá bom."

# game/script.rpy:2894
translate ptbr ch6_44596fc6:

    # "Okay! Enough... I'll admit it."
    "Certo! Já chega... eu admito."

# game/script.rpy:2895
translate ptbr ch6_66217057:

    # "I'm stupidly, desperately, absolutely ridiculously..."
    "Eu estou absurdamente, desesperadamente, ridiculamente..."

# game/script.rpy:2896
translate ptbr ch6_4b601189:

    # "...in love with Pastille."
    "...apaixonado pelo Pastille."

# game/script.rpy:2897
translate ptbr ch6_b65603b6:

    # nvl clear
    # "There! I said it--or at least, I'm saying it to myself."
    nvl clear
    "Pronto! Falei--ou pelo menos, eu pensei."

# game/script.rpy:2899
translate ptbr ch6_8127d328:

    # "I'll accept this. Pastille is incredible! Who WOULDN'T fall for him?"
    "Já é o bastante. Pastille é incrível! Quem NÃO se apaixonaria por ele?"

# game/script.rpy:2900
translate ptbr ch6_a7f8f6b4:

    # "I don't want anyone else anymore. I've been poisoned by this perfect boy."
    "Eu não quero mais ninguém. Eu fui estragado pelo garoto perfeito."

# game/script.rpy:2901
translate ptbr ch6_4d52c35b:

    # "The problem now is what to DO about it...."
    "Agora o problema é o que FAZER a respeito disso..."

# game/script.rpy:2902
translate ptbr ch6_76b2fe88_1:

    # nvl clear
    nvl clear

# game/script.rpy:2905
translate ptbr ch6_b4d687b8:

    # p "Weird question, but..."
    p "Pode ser uma pergunta estranha, mas..."

# game/script.rpy:2906
translate ptbr ch6_36c7f47d:

    # p shy "Would you want to... um..."
    p shy "Você gostaria de... uh..."

# game/script.rpy:2907
translate ptbr ch6_1e42307e:

    # w pj innocent "(Date you? Yes!!)"
    w pj innocent "(Namorar você? Sim!!)"

# game/script.rpy:2908
translate ptbr ch6_1977ea6f:

    # p seriously "...Clean the rest of your house together?" with vpunch
    p seriously "...Limpar o resto da casa juntos?" with vpunch

# game/script.rpy:2909
translate ptbr ch6_4cd578fd:

    # w ohdear "...Hm?"
    w ohdear "...Hm?"

# game/script.rpy:2910
translate ptbr ch6_bdf3c1ab:

    # p shy "I-it'll be more fun than it sounds! And if you get bored, we can do something else..."
    p shy "Eu juro que é mais divertido do que parece! E se você ficar entediado, nós podemos fazer outra coisa..."

# game/script.rpy:2911
translate ptbr ch6_a76308ac:

    # w calm "Pastille..."
    w calm "Pastille..."

# game/script.rpy:2912
translate ptbr ch6_80a12d07:

    # p embarrassed "I just thought if we did it together, you'd get a say in where everything goes, so nothing ends up getting lost...!"
    p embarrassed "Eu só pensei que limpando juntos, você poderia decidir onde as coisas vão, então nada acabaria perdido...!"

# game/script.rpy:2913
translate ptbr ch6_ee213eff:

    # w love "Pastille...!"
    w love "Pastille...!"

# game/script.rpy:2914
translate ptbr ch6_c8b7db60:

    # p ehe2 "And it's totally fine if you don't want me going through your stuff anymore. We really don't have to--"
    p ehe2 "E não tem problema se você não quiser que eu mexa nas suas coisas. Nós não temos que fazer isso se--"

# game/script.rpy:2915
translate ptbr ch6_38742bdf:

    # w happy "Pastille, it's fine! I think it's a lovely idea."
    w happy "Pastille, tudo bem! Eu acho uma ótima ideia."

# game/script.rpy:2916
translate ptbr ch6_d3b99301:

    # p wha "R-really...?"
    p wha "M-mesmo...?"

# game/script.rpy:2917
translate ptbr ch6_d5f25738:

    # w innocent "Yes. In fact, I'd appreciate your help."
    w innocent "Sim. Na verdade, eu fico agradecido pela ajuda."

# game/script.rpy:2918
translate ptbr ch6_4ba187a4:

    # w love "One thing or another has always come up when I try to clean on my own. I'm simply useless at it."
    w love "Alguma coisa sempre acontece quando eu tento limpar a casa. Eu simplesmente não sirvo para isso."

# game/script.rpy:2919
translate ptbr ch6_c049910d:

    # p happy "Then... I'll take the lead! I wanted to start with these boxes by the couch..."
    p happy "Então... Eu vou assumir a liderança! Eu quero começar com essas caixas perto do sofá..."

# game/script.rpy:2923
translate ptbr ch6_98446b5c:

    # "Pastille already had a plan for everything, it seemed."
    "Pastille já parece ter elaborado um plano."

# game/script.rpy:2924
translate ptbr ch6_80b953ec:

    # "His energy was contagious. He was right that it would be fun--it was entertaining even just watching him go."
    "A energia dele é contagiosa. Ele tinha razão quando disse que seria divertido--eu já estava me divertindo só de assistir."

# game/script.rpy:2925
translate ptbr ch6_8e73e0b2:

    # "To see him dart around the room so energetically, finding the perfect place for every little thing..."
    "Ver ele correr ao redor da sala com tanta animação, achando o lugar perfeito para todas as coisas..."

# game/script.rpy:2926
translate ptbr ch6_f19b7285:

    # "He truly has a talent for organization."
    "Ele realmente tem um talento para organizar."

# game/script.rpy:2927
translate ptbr ch6_8bb41e57:

    # nvl clear
    # "Meanwhile, I mostly played the role of assistant."
    nvl clear
    "Enquanto isso, eu só fiquei no papel de assistente."

# game/script.rpy:2929
translate ptbr ch6_a1ad8874:

    # "He would ask for my input every now and then, or instruct me to place something he found somewhere across the room."
    "Ele perguntava o que eu achava de vez em quando, ou me dizia onde colocar alguma coisa no outro lado da sala."

# game/script.rpy:2930
translate ptbr ch6_092cda92:

    # "He made little decisions like that so easily. If it were me, I'd get stuck on every one..."
    "Ele fazia pequenas decisões como essa com tanta facilidade. Se fosse eu, acabaria pensando nelas por horas..."

# game/script.rpy:2931
translate ptbr ch6_48fd29c3:

    # "But he saw everything through, effortlessly. It was nothing short of amazing."
    "Mas ele decidia tudo sem esforço algum. Não era nada menos que fantástico."

# game/script.rpy:2932
translate ptbr ch6_8d433bab:

    # nvl clear
    # n "And so, in a short few hours..."
    nvl clear
    n "E então, em algumas poucas horas..."

# game/script.rpy:2938
translate ptbr ch6_80154118:

    # n "...The entire house had become neat and tidy."
    n "...A casa toda estava arrumada e limpa."

# game/script.rpy:2941
translate ptbr ch6_fe44cae1:

    # p "Okay... I think I'm satisfied. You?"
    p "Pronto... Eu estou satisfeito. E você?"

# game/script.rpy:2942
translate ptbr ch6_9e685ed1:

    # w pj shy "Hmm~ don't you think you deserve to be rewarded for all your hard work? 💙"
    w pj shy "Hmm~ não acha que é hora de receber uma recompensa depois de trabalhar tão duro? 💙"

# game/script.rpy:2943
translate ptbr ch6_876e21b0:

    # p uhoh "Ah--I-I should've seen that one coming...!"
    p uhoh "Ah--E-eu devia ter imaginado que isso ia acontecer...!"

# game/script.rpy:2944
translate ptbr ch6_09a70627:

    # p shy "But no, not right now! I should actually get going...."
    p shy "Mas não, não no momento! Na verdade, já é hora de eu ir..."

# game/script.rpy:2945
translate ptbr ch6_4a104fcf:

    # w smile "You won't stay?"
    w smile "Você não vai ficar?"

# game/script.rpy:2946
translate ptbr ch6_7477ec63:

    # p smile "I promised Gumdrop I'd be back for the afternoon shift. She'll start to worry if I don't come back soon."
    p smile "Eu prometi para a Gumdrop que eu voltaria para o turno da tarde. Ela vai começar a se preocupar se eu não voltar logo."

# game/script.rpy:2947
translate ptbr ch6_7efae89a:

    # w calm "Hmhm... I'll save your reward for next time, then."
    w calm "Hmhm...então vou guardar a sua recompensa para a próxima."

# game/script.rpy:2950
translate ptbr ch6_ebdb2310:

    # n "Pastille slips on his jacket and shoes."
    n "Pastille veste sua jaqueta e coloca os sapatos."

# game/script.rpy:2951
translate ptbr ch6_4a339e2c:

    # n "Just before he leaves, he turns back to face Periwinkle..."
    n "Logo antes de ir, ele se vira para Periwinkle..."

# game/script.rpy:2954
translate ptbr ch6_931329ba:

    # p "By the way, um... I was thinking..."
    p "Por sinal, uh... eu estava pensando..."

# game/script.rpy:2955
translate ptbr ch6_97a64bda:

    # w pj "Yes...?"
    w pj "Sim...?"

# game/script.rpy:2956
translate ptbr ch6_55b62f87:

    # p oh "There are some days my friends travel out of town. For alchemy stuff."
    p oh "Tem uns dias em que meus amigos saem da cidade. Pra fazer coisas de alquimia."

# game/script.rpy:2957
translate ptbr ch6_5634565b:

    # p shy "So if you ever wanted to drop by while I'm working on those days... I think that'd be okay..."
    p shy "Então se você quiser aparecer na loja enquanto eu trabalho nesses dias... não teria problema..."

# game/script.rpy:2958
translate ptbr ch6_9d4854d5:

    # p ehe "That's, um... the most I can do right now... sorry."
    p ehe "Esse é, uh... o melhor que eu posso fazer por enquanto... desculpe."

# game/script.rpy:2959
translate ptbr ch6_41c1209f:

    # w happy "I'll gladly take you up on that! I'd love to keep you company 💙"
    w happy "Eu aceito essa proposta com prazer! Eu adoraria lhe fazer companhia 💙"

# game/script.rpy:2960
translate ptbr ch6_8fc6bb84:

    # p smile "Great! Okay, then...."
    p smile "Ótimo! Certo, então...."

# game/script.rpy:2964
translate ptbr ch6_7cabd49b:

    # n "Pastille gives him a quick peck on the cheek..."
    n "Pastille lhe dá um beijinho na bochecha..."

# game/script.rpy:2966
translate ptbr ch6_3305bee7:

    # n "...before saying goodbye, and walking out the door."
    n "...antes de dar adeus e sair porta a fora."

# game/script.rpy:2971
translate ptbr ch6_7969eade:

    # w pj wow "...."
    w pj wow "...."

# game/script.rpy:2973
translate ptbr ch6_c71484d3:

    # "What... WAS all of that?"
    "O que... FOI tudo isso?"

# game/script.rpy:2974
translate ptbr ch6_77393381:

    # "It was extremely domestic! I can't be imagining things, can I?"
    "Isso foi muito doméstico! Eu não estou imaginando coisas, estou?"

# game/script.rpy:2975
translate ptbr ch6_a79fc5b9:

    # "He said it was okay... to come and visit him...?"
    "Ele disse que não tem problema... ir visitar ele...?"

# game/script.rpy:2976
translate ptbr ch6_3ed40c2c:

    # "That has to mean something, doesn't it?"
    "Isso tem que significar alguma coisa, não é?"

# game/script.rpy:2977
translate ptbr ch6_b3442fd3:

    # nvl clear
    # w pj nofair "......"
    nvl clear
    w pj nofair "......"

# game/script.rpy:2980
translate ptbr ch6_d0687ab0:

    # n "Periwinkle begins pacing around the room."
    n "Periwinkle começa a caminhar em círculos pela sala."

# game/script.rpy:2982
translate ptbr ch6_ee66677e:

    # "Now, now... let's not get carried away."
    "Calma, calma... não vamos fazer tempestade em copo d'água."

# game/script.rpy:2983
translate ptbr ch6_da436e71:

    # "This is a delicate situation. Dropping these intense feelings onto him out of nowhere may only serve to scare him off."
    "Essa é uma situação delicada. Contar sobre esses sentimentos tão intensos do nada pode acabar assustando ele."

# game/script.rpy:2984
translate ptbr ch6_9440b0fe:

    # "Neither of us was looking for a committed relationship from the beginning--that was made explicitly clear early on!"
    "Nenhum de nós estava procurando por um relacionamento de longo prazo desde o começo--isso foi especificado no primeiro encontro!"

# game/script.rpy:2985
translate ptbr ch6_43ab76b1:

    # "And yet... and yet...!"
    "E mesmo assim... mesmo assim...!"

# game/script.rpy:2986
translate ptbr ch6_6333e45c:

    # nvl clear
    # w nofair2 "He isn't playing fair...! My heart can't take this!"
    nvl clear
    w nofair2 "Ele não está sendo justo...! Meu coração não aguenta!"

# game/script.rpy:2989
translate ptbr ch6_027ff050:

    # n "Periwinkle throws himself onto the couch dramatically."
    n "Periwinkle se joga de forma dramática no sofá."

# game/script.rpy:2990
translate ptbr ch6_e25e9729:

    # w pj yell "There's no way I'll be able to stop thinking of him now... even being at home has become a reminder in and of itself...!"
    w pj yell "Não tem como parar de pensar nele... até a minha própria casa se tornou um lembrete dele...!"

# game/script.rpy:2991
translate ptbr ch6_08637e4e:

    # w nofair "Everything is nice because of him! And now I'm suffering...!!"
    w nofair "Tudo está arrumado por causa dele! E agora eu estou sofrendo...!!"

# game/script.rpy:2993
translate ptbr ch6_c2595cfb:

    # "This is simply too much..."
    "Isso já é demais..."

# game/script.rpy:2994
translate ptbr ch6_b7a26f25:

    # "There has to be a way for me to safely indulge in these romantic feelings."
    "Tem de existir um jeito de satisfazer esses sentimentos românticos de forma segura."

# game/script.rpy:2995
translate ptbr ch6_f0e953fa:

    # "Things are fine as they are. Progressing, even."
    "As coisas estão bem como estão. Estão até melhorando."

# game/script.rpy:2996
translate ptbr ch6_8a9f8371:

    # "If I just let it run its natural course, then maybe we'll end up..."
    "Se eu deixar que tudo aconteça naturalmente, então talvez ele acabe..."

# game/script.rpy:2997
translate ptbr ch6_74c39862:

    # nvl clear
    # "Ah... what do I want out of this?"
    nvl clear
    "Ah... O que eu quero dessa relação?"

# game/script.rpy:2999
translate ptbr ch6_d0086124:

    # "To be with him forever? ME?!"
    "Ficar com ele para sempre? EU?!"

# game/script.rpy:3000
translate ptbr ch6_54531ff3:

    # "I haven't had a single healthy long-term relationship in my entire life! Love isn't in the cards for someone like me..."
    "Eu nunca tive uma relação saudável de longo prazo em toda a minha vida! O amor não está nas cartas para alguém como eu..."

# game/script.rpy:3001
translate ptbr ch6_de6de606:

    # "Ugh, I... I can't even recognize myself right now...!"
    "Ugh, Eu... eu nem me reconheço mais...!"

# game/script.rpy:3002
translate ptbr ch6_c71bbc8b:

    # nvl clear
    # w decline "*sigh* ...Calm down."
    nvl clear
    w decline "*suspiro* ... Calma, calma."

# game/script.rpy:3004
translate ptbr ch6_e31dafc0:

    # w neutral "I'm overreacting again. Nothing has effectively changed just yet."
    w neutral "Eu estou exagerando de novo. Nada realmente mudou."

# game/script.rpy:3006
translate ptbr ch6_ac683799:

    # "I can't keep fighting myself on this..."
    "Eu não posso ficar brigando comigo mesmo..."

# game/script.rpy:3007
translate ptbr ch6_58b7973a:

    # "I'm in love with Pastille--No matter what it entails, that's the reality."
    "Eu estou apaixonado pelo Pastille--não importa o que isso signifique, essa é a realidade."

# game/script.rpy:3008
translate ptbr ch6_77ae6378:

    # "He still isn't quite ready for me to meet his friends, which means... there isn't any room to advance further at the moment."
    "E ele não está pronto para me apresentar aos amigos, o que significa... que não tem espaço para que essa relação progrida no momento."

# game/script.rpy:3009
translate ptbr ch6_82b36bbd:

    # "I have to be patient."
    "Eu tenho que ter paciência."

# game/script.rpy:3010
translate ptbr ch6_1b1e1fde:

    # nvl clear
    # w empty "At the very least, I hope accepting all this lets my magic return to normal..."
    nvl clear
    w empty "Pelo menos, eu espero que aceitar esses sentimentos faça com que a minha magia volte ao normal..."

# game/script.rpy:3012
translate ptbr ch6_aab52ef0:

    # w sleepy "*sigh* ...I need a nap."
    w sleepy "*suspiro* ...Eu preciso dormir."

# game/script.rpy:3017
translate ptbr ch6_4bc6b794:

    # n "And so, over the next few weeks..."
    n "E então, nas próximas semanas..."

# game/script.rpy:3019
translate ptbr ch6_ed3721c2:

    # n "Periwinkle would come by Atelier Sweets to spend time with Pastille."
    n "Periwinkle visitou Atelier Sweets para passar um tempo com Pastille."

# game/script.rpy:3031
translate ptbr ch6_650246fd:

    # "He always stood there so sweetly behind the counter."
    "Ele sempre ficava lá, bem arrumadinho atrás do balcão."

# game/script.rpy:3032
translate ptbr ch6_038e0033:

    # "And then I would waltz in, pretending to be just another customer, browsing the aisles before meandering over to him..."
    "E então eu entrava em cena, fingindo ser mais um cliente qualquer, olhando os produtos e aos poucos me aproximando dele..."

# game/script.rpy:3034
translate ptbr ch6_958370f1:

    # "Others would stop in every now and again, but there was ample time in which I had him completely to myself 💙"
    "Outros clientes entravam na loja de vez em quando, mas mesmo assim ainda tinha muito tempo em que éramos só nós dois 💙"

# game/script.rpy:3035
translate ptbr ch6_cc1ef0c4:

    # "That's when I'd take the opportunity to chat..."
    "E nesses momentos eu aproveitava para conversar..."

# game/script.rpy:3036
translate ptbr ch6_76b2fe88_2:

    # nvl clear
    nvl clear

# game/script.rpy:3038
translate ptbr ch6_372a5a1f:

    # w calm "Hmhm, this place smells just like you, my sweet~"
    w calm "Hmhm, esse lugar tem o seu cheiro, meu doce~"

# game/script.rpy:3039
translate ptbr ch6_f8395ebd:

    # p ehe "I think it's the other way around... d-do I smell like candy or something?"
    p ehe "Eu acho que é o contrário... e-eu tenho cheiro de doce ou algo assim?"

# game/script.rpy:3040
translate ptbr ch6_504d2a88:

    # w happy "Why else do you think I want to eat you up?"
    w happy "Por que você acha que eu quero comer você todinho?"

# game/script.rpy:3041
translate ptbr ch6_c62c6083:

    # p omg "A-aaahh...! Please don't say things like that when there are customers here!" with vpunch
    p omg "A-aaahh...! Por favor não diga essas coisas enquanto tem clientes na loja!" with vpunch

# game/script.rpy:3042
translate ptbr ch6_d4eebef7:

    # w oh "Customers? I don't see anyone."
    w oh "Clientes? Eu não vejo nenhum."

