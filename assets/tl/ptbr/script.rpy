translate ptbr ch5_de48edd8:

    # w "You forgot to turn the light off...."
    w "Você esqueceu de apagar a luz...."

# game/script.rpy:2763
translate ptbr ch5_a01f3a61:

    # p "W-well... I can't get up now...."
    p "B-bom... eu não vou sair da cama agora...."

# game/script.rpy:2764
translate ptbr ch5_165a8c0c:

    # w "(How can he be so impatient after making me wait for so long...?)"
    w "(Como ele pode ser tão impaciente depois de me fazer esperar tanto tempo...?)"

# game/script.rpy:2766
translate ptbr ch5_32610596:

    # w "Hmhm... oh well."
    w "Hmhm... ah bem."

# game/script.rpy:2778
translate ptbr ch6_7b49a2da:

    # centered "{w=3}{nw}"
    centered "{w=3}{nw}"

# game/script.rpy:2785
translate ptbr ch6_119ba1b9:

    # "I awake to a rustling sound."
    "Eu acordo com os sons de algo se mexendo."

# game/script.rpy:2786
translate ptbr ch6_ab14d017:

    # "My bed is empty again, but when I roll over..."
    "Minha cama está vazia de novo, mas quando eu me viro..."

# game/script.rpy:2787
translate ptbr ch6_b46fc96f:

    # "Pastille is there, standing in front of my closet."
    "Lá está o Pastille, parado em frente ao meu armário."

# game/script.rpy:2788
translate ptbr ch6_761374d1:

    # nvl clear
    # "I sit up, rubbing the sleep from my eyes."
    nvl clear
    "Eu me sento, esfregando os meus olhos."

# game/script.rpy:2790
translate ptbr ch6_bd31bc8e:

    # "He's holding a box. As he lifts it on to the top shelf, its contents shift, making a clattering noise."
    "Ele está segurando uma caixa. Quando ele a levanta para coloca-lá na prateleira, o conteúdo da caixa faz barulho."

# game/script.rpy:2791
translate ptbr ch6_64a5f7e2:

    # "Utterly confused as to what he's doing, I finally call out to him."
    "Completamente confuso a respeito do que ele está fazendo, eu falo seu nome."

# game/script.rpy:2792
translate ptbr ch6_cd1b109b:

    # nvl clear
    # w bed sleepy "Pastille...?"
    nvl clear
    w bed sleepy "Pastille...?"

# game/script.rpy:2798
translate ptbr ch6_f0b9d5cf:

    # p "Sorry! I didn't break anything, I promise."
    p "Desculpe! Eu não quebrei nada, eu juro."

# game/script.rpy:2799
translate ptbr ch6_162a2395:

    # w sleepy2 "What are you doing in my closet...?"
    w sleepy2 "O que você está fazendo no meu armário...?"

# game/script.rpy:2800
translate ptbr ch6_c6af6f68:

    # p um "Huh...? You said I could clean up."
    p um "Huh...? Você disse que eu podia limpar."

# game/script.rpy:2801
translate ptbr ch6_50b69d81:

    # w "Hmm...?"
    w "Hmm...?"

# game/script.rpy:2802
translate ptbr ch6_ac6fcf82:

    # w guilty "Oh, haha... is there anything I won't agree to in my sleep...?"
    w guilty "Oh, haha... será que eu concordo com qualquer coisa enquanto durmo...?"

# game/script.rpy:2803
translate ptbr ch6_50286f17:

    # p embarrassed "Ah--I'm sorry, I thought you were awake when I asked...! I-I'll stop."
    p embarrassed "Ah--Desculpe, eu achei que você estava acordado quando eu perguntei...! E-eu vou parar."

# game/script.rpy:2804
translate ptbr ch6_11d9a40b:

    # w sleepy3 "It's fine... I just didn't expect to wake up to you rifling through my things."
    w sleepy3 "Tudo bem... Eu só não esperava acordar e ver você mexendo nas minhas coisas."

# game/script.rpy:2805
translate ptbr ch6_1b21a1bb:

    # p flustered2 "Th-that really wasn't my intention...! I just felt like organizing stuff...."
    p flustered2 "E-eu não estava querendo bisbilhotar...! Eu só queria organizar as coisas...."

# game/script.rpy:2806
translate ptbr ch6_8abb953b:

    # p think "What do people normally do on the morning after...? I guess I should've made breakfast."
    p think "O que as pessoas normalmente fazem na manhã seguinte...? Acho que eu devia ter feito café da manhã."

# game/script.rpy:2807
translate ptbr ch6_d9be9541:

    # w happy "Ohh~ I want to eat pancakes~!"
    w happy "Ohh~ Eu quero panquecas~!"

# game/script.rpy:2808
translate ptbr ch6_602cfadd:

    # p happy "Great! I'll make some!!"
    p happy "Ótimo! Eu vou lá fazer!!"

# game/script.rpy:2810
translate ptbr ch6_7c1da6cd:

    # n "Pastille practically bolts from the room to get started on cooking."
    n "Pastille praticamente saí correndo do quarto para começar a cozinhar."

# game/script.rpy:2811
translate ptbr ch6_c9e53739:

    # w sleepy3 "Hmhm... oh, Pastille...."
    w sleepy3 "Hmhm... Ai, Pastillle...."

# game/script.rpy:2814
translate ptbr ch6_54d8e5dc:

    # "Looking around the room, he did much more than organize my closet..."
    "Olhando ao meu redor, eu percebo que ele fez bem mais do que arrumar o armário..."

# game/script.rpy:2815
translate ptbr ch6_d495c413:

    # "The books I'd been reading were all tucked back into their proper places on the bookshelf."
    "Os livros que eu estava lendo foram colocados em seus devidos lugares na prateleira."

# game/script.rpy:2816
translate ptbr ch6_ff59d209:

    # "The clothes that had been strewn across the floor, or otherwise left hanging in ridiculous places, now sat in the hamper waiting to be washed."
    "As roupas que estavam jogadas pelo chão ou que foram deixadas penduradas por aí, agora estão no cesto esperando para serem lavadas."

# game/script.rpy:2817
translate ptbr ch6_0c0a8ef8:

    # nvl clear
    # "Even the pile of unfolded laundry I had previously abandoned was now absent--properly folded and placed into the appropriate drawers by Pastille."
    nvl clear
    "Até a pilha de roupas limpas que eu tinha abandonado havia sumido--todas dobradas e guardadas em suas devidas gavetas pelo Pastille."

# game/script.rpy:2819
translate ptbr ch6_c62ed776:

    # "In a word, I'm in awe."
    "Simplesmente, eu estou em choque."

# game/script.rpy:2820
translate ptbr ch6_d9bb5a76:

    # "How long had he been at this? And all while I slept?"
    "Quanto tempo ele levou para fazer isso? E ele fez tudo enquanto eu dormia?"

# game/script.rpy:2821
translate ptbr ch6_d234491a:

    # "It shouldn't even be possible."
    "Isso não parece possível."

# game/script.rpy:2822
translate ptbr ch6_58188605:

    # nvl clear
    # w bed neutral "...."
    nvl clear
    w bed neutral "...."

# game/script.rpy:2825
