translate ptbr ch4_c829cbee:

    # w innocent "Your specialty, dear!"
    w innocent "Qual a sua especialidade, querido!"

# game/script.rpy:2143
translate ptbr ch4_9847abef:

    # w smile "If you were that good at reconstruction, I imagine it must fall somewhere in that category...?"
    w smile "Se você é bom em reconstituição, eu imagino que seja alguma coisa nessa categoria...?"

# game/script.rpy:2144
translate ptbr ch4_b09961bf:

    # p ehe "Um, not really... I'm actually an astral witch."
    p ehe "Uh, na verdade não... Eu sou um bruxo astral."

# game/script.rpy:2145
translate ptbr ch4_443121bc:

    # w my "My, how rare! And what exactly does that entail for you?"
    w my "Meu bem, que raro! E o que exatamente isso significa no seu caso?"

# game/script.rpy:2146
translate ptbr ch4_44c2df3e:

    # p shy "Ahh, well, I mostly use it for fire spells, like anyone else..."
    p shy "Ahh, bem, eu normalmente acabo usando para fazer feitiços de fogo, como a maioria das pessoas..."

# game/script.rpy:2147
translate ptbr ch4_bcabe313:

    # w oh "Forgive me, I'm not well-versed in magic theory... but doesn't astral magic have something to do with creation?"
    w oh "Me perdoe, eu não sou especialista em teoria da magia... mas magia astral não é voltada para criação?"

# game/script.rpy:2148
translate ptbr ch4_ac2d501e:

    # p ehe2 "It does... but that stuff is pretty advanced. I haven't been able to find any books explaining how to use it."
    p ehe2 "Sim... mas esse tipo de coisa é bem avançada. Eu não consegui encontrar muitos livros explicando como funciona."

# game/script.rpy:2149
translate ptbr ch4_02f8bfe1:

    # p embarrassed "...Which is probably for the best, actually. No one should be allowed to go around creating souls spontaneously...!"
    p embarrassed "...Eu acho que, provavelmente, é melhor assim. Ninguém deveria poder sair por aí criando almas do nada...!"

# game/script.rpy:2150
translate ptbr ch4_29508975:

    # w neutral "Hm..."
    w neutral "Hm..."

# game/script.rpy:2152
translate ptbr ch4_1b5322bf:

    # "Pastille rubs the back of his neck, looking off into the distance."
    "Pastille esfrega sua nuca, olhando em direção ao horizonte."

# game/script.rpy:2153
translate ptbr ch4_309805fa:

    # "He seems so troubled by the subject..."
    "Ele não parece gostar de falar sobre isso..."

# game/script.rpy:2154
translate ptbr ch4_9604342e:

    # "I suppose because he had been living without magic, it may feel strange to openly discuss it?"
    "Eu suponho que depois de ter vivido tanto tempo sem magia, pode ser estranho falar tão abertamente sobre o assunto?"

# game/script.rpy:2155
translate ptbr ch4_48123bf8:

    # nvl clear
    # "An astral witch, though... I wouldn't have guessed."
    nvl clear
    "Então você é um bruxo astral... Eu nunca teria imaginado."

# game/script.rpy:2157
translate ptbr ch4_c8d56a68:

    # "Putting two and two together, ONE thing makes perfect sense now..."
    "Levando tudo em consideração, UMA coisa faz sentido agora..."

# game/script.rpy:2158
translate ptbr ch4_551942a5:

    # nvl clear
    # w ah "So the famous Atelier Sweets golem was YOUR creation?"
    nvl clear
    w ah "Então o famoso golem da Atelier Sweets é uma criação SUA?"

# game/script.rpy:2161
translate ptbr ch4_2c8fd31f:

    # p ehe2 "Haha, is she really that famous? I'd expect our sales to be a little better if that were the case..."
    p ehe2 "Haha, ela é tão famosa assim? Se fosse o caso, eu acho que as nossas vendas seriam um pouco melhores..."

# game/script.rpy:2162
translate ptbr ch4_fd97e90a:

    # p flustered2 "But... yeah. Just don't go around telling everyone--I didn't know what I was doing when I made her."
    p flustered2 "Mas... sim. Mas não conte pra ninguém--Eu não tinha ideia do que eu estava fazendo quando criei ela."

# game/script.rpy:2163
translate ptbr ch4_e7fb158c:

    # w my "What an amazing feat... and yet you sound almost ashamed of it!"
    w my "É um feito impressionante... e mesmo assim você quase parece ter vergonha disso!"

# game/script.rpy:2164
translate ptbr ch4_0bf92251:

    # p ohno "I-it's not like I regret it or anything... Gumdrop is really great! I just..."
    p ohno "E-Eu não me arrependo nem nada assim... A Gumdrop é incrível! Eu só..."

# game/script.rpy:2165
translate ptbr ch4_2ed99bc8:

    # p nervous "I feel bad that she's stuck in a body with so many limitations. Like, she didn't ask to be made that way..."
    p nervous "Eu me sinto mal por ter dado a ela um corpo com tantas limitações. Tipo, ela não pediu para ser feita daquele jeito..."

# game/script.rpy:2166
translate ptbr ch4_8694e630:

    # p flustered2 "I didn't know you could even make golems that felt real emotions, so of course I never considered any of that."
    p flustered2 "Eu nem sabia que era possível criar um golem com emoções reais, então é claro que eu nem tinha pensando nesses detalhes."

# game/script.rpy:2167
translate ptbr ch4_cde66f06:

    # p shy "...Sorry to go off about it. I-I've just been feeling guilty lately--kind of a heavy topic."
    p shy "...Desculpe por descarregar tudo isso em você. E-eu tenho me sentindo culpado ultimamente--é um assunto delicado."

# game/script.rpy:2168
translate ptbr ch4_9931704c:

    # w ah "No, no... thank you for telling me."
    w ah "Não, não... obrigado por me contar."

# game/script.rpy:2169
translate ptbr ch4_b7df5332:

    # w calm "It's as if I've discovered a whole new side of you today. I'm grateful to know it."
    w calm "É como se eu tivesse descoberto um lado seu completamente novo. Eu fico feliz com isso."

# game/script.rpy:2170
