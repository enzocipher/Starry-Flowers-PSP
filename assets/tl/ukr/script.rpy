    n "Барвінок виходить, нарешті одягнувшись...."

# game/script.rpy:1731
translate ukr ch4_1c98e1e7:

    # w date happy "Ready to go~ 💙"
    w date happy "Я готовий~ 💙"

# game/script.rpy:1732
translate ukr ch4_9bd1b54c:

    # n "Pastille looks him up and down cautiously."
    n "Пастиль с підозрою його оглядає."

# game/script.rpy:1735
translate ukr ch4_ead54352:

    # p uhoh "Y-you're wearing some, right...?"
    p uhoh "Т-ти ж надягнув якусь спідню білизну, так?.."

# game/script.rpy:1736
translate ukr ch4_03f36c74:

    # w teehee "Hm~ we'll just have to find out later tonight, won't we?"
    w teehee "Хм~ гадаю, ти ввечері і сам побачиш, чи не так?"

# game/script.rpy:1737
translate ukr ch4_ba35183f:

    # p scream "P-PERI...!" with vpunch
    p scream "Б-БАРВІ!.." with vpunch

# game/script.rpy:1752
translate ukr ch4_f71e2dad:

    # "What a lovely day for a date 💙"
    "Який прекрасний день для побачення 💙"

# game/script.rpy:1753
translate ukr ch4_1b84dc6c:

    # "We walk side by side, Pastille with his hands stuffed into oversized pockets. So cute..."
    "Ми йдемо поруч один з одним, Пастиль ховає руки у свої неймовірно широкі кишені. Як мило..."

# game/script.rpy:1754
translate ukr ch4_2b607e30:

    # "He's in the perfect position to be clinged to~ But, I must refrain."
    "Така позиція ідеальна для того, аби взяти його під лікоть~ Але я маю стриматись."

# game/script.rpy:1755
translate ukr ch4_6a692108:

    # "I doubt he'd be comfortable with me hanging all over him in broad daylight. Besides, there's no need to jump into such overt affections just yet."
    "Не думаю, що йому сподобається, якщо я повисну на ньому серед білого дня. До того ж, не варто поспішати з таким відвертим проявом почуттів."

# game/script.rpy:1756
translate ukr ch4_76b2fe88_2:

    # nvl clear
    nvl clear

# game/script.rpy:1763
translate ukr ch4_b6217edd:

    # "When we reach the café, Pastille orders us some doughnuts to share."
    "В кафе Пастиль замовляє для нас кілька пончиків з глазур'ю."

# game/script.rpy:1764
translate ukr ch4_f8a53225:

    # "I wonder what else he has planned...?"
    "Цікаво, що ще він задумав?.."

# game/script.rpy:1765
translate ukr ch4_d90128ed:

    # "He only mentioned hanging out--who knows what that could entail~?"
    "Він сказав лише про те, що ми разом проведемо час і побалакаємо - хто знає, до чого це може призвести?~"

# game/script.rpy:1766
translate ukr ch4_98bb6b9f:

    # "Munching away at our breakfast, I study his face for clues..."
    "Я жую пончик і водночас придивляюсь до обличчя Пастила, намагаючись знайти якісь підказки..."

# game/script.rpy:1767
translate ukr ch4_76b2fe88_3:

    # nvl clear
    nvl clear

# game/script.rpy:1769
translate ukr ch4_4e7d5c55:

    # "He really is so cute."
    "Він дійсно неймовірно милий."

# game/script.rpy:1770
translate ukr ch4_adc44e53:

    # "I remember the choker. He wore it on our first date as well 💙"
    "І я пам'ятаю цей чокер - він його надягнув на наше перше побачення 💙"

# game/script.rpy:1772
translate ukr ch4_1e8c7e1f:

    # "And that's the same barrette he left behind after one of our sleepovers~ Such pointed choice in accessories..."
    "А цю шпильку для волосся він залишив у мене після однієї з ночівель~ Який цікавий вибір аксесуарів..."

# game/script.rpy:1774
translate ukr ch4_1fd546cf:

    # "Ah, and now all my staring has embarrassed him. You're too easily flustered, my sweet 💙"
    "Ах, і тепер він засоромився від моїх поглядів. Мій солоденький, ти занадто легко ніяковієш 💙"

# game/script.rpy:1775
translate ukr ch4_0f78683c:

    # nvl clear
    # w date "Forgive me for staring; I was trying to intuit what you might have planned for us after this."
    nvl clear
    w date "Вибач, що настільки пильно тебе роздивлявся - я намагався вгадати, які в тебе подальші плани."

# game/script.rpy:1777
translate ukr ch4_bbf68c72:

    # p ehe "Oh, um, nothing in particular... wandering around town is enough for me."
    p ehe "Ох, ем, насправді нічого такого... Було б непогано, якщо б ми просто прогулялися містом."

# game/script.rpy:1778
translate ukr ch4_0455f80a:

    # w calm "I see 💙 Loitering does facilitate conversation quite well."
    w calm "Розумію 💙 Прогулянки доволі добре сприяють розмовам."

# game/script.rpy:1779
translate ukr ch4_39f199d8:

    # p shy "As long as we're out and about, we won't end up... um...."
    p shy "Доки ми на вулиці і все таке, ми не... ем...."

# game/script.rpy:1780
translate ukr ch4_db519a24:

    # w my "(Oh, is he going to say it~?)"
    w my "(Ох, невже він збирається сказати це вголос?~)"

# game/script.rpy:1781
translate ukr ch4_ae3f626a:

    # p omg "Y-you know...."
    p omg "Т-ти розумієш, про що я..."

# game/script.rpy:1782
translate ukr ch4_143046d9:

    # w innocent "(Hmhm, of course not 💙)"
    w innocent "(Хмхм, звісно ж ні 💙)"

# game/script.rpy:1783
translate ukr ch4_98697be5:

    # p wha "I actually like when we get to talk...!"
    p wha "Мені просто подобається, коли з'являється можливість з тобою поговорити!.."

# game/script.rpy:1784
translate ukr ch4_09628e53:

    # p uhoh "I-I mean, not that we DON'T when I sleep over, it's just... a different kind...."
    p uhoh "Я-я маю на увазі, не те щоб ми цього не робили, коли я залишаюсь на ніч, це просто... дещо інші розмови...."

# game/script.rpy:1785
translate ukr ch4_c6264bf7:

    # w calm "True... 💙"
    w calm "Дійсно... 💙"

# game/script.rpy:1786
translate ukr ch4_b63fac77:

    # p flustered2 "Sorry... now I feel like I'm talking too much."
    p flustered2 "Вибач... здається, я забагато говорю."

# game/script.rpy:1787
translate ukr ch4_b1f80a86:

    # w love "Not at all, my sweet! I have to say, I rather enjoy our chats as well~"
    w love "Зовсім ні, мій солоденький! Маю сказати, що я теж насолоджуюсь нашими розмовами~"

# game/script.rpy:1788
translate ukr ch4_062a8003:

    # w teehee "Even if you can't resist cutting them short once we're behind closed doors 💙"
    w teehee "Навіть якщо ти не можеш втриматись від того, аби обірвати їх, як тільки ми опиняємось за зачиненими дверима 💙"

# game/script.rpy:1789
translate ukr ch4_8ad9efbe:

    # p omgstop "I-I'm really sorry...!" with vpunch
    p omgstop "В-вибач!.." with vpunch

# game/script.rpy:1791
translate ukr ch4_7f6c0c2e:

    # "He's simply too much fun..."
    "З ним так весело..."

# game/script.rpy:1792
translate ukr ch4_a556fc99:

    # "Ah, but this is no time for my usual teasing~! I can't forget what brought us here..."
    "Ах, але зараз не час дражнитися!~ Я не маю забувати про те, чому ми тут..."

# game/script.rpy:1794
translate ukr ch4_23b094b1:

    # "This is the perfect opportunity to become more deeply acquainted."
    "Це чудова нагода дізнатись один одного краще."

# game/script.rpy:1795
translate ukr ch4_d08bb998:

    # "I'll learn all about Pastille, so that I don't end up crossing the line again..."
    "Я дізнаюсь все про Пастиля, і більше ніколи не перейду його межі..."

# game/script.rpy:1796
translate ukr ch4_76b2fe88_4:

    # nvl clear
    nvl clear

# game/script.rpy:1799
translate ukr ch4_631bf0aa:

    # w oh "In the interest of defining boundaries... are there any subjects I should avoid bringing up with you?"
    w oh "До речі, щодо твоїх меж... чи є якісь теми, які мені не варто згадувати при розмовах с тобою?"

# game/script.rpy:1800
translate ukr ch4_0d8de333:

    # w guilty "On that note, has there ever been anything I've said that's caused you discomfort in the slightest? Please don't hold back."
    w guilty "І чи не викликали в тебе дискомфорт якісь мої слова? Будь ласка, не приховуй нічого від мене."

# game/script.rpy:1801
translate ukr ch4_84306ef7:

    # p think "Hmm... nothing really comes to mind...."
    p think "Хмм... нічого на думку не спадає...."

# game/script.rpy:1802
translate ukr ch4_a73c1ed9:

    # p shy "I mean, I've always felt... pretty comfortable around you... so we could probably talk about anything and it'd be okay."
    p shy "Я маю на увазі... мені завжди було доволі затишно поруч з тобою... так що, напевно, ми можемо говорити про будь-що."

# game/script.rpy:1803
translate ukr ch4_15ab8bed:

    # w love "Anything, really? Surely you must have SOME sensitive topics you'd like to avoid."
    w love "Дійсно про будь-що? Мають же існувати якісь делікатні або болючі теми, яких ти хочеш уникнути."

# game/script.rpy:1804
translate ukr ch4_7af929e3:

    # p oh "I guess so... but I wouldn't really be worried talking about them with you."
    p oh "Гадаю, що так... але я не боюсь говорити на ці теми з тобою."

# game/script.rpy:1805
translate ukr ch4_d4971bd3:

    # p ehe "Actually, you might be the most attentive person I've ever met. Maybe that's why I'm not worried at all."
    p ehe "Насправді, ти найуважніша людина зі всіх, яких я коли-небудь зустрічав. Напевно, саме через це я і не хвилююся."

# game/script.rpy:1806
translate ukr ch4_5e290654:

    # w innocent "Hmhm, I'm glad to hear that 💙"
    w innocent "Хмхм, радий це чути 💙"

# game/script.rpy:1807
translate ukr ch4_3e0eb085:

    # w smile "But you've certainly piqued my curiosity... what kinds of sensitive topics, if you don't mind me asking?"
    w smile "Але ти, безумовно, розпалив мій інтерес... які теми для тебе делікатні так або інакше? Якщо ти не проти відповісти."

# game/script.rpy:1808
translate ukr ch4_55849c5e:

    # p think "Like... for example. You've never made me feel weird about gender stuff."
    p think "Хм... ну, наприклад. Ти ніколи не змушував мене почувати себе некомфортно через пов'язані з ґендером речі."

# game/script.rpy:1809
translate ukr ch4_7baf213c:

    # w oh "I'd certainly hope not! That one's a bit sensitive for me as well."
    w oh "Я дійсно сподіваюсь, що не змушував! Це і для мене самого трохи делікатна тема."

# game/script.rpy:1810
translate ukr ch4_6486f9c9:

    # p happy "See? That's why it feels okay to talk about with you."
    p happy "Бачиш? Ось чому я спокійно можу говорити про це з тобою."

# game/script.rpy:1811
translate ukr ch4_6927813d:

    # p shy "I'm, well... not very masculine. So I get mistaken for a girl every now and then..."
    p shy "Я... не дуже маскулінно виглядаю. Тому мене часто приймають за дівчину..."

# game/script.rpy:1812
translate ukr ch4_0f2dfa36:

    # p oh "Not that it's something I get mad about or anything. I've always dealt with it, ever since I was little."
    p oh "Не те щоб я злюсь на людей через це чи щось таке. Це постійно відбувається, і я з дитинства з такими випадками стикався."

# game/script.rpy:1814
translate ukr ch4_be78c7ec:

    # p flustered2 "Still, I think it bothers me in particular, since... well, you know, I'm intersex."
    p flustered2 "Але, гадаю, мене це все-таки турбує, тому що... ну, я інтерсекс."

# game/script.rpy:1815
translate ukr ch4_6f967fdb:

    # w decline "Mm, right."
    w decline "Мм, ага."

# game/script.rpy:1816
translate ukr ch4_136e9d0e:

    # p ohno2 "I want to be recognized as a boy. But I like wearing feminine clothes, too..."
    p ohno2 "Я хочу, аби мене сприймали як хлопця. Але в той самий час мені подобається носити також і речі, що зазвичай носять жінки..."

# game/script.rpy:1817
translate ukr ch4_b2e10257:

    # w happy "Yes, that's it exactly! I feel the very same!"
    w happy "Так, я розумію! Я так само себе почуваю!"

# game/script.rpy:1818
translate ukr ch4_e80b7732:

    # p ehe "Right? Like, I don't wanna be limited to presenting only one way... even if I'm fine with boyish clothes, too."
    p ehe "Розумієш? Я не хочу обмежувати і показувати всім лише одну сторону своєї особистості... навіть якщо мені подобається і більш притаманний хлопцям одяг."

# game/script.rpy:1819
translate ukr ch4_8ba96462:

    # w calm "For me, it's simply about looking beautiful. I dress to fit my ideal."
    w calm "Щодо мене... я просто хочу гарно виглядати і одягаюсь так, аби відповідати своєму ідеалу."

# game/script.rpy:1820
translate ukr ch4_ad75be97:

    # w oh "It's not a matter of gender, but aesthetic preference. These are the clothes I feel best in."
    w oh "Це немає ніякого відношення до ґендеру - лише до естетичних уподобань. Саме в цьому одязі я почуваю себе найкраще."

# game/script.rpy:1821
translate ukr ch4_fc9182ac:

    # p embarrassed "You, um... look really good in them, too...."
    p embarrassed "Ти, ем... і виглядаєш в ньому дуже гарно..."

# game/script.rpy:1822
translate ukr ch4_f6672aa7:

    # w innocent "Why, thank you! And I must say, YOUR sense of style never fails to impress 💙"
    w innocent "Велике дякую! Маю сказати, що ТВОЄ почуття стилю завжди мене вражає 💙"

# game/script.rpy:1823
translate ukr ch4_e09db7a3:

    # p omg "Ah, haha... I'm glad you like it...."
    p omg "Ах, хаха... Я радий це почути...."

# game/script.rpy:1825
translate ukr ch4_403c728d:

    # n "Pastille sips his drink while Periwinkle continues."
    n "Пастил відпиває трохи зі своєї чашки, і тим часом Барвінок продовжує свою розповідь."

# game/script.rpy:1827
translate ukr ch4_6a1d304f:

    # w calm "When I was young... I didn't have the confidence to dress so beautifully. Hmhm, can you even imagine it?"
    w calm "Коли я був молодше... в мене не вистачало впевненості у собі, аби одягатись настільки прекрасно. Хмхм, чи можеш ти це уявити?"

# game/script.rpy:1828
translate ukr ch4_40871af5:

    # p ehe "You, without confidence? No, I'm not sure that's possible."
    p ehe "Ти - і без впевненості у собі? Ні, я навіть не знаю, чи таке взагалі можливо."

# game/script.rpy:1829
translate ukr ch4_3ddf3ee7:

    # w happy "Right~? I suppose I was a different person back then."
    w happy "Дійсно?~ Гадаю, тоді я був зовсім іншим."

# game/script.rpy:1830
translate ukr ch4_58aae749:

    # w neutral "Where I grew up... things were much more black and white. You were either a boy or a girl, and you HAD to dress accordingly."
    w neutral "Там, де я ріс... все було більш чорно-білим. Ти був або хлопцем, або дівчиною, і МАВ одягатись відповідно."

# game/script.rpy:1831
translate ukr ch4_51a7c612:

    # p ohno2 "Ah, that sounds harsh..."
    p ohno2 "Ох, це звучить суворо..."

# game/script.rpy:1832
translate ukr ch4_c463434f:

    # w my "It very much was! I was completely MISERABLE!"
    w my "Це і було дуже суворо! Я був дуже НЕЩАСНИМ!"

# game/script.rpy:1833
translate ukr ch4_424e83ef:

    # w oh "Perhaps it's because I come from that sort of environment... that I want it to be known, I look this glamorous as a BOY."
    w oh "Можливо, через те, що я виріс у такому оточенні... тепер мені хочеться, аби всі знали, що я - ХЛОПЕЦЬ, і це анітрохи не заважає мені виглядати настільки привабливо."

# game/script.rpy:1834
translate ukr ch4_9d701ab1:

    # w pout "Not to say that this is easy for ANY gender--I only wish for my efforts to be acknowledged!"
    w pout "Звісно, не можна сказати, що це легко для людини будь-якого ґендеру - але я хочу, аби мої зусилля були визнані!"

# game/script.rpy:1835
translate ukr ch4_180fe63a:

    # p shy "Haha, I think that's just your competitive spirit again."
    p shy "Хаха, гадаю, в тобі просто знову прокинувся дух суперництва."

# game/script.rpy:1836
translate ukr ch4_564ec052:

    # w happy "See, you truly understand me~!"
    w happy "Бачиш, ти повністю мене розумієш!~"

# game/script.rpy:1838
translate ukr ch4_50f5fa7a:

    # n "They laugh together. Periwinkle relaxes into his chair and finishes his drink with a big smile on his face..."
    n "Вони сміються разом. Барвінок розслаблено відкидається на спинку стільця і допиває свій напій, широко посміхаючись..."

# game/script.rpy:1842
translate ukr ch4_ab260034:

    # "Pastille and I depart from the café and make our way down the street."
    "Пастиль та я виходимо з кафе і йдемо по вулиці."

# game/script.rpy:1843
translate ukr ch4_3d888206:

    # "With no destination in mind, the details of our surroundings--things I've never really paid any mind to, make themselves known."
    "У нашої прогулянки немає ніякої мети; через це деталі оточення, на які я раніше не звертав ніякої уваги, починають виходити на перший план."

# game/script.rpy:1844
translate ukr ch4_00e39214:

    # "Aromas from the bakery, the flower shop, the patisserie; each distinct and enticing. I'm left with a peaceful feeling as we pass each of them by."
    "Аромати з пекарні, квіткової крамниці, кондитерської; кожен з них по-свому особливий і по-свому спокушає зайти. Коли ми проходимо повз, то я відчуваю умиротворення."

# game/script.rpy:1845
translate ukr ch4_01ac64e9:

    # nvl clear
    # "Now there's a fun idea... a scent that transforms over time, giving you a sense of place--"
    nvl clear
    "Насправді, це непогана ідея... аромат, що перетворюється з часом на інший і створює атмосферу певного місця-"

# game/script.rpy:1847
translate ukr ch4_5e60bbe1:

    # "Ah, but I shouldn't be thinking about work while I'm on a date~!"
    "Ах, але ж я на побаченні, зараз не час думати про роботу!~"

# game/script.rpy:1848
translate ukr ch4_6b51ed02:

    # "I turn my attention back to Pastille."
    "Я звертаю свою увагу назад до Пастиля."

# game/script.rpy:1849
translate ukr ch4_76b2fe88_5:

    # nvl clear
    nvl clear

# game/script.rpy:1852
translate ukr ch4_d421c7da:

    # w date smile "With gender thoroughly discussed, the next personal question would have to be..."
    w date smile "Так, ми досить детально обговорили ґендер, і наступним особистим питанням буде..."

# game/script.rpy:1853
translate ukr ch4_83f1994a:

    # w happy "Ooh, sexuality! Which type of partner gets you THE MOST hot and bothered~?"
    w happy "О, точно, сексуальна орієнтація! Які партнери найбільше тебе заводять?~"

# game/script.rpy:1854
translate ukr ch4_4c24ed9b:

    # p omgstop "SHH...! You can't just shout those words in the middle of a crowd...!!" with vpunch
    p omgstop "ШШШ!.. Не кричи про це на всю вулицю!!..." with vpunch

# game/script.rpy:1855
translate ukr ch4_747240e4:

    # w calm "Ohh, who's even listening? I certainly wasn't shouting."
    w calm "О, да хто взагалі до нас прислухається? Я навіть не кричав."

# game/script.rpy:1856
translate ukr ch4_7e39cd48:

    # p flustered "Please don't talk about that stuff too loudly... people will start giving us weird looks...!"
    p flustered "Будь ласка, не говори про це так голосно... люди почнуть на нас дивитися!.."

# game/script.rpy:1857
translate ukr ch4_4e9876f6:

    # w love "Shall I whisper it into your ear, then~?"
    w love "Може, тоді я маю прошепотіти тобі на вушко?~"

# game/script.rpy:1858
translate ukr ch4_67ef6f9e:

    # p scream "TH-THAT'S EVEN WORSE...!" with vpunch
    p scream "Ц-ЦЕ ЩЕ ГІРШЕ!.." with vpunch

# game/script.rpy:1859
translate ukr ch4_49c373ff:

    # w pout "Hmph, NOW who's shouting."
    w pout "Хмпф, і хто ж ЗАРАЗ кричить на всю вулицю."

# game/script.rpy:1862
translate ukr ch4_33263a1e:

    # n "Pastille glances around, but despite his outburst, Periwinkle was right--no one had turned their way."
    n "Пастиль налякано оглядається навколо, але Барвінок був правий - ніхто навіть не подивився на них."

# game/script.rpy:1864
translate ukr ch4_9af32e30:

    # p ehe2 "Sorry... I-I guess it's okay...."
    p ehe2 "В-вибач... Я гадаю, що все в порядку..."

# game/script.rpy:1865
translate ukr ch4_85f11e29:

    # w innocent "Feel free to stop me if I'm being too much, yes?"
    w innocent "Якщо я буду занадто сильно тебе дражнити, то зупини мене, гаразд?"

# game/script.rpy:1866
translate ukr ch4_e44221b2:

    # p uhoh "There's nothing wrong with being a LITTLE too much...."
    p uhoh "Нічого страшного, якщо це буде ТРОХИ занадто..."

# game/script.rpy:1867
translate ukr ch4_0f1fc0c3:

    # w calm "Hmhm, I imagined you'd say so. Returning to the topic at hand..."
    w calm "Хмхм, я так і думав, що ти про це скажеш. Але давай повернемось до нашої розмови..."

# game/script.rpy:1868
translate ukr ch4_cd6834d6:

    # w happy "I've been with all sorts of partners. I'd say I can appreciate just about anyone 💙"
    w happy "В мене було багато різних партнерів. Можна сказати, що мені подобаються абсолютно всі 💙"

# game/script.rpy:1869
translate ukr ch4_3827f8fd:

    # w shy "But I must admit, I prefer witch boys above all others..."
    w shy "Але маю зізнатись, що найбільш мені подобаються хлопці-відьми..."

# game/script.rpy:1870
translate ukr ch4_4751efb0:

    # p wow "I-I would also... say... witch boys...."
    p wow "М-мені теж... подобаються... хлопці-відьми...."

# game/script.rpy:1871
translate ukr ch4_a4186c37:

    # w drool "OH~~~? Care to elaborate, my sweet?"
    w drool "ОХ?~~~ Не бажаєш розповісти у подробицях, солоденький?"

# game/script.rpy:1872
translate ukr ch4_859906e5:

    # p omg "Nope...! That's... all I have to say on the matter...." with vpunch
    p omg "Ні!.. Це... все, що я можу сказати...." with vpunch

# game/script.rpy:1873
translate ukr ch4_2c430f31:

    # w teehee "Hmhm, I'll have to tease it out of you later, then~ 💙"
    w teehee "Хмхм, гадаю, що тоді я виманю у тебе подробиці пізніше~ 💙"

# game/script.rpy:1874
translate ukr ch4_3d8c6825:

    # p dying "(AAAAHH...!!!)"
    p dying "(ААААХХ!!!...)"

# game/script.rpy:1877
translate ukr ch4_462c84e0:

    # "We follow along the twisting streets of the shopping district, looking in each of the windows as we pass them by."
    "Ми йдемо звивистими вуличками торгівельного району і розглядаємо кожну вітрину."

# game/script.rpy:1878
translate ukr ch4_f823e801:

    # "This is my favorite part of town--filled with all the high-end boutiques you could dream of 💙"
    "Це моя найулюбленіша частина міста - тут так багато бутиків високої моди, де можна знайти будь-що, про що ти мрієш 💙"

# game/script.rpy:1879
translate ukr ch4_9c01e828:

    # "The mannequins from one of them catch my eye, and I lightly grab Pastille's sleeve to draw his attention."
    "Один з манекенів привертає мою увагу, і я легенько смикаю Пастила за рукав, аби він теж подивився."

# game/script.rpy:1880
translate ukr ch4_76b2fe88_6:

    # nvl clear
    nvl clear

# game/script.rpy:1884
translate ukr ch4_232f4575:

    # w date "You'd look so good in that, don't you think?"
    w date "Я гадаю, тобі б це дуже підійшло, як ти думаєш?"

# game/script.rpy:1885
translate ukr ch4_4d24cc6c:

    # p shy "Really? I don't know if something so extravagant would really suit me..."
    p shy "Дійсно? Я не знаю, як буду виглядати у чомусь настільки екстравагантному..."

# game/script.rpy:1886
translate ukr ch4_16ac6632:

    # w happy "Nonsense, you could pull it off~! The accents match your eyes 💙"
    w happy "Ну і дурниці, ти ж можеш спробувати!~ Кольори оздоблення чудово пасують твоїм очам 💙"

# game/script.rpy:1887
translate ukr ch4_2006a486:

    # p ehe "Eheh, I guess they do..."
    p ehe "Ехех, гадаю, ти правий..."

# game/script.rpy:1888
translate ukr ch4_b01a9be6:

    # w oh "Hmm, but you'd look great in that one, too... oh, and THAT one...!"
    w oh "Хмм, але тобі б дуже підішло і це... ох, і ЦЕ!.."

# game/script.rpy:1889
translate ukr ch4_5204e835:

    # p embarrassed "Y-you're pointing to everything...."
    p embarrassed "Т-ти вказуєш буквально на кожний манекен..."

# game/script.rpy:1890
translate ukr ch4_9ad57405:

    # w shy "Yes, well, the alternative would be to say that I'd like to see you in nothing at all 💙"
    w shy "Так, бо інакше я б сказав, що надаю перевагу тобі взагалі без одягу 💙"

# game/script.rpy:1891
translate ukr ch4_a9e27c65:

    # p omg "A-AH...." with vpunch
    p omg "А-АХ...." with vpunch

# game/script.rpy:1893
translate ukr ch4_21b7c10a:

    # w smile "Do you go clothes shopping often? You have such a variety of cute looks."
    w smile "Ти, напевно, часто купуєш одяг? В тебе багато милого вбрання."

# game/script.rpy:1894
translate ukr ch4_a98d72c6:

    # p shy "Oh, um, every now and then... but I can't afford the kinds of stuff they sell here."
    p shy "Ох, ем, час від часу... але я не можу собі дозволити того, що продається тут."

# game/script.rpy:1895
translate ukr ch4_21f87c1a:

    # w oh "It IS rather pricy... but the brands are worth it."
    w oh "Так, цей одяг доволі дорогий... але бренди того вартують."

# game/script.rpy:1896
translate ukr ch4_e26fc98b:

    # p ehe "I really don't know anything about fashion. I just end up picking whatever stands out to me...."
    p ehe "Я, насправді, не дуже розбираюсь у стилі та моді. Я просто вибираю те, що найбільше мені подобається.... "

# game/script.rpy:1897
translate ukr ch4_06e4ae9b:

    # w smile "As it should be! You're better off not becoming obsessed with these things--it certainly isn't easy on the wallet."
    w smile "Як і треба робити! Модою не треба занадто сильно захоплюватись, інакше це буде бити по твому гаманцю."

# game/script.rpy:1898
translate ukr ch4_4dc60c1a:

    # p smile "I'll leave the brand-name stuff to you, then. Just seeing them is enough for me."
    p smile "Тоді я залишу всякі брендові штучки тобі. Мені достатньо насолоджуватись їхнім зовнішнім виглядом."

# game/script.rpy:1899
translate ukr ch4_1715bc7d:

    # w teehee "Oh, just seeing them? Not stripping them off of me? 💙"
    w teehee "Ох, просто дивитись і все? А як же ті моменти, коли ти стягаєш з мене цей одяг? 💙"

# game/script.rpy:1900
translate ukr ch4_7c54d0a0:

    # p dying "AAAAAHH...!!" with vpunch
    p dying "АААААХХ!!..." with vpunch

# game/script.rpy:1903
translate ukr ch4_6d3eceb8:

    # "After our little fashion circuit, we end up near the café where we'd started."
    "Після нашої невеликої прогулянки по кварталу моди ми опинились біля кафе, де снідали."

# game/script.rpy:1904
translate ukr ch4_ffdc441f:

    # "I've certainly worked him up enough to take home right away, but..."
    "Пройшло вже достатньо часу і я вже настільки підігрів Пастиля, що міг би повести його просто додому, але..."

# game/script.rpy:1905
translate ukr ch4_2c40055e:

    # "That would mean cutting our date short! And what a shame that would be 💙"
    "Але це б значило, що наше побачення дуже швидко закінчиться! Це було б дуже прикро 💙"

# game/script.rpy:1906
translate ukr ch4_c2d04cee:

    # "I skip ahead of Pastille and twirl around to face him."
    "Я трохи прискорюю крок, аби випередити Пастиля, і розвертаюсь, аби повернутись до нього обличчям."

# game/script.rpy:1907
translate ukr ch4_76b2fe88_7:

    # nvl clear
    nvl clear

# game/script.rpy:1910
translate ukr ch4_5061977c:

    # w date innocent "There's somewhere I'd like to take you!"
    w date innocent "Знаєш, є місце, куди б я хотів тебе повести!"

# game/script.rpy:1911
translate ukr ch4_8f04b75d:

    # p um "Huh? Sure..."
    p um "А? Звісно..."

# game/script.rpy:1912
translate ukr ch4_4a86880b:

    # w smile "I realize I've seen YOUR workplace, but you haven't seen mine. It's a little apothecary I sell my magic to for distribution."
    w smile "Я зрозумів, що вже бачив, де ти працюєш, але ти ж моє місце роботи так і не відвідував. Я продаю свою магію для подальшого поширення у невеличку аптеку."

# game/script.rpy:1913
translate ukr ch4_4e3c1a91:

    # p oh "An apothecary? I thought you sold perfumes...?"
    p oh "Аптеку? Я гадав, що ти продаєш парфуми?.."

# game/script.rpy:1914
translate ukr ch4_7845214f:

    # w calm "Technically, that's all they are. I don't claim they deliver any lasting health benefits..."
    w calm "Дійсно, так і є. Я не стверджую, що вони мають якусь довготривалу користь для здоров'я..."

# game/script.rpy:1915
translate ukr ch4_3283e0de:

    # w smile "They're more for healing the mind. Anxiety, stress, and any other unpleasant feelings can be lifted away with just the right aromas~"
    w smile "Вони слугують для лікування душі. Тривогу, стрес та інші неприємні почуття легко відлякнути за допомогою правильного аромату~"

# game/script.rpy:1916
translate ukr ch4_99916f10:

    # w oh "It's more effective for some than others. But for those sensitive to such things, it can make quite the difference."
    w oh "На когось це діє більш ефективно, на інших - менш ефективно. Людям, що чутливі до подібного, правильно підібраний аромат дійсно може допомогти."

# game/script.rpy:1917
translate ukr ch4_b1864f45:

    # p think "Huh...."
    p think "Ого...."

# game/script.rpy:1918
translate ukr ch4_7f7e2939:

    # w guilty "And now I fear I've bored you with all this uninteresting work chatter..."
    w guilty "Здається, я тебе втомив цими нудними балачками про роботу..."

# game/script.rpy:1919
translate ukr ch4_bb924acc:

    # p wha "N-no! That's not it at all--I was just thinking..."
    p wha "Н-ні! Зовсім не так - я просто думав..."

# game/script.rpy:1920
translate ukr ch4_3efb722b:

    # p shy "It's really admirable, that your magic can be used to help people like that...."
    p shy "Те, що твоя магія може ось так допомагати людям, викликає у мене захоплення...."

# game/script.rpy:1921
translate ukr ch4_cd5ea0a1:

    # w ah "(Admirable...?)"
    w ah "(Захоплення?..)"

# game/script.rpy:1922
translate ukr ch4_5eb41425:

    # p ehe "Selling candy... I think, makes people happy too. Maybe that's what's fun about it."
    p ehe "Гадаю, що цукерки... теж роблять людей щасливішими. Можливо, саме через це мені і подобається моя робота."

# game/script.rpy:1923
translate ukr ch4_a605b20b:

    # p shy "Not that I'd ever claim our candy is healthy either. If anything, you might get cavities..."
    p shy "Не те щоб я мав на увазі, що наші цукерки якось поліпшують здоров'я. Навпаки, можна і зуби зіпсувати, якщо їх переїсти..."

# game/script.rpy:1924
translate ukr ch4_0ed90fce:

    # w happy "Hmhm, the witch who owns the apothecary really liked the sample I passed along to her."
    w happy "Хмхм, я пригостив відьму, що керує аптекою, однією з ваших цукерок і їй дуже сподобалось."

# game/script.rpy:1925
translate ukr ch4_33647d12:

    # w teehee "Perhaps she'll ask to distribute your candies as well~!"
    w teehee "Може, вона захоче і ваші цукерки продавати!~"

# game/script.rpy:1926
translate ukr ch4_5b3353f1:

    # p flustered2 "Sy--um, my boss would never agree to that."
    p flustered2 "Сі- ем, моя керівниця ніколи на це не погодиться."

# game/script.rpy:1927
translate ukr ch4_3c241263:

    # p smile "Anyway... I'd be happy to see it. Lead the way!"
    p smile "В будь-якому разі... Мені було б цікаво побачити, де ти працюєш. Показуй дорогу!"

# game/script.rpy:1928
translate ukr ch4_573a6eaf:

    # w innocent "Very well 💙 Follow me~"
    w innocent "Чудово 💙 Йди за мною~"

# game/script.rpy:1936
translate ukr ch4_d2942b5c:

    # "When we enter the apothecary, it looks to be completely empty."
    "Коли ми зайшли в аптеку, вона виглядала цілком порожньою."

# game/script.rpy:1937
translate ukr ch4_6c59545b:

    # "Astragalus usually sits in the back room, consumed in her work, until she hears the chime of a customer entering."
    "Астрагал зазвичай сидить у підсобці, повністю занурена у працю, аж поки дзвінок не сповістить її про прибуття клієнта."

# game/script.rpy:1938
translate ukr ch4_5aa40d36:

    # "If you ask me, she could really use another helper to liven up the place..."
    "Як на мене, їй би не завадив ще один помічник, аби трохи оживити це місце..."

# game/script.rpy:1939
translate ukr ch4_d6fdead9:

    # "But I suppose the hustle and bustle of an ever-busy shop would have its own setbacks."
    "Але, гадаю, постійний натовп і метушня в магазині можуть мати свої недоліки."

# game/script.rpy:1940
translate ukr ch4_76b2fe88_8:

    # nvl clear
    nvl clear

# game/script.rpy:1943
translate ukr ch4_2c0acbc5:

    # w date "Feel free to look around. I'm going to go and greet the owner 💙"
    w date "Не соромся, роздивляйся. Я поки піду і привітаю власницю 💙"

# game/script.rpy:1944
translate ukr ch4_edde0847:

    # p smile "Sure."
    p smile "Звісно."

# game/script.rpy:1949
translate ukr ch4_03389dda:

    # n "Periwinkle leans over the counter to peek into the back room."
    n "Барвінок нахиляється через прилавок, аби зазирнути в підсобку."

# game/script.rpy:1951
translate ukr ch4_b6b8917e:

    # w date happy "Astragalus~! You have a customer~~!"
    w date happy "Астрагал!~ До тебе прийшов клієнт!~~"

# game/script.rpy:1954
translate ukr ch4_17a4c616:

    # a "Oh, Periwinkle. Didn't expect to see you back so soon."
    a "О, Барвінок. Не очікувала тебе так швидко побачити знову."

# game/script.rpy:1955
translate ukr ch4_8bd3c979:

    # w innocent "I brought Pastille! We're on a date 💙"
    w innocent "Я привів Пастиля! Ми на побаченні 💙"

# game/script.rpy:1956
translate ukr ch4_95b073e2:

    # a annoyed "...Okay."
    a annoyed "...Гаразд."

# game/script.rpy:1957
translate ukr ch4_b2245627:

    # n "She looks over at Pastille, who waves when he notices he's being watched. Astragalus turns back to Periwinkle."
    n "Вона дивиться на Пастиля, який помічає це і маше рукою. Астрагал повертається до Барвінка."

# game/script.rpy:1958
translate ukr ch4_215220bc:

    # a whatever "I take it you decided NOT to heed my advice."
    a whatever "Гадаю, ти вирішив НЕ брати до уваги мою пораду."

# game/script.rpy:1959
translate ukr ch4_b3e20422:

    # w my "Hm? What advice?"
    w my "Хм? Яку пораду?"

# game/script.rpy:1960
translate ukr ch4_e1925ef2:

    # a augh "Why bother coming to me if you're just gonna do whatever you want..."
    a augh "Нащо взагалі приходити до мене за порадами, якщо ти робиш те, що в голову прийде..."

# game/script.rpy:1961
translate ukr ch4_42d8b424:

    # a closed "Well, whatever. Is there a reason you're here?"
    a closed "Гаразд, це не мої проблеми. Ти прийшов сюди з якоїсь причини?"

# game/script.rpy:1962
translate ukr ch4_cd2145bd:

    # w innocent "I thought I'd drop by to give you a little update! As you can see, everything is fine now."
    w innocent "Я просто подумав, що міг би зазирнути і принести гарну новину! Як бачиш, тепер все гаразд."

# game/script.rpy:1963
translate ukr ch4_ac82b301:

    # a eyeroll "...Sure. Very normal of you to suddenly bring one of your dates here."
    a eyeroll "...Звісно. Ти ж постійно сюди притягаєш когось зі своїх пасій."

# game/script.rpy:1964
translate ukr ch4_d2135757:

    # w my "Is it not? I visit you all the time!"
    w my "Чому б ні? Я часто до тебе заглядаю!"

# game/script.rpy:1965
translate ukr ch4_59449ce5:

    # a lol "Yeah, not for stuff like this."
    a lol "Ага, але не заради такого."

# game/script.rpy:1966
translate ukr ch4_bfc9f6c6:

    # w happy "Anyway--I wanted you to meet Pastille!"
    w happy "В будь-якому випадку - я хотів познайомити тебе з Пастилем!"

# game/script.rpy:1967
translate ukr ch4_479d8d54:

    # w "Pastille~! Come over here 💙"
    w "Пастиле!~ Підійди сюди 💙"

# game/script.rpy:1969
translate ukr ch4_347c886b:

    # n "Startled by suddenly being called upon, Pastille fumbles the bottle he was holding and it crashes onto the floor."
    n "Пастил, раптом почувши своє ім'я, здригається, і флакон, який він тримав, вилітає у нього з рук, розбиваючись на дрібні шматочки."

# game/script.rpy:1971
translate ukr ch4_a645f843:

    # w ohdear "Ah--"
    w ohdear "Ах-"

# game/script.rpy:1972
translate ukr ch4_da2d5595:

    # a augh "HEY, you break it, you buy it!" with vpunch
    a augh "ХЕЙ, якщо зламав - то плати!" with vpunch

# game/script.rpy:1973
translate ukr ch4_182e1ea6:

    # p "Sorry!! I-I can fix it--"
    p "Вибачте!! Я-я можу його полагодити-"

# game/script.rpy:1975
translate ukr ch4_96d34e8e:

    # n "Pastille sweeps the pieces of the bottle into a pile along with its powdered contents."
    n "Пастиль змітає шматочки флакону і порошок, що в ньому був, в одну купку."

# game/script.rpy:1977
translate ukr ch4_4e1d7957:

    # n "He holds his hands over the pile, now glowing with magic, and the three of them watch as it reassembles perfectly before them."
    n "Він простягає руки, що починають світитись магією, над купкою, і всі троє спостерігають за тим, як флакон стає цілим."

# game/script.rpy:1978
translate ukr ch4_0b2deec4:

    # w ah "(Impressive... He's done it so quickly....)"
    w ah "(Вражаюче... Він так швидко це зробив....)"

# game/script.rpy:1981
translate ukr ch4_4b28fdb7:

    # p ehe2 "There... good as new."
    p ehe2 "Ось... як новий."

# game/script.rpy:1982
translate ukr ch4_0508b2ea:

    # a whatever "...Bring it here."
    a whatever "...Принеси його сюди."

# game/script.rpy:1983
translate ukr ch4_4fd60af9:

    # p um "Ah--um... sure. S-sorry...."
    p um "Ах- ем... звісно. В-вибачте...."

# game/script.rpy:1984
translate ukr ch4_62c15c89:

    # w guilty "(I can't help but feel I've put Pastille in yet another uncomfortable situation....)"
    w guilty "(Мені здається, що я знов поставив Пастиля у незручне положення....)"

# game/script.rpy:1985
translate ukr ch4_2664336a:

    # a hm "...Damn, can't even tell it was ever busted up. This kind of magic your specialty?"
    a hm "...Чорт забирай, навіть і не скажеш, що він коли-небудь ламався. Ти на цій магії спеціалізуєшся?"

# game/script.rpy:1986
translate ukr ch4_0b008a8e:

    # p ehe "Not really... I only learned it because I thought it'd come in handy."
    p ehe "Насправді, ні... Я просто навчився цьому, бо подумав, що це може колись знадобитись."

# game/script.rpy:1987
translate ukr ch4_c184027e:

    # a closed "Huh."
    a closed "Оу."

# game/script.rpy:1991
translate ukr ch4_33a20748:

    # n "Astragalus continues inspecting the bottle, and then takes it into the back room without saying another word."
    n "Астрагал продовжує ретельно оглядати флакончик, і після цього забирає його у підсобку, не промовивши ні слова."

# game/script.rpy:1992
translate ukr ch4_e17b00b3:

    # w date my "(Wow~ I suppose she was impressed, too!)"
    w date my "(Вау~ Гадаю, вона теж вражена!)"

# game/script.rpy:1995
translate ukr ch4_f3676b3b:

    # p "Is she mad at me...? I can't really tell...."
    p "Вона злиться на мене?.. Я не можу зрозуміти...."

# game/script.rpy:1996
translate ukr ch4_a65c95b5:

    # w happy "It looks like you were spared today 💙 That spell really saved you."
    w happy "Гадаю, що сьогодні вона тебе пощадила 💙 Це закляття тебе дійсно врятувало."

# game/script.rpy:1997
translate ukr ch4_f977739a:

    # p flustered2 "I can't believe I did that... I'm not usually this clumsy, I swear."
    p flustered2 "Не можу повірити, що таке сталося... Зазвичай я не настільки незграбний, клянуся."

# game/script.rpy:1998
translate ukr ch4_ebece81c:

    # w love "Oh, but wouldn't it be adorable if you were? Pastille the klutz~! 💙"
    w love "Ох, але це б було неймовірно мило, хіба ні? Розтяпа Пастиль!~ 💙"

# game/script.rpy:1999
translate ukr ch4_b4268f28:

    # p scream "NO...! I-I'm just gonna go wait outside!!" with vpunch
    p scream "НІ!.. Я-я краще почекаю на тебе зовні!!" with vpunch

# game/script.rpy:2000
translate ukr ch4_83c29565:

    # w innocent "Hmhm, don't be too hard on yourself~ I promise you made a better impression than you think."
    w innocent "Хмхм, не переживай так сильно~ Я впевнений, що ти справив краще враження, ніж думаєш."

# game/script.rpy:2004
translate ukr ch4_2175cd9e:

    # "Pastille walks out of the apothecary, and I lean against the counter, waiting for Astragalus to re-emerge from the back room."
    "Пастиль виходить з аптеки, а я перехиляюсь через прилавок і чекаю, поки Астрагал повернеться з підсобки."

# game/script.rpy:2005
translate ukr ch4_e0cb17ac:

    # "But when she does, it's with a bag full of... well... I'm not quite sure."
    "Але повертається вона з сумкою, повною... я навіть не впевнений, що це таке."

# game/script.rpy:2006
translate ukr ch4_76b2fe88_9:

    # nvl clear
    nvl clear

# game/script.rpy:2009
translate ukr ch4_e90d8861:

    # a "...Hm? Where'd your boyfriend go?"
    a "...Хм? А куди твій бойфренд дівся?"

# game/script.rpy:2010
translate ukr ch4_abadde12:

    # w date "You shouldn't call him that. Might I ask--what is it you're holding?"
    w date "Не треба так його називати. Дозволь поцікавитись - що це в тебе таке у сумці?"

# game/script.rpy:2011
translate ukr ch4_4abab777:

    # a happy "Busted lamp. I've been meaning to glue it back together myself, until I saw the opportunity to save myself the trouble."
    a happy "Розбита лампа. Хотіла склеїти її сама, але тепер побачила можливість позбавити себе від зайвого клопоту."

# game/script.rpy:2012
translate ukr ch4_62e9d646:

    # w pout "How offensive. Take it to a repair shop, like everyone else."
    w pout "Твої слова мене ображають. Просто віднеси її у майстерню, як всі нормальні люди."

# game/script.rpy:2013
translate ukr ch4_d29f2200:

    # a lol "Nah, waste of money. You better keep that boy around--he's useful."
    a lol "Це марна трата грошей. Ти, до речі, притримай цього хлопця при собі - він корисний."

# game/script.rpy:2014
translate ukr ch4_88d15fb4:

    # w calm "You've certainly changed your tune...."
    w calm "Бачу, тепер ти змінила свою думку...."

# game/script.rpy:2015
translate ukr ch4_d330e65c:

    # a happy "He's cute. I get a good vibe from him."
    a happy "Він дійсно милий. І я відчуваю, що в нього хороша енергетика."

# game/script.rpy:2016
translate ukr ch4_f8e67399:

    # a lol2 "Anyway, bring him back in sometime so I can get this lamp fixed. Got it?"
    a lol2 "В будь-якому разі, приведи його якось ще раз, аби він мені полагодив цю лампу. Домовились?"

# game/script.rpy:2017
translate ukr ch4_743dec44:

    # w happy "He won't be doing that!!"
    w happy "Він не буде цього робити!!"

# game/script.rpy:2018
translate ukr ch4_91bd044b:

    # a neutral "Seriously, though. Where I'm from, we were taught that you can tell a lot about a witch from their magic..."
    a neutral "Але якщо говорити серйозно... Там, де я народилась, вважається, що можна дізнатись багато про відьом, якщо знати про їхню магію..."

# game/script.rpy:2019
translate ukr ch4_f2f55ac5:

    # a closed "And his? Very empathetic. Sincere, compassionate."
    a closed "І що я можу сказати про його магію? Дуже емпатична. Відверта та співчутлива."

# game/script.rpy:2020
translate ukr ch4_7019ca7c:

    # w love "Well, you aren't wrong, but... how can you judge that sort of thing after witnessing one little spell?"
    w love "Так, гадаю, що ти права, але... як ти можеш з впевненістю говорити про таке, побачивши всього одне невеличке закляття?"

# game/script.rpy:2021
translate ukr ch4_bd2d025d:

    # a lol "Ha, wouldn't YOU like to know?"
    a lol "Ха, хіба ти не хочеш дізнатись?"

# game/script.rpy:2022
translate ukr ch4_768d16f3:

    # w calm "Hmhm, I don't need your superstitions. I have a date to get back to."
    w calm "Хмхм, мені не потрібні твої забобони. До того ж, в мене зараз побачення."

# game/script.rpy:2023
translate ukr ch4_dfa92959:

    # a smile "Heh, alright. Have fun, Periwinkle...."
    a smile "Хех, гаразд. Повеселись там, Барвінку..."

# game/script.rpy:2024
translate ukr ch4_c2b45ec4:

    # w innocent "Oh, I very much intend to 💙"
    w innocent "О, я саме це і планую 💙"

# game/script.rpy:2028
translate ukr ch4_7cd4194b:

    # n "Smiling to himself, Periwinkle strides confidently out the door to where Pastille is waiting."
    n "Посміхаючись, Барвінок впевнено крокує до дверей і виходить на вулицю, де на нього чекає Пастиль."

# game/script.rpy:2036
translate ukr ch4_d3b6758e:

    # p "Hey--um... do I still need to pay for that bottle?"
    p "Хей- ем... мені все-таки треба заплатити за той флакон?"

# game/script.rpy:2037
translate ukr ch4_c189c5fa:

    # w date calm "She didn't mention it."
    w date calm "Вона нічого про це не казала."

# game/script.rpy:2038
translate ukr ch4_3e5dc9da:

    # p calm "Phew. I'm glad I could fix it... I was worried it might be expensive."
    p calm "Фух. Я радий, що зміг його полагодити... Боявся, що він може дорого коштувати."

# game/script.rpy:2039
translate ukr ch4_b7aae312:

    # w smile "You never told me you were so good with magic. As I recall, you said you had been living without it?"
    w smile "Ти ніколи мені не говорив, що настільки добре вправляєшся з магією. Наскільки я пам'ятаю, ти сказав, що жив без неї?"

# game/script.rpy:2040
translate ukr ch4_ae7d5ce2:

    # p think "Yeah, mostly."
    p think "Ага, більшу частину життя."

# game/script.rpy:2041
translate ukr ch4_d4e69b9f:

    # p ehe "I won't get into the reasons why... but I got back into studying it recently."
    p ehe "Не хочу говорити про причини, але... нещодавно я повернувся до її вивчення."

# game/script.rpy:2042
translate ukr ch4_b20c986a:

    # w happy "Astragalus certainly thought you were talented. I'm impressed too, of course."
    w happy "Астрагал абсолютно точно вважає, що ти дуже талановитий. Я, звісно, теж вражений."

# game/script.rpy:2043
translate ukr ch4_537846ba:

    # p shy "Th-thanks... haha, if only I could use magic to stop myself from being a klutz...."
    p shy "Д-дякую... хаха, якщо б тільки я міг використати магію для того, аби не бути таким розтяпою...."

# game/script.rpy:2044
translate ukr ch4_e7496cc5:

    # w teehee "Oh, are you embracing that nickname now?"
    w teehee "О, ти вже звикаєш до цього прізвиська?"

# game/script.rpy:2045
translate ukr ch4_32e4b18b:

    # p scream "N-no!! Please go back to saying \"my sweet\"!!!" with vpunch
    p scream "Н-ні!! Будь ласка, краще називай мене \"мій солоденький\", як і раніше!!" with vpunch

# game/script.rpy:2046
translate ukr ch4_e86c0674:

    # w love "Ah~ if you like that one so much, I suppose I have no choice! 💙"
    w love "Ах~ Гадаю, якщо це прізвисько тобі настільки подобається, то в мене немає іншого вибору! 💙"

# game/script.rpy:2047
translate ukr ch4_419d487f:

    # p omgstop "I-I... I just meant...!"
    p omgstop "Я-я... Я мав на увазі!.."

# game/script.rpy:2048
translate ukr ch4_8c34b708:

    # p flustered "N-Nevermind!! Don't call me anything...!" with vpunch
    p flustered "З-забудь!! Ніяк мене не називай!.." with vpunch

# game/script.rpy:2049
translate ukr ch4_58252808:

    # w shy "Hmhmhm 💙 Oh, Pastille...."
    w shy "Хмхмхм 💙 Ох, Пастиле...."

# game/script.rpy:2052
translate ukr ch4_5df76680:

    # "We resume our stroll around town..."
    "Ми повертаємось до нашої прогулянки містом."

# game/script.rpy:2053
translate ukr ch4_df4e55af:

    # "This time, it's Pastille who takes the lead. He seems to have someplace in mind, but hasn't said as much."
    "На цей раз веде Пастиль. Він нічого не каже про те, куди саме ми йдемо, але, здається, він хоче щось мені показати."

# game/script.rpy:2054
translate ukr ch4_5623091f:

    # "He merely takes my hand and leads me up a labyrinth of stairs..."
    "Він просто бере мене за руку і веде нагору. Сходів так багато, що вони схожі на справжній лабіринт..."

# game/script.rpy:2055
translate ukr ch4_76b2fe88_10:

    # nvl clear
    nvl clear

# game/script.rpy:2059
translate ukr ch4_fd97df8a:

    # "And once we reach the top..."
    "І коли ми нарешті опиняємось нагорі..."

# game/script.rpy:2060
translate ukr ch4_37819467:

    # "A gust of wind swoops through the trees overhead, showering us in flower petals."
    "Різкий порив вітру проноситься крізь дерева, які осипають нас дощем з пелюсток квітів."

# game/script.rpy:2061
translate ukr ch4_af3d310d:

    # nvl clear
    # w date ah "Ah. Peach blossoms..."
    nvl clear
    w date ah "Ах. Цвітіння персика..."

# game/script.rpy:2065
translate ukr ch4_bf824512:

    # p "It's nice, isn't it?"
    p "Гарно, чи не так?"

# game/script.rpy:2066
translate ukr ch4_745730c3:

    # w love "Hmhm, I can't help but think you're trying to tell me something right now~"
    w love "Хмхм, мені здається, що ти намагаєшся мені на щось натякнути~"

# game/script.rpy:2067
translate ukr ch4_36d2e96b:

    # p oh "Huh...?"
    p oh "А?.."

# game/script.rpy:2068
translate ukr ch4_7daf2c79:

    # w smile "Don't you remember? My \"aphrodisiac\" was also peach-scented..."
    w smile "Хіба ти не пам'ятаєш? Мій \"афродізіак\" теж мав аромат персику..."

# game/script.rpy:2069
translate ukr ch4_290ca16a:

    # p wha "Ah..."
    p wha "А..."

# game/script.rpy:2070
translate ukr ch4_d493bae3:

    # p kyaa "A-AH...! I WASN'T THINKING ABOUT THAT...!!!" with vpunch
    p kyaa "А-А!.. Я ПРО ЦЕ НЕ ПОДУМАВ!!!..." with vpunch

# game/script.rpy:2071
translate ukr ch4_d739c596:

    # p wow "I-I just, was trying to think of other places we could go, and this one came to mind..."
    p wow "Я-я просто думав, куди б ще ми могли піти, і це місце спало на думку..."

# game/script.rpy:2072
translate ukr ch4_eab2cf4c:

    # w happy "It's lovely. Very romantic 💙"
    w happy "Воно чудове. Дуже романтичне 💙"

# game/script.rpy:2073
translate ukr ch4_2f1a8383:

    # w shy "(Straight out of a shoujo manga, honestly... how does he know I'm weak to such things?)"
    w shy "(Чесно кажучи, воно неначе вийшло зі сторінок шьоджьо-манґи... як він здогадався, що мені таке подобається?)"

# game/script.rpy:2074
translate ukr ch4_9218331e:

    # p omg "We don't have to stay... I mean, we've already walked around so much--it's okay if you wanna head back now..."
    p omg "Ми можемо тут не залишатися... Я мав на увазі, що ми вже довго ходимо - може, ти хочеш повернутися назад..."

# game/script.rpy:2075
translate ukr ch4_18984878:

    # p omgstop "N-NOT TO... DO THINGS... I just meant...! I-I'm gonna stop talking......" with vpunch
    p omgstop "Н-НЕ ДЛЯ ТОГО... АБИ ЗАЙМАТИСЬ... т-ти зрозумів... Я просто!.. В-все, мовчу....." with vpunch

# game/script.rpy:2076
translate ukr ch4_6d760657:

    # w love "Pastille."
    w love "Пастилю."

# game/script.rpy:2077
translate ukr ch4_7a8b97fb:

    # p seriously "Y-yes...?"
    p seriously "Т-так?.."

# game/script.rpy:2078
translate ukr ch4_ec1d1b34:

    # w calm "You've presented me quite the conundrum. If I kiss you now, you'll definitely want to return home with me as soon as possible..."
    w calm "Ти поставив мене перед важким вибором. Якщо я тебе зараз поцілую, ти точно захочеш повернутися зі мною додому якнайшвидше..."

# game/script.rpy:2079
translate ukr ch4_80145f9c:

    # w happy "But I wasn't done learning all about you. I'm not ready for our date to end 💙"
    w happy "Але я досі далеко не все про тебе дізнався! Я не хочу, аби наше побачення закінчувалось зараз 💙"

# game/script.rpy:2080
translate ukr ch4_5974e4ff:

    # p embarrassed "O-oh... that IS a conundrum...."
    p embarrassed "О-ох... це дійсно важкий вибір...."

# game/script.rpy:2081
translate ukr ch4_dbc74acd:

    # w love "Yes, you see? Both options are equally appealing. However can I decide~?"
    w love "Так, розумієш? Обидві можливості мене дуже приваблюють. І що ж мені обрати?~"

# game/script.rpy:2082
translate ukr ch4_ec2c6956:

    # p shy "Haha, um, well... i-it's still light out! Maybe we can hold back until after dinner...."
    p shy "Хаха, ем, ну... на вулиці досі світло! Може, ми зможемо протриматись до вечері...."

# game/script.rpy:2083
translate ukr ch4_584de9f1:

    # w teehee "Or I could have YOU for dinner 💙"
    w teehee "Або я можу повечеряти ТОБОЮ 💙"

# game/script.rpy:2084
translate ukr ch4_31907a91:

    # p kyaa "A-AH...!" with vpunch
    p kyaa "А-АХ!.." with vpunch

# game/script.rpy:2085
translate ukr ch4_f4a3afbc:

    # w calm "On the other hand, you bring up a valid point. Holding back is fun in itself."
    w calm "З іншого боку, ти висловив непогану думку. Ми можемо і відтягнути задоволення~"

# game/script.rpy:2086
translate ukr ch4_9d41c26b:

    # p omgstop "Do you expect me to recover after what you just said...?!"
    p omgstop "Думаєш, я прийду до тями після того, що ти сказав?!..."

# game/script.rpy:2087
translate ukr ch4_32adccf0:

    # w happy "See~? This IS quite fun!"
    w happy "Бачиш?~ Це дійсно доволі весело!"

# game/script.rpy:2088
translate ukr ch4_b5263d43:

    # w calm "It's decided, then. The date continues."
    w calm "Тоді вирішено. Побачення продовжується."

# game/script.rpy:2092
translate ukr ch4_98062818:

    # "I give Pastille a moment to calm himself."
    "Я дав Пастилю час, аби прийти до тями."

# game/script.rpy:2093
translate ukr ch4_43346300:

    # "We walk up to the railing and look out at the town..."
    "Ми підходимо до перил, аби подивитись на місто..."

# game/script.rpy:2094
translate ukr ch4_2e739e18:

    # nvl clear
    # "You can see Atelier Sweets from here. And the train station next to it."
    nvl clear
    "Звідси можна побачити Ательє Солодощів і залізнодорожню станцію недалеко від нього."

# game/script.rpy:2096
translate ukr ch4_65c0b220:

    # "My house is... somewhere in a row of similarly built homes. Inconspicuous."
    "Мій будинок... непомітно стоїть у ряді абсолютно однакових будинків."

# game/script.rpy:2097
translate ukr ch4_140deac1:

    # "Fallen petals litter the bricks at our feet, with every little breeze carrying a few more over the railing to land somewhere unknown."
    "Пелюстки падають до наших ніг, і вітерець кожен раз здмухує декілька з них. Вони летять далі і далі, аби приземлитись десь в іншому місці."

# game/script.rpy:2098
translate ukr ch4_9b3a7e5d:

    # "After watching them for a while, I turn back to Pastille."
    "Деякий час я спостерігаю за ними, а потім повертаюсь до Пастиля."

# game/script.rpy:2099
translate ukr ch4_76b2fe88_11:

    # nvl clear
    nvl clear

# game/script.rpy:2102
translate ukr ch4_6319f667:

    # w date "Tell me about your magic."
    w date "Розкажи мені про свою магію."

# game/script.rpy:2103
translate ukr ch4_81ee26b5:

    # p um "O-okay... what do you want to know?"
    p um "Г-гаразд... що саме ти хочеш дізнатись?"

# game/script.rpy:2104
translate ukr ch4_c829cbee:

    # w innocent "Your specialty, dear!"
    w innocent "Те, на чому ти спеціалізуєшся, любий!"

# game/script.rpy:2105
translate ukr ch4_9847abef:

    # w smile "If you were that good at reconstruction, I imagine it must fall somewhere in that category...?"
    w smile "Якщо в тебе настільки добре виходить реконструкція, гадаю, що десь тут і знаходиться твоя спеціальність?.."

# game/script.rpy:2106
translate ukr ch4_b09961bf:

    # p ehe "Um, not really... I'm actually an astral witch."
    p ehe "Ем, ні... Насправді я астральна відьма."

# game/script.rpy:2107
translate ukr ch4_443121bc:

    # w my "My, how rare! And what exactly does that entail for you?"
    w my "Боже, яка рідкість! І що саме ще значить для тебе?"

# game/script.rpy:2108
translate ukr ch4_44c2df3e:

    # p shy "Ahh, well, I mostly use it for fire spells, like anyone else..."
    p shy "Ахх, ну, я зазвичай використовую її для заклять вогню, як і більшість..."

# game/script.rpy:2109
translate ukr ch4_bcabe313:

    # w oh "Forgive me, I'm not well-versed in magic theory... but doesn't astral magic have something to do with creation?"
    w oh "Пробач, я не дуже обізнаний в теорії магії... але хіба астральна магія не пов'язана зі створенням чогось?"

# game/script.rpy:2110
translate ukr ch4_ac2d501e:

    # p ehe2 "It does... but that stuff is pretty advanced. I haven't been able to find any books explaining how to use it."
    p ehe2 "Вона пов'язана, так... але це доволі складно. Я так і не знайшов жодної книги, яка б пояснювала, як її використовувати."

# game/script.rpy:2111
translate ukr ch4_02f8bfe1:

    # p embarrassed "...Which is probably for the best, actually. No one should be allowed to go around creating souls spontaneously...!"
    p embarrassed "...Напевно, це на краще. Ніхто не має мати змоги просто так брати і створювати душі!.."

# game/script.rpy:2112
translate ukr ch4_29508975:

    # w neutral "Hm..."
    w neutral "Хм..."

# game/script.rpy:2114
translate ukr ch4_1b5322bf:

    # "Pastille rubs the back of his neck, looking off into the distance."
    "Пастиль дивиться у сторону, потираючи шию."

# game/script.rpy:2115
translate ukr ch4_309805fa:

    # "He seems so troubled by the subject..."
    "Здається, ця тема ця його дуже хвилює та непокоїть..."

# game/script.rpy:2116
translate ukr ch4_9604342e:

    # "I suppose because he had been living without magic, it may feel strange to openly discuss it?"
    "Можливо, для нього дивно так відкрито обговорювати магію, бо він стільки часу жив без неї?"

# game/script.rpy:2117
translate ukr ch4_48123bf8:

    # nvl clear
    # "An astral witch, though... I wouldn't have guessed."
    nvl clear
    "Астральна відьма... Я б не здогадався."

# game/script.rpy:2119
translate ukr ch4_c8d56a68:

    # "Putting two and two together, ONE thing makes perfect sense now..."
    "Але якщо скласти факти один з одним, одна річ раптом набуває сенсу..."

# game/script.rpy:2120
translate ukr ch4_551942a5:

    # nvl clear
    # w ah "So the famous Atelier Sweets golem was YOUR creation?"
    nvl clear
    w ah "Так це ти створив відомого голема з Ательє Солодощів?"

# game/script.rpy:2123
translate ukr ch4_2c8fd31f:

    # p ehe2 "Haha, is she really that famous? I'd expect our sales to be a little better if that were the case..."
    p ehe2 "Хаха, вона дійсно настільки відома? Я гадаю, що тоді б у нас мали бути кращі продажі..."

# game/script.rpy:2124
translate ukr ch4_fd97e90a:

    # p flustered2 "But... yeah. Just don't go around telling everyone--I didn't know what I was doing when I made her."
    p flustered2 "Але... так. Тільки не розповідай нікому - я не знаю, що на мене найшло і чому мені прийшла в голову ідея її створити."

# game/script.rpy:2125
translate ukr ch4_e7fb158c:

    # w my "What an amazing feat... and yet you sound almost ashamed of it!"
    w my "Це настільки вражаюче досягнення... і тим не менш, ти неначе соромишся цього!"

# game/script.rpy:2126
translate ukr ch4_0bf92251:

    # p ohno "I-it's not like I regret it or anything... Gumdrop is really great! I just..."
    p ohno "Н-не те щоб я шкодую про те, що її створив... Мармеладка дійсно чудова! Просто..."

# game/script.rpy:2127
translate ukr ch4_2ed99bc8:

    # p nervous "I feel bad that she's stuck in a body with so many limitations. Like, she didn't ask to be made that way..."
    p nervous "Мені шкода, що вона застрягла у тілі з такою великою кількістю обмежень. Вона ж не просила бути створеною ось так..."

# game/script.rpy:2128
translate ukr ch4_8694e630:

    # p flustered2 "I didn't know you could even make golems that felt real emotions, so of course I never considered any of that."
    p flustered2 "Я не знав, що можливо створити големів, що мають емоції та почуття, і, звісно, навіть не подумав про це."

# game/script.rpy:2129
translate ukr ch4_cde66f06:

    # p shy "...Sorry to go off about it. I-I've just been feeling guilty lately--kind of a heavy topic."
    p shy "...Вибач, що так на тебе все вилив. Я-я просто останнім часом відчуваю провину... це трохи важка тема."

# game/script.rpy:2130
translate ukr ch4_9931704c:

    # w ah "No, no... thank you for telling me."
    w ah "Ні, ні... дякую, що розповів."

# game/script.rpy:2131
translate ukr ch4_b7df5332:

    # w calm "It's as if I've discovered a whole new side of you today. I'm grateful to know it."
    w calm "Гадаю, що сьогодні я відкрив нову сторону тебе. І я вдячний тобі - ти дозволив мені її побачити."

# game/script.rpy:2132
translate ukr ch4_d2da19ee:

    # p ehe "Thanks for listening... I don't get many chances to talk about things like this, so I'm grateful for it, too."
    p ehe "Дякую, що вислухав... В мене зазвичай немає можливості про це поговорити, тому я теж дуже вдячний тобі."

# game/script.rpy:2133
translate ukr ch4_2f822c09:

    # w love "Hmhm, hearing you speak of her though, I'd love to meet this golem of yours one day."
    w love "Хмхм, але я настільки наслухався про цього голема від тебе, і мені захотілось коли-небудь її побачити."

# game/script.rpy:2134
translate ukr ch4_87960f32:

    # p sure "Sure. Maybe one day."
    p sure "Звісно. Може, коли-небудь."

# game/script.rpy:2137
translate ukr ch4_e955de1d:

    # "Pastille is amazing."
    "Пастиль неймовірний."

# game/script.rpy:2138
translate ukr ch4_dd1b4e98:

    # "I've never met anyone who would downplay their talents this much--I could ask a thousand questions and still only scratch the surface..."
    "Я ніколи не зустрічав когось, хто б настільки приховував та применшував свої таланти. Я можу задати тисячу питань і дізнаюсь лише трохи про те, який він насправді..."

# game/script.rpy:2139
translate ukr ch4_034046bb:

    # "My, now I'M the insatiable one. How the tables have turned!"
    "Боже, тепер Я ненаситний. Як все змінилося!"

# game/script.rpy:2140
translate ukr ch4_aa528040:

    # nvl clear
    # "We decide it's time to move on, and descend the stairs from whence we came..."
    nvl clear
    "Ми вирішуємо, що настав час вирушати далі, і починаємо спускатися по сходах..."

# game/script.rpy:2142
translate ukr ch4_5310cd5c:

    # "...Still chatting endlessly as we decide where we'll wander to next."
    "...водночас ми не перестаємо балакати, і намагаємось обрати наступну ціль прогулянки."

# game/script.rpy:2143
translate ukr ch4_76b2fe88_12:

    # nvl clear
    nvl clear

# game/script.rpy:2146
translate ukr ch4_ab4f864b:

    # "Over dinner, Pastille opens up a little more."
    "Після вечері Пастиль ще трохи мені відкривається."

# game/script.rpy:2147
translate ukr ch4_2a1a4890:

    # "We trade anecdotes, listening intently to each others' stories no matter how unremarkable the events told within them."
    "Ми розповідаємо про своє життя, уважно слухаємо історії один одного, незважаючи на те, про наскільки незначні події там розповідається."

# game/script.rpy:2148
translate ukr ch4_a504ab29:

    # "I could never tire of it~ I was hooked by his every word."
    "Я б ніколи від цього не втомився~ Я був неначе зачарований кожним його словом."

# game/script.rpy:2149
translate ukr ch4_efbe6e4c:

    # nvl clear
    # "Alas, the hours flew by, and our day together was quickly approaching its end..."
    nvl clear
    "Час пролетів швидко, і наш день разом вже добігав свого кінця..."

# game/script.rpy:2151
translate ukr ch4_d04a4349:

    # "But now we had the whole night to look forward to 💙"
    "Але в нас була ще ціла ніч попереду 💙"

# game/script.rpy:2152
translate ukr ch4_b7200d05:

    # "The sun was on its way down as we emerged back onto the street, the atmosphere so different than it had been just a short while ago."
    "Коли ми вийшли на вулицю, сонце вже заходило. Атмосфера на вулиці була зовсім інакшою, ніж раніше."

# game/script.rpy:2153
translate ukr ch4_d4905e0a:

    # "Pastille brushes his bangs aside and asks..."
    "Пастиль поправляє своє волосся і запитує..."

# game/script.rpy:2154
translate ukr ch4_76b2fe88_13:

    # nvl clear
    nvl clear

# game/script.rpy:2156
translate ukr ch4_b2bdea1d:

    # p "Do you wanna head back? It's starting to get late...."
    p "Як гадаєш, чи не час нам піти додому? Вже починає темніти..."

# game/script.rpy:2157
translate ukr ch4_843a037d:

    # w date shy "Hmhm, you've waited so patiently to be able to say that."
    w date shy "Хмхм, ти так спокійно чекав того моменту, коли нарешті можна буде про це запитати."

# game/script.rpy:2158
translate ukr ch4_8b799080:

    # p embarrassed "I-it's not like you aren't thinking of it too..."
    p embarrassed "Н-не роби вигляд, що ти теж про це не думав..."

# game/script.rpy:2159
translate ukr ch4_6cca094e:

    # w innocent "Let's go through the park. It's a shorter walk 💙"
    w innocent "Давай підемо через парк, так буде коротше 💙"

# game/script.rpy:2160
translate ukr ch4_027952fc:

    # p ehe "Sure...! A-after you...."
    p ehe "З-звісно!.. В-веди...."

# game/script.rpy:2162
translate ukr ch4_7984db30:

    # n "Periwinkle extends his hand, which Pastille takes without hesitation."
    n "Барвінок протягує руку, і Пастиль береться за неї без жодних вагань."

# game/script.rpy:2163
translate ukr ch4_93861845:

    # n "Under cover of dusk, they walk toward the park with fingers gently intertwined..."
    n "У сутінках вони йдуть по парку, тримаючись за руки, переплетаючись пальцями..."

# game/script.rpy:2167
translate ukr ch4_25bb3367:

    # "This park, during twilight hours, is nearly always deserted."
    "У вечірній час цей парк майже порожній."

# game/script.rpy:2168
translate ukr ch4_df0cd7c9:

    # "Tonight was no exception. We had the entire place to ourselves 💙"
    "Сьогоднішній вечір теж не виключення. Все це місце належить лише нам 💙"

# game/script.rpy:2169
translate ukr ch4_6ecf5db9:

    # "This way I can cling to Pastille all I want~! And on top of that..."
    "І тепер я можу притискатись до Пастила скільки захочу!~ І до того ж..."

# game/script.rpy:2170
translate ukr ch4_76b2fe88_14:

    # nvl clear
    nvl clear

# game/script.rpy:2172
translate ukr ch4_4d0933e5:

    # w date calm "Hmhm... 💙"
    w date calm "Хмхм... 💙"

# game/script.rpy:2173
translate ukr ch4_861071a6:

    # p ehe "What are you smiling about?"
    p ehe "Чому ти так посміхаєшься?"

# game/script.rpy:2174
translate ukr ch4_94a989eb:

    # w happy "Finally, no one's around! We can talk about all the inappropriate things we want 💙"
    w happy "Нарешті навколо нас нікого нема! Ми можемо говорити про будь-які непристойні речі, про які тільки захочемо 💙"

# game/script.rpy:2175
translate ukr ch4_f130417b:

    # p shy "Ahh, haha, I knew there was something dangerous about taking this shortcut...."
    p shy "Ахх, хаха, я так і знав, що вибирати коротший шлях небезпечно...."

# game/script.rpy:2176
translate ukr ch4_3e2e4df1:

    # w innocent "It's ok then, right~? No one will overhear your lascivious confessions."
    w innocent "Але ж ти тепер не проти, так?~ Ніхто не почує твоїх пристрастних зізнань."

# game/script.rpy:2177
translate ukr ch4_bf583b65:

    # p flustered "Mnnmmmnnn..."
    p flustered "Мннмммннн..."

# game/script.rpy:2178
translate ukr ch4_7af38195:

    # p omg "Okay. Wh-what do you want to know...?"
    p omg "Гаразд. П-про що ти хочеш дізнатись?.."

# game/script.rpy:2179
translate ukr ch4_888ea3f4:

    # w my "Oh--I didnt think you'd actually agree! I don't have anything prepared...."
    w my "Ох- я і гадки не мав, що ти дійсно погодишся! Я навіть питань не підготував...."

# game/script.rpy:2180
translate ukr ch4_664693be:

    # p wha "Wha--really? How anticlimactic."
    p wha "Що- дійсно? Яке розчарування."

# game/script.rpy:2181
translate ukr ch4_80a4788f:

    # w drool "Unless you're dying to tell me how much you love being dommed~" id ch4_80a4788f
    w drool "Якщо ти тільки не вмираєш від бажання розповісти, як тобі подобається, коли над тобою домінують~" id ch4_80a4788f

# game/script.rpy:2182
translate ukr ch4_ffcfb6d7:

    # p scream "I-I'm not gonna say that!!" with vpunch
    p scream "Я-я не буду цього говорити!!" with vpunch

# game/script.rpy:2183
translate ukr ch4_8613e224:

    # w teehee "Any fetishes, then? I have experience with all sorts, you know 💙"
    w teehee "Як щодо фетишів? Я мав справу з багатьма з них, знаєш 💙"

# game/script.rpy:2184
translate ukr ch4_0c994876:

    # p omgstop "TH-THIS IS TOO MUCH... I need to sit down...."
    p omgstop "Ц-ЦЕ ЗАНАДТО... Мені треба присісти...."

# game/script.rpy:2186
translate ukr ch4_4b33c40f:

    # n "Pastille begins his retreat to a nearby bench."
    n "Пастиль відступає до найближчої лавички."

# game/script.rpy:2188
translate ukr ch4_2eba37f4:

    # w love "Ahh, are you perhaps into fooling around outdoors? 💙"
    w love "Ахх, може, тобі подобається ідея розважатись на свіжому повітрі? 💙"

# game/script.rpy:2189
translate ukr ch4_41b5f99b:

    # p scream "THAT'S ILLEGAL...!"
    p scream "Ц-ЦЕ НЕЗАКОННО!.."

# game/script.rpy:2190
translate ukr ch4_b40825b6:

    # w innocent "Hmhm, only kidding~"
    w innocent "Хмхм, просто жартую~"

# game/script.rpy:2193
translate ukr ch4_2c359c9c:

    # n "Periwinkle follows Pastille to the bench and sits down beside him, leaning his head on his shoulder."
    n "Барвінок йде до лавички і сідає поруч з Пастилем, опускаючи голову на його плече."

# game/script.rpy:2196
translate ukr ch4_808f58c9:

    # w "Mm~ your sweatshirt is so warm 💙"
    w "Мм~ твоя кофта така тепла 💙"

# game/script.rpy:2197
translate ukr ch4_d5c67421:

    # p "...."
    p "...."

# game/script.rpy:2198
translate ukr ch4_c7ba6f29:

    # w "Are you upset with me? For suggesting such a scandalous idea~?"
    w "Я тебе раптом не засмучив тим, що запропонував таку скандальну ідею~?"

# game/script.rpy:2199
translate ukr ch4_15b477da:

    # p "No... but if you cling to me too much, I'm worried I might change my mind...."
    p "Ні... але якщо ти будеш занадто до мене притискатись, боюсь, що я зміню свою думку..."

# game/script.rpy:2200
translate ukr ch4_2cc70a66:

    # w "Hmhm, I wouldn't want to compromise your morals. But I'd also hate to let go."
    w "Хмхм, не хотілося б змушувати тебе відходити від своїх принципів. Але і відпускати тебе зовсім не хочеться."

# game/script.rpy:2201
translate ukr ch4_2b690861:

    # n "Pastille laughs at that, resigned to his fate."
    n "Пастиль, змирившись зі своєю долею, сміється у відповідь."

# game/script.rpy:2204
translate ukr ch4_5c08eb41:

    # n "The pair sits in comfortable silence for a while, listening only to the sound of the fountain before them."
    n "Пара сидить якийсь час у затишній тиші, яку порушує тільки журчання фонтану перед ними."

# game/script.rpy:2205
translate ukr ch4_a460b106:

    # n "Periwinkle can start to feel himself being lulled to sleep by it, and so, he tries speaking up again..."
    n "Барвінок починає відчувати, що цей звук заколисує його у сон, і намагається заговорити знову..."

# game/script.rpy:2208
translate ukr ch4_102622e6:

    # w date calm "I don't know what it is about you, Pastille..."
    w date calm "Є у тобі дещо таке, Пастиле..."

# game/script.rpy:2209
translate ukr ch4_89bd3bdc:

    # w shy "We've talked all day, and yet I still don't feel like it's enough."
    w shy "Ми пробалакали весь день і я все одно відчуваю, що цього недостатньо."

# game/script.rpy:2210
translate ukr ch4_e619d90e:

    # p ehe "I, uh... didn't really expect to be out this late either. It just kind of happened."
    p ehe "Я, ем... теж не очікував, що ми затримаємось на прогулянці до самого вечора. Якось так вийшло."

# game/script.rpy:2211
translate ukr ch4_c07a8df3:

    # w love "Mm... this was all supposed to be foreplay, wasn't it? Forgive me for putting it so bluntly..."
    w love "Мм... Це мало бути прелюдією, чи не так? Вибач, що говорю настільки прямо..."

# game/script.rpy:2212
translate ukr ch4_4ea0b52d:

    # p omg "Haha, um...! I-I guess it was...."
    p omg "Хаха, ем!.. Гадаю, що так...."

# game/script.rpy:2213
translate ukr ch4_296612b5:

    # w whine "Pastille, we have to get back to my place so I can fuck you..."
    w whine "Пастиле, ми маємо дістатись до мого дому, аби я міг тебе виїбати..."

# game/script.rpy:2214
translate ukr ch4_ceb4786b:

    # p dying "You really are being so blunt right now...!!" with vpunch
    p dying "Ти дійсно зараз занадто прямо говориш!!..." with vpunch

# game/script.rpy:2215
translate ukr ch4_1d319089:

    # w shy "We have to... it's the entire purpose of foreplay, isn't it? How could you have let it go on this long..."
    w shy "Ми маємо... в цьому ж і сенс прелюдії, чи не так? Як ти міг дозволити, аби вона настільки затягнулась..."

# game/script.rpy:2216
translate ukr ch4_05d161ca:

    # p wow "W-we could head back right now..?"
    p wow "М-ми можемо піти назад просто зараз?.."

# game/script.rpy:2217
translate ukr ch4_9efb4b57:

    # w "Yes."
    w "Так."

# game/script.rpy:2218
translate ukr ch4_5388d11a:

    # p wha "...Um, you're gonna have to stand up first...."
    p wha "...Ем, але тоді тобі треба піднятись...."

# game/script.rpy:2219
translate ukr ch4_fa1f26f3:

    # w "In a moment..."
    w "Зачекай секунду..."

# game/script.rpy:2222
translate ukr ch4_441f7fc6:

    # n "...But trapped in their comfortable position on that bench, Periwinkle is unable to stand in the end."
    n "...Але Барвінок настільки затишно відчував себе у цьому положенні, що так і не знайшов в собі сил піднятись на ноги."

# game/script.rpy:2223
translate ukr ch4_ba019848:

    # n "Instead, he falls asleep to the sounds of the fountain and Pastille's beating heart."
    n "Він заснув під шум фонтану та звуки биття серця Пастиля."

# game/script.rpy:2238
translate ukr ch5_7b49a2da:

    # centered "{w=3}{nw}"
    centered "{w=3}{nw}"

# game/script.rpy:2245
translate ukr ch5_105e757d:

    # n "Periwinkle wakes up in his bed the next morning... alone."
    n "Наступного ранку Барвінок прокидається у своєму ліжку... сам-самісінький."

# game/script.rpy:2246
translate ukr ch5_29523987:

    # w pj sleepy "Hmmn...? Pastille...?"
    w pj sleepy "Хмммн?.. Пастиле?.."

# game/script.rpy:2248
translate ukr ch5_77d65967:

    # "No response."
    "Відповіді немає."

# game/script.rpy:2249
translate ukr ch5_9cd6179c:

    # "No evidence of him either--none of his clothes laying about, no blankets out of place..."
    "І ніяких слідів того, що Пастиль тут був - ковдри та покривала лежать недоторканними, і його одягу ніде не видно..."

# game/script.rpy:2250
translate ukr ch5_0b1fd0ef:

    # "I'm wearing pajamas, though I don't remember changing into them."
    "Я у піжамі - але не пам'ятаю, аби я перевдягався."

# game/script.rpy:2251
translate ukr ch5_091a37c2:

    # nvl clear
    # w "(In fact, I don't remember coming home at all...)"
    nvl clear
    w "(Насправді, я навіть не пам'ятаю, як прийшов додому...)"

# game/script.rpy:2254
translate ukr ch5_8ab1a312:

    # w "(Did I.. fall asleep, then...?)"
    w "(Може, я... заснув?..)"

# game/script.rpy:2255
translate ukr ch5_a7d1b745:

    # w "(Hm... I vaguely remember being carried, but...)"
    w "(Хм... Здається, я пригадую, як мене несли, але...)"

# game/script.rpy:2257
translate ukr ch5_f3d5f1c1:

    # n "He pauses..."
    n "Він на секунду завмирає..."

# game/script.rpy:2258
translate ukr ch5_caac792a:

    # n "...and then suddenly throws the covers off himself and leaps from bed."
    n "...і потім різко скидує з себе ковдру і вискакує з ліжка."

# game/script.rpy:2260
translate ukr ch5_2eddeb17:

    # w pj shock "He truly isn't here?!"
    w pj shock "Його дійсно тут нема?!"

# game/script.rpy:2261
translate ukr ch5_57322f2e:

    # w conflicted "And he changed my clothes... was I conscious for that...? I-I..."
    w conflicted "Він перевдягнув мене... я взагалі тоді був у свідомості?.. Я-я..."

# game/script.rpy:2262
translate ukr ch5_ec8ea8b0:

    # w yell "I-I FELL ASLEEP BEFORE WE COULD FUCK?!?!??" with vpunch
    w yell "Я ЗАСНУВ ДО ТОГО, ЯК МИ ЗМОГЛИ ЗАЙНЯТИСЯ СЕКСОМ?!?!?!" with vpunch

# game/script.rpy:2264
translate ukr ch5_8f6d8542:

    # n "Periwinkle paces around his room, desperately running through the events of the previous night."
    n "Барвінок ходить по кімнаті взад-вперед, і у розпачі намагається пригадати події попередньої ночі."

# game/script.rpy:2265
translate ukr ch5_c9aacfa3:

    # w oops "We were on our way here. We stopped to rest. But it was so comfortable that I... I...."
    w oops "Ми йшли до мене додому і зупинились, аби трохи відпочити. Але там було так зручно, що я... я...."

# game/script.rpy:2267
translate ukr ch5_b207146a:

    # w insulted "Th-this is unheard of, this is... this is...!"
    w insulted "Ц-це просто нечувано, це... це!.."

# game/script.rpy:2269
translate ukr ch5_e25c95bc:

    # "...This is the first time something like this has ever happened."
    "...Це перший раз, коли зі мною трапилось щось подібне."

# game/script.rpy:2270
translate ukr ch5_515f7500:

    # "We had such a nice day together. The perfect date, really. It should have ended with a bang."
    "Ми провели разом багато часу, це був чудовий день. Насправді, це навіть можна назвати ідеальним побаченням. І ми всі розуміємо, чим воно мало закінчитись."

# game/script.rpy:2271
translate ukr ch5_c2f45725:

    # "Normally it would have...! We both very much wanted it to!"
    "Зазвичай все так і закінчувалось!.. Ми обидва цього дуже хотіли!"

# game/script.rpy:2272
translate ukr ch5_52e736fb:

    # "So how could I have let myself fall asleep like that...?"
    "І як я міг дозволити собі заснути?.."

# game/script.rpy:2273
translate ukr ch5_b080594f:

    # nvl clear
    # "No... there's no need to panic. I simply lost track of time."
    nvl clear
    "Ні... не треба панікувати. Я просто втратив почуття часу."

# game/script.rpy:2275
translate ukr ch5_e2d3f8d0:

    # "We had been walking around all day! Of course I would be worn out by the end of it."
    "Ми ходили цілий день! Звісно ж, що наприкінці дня я зовсім втомився."

# game/script.rpy:2276
translate ukr ch5_e0c669c7:

    # "I should've accounted for that. A simple mistake."
    "Треба було взяти це до уваги. Занадто банальна помилка."

# game/script.rpy:2277
translate ukr ch5_6a1541a5:

    # "One that completely nullified all the tension I had so gradually built up..."
    "До того ж, вона повністю знищила все напруження, яке я так старанно вибудовував..."

# game/script.rpy:2278
translate ukr ch5_cd4d0651:

    # nvl clear
    # "Had I gotten lost in the performance, then?"
    nvl clear
    "Може, я занадто сильно захопився цією виставою?"

# game/script.rpy:2280
translate ukr ch5_01fa644f:

    # "The romantic flourish, meant only to heighten the intensity of the passionate night to come..."
    "Цими романтичними жестами, метою яких було лише підігріти пристрасть перед тим, що станеться вночі?.."

# game/script.rpy:2281
translate ukr ch5_3bba54b6:

    # "It's roleplay. Pretend! The only thing genuine about it is the lust that it masks...!"
    "Це всього-навсього рольова гра. Це все - несправжнє! Єдине справжнє почуття - пристрасть, що прихована під цією мішурою!.."

# game/script.rpy:2282
translate ukr ch5_f851ccad:

    # "For me to have reached a point of satisfaction before the intended finale would mean..."
    "Якщо я досягнув піку задоволення до моменту, коли мав наступити запланований фінал, то це значить..."

# game/script.rpy:2283
translate ukr ch5_9a548114:

    # nvl clear
    # w ah "It was just... a legitimate, romantic date...."
    nvl clear
    w ah "Це було просто... звичайне, повноцінне романтичне побачення...."

# game/script.rpy:2287
translate ukr ch5_b590e6dd:

    # n "Periwinkle stops in his tracks. He turns back toward his bed and crawls under the covers, wrapping himself up in them."
    n "Барвінок різко зупиняється. Він повертається у сторону ліжка і потім заповзає під ковдри та покривала, загортаючись в них цілком."

# game/script.rpy:2289
translate ukr ch5_7e70b7d2:

    # "Have I ever... had one of those before?"
    "Чи були в мене коли-небудь такі побачення?.."

# game/script.rpy:2290
translate ukr ch5_4bff432d:

    # "I mean, I certainly don't expect EVERY date to end in a sexual encounter! Sometimes a partner just isn't ready, or something comes up--"
    "Звісно ж, я не очікую, що КОЖНА зустріч завершиться сексом! Іноді партнер просто не готовий, або трапляється ще щось, що ми не врахували..."

# game/script.rpy:2291
translate ukr ch5_bd728927:

    # "It isn't that sex was owed, no... it's that... we never even reached the bedroom."
    "І ніхто не зобов'язаний займатись сексом, і справа зовсім не в цьому... справа в тому... що ми навіть не дійшли до спальні."

# game/script.rpy:2292
translate ukr ch5_7530a326:

    # "That's...!"
    "Такого!.."

# game/script.rpy:2293
translate ukr ch5_83089348:

    # nvl clear
    # w wow "That's never happened..."
    nvl clear
    w wow "Такого ніколи не траплялося..."

# game/script.rpy:2296
translate ukr ch5_a01fc2da:

    # n "The thought sinks in. Periwinkle slowly unwraps himself from his blankets and sits up in bed."
    n "Барвінок починає розуміти значення цих слів. Він поступово вибирається з ковдр і сідає на ліжку."

# game/script.rpy:2299
translate ukr ch5_260c1a23:

    # "I'm overreacting."
    "Я занадто сильно реагую."

# game/script.rpy:2300
translate ukr ch5_846d8f9f:

    # "Yes, I'm merely embarrassed that I had to be carried home and tucked into bed! To be taken care of like that..."
    "Так, я просто присоромлений тим, що мене віднесли додому і поклали у ліжко! Тим, що про мене попіклувалися..."

# game/script.rpy:2301
translate ukr ch5_e6d59d32:

    # "Usually I'M the one who \"takes care of things\". Now I just feel ridiculous."
    "Зазвичай саме Я піклуюсь про когось і стежу за тим, аби все було в порядку. А зараз я відчуваю себе як дурень."

# game/script.rpy:2302
translate ukr ch5_09e225b0:

    # "...Something isn't right here. There has to be an explanation."
    "...Ні, щось точно не так. Цьому має бути якесь пояснення."

# game/script.rpy:2303
translate ukr ch5_1e2b4ab0:

    # nvl clear
    # "It's safe to admit, at this point, that I am very sensitive to matters that involve Pastille."
    nvl clear
    "Можна з упевненістю сказати, що на цьому етапі я більш чутливо ставлюсь до будь-яких речей, що пов'язані з Пастилем."

# game/script.rpy:2305
translate ukr ch5_b5938d01:

    # "But where did that begin? It couldn't have started just the other day."
    "Але коли це почалось? Це ж не могло з'явитись за один день."

# game/script.rpy:2306
translate ukr ch5_9a0782c3:

    # "Things were relatively normal--though I WAS seeing him quite often... moreso than other partners in the past...."
    "Все наче було так, як і зазвичай, хоча я бачився з ним доволі часто... частіше, ніж з іншими моїми партнерами...."

# game/script.rpy:2307
translate ukr ch5_1dab26c0:

    # "This has progressed too far beyond casual. What could have caused this...?"
    "Насправді, це вже зайшло далеко за межі випадкового зв'язку. Але що ж стало причиною?.."

# game/script.rpy:2308
translate ukr ch5_f4fa711c:

    # nvl clear
    # n "He thinks for a moment before walking out of his bedroom with purposeful strides."
    nvl clear
    n "Барвінок замислюється на мить і потім рішуче виходить зі спальні."

# game/script.rpy:2313
translate ukr ch5_fc2353d3:

    # n "Going immediately to the bookcase, he tosses a few things aside and pulls down the box of his favorite perfumes."
    n "Він одразу підходить до книжкової шафи, переставляє кілька речей в сторону і витягає коробку зі своїми улюбленими парфумами."

# game/script.rpy:2314
translate ukr ch5_345f2c6b:

    # n "He then carefully extracts the bottle filled with pale pink liquid..."
    n "Далі він обережно витягає пляшечку, наповнену блідо-рожевою рідиною."

# game/script.rpy:2316
translate ukr ch5_3b02742a:

    # w pj mad "You... you must be the culprit."
    w pj mad "Ти... ти в цьому винен."

# game/script.rpy:2318
translate ukr ch5_37fec35c:

    # "This aphrodisiac--no, love potion!"
    "Цей афродізіак - ні, любовне зілля!"

# game/script.rpy:2319
translate ukr ch5_75862705:

    # "I wanted to see Pastille's reaction when I called it that. An inconsequential little joke..."
    "Я просто хотів побачити реакцію Пастиля, коли назвав його так. Просто маленький несуттєвий жарт..."

# game/script.rpy:2320
translate ukr ch5_b39b1921:

    # "But it's kept coming up! There must be something to it."
    "Але його постійно згадували в розмовах! Це ж не може бути просто так."

# game/script.rpy:2321
translate ukr ch5_bf9a2bcf:

    # "Could the peach blossoms yesterday have further amplified its effects...?"
    "Чи могли квіти персика, які ми вчора бачили, ще більше посилити його дію?.."

# game/script.rpy:2322
translate ukr ch5_12edd207:

    # nvl clear
    # "Yes, it all makes sense now..."
    nvl clear
    "Так, тепер все встає на свої місця..."

# game/script.rpy:2324
translate ukr ch5_7765a051:

    # "Whether it be by my own magic, or some kind of chain reaction with Pastille's..."
    "Або своєю власною магією, або, можливо, якось реакцією з магією Пастиля..."

# game/script.rpy:2325
translate ukr ch5_e7c7b95a:

    # "I've somehow, unintentionally, created a scent that invokes romantic obsession in witches!"
    "Якимось чином я ненавмисно створив аромат, що спричиняє у відьом романтичну одержимість!"

# game/script.rpy:2326
translate ukr ch5_b3822351:

    # nvl clear
    # w my "There's research to be done! I have to put an end to these artificially-inspired feelings..."
    nvl clear
    w my "Треба провести дослідження! Я маю покласти кінець цим штучно створенним почуттям..."

# game/script.rpy:2329
translate ukr ch5_bfd8014c:

    # w aha "I-I'll create an anti-aphrodisiac, then! Something to cancel out its effects!"
    w aha "Я-я тоді створю анти-афродізіак! Щось, що зможе знищити цей ефект!"

# game/script.rpy:2330
translate ukr ch5_133fd5dc:

    # w innocent "At which point, everything will go back to normal...! There's no problem at all 💙"
    w innocent "І тоді все буде в порядку, як і раніше!.. Так що і ніякої проблеми нема 💙"

# game/script.rpy:2332
translate ukr ch5_0c5d4d1c:

    # n "Convinced by his new theory, Periwinkle dresses himself and heads out to find a solution..."
    n "Впевнений у своїй новій теорії, Барвінок одягається і відправляється на пошуки рішення..."

# game/script.rpy:2344
translate ukr ch5_63400f39:

    # "I head directly to the potion supply shop, just a few blocks away."
    "Я пішов одразу до магазинчику неподалік, де можна купити все, що необхідно для виготовлення зілля."

# game/script.rpy:2345
translate ukr ch5_7e87a103:

    # "It's brimming with reference materials, though I usually only come to purchase magic containers--the vials to hold my perfumes."
    "Зазвичай я приходжу сюди лише для того, аби купити контейнери для магії - флакони для моїх парфумів. Але тут можна знайти і купу різноманітних книжок та довідників."

# game/script.rpy:2346
translate ukr ch5_6aa36029:

    # "Navigating their shelves of spell manuals and encyclopedias, I find myself somewhat overwhelmed..."
    "Я починаю копатися серед полиць, що заповнені енциклопедіями заклять та різноманітними мануалами, і через деякий час відчуваю, як в мене голова йде обертом..."

# game/script.rpy:2347
translate ukr ch5_a61feed8:

    # "But soon, the shopkeeper comes to my aid."
    "Але через деякий час мені на допомогу приходить власниця магазину."

# game/script.rpy:2348
translate ukr ch5_76b2fe88:

    # nvl clear
    nvl clear

# game/script.rpy:2351
translate ukr ch5_7486fc1c:

    # r "Good afternoon, Periwinkle! And what might you be looking for today?"
    r "Доброго дня, Барвінку! І що ж ти сьогодні шукаєш?"

# game/script.rpy:2352
translate ukr ch5_c89d618d:

    # r wink "New bottles? A book? Or perhaps... ME? 💙"
    r wink "Нові пляшечки? Книгу? Або, може... МЕНЕ? 💙"

# game/script.rpy:2353
translate ukr ch5_682c05bf:

    # w happy "Amaretti~! It's lovely to see you, but I'm strictly here for business."
    w happy "Амареті!~ Приємно тебе бачити, але сьогодні я тебе відвідав виключно за справами."

# game/script.rpy:2354
translate ukr ch5_69e7637e:

    # r smirk "Playing the professional today, I see. Your loss~"
    r smirk "Бачу, сьогодні ти вирішив побути профі. Що ж, тобі ж гірше~"

# game/script.rpy:2356
translate ukr ch5_c467d8e2:

    # "Few witches have ever come close to my level of flirty energy, but Amaretti is one of them."
    "Лише декілька відьом можуть зрівнятися зі мною в мистецтві флірту, і Амареті - одна з них."

# game/script.rpy:2357
translate ukr ch5_1860b4ae:

    # "We may have fooled around at a party once or twice, but who's to say~?"
    "Ми вже пару разів порозважались разом на вечірках, але хто знає?~"

# game/script.rpy:2358
translate ukr ch5_3d07a8b4:

    # "As much as her company would be a welcome distraction, I'm afraid removing my self-inflicted curse takes priority."
    "Її компанія могла б чудово мене відволікти від проблем. Але все-таки прокляття, що я сам на себе навісив, зараз турбувало набагато більше."

# game/script.rpy:2359
translate ukr ch5_639cf832:

    # nvl clear
    # w calm "There IS actually something you can help me with..."
    nvl clear
    w calm "Насправді є ДЕЩО, з чим ти можеш мені трохи допомогти..."

# game/script.rpy:2362
translate ukr ch5_87508ba5:

    # w oh "But first, would you happen to know anything about aphrodisiacs?"
    w oh "Але спочатку скажи мені - чи знаєш ти щось про афродізіаки?"

# game/script.rpy:2363
translate ukr ch5_ada29de2:

    # r tell "Ahh, aphrodisiacs! Magic that sways the heart, stimulates the libido..."
    r tell "Ахх, афродізіаки! Магія, що запалює серця та стимулює лібідо..."

# game/script.rpy:2364
translate ukr ch5_78401cad:

    # r no "They DO end up being classified as dark magic because of the manipulative aspects, but..."
    r no "Їх почали класифікувати як темну магію через маніпулятивні аспекти використання, але..."

# game/script.rpy:2365
translate ukr ch5_aaa27385:

    # r wink "A few popular spellbooks happen to contain instructions for consensual usage. Is that what you'd be looking for?"
    r wink "В деяких популярних книгах є інструкції для використання за взаємною згодою. Ти це шукаєш?"

# game/script.rpy:2366
translate ukr ch5_f3b1d738:

    # w guilty "Yes--er, rather, assuming those books also contained instructions for CANCELLING the effects..."
    w guilty "Так- точніше, якщо ці книги також мають інструкції з того, як ВІДМІНИТИ їх дію..."

# game/script.rpy:2367
translate ukr ch5_b538f47c:

    # r think "Hmm...."
    r think "Хмм...."

# game/script.rpy:2368
translate ukr ch5_cf23c93b:

    # r smirk "Did something go wrong in the bedroom? You can tell me! Nothing to get embarrassed about~"
    r smirk "Щось пішло не так у спальні? Можеш розповісти мені! Нема чого соромитись~"

# game/script.rpy:2369
translate ukr ch5_1faa2750:

    # w oops "No, it's much more complicated than that..."
    w oops "Ні, це набагато складніше..."

# game/script.rpy:2370
translate ukr ch5_4eb2fa73:

    # w oh "Which spellbooks did you say I could find this information in? I'd like to look through them if possible."
    w oh "Так що ти казала про книги заклять, в яких можна про це почитати? Я би хотів їх переглянути, якщо можна."

# game/script.rpy:2371
translate ukr ch5_1e7e3e3d:

    # r think "Hmmmmmm......"
    r think "Хммммм......."

# game/script.rpy:2372
translate ukr ch5_c522ed48:

    # r smirk "You're lying to me, aren't you? You just wanna learn these spells to spice things up in the bedroom."
    r smirk "Дуриш мене, так? Ти просто хочеш вивчити ці закляття, аби зробити події у спальні гарячішими."

# game/script.rpy:2373
translate ukr ch5_d369f5be:

    # w pout "Not everything is related to sex, Amaretti."
    w pout "Не все в житті зводиться до сексу, Амареті."

# game/script.rpy:2374
translate ukr ch5_aa4f7e0f:

    # r think "Love, then...? No, you aren't the type...."
    r think "Тоді що, справа у коханні?.. Ні, на тебе це зовсім не схоже...."

# game/script.rpy:2375
translate ukr ch5_9a95397c:

    # r wink "Come on, why won't you just tell me? I can't help if you won't give up any details."
    r wink "Ну Барвінок, чому ти не можеш просто розповісти все як є? Без конкретики та деталей я тобі нічим не допоможу."

# game/script.rpy:2376
translate ukr ch5_779ec9fd:

    # w oops "All I want to know is whether or not aphrodisiac-induced feelings of romantic love can be nullified...! The details aren't important!"
    w oops "Я просто хочу знати, чи можна знищити романтичні почуття, викликані афродізіаком!.. Деталі тут ні до чого!"

# game/script.rpy:2377
translate ukr ch5_30630cc1:

    # r tell "So it IS love...! Hmmmm...... hm, hm, hm. Hmm!"
    r tell "Так все-таки це любов!.. Хмммм..... хм, хм, хм. Хмм!"

# game/script.rpy:2378
translate ukr ch5_07ba1235:

    # w insulted "(Why does she insist on wasting my time...?!)"
    w insulted "(Чому вона витрачає мій час і не може просто дати мені ці книги?!...)"

# game/script.rpy:2381
translate ukr ch5_bf1c9c82:

    # n "A large, resounding thud from down the aisle startles both Amaretti and Periwinkle."
    n "Раптом десь з проходу поміж стелажами лунає сильний та гучний удар, від якого Амареті та Барвінок різко здригаються."

# game/script.rpy:2382
translate ukr ch5_18274f1f:

    # n "The pair turns to see a much shorter witch standing there, fuming..."
    n "Пара обертається і бачить низьку відьму, що стоїть і роззлючено дивиться на них..."

# game/script.rpy:2384
translate ukr ch5_6dba0f24:

    # u "UGH...! If I have to listen to you two IGNORAMUSES babble on for another second, I am going to LOSE IT!!" with vpunch
    u "УГХ!.. Якщо я почую ще хоч одне слово від вас, двох невігласі, то просто збожеволію!!" with vpunch

# game/script.rpy:2385
translate ukr ch5_3ffaf986:

    # w ohdear "(There was another customer here...? How long have they been listening?)"
    w ohdear "(Тут були ще інші покупці?.. І як довго нас підслуховували?)"

# game/script.rpy:2386
translate ukr ch5_4e151ed3:

    # u "First off--stop conflating aphrodisiacs and love potions! They're ENTIRELY SEPARATE CATEGORIES!!"
    u "По-перше - ДОСИТЬ плутати афродізіаки і любовні зілля! Вони знаходяться В ДВОХ АБСОЛЮТНО РІЗНИХ КАТЕГОРІЯХ!!"

# game/script.rpy:2387
translate ukr ch5_8e0b52b2:

    # u "A witch who sells POTION SUPPLIES should at least know THAT much! You sell a whole book about it right here!!"
    u "І відьма, що продає ВСЕ ДЛЯ ВИГОТОВЛЕННЯ ЗІЛЛЯ, має хоча б це знати! У тебе ціла книжка на цю тему на продаж виставлена!!"

# game/script.rpy:2388
translate ukr ch5_32af5759:

    # n "She gestures to the thick tome she had slammed onto the floor at the beginning of her outburst."
    n "Вона показує на важкий том, який зі злості кинула на підлогу."

# game/script.rpy:2389
translate ukr ch5_190cea79:

    # r wink "So THAT'S the one I was thinking of...! You'll find everything you need to know about cancelling your love spell in there, Periwinkle."
    r wink "О, якраз про цю книгу я і думала!.. Барвінку, в цій книзі ти знайдеш все, що потрібно знати, аби відмінити твоє любовне закляття."

# game/script.rpy:2390
translate ukr ch5_f7c275b4:

    # u "NO!! YOU WON'T!!!" with vpunch
    u "НІ!! НЕ ЗНАЙДЕШ!!" with vpunch

# game/script.rpy:2391
translate ukr ch5_c74bb768:

    # r uhoh "He won't...?"
    r uhoh "Не знайде?.."

# game/script.rpy:2392
translate ukr ch5_9052ca3c:

    # u "Because it's not a freakin' ~love spell~ to begin with!"
    u "Давайте почнемо з того, що це не сране ~любовне закляття~!"

# game/script.rpy:2393
translate ukr ch5_304f62c3:

    # u "I find it MAAAAJORLY unlikely someone's been able to pull off a spell like that, when I've been trying for LITERALLY YEARS!!!!"
    u "Мені здається ДУУУУУЖЕ малоімовірним, що хтось просто взяв і його створив! Я РОКАМИ намагаюсь це зробити і все марно!!!!"

# game/script.rpy:2394
translate ukr ch5_b8b3bb86:

    # w happy "Ah... well, thank you! That certainly answers my question!"
    w happy "Ах... велике вам дякую! Це повністю відповідає на моє питання!"

# game/script.rpy:2395
translate ukr ch5_2897b47f:

    # w my "Since you're familiar with these things, I must ask--if not a love spell, could it have been a side effect of some OTHER type of magic?"
    w my "Здається, ви добре розбираєтесь в цій темі... Хочу запитати - якщо це не любовне закляття, чи може такий ефект виникнути як побічний від якогось іншого типу магії?"

# game/script.rpy:2396
translate ukr ch5_5d616ae4:

    # u "HA...! A side effect... you think it's so easy it could be tacked on, just like that?!"
    u "ХА!.. Побічний ефект... ти думаєш, що його можна так легко просто узяти і зверху пришпандьорити?!"

# game/script.rpy:2397
translate ukr ch5_01652a3d:

    # u "PLACEBO effect is more like it! In which case, all you'd need to do is stop thinking about it, and it'd go away! (Dumbass...)"
    u "Це скоріше ефект ПЛАЦЕБО! І якщо це він, то тобі просто треба припинити про це думати і все як рукою зніме! (Йолоп...)"

# game/script.rpy:2398
translate ukr ch5_a6530901:

    # w happy "Oh, really~? That saves me so much trouble! Thanks for the advice!"
    w happy "О, дійсно?~ Це позбавляє мене від клопоту! Дякую за пораду!"

# game/script.rpy:2399
translate ukr ch5_15e688b0:

    # u "H-HMPH...! If that shopkeeper woulda done her RESEARCH...."
    u "Х-ХМПФ!.. Якщо б ця продавчиня хоча б ЩОСЬ знала...."

# game/script.rpy:2401
translate ukr ch5_aa1f8b73:

    # n "The witch's angry shouts fade into placated mumbles as she storms out of the shop."
    n "Люті крики відьми затихають до незрозумілого бубоніння, коли вона вибігає геть з крамниці."

# game/script.rpy:2402
translate ukr ch5_977449e6:

    # r tell "...You handled that so well! You should work in retail."
    r tell "...Ти так добре впорався з цією ситуацією! Не думав піти працювати продавцем?"

# game/script.rpy:2403
translate ukr ch5_049f717f:

    # w calm "Oh, so I'M the one in need of a new career now...? After THAT exchange?"
    w calm "О, то тепер це МЕНІ потрібна нова робота...? Після всього, що зараз відбулося?"

# game/script.rpy:2405
translate ukr ch5_48d1f5c4:

    # n "Amaretti gives a nervous laugh and steps away to return the spellbook to its proper shelf."
    n "Амареті нервово сміється і відходить, аби повернути книгу заклять на її місце."

# game/script.rpy:2406
translate ukr ch5_c8f75af2:

    # n "After bidding her farewell, Periwinkle exits the store to begin his short walk home..."
    n "Барвінок прощається з нею і після цього виходить з магазину, аби піти додому..."

# game/script.rpy:2410
translate ukr ch5_c9fa2beb:

    # "A placebo... of course it was just a placebo~!"
    "Плацебо... звісно, це просто ефект плацебо!~"

# game/script.rpy:2411
translate ukr ch5_f8469479:

    # "I should've thought of it sooner. There was never any cause for alarm."
    "Я мав би і раніше до цього додуматись. Не було ніяких приводів для того, аби так тривожитись."

# game/script.rpy:2412
translate ukr ch5_8aca814e:

    # "This is just like before--it has nothing to do with Pastille. He just happens to be the one my mind is fixating on!"
    "Як і минулого разу, це не має ніякого відношення до Пастиля. Просто мій мозок на ньому фіксується, ось і все!"

# game/script.rpy:2413
translate ukr ch5_acc12d29:

    # "It's precisely as that temperamental little witch said: if I stop thinking about him, the problem will resolve on its own 💙"
    "Ця маленька темпераментна відьма все правильно сказала: якщо я припиню про нього думати, проблема вирішиться сама 💙"

# game/script.rpy:2414
translate ukr ch5_e74671f6:

    # nvl clear
    # "And so... I must take a few days to focus on myself!"
    nvl clear
    "І тому... мені потрібно кілька днів присвятити виключно собі!"

# game/script.rpy:2416
translate ukr ch5_b149db3c:

    # "At least until I can find my way out of this odd state I've ended up in...."
    "Поки я не позбавлюсь від цього дивного стану...."

# game/script.rpy:2417
translate ukr ch5_76b2fe88_1:

    # nvl clear
    nvl clear

# game/script.rpy:2424
translate ukr ch5_41374bae:

    # n "Operation \"Stop thinking about Pastille\"\nDay 1"
    n "Операція \"Припинити думати про Пастиля\"\nДень перший"

# game/script.rpy:2426
translate ukr ch5_78eaa119:

    # w calm "Let's see... the optimal distracting task would be..."
    w calm "Давайте подумаємо... яке заняття допоможе мені відволіктись..."

# game/script.rpy:2427
translate ukr ch5_e68a8deb:

    # w happy "Work, of course! Perhaps I could begin with the transforming aroma I thought of yesterday--"
    w happy "Звісно, робота! Напевно, я можу почати зі вчорашньої ідеї - аромату, який трансформується з часом..."

# game/script.rpy:2428
translate ukr ch5_0f9c3a34:

    # w ohdear "Ah, but that idea came about during our date... I should be avoiding any and all memories tied to him at the moment."
    w ohdear "Ах, але ця ідея прийшла під час нашого побачення... Зараз мені потрібно уникати будь-яких думок та спогадів, що пов'язані з Пастилем."

# game/script.rpy:2429
translate ukr ch5_592a73cd:

    # w oops "Hm... this may prove more difficult than I anticipated..."
    w oops "Хм... це може виявитись складнішим, ніж я думав..."

# game/script.rpy:2430
translate ukr ch5_fe203ad7:

    # w happy "No matter! I'll just warm up with a nice bergamot scent for now 💙"
    w happy "Але яка різниця! Для початку я створю приємний аромат бергамоту 💙"

# game/script.rpy:2434
translate ukr ch5_e1610e30:

    # n "Periwinkle retrieves a few empty vials from his box of perfume supplies, and readies his wand."
    n "Барвінок дістає кілька порожніх флакончиків з коробки і витягає свою паличку."

# game/script.rpy:2435
translate ukr ch5_04c3bf1e:

    # n "But instead of the bright green drops he expected, what comes out is a familiar pale pink..."
    n "Він очікував побачити яскраво-зелені краплинки, але з кінця палички витікає добре знайома блідо-рожева рідина..."

# game/script.rpy:2438
translate ukr ch5_f23df9f2:

    # w ohdear "Peach...? Aha, that isn't right at all...."
    w ohdear "Персик?.. Ага, зовсім не те...."

# game/script.rpy:2440
translate ukr ch5_f23f79a8:

    # n "He seals the bottle and moves on to the next..."
    n "Він закриває флакон і приймається за наступний..."

# game/script.rpy:2441
translate ukr ch5_9642d0ad:

    # n "...which, much to his dismay, yields the same result."
    n "...але, на превеликий жаль, результат залишається таким самим."

# game/script.rpy:2442
translate ukr ch5_f95e4a27:

    # w mad "...."
    w mad "...."

# game/script.rpy:2443
translate ukr ch5_5d25a848:

    # w oops "Okay. Magic is tied to emotions... I mustn't get frustrated. I have to focus."
    w oops "Гаразд. Магія дуже пов'язана з емоціями... Я не маю дратуватися чи впадати в тугу. Треба просто сфокусуватися."

# game/script.rpy:2444
translate ukr ch5_a5ede285:

    # w decline "Deep breaths. It never helps to force it... just imagine the desired scent, and...."
    w decline "Глибоке дихання. Змушувати себе силою ніколи не допомагало... просто уяви потрібний аромат, і...."

# game/script.rpy:2447
translate ukr ch5_a6226304:

    # n "He tries for a third time..."
    n "Він намагається в третій раз..."

# game/script.rpy:2448
translate ukr ch5_818ee6b1:

    # n "...and yet..."
    n "...але..."

# game/script.rpy:2451
translate ukr ch5_9250f26a:

    # w yell "Peach again?!" with vpunch
    w yell "Знову персик?!" with vpunch

# game/script.rpy:2452
translate ukr ch5_aec19f40:

    # w pout "This is a waste of supplies. So much for my attempt at diligence...!"
    w pout "Я просто марно витрачаю флакони. Ось вам і спроба побути працьовитим!.."

# game/script.rpy:2453
translate ukr ch5_2f58dc58:

    # w oops "If I can't conjure other scents, I'll have to find something else to occupy my time...."
    w oops "Якщо я не можу створювати інші аромати, то треба знайти якусь іншу справу, аби себе зайняти...."

# game/script.rpy:2454
translate ukr ch5_c94aab20:

    # w innocent "Ahh, housework! I can finally get some chores done around here~!"
    w innocent "Ах, точно, домашні справи! Нарешті я можу трохи тут прибратись!~"

# game/script.rpy:2455
translate ukr ch5_199d4349:

    # w aha "Nothing could possibly distract me from finishing them today... they ARE the distraction!"
    w aha "Сьогодні мене від прибирання цього безладу ніщо не зможе відволікти... лише він і відволікає!"

# game/script.rpy:2456
translate ukr ch5_db67403d:

    # w oh "Oh, that's right! I still had laundry to put away, didn't I?"
    w oh "Ох, точно! Мені ще треба скласти випрані речі, чи не так?"

# game/script.rpy:2459
translate ukr ch5_b6cfe690:

    # n "Periwinkle walks into his bedroom to face the pile of clothes he hadn't folded yet."
    n "Барвінок заходить у спальню, аби розібратись з купою одягу, який він досі не розклав по місцях."

# game/script.rpy:2460
translate ukr ch5_9af0cc6b:

    # w guilty "Whenever I tell myself I'll get to it later, I tend to leave it for days...."
    w guilty "Кожного разу після прання я залишаю одяг, аби розібратись з ним пізніше, і руки в мене до цього так і не доходять...."

# game/script.rpy:2461
translate ukr ch5_7561ad39:

    # n "But the single large pile he expected wasn't there. Instead, it was split in two, with one half already neatly folded..."
    n "Але великої купи речей, яку він очікував побачити, тут не було. Вона була розділена на дві купки поменше, і в одній з них одяг вже був старанно складений..."

# game/script.rpy:2462
translate ukr ch5_7ae4391f:

    # w my "Ah... I don't remember making this much progress...."
    w my "А... Не пам'ятаю, аби я це робив..."

# game/script.rpy:2463
translate ukr ch5_8e27678f:

    # w insulted "N-no...! Pastille did this, didn't he?! When he came to pick me up yesterday!!" with vpunch
    w insulted "Н-ні!.. Пастиль це зробив, чи не так?! Тоді, коли він прийшов за мною вчора!!" with vpunch

# game/script.rpy:2464
translate ukr ch5_ebbaaa9d:

    # w oops "Curses... he's too good! I can't touch this right now...!"
    w oops "Чорт забирай... в нього це занадто добре виходить!.. Займатись цим я зараз не буду!.."

# game/script.rpy:2465
translate ukr ch5_fabf3693:

    # n "Periwinkle covers the pile of neatly folded clothes with the rest of the unfolded ones in retaliation."
    n "Барвінок накриває купу старанного складеного одягу нерозібраними речами."

# game/script.rpy:2466
translate ukr ch5_7f95d5c9:

    # w aha "There. One less reminder to worry about."
    w aha "Ось так. Чого очі не бачать, того серцю не жаль. І одним нагадуванням менше."

# game/script.rpy:2467
translate ukr ch5_6d9815d8:

    # w decline "Now I'm going to have to think of something else to do...."
    w decline "Тепер мені доведеться вигадати якесь інше заняття...."

# game/script.rpy:2472
translate ukr ch5_99c1ff41:

    # "So far, my attempts at forgetting about Pastille have been completely futile."
    "Поки що мої спроби забути про Пастиля виявились абсолютно марними."

# game/script.rpy:2473
translate ukr ch5_80ef4d03:

    # "But that's perfectly fine...! No one said it was going to be easy."
    "Але все в порядку!.. Ніхто і не казав, що буде легко."

# game/script.rpy:2474
translate ukr ch5_9c18fb74:

    # "Ironically, the more you tell yourself NOT to think of something, the more your mind will be enticed by it...."
    "Іронічно, що чим більше ти намагаєшся не думати про щось, тим більше ти будеш думати саме про це...."

# game/script.rpy:2475
translate ukr ch5_896a9911:

    # nvl clear
    # "I mustn't let this consume me. I have to find a way to relax."
    nvl clear
    "Я не можу дозволити цим думкам поглинути мене. Треба знайти спосіб розслабитись."

# game/script.rpy:2477
translate ukr ch5_67f5662b:

    # "A nice bath should help to calm my nerves..."
    "Гадаю, якщо я прийму ванну, то мені стане легше..."

# game/script.rpy:2478
translate ukr ch5_76b2fe88_2:

    # nvl clear
    nvl clear

# game/script.rpy:2483
translate ukr ch5_142a3147:

    # n "Later that evening..."
    n "Пізніше цього ж вечора..."

# game/script.rpy:2485
translate ukr ch5_b084a8a3:

    # w shutin happy "I'm feeling so refreshed, I could do just about anything~!"
    w shutin happy "Я відчуваю себе так бадьоро! Здається, тепер я можу робити все, що завгодно!~"

# game/script.rpy:2486
translate ukr ch5_bfecbb7d:

    # w smile "I should try cooking for myself tonight... Now THERE'S a task that'll require my full attention!"
    w smile "Спробую приготувати собі поїсти самостійно... Для цієї задачі мені буде потрібна вся моя увага та концентрація!"

# game/script.rpy:2487
translate ukr ch5_5e931d21:

    # n "Periwinkle opens up the fridge for ideas..."
    n "Барвінок відкриває холодильник..."

# game/script.rpy:2488
translate ukr ch5_eb1a4107:

    # w oh "A pint of milk. A few cups of yogurt, some eggs, whipped cream..."
    w oh "Пінта молока. Кілька стаканчиків йогурту, кілька яєць, взбиті вершки..."

# game/script.rpy:2489
translate ukr ch5_a167090a:

    # w pout "There isn't much in the way of meals, is there? This is why I never cook..."
    w pout "Не дуже-то й багатий набір продуктів. Ось чому я ніколи не готую..."

# game/script.rpy:2490
translate ukr ch5_c2f55194:

    # w happy "Ah, but I could try making an omelet! Breakfast for dinner~ oh, what fun~"
    w happy "Ах, але я можу спробувати зробити омлет! Сніданок на вечерю, як кумедно~"

# game/script.rpy:2493
translate ukr ch5_b1019ee6:

    # n "Periwinkle cheerfully reaches for the eggs, then pauses."
    n "Барвінок протягає руку, аби взяти яйця, але зупиняється."

# game/script.rpy:2494
translate ukr ch5_9393331d:

    # w shutin oh "...Actually. Can I cook without magic...?"
    w shutin oh "...Хоча. Чи зможу я приготувати щось без використання магії?.."

# game/script.rpy:2495
translate ukr ch5_94dffac0:

    # n "He turns to face the stove."
    n "Він повертає голову, аби поглянути на пічку."

# game/script.rpy:2496
translate ukr ch5_d5bc20eb:

    # w neutral "This burner... is the kind you'd light with a spell."
    w neutral "Ця конфорка... вогонь можна розпалити лише за допомогою закляття."

# game/script.rpy:2497
translate ukr ch5_5df0ebaf:

    # w oops "I'm far too nervous my magic is going to come out smelling of peaches again..."
    w oops "Я занадто переймаюсь через те, що моя магія знову може запахнути персиками..."

# game/script.rpy:2498
translate ukr ch5_f95e4a27_1:

    # w mad "...."
    w mad "...."

# game/script.rpy:2499
translate ukr ch5_98438b48:

    # n "Periwinkle slams the fridge shut."
    n "Барвінок с силою захлопує дверцята холодильника."

# game/script.rpy:2500
translate ukr ch5_04db34f2:

    # w innocent "Forget cooking! What was I thinking~? I'm not cut out to be a chef 💙"
    w innocent "Забудемо про це! І про що я взагалі думав?~ Я народжений не для того, аби бути шефом 💙"

# game/script.rpy:2501
translate ukr ch5_ce61890c:

    # w "(Pastille on the other hand...)"
    w "(З іншого боку, Пастиль...)"

# game/script.rpy:2502
translate ukr ch5_72f902e5:

    # w oops "No, no, no...! Thinking of him in this delightful domestic context is ESPECIALLY banned!"
    w oops "Ні, ні, ні!.. Думати про нього в таких затишному, домашньому контексті особливо ЗАБОРОНЕНО!"

# game/script.rpy:2503
translate ukr ch5_fdc8fc60:

    # w whine "No matter how much I want to eat his cooking now...! He's obviously the type to be good at it...!"
    w whine "І що з того, що я хочу прямо зараз з'їсти щось, що він приготував!.. Він, звісно ж, відноситься до типу людей, що гарно куховарять!.."

# game/script.rpy:2504
translate ukr ch5_cba66395:

    # w neutral "...."
    w neutral "...."

# game/script.rpy:2505
translate ukr ch5_351d08ce:

    # w empty "Ahh, this is depressing... I'm already right back to where I started."
    w empty "Ахх, це так пригнічує... Я повернувся до того, з чого і почав."

# game/script.rpy:2506
translate ukr ch5_9f77ed17:

    # w sleepy "*sigh* I'll just order takeout...."
    w sleepy "*позіхає* Просто замовлю доставку...."

# game/script.rpy:2509
translate ukr ch5_0cc969eb:

    # n "Periwinkle goes to bed that night utterly incapable of forgetting about Pastille."
    n "Барвінок відправляється у ліжко, повністю неспроможний забути про Пастиля."

# game/script.rpy:2515
translate ukr ch5_9d3aad6a:

    # n "Operation \"SERIOUSLY, do not think about that boy!\" - Day 2"
    n "Операція \"СЕРЙОЗНО, не думай про цього хлопця!\" - День другий"

# game/script.rpy:2516
translate ukr ch5_3e78daf8:

    # "I've tried working... I've tried doing chores... I've even tried to cook! All miserable failures."
    "Я намагався працювати... Я намагався прибирати... Я навіть намагався готувати! І нічого з цього не вийшло."

# game/script.rpy:2517
translate ukr ch5_cd9bef67:

    # "That's why, today, I'm taking drastic measures: complete escapism!"
    "Саме тому сьогодні я вживаю радикальні заходи: повний ескапізм!"

# game/script.rpy:2518
translate ukr ch5_5895572f:

    # "I'm returning to my roots. I'll reread one of my favorite series! If nothing else, it should make a nice source of inspiration..."
    "Я повернусь до свого коріння і перечитаю якусь з моїх улюблених серій! Це може послужити гарним джерелом натхнення..."

# game/script.rpy:2519
translate ukr ch5_7c3c5f99:

    # nvl clear
    # n "Periwinkle pulls out volume one of a certain manga from his bookshelf."
    nvl clear
    n "Барвінок дістає з книжкової полички томик манґи."

# game/script.rpy:2523
translate ukr ch5_c39703ae:

    # w shutin happy "\"Fabric of our Love\"! How many years has it been~?"
    w shutin happy "\"Матерія нашої любові\"! Скільки ж років пройшло?~"

# game/script.rpy:2524
translate ukr ch5_45eda1a9:

    # w love "The dresses were always drawn so beautifully in this series... I still think of them from time to time."
    w love "Всі плаття у цій манзі настільки гарно намальовані... Я досі їх згадую час від часу."

# game/script.rpy:2527
translate ukr ch5_4ce77425:

    # "It's the story of a girl who's fallen for a handsome prince 💙 Standard fare for the types of manga I read."
    "Це історія про дівчину, що закохалась у прекрасного принца 💙 Доволі стандартний сюжет для тих жанрів, які я зазвичай читаю."

# game/script.rpy:2528
translate ukr ch5_c86d4767:

    # "Her mother is a talented seamstress who designs all sorts of dazzling gowns for her to wear... and when the prince sees her in one, he becomes smitten with her!"
    "Мати головної героїні - талановита швачка, що створює різноманітні плаття для своєї коханої доньки... і коли принц бачить її у одному з них, то негайно закохується!"

# game/script.rpy:2529
translate ukr ch5_1a90caff:

    # nvl clear
    # "At first, she's in heaven! This is the prince of her dreams~!"
    nvl clear
    "Спочатку вона землі під собою не відчувала! Це ж принц з її мрій!~"

# game/script.rpy:2531
translate ukr ch5_ebf04359:

    # "But she soon wonders if the prince is only attracted to the dresses, the glamour... and not the poor girl underneath."
    "Але потім вона замислюється - може, принцу подобаються лише плаття та романтичний ореол, який вони створюють... а не бідолашна дівчина, що їх носить."

# game/script.rpy:2532
translate ukr ch5_bbca257f:

    # "Until the prince reveals... ah, I shouldn't spoil it! 💙 The ending is too sweet~!"
    "І поки принц не... ах, я не маю розкривати деталі! 💙 Кінець неймовірно милий!~"

# game/script.rpy:2533
translate ukr ch5_8ea6ec16:

    # nvl clear
    # n "After admiring the cover art for a while, Periwinkle finally opens the book and begins to read."
    nvl clear
    n "Барвінок деякий час милується малюнком на обкладинці, після чого нарешті відкриває книжку та починає читати."

# game/script.rpy:2537
translate ukr ch5_558ae81a:

    # w shutin love "Just as lovely as I remember... such delicate linework...."
    w shutin love "Так само прекрасно намальовані, як я і пам'ятаю... такі майстерні лінії...."

# game/script.rpy:2538
translate ukr ch5_c6240c65:

    # w calm "I wouldn't blame that prince for noticing the dresses before the girl. They really are so beautiful."
    w calm "Важко звинувачувати принца в тому, що він спочатку звернув увагу не на дівчину, а на плаття. Вони дійсно чарівні."

# game/script.rpy:2539
translate ukr ch5_63862a4b:

    # w oh "Come to think of it, the way this prince is drawn..."
    w oh "До речі, якщо подумати, то те, як намальований принц..."

# game/script.rpy:2540
translate ukr ch5_130cf072:

    # w "His short, fluffy hair, his gentle features... remind me of..."
    w "Його коротке, пухнасте волосся, його ніжні риси обличчя... нагадують мені..."

# game/script.rpy:2543
translate ukr ch5_6e0c6c75:

    # n "Periwinkle closes the book in a panic."
    n "Барвінок у паніці закриває книжку."

# game/script.rpy:2545
translate ukr ch5_30eaa72d:

    # w shutin mad "That was dangerous. I can't risk even thinking his name...!"
    w shutin mad "Це було дуже небезпечно. Я не можу ризикувати і навіть думати про його ім'я!.."

# game/script.rpy:2546
translate ukr ch5_f09961e7:

    # w whine "Ahh, and there's even a later chapter where he's dressed in servants' clothing! There are too many parallels...!"
    w whine "Ахх, а пізніше ще буде розділ, де він носить одяг слуги! Занадто багато паралелей!.."

# game/script.rpy:2547
translate ukr ch5_41e8eb06:

    # n "Periwinkle rolls across his bed and slides the book back into its place on his shelf."
    n "Барвінок перекочується на іншу сторону ліжка і ставить книжку назад на її місце."

# game/script.rpy:2548
translate ukr ch5_5b74eeff:

    # w pout "This isn't fair... how can one of my most beloved series be off-limits in my time of need...?"
    w pout "Це нечесно... чому моя улюблена історія мені протипоказана саме тоді, коли я найбільше її потребую?.."

# game/script.rpy:2549
translate ukr ch5_8b1d5778:

    # n "He scans through the different titles once more, before landing on a 12-volume series..."
    n "Він передивляється різні назви ще раз, поки не зупиняє погляд на серії з 12 томів..."

# game/script.rpy:2551
translate ukr ch5_f3715939:

    # w neutral "I don't remember this one as clearly... but as an all-girls story, it should be safe...."
    w neutral "Я не дуже добре пам'ятаю, який там сюжет... але всі персонажі там - дівчата, так що, гадаю, я у безпеці..."

# game/script.rpy:2553
translate ukr ch5_57ab056b:

    # n "Periwinkle pulls the new book from his shelf, and quietly immerses himself in its fictional world..."
    n "Барвінок бере нову книжку з полички і швидко поринає у вигаданий світ..."

# game/script.rpy:2557
translate ukr ch5_0630a164:

    # "Before I knew it, I'd finished reading all 12 volumes. The whole day had flown right by."
    "Якимось чином я і не помітив, як прочитав всі 12 томів. Цілий день просто пройшов повз."

# game/script.rpy:2558
translate ukr ch5_7bca8e7b:

    # "I couldn't help but keep turning the pages... the story was so much more than I remembered!"
    "Я просто не міг відірватися... історія виявилась набагато цікавішою, ніж я пам'ятав!"

# game/script.rpy:2559
translate ukr ch5_34844c79:

    # "The protagonist was nothing to write home about, but her childhood friend? Ah, what a moving character arc...!"
    "Про головну героїню мало що можна сказати, але її подруга дитинства? Ах, в неї був настільки потужний розвиток!.."

# game/script.rpy:2560
translate ukr ch5_33580eee:

    # nvl clear
    # "She's very charismatic from the start. The kind of person you'd think has it all figured out... but you couldn't be more wrong!"
    nvl clear
    "Вона з самого початку була дуже харизматичною. Такі люди зазвичай виглядають так, наче повністю розібралися в собі та житті... але у цьому випадку це зовсім не так!"

# game/script.rpy:2562
translate ukr ch5_49da7a6c:

    # "Over the course of the series, she goes through so many love interests... back in the day, I had assumed it was because the author couldn't make up their mind!"
    "По сюжету в неї з'являється багато романтичних інтересів... колись я думав, що манґака просто не знала, на кому зупинити вибір!"

# game/script.rpy:2563
translate ukr ch5_e0af319b:

    # nvl clear
    # "But reading it all at once, it must've been planned from the beginning... these doomed relationships are merely self-sabotage! A distraction from pursuing her one true love!"
    nvl clear
    "Але зараз, коли я перечитав, то усвідомлюю, що так було заплановано з самого початку... ці приречені відносини були просто самосаботажем! Вона намалась відволікти себе і не слідувати за своїм справжнім коханням!"

# game/script.rpy:2565
translate ukr ch5_9828e662:

    # "She never realizes the obvious answer until the very end...! And what an emotional finale!"
    "Вона не розуміла нічого до самого кінця, хоча відповідь лежала на поверхні!.. І яким емоційним був фінал!"

# game/script.rpy:2566
translate ukr ch5_967fea48:

    # "When she finally confesses, and the two girls share their first kiss...!"
    "Коли вона нарешті зізналась у коханні, і дві дівчини вперше поцілувалися!.."

# game/script.rpy:2567
translate ukr ch5_a29c652c:

    # nvl clear
    # w shutin love "Ah~! The fireworks!! Could anything be more romantic?!" with vpunch
    nvl clear
    w shutin love "Ах!~ Фейерверки!! Що може бути більш романтичним?!" with vpunch

# game/script.rpy:2570
translate ukr ch5_bf1c8f6a:

    # w happy "Her tears of happiness...! Finally being honest with herself, and with her best friend...! How lovely!"
    w happy "І її сльози щастя!.. І те, як вона нарешті була відвертою з собою та своєю кращою подругою!.. Як мило!"

# game/script.rpy:2571
translate ukr ch5_bab1bf08:

    # w calm "The well of loneliness that is her character was portrayed so flawlessly... she's the most real of them all."
    w calm "Її особистість - неначе колодязь, що заповнений самотністю, і він був прописан настільки бездоганно... вона відчувається найбільш реальною з усіх персонажів."

# game/script.rpy:2572
translate ukr ch5_3c397fdf:

    # w love "Ending the story any other way would've been an injustice. She deserves the world...!"
    w love "Закінчити цю історію якось інакше було б несправедливо. Вона заслуговує тільки всього найкращого!.."

# game/script.rpy:2573
translate ukr ch5_4f0b1bd8:

    # w oh "Hmm... I own this author's follow-up series as well, don't I...?"
    w oh "Хмм... Здається, в мене є і наступна манґа від цієї манґаки, так?.."

# game/script.rpy:2574
translate ukr ch5_7b7b7eff:

    # w happy "Time to get some snacks and start searching for it 💙 I can't resist diving in right away~!"
    w happy "Треба узяти щось, аби перекусити, і її відшукати 💙 Не можу встояти перед тим, аби не почати читати просто зараз!~"

# game/script.rpy:2578
translate ukr ch5_e43c6f26:

    # n "Operation \"Escape reality\" - Day 3"
    n "Операція \"Втекти з реальності\" - День третій"

# game/script.rpy:2579
translate ukr ch5_f8a47392:

    # n "Periwinkle continued to read..."
    n "Барвінок продовжував читати..."

# game/script.rpy:2583
translate ukr ch5_18ee21a7:

    # n "...and read..."
    n "...і читати..."

# game/script.rpy:2587
translate ukr ch5_577f25be:

    # n "...and read."
    n "...і читати."

# game/script.rpy:2589
translate ukr ch5_6b9ceb2b:

    # n "Until he heard a knock at his door."
    n "Аж поки він не почув стук у двері."

# game/script.rpy:2591
translate ukr ch5_eb6b9ef1:

    # w shutin oh "(Pastille...? No, that isn't his knock.)"
    w shutin oh "(Пастиль?.. Ні, він так не стукає.)"

# game/script.rpy:2592
translate ukr ch5_add831c5:

    # w oops "(Ah, wait--I was trying to forget about him!)"
    w oops "(Ах, зачекайте- я намагався про нього забути!)"

# game/script.rpy:2593
translate ukr ch5_49e273c0:

    # w oh "(Though I suppose it means I was successful for a while... I even forgot that I was avoiding something to begin with....)"
    w oh "(Хоча, гадаю, якийсь час мені це успішно вдавалося... Я навіть забув, що взагалі уникав думок про щось....)"

# game/script.rpy:2599
translate ukr ch5_3fd120b3:

    # n "When he opens the door, Periwinkle is greeted by a small crowd of friends and acquaintances."
    n "Барвінок відкриває двері і на порозі його зустрічає невеличка група друзів та знайомих."

# game/script.rpy:2602
translate ukr ch5_24c4f6ca:

    # h "Periwinkle~! Get dressed, we're hitting the clubs!"
    h "Барвінку!~ Вдягайся, ми відправляємось по клубах!"

# game/script.rpy:2603
translate ukr ch5_2c561f37:

    # w shutin happy "Wow~ the whole cavalry's arrived!"
    w shutin happy "Вау~ ви всі зібралися!"

# game/script.rpy:2604
translate ukr ch5_ccfacf58:

    # w love "Unfortunately, I'm going to have to decline... tonight isn't going to work for me."
    w love "На жаль, я змушений відмовитись... сьогодні в мене не виходить вибратись."

# game/script.rpy:2605
translate ukr ch5_0c4017c9:

    # h "Whaaat~?! But no one's seen you in AGES! You haven't abandoned us for a new scene, have you?"
    h "Щоооо?!~ Але тебе вже ТАК ДАВНО ніхто не бачив! Ти ж не кинув нас напризволяще, так?"

# game/script.rpy:2606
translate ukr ch5_547f416c:

    # w guilty "Oh, nothing like that... I've just been a little preoccupied. I'm taking some time to myself at the moment."
    w guilty "Ні, нічого такого... я просто був дещо зайнятий. А зараз вирішив приділити час собі."

# game/script.rpy:2607
translate ukr ch5_1bc1c398:

    # h "Nothing wrong with a little self-care, but... are you suuure you don't wanna come out and enjoy the night life?"
    h "Піклуватися про себе - круто, але... ти тооочно впевнений, що не хочеш піти з нами і приємно провести ніч?"

# game/script.rpy:2608
translate ukr ch5_e857923b:

    # w love "Ahh, I don't know... I've fallen so far behind on my work."
    w love "Ахх, я не знаю... Я ще й роботою завалений по самі вуха."

# game/script.rpy:2609
translate ukr ch5_87ce4ec9:

    # h "Choosing work over getting laid? Now I KNOW something's up with you!"
    h "І між сексом і роботою ти обираєш роботу? Тепер ТОЧНО зрозуміло, що з тобою щось не те!"

# game/script.rpy:2610
translate ukr ch5_7d59c83b:

    # w happy "How offensive~! I have more going on than just going out and flirting with everyone I meet!"
    w happy "Яке неподобство!~ Я же не тільки фліртую з усіма, хто попадеться, в мене набагато більше сторін!"

# game/script.rpy:2611
translate ukr ch5_c159c59e:

    # h "Haahaha! Of course, of course~!"
    h "Хахаха! Звісно, звісно!~"

# game/script.rpy:2612
translate ukr ch5_87163668:

    # w calm "I do appreciate the invitation, though. Thank you for thinking of me."
    w calm "Але я дійсно ціную ваше запрошення. Дякую, що згадали про мене."

# game/script.rpy:2613
translate ukr ch5_d75fa27b:

    # h "We just had to come and make sure you were still alive. The clubs are lonely without you~!"
    h "Ми ж мали перевірити, чи ти ще живий, чи що з тобою. Клуби без тебе - зовсім не те!~"

# game/script.rpy:2614
translate ukr ch5_5fa75dc3:

    # w happy "I'll have to make my grand return some other time, then. Have a lovely evening~!"
    w happy "Я урочисто повернуся, але якось іншим разом. Гарного вечора!~"

# game/script.rpy:2617
translate ukr ch5_84d367b4:

    # n "The group waves goodbye and disappears into the night..."
    n "Група прощається з ним і йде у ніч..."

# game/script.rpy:2621
translate ukr ch5_1fb460c7:

    # w shutin calm "Hmhm... it's been a while since I've had to turn them down...."
    w shutin calm "Хмхм... Давно я їм не відмовляв...."

# game/script.rpy:2622
translate ukr ch5_bd0d5988:

    # n "Periwinkle leans his back against the door and sighs."
    n "Барвінок притуляється спиною до дверей та позіхає."

# game/script.rpy:2624
translate ukr ch5_a96c004e:

    # "I'm definitely not in any state to go clubbing right now."
    "Я не у тому стані, аби йти до якихось клубів."

# game/script.rpy:2625
translate ukr ch5_8fa632dc:

    # "No matter how much it warms my heart to know that I am missed, I won't be making the same mistake as the other night!"
    "Звісно, моє серце гріє думка, що мої приятелі за мною сумують, але я не буду повторювати своїх помилок!"

# game/script.rpy:2626
translate ukr ch5_ab8d7c49:

    # "I can't go recklessly diving into the comforting arms of another as long as my mind is still hung up on Pastille..."
    "Я не можу стрімголов кидатися в обійми іншого, поки думками все ще чіпляюсь за Пастиля..."

# game/script.rpy:2627
translate ukr ch5_31e9e456:

    # nvl clear
    # "But how long will I remain in this state?"
    nvl clear
    "Але як довго я ще буду у такому стані?"

# game/script.rpy:2629
translate ukr ch5_87296cd0:

    # "Shutting myself away, binge-reading comics..."
    "Я заперся в домі, ізолювався від усіх і без перерви читаю комікси..."

# game/script.rpy:2630
translate ukr ch5_6ab20be7:

    # "These were emergency measures. I can't avoid the outside world forever."
    "Але це екстрені заходи. Я не можу постійно уникати контакту з зовнішнім світом."

# game/script.rpy:2631
translate ukr ch5_091fa9e2:

    # nvl clear
    # "In any case, shouldn't Pastille be returning here at some point?"
    nvl clear
    "І в будь-якому випадку, хіба Пастиль не повернеться сюди рано чи пізно?"

# game/script.rpy:2633
translate ukr ch5_ee826e83:

    # "From where we left off, I'd have expected him to come knocking as soon as possible!"
    "Враховуючи те, на якому місці ми зупинились, я думав, що він прийде якнайшвидше!"

# game/script.rpy:2634
translate ukr ch5_16870329:

    # "And yet... it's been three full days now, hasn't it?"
    "І тим не менш... пройшло вже цілих три дні, чи не так?"

# game/script.rpy:2635
translate ukr ch5_efc836eb:

    # "How long could he possibly abstain from my touch! Or is something wrong...?"
    "Як довго він може утримуватися від моїх дотиків! Чи щось сталося?.."

# game/script.rpy:2636
translate ukr ch5_282afc69:

    # nvl clear
    # "I shouldn't be thinking about any of this... but I'm beginning to feel..."
    nvl clear
    "Я не маю думати про це... але я починаю відчувати..."

# game/script.rpy:2638
translate ukr ch5_bb1c3e4d:

    # "Annoyed? Confused...?"
    "Роздратованість? Збентеженість?.."

# game/script.rpy:2639
translate ukr ch5_82208e45:

    # nvl clear
    # w shutin conflicted "(If he never comes back, I suppose my problem would go away on its own...)"
    nvl clear
    w shutin conflicted "(Якщо він ніколи не повернеться, то, гадаю, мої проблеми самі пропадуть...)"

# game/script.rpy:2642
translate ukr ch5_7082d627:

    # w oops "(But I hate the thought of that. As things are now, I'd only be haunted by thoughts of what I could've possibly done wrong.)"
    w oops "(Але я навіть думати про таке не хочу. Бо в такому випадку я все життя буду намагатися зрозуміти, що ж саме я не так зробив.)"

# game/script.rpy:2643
translate ukr ch5_6a2ef4f7:

    # w empty "(What IS my plan, then? Continue to ping-pong back and forth between these extreme emotional states?)"
    w empty "(І який тоді в мене план? Продовжувати стрибати туди-сюди між цими емоційними крайнощами, наче м'ячик?)"

# game/script.rpy:2644
translate ukr ch5_eba87ac9:

    # n "He rubs his eyes in exhaustion."
    n "Він втомлено потирає очі."

# game/script.rpy:2645
translate ukr ch5_e4efba8a:

    # w sleepy "...I'll worry about this tomorrow...."
    w sleepy "...Подумаю про це завтра...."

# game/script.rpy:2647
translate ukr ch5_4025cec7:

    # n "Periwinkle steps back into his room and tucks himself into bed with his books..."
    n "Барвінок повертається до себе в кімнату, влаштовується позручніше і знову приймається за книги..."

# game/script.rpy:2653
translate ukr ch5_9fbba0e4:

    # n "But an hour later... another knock comes."
    n "Але через годину... хтось знову стучить у двері."

# game/script.rpy:2654
translate ukr ch5_48a3bbb2:

    # n "This time, the pattern is unmistakable."
    n "Цей ритм неможливо переплутати з якимось іншим."

# game/script.rpy:2655
translate ukr ch5_5b483588:

    # w shutin ah "(Pastille is here....)"
    w shutin ah "(Пастиль тут....)"

# game/script.rpy:2657
translate ukr ch5_5a00cde9:

    # "Well, well, well..."
    "Що ж, що ж..."

# game/script.rpy:2658
translate ukr ch5_5f55459f:

    # "So he's come after all."
    "Все-таки він прийшов."

# game/script.rpy:2659
translate ukr ch5_16205056:

    # nvl clear
    # "Despite all my hard work of trying to forget..."
    nvl clear
    "Незважаючи на те, скільки зусиль я доклав, аби забути його..."

# game/script.rpy:2661
translate ukr ch5_5eb7e5c9:

    # "I've actually been waiting for this moment, haven't I?"
    "Я насправді чекав цього моменту, чи не так?"

# game/script.rpy:2662
translate ukr ch5_b9f40f3e:

    # "I don't care what these feelings might mean anymore. I'm tired of fighting them."
    "Я втомився думати про те, що можуть означати ці почуття, і втомився з ними боротися."

# game/script.rpy:2663
translate ukr ch5_83d0f4c7:

    # "I... just want Pastille."
    "Я... просто хочу Пастиля."

# game/script.rpy:2664
translate ukr ch5_76b2fe88_3:

    # nvl clear
    nvl clear

# game/script.rpy:2668
translate ukr ch5_ee017070:

    # n "He opens the door, and sure enough, Pastille is the one he finds standing there."
    n "Він відкриває двері, і, звісно, за ними стоїть Пастиль."

# game/script.rpy:2670
translate ukr ch5_b3482bb2:

    # p "Hi!"
    p "Привіт!"

# game/script.rpy:2671
translate ukr ch5_ad5989c9:

    # w shutin happy "Why, good evening~ and what could you have possibly come for at this hour?"
    w shutin happy "Доброго вечора~ і що ж могло тебе привести сюди в таку пізню годину?"

# game/script.rpy:2672
translate ukr ch5_d6116a12:

    # p shy "To, um... pick up where we left off the other night? Maybe?"
    p shy "Ем... Бажання продовжити те, на чому ми зупинились минулого разу? Напевно?"

# game/script.rpy:2673
translate ukr ch5_de585d14:

    # w calm "(It's about time...)"
    w calm "(Настав час...)"

# game/script.rpy:2674
translate ukr ch5_5385df4b:

    # w smile "Come in, come in~"
    w smile "Заходь, заходь~"

# game/script.rpy:2679
translate ukr ch5_cd910a5d:

    # p "Sorry, I meant to come see you again sooner. I had a few things to sort out before I--"
    p "Вибач, я хотів навідатись до тебе раніше. Але треба було покінчити з деякими справами..."

# game/script.rpy:2680
translate ukr ch5_bc730da8:

    # w shutin "Hush, now. That's not where we left off at all, was it?"
    w shutin "Тшш. Ми ж зовсім не на цьому зупинились, чи не так?"

# game/script.rpy:2681
translate ukr ch5_2e90126b:

    # p wha "Huh? Y-yeah, I guess not...."
    p wha "Хах? Т-так, гадаю, що не на цьому...."

# game/script.rpy:2682
translate ukr ch5_018d96d1:

    # w calm "I'm more interested in how you got me home that night. You see, the last thing I remember is sitting on that bench..."
    w calm "Мене більше цікавить, як ти доставив мене додому. Останнє, що я пам'ятаю - як ми сиділи разом на лавичці..."

# game/script.rpy:2683
translate ukr ch5_ea6b3cdd:

    # p shy "Oh! Uh, well, I was having a hard time waking you up, so I just ended up carrying you..."
    p shy "Ох! Ем, ну, я намагався тебе розбудити, але не зміг, і тому просто поніс тебе..."

# game/script.rpy:2684
translate ukr ch5_7bf95963:

    # w love "The whole way, by yourself~?"
    w love "І весь цей шлях ти подолав зі мною на руках?~"

# game/script.rpy:2685
translate ukr ch5_85a7733b:

    # p ehe "I mean, having a broom to ride helped a lot..."
    p ehe "Ну, як сказати - те, що в мене є мітла, на яку можна сісти та полетіти, теж допомогло..."

# game/script.rpy:2687
translate ukr ch5_025b722e:

    # n "Periwinkle closes in."
    n "Барвінок підходить ближче."

# game/script.rpy:2689
translate ukr ch5_99ae40bd:

    # w "We rode it together, then?"
    w "Отже, ми летіли на ній разом?"

# game/script.rpy:2690
translate ukr ch5_c7a8bcd7:

    # p "That was the easiest way, yes..."
    p "Так, так було найлегше..."

# game/script.rpy:2692
translate ukr ch5_ea00b1f1:

    # w "You must've held me close, so I wouldn't fall."
    w "І ти мав мене дуже міцно тримати, аби я не впав."

# game/script.rpy:2693
translate ukr ch5_17dffd1d:

    # p "I-I did..."
    p "Т-так..."

# game/script.rpy:2694
translate ukr ch5_c05aeb0d:

    # w "Putting your hands all over me, hm?"
    w "Всього мене обмацав, хм?"

# game/script.rpy:2696
translate ukr ch5_d5950d96:

    # p "I-I didn't feel you up while you were unconscious!!" with vpunch
    p "Я-я не чіпав тебе, коли ти спав!!" with vpunch

# game/script.rpy:2698
translate ukr ch5_e4c9d1f9:

    # n "He gives him a big kiss."
    n "Барвінок цілує його."

# game/script.rpy:2699
translate ukr ch5_40d0a112:

    # w "I was only kidding 💙"
    w "Я просто пожартував 💙"

# game/script.rpy:2706
translate ukr ch5_8c5d6ecb:

    # w shutin oh "But you also changed my clothes..."
    w shutin oh "Але ти перевдягнув мене..."

# game/script.rpy:2707
translate ukr ch5_3f8c0164:

    # p shout "Because I thought you'd be more comfortable that way! It was an innocent gesture!!"
    p shout "Я просто подумав, що так тобі буде зручніше спати! Я нічого такого не мав на увазі!!"

# game/script.rpy:2708
translate ukr ch5_722429a2:

    # w shy "I can't believe you saw my bare chest...!"
    w shy "Повірити не можу, що ти бачив мої голі груди!.."

# game/script.rpy:2709
translate ukr ch5_d0de9f7d:

    # p mou "I've already seen it!!" with vpunch
    p mou "Я і до цього їх бачив!!" with vpunch

# game/script.rpy:2710
translate ukr ch5_129da7dd:

    # w kyaa "Kyaa~!"
    w kyaa "Кьяя!~"

# game/script.rpy:2712
translate ukr ch5_2a5bf1a0:

    # n "Pastille suddenly lifts him by the waist and hoists him over his shoulder."
    n "Пастиль раптом хапає його за талію і перекидує через плече."

# game/script.rpy:2714
translate ukr ch5_b0384b66:

    # w "PASTILLE--!!!!"
    w "ПАСТИЛЕ!!!!-"

# game/script.rpy:2715
translate ukr ch5_c919570c:

    # w "Wah!! Please handle me more delicately~! 💙"
    w "Вах!! Будь ласка, неси мене обережніше!~ 💙"

# game/script.rpy:2720
translate ukr ch5_ce101c14:

    # n "When they reach the bed, Pastille falls backwards onto it, taking Periwinkle with him..."
    n "Коли вони досягають ліжка, Пастиль падає на нього спиною вперед, і тягне Барвінка за собою..."

# game/script.rpy:2723
translate ukr ch5_e3264b9c:

    # n "They pause there a moment, laughs fading to soft breaths."
    n "Вони на секунду замовкають, сміх затихає, і чується лише їхнє дихання."

# game/script.rpy:2724
translate ukr ch5_de48edd8:

    # w "You forgot to turn the light off...."
    w "Ти забув погасити світло...."

# game/script.rpy:2725
translate ukr ch5_a01f3a61:

    # p "W-well... I can't get up now...."
    p "Н-ну... Я піднятись вже не можу..."

# game/script.rpy:2726
translate ukr ch5_165a8c0c:

    # w "(How can he be so impatient after making me wait for so long...?)"
    w "(Як він може бути таким нетерплячим після того, як змусив мене чекати так довго?..)"

# game/script.rpy:2728
translate ukr ch5_32610596:

    # w "Hmhm... oh well."
    w "Хмхм... гаразд."

# game/script.rpy:2740
translate ukr ch6_7b49a2da:

    # centered "{w=3}{nw}"
    centered "{w=3}{nw}"

# game/script.rpy:2747
translate ukr ch6_119ba1b9:

    # "I awake to a rustling sound."
    "Я прокинаюсь від якогось шурхоту."

# game/script.rpy:2748
translate ukr ch6_ab14d017:

    # "My bed is empty again, but when I roll over..."
    "Моє ліжко знову порожнє, але коли я перевертаюсь на інший бік, то бачу..."

# game/script.rpy:2749
translate ukr ch6_b46fc96f:

    # "Pastille is there, standing in front of my closet."
    "Пастиль стоїть перед моєю шафою."

# game/script.rpy:2750
translate ukr ch6_761374d1:

    # nvl clear
    # "I sit up, rubbing the sleep from my eyes."
    nvl clear
    "Я сідаю в ліжку і протираю очі, намагаючись остаточно прокинутись."

# game/script.rpy:2752
translate ukr ch6_bd31bc8e:

    # "He's holding a box. As he lifts it on to the top shelf, its contents shift, making a clattering noise."
    "В руках він тримає коробку, яку кладе на верхню полицю. Вміст коробки рухається всередині і брязкає."

# game/script.rpy:2753
translate ukr ch6_64a5f7e2:

    # "Utterly confused as to what he's doing, I finally call out to him."
    "Я збентежений і абсолютно не розумію, що він робить, тому кличу його."

# game/script.rpy:2754
translate ukr ch6_cd1b109b:

    # nvl clear
    # w bed sleepy "Pastille...?"
    nvl clear
    w bed sleepy "Пастиле?.."

# game/script.rpy:2760
translate ukr ch6_f0b9d5cf:

    # p "Sorry! I didn't break anything, I promise."
    p "Вибач! Я нічого не зламав і не розбив, чесне слово."

# game/script.rpy:2761
translate ukr ch6_162a2395:

    # w sleepy2 "What are you doing in my closet...?"
    w sleepy2 "Що ти робиш у моїй шафі?.."

# game/script.rpy:2762
translate ukr ch6_c6af6f68:

    # p um "Huh...? You said I could clean up."
    p um "А?.. Ти же сам сказав, що я можу прибрати."

# game/script.rpy:2763
translate ukr ch6_50b69d81:

    # w "Hmm...?"
    w "Хмм?.."

# game/script.rpy:2764
translate ukr ch6_ac6fcf82:

    # w guilty "Oh, haha... is there anything I won't agree to in my sleep...?"
    w guilty "Ох, хаха... поки я сплю, то можу погодитись на що завгодно..."

# game/script.rpy:2765
translate ukr ch6_50286f17:

    # p embarrassed "Ah--I'm sorry, I thought you were awake when I asked...! I-I'll stop."
    p embarrassed "Ах- вибач, я думав, що ти вже прокинувся!.. Я-я зараз припиню."

# game/script.rpy:2766
translate ukr ch6_11d9a40b:

    # w sleepy3 "It's fine... I just didn't expect to wake up to you rifling through my things."
    w sleepy3 "Все в порядку, нічого страшного... Просто не очікував прокинутись і побачити, як ти копирсаєшся в моїх речах."

# game/script.rpy:2767
translate ukr ch6_1b21a1bb:

    # p flustered2 "Th-that really wasn't my intention...! I just felt like organizing stuff...."
    p flustered2 "Я-я не хотів копатися в твоїх речах!.. Просто захотілося навести лад..."

# game/script.rpy:2768
translate ukr ch6_8abb953b:

    # p think "What do people normally do on the morning after...? I guess I should've made breakfast."
    p think "Що зазвичай люди роблять вранці?.. Гадаю, треба було приготувати сніданок."

# game/script.rpy:2769
translate ukr ch6_d9be9541:

    # w happy "Ohh~ I want to eat pancakes~!"
    w happy "Охх~ Я хочу панкейків!~"

# game/script.rpy:2770
translate ukr ch6_602cfadd:

    # p happy "Great! I'll make some!!"
    p happy "Чудово! Зараз зроблю!!"

# game/script.rpy:2772
translate ukr ch6_7c1da6cd:

    # n "Pastille practically bolts from the room to get started on cooking."
    n "Пастиль миттєво вибігає з кімнати, аби прийнятись за приготування сніданку."

# game/script.rpy:2773
translate ukr ch6_c9e53739:

    # w sleepy3 "Hmhm... oh, Pastille...."
    w sleepy3 "Хмхм... ох, Пастилю..."

# game/script.rpy:2776
translate ukr ch6_54d8e5dc:

    # "Looking around the room, he did much more than organize my closet..."
    "Я оглянув кімнату і зрозумів, що він зробив набагато більше, ніж просто розібрав речі у моїй шафі..."

# game/script.rpy:2777
translate ukr ch6_d495c413:

    # "The books I'd been reading were all tucked back into their proper places on the bookshelf."
    "Книги, які я читав, вже розставлені по своїх місцях на книжковій поличці."

# game/script.rpy:2778
translate ukr ch6_ff59d209:

    # "The clothes that had been strewn across the floor, or otherwise left hanging in ridiculous places, now sat in the hamper waiting to be washed."
    "Одяг, що лежав на підлозі, або звисав з якихось дурнацьких місць, тепер лежав у кошику, очікуючи на прання."

# game/script.rpy:2779
translate ukr ch6_0c0a8ef8:

    # nvl clear
    # "Even the pile of unfolded laundry I had previously abandoned was now absent--properly folded and placed into the appropriate drawers by Pastille."
    nvl clear
    "І навіть купи нескладених речей, яку я хотів розібрати, тепер не було - всі речі Пастиль акуратно розклав по полицях та шухлядах."

# game/script.rpy:2781
translate ukr ch6_c62ed776:

    # "In a word, I'm in awe."
    "Якщо коротко, я вражений."

# game/script.rpy:2782
translate ukr ch6_d9bb5a76:

    # "How long had he been at this? And all while I slept?"
    "Як багато часу в нього це зайняло? І він це все зробив, поки я спав?"

# game/script.rpy:2783
translate ukr ch6_d234491a:

    # "It shouldn't even be possible."
    "Це просто неможливо."

# game/script.rpy:2784
translate ukr ch6_58188605:

    # nvl clear
    # w bed neutral "...."
    nvl clear
    w bed neutral "...."

# game/script.rpy:2787
translate ukr ch6_a12675e8:

    # w oh2 "(I have so much more floor space than I remembered... how did he manage to do that...?)"
    w oh2 "(Виявляється, моя кімната значно просторіша, ніж я пам'ятаю... як він з цим впорався?..)"

# game/script.rpy:2790
translate ukr ch6_9f49ab7b:

    # n "Periwinkle puts on a fresh pair of pajamas and walks out to the kitchen in a daze."
    n "Барвінок перевдягається у чисту піжаму і, весь приголомшений, заходить до кухні."

# game/script.rpy:2796
translate ukr ch6_d0be8d4a:

    # p "Hey! Pancakes are ready."
    p "Хей! Панкейки готові."

# game/script.rpy:2798
translate ukr ch6_2bbe66e9:

    # w pj happy "Oh~! Is it too soon to say I love you?"
    w pj happy "Ох!~ Можна вже зізнатись тобі у коханні?"

# game/script.rpy:2799
translate ukr ch6_59343347:

    # p sure "Haha, please enjoy...."
    p sure "Хаха, смачного...."

# game/script.rpy:2800
translate ukr ch6_5c9fb064:

    # n "Periwinkle takes his seat at the table and digs in..."
    n "Барвінок сідає за стіл і пробує панкейки..."

# game/script.rpy:2803
translate ukr ch6_dba11a19:

    # "They're... delicious."
    "Вони... неймовірні."

# game/script.rpy:2804
translate ukr ch6_ed24b619:

    # "Perfectly light and fluffy... the optimal amount of syrup and whipped cream..."
    "Ідеально легкі та пухнасті... сиропу та взбитих вершків саме стільки, скільки і треба..."

# game/script.rpy:2805
translate ukr ch6_877ba230:

    # "Every bite is so heavenly, I could cry!"
    "Кожен шматочок смакує неймовірно, я зараз заплачу від насолоди!"

# game/script.rpy:2806
translate ukr ch6_534a3175:

    # "I've never felt so emotional over food...! What has this boy done to me?"
    "Я ніколи не відчував таких емоцій від їжі!.. Що цей хлопець зі мною зробив?"

# game/script.rpy:2807
translate ukr ch6_d42fc5b3:

    # nvl clear
    # "I was right about him being the culinary type."
    nvl clear
    "Я був правий, коли припустив, що він має гарно готувати."

# game/script.rpy:2809
translate ukr ch6_a846ccd2:

    # "I didn't think I would get to try his cooking so soon... this is a surprise attack."
    "Але я і гадки не мав, що спробую страву, приготовлену ним, так швидко... це наче удар зненацька."

# game/script.rpy:2810
translate ukr ch6_3495ef88:

    # "He even... ah, but how did those get there? I have to ask--"
    "Він навіть... ах, але як вони тут опинилися? Я маю запитати..."

# game/script.rpy:2811
translate ukr ch6_76b2fe88:

    # nvl clear
    nvl clear

# game/script.rpy:2815
translate ukr ch6_1784b473:

    # w pj oh "Pastille... where did you get these strawberries?"
    w pj oh "Пастилю... де ти знайшов полуниці?"

# game/script.rpy:2816
translate ukr ch6_cf3877d3:

    # p ehe "Oh, I saw you had some jam, so I used a little magic to change its form..."
    p ehe "Ох, я побачив, що в тебе було трохи джему, і магією змінив його форму..."

# game/script.rpy:2817
translate ukr ch6_d1a90016:

    # p ohno2 "Um, is that okay? Maybe I should've asked first--I just remember you liked strawberries, so..."
    p ohno2 "Ем, все в порядку? Напевно, краще було б запитати - я просто згадав, що тобі подобаються полуниці, так що..."

# game/script.rpy:2818
translate ukr ch6_db20d73e:

    # w shy "(Is there any limit to how thoughtful one can be...?!)"
    w shy "(Чи є якась межа тому, наскільки він уважний до інших?!...)"

# game/script.rpy:2819
translate ukr ch6_ced19f55:

    # w love "It's more than okay! This is the best breakfast I've ever had...!"
    w love "\"Все в порядку\" навіть не ті слова! Це найкращий сніданок в моєму житті!.."

# game/script.rpy:2820
translate ukr ch6_3aa7941c:

    # p shy "I'm sure you're exaggerating... they're just pancakes."
    p shy "Гадаю, ти перебільшуєш... це ж просто панкейки."

# game/script.rpy:2821
translate ukr ch6_12d8d8d4:

    # w teehee "Careful, my sweet... if you say it like that, I'm going to start asking you to cook my every meal."
    w teehee "Обережніше зі словами, мій солоденький... інакше такими темпами я попрошу тебе готувати мені постійно - і сніданок, і обід, і вечерю.."

# game/script.rpy:2822
translate ukr ch6_c38947a1:

    # p sure "Fine, you got me. They're special gourmet pancakes I can only whip up every once in a while."
    p sure "Гаразд, гаразд, ти мене викрив. Це особливі панкейки, які я дуже рідко готую."

# game/script.rpy:2823
translate ukr ch6_4b7d60e9:

    # w happy "Lucky me~! 💙"
    w happy "Як мені пощастило!~ 💙"

# game/script.rpy:2826
translate ukr ch6_9df71125:

    # n "Periwinkle finishes his pancakes while Pastille begins washing the dishes..."
    n "Барвінок доїдає панкейки, тим часом Пастиль починає мити посуд..."

# game/script.rpy:2828
translate ukr ch6_395109a4:

    # "This may just be the most spoiled I've ever felt..."
    "Здається, це перший раз в житті, коли мене настільки запестили..."

# game/script.rpy:2829
translate ukr ch6_76489d66:

    # "Being with Pastille is like getting caught in an endless whirlwind of positive feelings."
    "Коли я разом з Пастилем, то мене неначе затягує в нескінченний вихор позитивних відчуттів."

# game/script.rpy:2830
translate ukr ch6_0dbd129d:

    # "No wonder I've become obsessed with him. This boy is dangerously kind."
    "Ясна річ, що я на ньому так зациклився. Його доброта та увага - небезпечна сила."

# game/script.rpy:2831
translate ukr ch6_c7414828:

    # "After these past few emotionally tumultuous days, I... how could I possibly turn away from his comfort...?"
    "Після того, наскільки емоційно бурхливими були останні дні і як вони виснажили мене, я... як я можу відвернутися від комфорту, який він мені дарує?.."

# game/script.rpy:2832
translate ukr ch6_7ab087e8:

    # nvl clear
    # n "Periwinkle rests his elbows on the table, head tilted into palm as he watches Pastille in his kitchen."
    nvl clear
    n "Барвінок кладе лікті на стіл, підпирає долонею щоку і спостерігає, як Пастиль порається на кухні."

# game/script.rpy:2835
translate ukr ch6_59ce0cf4:

    # w pj oh "Out of curiosity..."
    w pj oh "Мені стало цікаво..."

# game/script.rpy:2837
translate ukr ch6_bdbd5257:

    # p "Hm?"
    p "Хм?"

# game/script.rpy:2838
translate ukr ch6_d05db3f5:

    # w "Earlier, before I woke up. What made you ask to start cleaning my room?"
    w "Тоді, раніше, коли я ще не прокинувся... чому ти запитав, чи можна прибратись у мене в кімнаті?"

# game/script.rpy:2839
translate ukr ch6_2563590a:

    # p ehe "Oh, I noticed it was getting harder to walk around..."
    p ehe "Ох, я просто помітив, що там стало важче ходити..."

# game/script.rpy:2840
translate ukr ch6_8bffd0df:

    # p shy "I think I stepped on some of your clothes when I, um... carried you in there last night. Sorry."
    p shy "Гадаю, я наступив на щось з твого одягу, коли, ем... заносив тебе вчора. Вибач."

# game/script.rpy:2841
translate ukr ch6_32cb935a:

    # w calm "That's nothing to apologize for. It was fun."
    w calm "Тобі немає за що вибачатись. Це було весело."

# game/script.rpy:2842
translate ukr ch6_a00c9b60:

    # p embarrassed "Eheh... a-anyway... I felt a little bad about it."
    p embarrassed "Ехех... в будь-якому разі... Мені було трохи незручно."

# game/script.rpy:2843
translate ukr ch6_7219c855:

    # p ehe "So I figured, if I'm going to be coming back here so often, I might as well help clean."
    p ehe "І я подумав - якщо я так і буду сюди часто навідуватись, то, напевно, можу і з прибиранням допомогти."

# game/script.rpy:2844
translate ukr ch6_0d37e844:

    # w ah "Ah...!"
    w ah "Ах!.."

# game/script.rpy:2845
translate ukr ch6_fd796632:

    # p nervous "I-I'm not getting ahead of myself, am I? Sorry, I didn't mean--"
    p nervous "Я-я ж не забігаю наперед, так? Вибач, я не хотів сказати, що-"

# game/script.rpy:2846
translate ukr ch6_b8380aaf:

    # w shock "Not at all!" with vpunch
    w shock "Зовсім ні!" with vpunch

# game/script.rpy:2848
translate ukr ch6_7d5763ee:

    # n "Startled by the sudden outburst, Pastille stops what he's doing."
    n "Пастиль зупиняється, відірвавшись від свого заняття, вражений цим раптовим спалахом емоцій."

# game/script.rpy:2849
translate ukr ch6_cd303bbf:

    # w shy "Hmhm, silly Pastille..."
    w shy "Хмхм, дурненький Пастиле..."

# game/script.rpy:2850
translate ukr ch6_fa84fa9d:

    # w love "You're always welcome here 💙"
    w love "Тобі тут завжди раді 💙"

# game/script.rpy:2851
translate ukr ch6_265a51d5:

    # p doki "Ah...! W-well, thank you...."
    p doki "Ах!.. Д-добре, дякую тобі...."

# game/script.rpy:2855
translate ukr ch6_4bd430f5:

    # "Fine."
    "Гаразд."

# game/script.rpy:2856
translate ukr ch6_44596fc6:

    # "Okay! Enough... I'll admit it."
    "Гаразд! Доволі... Я зізнаюсь."

# game/script.rpy:2857
translate ukr ch6_66217057:

    # "I'm stupidly, desperately, absolutely ridiculously..."
    "Я тупо, відчайдушно, абсолютно безглуздо..."

# game/script.rpy:2858
translate ukr ch6_4b601189:

    # "...in love with Pastille."
    "...закохався у Пастила."

# game/script.rpy:2859
translate ukr ch6_b65603b6:

    # nvl clear
    # "There! I said it--or at least, I'm saying it to myself."
    nvl clear
    "Ось! Я зізнався у цьому - хоча б собі самому."

# game/script.rpy:2861
translate ukr ch6_8127d328:

    # "I'll accept this. Pastille is incredible! Who WOULDN'T fall for him?"
    "Я прийму це. Пастиль неймовірний! Хто б в нього НЕ закохався?"

# game/script.rpy:2862
translate ukr ch6_a7f8f6b4:

    # "I don't want anyone else anymore. I've been poisoned by this perfect boy."
    "Ніхто інший більше мені не потрібний. Я отруєний ідеальністю цього хлопця."

# game/script.rpy:2863
translate ukr ch6_4d52c35b:

    # "The problem now is what to DO about it...."
    "Проблема тепер полягає в тому, що з цим робити...."

# game/script.rpy:2864
translate ukr ch6_76b2fe88_1:

    # nvl clear
    nvl clear

# game/script.rpy:2867
translate ukr ch6_b4d687b8:

    # p "Weird question, but..."
    p "Дивне питання, але..."

# game/script.rpy:2868
translate ukr ch6_36c7f47d:

    # p shy "Would you want to... um..."
    p shy "Чи не хочеш ти... ем..."

# game/script.rpy:2869
translate ukr ch6_1e42307e:

    # w pj innocent "(Date you? Yes!!)"
    w pj innocent "(Зустрічатись з тобою? Так!!)"

# game/script.rpy:2870
translate ukr ch6_1977ea6f:

    # p seriously "...Clean the rest of your house together?" with vpunch
    p seriously "...Прибратись у тебе разом?" with vpunch

# game/script.rpy:2871
translate ukr ch6_4cd578fd:

    # w ohdear "...Hm?"
    w ohdear "...Хм?"

# game/script.rpy:2872
translate ukr ch6_bdf3c1ab:

    # p shy "I-it'll be more fun than it sounds! And if you get bored, we can do something else..."
    p shy "Це буде веселіше, ніж звучить! І якщо тобі набридне, ми можемо зайнятись чимось іншим..."

# game/script.rpy:2873
translate ukr ch6_a76308ac:

    # w calm "Pastille..."
    w calm "Пастиле..."

# game/script.rpy:2874
translate ukr ch6_80a12d07:

    # p embarrassed "I just thought if we did it together, you'd get a say in where everything goes, so nothing ends up getting lost...!"
    p embarrassed "Я просто подумав, що якщо б ми робили це разом, то ти міг би сказати, куди що покласти, аби нічого не загубилось!.."

# game/script.rpy:2875
translate ukr ch6_ee213eff:

    # w love "Pastille...!"
    w love "Пастиле!.."

# game/script.rpy:2876
translate ukr ch6_c8b7db60:

    # p ehe2 "And it's totally fine if you don't want me going through your stuff anymore. We really don't have to--"
    p ehe2 "Я зрозумію, якщо ти не хочеш, аби я знову копався в твоїх речах. Ми не обов'язково маємо-"

# game/script.rpy:2877
translate ukr ch6_38742bdf:

    # w happy "Pastille, it's fine! I think it's a lovely idea."
    w happy "Пастиле, все гаразд! Мені подобається твоя ідея."

# game/script.rpy:2878
translate ukr ch6_d3b99301:

    # p wha "R-really...?"
    p wha "Д-дійсно?.."

# game/script.rpy:2879
translate ukr ch6_d5f25738:

    # w innocent "Yes. In fact, I'd appreciate your help."
    w innocent "Так. Насправді, я дуже ціную твою допомогу."

# game/script.rpy:2880
translate ukr ch6_4ba187a4:

    # w love "One thing or another has always come up when I try to clean on my own. I'm simply useless at it."
    w love "Коли я намагаюсь прибратись самостійно, мене завжди щось відволікає. Я просто до цього непридатний."

# game/script.rpy:2881
translate ukr ch6_c049910d:

    # p happy "Then... I'll take the lead! I wanted to start with these boxes by the couch..."
    p happy "Тоді... я візьму керівництво на себе! Я хотів почати з тих коробок біля дивану..."

# game/script.rpy:2885
translate ukr ch6_98446b5c:

    # "Pastille already had a plan for everything, it seemed."
    "Здається, що у Пастила вже був підготовлений план."

# game/script.rpy:2886
translate ukr ch6_80b953ec:

    # "His energy was contagious. He was right that it would be fun--it was entertaining even just watching him go."
    "Його ентузіазм заразив і мене. Він не збрехав, коли сказав, що буде весело - мені було цікаво навіть просто спостерігати за ним."

# game/script.rpy:2887
translate ukr ch6_8e73e0b2:

    # "To see him dart around the room so energetically, finding the perfect place for every little thing..."
    "Дивитися, як він енергійно рухається по кімнаті і кожній дрібничці, навіть найменшій, знаходить своє місце..."

# game/script.rpy:2888
translate ukr ch6_f19b7285:

    # "He truly has a talent for organization."
    "В нього дійсно талант все розкладати по місцях."

# game/script.rpy:2889
translate ukr ch6_8bb41e57:

    # nvl clear
    # "Meanwhile, I mostly played the role of assistant."
    nvl clear
    "Я ж грав лише роль помічника."

# game/script.rpy:2891
translate ukr ch6_a1ad8874:

    # "He would ask for my input every now and then, or instruct me to place something he found somewhere across the room."
    "Час від часу він звертався до мене за уточненнями, або відправляв у інший кінець кімнати покласти якусь річ, яку він знайшов."

# game/script.rpy:2892
translate ukr ch6_092cda92:

    # "He made little decisions like that so easily. If it were me, I'd get stuck on every one..."
    "Він дуже легко приймав всі ці невеличкі рішення. Я б на його місці надовго застрягав на кожному..."

# game/script.rpy:2893
translate ukr ch6_48fd29c3:

    # "But he saw everything through, effortlessly. It was nothing short of amazing."
    "Але він доводив все до кінця без жодних зусиль. Просто неймовірно."

# game/script.rpy:2894
translate ukr ch6_8d433bab:

    # nvl clear
    # n "And so, in a short few hours..."
    nvl clear
    n "І через кілька годин..."

# game/script.rpy:2900
translate ukr ch6_80154118:

    # n "...The entire house had become neat and tidy."
    n "...Весь будинок став чистим та охайним."

# game/script.rpy:2903
translate ukr ch6_fe44cae1:

    # p "Okay... I think I'm satisfied. You?"
    p "Гаразд... Я думаю, що я задоволений. А ти?"

# game/script.rpy:2904
translate ukr ch6_9e685ed1:

    # w pj shy "Hmm~ don't you think you deserve to be rewarded for all your hard work? 💙"
    w pj shy "Хммм~ не думаєш, що заслуговуєш на нагороду за все, що ти зробив? 💙"

# game/script.rpy:2905
translate ukr ch6_876e21b0:

    # p uhoh "Ah--I-I should've seen that one coming...!"
    p uhoh "Ах- Я-я мав здогадатися, що ти це скажеш!.."

# game/script.rpy:2906
translate ukr ch6_09a70627:

    # p shy "But no, not right now! I should actually get going...."
    p shy "Але ні, не зараз! Мені треба йти...."

# game/script.rpy:2907
