translate ukr ch6_8f5a93ed:

    # "Our exchanges were mostly innocent, unlike other partners I've paid visits to in the past."
    "Наші бесіди були доволі невинними - на відміну від розмов з деякими іншими партнерами, яких я відвідував у минулому."

# game/script.rpy:3011
translate ukr ch6_0ec556fd:

    # "He was very adamant about not fooling around at work..."
    "Він дуже категорично відмовлявся від моєї пропозиції порозважатися на роботі..."

# game/script.rpy:3012
translate ukr ch6_67128253:

    # "Not that it ever stopped me from teasing him about it 💙"
    "Не те щоб це зупиняло мене від того, аби його подражнити 💙"

# game/script.rpy:3013
translate ukr ch6_078fe372:

    # nvl clear
    # centered "{nw}"
    nvl clear
    centered "{nw}"

# game/script.rpy:3020
translate ukr ch6_edfaa106:

    # n "Periwinkle watches as Pastille, armed with a rag and a bottle of cleaner, sprays down the counter in front of him."
    n "Барвінок спостерігає, як Пастиль, озброївшись ганчіркою та пляшкою очищувача, протирає прилавок."

# game/script.rpy:3021
translate ukr ch6_a7891201:

