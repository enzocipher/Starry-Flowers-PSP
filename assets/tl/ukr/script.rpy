    w love "Не хочеш збуджуватися на роботі? 💙"

# game/script.rpy:3007
translate ukr ch6_bbf2a841:

    # p scream "THAT!! THAT'S NOT ALLOWED!!!" with vpunch
    p scream "ЦЕ!! НЕ ДОЗВОЛЕНО!!!" with vpunch

