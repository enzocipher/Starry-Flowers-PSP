    w teehee "...І ніякої спідньої білизни?"

# game/script.rpy:1721
translate ukr ch4_9610688c:

    # p seriously "W-weren't you already wearing some?!"
    p seriously "Я-я думав, ти вже її надягнув?!"

# game/script.rpy:1722
translate ukr ch4_96005872:

    # w shy "So scandalous, Pastille... I didn't know you had it in you~"
    w shy "Як скандально, Пастиле... Я й не думав, що ти на таке здатен~"

# game/script.rpy:1723
translate ukr ch4_efe025bf:

    # p scream "PLEASE, I'LL FIND YOU A PAIR...!" with vpunch
    p scream "БУДЬ ЛАСКА, ДОСИТЬ, Я ЗАРАЗ ЗНАЙДУ ТОБІ ЩОСЬ!.." with vpunch

# game/script.rpy:1724
translate ukr ch4_36731a75:

    # w happy "Hahaha 💙 I'm only teasing, my sweet~"
    w happy "Хахаха 💙 Я просто дражнюсь, солоденький~"

# game/script.rpy:1728
translate ukr ch4_c5dc64f3:

