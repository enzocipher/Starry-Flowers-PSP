    # nvl clear
    # centered "{nw}"
    nvl clear
    centered "{nw}"

# game/script.rpy:3071
translate ukr ch6_59e10b52:

    # p "Sy can be really frustrating sometimes..."
    p "З Сі іноді дійсно важко мати справу..."

# game/script.rpy:3072
translate ukr ch6_c7cb80c7:

    # p calm "But she's my best friend. I still care about her, even when she messes up."
    p calm "Але вона моя найкраща подруга. І я за неї переживаю, навіть коли вона сама робить дурниці."

# game/script.rpy:3073
translate ukr ch6_9a10cd12:

    # w calm "Hmhm, she's lucky to have you."
    w calm "Хмхм, їй пощастило, що в неї такий друг."

# game/script.rpy:3074
translate ukr ch6_de428b8a:

    # p seriously "Yeah, she really is! Anyone else would've given up on her by now!"
    p seriously "Ага, погоджуюсь! Хтось інший би давно же кинув її напризволяще!"

# game/script.rpy:3075
translate ukr ch6_afc84a52:

    # p "For YEARS, she would just lock herself in her lab, making all this candy, bragging about how cool her alchemy is compared to magic..."
    p "Вона РОКАМИ замикала себе у цій лабораторії, і робила там всі ці цукерки, розповідала, яка кльова її алхімія у порівнянні з магією..."

# game/script.rpy:3076
translate ukr ch6_992901dd:

    # p flustered2 "She barely ever talked to anyone else! And when she did, it was to BERATE them over something!"
    p flustered2 "Вона майже ні з ким, крім мене, не розмовляла! А коли розмовляла - то завжди лише для того, аби комусь дорікнути!"

# game/script.rpy:3077
translate ukr ch6_82d312bb:

    # p shout "Who treats their own customers like that?! Who do you think pays for the roof over our heads!!" with vpunch
    p shout "Хто так поводиться з власними покупцями?! Хто, на її думку, платить за дах над нашими головами!!" with vpunch

# game/script.rpy:3078
translate ukr ch6_46d8cf69:

    # p calm "*sigh* ...Sorry. I don't wanna give you a bad impression of her. She's gotten much better recently."
    p calm "*позіхає* ...Вибач. Не хочу, аби в тебе склалося погане враження про неї. До того ж, нещодавно вона стала себе поводити набагато краще."

# game/script.rpy:3079
translate ukr ch6_7c7821bc:

    # w smile "It sounds complicated. At least your patience is paying off, hm?"
    w smile "Звучить складно. Але твоє терпіння хоча б приносить плоди, хм?"

# game/script.rpy:3080
translate ukr ch6_1c65e1f5:

    # p ehe "Yeah, seems like it... at one point, it was kinda up to a coin toss on whether I'd stay or go."
    p ehe "Ага, схоже, що так... але в певний момент навіть я вже був готовий піти - як монета скаже."

# game/script.rpy:3081
translate ukr ch6_24fcc0db:

    # w love "A coin toss? How extreme!"
    w love "Ти підкидував монетку? Як радикально!"

# game/script.rpy:3082
translate ukr ch6_af8b1653:

    # p shy "N-not literally... it was more like, whether or not she could prove she actually felt empathy...."
    p shy "Н-не настільки буквально... я мав на увазі, що в той момент я дивився, чи зможе вона довести, що здатна відчувати співчуття та емпатію...."

# game/script.rpy:3083
translate ukr ch6_105eee71:

    # p sure "Anyway, it turns out she's not a complete monster. So here I am."
    p sure "В будь-якому разі, виявилось, що вона не повний монстр, і тому я залишився тут."

# game/script.rpy:3084
translate ukr ch6_f9876e9c:

    # p ohno "...Sorry. I'm still giving you a bad impression of her, aren't I...?"
    p ohno "...Вибач. Своїми словами я створюю тільки більш неприємне враження про неї, чи не так?.."

# game/script.rpy:3085
translate ukr ch6_cb250703:

    # p ehe2 "Y-you can just disregard everything I said! Sy is great."
    p ehe2 "Забудь все, що я тобі наговорив! Сі чудова."

# game/script.rpy:3086
translate ukr ch6_a3db29c7:

    # w calm "I believe you. She must be, if you've put up with so much from her."
    w calm "Я тобі вірю. Якщо ти стільки від неї терпів, то має бути того вартою."

# game/script.rpy:3087
translate ukr ch6_84140ef5:

    # p shy "Haha... yeah...."
    p shy "Хаха... так...."

# game/script.rpy:3091
translate ukr ch6_a9cdd89b:

    # "I treasured every moment I got to spend with Pastille."
    "Я цінував кожен момент, який проводив разом з Пастилем."

# game/script.rpy:3092
translate ukr ch6_32ddcc56:

    # "Even without a label on what exactly our relationship was, I could enjoy myself all the same."
    "Нехай наші стосунки і не мали точного визначення - я відчував від них лише радість."

# game/script.rpy:3093
translate ukr ch6_34fb4329:

    # "In truth, I was only biding my time. But it didn't really feel like that at all."
    "Якщо бути відвертим, я просто чекав на зручний момент. Хоча це таким зовсім не відчувалося."

# game/script.rpy:3094
translate ukr ch6_e4a42b4e:

    # "Just being near him was enough."
    "Мені було достатньо просто бути з ним поруч."

# game/script.rpy:3095
translate ukr ch6_76b2fe88_3:

    # nvl clear
    nvl clear

# game/script.rpy:3101
translate ukr ch6_458936c0:

    # "One day... he finally asked it."
    "Одного дня... він нарешті сказав це."

# game/script.rpy:3102
translate ukr ch6_50461ff7:

    # "The question I'd been waiting to hear."
    "Питання, яке я хотів почути."

# game/script.rpy:3103
translate ukr ch6_76b2fe88_4:

    # nvl clear
    nvl clear

# game/script.rpy:3107
translate ukr ch6_873dd47d:

    # p "Do you... wanna meet my friends?"
    p "Чи не хочеш ти... зустріти моїх друзів?"

# game/script.rpy:3108
translate ukr ch6_cdaf4cfc:

    # w ah "Ah... well, yes, but... are you sure?"
    w ah "Ах... так, хочу, але... чи ти впевнений?"

# game/script.rpy:3109
translate ukr ch6_44d93660:

    # p nervous "No. But it feels stupid to keep avoiding it..."
    p nervous "Ні. Але і уникати цього здається безглуздим..."

# game/script.rpy:3110
translate ukr ch6_73223976:

    # p flustered2 "I started worrying it'd happen on accident one of these days. I-I don't think I would survive that, so...."
    p flustered2 "Я почав хвилюватись, що раптом ти зіткнешься з ними. Н-не впевнений, що переживу це, так що...."

# game/script.rpy:3111
translate ukr ch6_311b280d:

    # p seriously "We should just go! Before I change my mind!!"
    p seriously "Ми просто маємо йти! Поки я не передумав!!"

# game/script.rpy:3112
translate ukr ch6_f1b74a79:

    # w ohdear "Ah--right now?"
    w ohdear "А- просто зараз?"

# game/script.rpy:3113
translate ukr ch6_4ae7537b:

    # p "Yes. C'mon!"
    p "Так. Нумо!"

# game/script.rpy:3115
translate ukr ch6_8e34219d:

    # n "Pastille takes Periwinkle by the hand and the pair hastily makes their way to Atelier Sweets."
    n "Пастиль бере Барвінка за руку і вони швидко йдуть до Ательє Солодощів."

# game/script.rpy:3119
translate ukr ch6_f5c266a1:

    # n "Slightly out of breath, Pastille stops just before they reach their destination."
    n "Пастиль зупиняється просто перед ним, важко дихаючи."

# game/script.rpy:3121
translate ukr ch6_429c311f:

    # p "O-okay... gimme a minute...."
    p "Г-гаразд... зачекай хвилинку..."

# game/script.rpy:3122
translate ukr ch6_7f8e79f8:

    # w love "After we rushed all the way here? Don't back down now, my sweet."
    w love "Після того, як ми неслись сюди, як навіжені? Мій солоденький, не час відступати."

# game/script.rpy:3123
translate ukr ch6_7a0ca5a3:

    # p anxious "I know. I'm preparing, mentally."
    p anxious "Я знаю. Я просто намагаюсь морально підготуватись."

# game/script.rpy:3124
translate ukr ch6_9232f91d:

    # p flustered "I-I've never done this before. I know it'll be fine, I just..."
    p flustered "Я-я ніколи цього не робив, я знаю, що все буде гаразд, але просто..."

# game/script.rpy:3125
translate ukr ch6_95a43e60:

    # w calm "Take your time. We'll go in when you're ready."
    w calm "Не поспішай. Ми підемо, коли ти будеш готовий."

# game/script.rpy:3126
translate ukr ch6_a12d8c1f:

    # p calm "...."
    p calm "...."

# game/script.rpy:3127
translate ukr ch6_61001015:

    # p shy "O-okay... I think I'm only getting more nervous standing out here thinking about it. Let's just go in."
    p shy "Г-гаразд... Здається, що я тільки більше хвилююсь від того, що стою та думаю, як все пройде. Давай просто зайдемо."

# game/script.rpy:3128
translate ukr ch6_0688977c:

    # w smile "After you~ 💙"
    w smile "Після тебе~ 💙"

# game/script.rpy:3134
translate ukr ch6_9a0555ba:

    # "The meeting itself was nothing memorable."
    "Сама зустріч не була дуже особливою."

# game/script.rpy:3136
translate ukr ch6_c307d6e9:

    # "Gumdrop was incredibly human, for a golem made out of candy."
    "Мармеладка була дуже схожа на людину - настільки, наскільки може бути на неї схожим голем, зроблений з цукерок."

# game/script.rpy:3137
translate ukr ch6_acf7f2ce:

    # "Syrup was about what I expected. Curt, but also... warm."
    "Сироп виявилась такою, як я і очікував. Різка та дещо груба, але... від неї відчувалось тепло."

# game/script.rpy:3138
translate ukr ch6_9912d0e0:

    # "For all its buildup, the interaction itself was anticlimactic. A quick exchange of pleasantries before the Candy Alchemist called her golem back downstairs."
    "Попри всі очікування, сама зустріч дещо розчарувала. Ми лише обмінялись кількома фразами, і Алхімік Солодощів разом зі своїм големом спустилась назад до себе."

# game/script.rpy:3139
translate ukr ch6_76b2fe88_5:

    # nvl clear
    nvl clear

# game/script.rpy:3141
translate ukr ch6_396781ed:

    # "It didn't feel real."
    "Це було наче уві сні."

# game/script.rpy:3142
translate ukr ch6_35d1a4fb:

    # "Had I acted normal? Come across as my usual self?"
    "Чи поводився я нормально? Здається, як і завжди?"

# game/script.rpy:3143
translate ukr ch6_229524b0:

    # "It had only just happened, but it's already a blur."
    "Це тільки сталося, але враження вже були неначе змазані."

# game/script.rpy:3144
translate ukr ch6_fcf147cb:

    # "I held Pastille's hand in the end, I remember that. He had been so nervous, I could practically hear his heart beating out of his chest..."
    "Але я запам'ятав, як узяв Пастиля за руку під кінець розмови. Він дуже хвилювався - я чув, як його серце намагалося вистрибнути з грудей..."

# game/script.rpy:3145
translate ukr ch6_76b2fe88_6:

    # nvl clear
    nvl clear

# game/script.rpy:3147
translate ukr ch6_c267c7e4:

    # "I hadn't understood just how stressful it would be for him."
    "Я і гадки не мав, наскільки хвилюючою для нього буде ця зустріч."

# game/script.rpy:3148
translate ukr ch6_193283c6:

    # "I felt guilty at having put him through it, although the idea was his to begin with."
    "Я відчував провину через те, що змусив його проходити через все це, незважаючи на те, що він сам запропонував."

# game/script.rpy:3149
translate ukr ch6_91dcf0bc:

    # "He decided to go through that... for himself? Or for me?"
    "Він вирішив зробити це... заради себе? Чи заради мене?"

# game/script.rpy:3150
translate ukr ch6_78813798:

    # "This seemingly mundane interaction that meant so much more for the both of us...."
    "Ця, здавалось би, звичайна зустріч так багато значила для нас обох...."

# game/script.rpy:3151
translate ukr ch6_76b2fe88_7:

    # nvl clear
    nvl clear

# game/script.rpy:3153
translate ukr ch6_d5c67421:

    # p "...."
    p "...."

# game/script.rpy:3154
translate ukr ch6_b375b5a9:

    # w love "Pastille...?"
    w love "Пастилю?.."

# game/script.rpy:3155
translate ukr ch6_7d1ba007:

    # p ehe2 "Sorry. I'm okay."
    p ehe2 "Вибач. Я в порядку."

# game/script.rpy:3156
translate ukr ch6_555a4581:

    # p embarrassed "I feel stupid having made such a big deal of it... of course it all turned out just fine...."
    p embarrassed "Тільки почуваю себе як дурень через те, що так сильно хвилювався... звісно ж, що все пройшло нормально..."

# game/script.rpy:3157
translate ukr ch6_871b9d05:

    # w calm "It was important to you. We all get worked up over things we care about, don't we?"
    w calm "Це було важливо для тебе. Ми всі хвилюємось через важливі для нас речі, чи не так?"

# game/script.rpy:3158
translate ukr ch6_e65a7757:

    # p shy "A-are you including yourself in that? You seem like you always have it together...."
    p shy "Т-ти і себе теж маєш на увазі? Здавалося, що в тебе все завжди під контролем...."

# game/script.rpy:3159
translate ukr ch6_0135eb0d:

    # w happy "Ohh, am I hiding it THAT well~?"
    w happy "Охх, я настільки добре це приховую?~"

# game/script.rpy:3160
translate ukr ch6_e3e6d0c0:

    # p ehe "Haha, anyway... um, we can go...."
    p ehe "Хаха, в будь-якому разі... ем, можемо йти...."

# game/script.rpy:3162
translate ukr ch6_23c6df31:

    # w smile "...."
    w smile "...."

# game/script.rpy:3163
translate ukr ch6_026080f9:

    # w ohdear "(How is he going to react when he discovers what a mess I've been...?)"
    w ohdear "(Як він відреагує, коли дізнається, в якому стані я був в ті дні?..)"

# game/script.rpy:3166
translate ukr ch6_6537e332:

    # "Pastille walks me home, and promises to return later tonight."
    "Пастиль проводжає мене до дому і обіцяє повернутися вночі."

# game/script.rpy:3167
translate ukr ch6_49b208d4:

    # "Things will move forward from there, won't they? Or is it too soon...?"
    "Тепер ми можемо йти далі, чи не так? Чи досі занадто рано?.."

# game/script.rpy:3168
translate ukr ch6_2cc88408:

    # "Maybe it's too much for one day! I don't want to add to his stress...."
    "Можливо, стільки подій в один день буде занадто! Я не хочу, аби він ще більше хвилювався...."

# game/script.rpy:3169
translate ukr ch6_1dc0c4c0:

    # nvl clear
    # w oops "(Ugh... why is this so difficult...?)"
    nvl clear
    w oops "(Чорт забирай... чому все так складно?..)"

# game/script.rpy:3171
translate ukr ch6_b84eb580:

    # w conflicted "(His perception of me could be completely destroyed! Tarnished!)"
    w conflicted "(Його сприйняття мене може бути повністю зруйноване! Заплямоване!)"

# game/script.rpy:3172
translate ukr ch6_d13ffbb7:

    # w sorry "(But that's a risk worth taking... isn't it...?)"
    w sorry "(Але все-таки варто ризикнути... чи не так?..)"

# game/script.rpy:3181
translate ukr ch6_dad1a362:

    # n "That night... Periwinkle laid on the floor in the middle of his living room and waited."
    n "Вночі... Барвінок ліг на підлогу посередині вітальні та чекав."

# game/script.rpy:3183
translate ukr ch6_83701cac:

    # w shutin neutral "...."
    w shutin neutral "...."

# game/script.rpy:3184
translate ukr ch6_82a844cb:

    # w empty "(I'd expected this night to come eventually, and yet... I still don't feel any more prepared for it.)"
    w empty "(Я очікував, що ця ніч рано чи пізно настане, але... я досі не відчуваю себе достатньо підготовленим.)"

# game/script.rpy:3186
translate ukr ch6_0b065d30:

    # n "Periwinkle idly taps his wand to one of the candles on the table."
    n "Барвінок легенько стукає паличкою по одній зі свічок на столі."

# game/script.rpy:3187
translate ukr ch6_b971b49b:

    # w shutin oops "...Still peachy. The curse is not yet lifted."
    w shutin oops "...Досі пахне персиком. Прокляття ще не знято."

# game/script.rpy:3189
translate ukr ch6_b7ed660b:

    # n "Pastille's knock finally comes, and Periwinkle rises to answer."
    n "Нарешті Пастиль стукає у двері, і Барвінок поспішає їх відчинити."

# game/script.rpy:3195
translate ukr ch6_7f645bd4:

    # p "Oh, it smells nice in here. Is that your magic?"
    p "Ох, гарно пахне. Це твоя магія?"

# game/script.rpy:3196
translate ukr ch6_c6202711:

    # w shutin innocent "You like it? It's my latest specialty 💙"
    w shutin innocent "Тобі подобається? Це фірмовий аромат, останнє, що я розробив 💙"

# game/script.rpy:3197
translate ukr ch6_d842efac:

    # p happy "Aww, what a treat!"
    p happy "Авв, да ти мене пестиш!"

# game/script.rpy:3199
translate ukr ch6_2d39236d:

    # p smile "Have you eaten yet? I could make us a special dinner."
    p smile "Ти ще не їв? Я можу приготувати для нас особливу вечерю."

# game/script.rpy:3200
translate ukr ch6_43c03053:

    # w my "Oh~ what's the occasion?"
    w my "Ох~ і яка ж причина для цього?"

# game/script.rpy:3201
translate ukr ch6_cdb2e25e:

    # p ehe "Celebrating the fact nothing went horribly wrong today. I brought a few things, if I could just borrow your stove..."
    p ehe "Відмітимо те, що все сьогодні пройшло нормально і не сталося нічого жахливого. Я дещо з собою приніс, і якщо ти дозволиш мені скористуватись кухнею..."

# game/script.rpy:3202
translate ukr ch6_ccea5b7d:

    # w innocent "By all means~"
    w innocent "Звісно~"

# game/script.rpy:3205
translate ukr ch6_b1a59605:

    # "I once again found myself in the excruciatingly domestic situation of watching Pastille prepare a meal in my kitchen."
    "І я знову опинився в до болю домашній ситуації, коли Пастиль готує їжу на моїй кухні."

# game/script.rpy:3206
translate ukr ch6_27f276dd:

    # "There's no way he doesn't realize it, right? That we've been acting as a couple for a long time now..."
    "Він же не може цього не розуміти, чи не так? Ми вже доволі довго поводимо себе як пара..."

# game/script.rpy:3207
translate ukr ch6_64b1117b:

    # "It's just that neither of us have bothered to address it."
    "Просто ніхто з нас не піднімав цю тему."

# game/script.rpy:3208
translate ukr ch6_11c05150:

    # "Shouldn't it be properly acknowledged...?"
    "Але чи не варто проговорювати таке вголос?.."

# game/script.rpy:3209
translate ukr ch6_a15243f7:

    # nvl clear
    # "Pastille chats with me as he cooks, but I'm admittedly distracted by these thoughts."
    nvl clear
    "Пастиль балакає зі мною, поки готує, але я не здатний зосередитись на розмові, і постійно відволікаюсь на свої думки."

# game/script.rpy:3211
translate ukr ch6_8b6ec33b:

    # "Perhaps putting a name to it would only cause it to unravel..."
    "Можливо, якщо ми дамо нашим стосункам якусь назву, то все стане тільки гіршим..."

# game/script.rpy:3212
translate ukr ch6_fed127ba:

    # "Currently, there's no expectation. We're free to see whoever else we like."
    "Зараз в нас обох немає ніяких очікувань, і ми вільно можемо зустрічатись з кимось ще."

# game/script.rpy:3213
translate ukr ch6_588f3995:

    # "Though... it doesn't seem either of us are doing that."
    "Але... не схоже, аби хтось з нас цим користувався."

# game/script.rpy:3214
translate ukr ch6_7d13798e:

    # nvl clear
    # n "Pastille approaches the table where Periwinkle sits, holding a plate in each hand."
    nvl clear
    n "Пастиль підходить до столу, за яким сидить Барвінок, тримаючи по тарілці в кожній руці."

# game/script.rpy:3220
translate ukr ch6_45d7faef:

    # p "Ta-da~ Pasta's ready."
    p "Та-дам~ Паста готова."

# game/script.rpy:3221
translate ukr ch6_10cdcc29:

    # w shutin happy "Ooh, bon appétit 💙"
    w shutin happy "Оох, бон аппетіт 💙"

# game/script.rpy:3224
translate ukr ch6_0e94caa2:

    # "Maybe he's already decided we're a couple, and I'm just obsessing over formalities."
    "Може, він вже вирішив, що ми пара, і я просто надто сильно переймаюсь через формальності."

# game/script.rpy:3225
translate ukr ch6_b80eb0a1:

    # "What does it matter, so long as the two of us are happy?"
    "Яка різниця, якщо ми обидва щасливі?"

# game/script.rpy:3226
translate ukr ch6_e81d99d4:

    # "And I really AM happy..."
    "І я дійсно щасливий..."

# game/script.rpy:3227
translate ukr ch6_a91d3dfd:

    # "His cooking... tastes wonderful...."
    "Його страви... смакують неймовірно...."

# game/script.rpy:3228
translate ukr ch6_76b2fe88_8:

    # nvl clear
    nvl clear

# game/script.rpy:3231
translate ukr ch6_41880f7f:

    # p "...Peri? You okay?"
    p "...Барві? Все в порядку?"

# game/script.rpy:3232
translate ukr ch6_94ce811b:

    # w shutin ah "Hm? Yes...?"
    w shutin ah "Хм? Так?.."

# game/script.rpy:3233
translate ukr ch6_a057a474:

    # p ehe "You were being so quiet, I started to worry that I messed up our dinner somehow..."
    p ehe "Ти просто так тихо сидиш, що я почав думати, що якось зіпсував вечерю.."

# game/script.rpy:3234
translate ukr ch6_05d526a2:

    # w guilty "No, no... it's delicious!"
    w guilty "Ні, ні... все дуже смачно!"

# game/script.rpy:3235
translate ukr ch6_8f95049d:

    # w smile "I was just lost in the pasta, is all. Forgive me, I didn't mean to worry you."
    w smile "Я просто занадто сильно зосередився на пасті, от і все. Пробач мене, не хотів тебе хвилювати."

# game/script.rpy:3238
translate ukr ch6_bc3ffb32:

    # "I need to get out of my own head."
    "Мені не можна застрягати у своїх думках."

# game/script.rpy:3239
translate ukr ch6_4781f2a1:

    # "Pastille is here in front of me! And I'm too distracted to savor it...!"
    "Пастиль просто переді мною! І я занадто сильно відволікаюсь, замість того, аби насолоджуватись його присутністю!.."

# game/script.rpy:3240
translate ukr ch6_36793aff:

    # "Forget my doubts. We'll just have to see where the night takes us..."
    "Треба забути про сумніви. Просто подивимось, що нам принесе ця ніч..."

# game/script.rpy:3241
translate ukr ch6_8abc74f1:

    # nvl clear
    # n "Periwinkle takes his plate to the sink and begins to wash up."
    nvl clear
    n "Барвінок встає зі столу і підходить до раковини, починаючи мити свою тарілку."

# game/script.rpy:3245
translate ukr ch6_3e0f9893:

    # p wha "Ah--I can take care of that!"
    p wha "Ах- я можу помити!"

# game/script.rpy:3246
translate ukr ch6_e738bebe:

    # w love "Nonsense, you just cooked us dinner! It's your turn to relax, my sweet 💙"
    w love "Ні в якому разі, ти ж тільки-но готував нам вечерю! Тепер твоя черга відпочівати, солоденький 💙"

# game/script.rpy:3247
translate ukr ch6_56c4b6d1:

    # p shy "Are you sure I can't help...? I wouldn't mind at all...."
    p shy "Ти впевнений, що ніяк не можу допомогти?.. Я був би не проти...."

# game/script.rpy:3248
translate ukr ch6_bc36cfb7:

    # w calm "You can help by bringing me your plate when you're finished."
    w calm "Можеш допомогти мені і принести тарілку, коли доїсиш."

# game/script.rpy:3249
translate ukr ch6_c83acea9:

    # p ehe "Okaaay...."
    p ehe "Гараааазд...."

# game/script.rpy:3252
translate ukr ch6_4911fe5a:

    # n "Pastille does as he's told, then wanders over to the couch."
    n "Пастиль робить те, що йому сказали, і потім присідає на диван."

# game/script.rpy:3255
translate ukr ch6_e34ed609:

    # p "Hey, um..."
    p "Хей, ем..."

# game/script.rpy:3256
translate ukr ch6_fe1d1ce2:

    # p "If you have anyone you want to introduce me to, I'd be happy to meet them. Return the favor, sort of thing."
    p "Якщо ти хочеш мене познайомити зі своїми друзями або знайомими, то я з радістю погоджусь на таку зустріч. Поверну борг, так би мовити."

# game/script.rpy:3258
translate ukr ch6_bbf226dc:

    # p "I-I know it can be awkward though, so... if not, that's okay too...."
    p "Я-я знаю, що це може бути незручно, так що... все в порядку, якщо ти не хочеш...."

# game/script.rpy:3259
translate ukr ch6_6753e7b3:

    # w "Hm... no, no one comes to mind."
    w "Хм... ні, ніхто не спадає на думку."

# game/script.rpy:3260
translate ukr ch6_a367466f:

    # p "...Huh? Really?"
    p "...Хах? Дійсно?"

# game/script.rpy:3261
translate ukr ch6_6e2dd70d:

    # w "Sure, I know a lot of people. But I couldn't say I'm particularly close with any of them..."
    w "Звісно, я знаю дуже багатьох, але не можу сказати, аби був з кимось дуже близьким..."

# game/script.rpy:3263
translate ukr ch6_8585d2d5:

    # w "Except maybe one? But you've already met my business partner."
    w "Напевно, за винятком однієї людини? Але мою партнерку по бізнесу ти вже зустрів."

# game/script.rpy:3264
translate ukr ch6_0aad42dd:

    # p "Oh! At the apothecary, right?"
    p "Ох! Власниця аптеки, так?"

# game/script.rpy:3266
translate ukr ch6_05485f5a:

    # w "Precisely."
    w "Саме так."

# game/script.rpy:3267
translate ukr ch6_d5c67421_1:

    # p "...."
    p "...."

# game/script.rpy:3269
translate ukr ch6_01f6d082:

    # w "Hm~? What's with that look."
    w "Хм~? Що це за дивний вираз обличчя?"

# game/script.rpy:3271
translate ukr ch6_c50b5f2b:

    # p "N-no, nothing... I just don't know what to say now."
    p "Н-нічого такого... Просто не знаю, що сказати."

# game/script.rpy:3272
translate ukr ch6_1af14dea:

    # w "Hmhm, you expected someone as charismatic as me to have all sorts of new people to introduce you to, then?"
    w "Хмхм, гадаю, що ти думав, що така харизматична людина, як я, має багато знайомих, яким хоче тебе представити?"

# game/script.rpy:3273
translate ukr ch6_9e2f690d:

    # p "I guess so. I'm just surprised..."
    p "Гадаю, що так. Я просто здивований..."

# game/script.rpy:3274
translate ukr ch6_e3fe1cd7:

    # p "I, um, really like... being around you... so I expected that to be true for your other friends, too."
    p "Мені, ем, дійсно подобається... бути з тобою поруч... так що я подумав, що і твої друзі мають себе почувати так само."

# game/script.rpy:3275
translate ukr ch6_81608c29:

    # w "Hmm..."
    w "Хмм..."

# game/script.rpy:3277
translate ukr ch6_04156cdb:

    # w "I'd say you're probably the closest I've ever been with someone."
    w "Я б сказав, що найближча до мене людина за все моє життя - це ти."

# game/script.rpy:3278
translate ukr ch6_291e005a:

    # w "...Literally speaking."
    w "...Буквально."

# game/script.rpy:3282
translate ukr ch6_ba9915e5:

    # n "They laugh together, then fall into a comfortable silence..."
    n "Вони засміялись разом, після чого запанувала затишна тиша..."

# game/script.rpy:3283
translate ukr ch6_34bec6e3:

    # n "With their heads leaned together, Periwinkle nuzzles his face into Pastille's shoulder affectionately."
    n "Схиливши голову, Барвінок ласкаво утикається обличчям в плече Пастила."

# game/script.rpy:3284
translate ukr ch6_7680a727:

    # n "After a few moments, Pastille asks..."
    n "Через кілька хвилин Пастиль питає..."

# game/script.rpy:3287
translate ukr ch6_7e4e52b8:

    # p "Do you... wanna get in bed?"
    p "Чи не хочеш ти... перебратись у ліжко?"

# game/script.rpy:3288
translate ukr ch6_08b40548:

    # w shutin teehee "For sleep, or for pleasure?"
    w shutin teehee "Заради сну чи заради задоволення?"

# game/script.rpy:3289
translate ukr ch6_275c3be8:

    # p omg "U-um, that's up to you...!" with vpunch
    p omg "Е-ем, це залежить від тебе!.." with vpunch

# game/script.rpy:3291
translate ukr ch6_1609c48e:

    # n "Periwinkle stands, then turns around to take Pastille's hands."
    n "Барвінок встає і повертається обличчям до Пастиля, аби взяти його за руки."

# game/script.rpy:3292
translate ukr ch6_a6d0b21a:

    # w shutin "Come, then."
    w shutin "Тоді ходімо."

# game/script.rpy:3297
translate ukr ch6_e0c4b6a5:

    # n "He leads him into the bedroom, closing the door behind them."
    n "Він веде Пастила у спальню і зачиняє за ними двері."

# game/script.rpy:3298
translate ukr ch6_17bd39fe:

    # n "When he does, Pastille speaks up again..."
    n "Коли він це робить, Пастиль знову говорить..."

# game/script.rpy:3301
translate ukr ch6_90e29b25:

    # p "You know... I'm still finding it hard to believe there's no one else you're close to."
    p "Знаєш... Досі важко повірити, що в тебе так мало близьких людей."

# game/script.rpy:3302
translate ukr ch6_25de1dd0:

    # w shutin "Hm~? Two is a reasonable number."
    w shutin "Хм~? Двоє - доволі непогане число."

# game/script.rpy:3303
translate ukr ch6_48ef453d:

    # w calm "You had two friends as well, did you not? Syrup and Gumdrop."
    w calm "В тебе теж двоє друзів, чи не так? Сироп та Мармеладка."

# game/script.rpy:3304
translate ukr ch6_dcd034df:

    # p sure "Fair point... but counting YOU makes three."
    p sure "Справедливе зауваження... але якщо врахувати ТЕБЕ, то вийде троє."

# game/script.rpy:3305
translate ukr ch6_1da53c55:

    # w love "Ah, you have me beat. Perhaps I should try harder to catch up."
    w love "Ах, ти мене переміг. Гадаю, я маю постаратись і тебе наздогнати."

# game/script.rpy:3308
translate ukr ch6_c5a565be:

    # n "Periwinkle collapses into bed, while Pastille sits down beside him."
    n "Барвінок падає на ліжко, Пастиль сідає за ним."

# game/script.rpy:3311
translate ukr ch6_85981fc3:

    # w "I think I've preferred it, though. Keeping a healthy distance from others..."
    w "Я думав, що мені просто так зручніше - тримати здорову дистанцію від інших..."

# game/script.rpy:3312
translate ukr ch6_43989462:

    # p "Really? How come?"
    p "Дійсно? Чому ж так?"

# game/script.rpy:3313
translate ukr ch6_a40f3b27:

    # w "The alternative has been disastrous in my experience. I'm far too intense."
    w "Зі свого досвіду знаю, що якась інша поведінка перетворилась би на катастрофу. Я занадто палкий."

# game/script.rpy:3314
translate ukr ch6_c4dfb99a:

    # p "Ha, what do you mean by THAT...?"
    p "Ха, що ти маєш на увазі?.."

# game/script.rpy:3315
translate ukr ch6_d85fd387:

    # w "Goodness, my best example is the worst one..."
    w "Чорт, найкращим прикладом буде якраз найгірший випадок..."

# game/script.rpy:3317
translate ukr ch6_0c4b9b3e:

    # w "In my teenage years... there was a boy I would've done anything for."
    w "Коли я ще був підлітком... то спілкувався з одним хлопцем, заради якого міг зробити що завгодно."

# game/script.rpy:3318
translate ukr ch6_567cfdcb:

    # w "I wanted his approval so badly. I wanted to be loved."
    w "Я так хотів його уваги і похвали. Я хотів, аби мене кохали."

# game/script.rpy:3319
translate ukr ch6_53f3ef0f:

    # w "...It's funny, I can't even think of what drew me to him."
    w "...Смішно, що я навіть не можу згадати, що мене в ньому приваблювало."

# game/script.rpy:3321
translate ukr ch6_b214fa05:

    # w "I suppose he was just a vessel to project onto. An idealized boyfriend, this... shortcut to happiness."
    w "Гадаю, що він просто слугував предметом, на який я міг проектувати свої власні бажання. Ідеалізований бойфренд, такий собі... короткий шлях до щастя."

# game/script.rpy:3322
translate ukr ch6_1201679b:

    # w "Hmhm... poor guy. He didn't know what to do with the torrent of feelings I'd been forcing onto him. We were young."
    w "Хмхм... бідолаха. Він не знав, що робити з цією бурхливою хвилею почуттів, що я виливав на нього. Ми були дуже юні."

# game/script.rpy:3323
translate ukr ch6_7ae36a53:

    # w "A love like that is much too painful. If it can even be called love...."
    w "Така любов приносить занадто багато болі. Якщо це взагалі можна назвати любов'ю...."

# game/script.rpy:3325
translate ukr ch6_4235f80c:

    # w "It took some practice to be able to separate the emotions out."
    w "Потрібен був певний час, аби я зміг навчитися фільтрувати емоції."

# game/script.rpy:3326
translate ukr ch6_094487a5:

    # w "To be able to indulge in the romantic and sexual energy I craved, while protecting my fragile heart..."
    w "Все заради того, аби насолодитись романтичними та сексуальними почуттями, яких я жадав, і при цьому захистити моє ніжне серце..."

# game/script.rpy:3327
translate ukr ch6_c9592a6d:

    # w "But, ever since I figured it out, I've gotten to experience all sorts of love through these casual flings~"
    w "Але з тих пір, як я цьому навчився, я відчув всі види любові - у формі ось таких скоробіжних зв'язків~"

# game/script.rpy:3328
translate ukr ch6_bd22f0ce:

    # w "(What am I saying...?)"
    w "(Що за дурню я несу?..)"

# game/script.rpy:3329
translate ukr ch6_b87e6b7a:

    # w "It's perfect for me 💙 The ideal life, really."
    w "Це мені найбільш пасує 💙 Ідеальне життя, так би мовити."

# game/script.rpy:3330
translate ukr ch6_694c6d8c:

    # w "(Don't listen to me, Pastille....)"
    w "(Не слухай мене, Пастиле....)"

# game/script.rpy:3335
translate ukr ch6_a29244df:

    # p "Hmm..."
    p "Хмм..."

# game/script.rpy:3336
translate ukr ch6_884754a7:

    # p smile "I don't know if your heart is as fragile as you think."
    p smile "Не знаю, чи дійсно в тебе серце настільки ніжне, як тобі здається."

# game/script.rpy:3337
translate ukr ch6_cb22988c:

    # w shutin love "You don't believe me? Despite what it seems, I have the heart of an innocent maiden~!"
    w shutin love "Ти не віриш мені? Незважаючи на те, яким я можу здаватися, серце в мене як у невинної діви!~"

# game/script.rpy:3338
translate ukr ch6_1dece50f:

    # p sure "Haha, I don't know about innocent, but..."
    p sure "Хаха, не знаю, як щодо невинної, але..."

# game/script.rpy:3342
translate ukr ch6_ea6c8d9d:

    # n "Pastille leans forward and lays his head on Periwinkle's chest."
    n "Пастиль нахиляється і кладе голову на груди Барвінка."

# game/script.rpy:3343
translate ukr ch6_192176bb:

    # p "...Sounds pretty strong to me."
    p "...Звучить як сильне серце, як на мене."

# game/script.rpy:3344
translate ukr ch6_075d682d:

    # w "...!!"
    w "...!!"

# game/script.rpy:3346
translate ukr ch6_77261c10:

    # p "Ah, it's beating harder now."
    p "Ах, тепер воно стукає гучніше."

# game/script.rpy:3348
translate ukr ch6_51fe2183:

    # w "B-because you suddenly embraced me! See, this is what I mean by fragile...!" with vpunch
    w "Т-тому що ти зненацька мене обійняв! Ось бачиш, що я мав на увазі під \"ніжним\"!.." with vpunch

# game/script.rpy:3351
translate ukr ch6_afbec36c:

    # n "Periwinkle struggles out from under him, and the pair sits facing each other on the bed."
    n "Барвінок вивертається з-під Пастила і тепер вони обидва сидять на ліжку, дивлячись один на одного."

# game/script.rpy:3354
translate ukr ch6_f8a67d56:

    # p "You know... at first, I thought romantic stuff was just a formality for you. But you actually love it, huh?"
    p "Знаєш... спочатку я думав, що всі романтичні жести для тебе були лише формальністю. Але вони дійсно тобі подобаються, так?"

# game/script.rpy:3355
translate ukr ch6_9c15c768:

    # w shutin love "Are you only realizing that NOW?"
    w shutin love "Ти тільки ЗАРАЗ це зрозумів?"

# game/script.rpy:3356
translate ukr ch6_35b3829b:

    # p ehe "Haha, I guess not...."
    p ehe "Хаха, напевно, ні...."

# game/script.rpy:3360
translate ukr ch6_d170010a:

    # "What are you trying to say, Pastille?"
    "Що ти хочеш цим сказати, Пастиле?"

# game/script.rpy:3361
translate ukr ch6_736befba:

    # "That it's okay for me to love you...?"
    "Що нічого страшного в тому, що я тебе кохаю?.."

# game/script.rpy:3362
translate ukr ch6_310f8fb1:

    # "That I'll be safe?"
    "Що я буду в безпеці?"

# game/script.rpy:3363
translate ukr ch6_76b2fe88_9:

    # nvl clear
    nvl clear

# game/script.rpy:3366
translate ukr ch6_94871324:

    # w "Then, hurry up and kiss me."
    w "Тоді не тягни вже і поцілуй мене."

# game/script.rpy:3368
translate ukr ch6_4a8350ae:

    # p "Okay ❤ Sorry to keep you waiting."
    p "Гаразд ❤ Вибач, що змусив чекати."

# game/script.rpy:3370
translate ukr ch6_d66b3318:

    # n "Pastille closes the distance between them..."
    n "Пастиль зменшує дистанцію між ними..."

# game/script.rpy:3371
translate ukr ch6_54a35ace:

    # "I'm too weak."
    "Я занадто слабкий."

# game/script.rpy:3372
translate ukr ch6_139334f1:

    # "The words won't come out..."
    "Я не можу і слова сказати..."

# game/script.rpy:3373
translate ukr ch6_76b2fe88_10:

    # nvl clear
    nvl clear

# game/script.rpy:3375
translate ukr ch6_0f7e6da5:

    # n "As they kiss, Periwinkle becomes more and more entangled in his thoughts..."
    n "І поки вони цілуються, Барвінок все більше поринає у свої думки..."

# game/script.rpy:3376
translate ukr ch6_f42e65a6:

    # "Ahh, it hurts...!"
    "Ахх, як це боляче!.."

# game/script.rpy:3377
translate ukr ch6_d63ae36a:

    # "I want to be even closer...."
    "Мені хочеться бути ще ближчим...."

# game/script.rpy:3378
translate ukr ch6_76b2fe88_11:

    # nvl clear
    nvl clear

# game/script.rpy:3380
translate ukr ch6_341a3f02:

    # n "He lets himself fall backward, bringing Pastille down with him."
    n "Він дозволяє собі впасти на спину, і тягне Пастиля за собою."

# game/script.rpy:3381
translate ukr ch6_443d47e5:

    # "This isn't nearly enough to satisfy me..."
    "Цього недостатньо, мені потрібно ще більше..."

# game/script.rpy:3382
translate ukr ch6_c8df87cf:

    # "Just, please, don't stop...."
    "Просто, будь ласка, не зупиняйся...."

# game/script.rpy:3383
translate ukr ch6_76b2fe88_12:

    # nvl clear
    nvl clear

# game/script.rpy:3387
translate ukr ch6_cb671a59:

    # n "Periwinkle's heart cried out..."
    n "Серце Барвінка кричить..."

# game/script.rpy:3388
translate ukr ch6_a66018f1:

    # n "His jumbled emotions caught in his throat, manifesting through his hands, clinging desperately to Pastille..."
    n "Його змішані емоції застрягають в горлі, змушуючи його руки відчаянно чіплятись за Пастиля..."

# game/script.rpy:3389
translate ukr ch6_5f6ba41c:

    # n "...who continued to kiss him and hold him through the night."
    n "...який продовжував його цілувати та міцно притискати до себе всю ніч."

# game/script.rpy:3400
translate ukr ch7_7b49a2da:

    # centered "{w=3}{nw}"
    centered "{w=3}{nw}"

# game/script.rpy:3405
translate ukr ch7_6f509ab8:

    # n "The next morning, Periwinkle steps out onto his doorstep with a heavy sigh."
    n "Наступного ранку Барвінок виходить з дому і важко зітхає."

# game/script.rpy:3407
translate ukr ch7_a6ad8caa:

    # w hood empty "(If I lay around in bed all day, I'll only feel more miserable...)"
    w hood empty "(Якщо я пролежу у ліжку весь день, то буду відчувати себе жахливо...)"

# game/script.rpy:3408
translate ukr ch7_bfb25d37:

    # w oops "(I need to stop avoiding my work. I have to talk to Astragalus....)"
    w oops "(Мені треба перестати ухилятися від своєї роботи. І поговорити нарешті з Астрагал....)"

# game/script.rpy:3409
translate ukr ch7_3eb69f61:

    # w empty "(She isn't going to be pleased with me though....)"
    w empty "(Хоча наврядче вона буде рада цим новинам....)"

# game/script.rpy:3411
translate ukr ch7_c0771f75:

    # n "Holding his mantle tightly, he makes his way to the apothecary..."
    n "Міцно тримаючись за мантію, Барвінок прямує до аптеки..."

# game/script.rpy:3419
translate ukr ch7_ec45006e:

    # n "When he arrives, Astragalus is preoccupied with arranging some of her merchandise."
    n "Коли він прийшов, Астрагал була зайнята розкладанням ліків по поличкам."

# game/script.rpy:3420
translate ukr ch7_2eb737f5:

    # n "She turns abruptly at the unexpected sound of the door's chime."
    n "Вона різко повертається через несподіваний звук двірного дзвінка."

# game/script.rpy:3423
translate ukr ch7_23102229:

    # a augh "Hey, we're not open yet--!" with vpunch
    a augh "Хей, ми взагалі-то ще зачинені!-" with vpunch

# game/script.rpy:3425
translate ukr ch7_21ae3d6f:

    # a hm "...Huh? Periwinkle?"
    a hm "...А? Барвінок?"

# game/script.rpy:3426
translate ukr ch7_0cfdf83c:

    # w hood decline "Good morning, Astragalus."
    w hood decline "Доброго ранку, Астрагал."

# game/script.rpy:3427
translate ukr ch7_ca42047f:

    # a uh "I haven't seen you all month--I barely recognized you under that hood!"
    a uh "Я тебе цілий місяць не бачила - і ледве впізнала тебе під цим капюшоном!"

# game/script.rpy:3428
translate ukr ch7_a59d0c89:

    # a augh "I was about to come and knock on your damn door if you didn't show your face here soon. You've got a huge backlog of orders waiting!"
    a augh "Я вже хотіла йти до твого чортового дому і стукати в двері, аби ти нарешті з'явився. На тебе чекає купа замовлень!"

# game/script.rpy:3429
translate ukr ch7_6328fc6a:

    # w empty "...I can't take them. My magic is useless."
    w empty "...Я не зможу їх виконати. Моя магія абсолютно нікчемна."

# game/script.rpy:3430
translate ukr ch7_709a7b6c:

    # a uh "Whaddaya mean, \"useless\"?"
    a uh "В сенсі \"нікчемна\"?"

# game/script.rpy:3431
translate ukr ch7_78308c9b:

    # n "Periwinkle meekly hands over one of his pale pink vials."
    n "Барвінок несміливо протягує флакончик з блідо-рожевою рідиною."

# game/script.rpy:3432
translate ukr ch7_e6a68b87:

    # w ohhh "This is all I can make... it's been this way for ages."
    w ohhh "Це все, що я можу створити... і це триває вже дуже довго."

# game/script.rpy:3433
translate ukr ch7_c42de9e7:

    # a whatever "*sigh* Let's see..."
    a whatever "*позіхає* Гаразд, давай подивимось..."

# game/script.rpy:3434
translate ukr ch7_60a7f254:

    # n "Astragalus unscrews the top, and eyes Periwinkle suspiciously before giving it a whiff..."
    n "Астрагал відкриває флакончик і з підозрою дивиться на Барвінка, перш ніж понюхати..."

# game/script.rpy:3435
translate ukr ch7_0d690c65:

    # a uh "Whew, that's powerful!!" with vpunch
    a uh "Вау, воно міцне!!" with vpunch

# game/script.rpy:3436
translate ukr ch7_2b253749:

    # a think "Not bad, though... warms me right up. Could stand to be diluted a little, just to make it less overwhelming..."
    a think "Але, насправді, непогана річ... одразу зігріває. Можна було б трохи розбавити, аби аромат не був таким міцним..."

# game/script.rpy:3437
translate ukr ch7_40f53860:

    # a lol "So. What's got you stuck on a scent like this?"
    a lol "Так. І через кого ти застряг на цьому ароматі?"

# game/script.rpy:3438
translate ukr ch7_de42c61a:

    # w ohhh2 "...It's Pastille...."
    w ohhh2 "...Це все Пастиль...."

# game/script.rpy:3439
translate ukr ch7_0381a0e1:

    # w whine2 "He's ruined me! I'll never be able to return to the way I was before...!"
    w whine2 "Він мене зруйнував! Я ніколи не зможу знову стати таким, як раніше!.."

# game/script.rpy:3440
translate ukr ch7_4bd0f1d4:

    # a closed "I see. So things got complicated, just like I warned you."
    a closed "Я бачу. Так все ускладнилось, як я тебе і попереджала."

# game/script.rpy:3441
translate ukr ch7_1fb3e795:

    # w cwy "Mhm... *sniffle*..."
    w cwy "Мхм... *хлюп* ..."

# game/script.rpy:3442
translate ukr ch7_6be39aa2:

    # w cwy2 "I-I love him so much, I think I might die...."
    w cwy2 "Я-я так сильно його кохаю, мені здається, що я помру...."

# game/script.rpy:3443
translate ukr ch7_48204255:

    # a neutral "Come on... Back room. Now."
    a neutral "Давай... До іншої кімнати. Негайно."

# game/script.rpy:3447
translate ukr ch7_7d77e570:

    # n "Periwinkle nods and obediently follows Astragalus into her private office..."
    n "Барвінок киває і слухняно слідує за Астрагал до її приватного офісу..."

# game/script.rpy:3452
translate ukr ch7_1be0328f:

    # n "He quietly takes in his surroundings before she suddenly turns to him with a raised finger."
    n "Він мовчазно озирається і розглядає кімнату, поки Астрагал раптом не повертається до нього з піднятим пальцем."

# game/script.rpy:3454
translate ukr ch7_170b612d:

    # a "Don't touch anything."
    a "Нічого не чіпай."

# game/script.rpy:3455
translate ukr ch7_90a8c977:

    # w hood ohhh "...?"
    w hood ohhh "...?"

# game/script.rpy:3457
translate ukr ch7_020bb483:

    # n "Astragalus drags a bean bag chair out from the corner and plops it in the middle of the room unceremoniously."
    n "Астрагал витягає з кутка крісло-мішок і безцеремонно кидає його посередині кімнати."

# game/script.rpy:3459
translate ukr ch7_507ec09a:

    # a "Sit."
    a "Сідай."

# game/script.rpy:3460
translate ukr ch7_e6ea4d0e:

    # w hood ohhh "...It's dusty...."
    w hood ohhh "...Воно пильне...."

# game/script.rpy:3461
translate ukr ch7_44201857:

    # a augh "UGH, you're such a diva..."
    a augh "Чорт забирай, ну що ти за примадонна..."

# game/script.rpy:3462
translate ukr ch7_c4c193b3:

    # n "She gives it a couple good smacks, beating the dust into the air instead."
    n "Вона кілька разів міцно вдаряє по кріслу, вибиваючи з нього пил."

# game/script.rpy:3463
translate ukr ch7_c411bd45:

    # a annoyed "...NOW sit."
    a annoyed "...ТЕПЕР сідай."

# game/script.rpy:3464
translate ukr ch7_ca9dcc70:

    # w oops "Very well...."
    w oops "Гаразд..."

# game/script.rpy:3467
translate ukr ch7_86603b28:

    # n "He complies, and Astragalus spins her office chair around to face him."
    n "Він слухняно сідає, і Астрагал повертається до нього на своєму офісному кріслі."

# game/script.rpy:3470
translate ukr ch7_46e11470:

    # a "Alright, Periwinkle. Here's what's gonna happen."
    a "Гаразд, Барвінку. Слухай, що зараз буде."

# game/script.rpy:3471
translate ukr ch7_89a00474:

    # a "I'm gonna brew us up some tea, and you're gonna explain everything. From the beginning."
    a "Я заварю нам чай, і ти поясниш все, що сталося. З самого початку."

# game/script.rpy:3472
translate ukr ch7_0ccf1ed0:

    # w hood sorry "Explain what...?"
    w hood sorry "Пояснити все про що?.."

# game/script.rpy:3473
translate ukr ch7_0e7a98bb:

    # a "About Pastille. Even the stuff I already know. Everything, from the top."
    a "Ситуацію з Пастилем. Навіть те, що я вже знаю. Все. З самого початку і все, що було далі."

# game/script.rpy:3474
translate ukr ch7_30cf76fb:

    # w ohhh "Everything...?"
    w ohhh "Все-все?.."

# game/script.rpy:3475
translate ukr ch7_4f05ba39:

    # a "Skip the bedroom details, obviously. Just walk me through anything important that happened since you met."
    a "Ну звісно, без опису того, що у спальні відбувається. Просто розкажи по порядку про все важливе, що трапилось з моменту вашої першої зустрічі."

# game/script.rpy:3476
translate ukr ch7_c147a5e1:

    # w whine "I-I don't want to! Reliving it all is only going to make things worse...!"
    w whine "Я-я не хочу! Якщо я почну це все згадувати, то стане тільки гірше!.."

# game/script.rpy:3479
translate ukr ch7_d617b2fd:

    # n "Astragalus stands and walks over to her kettle to start the tea."
    n "Астрагал підіймається і підходить до чайнику, аби зробити чай."

# game/script.rpy:3481
translate ukr ch7_c88d1b30:

    # a "Alright, you lovesick dolt..."
    a "Гаразд, закоханий йолопе..."

# game/script.rpy:3482
translate ukr ch7_95976d4b:

    # a annoyed "You wanna know why exactly your magic's been stuck like that? It's because you don't have an outlet for all those emotions."
    a annoyed "Хочеш знати, чому твоя магія так себе поводить? Тому що ти не дозволяв собі випустити всі свої емоції."

# game/script.rpy:3483
translate ukr ch7_ea89bd51:

    # a closed "Instead, you keep bottling them up--literally, I guess. It's all that comes out because it's all there is inside you."
    a closed "І замість цього ти їх закоркував - гадаю, що буквально. Це все, що може вийти зовні, тому що всередині нічого іншого нема."

# game/script.rpy:3484
translate ukr ch7_61f43815:

    # w hood ohhh "...."
    w hood ohhh "...."

# game/script.rpy:3485
translate ukr ch7_4d08edac:

    # a lol2 "So, let it all out! What, you think I'm gonna judge you?"
    a lol2 "Так що давай, виплесни це! Чи думаєш, що я буду тебе засуджувати?"

# game/script.rpy:3486
translate ukr ch7_0e405e25:

    # w oops "No... I don't know."
    w oops "Ні... Я не знаю."

# game/script.rpy:3487
translate ukr ch7_a2f71b21:

    # a lol "Would you rather spill it all to him instead?"
    a lol "Хочеш тоді це все одразу йому розповісти?"

# game/script.rpy:3488
translate ukr ch7_237d6381:

    # w cwy "I can't...! It's too much!"
    w cwy "Я не можу!.. Це занадто!"

# game/script.rpy:3489
translate ukr ch7_61ef0d5e:

    # a sure "Then tell it to me, a neutral third party."
    a sure "Тоді розкажи мені - я нейтральна і незацікавлена сторона."

# game/script.rpy:3490
translate ukr ch7_5df175e3:

    # a uh "Actually, I can't say that I'm neutral... I'd need to find a new supplier if you couldn't fill my orders anymore."
    a uh "Хоча не можу сказати, що я взагалі незацікавлена... Якщо ти не зможеш виконувати мої замовлення, мені доведеться шукати іншого постачальника."

# game/script.rpy:3491
translate ukr ch7_3a7ea07c:

    # w oops "I do feel a little more at ease imagining this is all a business matter for you...."
    w oops "Коли я уявляю, що для тебе це лише питання бізнесу, то стає трохи простіше...."

# game/script.rpy:3492
translate ukr ch7_969f721a:

    # a smile "Then just think of it like that."
    a smile "Тоді саме так і думай."

# game/script.rpy:3494
translate ukr ch7_e9b2e9b2:

    # n "Astragalus pours their tea and returns to her seat with two mugs in hand."
    n "Астрагал наливає чай і повертається на місце з двома кухлями в руках."

# game/script.rpy:3495
translate ukr ch7_a98ff37d:

    # n "With a heavy sigh, Periwinkle finally relents and begins his story..."
    n "Барвінок тяжко позіхає, і нарешті починає розповідати свою історію..."

# game/script.rpy:3501
translate ukr ch7_d30066c5:

    # "I told her everything I could think of..."
    "Я розповів їй все, що тільки міг згадати..."

# game/script.rpy:3502
translate ukr ch7_33d9f84f:

    # "My first impressions of him. How he continuously subverted my expectations."
    "Мої перші враження. Як він постійно перевершував мої очікування."

# game/script.rpy:3503
translate ukr ch7_c5f52926:

    # "My mistakes. Appearing where I shouldn't have, then going into a desperate spiral as I tried to rid myself of the guilt over it."
    "Мої помилки. Як я з'явився там, де не був повинен з'являтись; і потім потонув у спіралі відчаю, поки намагався позбавитись почуття провини."

# game/script.rpy:3504
translate ukr ch7_1bbf690f:

    # "How he was the one to come to apologize afterward..."
    "Як йому довелося робити перший крок та вибачатися..."

# game/script.rpy:3505
translate ukr ch7_c5838a34:

    # nvl clear
    # "Our date that day, which was so, so wonderful... but which also laid bare the feelings I was too afraid to acknowledge."
    nvl clear
    "Наше побачення наступного дня, яке було неймовірним... але воно оголило почуття, які я боявся визнати."

# game/script.rpy:3507
translate ukr ch7_e6e49546:

    # "How I latched on to any alternative explanation I could in order to escape them."
    "Як я хапався за будь-яке альтернативне пояснення, яке тільки міг вигадати, аби від них втекти."

# game/script.rpy:3508
translate ukr ch7_4e84de73:

    # "The moment I could finally admit it to myself. All the ways he'd changed my life for the better."
    "Момент, коли я нарешті зміг бути чесним з собою. І наскільки це змінило моє життя на краще."

# game/script.rpy:3509
translate ukr ch7_6a07a020:

    # "How we grew closer and closer, while I held those feelings tighter to my chest..."
    "Як ми ставали все ближчими і ближчими, і як я намагався заховати ці почуття якомога далі..."

# game/script.rpy:3510
translate ukr ch7_d4484d1e:

    # nvl clear
    # "I told her how he had finally worked up the courage to introduce me to his friends."
    nvl clear
    "Я розповів їй, що він нарешті набрався хоробрості познайомити мене зі своїми друзями."

# game/script.rpy:3512
translate ukr ch7_65da988b:

    # "How his hand trembled in mine as we walked out the door together."
    "Як його рука тремтіла у моїй, коли ми разом вийшли з Ательє."

# game/script.rpy:3513
translate ukr ch7_ee6b35c9:

    # "This point of contention, a far-off goal I had decided would have to be met before advancing..."
    "Ця далека мета, яку я мав досягнути, перш ніж ми зможемо розвивати стосунки далі..."

# game/script.rpy:3514
translate ukr ch7_ca54ab44:

    # "Everything, up to the state I'm in now. Useless, paralyzed, and sobbing."
    "Все, аж до того стану, у якому я знаходжусь зараз. Весь у сльозах, заціпенілий та нікчемний."

# game/script.rpy:3515
translate ukr ch7_92f40e14:

    # nvl clear
    # "Astragalus listened patiently through all of it."
    nvl clear
    "Астрагал терпляче слухала мене весь цей час."

# game/script.rpy:3517
translate ukr ch7_343d2423:

    # "She asked questions from time to time. Clarification on the timeframe, certain details..."
    "Іноді вона задавала питання. Уточнювала час та деякі деталі..."

# game/script.rpy:3518
translate ukr ch7_87e644fe:

    # "Her reaffirming comments offered such comfort, such relief to this pain I'd kept confined to my own heart."
    "Підбадьорливі коментарі від неї несли таку втіху... І полегшували біль, який я настільки довго тримав у своєму серці."

# game/script.rpy:3519
translate ukr ch7_b69014f7:

    # "Until finally, I had nothing left to say."
    "І, нарешті, настав момент, коли мені було нічого розповідати."

# game/script.rpy:3520
translate ukr ch7_d27b4990:

    # nvl clear
    # n "Astragalus sits back in her chair and heaves a sigh."
    nvl clear
    n "Астрагал відкидується на спинку крісла і важко позіхає."

# game/script.rpy:3524
translate ukr ch7_a8670c2a:

    # a "So? How are you feeling?"
    a "Так що? Як ти себе почуваєш?"

# game/script.rpy:3525
translate ukr ch7_04d072f1:

    # w hood oh2 "There's a certain clarity in laying it all out at once..."
    w hood oh2 "Коли ось так все одразу розповідаєш, то дещо прояснюється..."

# game/script.rpy:3526
translate ukr ch7_547bdb80:

    # w ohhh "But, I still... don't know what I can do to push things forward... could I even handle the rejection...?"
    w ohhh "Але я все одно... не знаю, що зробити, аби перевести наші стосунки на новий етап... і чи зможу я пережити відмову?.."

# game/script.rpy:3527
translate ukr ch7_a359177e:

    # a eyeroll "He won't reject you."
    a eyeroll "Він тобі не відмовить."

# game/script.rpy:3528
translate ukr ch7_229785e7:

    # w sorry "What makes you so certain...?"
    w sorry "Чому ти так у цьому впевнена?.."

# game/script.rpy:3529
translate ukr ch7_47ddd304:

    # a lmao "That boy is madly in love with you!! Why else would he devote all that time and energy to making you happy?"
    a lmao "Цей хлопець закоханий у тебе до нестями!! Інакше чому б тоді він витрачав стільки часу і сил на те, аби зробити тебе щасливим?"

# game/script.rpy:3530
translate ukr ch7_a282e00e:

    # w pout "Because I'm great in bed! Obviously!!" with vpunch
    w pout "Ну все ж зрозуміло! Тому що я неймовірний у ліжку!!" with vpunch

# game/script.rpy:3531
translate ukr ch7_7d78d80b:

    # a lol2 "Quit deflecting! You know that's not all it is."
    a lol2 "Припини ухилятися від правди! Ти чудово знаєш, що справа не лише в цьому."

# game/script.rpy:3532
translate ukr ch7_c44bc880:

    # w nofair2 "I don't want to leave any room for doubt... if I were to confess now, and it didn't go well, I'd... I'd be destroyed beyond repair!"
    w nofair2 "Я не хочу, аби в мене залишались якісь сумніви... якщо я зараз вирішу зізнатися, і все піде не так, я... мене це просто знищить!"

# game/script.rpy:3533
translate ukr ch7_699f61db:

    # w nofair "That's why, if I'm going to say it, I want it to be a sure thing."
    w nofair "І тому, якщо я вирішу зізнатись - то хочу отримати одну-єдину однозначну відповідь."

# game/script.rpy:3534
translate ukr ch7_70aa9f4c:

    # a sure "Life ain't about \"sure things\"."
    a sure "Життя - це не про \"однозначні відповіді\"."

# game/script.rpy:3535
translate ukr ch7_1ce1b2b1:

    # w oops "Even so. I'm going to wait for the opportune moment before exposing my vulnerable heart...."
    w oops "Ну то й що. Я краще дочекаюсь гідного моменту, перш ніж відкривати для нього своє ніжне серце..."

# game/script.rpy:3536
translate ukr ch7_67d2fe6a:

    # a eyeroll "As long as you've got a plan."
    a eyeroll "Ну, головне, аби зізнання входило в твої плани."

# game/script.rpy:3538
translate ukr ch7_5c6e9d30:

    # n "Astragalus leans down to pick up Periwinkle's empty mug, then holds it out in front of him."
    n "Астрагал нахиляється, бере зі столу порожній кухоль Барвінка і протягує йому."

# game/script.rpy:3539
translate ukr ch7_05b45148:

    # a happy "Try your magic again. Whatever scent you want, just pour it right in the cup."
    a happy "Спробуй знову скористатись своєю магією. Будь-який аромат, що тебе на думку спаде, просто крапни його сюди."

# game/script.rpy:3540
translate ukr ch7_61f43815_1:

    # w hood ohhh "...."
    w hood ohhh "...."

# game/script.rpy:3544
translate ukr ch7_bffebb26:

    # n "Periwinkle nervously draws his wand, holds it out to the cup... then closes his eyes, and taps."
    n "Барвінок, хвилюючись, витягає паличку, простягає її над чашкою... і потім закриває очі і легенько стукає."

# game/script.rpy:3547
translate ukr ch7_62bd9f4e:

    # w hood ohhh2 "...Is it...?"
    w hood ohhh2 "...І це?.."

# game/script.rpy:3548
translate ukr ch7_31d796dc:

    # a "...."
    a "...."

# game/script.rpy:3549
translate ukr ch7_a378f6db:

    # a hm "Chamomile?"
    a hm "Ромашка?"

# game/script.rpy:3550
translate ukr ch7_a5fd1669:

    # w my "It isn't peach...!"
    w my "Це не персик!.."

# game/script.rpy:3551
translate ukr ch7_48779aee:

    # w happy "I-I'm cured!!" with vpunch
    w happy "Я-я вилікувався!!" with vpunch

# game/script.rpy:3552
translate ukr ch7_c8bd051e:

    # a lol2 "Yeah, dumbass! Did you forget this is an apothecary?"
    a lol2 "Звісно, дурнику! Чи ти забув, що знаходишся в аптеці?"

# game/script.rpy:3553
translate ukr ch7_15718a3f:

    # w ohdear "Ah... it is, isn't it...."
    w ohdear "Ах... звісно ж...."

# game/script.rpy:3554
translate ukr ch7_21466243:

    # a eyeroll "Next time you've got a problem with your magic, don't sit around crying about it on your own. Come straight to me, and I'll fix you up."
    a eyeroll "Якщо в тебе знову виникнуть проблеми з магією, то не рюмсай на самоті. Одразу приходь до мене, і я приведу тебе до ладу."

# game/script.rpy:3555
translate ukr ch7_ba5c6de9:

    # w love "Thank you... I..."
    w love "Дякую тобі... Я..."

# game/script.rpy:3556
translate ukr ch7_44e91ae4:

    # w shy "I'm truly glad that we're friends... I would be lost without you."
    w shy "Я дійсно радий тому, що ми дружимо... Без тебе я б зовсім пропав."

# game/script.rpy:3557
translate ukr ch7_4ffcdd35:

    # a sure "Business associates. Don't forget I've got loads of orders for you now that you're back to normal."
    a sure "Ми партнери по бізнесу. Не забувай, тепер, коли ти повернувся до норми, на тебе чекає купа замовлень."

# game/script.rpy:3558
translate ukr ch7_b19f23d3:

    # w happy "I'll go home and fill them right away! But first..."
    w happy "Я прийду додому і одразу їх виконаю! Але спочатку..."

# game/script.rpy:3559
translate ukr ch7_9d2c05b0:

    # w love "May I hug you?"
    w love "Можна тебе обійняти?"

# game/script.rpy:3560
translate ukr ch7_04792b09:

    # a augh "Not a chance!" with vpunch
    a augh "Ні в якому разі!" with vpunch

# game/script.rpy:3561
translate ukr ch7_d733da0f:

    # w teehee "Hmhm, it was worth a shot. You'll accept my platonic affection one day~!"
    w teehee "Хмхм, але я мав спробувати. Колись ти приймеш мою платонічну симпатію!~"

# game/script.rpy:3562
translate ukr ch7_7f7593b0:

    # a happy "Yeah, yeah... get outta my office, Periwinkle."
    a happy "Ага, звісно... а тепер звали з мого офісу."

# game/script.rpy:3569
translate ukr ch7_875a28a9:

    # n "The pair exits the back room, but they only make it a few steps out before Periwinkle turns on his heel."
    n "Пара виходить з підсобки, але встигає пройти лише кілька кроків, перш ніж Барвінок повертається обличчям до Астрагал."

# game/script.rpy:3570
translate ukr ch7_4d17f35d:

    # w hood oh "Ah, one more thing, before I go..."
    w hood oh "Ах, перш ніж я пішов... Хотів ще дещо запитати."

# game/script.rpy:3572
translate ukr ch7_3f808ca6:

    # a "Hm? What's up."
    a "Хм? Що таке?"

# game/script.rpy:3573
translate ukr ch7_faf56b4e:

    # w smile "I've been curious to ask. The last time I was here, you told me that magic can be interpreted as a judge of one's character..."
    w smile "Мені стало цікаво. Останнього разу, коли я тут був, ти сказала, що за магією можна зробити певні висновки про характер її власника..."

# game/script.rpy:3574
translate ukr ch7_09ac5a27:

    # a think "Oh, right. When I changed my mind about Pastille."
    a think "Ох, дійсно. Коли я змінила свою думку щодо Пастиля."

# game/script.rpy:3575
translate ukr ch7_e02f8699:

    # w calm "Yes, precisely. It's rather impressive that you could see through to his true nature, despite having only just met..."
    w calm "Саме так. Мене дуже вразило, що ти змогла побачити його справжню натуру, незважаючи на те, що ви зустрілись в перший раз..."

# game/script.rpy:3576
translate ukr ch7_d75c0f1f:

    # a lol "Sure, but he was pretty easy to read. Don't be too impressed."
    a lol "Ага, але його характер побачити легко, так що не вражайся сильно."

# game/script.rpy:3577
translate ukr ch7_7bba75e2:

    # w love "...Well?"
    w love "...То що?"

# game/script.rpy:3578
translate ukr ch7_21235aed:

    # a lol2 "Well what?"
    a lol2 "Що що?"

# game/script.rpy:3579
translate ukr ch7_665ef7a8:

    # w happy "What does my magic say about me~? I'm dying to know 💙"
    w happy "Що моя магія говорить про мене?~ Я дуже хочу дізнатись 💙"

# game/script.rpy:3580
translate ukr ch7_f33dfb60:

    # a sure "YOUR magic... was always lively and carefree. Compassionate, too. Like Pastille's."
    a sure "ТВОЯ магія... завжди була безтурботною та повною життя. І співчутливою, як у Пастиля."

# game/script.rpy:3581
translate ukr ch7_08b17c47:

    # w love "How can you possibly read something like \"carefree\" from perfume?"
    w love "Як ти можеш дізнатись про щось накшталт \"безтурботності\" з парфуму?"

# game/script.rpy:3582
translate ukr ch7_e94ff0db:

    # a lol "Hey, I'm just telling you the vibes I've gotten over the years."
    a lol "Хей, я просто говорю про свої враження, які в мене склались за ці роки."

# game/script.rpy:3583
translate ukr ch7_a2de6d44:

    # a think "Your aromas prioritize pleasure. But there was definitely a hint of loneliness in them, too..."
    a think "В основі твоїх ароматів майже завжди лежить насолода. Але в них також була і нотка самотньості..."

# game/script.rpy:3584
translate ukr ch7_d8043053:

    # w teehee "Alright, now I KNOW you're making things up. I've always had someone to keep me company 💙"
    w teehee "Гаразд, тепер я ЗНАЮ, що ти все вигадуєш. У мене завжди був хтось, хто міг провести зі мною час 💙"

# game/script.rpy:3585
translate ukr ch7_15310979:

    # a smile "Just because you've always got someone around doesn't mean you can't be lonely."
    a smile "Те, що з тобою завжди був хтось поруч, не означає, що тобі не було самотньо."

# game/script.rpy:3586
translate ukr ch7_c61d8bb7:

    # w calm "And I suppose someone like you would know a thing or two about loneliness, hm?"
    w calm "І, гадаю, хтось накшталт тебе знає дещо про самотність з властного досвіду, хм?"

# game/script.rpy:3587
translate ukr ch7_c94c969b:

    # a hm "I'm not lonely at all. In fact, I PREFER to be alone."
    a hm "Я взагалі не самотня. Насправді, бути на самоті - це мій власний вибір."

# game/script.rpy:3588
translate ukr ch7_adf9c46f:

    # a closed "YOU on the other hand... can't stand it even for a second. That's why you'd always run off chasing someone to fill the void."
    a closed "А ось ти... ти на самоті не можеш протриматись навіть секунди. Ось чому ти завжди в погоні за кимось, хто може заповнити цю порожнечу."

# game/script.rpy:3589
translate ukr ch7_cd947219:

    # w ohdear "...Well THAT certainly isn't true."
    w ohdear "...Гаразд, ОСЬ ЦЕ абсолютно точно неправда."

# game/script.rpy:3590
translate ukr ch7_be244ae7:

    # a lol "The peach stuff you gave me earlier was PURE loneliness. It was crying out, like \"Please, Pastille, never leave me~!\""
    a lol "Та персикова штука, яку ти показав сьогодні - ЧИСТА, концентрована самотність. Вона неначе кричала \"Будь ласка, Пастиле, не залишай мене~!\""

# game/script.rpy:3591
translate ukr ch7_27338eed:

    # w pout "This isn't fun anymore. Forget that I asked!"
    w pout "Це вже зовсім не весело. Забудь, що я взагалі про це запитував!"

# game/script.rpy:3592
translate ukr ch7_11cf638a:

    # a happy "Sorry. Couldn't resist."
    a happy "Вибач. Не втрималась."

# game/script.rpy:3593
translate ukr ch7_7623f766:

    # w oops "...."
    w oops "...."

# game/script.rpy:3594
translate ukr ch7_b80c39a5:

    # w ohhh "I suppose you're right, though... I haven't been able to tell him that in words."
    w ohhh "Але, гадаю, ти маєш рацію... Я не зміг сказати йому про це словами."

# game/script.rpy:3595
translate ukr ch7_ad5bdd9e:

    # w nofair2 "I can't keep holding back... he has to know. No matter the outcome."
    w nofair2 "Я більше не можу приховувати правду... він має право знати. І неважливо, які у цього будуть наслідки."

# game/script.rpy:3596
translate ukr ch7_60359fd7:

    # a smile "Good luck, okay? I'm sure it'll turn out just fine."
    a smile "Удачі тобі. Але я впевнена, що все буде гаразд."

# game/script.rpy:3597
translate ukr ch7_a4d8dbdf:

    # w ohhh "Yes... yes, it likely will."
    w ohhh "Так... так, гадаю, що так і буде."

# game/script.rpy:3598
translate ukr ch7_0f7a9daf:

    # w shy "Thank you again... I'm truly grateful for all that you've done for me."
    w shy "Ще раз дякую... Я дійсно дуже вдячний за все, що ти для мене зробила."

# game/script.rpy:3603
translate ukr ch7_47504267:

    # n "Astragalus waves him off, and Periwinkle leaves the apothecary with new resolve..."
    n "Астрагал відмахується від нього, і Барвінок полишає аптеку, переповнений рішучістю..."

# game/script.rpy:3613
translate ukr ch7_8954e2f7:

    # "I spent the next several days catching up on my work."
    "Кілька наступних днів я провів, виконуючи замовлення."

# game/script.rpy:3614
translate ukr ch7_c124ee6b:

    # "Magic truly does come so easily with a clear mind! If only I'd swallowed my pride sooner."
    "Магію дійсно набагато легше використовувати, коли ти спокійний і голова не забита зайвими думками! Ох, якби я раніше переступив через свою гордість..."

# game/script.rpy:3615
translate ukr ch7_1e30c6c5:

    # "I completed batch after batch almost effortlessly, going down the long checklist Astragalus had given me..."
    "Я створював партію за партією згідно довгого списку, що дала мені Астрагал, майже без зусиль..."

# game/script.rpy:3616
translate ukr ch7_ba772060:

    # "I hadn't even felt tired by the end of it. As if all this energy had been stored up inside me all along!"
    "Я навіть не відчув втоми, коли покінчив з роботою. Таке відчуття, наче ця енергія накопичувалась у мені весь цей час!"

# game/script.rpy:3617
translate ukr ch7_2d728c30:

    # nvl clear
    # "It was a relief to return to somewhat normalcy."
    nvl clear
    "Те, що я більш-менш повернувся до нормального життя, було великим полегшенням."

# game/script.rpy:3619
translate ukr ch7_e65838f7:

    # "Thinking of Pastille no longer caused my heart to ache... at least, not enough to put me in a state of total despondence."
    "Думки про Пастиля більше не приносили мені болю... ну, вони хоча б не приводили мене до стану повного відчаю."

# game/script.rpy:3620
translate ukr ch7_b8bdf17b:

    # "Instead, those thoughts served as motivation. The way forward was clear."
    "Тепер думки слугували мені як джерело мотивації. Шлях вперед був ясний та прямий."

# game/script.rpy:3621
translate ukr ch7_975f7c4e:

    # "I would tell him how I felt... and surely..."
    "Я розповім йому про свої почуття... і звісно..."

# game/script.rpy:3622
translate ukr ch7_38f5635f:

    # nvl clear
    # w pj calm "Surely things will turn out just fine...."
    nvl clear
    w pj calm "І звісно, все буде гаразд...."

# game/script.rpy:3627
translate ukr ch7_94b11f24:

    # n "The following night... Pastille shows up on Periwinkle's doorstep."
    n "Наступної ночі... Пастиль з'явився у Барвінка на порозі."

# game/script.rpy:3629
translate ukr ch7_1810d3ec:

    # p "Get dressed. I wanna take you somewhere."
    p "Вдягайся. Я хочу декуди тебе відвести."

# game/script.rpy:3630
translate ukr ch7_89d40548:

    # w pj happy "Oh~ and where exactly am I being whisked away to? 💙"
    w pj happy "Ох~ І куди саме ти мене забираєш? 💙"

# game/script.rpy:3631
translate ukr ch7_f5ebb1d6:

    # p happy "You'll see. Wear comfortable shoes, okay?"
    p happy "Побачиш. Тільки надягни зручне взуття, гаразд?"

# game/script.rpy:3632
translate ukr ch7_cd6c9ac9:

    # w calm "How mysterious..."
    w calm "Як таємнично..."

# game/script.rpy:3633
translate ukr ch7_c60adcac:

    # w smile "Hmhm, very well. I'll be ready momentarily 💙"
    w smile "Хмхм, гаразд. Зачекай секунду 💙"

# game/script.rpy:3636
translate ukr ch7_98348ebf:

    # "This is it..."
    "Ось і настав цей момент..."

# game/script.rpy:3637
translate ukr ch7_09cbb0da:

    # "The dramatic confession scene is upon us!"
    "Перед нами розгортається сцена драматичного зізнання у коханні!"

# game/script.rpy:3638
translate ukr ch7_e135b4c9:

    # "I have to look my best! For good luck, of course."
    "Я маю виглядати якнайкраще! Заради того, аби мені пощастило, звісно."

# game/script.rpy:3639
translate ukr ch7_572f99bc:

    # "And for confidence...."
    "І аби мати більше впевненості...."

# game/script.rpy:3640
translate ukr ch7_76b2fe88:

    # nvl clear
    nvl clear

# game/script.rpy:3652
translate ukr ch7_28d525bc:

    # n "Hand in hand, the pair makes their way to the train station."
    n "Узявшись за руки, пара прямувала до залізничної станції."

# game/script.rpy:3653
translate ukr ch7_931bcf8a:

    # w cute innocent "(Hmhm~ had he been planning something while I was sequestered away with my work?)"
    w cute innocent "(Хмхм~ невже він щось напланував, поки я був поглинутий роботою?)"

# game/script.rpy:3654
translate ukr ch7_db582720:

    # w love "(Pastille is always so full of surprises... how positively delightful 💙)"
    w love "(Пастиль завжди сповнений сюрпризів... це вражаюче 💙)"

# game/script.rpy:3657
translate ukr ch7_b5146a9c:

    # p "I hope I didn't interrupt any plans you had for the night...."
    p "Сподіваюсь, я не зруйнував твої плани на ніч...."

# game/script.rpy:3658
translate ukr ch7_028375c7:

    # w happy "Oh, not at all~! It was about time I got out of the house again."
    w happy "Ох, зовсім ні!~ Я якраз збирався нарешті вийти з дому."

# game/script.rpy:3659
translate ukr ch7_dd0f85ec:

    # w smile "I've actually had a very productive past several days, you know. Toiling away over my perfumes."
    w smile "Знаєш, останні кілька днів в мене були дуже продуктивними. Я тільки і робив, що створював парфуми."

# game/script.rpy:3660
translate ukr ch7_dcf1b0e8:

    # p ehe "Haha, I thought that might be the case, since you hadn't dropped by in a while."
    p ehe "Хаха, я так і подумав - ти давно до мене не приходив."

# game/script.rpy:3661
translate ukr ch7_fb3a840a:

    # w innocent "Did you miss me? 💙"
    w innocent "Сумував за мною? 💙"

# game/script.rpy:3662
translate ukr ch7_13104245:

    # p embarrassed "W-well...."
    p embarrassed "Н-ну...."

# game/script.rpy:3664
translate ukr ch7_b1056d27:

    # n "Periwinkle hugs Pastille's arm tightly as they continue their walk."
    n "Барвінок міцно стискає руку Пастиля, поки вони продовжують свою прогулянку."

# game/script.rpy:3665
translate ukr ch7_9e455bb5:

    # w cute shy "(I missed you, too...)"
    w cute shy "(Я теж за тобою сумував...)"

# game/script.rpy:3668
translate ukr ch7_92a9892d:

    # "When Pastille and I step off the train, we're greeted by grassy fields and a sky full of luminous stars."
    "Коли ми з Пастилем виходимо з поїзда, то нас зустрічають поле трави та небо, повне яскравих зірок."

# game/script.rpy:3669
translate ukr ch7_1242c23a:

    # "Just where has he taken me...?"
    "І куди він мене привіз?.."

# game/script.rpy:3670
translate ukr ch7_924bc4f2:

    # "A trail of lanterns lights the lone path forward..."
    "Ланцюжок ліхтариків освітлює самотню доріжку..."

# game/script.rpy:3671
translate ukr ch7_27428714:

    # "Pastille takes the lead."
    "Пастиль йде першим."

# game/script.rpy:3672
translate ukr ch7_76b2fe88_1:

    # nvl clear
    nvl clear

# game/script.rpy:3675
translate ukr ch7_794d51f4:

    # p "It's a bit of a walk from here... but I promise it'll be worth it."
    p "Доведеться трохи пройтись... але, обіцяю, воно того варте."

# game/script.rpy:3676
translate ukr ch7_dd9f0107:

    # w cute love "A long walk, hm? Couldn't we take a ride on your broom together~?"
    w cute love "Довга прогулянка, хм? Ми хіба не можемо полетіти на твоїй метлі?~"

# game/script.rpy:3677
translate ukr ch7_6e405e15:

    # p sure "Nah, it'd defeat the purpose. It'll feel more rewarding getting there on foot."
    p sure "Ні, це б позбавило сенсу всю ідею. Якщо ми доберемось пішки, то це принесе набагато більше задоволення."

# game/script.rpy:3678
translate ukr ch7_ebba887b:

    # w calm "Hmhm... fair enough. Tragic, though, that you'd willingly pass on an opportunity for me to cling to you."
    w calm "Хмхм... гарний аргумент. Але як сумно - ти за власним бажанням відмовився від того, аби я притиснувся до тебе зайвий раз."

# game/script.rpy:3679
translate ukr ch7_34a0afcc:

    # p ehe "Haha, we can fly on the way back if you want."
    p ehe "Хаха, якщо ти хочеш - назад можемо полетіти на метлі."

# game/script.rpy:3681
translate ukr ch7_4f263e5f:

    # n "Pastille offers his hand again, which Periwinkle takes with a smile."
    n "Пастиль знову подає йому руку, і Барвінок з радістю її бере."

# game/script.rpy:3686
translate ukr ch7_59ddd814:

    # w "...Tell me more about your relationship with magic."
    w "...Розкажи мені більше про свої стосунки з магією."

# game/script.rpy:3687
translate ukr ch7_2528ce76:

    # p "Hm? What do you mean?"
    p "Хм? Що ти маєш на увазі?"

# game/script.rpy:3688
translate ukr ch7_3c167982:

    # w "It was the same when we cleaned my house together. You insisted on doing things manually..."
    w "Те саме сталося, коли ми разом прибирали в моєму домі. Ти наполягав на тому, аби робити все власноруч..."

# game/script.rpy:3689
translate ukr ch7_7c5e0bd7:

    # w "Not that I minded at all. Seeing you lift so many heavy things was a treat in itself 💙"
    w "Не те щоб я був проти. Те, як ти вправлявся з важкими речами, було чудовим видовищем 💙"

# game/script.rpy:3690
translate ukr ch7_4caf8895:

    # p "Hahaha, well..."
    p "Хахаха, гаразд..."

# game/script.rpy:3691
translate ukr ch7_10f7805a:

    # p "Ever since I was young... it was clear I was, um... \"ridiculously talented\", as they'd put it."
    p "Ще коли я був малим... було очевидним, що я був, ем... \"неймовірно талановитим\", як вони казали."

# game/script.rpy:3692
translate ukr ch7_e85247dc:

    # p "My moms wanted me to be a traditional witch. They enrolled me in one of the top schools, so I could learn from the best."
    p "Мої мами хотіли, аби я був традиційною відьмою. Вони записали мене в одну з найбільш елітних шкіл, аби я міг вчитися у найрозумніших та найкращих."

# game/script.rpy:3694
translate ukr ch7_0b59e908:

    # p "I-it was an all-girls school, though... Guess I was young enough that no one realized I was a boy."
    p "Ц-це була школа лише для дівчат... Гадаю, я був достатньо малим, аби ніхто не зрозумів, що я хлопець."

# game/script.rpy:3695
translate ukr ch7_c1703821:

    # p "I really... didn't belong there. On any level."
    p "І я... не вписувався туди. Ні на якому рівні."

# game/script.rpy:3696
translate ukr ch7_fa8d2d79:

    # p "But, I kept at it as long as I could. Just enough to keep my parents happy, until I could go out and live on my own."
    p "Але я намагався протриматись там настільки довго, настільки міг. Настільки, аби мої батьки були щасливі - поки я не зміг поїхати та жити самостійно."

# game/script.rpy:3698
translate ukr ch7_73d8e924:

    # p "Haha, I still don't understand exactly why... but I always felt uncomfortable using my magic."
    p "Хаха, досі не розумію, чому... але мені завжди було незручно використовувати мою власну магію."

# game/script.rpy:3699
translate ukr ch7_b1a584dd:

    # p "It felt like cheating. Like... this kind of power shouldn't come so easily."
    p "Це відчувалось чимось нечесним. Просто... така сила не повинна діставатись легко."

# game/script.rpy:3700
translate ukr ch7_f94b0797:

    # p "Sy thought so, too. I guess that's why I latched onto her when we met..."
    p "Сі теж так думала. Гадаю, саме тому я і вчепився за неї, коли ми познайомились..."

# game/script.rpy:3701
translate ukr ch7_b940b2af:

    # p "She used to really hate magic. Which worked out perfectly for me--it was a good excuse to pretend to be a regular human like her."
    p "Вона колись дійсно ненавиділа магію. І мене це повністю влаштовувало - я міг використав це як привід прикинутись звичайною людиною, як і вона сама."

# game/script.rpy:3702
translate ukr ch7_e058bb72:

    # p "So... that's what I did. For the past... seven years?"
    p "І... ось так я і жив. Здається, це тривало... сім років?"

# game/script.rpy:3705
translate ukr ch7_fe2bf237:

    # w cute my "Seven years... that's quite a long time!"
    w cute my "Сім років... це великий проміжок часу!"

# game/script.rpy:3707
translate ukr ch7_4d057338:

    # p "Yeah, but there was a lot to distract me back then... it took a while to get Atelier Sweets up and running."
    p "Ага, але в мене тоді була купа інших справ... пройшло немало часу, перш ніж Ательє Солодощів почало процвітати."

# game/script.rpy:3708
translate ukr ch7_dc3c7909:

    # p calm "And... Sy did eventually find out. I thought she'd disown me when she did..."
    p calm "І... врешті-решт Сі дізналась правду. Я думав, що вона від мене відречеться, коли дізнається..."

# game/script.rpy:3709
translate ukr ch7_c13fd2df:

    # p ehe "But instead... she told me I shouldn't have hid it. Even though I doubt we would've become friends if I told her from the beginning..."
    p ehe "Але замість цього... вона сказала мені, що я не мав від неї приховувати це. Хоча я сумніваюсь, що ми б стали друзями, якщо б сказав про це одразу..."

# game/script.rpy:3710
translate ukr ch7_53e2aed6:

    # w calm "Quite impossible to please, hm?"
    w calm "Неможливо вгодити, хм?"

# game/script.rpy:3711
translate ukr ch7_03a0e69e:

    # p sure "You have no idea...."
    p sure "Ти і гадки не маєш...."

# game/script.rpy:3712
translate ukr ch7_6dc476af:

    # p smile "But... ever since she said that, I've been able to start embracing magic again. On my own terms."
    p smile "Але... з того моменту, як вона це сказала, я почав приймати свою магію і потрохи її використовувати. Але на своїх умовах."

# game/script.rpy:3713
translate ukr ch7_3832c226:

    # w "(I'm beginning to grasp why he values her so highly...)"
    w "(Я починаю розуміти, чому він настільки цінує Сироп...)"

# game/script.rpy:3714
translate ukr ch7_ff5b5b21:

    # p ohno "Um, sorry that I just keep talking about myself...."
    p ohno "Ем, вибач, що я говорю тільки про себе...."

# game/script.rpy:3715
translate ukr ch7_d3905dce:

    # w happy "Don't apologize~! I'm the one who asked."
    w happy "Не вибачайся!~ Врешті-решт, я сам про це запитав."

# game/script.rpy:3716
translate ukr ch7_7c140cec:

    # w smile "Besides, I'm content to listen. Say as much as you like."
    w smile "До того ж, мені подобається тебе слухати. Так що говори стільки, скільки захочеш."

# game/script.rpy:3717
translate ukr ch7_acb13031:

    # p embarrassed "Thanks...."
    p embarrassed "Дякую...."

# game/script.rpy:3720
translate ukr ch7_ea22c411:

    # n "Periwinkle gives Pastille's hand a reassuring squeeze."
    n "Барвінок стискає руку Пастила, аби той трохи заспокоївся."

# game/script.rpy:3722
translate ukr ch7_6ce8c1d1:

    # "I love him..."
    "Я кохаю його..."

# game/script.rpy:3723
translate ukr ch7_aa288728:

    # "I have to find the right moment to tell him that."
    "Мені треба підібрати влучний момент, аби йому зізнатись."

# game/script.rpy:3724
translate ukr ch7_973b0143:

    # "Should it be now? During this romantic walk?"
    "Може, просто зараз? Під час цієї романтичної прогуляки?"

# game/script.rpy:3725
translate ukr ch7_34c7c040:

    # "Ah, but he still has yet to reveal our destination..."
    "Ах, але ж він досі не сказав, куди ми прямуємо..."

# game/script.rpy:3726
translate ukr ch7_87cfcf28:

    # "What do you have in store for me, Pastille...?"
    "Що ж ти підготував для мене, Пастиле?.."

# game/script.rpy:3727
translate ukr ch7_76b2fe88_2:

    # nvl clear
    nvl clear

# game/script.rpy:3730
translate ukr ch7_cd548b59:

    # p "I think I might be too used to how Sy is... she's usually so preoccupied with her own stuff."
    p "Гадаю, що я занадто звик до того, як себе поводить Сі... вона зазвичай дуже зайнята своїми справами."

# game/script.rpy:3731
translate ukr ch7_e4e3ea32:

    # p smile "So it's nice... having someone who actually wants to listen to me."
    p smile "Тому приємно... знати, що хтось дійсно хоче мене слухати."

# game/script.rpy:3732
translate ukr ch7_63040b81:

    # p flustered2 "Agh, that makes her sound like such a horrible friend...! She's really not!!" with vpunch
    p flustered2 "Чорт, це знову звучить так, наче вона жахлива подруга!.. Це не так!!" with vpunch

# game/script.rpy:3733
translate ukr ch7_0bd17d69:

    # w cute happy "You certainly haven't made a convincing case for her~!"
    w cute happy "Але ти так і не навів аргументів на її користь!~"

# game/script.rpy:3734
translate ukr ch7_92bac40c:

    # p calm "*sigh* I know. But that wasn't the point I was trying to make..."
    p calm "*позіхає* Знаю. Але я не це мав на увазі..."

# game/script.rpy:3735
translate ukr ch7_cb1d6efd:

    # w oh "Oh?"
    w oh "Ох?"

# game/script.rpy:3736
translate ukr ch7_6f213e95:

    # p ohno2 "I really...!"
    p ohno2 "Я дійсно!.."

# game/script.rpy:3737
translate ukr ch7_2ddcc144:

    # p flustered2 "...."
    p flustered2 "...."

# game/script.rpy:3738
translate ukr ch7_5793c0e9:

    # w love "Yes...?"
    w love "Так?.."

# game/script.rpy:3739
translate ukr ch7_bd8caf25:

    # p seriously "Let me start over."
    p seriously "Давай я почну спочатку."

# game/script.rpy:3742
translate ukr ch7_4457e2ee:

    # n "Pastille takes a deep breath before continuing..."
    n "Пастиль глибоко вдихає, перш ніж продовжити говорити..."

# game/script.rpy:3743
translate ukr ch7_3c52a2e3:

    # p wha "Going back to... what we were talking about before. With my magic and everything."
    p wha "Давай повернемось до... того, про що ми говорили. Про мою магію і все таке."

# game/script.rpy:3744
translate ukr ch7_b651cf3a:

    # p think "I think I have trouble accepting myself for what I am... I tend to hide things, even when I don't need to."
    p think "Гадаю, в мене є проблема - я не можу прийняти себе таким, який я є... В мене є звичка приховувати те, що стосується мене, навіть коли в цьому нема необхідності."

# game/script.rpy:3745
translate ukr ch7_8c631518:

    # p oh "Being with YOU feels like... it's better not to hide? Like, I'm allowed to just BE."
    p oh "Але коли я з тобою, то відчуваю, що... краще не ховатись? Мені наче дозволяють просто бути таким, який я є."

# game/script.rpy:3746
translate ukr ch7_bd2d007a:

    # p shy "Or, more like... celebrated? For being? I-I don't know, that feels weird to say."
    p shy "Чи, може... наче я - це привід радіти? І моє існування само по собі неначе свято? Я-я не знаю, дивно таке говорити."

# game/script.rpy:3747
translate ukr ch7_f3a624fa:

    # w cute wow "...."
    w cute wow "...."

# game/script.rpy:3748
translate ukr ch7_a1e89604:

    # p ehe "Y-you can stop me if I'm being too much...."
    p ehe "М-можеш мене зупинити, якщо я говорю щось не те...."

# game/script.rpy:3749
translate ukr ch7_cb9e5642:

    # w nofair2 "(IT'S BECAUSE I LOVE YOU...! Why can't I just say that...?!)" with vpunch
    w nofair2 "(ЦЕ ВСЕ ТОМУ ЩО Я КОХАЮ ТЕБЕ!.. Чому я просто не можу цього сказати?!)" with vpunch

# game/script.rpy:3751
translate ukr ch7_0e54bcb0:

    # p smile "Oh! We're here!"
    p smile "О! Ми прийшли!"

# game/script.rpy:3752
translate ukr ch7_f344f25d:

    # w my "W-we are...?"
    w my "Прийшли?.."

# game/script.rpy:3761
translate ukr ch7_01fc1362:

    # "When we came up over the hill..."
    "Коли ми піднялись на пагорб..."

# game/script.rpy:3762
translate ukr ch7_5d572078:

    # "The vastness of the night sky overwhelmed me."
    "Від всеосяжності нічного неба в мене перехопило дихання."

# game/script.rpy:3763
translate ukr ch7_38f127a1:

    # "But more than that..."
    "Але крім цього..."

# game/script.rpy:3764
translate ukr ch7_6294189d:

    # "The field of small blue flowers, that stretched as far as the eye could see..."
    "Поле маленьких блакитних квітів, що простиралось аж до горизонту..."

# game/script.rpy:3765
translate ukr ch7_69330f7d:

    # "Matched it so perfectly."
    "Виглядало як його дзеркальне відображення."

# game/script.rpy:3766
translate ukr ch7_76b2fe88_3:

    # nvl clear
    nvl clear

# game/script.rpy:3770
translate ukr ch7_c19eb018:

    # w cute shock "Pastille...!"
    w cute shock "Пастиле!.."

# game/script.rpy:3773
translate ukr ch7_00d275ec:

    # p "They're periwinkles. When I looked up where to find some... I found out about this place."
    p "Це барвінки. Коли я шукав, де їх можна знайти... я дізнався про це місце."

# game/script.rpy:3774
translate ukr ch7_36ad9faf:

    # p doki "A-apparently it's a famous date spot... I thought you'd like to see it, so...."
    p doki "Д-до того ж, це відоме місце для побачень... Я подумав, що тобі може сподобатись, так що...."

# game/script.rpy:3776
translate ukr ch7_3d805e46:

    # w "I... I-I...!"
    w "Я... Я-я!..."

# game/script.rpy:3777
translate ukr ch7_8adde88a:

    # w whine2 "I shouldn't have told you I'm weak to romance...!! Pastille!!!" with vpunch
    w whine2 "Мені не варто було говорити тобі про свою слабкість до романтичних речей!!... Пастиле!!!" with vpunch

# game/script.rpy:3781
translate ukr ch7_05c9cbbc:

    # n "A glint catches Periwinkle's eye,{nw}"
    n "Барвінок помічає блиск,{nw}"

# game/script.rpy:3783
translate ukr ch7_a8567a09:

    # extend " and he looks up to notice... a meteor shower has begun."
    extend "і підіймає голову, аби побачити... що почався метеоритний дощ."

# game/script.rpy:3785
translate ukr ch7_73f1a48a:

    # w my "Ah...!"
    w my "Ах!.."

# game/script.rpy:3786
translate ukr ch7_559af831:

    # p happy "Oh, good! It started just in time...."
    p happy "Ох, чудово! Він почався якраз вчасно...."

# game/script.rpy:3787
translate ukr ch7_060caff3:

    # w shock "You planned this, too?!" with vpunch
    w shock "Ти і це запланував?!" with vpunch

# game/script.rpy:3788
translate ukr ch7_a08d1d6b:

    # p embarrassed "Well, I knew this was supposed to be happening tonight... so...."
    p embarrassed "Ну, я знав, що він має статись сьогодні вночі... так що...."

# game/script.rpy:3793
translate ukr ch7_e01493c6:

    # w overwhelmed "PASTILLE!!!!!!!"
    w overwhelmed "ПАСТИЛЕ!!!!!!!"

# game/script.rpy:3795
translate ukr ch7_b1a81c31:

    # p "WAH--!!" with vpunch
    p "ААА!!-" with vpunch

# game/script.rpy:3800
translate ukr ch7_e7ad4e10:

    # n "Periwinkle tackles Pastille to the ground, landing them in the field of flowers..."
    n "Барвінок міцно обіймає Пастиля, і вони обидва падають на траву, усипану квітами..."

# game/script.rpy:3804
translate ukr ch7_993f86f6:

    # w "This is perfect..."
    w "Просто неймовірно..."

# game/script.rpy:3805
translate ukr ch7_29d90c6e:

    # w "I-I don't know what else to say...! I'm speechless...."
    w "Я-я не знаю, що ще сказати!.. Я втратив мову...."

# game/script.rpy:3806
translate ukr ch7_74dc2d6c:

    # p "Haha, I guess I went a little overboard...."
    p "Хаха, напевно, я трохи перестарався...."

# game/script.rpy:3807
translate ukr ch7_71a07f4f:

    # w "A little?! This is the most romantic thing anyone's ever done for me!!!" with vpunch
    w "Трохи?! Це найбільш романтична річ, яку хтось робив для мене за все моє життя!!!" with vpunch

# game/script.rpy:3808
translate ukr ch7_e978b8e5:

    # n "He buries his face in Pastille's chest, holding him close."
    n "Він притискається обличчям до груди Пастила, і обіймає його ще міцніше."

# game/script.rpy:3809
translate ukr ch7_16aecb80:

    # p "Well... there's actually... one more thing I wanted to say."
    p "Гаразд... насправді... я ще дещо хотів сказати."

# game/script.rpy:3811
translate ukr ch7_2f9a6199:

    # n "He can feel Pastille's heart pounding."
    n "Він чує, як швидко б'ється серце Пастиля."

# game/script.rpy:3812
translate ukr ch7_3890f9c5:

    # p "Ahh, where do I start... um...."
    p "Ахх, з чого ж почати... ем...."

# game/script.rpy:3813
translate ukr ch7_e74b39bd:

    # p "You know how... Sy and Gumdrop are really important to me?"
    p "Ти же розумієш... наскільки Сі та Мармеладка для мене важливі?"

# game/script.rpy:3814
translate ukr ch7_d67e120d:

    # p "I always thought that I needed to keep myself available for them. To take care of the store and everything."
    p "Я завжди думав, що маю бути в їх розпорядженні, слідкувати за магазином і все таке."

# game/script.rpy:3815
translate ukr ch7_2ebc1e5f:

    # p "But in practice, that just meant... I never really took any time for myself."
    p "Але насправді це значило лише одне... Що я повністю перестав витрачати час на себе."

# game/script.rpy:3816
translate ukr ch7_dc57cb02:

    # p "Like, my own needs were something I could just bury, and it would be fine... because it's for their sake."
    p "Наче мої власні бажання - це щось, на що я можу не звертати уваги, і все буде гаразд... бо я робив це для них."

# game/script.rpy:3818
translate ukr ch7_3e7da720:

    # p "I guess that's part of why... I'd go out with random guys in secret. As something just for me, totally detached from everything else."
    p "Гадаю, ось чому... я потайки зустрічався з випадковими хлопцями. Це було щось лише моє, повністю відділене від мого звичайного життя."

# game/script.rpy:3819
translate ukr ch7_a24acfbd:

    # p "I tried... having a real relationship once. It didn't work out, obviously. I-I never told Sy about him..."
    p "Я колись намагався... вступити у реальні стосунки. Звісно, нічого не вийшло. Я-я навіть не розповів Сі про нього..."

# game/script.rpy:3820
translate ukr ch7_4e3c6695:

    # p "But that made me think... that I was right to continue on the way I had been. Since I wasn't willing to let my priorities shift."
    p "Але це змусило мене замислитись... що буде правильно продовжувати жити так, як я і жив, якщо я не хочу змінювати свої пріорітети."

# game/script.rpy:3821
translate ukr ch7_03dafb87:

    # n "Periwinkle grips Pastille's cloak a little tighter."
    n "Барвінок міцніше хапається за плащ Пастиля."

# game/script.rpy:3822
translate ukr ch7_8f89c97b:

    # w "Wh-what are you saying...?"
    w "Щ-що ти маєш на увазі?.."

# game/script.rpy:3823
translate ukr ch7_ed9ffa87:

    # p "I guess, um... that, with you... I don't mind it as much."
    p "Гадаю, ем... коли мова йде про тебе... я не настільки проти."

# game/script.rpy:3830
translate ukr ch7_1b31e9f8:

    # "H-he's... he's going to beat me to it at this rate!!"
    "В-він... такими темпами він мене випередить і зізнається першим!!"

# game/script.rpy:3831
translate ukr ch7_5760d7ef:

    # "I-I can't let that happen...!"
    "Я-я не можу дозволити, аби це сталося!.."

# game/script.rpy:3832
translate ukr ch7_e860da44:

    # nvl clear
    # n "Periwinkle suddenly rolls himself on top of Pastille, pinning him down."
    nvl clear
    n "Барвінок раптом перевертається, опиняючись зверху Пастиля, і притискає його до землі."

# game/script.rpy:3837
translate ukr ch7_e3a3d605:

    # w "Pastille, I'm in love with you!!!"
    w "Пастилю, я кохаю тебе!!!"

# game/script.rpy:3838
translate ukr ch7_3353d4b4:

    # p "Wh-wha--??!?!? S-since when?!" with vpunch
    p "Щ-що??!?!?- І-і як довго?!" with vpunch

# game/script.rpy:3840
translate ukr ch7_d08ef308:

    # w "I-I don't know, maybe this whole time?!"
    w "Я-я не знаю, може, весь цей час?!"

# game/script.rpy:3841
translate ukr ch7_fc9fe40d:

    # w "I only admitted it to myself that morning you made me pancakes...."
    w "Я зізнався собі в цьому тільки того ранку, коли ти приготував мені панкейки...."

# game/script.rpy:3843
translate ukr ch7_69ecef14:

    # p "That's what it took..?"
    p "І тобі цього вистачило?.."

# game/script.rpy:3844
translate ukr ch7_72ea541b:

    # w "Why? How long have YOU felt this way?"
    w "А що? І як довго ТИ це відчував?"

# game/script.rpy:3846
translate ukr ch7_1e470d14:

    # p "Since... having to carry you home, after spending the day together? I think that's when I first realized it..."
    p "З того дня... коли мені довелось нести тебе додому після побачення? Гадаю, я тоді вперше це усвідомив..."

# game/script.rpy:3847
translate ukr ch7_f1180398:

    # w "Then why didn't you say something?! I've been suffering in silence this entire time...!" with vpunch
    w "Тоді чому ти нічого не сказав?! Я весь цей час мовча страждав!.." with vpunch

# game/script.rpy:3849
translate ukr ch7_350e8d77:

    # p "I-I thought you wanted to keep it casual...?"
    p "Я-я думав, що ти проти серйозних стосунків?.."

# game/script.rpy:3850
translate ukr ch7_2ded0261:

    # w "We saw each other almost every day!! How is that casual?!"
    w "Ми бачили один одного майже кожен день!! І це було, по-твоєму, несерйозно?!"

# game/script.rpy:3851
translate ukr ch7_8f5651d3:

    # p "But you never acted any differently...! A-and I was busy sorting through my own feelings anyway...."
    p "Але ти поводив себе, як і раніше!.. І-і мені потрібен був час, аби розібратись у власних почуттях...."

# game/script.rpy:3853
translate ukr ch7_8cca7f14:

    # w "Mmmnnnnnn...!!!!!!! So was I...."
    w "Ммммннннн!!!!!!!... Як і мені..."

# game/script.rpy:3854
translate ukr ch7_56b8e860:

    # w "But that's no excuse for how long you kept me waiting...! I-I won't forgive you!"
    w "Але те, наскільки ти довго змусив мене чекати, не має жодного виправдання!.. Я-я тебе не пробачу!"

# game/script.rpy:3856
translate ukr ch7_d5c67421:

    # p "...."
    p "...."

# game/script.rpy:3857
translate ukr ch7_47bd51eb:

    # w "Wh-what...? Why are you smiling like that?"
    w "Щ-що?.. Чому ти так посміхаєшся?"

# game/script.rpy:3858
translate ukr ch7_fbb1d3e9:

    # p "It's cute... seeing you all worked up like this."
    p "Це мило... бачити тебе настільки обуреним."

# game/script.rpy:3859
translate ukr ch7_ae85e999:

    # w "--!!"
    w "!!-"

# game/script.rpy:3862
translate ukr ch7_ed75769f:

    # n "Periwinkle struggles to his feet and begins stomping away."
    n "Барвінок ледве підіймається на ноги і гнівно йде геть."

# game/script.rpy:3864
translate ukr ch7_f6c38887:

    # w cute nofair2 "Y-you could've saved me a lot of heartache, you know...!"
    w cute nofair2 "Т-ти міг би мене позбавити від зайвих страждань і зберегти купу нервів!.."

# game/script.rpy:3865
translate ukr ch7_7dc24b88:

    # n "Pastille sits up, straightening out his cloak and retrieving his hat."
    n "Пастиль сідає на траву, поправляє свою мантію і підбирає шляпу."

# game/script.rpy:3868
translate ukr ch7_ff9468ab:

    # p "Where are you going...? Come back."
    p "Куди ти йдеш?.. Повернись."

# game/script.rpy:3869
translate ukr ch7_f6894d83:

    # w nofair "No!! I'm too upset!" with vpunch
    w nofair "Ні!! Я занадто засмучений!" with vpunch

# game/script.rpy:3870
translate ukr ch7_ff48b4a6:

    # p ehe "Peri...."
    p ehe "Барві..."

# game/script.rpy:3871
translate ukr ch7_34963f72:

    # w yell "I was convinced... CONVINCED, that I'd cursed myself with some kind of love potion! My fake aphrodisiac turned real!"
    w yell "Я був впевнений... АБСОЛЮТНО ВПЕВНЕНИЙ в тому, що прокляв себе якимось любовним зіллям! Що мій фальшивий афродізіак перетворився на справжній!"

# game/script.rpy:3872
translate ukr ch7_c9c42113:

    # p "What in the world...?"
    p "Що ти маєш на увазі?.."

# game/script.rpy:3873
translate ukr ch7_ca056bf8:

    # w "Because we didn't fuck that day! Fucking was supposed to be the entire point of it!!" with vpunch
    w "Ми в той день так і не поїбались! А заради сексу все це і затівалося!!" with vpunch

# game/script.rpy:3874
translate ukr ch7_03d3511b:

    # p dying "P-PERI...!"
    p dying "Б-БАРВІ!.."

# game/script.rpy:3875
translate ukr ch7_21cbb225:

    # w nofair2 "Everything spiraled out of control since then...! I couldn't stop thinking about you!!"
    w nofair2 "І з того моменту все вийшло з-під контролю!.. Я не міг припинити думати про тебе!!"

# game/script.rpy:3876
translate ukr ch7_c400f965:

    # w yell "You BROKE my magic! For weeks and weeks, all I could conjure was that stupid peach blossom scent...!"
    w yell "Ти ЗЛАМАВ мою магію! Проходили дні і тижні, і все, що я міг створити - цей дурний аромат квітучого персика!.."

# game/script.rpy:3877
translate ukr ch7_b704fa44:

    # p woah "A-ah... really...?"
    p woah "А-ах... дійсно?.."

# game/script.rpy:3878
translate ukr ch7_b58af626:

    # w nofair2 "Yes! Until just the other day... which I spent CRYING, in the dusty back room of the apothecary, telling Astragalus all about it...!"
    w nofair2 "Так! І це продовжувалось до вчорашнього дня... який я провів у сльозах, у забитій пилом підсобці аптеки, поки розповідав Астрагал про все!.."

# game/script.rpy:3879
translate ukr ch7_03175381:

    # w nofair "After all that... everything I spent so long preparing my heart for... you have the NERVE to try to confess first...?!"
    w nofair "І після цього всього... всього, для чого я так довго готував своє серце... в тебе вистачило нахабства спробувати зізнатись першим?!.."

# game/script.rpy:3880
translate ukr ch7_ea73974b:

    # p aw "I'm sorry."
    p aw "Вибач."

# game/script.rpy:3881
translate ukr ch7_4abce74d:

    # w nofair2 "Don't apologize! I already said I won't forgive you!!" with vpunch
    w nofair2 "Не вибачайся! Я вже сказав, що тебе не пробачу!!" with vpunch

# game/script.rpy:3882
translate ukr ch7_937c48a8:

    # p ehe "What do you want me to do, then...?"
    p ehe "Що ж тоді ти від мене хочеш?.."

# game/script.rpy:3883
translate ukr ch7_2af101c3:

    # w insulted "I don't know, fucking kiss me if you love me so much!!!"
    w insulted "Я не знаю - може, чорт забирай, поцілуй вже мене, якщо так сильно кохаєш!!!"

# game/script.rpy:3891
translate ukr ch7_71e3c067:

    # n "Pastille approaches, gently raising a hand to Periwinkle's cheek..."
    n "Пастиль підходить ближче, ніжно кладе руку на щоку Барвінка..."

# game/script.rpy:3893
translate ukr ch7_c2b3fc7a:

    # n "...and does exactly as he's told."
    n "...і робить саме так, як йому сказали."

# game/script.rpy:3895
translate ukr ch7_58024a15:

    # p "I love you."
    p "Я кохаю тебе."

# game/script.rpy:3896
translate ukr ch7_dde4b08e:

    # n "Periwinkle's heart skips a beat."
    n "Серце Барвінка на секунду зупиняється."

# game/script.rpy:3898
translate ukr ch7_2c91cb68:

    # w "I love you, too...!"
    w "Я теж тебе кохаю!.."

# game/script.rpy:3899
translate ukr ch7_ff617e74:

    # n "He hugs Pastille tightly, careful not to knock him over this time."
    n "Він міцно обіймає Пастила, намагаючись цього разу не збити його з ніг."

# game/script.rpy:3906
translate ukr ch7_33de9d18:

    # "It takes everything I've got to keep myself from bursting into tears."
    "Все мої сили йдуть на те, аби я втримався і не почав плакати."

# game/script.rpy:3907
translate ukr ch7_57e13493:

    # "I won't ruin my makeup on this perfect date...!"
    "Не вистачало ще зіпсувати макіяж на цьому ідеальному побаченні!.."

# game/script.rpy:3908
translate ukr ch7_1c5f0457:

    # "This beautiful place, that Pastille chose just for us..."
    "Це прекрасне місце, що Пастиль обрав лише для нас..."

# game/script.rpy:3909
translate ukr ch7_bc3b2ea7:

    # "I can't have my memory of this perfect night obscured by tears...."
    "Я не хочу, аби мої спогади про цю чудову ніч були зіпсовані сльозами..."

# game/script.rpy:3910
translate ukr ch7_76b2fe88_4:

    # nvl clear
    nvl clear

# game/script.rpy:3916
translate ukr ch7_ec2dd684:

    # p "It looks like the meteor shower's over...."
    p "Здається, зорепад закінчився..."

# game/script.rpy:3917
translate ukr ch7_75d5ddf8:

    # w cute pout "...Take me home...."
    w cute pout "...Відведи мене додому..."

# game/script.rpy:3918
translate ukr ch7_8bb2e9cd:

    # p ehe "A-are you still mad at me...?"
    p ehe "Т-ти досі злишся на мене?.."

# game/script.rpy:3919
translate ukr ch7_5b794844:

    # w oops "I'm not mad at you...."
    w oops "Я не злюсь..."

# game/script.rpy:3920
translate ukr ch7_16f5b969:

    # p aw "I've never seen you like this. I don't know how else I should interpret it."
    p aw "Я ніколи не бачив тебе таким і не знаю, як інакше це зрозуміти."

# game/script.rpy:3921
translate ukr ch7_f5a91280:

    # w conflicted "I'm overwhelmed. Elated... relieved... and frustrated...."
    w conflicted "Я приголомшений. Я відчуваю піднесенння... полегшення... і роздратованість..."

# game/script.rpy:3922
translate ukr ch7_8b592c68:

    # w ohhh "I-I want to get in bed... so that you can hold me close all night..."
    w ohhh "Я-я хочу опинитись у ліжку... аби ти зміг притиснути мене до себе, і аби ми обіймались цілу ніч..."

# game/script.rpy:3923
translate ukr ch7_ad678a44:

    # w ohhh2 "I don't think I'll be convinced that this was real unless you do that. So... please...?"
    w ohhh2 "Гадаю, поки ти цього не зробиш... то я так і не зможу впевнитись у тому, що все сталось насправді. Так що... будь ласка?.."

# game/script.rpy:3924
translate ukr ch7_9cd2e04f:

    # p doki "That sounds... really nice...."
    p doki "Це... дуже гарна ідея...."

# game/script.rpy:3925
translate ukr ch7_23f5322d:

    # p happy "Okay ❤ If it's to convince you, I guess I have no choice...."
    p happy "Гаразд ❤ Якщо це потрібно, аби переконати тебе, то, гадаю, в мене немає іншого вибору..."

