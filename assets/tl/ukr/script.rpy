    p omg "А-ааахх!.. Будь ласка, не говори таке в присутності покупців!" with vpunch

# game/script.rpy:3004
translate ukr ch6_d4eebef7:

    # w oh "Customers? I don't see anyone."
    w oh "Покупців? Я нікого не бачу."

# game/script.rpy:3005
translate ukr ch6_726b4f8e:

    # p flustered "I-I know, I mean... just, in general...."
    p flustered "Я-я знаю, просто... я мав на увазі, в принципі..."

# game/script.rpy:3006
translate ukr ch6_fde4125f:

