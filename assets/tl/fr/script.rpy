translate fr ch7_875a28a9:

    # n "The pair exits the back room, but they only make it a few steps out before Periwinkle turns on his heel."
    n "Les deux sortent de l'arrière boutique, mais ne font que quelques pas avant que Periwinkle ne se retourne."

# game/script.rpy:3608
translate fr ch7_4d17f35d:

    # w hood oh "Ah, one more thing, before I go..."
    w hood oh "Ah, une dernière chose, avant que je parte..."

