    # w oops "...."
    w oops "...."

# game/script.rpy:3632
translate fr ch7_b80c39a5:

    # w ohhh "I suppose you're right, though... I haven't been able to tell him that in words."
    w ohhh "Mais j'imagine que tu as raison... Je n'ai jamais pu lui dire tout ça de vive voix."

# game/script.rpy:3633
translate fr ch7_ad5bdd9e:

    # w nofair2 "I can't keep holding back... he has to know. No matter the outcome."
    w nofair2 "Je ne peux pas continuer à tout garder en moi... il doit savoir. Peu importe le résultat."

# game/script.rpy:3634
translate fr ch7_60359fd7:

    # a smile "Good luck, okay? I'm sure it'll turn out just fine."
    a smile "Bonne chance. Je suis sûre que tout ira bien."

# game/script.rpy:3635
translate fr ch7_a4d8dbdf:

    # w ohhh "Yes... yes, it likely will."
    w ohhh "Oui... oui, je l'espère."

# game/script.rpy:3636
translate fr ch7_0f7a9daf:

    # w shy "Thank you again... I'm truly grateful for all that you've done for me."
    w shy "Merci encore... Je suis vraiment reconnaissant pour tout ce que tu as fait pour moi."

# game/script.rpy:3641
translate fr ch7_47504267:

    # n "Astragalus waves him off, and Periwinkle leaves the apothecary with new resolve..."
    n "Astragalus lui dit au revoir, et Periwinkle sort de chez l'apothicaire avec une détermination nouvelle..."

# game/script.rpy:3651
translate fr ch7_8954e2f7:

    # "I spent the next several days catching up on my work."
    "Je passai les jours suivants à rattraper mon retard, en terme de travail."

# game/script.rpy:3652
translate fr ch7_c124ee6b:

    # "Magic truly does come so easily with a clear mind! If only I'd swallowed my pride sooner."
    "La magie marche si bien lorsqu'on a les idées claires! Si seulement j'avais ravalé ma fierté plus tôt."
    nvl clear

# game/script.rpy:3653
translate fr ch7_1e30c6c5:

    # "I completed batch after batch almost effortlessly, going down the long checklist Astragalus had given me..."
    "Je complétais des lots et des lots sans le moindre effort, continuant la longue liste qu'Astragalus m'avait donné..."

# game/script.rpy:3654
translate fr ch7_ba772060:

    # "I hadn't even felt tired by the end of it. As if all this energy had been stored up inside me all along!"
    "Je n'étais même pas fatigué à la fin. Comme si toute cette énergie avait été stockée en moi pendant tout ce temps!"

# game/script.rpy:3655
translate fr ch7_2d728c30:

    # nvl clear
    # "It was a relief to return to somewhat normalcy."
    nvl clear
    "Quel soulagement, de pouvoir revenir à une forme de normalité."

# game/script.rpy:3657
translate fr ch7_e65838f7:

    # "Thinking of Pastille no longer caused my heart to ache... at least, not enough to put me in a state of total despondence."
    "Penser à Pastille ne me fait plus mal au coeur... pas assez pour me mettre dans un état d'accablement total, en tout cas."

# game/script.rpy:3658
translate fr ch7_b8bdf17b:

    # "Instead, those thoughts served as motivation. The way forward was clear."
    "Ces pensées me servent maintenant de motivation. La marche à suivre était claire."

# game/script.rpy:3659
translate fr ch7_975f7c4e:

    # "I would tell him how I felt... and surely..."
    "Je lui dirais ce que je ressens... et ça va..."

# game/script.rpy:3660
translate fr ch7_38f5635f:

    # nvl clear
    # w pj calm "Surely things will turn out just fine...."
    nvl clear
    w pj calm "Ça va certainement bien se passer...."

# game/script.rpy:3665
