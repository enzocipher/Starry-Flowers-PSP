    # w oops "No... I don't know."
    w oops "Non... Je ne sais pas."

# game/script.rpy:3525
translate fr ch7_a2f71b21:

    # a lol "Would you rather spill it all to him instead?"
    a lol "Tu préfères plutôt t'adresser à lui?"

# game/script.rpy:3526
translate fr ch7_237d6381:

    # w cwy "I can't...! It's too much!"
    w cwy "Je ne peux pas...! C'est beaucoup trop!"

# game/script.rpy:3527
translate fr ch7_61ef0d5e:

    # a sure "Then tell it to me, a neutral third party."
    a sure "Alors dis-le à moi, le côté neutre."

