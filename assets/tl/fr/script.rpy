translate fr ch7_30cf76fb:

    # w ohhh "Everything...?"
    w ohhh "Tout...?"

# game/script.rpy:3513
translate fr ch7_4f05ba39:

    # a "Skip the bedroom details, obviously. Just walk me through anything important that happened since you met."
    a "Sauf les détails au lit, évidemment. Dis-moi juste tous les trucs importants qui sont arrivés depuis votre rencontre."

