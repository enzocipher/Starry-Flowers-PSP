# game/script.rpy:1520
translate fr ch3_c9017794:

    # w calm "Hmhm, I suppose you'll do 💙"
    w calm "Hmhm, j'imagine que ça suffira 💙"

# game/script.rpy:1523
translate fr ch3_50b7709f:

    # "I present my hand, and Kardaemon gives an exaggerated bow."
    "Je présente ma main, et Kardaemon se baisse de façon exagérée."

# game/script.rpy:1524
translate fr ch3_084b6170:

    # "He pulls me in, albeit a little clumsily, with his gigantic demon hands. Always enjoyable to be swept up in the arms of a larger man 💙"
    "Il m'emmène, bien que maladroitement, avec ses énormes mains de démon. Être emporté dans les bras d'un grand homme est toujours un plaisir 💙"

# game/script.rpy:1525
translate fr ch3_272b335d:

    # "My own hand is almost entirely consumed by his. Unlike with Pastille's, which fit so--"
    "Ma main est presque entièrement éclipsée par la sienne. Contrairement à celle de Pastille, qui me va si--"

# game/script.rpy:1526
translate fr ch3_36f5d814:

    # nvl clear
    # "...Pastille?"
    nvl clear
    "...Pastille?"

# game/script.rpy:1528
translate fr ch3_bd6489c5:

    # "Am I STILL comparing everyone to him?"
    "Est-ce que je suis TOUJOURS en train de le comparer aux autres?"

# game/script.rpy:1529
translate fr ch3_c405272e:

    # "I shake the thought and return to the moment..."
    "J'écartai cette pensée pour retourner au moment présent..."

# game/script.rpy:1530
translate fr ch3_76b2fe88_5:

    # nvl clear
    nvl clear

# game/script.rpy:1533
translate fr ch3_4dfd153d:

    # n "The pair twirls around the dance floor, losing themselves in the music."
    n "La paire virevolte sur la piste de danse, se laissant guider par la musique."

# game/script.rpy:1534
translate fr ch3_17b0a74e:

    # n "After a while, Kardaemon suddenly speaks up."
    n "Au bout d'un moment, Kardaemon pris soudainement la parole."

# game/script.rpy:1535
translate fr ch3_122eb838:

    # k "...OH! I think I just realized where I know you from!"
    k "...OH! Je pense que je viens juste de me rappeler où est-ce que je t'ai vu!"

# game/script.rpy:1536
translate fr ch3_5a8eabf4:

    # w love "Really, now?"
    w love "Vraiment?"

# game/script.rpy:1537
translate fr ch3_5ae9085a:

    # k "Yeah, you were in the magazine I work for!"
    k "Ouais, tu étais dans le magazine pour lequel je travaillais!"

# game/script.rpy:1538
translate fr ch3_a784e394:

    # k "I'm an editor. We used your photos for an issue a couple years back."
    k "J'étais éditeur. On avait utilisé tes photos pour un article il y a quelques années."

# game/script.rpy:1539
translate fr ch3_efcb9510:

    # w oh "Ah... what a coincidence. I DID used to do some modeling, in the past..."
    w oh "Ah... quelle coïncidence. Il est vrai que j'étais modèle, dans le passé... "

# game/script.rpy:1540
translate fr ch3_07b8e242:

    # w calm "And in the past it shall remain. I'm in a different line of work now."
    w calm "Et ce qui appartient au passé se doit d'y rester. Je fais un travail un peu différent, à présent."

# game/script.rpy:1541
translate fr ch3_e86cb7f9:

    # k "Aww, really? That's too bad. I always thought you looked amazing."
    k "Aww, vraiment? Quel dommage. J'ai toujours pensé que tu étais magnifique."

# game/script.rpy:1542
translate fr ch3_014598d5:

    # w smile "Hmhm, I appreciate that 💙"
    w smile "Hmhm, j'apprécie le compliment 💙"

# game/script.rpy:1545
translate fr ch3_eac59ccf:

    # w neutral "(Well this certainly complicates things... I'd much prefer to have been complete strangers.)"
    w neutral "(Ça complique définitivement les choses... J'aurais préféré être avec un total étranger.)"

# game/script.rpy:1546
translate fr ch3_54236a36:

    # w decline "(How unfortunate... just when I was beginning to enjoy myself.)"
    w decline "(Quel dommage... pile quand je commençais à m'amuser.)"

# game/script.rpy:1549
translate fr ch3_7c244efe:

    # k "Haha, wow, I can't believe I ran into you like this. Maybe it's a sign...?"
    k "Haha, wow, je n'aurais pas pensé te revoir ici. Peut-être est-ce un signe...?"

# game/script.rpy:1550
translate fr ch3_f26130c5:

    # w smile "A sign? Of what, dare I ask?"
    w smile "Un signe? De quoi, si je puis me permettre?"

# game/script.rpy:1551
translate fr ch3_41d59cda:

    # k smile "That you should come back to modeling! I can get you in our magazine again--if you're interested, that is."
    k smile "Que tu devrais reprendre ta carrière! Je pourrais te faire passer dans notre magazine à nouveau--si tu es intéressé, bien sûr."

# game/script.rpy:1552
translate fr ch3_24632a00:

    # w guilty "I appreciate the offer, but I've moved on. It put too much of a strain on my relationship with fashion, among other things..."
    w guilty "J'apprécie l'offre, mais je ne suis plus intéressé. Ma relation avec la mode en avait notamment bien souffert..."

# game/script.rpy:1553
translate fr ch3_9bbf2611:

    # k shy "Ah... well, at least take my card! In case you change your mind."
    k shy "Ah... bien, prends au moins ma carte! Au cas où tu changes d'avis."

# game/script.rpy:1554
translate fr ch3_1ae6e450:

    # w calm "No thank you. I don't see that happening."
    w calm "Non merci. Je ne pense pas que cela arrivera."

# game/script.rpy:1555
translate fr ch3_12306026:

    # k laugh "Aww, come on... you'd be so great! It feels like such a waste of talent...."
    k laugh "Aww, allez... tu étais génial! Ce serait vraiment du talent gâché...."

# game/script.rpy:1556
translate fr ch3_51eac4d1:

    # w neutral "(Hm... I'm quickly growing tired of this.)"
    w neutral "(Hm... Je commence vraiment à m'en lasser.)"

# game/script.rpy:1557
translate fr ch3_c4d486cb:

    # w smile "Thank you for the dance... but I really should be going now."
    w smile "Merci pour la danse... mais je dois vraiment y aller."

# game/script.rpy:1558
translate fr ch3_33e9643f:

    # k huh "Huh? Ah, uh... sure."
    k huh "Huh? Ah, euh... d'accord."

# game/script.rpy:1559
translate fr ch3_b30b1ced:

    # w innocent "This was fun. Perhaps we'll meet again sometime 💙"
    w innocent "C'était assez bien. Peut-être que nous nous reverrons à l'avenir 💙"

# game/script.rpy:1560
translate fr ch3_0d5df227:

    # k sad "Y-yeah...."
    k sad "O-Ouais...."

# game/script.rpy:1567
translate fr ch3_ef15a56c:

    # "I didn't expect to be reminded of my modeling days of all things..."
    "Je ne m'attendais pas à ce que l'on me rappelle mon passé dans le mannequinat..."

# game/script.rpy:1568
translate fr ch3_bad021ca:

    # "Although his excitement was understandable, the way he went about it certainly ruined the mood."
    "Bien que son excitation soit compréhensible, sa façon de l'exprimer a tout gâché."

# game/script.rpy:1569
translate fr ch3_72a95f04:

    # "I hate to admit it, but I'd gone into this night far too unstable to begin with. For such a small thing to get to me..."
    "Je déteste l'admettre, mais je suis venu ici en étant déjà bien trop instable. Pour qu'une telle chose me pose problème..."

# game/script.rpy:1570
translate fr ch3_5ad7ada1:

    # nvl clear
    # "I'm not even here on my own terms, am I?"
    nvl clear
    "Je ne suis même pas venu ici de moi-même, n'est-ce pas?"

# game/script.rpy:1572
translate fr ch3_2f4d44d7:

    # "This was all to prove a point. That's certainly not in the spirit of a friendly soirée..."
    "C'était juste pour prouver quelque chose. Une mentalité qui ne convient clairement pas pour une soirée."

# game/script.rpy:1573
translate fr ch3_d4b47508:

    # "It's best I just return home and--"
    "Mieux vaut rentrer à la maison et--"

# game/script.rpy:1574
translate fr ch3_f36f833e:

    # nvl clear
    # k "Periwinkle, wait!"
    nvl clear
    k "Periwinkle, attends!"

# game/script.rpy:1577
translate fr ch3_f6a6af3b:

    # n "He turns his head to find that Kardaemon has chased after him, stumbling into the lonely night air."
    n "Il tourne la tête pour voir que Kardaemon l'a suivi, trébuchant dans la solitude de la nuit. "

# game/script.rpy:1579
translate fr ch3_29be8e4a:

    # k "Hey--I, uh... I'm sorry if I said anything to upset you."
    k "Hey--Je, euh... Désolé si j'ai dit quoi que ce soit qui t'aies vexé."

# game/script.rpy:1580
translate fr ch3_63733355:

    # w oh "...Upset me? Perish the thought!"
    w oh "...Vexé? Pas du tout!"

# game/script.rpy:1581
translate fr ch3_7415dc79:

    # w guilty "It's simply that I'm feeling a little off tonight. I realized I may have come here for the wrong reasons..."
    w guilty "C'est juste que je ne me sentais pas très bien ce soir. J'ai réalisé que je n'étais pas venu ici pour les bonnes raisons..."

# game/script.rpy:1582
translate fr ch3_5567e155:

    # k pls "Look... I'm sorry that I suddenly started talking about work. That wasn't why I approached you at all."
    k pls "Écoute... Je suis désolé d'avoir soudainement parler du boulot. Ce n'est pas pour ça que je suis venu te voir."

# game/script.rpy:1583
translate fr ch3_01a63751:

    # k sorry "You came here for a good time, right? Well, a party's definitely the place to find it!"
    k sorry "Tu es venu pour passer un bon moment, pas vrai? Je ne vois pas de meilleur endroit qu'une fête pour cela!"

# game/script.rpy:1584
translate fr ch3_1e7ddd47:

    # k lookoff "Heck, it's what I'M here for, too... so, you're not wrong to come looking for that."
    k lookoff "Eh, c'est pour ça que JE suis là, après tout... alors, je pense que tu as raison de venir ici."

# game/script.rpy:1585
translate fr ch3_3219922b:

    # w neutral "(He's completely misread the situation... Although, it IS starting to look salvageable from here.)"
    w neutral "(Il ne comprend pas du tout... Même si la situation a l'air de pouvoir s'améliorer.)"

# game/script.rpy:1586
translate fr ch3_07c62861:

    # k sorry "Anyway, please forget about the magazine stuff--it doesn't matter. We were having fun before that right?"
    k sorry "Bon, oublions cette histoire de magazine--ça n'a aucune importance. On s'amusait bien, pas vrai?"

# game/script.rpy:1587
translate fr ch3_88dfd8df:

    # w calm "Dancing was nice, yes..."
    w calm "Danser était sympathique, en effet..."

# game/script.rpy:1588
translate fr ch3_0e1aab5c:

    # k sad "I-I wanna do more than just dance with you."
    k sad "J-Je veux faire plus que juste danser avec toi."

# game/script.rpy:1589
translate fr ch3_80ca340f:

    # w drool "(Oho, there it is~ Now we're getting somewhere.)"
    w drool "(Oho, nous y voilà~ On arrive enfin à quelque chose.) "

# game/script.rpy:1590
translate fr ch3_26564ac5:

    # w shy "More than dance? And what could that mean~?"
    w shy "Plus que de la danse? Et que veux-tu dire par là~?"

# game/script.rpy:1591
translate fr ch3_107e0d19:

    # k shy "Hah, well, don't make me spell it out..."
    k shy "Hah, ne me fais pas le dire..."

# game/script.rpy:1592
translate fr ch3_70331591:

    # w smile "A kiss, perhaps?"
    w smile "Un baiser, peut-être?"

# game/script.rpy:1593
translate fr ch3_1dbec082:

    # k smile "Sure. And, well, you know... whatever else you'd like to do! As an incubus, I live to please."
    k smile "Bien sûr. Et puis, tu sais... tout ce que tu aimerais faire! En tant qu'incubus, je vis pour plaire."

# game/script.rpy:1594
translate fr ch3_43a052fd:

    # w love "(Since he apologized, I may as well...)"
    w love "(Puisque qu'il s'est excusé, j'imagine que je pourrais...)"

# game/script.rpy:1595
translate fr ch3_d84e6f35:

    # w calm "Kissing is a fine start."
    w calm "Un baiser me semble un bon début."

# game/script.rpy:1598
translate fr ch3_91dabae0:

    # n "Kardaemon holds out his arms, inviting Periwinkle into a soft embrace."
    n "Kardaemon tend ses bras, invitant Periwinkle dans une douce étreinte."

# game/script.rpy:1599
translate fr ch3_890d5fb6:

    # n "Periwinkle's hands glide up his chest, and he wraps his arms around the demon's neck. Their faces just inches apart, he pauses..."
    n "Les mains de Periwinkle remonte son torse, et ses bras s'enroulent autour de la nuque du démon."
    n "Leurs lèvres à quelques centimètres à peine, il s'arrête..."

# game/script.rpy:1600
translate fr ch3_5db6b259:

    # k "...?"
    k "...?"

# game/script.rpy:1601
translate fr ch3_62b5b0bb:

    # w ah "(...Ah. I expected him to close the gap.)"
    w ah "(...Ah. Je m'attendais à ce qu'il prenne l'initiative.)"

# game/script.rpy:1602
translate fr ch3_d0a1702b:

    # w conflicted "(Pastille would've kissed me. I've grown far too accustomed to that, so I automatically...)"
    w conflicted "(Pastille m'aurait embrassé. Je me suis bien trop habitué à ça, et j'ai automatiquement...)"

# game/script.rpy:1603
translate fr ch3_6c100ae0:

    # w oops "(Shit. This was a mistake...)"
    w oops "(Merde. Quelle erreur...)"

# game/script.rpy:1604
translate fr ch3_795ea425:

    # n "Periwinkle gives him a light peck on the cheek before pulling away."
    n "Periwinkle lui fait un petit bisou sur la joue avant de se reculer."

# game/script.rpy:1607
translate fr ch3_01751b4a:

    # w decline "...My apologies. I do actually need to get going now."
    w decline "...Mes excuses. Je dois vraiment y aller."

# game/script.rpy:1608
translate fr ch3_466c52d9:

    # k huh "Huh...?"
    k huh "Hein...?"

# game/script.rpy:1609
translate fr ch3_d3799d4c:

    # w neutral "I shouldn't have led you on. I'm terribly sorry."
    w neutral "Je n'aurais pas dû te donner de faux espoirs. Je suis terriblement désolé."

# game/script.rpy:1610
translate fr ch3_e029c081:

    # k sorry "Oh--n-no, don't worry about that... If you don't want to, it's fine."
    k sorry "Oh--n-non, ne t'inquiète pas pour ça... Ce n'est pas grave si tu ne veux pas."

# game/script.rpy:1611
translate fr ch3_c9e5ee71:

    # k sad "I'm, uh... a little confused, though... Did I do something wrong?"
    k sad "Je suis, euh... un peu confus... Est-ce que j'ai fait quelque chose de mal?"

# game/script.rpy:1612
translate fr ch3_6e012f78:

    # w decline "It's not you--you're very nice. Very firm muscles."
    w decline "Ce n'est pas de ta faute-- tu es très gentil. Et avec des muscles bien fermes."

# game/script.rpy:1613
translate fr ch3_1de73ec5:

    # k shy "Hah, thanks."
    k shy "Hah, merci."

# game/script.rpy:1614
translate fr ch3_dc4c50ae:

    # w neutral "If it were any other night, things would've gone very differently. Please believe me when I say that."
    w neutral "Si cela avait été une nuit comme les autres, les choses se seraient déroulées différemment, tu peux me croire."

# game/script.rpy:1615
translate fr ch3_7e78fb2a:

    # k lookoff "Seriously... is all this mysterious talk supposed to make me want you less...?"
    k lookoff "Sérieusement... est-ce que toute cette conversation est censée me faire abandonner...?"

# game/script.rpy:1616
translate fr ch3_47a1fbc2:

    # w calm "I'm sure you'll have great luck with the witches inside. You're very charming."
    w calm "Je suis sûr que tu auras plus de chances avec les sorciers à l'intérieur. Tu es très charmant."

# game/script.rpy:1617
translate fr ch3_c29eff2b:

    # k pls "...Damn. Well, alright..."
    k pls "...Bon. Très bien..."

# game/script.rpy:1618
translate fr ch3_e35a87bd:

    # k sorry "Get home safe, Periwinkle. Hope to see you again... on any other night, like you said."
    k sorry "Rentre bien, Periwinkle. J'espère que nous nous verrons à nouveau... lors d'une nuit comme les autres, comme tu disais."

# game/script.rpy:1619
translate fr ch3_92af379d:

    # w innocent "Thank you for keeping me entertained. Farewell~"
    w innocent "Merci de m'avoir diverti. Au revoir~"

# game/script.rpy:1622
translate fr ch3_3e90a2df:

    # "I shouldn't have come..."
    "Je n'aurais pas dû venir..."

# game/script.rpy:1623
translate fr ch3_eed2f11e:

    # "What exactly have I proven here tonight? That I'm willing to pursue the first pink-haired boy I come across, out of sheer desperation?"
    "Qu'est-ce que j'essayais de prouver, exactement? Que je suis prêt à poursuivre le premier garçon aux cheveux roses que je rencontre, par pur désespoir?"

# game/script.rpy:1624
translate fr ch3_e4b0829d:

    # "I wanted Astragalus to be wrong for once. To admit that I'm hung up on someone is just...!"
    "Je voulais qu'Astragalus ait tort, pour une fois. Admettre que je me suis attaché à quelqu'un est juste...!"

# game/script.rpy:1625
translate fr ch3_0a84e19c:

    # "I don't feel like myself at all..."
    "Je ne me sens plus du tout moi-même..."

# game/script.rpy:1626
translate fr ch3_76b2fe88_6:

    # nvl clear
    nvl clear

# game/script.rpy:1639
translate fr ch3_f6133343:

    # n "Periwinkle arrives home, lazily slipping out of his shoes and dress. He tosses his hat somewhere and collapses onto the couch."
    n "Periwinkle arrive chez lui, se glissant paresseusement hors de ses chaussures et de sa robe."
    n "Il jette son chapeau dans un coin avant de s'écrouler sur le canapé."

# game/script.rpy:1640
translate fr ch3_bcd66a5f:

    # w lazy oops "(Ugh... I feel even more miserable than before.)"
    w lazy oops "(Ugh... Je me sens encore plus misérable qu'auparavant.)"

# game/script.rpy:1641
translate fr ch3_cba66395:

    # w neutral "...."
    w neutral "...."

# game/script.rpy:1642
translate fr ch3_b315e641:

    # n "Periwinkle finds himself staring at the front door, half-expecting to hear a familiar knock..."
    n "Periwinkle se voit en train de fixer la porte d'entrée, espérant entendre un cognement familier..."

# game/script.rpy:1643
translate fr ch3_d186408e:

    # w guilty "(The state Pastille would find me in if he were to show up tonight...)"
    w guilty "(L'état dans lequel Pastille me verrait s'il venait ce soir...)"

# game/script.rpy:1644
translate fr ch3_db6282c6:

    # w empty "...."
    w empty "...."

# game/script.rpy:1645
translate fr ch3_3e0e2f15:

    # w oops "(...I should get in bed.)"
    w oops "(...Je devrais aller me coucher.)"

# game/script.rpy:1647
translate fr ch3_f44ca24a:

    # n "But he doesn't. Instead, he buries his face in the cushions and falls asleep..."
    n "Mais il n'y alla pas. À la place, il enfonce son visage dans les coussins et s'endort..."

# game/script.rpy:1658
translate fr ch4_7b49a2da:

    # centered "{w=3}{nw}"
    centered "{w=3}{nw}"

# game/script.rpy:1664
translate fr ch4_646d0d17:

    # n "Periwinkle bolts awake to the sound of a knock on his door."
    n "Periwinkle se réveille en sursaut en entendant des coups à sa porte."

# game/script.rpy:1665
translate fr ch4_442e5a09:

    # w lazy sleepy "(Ugh, what time is it...?)"
    w lazy sleepy "(Ugh, quelle heure est-il...?)"

# game/script.rpy:1666
translate fr ch4_eddf3c07:

    # n "He rises from the couch and lightly treads over to check who might be visiting him so early in the morning..."
    n "Il se lève et s'avance légèrement pour vérifier qui pourrait lui rendre visite si tôt dans la matinée... "

# game/script.rpy:1667
translate fr ch4_451d8daa:

    # w ah "(Ah...)"
    w ah "(Ah...)"

# game/script.rpy:1669
translate fr ch4_ce446219:

    # "At first, I thought my eyes were playing tricks on me."
    "Au début, je crus que mes yeux me jouaient des tours."

# game/script.rpy:1670
translate fr ch4_16ee5917:

    # "It took several moments to register the fact that Pastille was on my doorstep."
    "Il me fallut un long moment pour accepter le fait que Pastille était à ma porte."

# game/script.rpy:1671
translate fr ch4_26279968:

    # "The knocking comes again, snapping me out of my stupor."
    "Un toquement arriva de nouveau, me sortant de ma stupeur."

# game/script.rpy:1672
translate fr ch4_c04c89fd:

    # nvl clear
    # w lazy guilty "*ahem* One moment, please~!"
    nvl clear
    w lazy guilty "*ahem* Un moment, s'il vous plaît~!"

# game/script.rpy:1674
translate fr ch4_f1422f42:

    # n "Periwinkle gathers up the clothes he'd left on the floor and stuffs them out of sight."
    n "Periwinkle récupère les vêtements qu'il avait laissé au sol et les range là où personne ne les verra."

# game/script.rpy:1675
translate fr ch4_f6a25d83:

    # n "Next, he scrambles into the bathroom to check his makeup."
    n "Ensuite, il s'empresse d'aller à la salle de bain pour vérifier son maquillage."

# game/script.rpy:1676
translate fr ch4_18e27ee5:

    # w oh "(Passable, considering the circumstances...)"
    w oh "(Passable, vu les circonstances...)"

# game/script.rpy:1677
translate fr ch4_93c9bcce:

    # n "Wrapping a blanket around his shoulders in an attempt to look half-decent, he finally opens the door..."
    n "Après s'être enveloppé d'une couverture autour des épaules dans l'espoir d'avoir l'air presque décent, il ouvre finalement la porte..."

# game/script.rpy:1683
translate fr ch4_9c6ed696:

    # p "Hi! I took the day off, so I..."
    p "Hey! J'ai pris un jour de congé, alors je..."

# game/script.rpy:1684
translate fr ch4_1d0b3106:

    # p ohno2 "Sorry, did I wake you up?"
    p ohno2 "Désolé, est-ce que je t'ai réveillé?"

# game/script.rpy:1685
translate fr ch4_4ce7e2ad:

    # w decent my "Yes... yes, I had a late night. Um..."
    w decent my "Oui... oui, je me suis couché assez tard. Hm..."

# game/script.rpy:1686
translate fr ch4_6ca14993:

    # w guilty "Come in, come in! I'll be ready in just a moment."
    w guilty "Entre donc! Je serai prêt dans un instant."

# game/script.rpy:1690
translate fr ch4_09875e01:

    # "Pastille is here."
    "Pastille est là."

# game/script.rpy:1691
translate fr ch4_af7a5d1a:

    # "But WHY is he here--a day off...? Not that he HAS the day off, but that he chose to TAKE it... and then came here...?"
    "Mais POURQUOI est-il là? Un jour de congé...? Pas un jour de congé qu'on lui a donné, mais qu'il a PRIS... pour venir ici...?"

# game/script.rpy:1692
translate fr ch4_075c02d6:

