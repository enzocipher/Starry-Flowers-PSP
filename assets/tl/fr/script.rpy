    w ohhh "Mais... je ne sais toujours pas comment faire avancer les choses... est-ce que je pourrais supporter d'être rejeté...?"

# game/script.rpy:3565
translate fr ch7_a359177e:

    # a eyeroll "He won't reject you."
    a eyeroll "Il ne te rejettera pas."

# game/script.rpy:3566
translate fr ch7_229785e7:

    # w sorry "What makes you so certain...?"
    w sorry "Comment est-ce que tu peux en être aussi certaine...?"

# game/script.rpy:3567
translate fr ch7_47ddd304:

    # a lmao "That boy is madly in love with you!! Why else would he devote all that time and energy to making you happy?"
    a lmao "Ce gars est fou amoureux de toi!! Pourquoi est-ce qu'il consacrerait autant de temps et d'énergie à te rendre heureux? "

