translate fr ch7_61f43815:

    # w hood ohhh "...."
    w hood ohhh "...."

# game/script.rpy:3523
translate fr ch7_4d08edac:

    # a lol2 "So, let it all out! What, you think I'm gonna judge you?"
    a lol2 "Alors, laisse-les s'échapper! Quoi, tu penses que je vais te juger?"

# game/script.rpy:3524
