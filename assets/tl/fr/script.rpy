    # w calm "How mysterious..."
    w calm "Comme c'est mystérieux..."

# game/script.rpy:3671
translate fr ch7_c60adcac:

    # w smile "Hmhm, very well. I'll be ready momentarily 💙"
    w smile "Hmhm, très bien. Je serai prêt dans un instant 💙"

# game/script.rpy:3674
translate fr ch7_98348ebf:

    # "This is it..."
    "Ça y est..."

# game/script.rpy:3675
translate fr ch7_09cbb0da:

    # "The dramatic confession scene is upon us!"
    "La dramatique scène de confession arrive!"

# game/script.rpy:3676
translate fr ch7_e135b4c9:

    # "I have to look my best! For good luck, of course."
    "Je dois être sur mon 31! Histoire de me porter chance, bien sûr."

# game/script.rpy:3677
translate fr ch7_572f99bc:

    # "And for confidence...."
    "Et pour ce qui est de la confiance..."

# game/script.rpy:3678
translate fr ch7_76b2fe88:

    # nvl clear
    nvl clear

# game/script.rpy:3690
translate fr ch7_28d525bc:

    # n "Hand in hand, the pair makes their way to the train station."
    n "La paire part en direction de la gare, main dans la main."

# game/script.rpy:3691
translate fr ch7_931bcf8a:

    # w cute innocent "(Hmhm~ had he been planning something while I was sequestered away with my work?)"
    w cute innocent "(Hmhm~ est-ce qu'il avait prévu quelque chose pendant que j'étais retenu par le travail?)"

# game/script.rpy:3692
translate fr ch7_db582720:

    # w love "(Pastille is always so full of surprises... how positively delightful 💙)"
    w love "(Pastille est toujours plein de surprises... un véritable plaisir 💙)"

# game/script.rpy:3695
translate fr ch7_b5146a9c:

    # p "I hope I didn't interrupt any plans you had for the night...."
    p "J'espère que je n'ai pas interrompu tes plans pour la nuit...."

# game/script.rpy:3696
translate fr ch7_028375c7:

    # w happy "Oh, not at all~! It was about time I got out of the house again."
    w happy "Oh, pas du tout~! Il était temps que je sorte enfin de chez moi."

# game/script.rpy:3697
translate fr ch7_dd0f85ec:

    # w smile "I've actually had a very productive past several days, you know. Toiling away over my perfumes."
    w smile "J'ai été très productif ces derniers jours, tu sais. À travailler sur mes parfums."

# game/script.rpy:3698
translate fr ch7_dcf1b0e8:

    # p ehe "Haha, I thought that might be the case, since you hadn't dropped by in a while."
    p ehe "Haha, c'est ce que je pensais, vu que tu n'es pas venu depuis un moment."

# game/script.rpy:3699
translate fr ch7_fb3a840a:

    # w innocent "Did you miss me? 💙"
    w innocent "Est-ce que je t'ai manqué?"

# game/script.rpy:3700
translate fr ch7_13104245:

    # p embarrassed "W-well...."
    p embarrassed "E-eh bien...."

# game/script.rpy:3702
translate fr ch7_b1056d27:

    # n "Periwinkle hugs Pastille's arm tightly as they continue their walk."
    n "Periwinkle s'accroche au bras de Pastille, tandis qu'ils continuent leur marche."

# game/script.rpy:3703
translate fr ch7_9e455bb5:

    # w cute shy "(I missed you, too...)"
    w cute shy "(Tu m'as manqué, toi aussi...)"

# game/script.rpy:3706
translate fr ch7_92a9892d:

    # "When Pastille and I step off the train, we're greeted by grassy fields and a sky full of luminous stars."
    "À notre descente du train, nous sommes accueillit par des plaines vertes et un ciel remplit d'étoiles brillantes."

# game/script.rpy:3707
translate fr ch7_1242c23a:

    # "Just where has he taken me...?"
    "Où a-t-il bien pu m'emmené...?"

# game/script.rpy:3708
translate fr ch7_924bc4f2:

    # "A trail of lanterns lights the lone path forward..."
    "Une rangée de lanternes éclaire le chemin..."

# game/script.rpy:3709
translate fr ch7_27428714:

    # "Pastille takes the lead."
    "Pastille mène la marche."

# game/script.rpy:3710
translate fr ch7_76b2fe88_1:

    # nvl clear
    nvl clear

# game/script.rpy:3713
translate fr ch7_794d51f4:

    # p "It's a bit of a walk from here... but I promise it'll be worth it."
    p "C'est encore un peu plus loin... mais je te promets que ça vaut le coup."

# game/script.rpy:3714
translate fr ch7_dd9f0107:

    # w cute love "A long walk, hm? Couldn't we take a ride on your broom together~?"
    w cute love "Une longue marche, hm? Est-ce qu'on ne pourrait pas monter sur ton balai ensemble~?"

# game/script.rpy:3715
translate fr ch7_6e405e15:

    # p sure "Nah, it'd defeat the purpose. It'll feel more rewarding getting there on foot."
    p sure "Nah, ça perdrait tout son sens. La récompense sera méritée, si on y va à pied."

# game/script.rpy:3716
translate fr ch7_ebba887b:

    # w calm "Hmhm... fair enough. Tragic, though, that you'd willingly pass on an opportunity for me to cling to you."
    w calm "Hmhm... il est vrai. Quelle tragédie, quand même, que tu refuses une opportunité de m'avoir contre toi."

# game/script.rpy:3717
translate fr ch7_34a0afcc:

    # p ehe "Haha, we can fly on the way back if you want."
    p ehe "Haha, on pourra toujours voler sur le chemin du retour, si tu veux."

# game/script.rpy:3719
translate fr ch7_4f263e5f:

    # n "Pastille offers his hand again, which Periwinkle takes with a smile."
    n "Pastille lui tend la main à nouveau, et Periwinkle la prend avec plaisir."

# game/script.rpy:3724
translate fr ch7_59ddd814:

    # w "...Tell me more about your relationship with magic."
    w "...Dis-m'en plus, à propos de ton rapport avec la magie."

# game/script.rpy:3725
translate fr ch7_2528ce76:

    # p "Hm? What do you mean?"
    p "Hm? Qu'est-ce que tu veux dire?"

# game/script.rpy:3726
translate fr ch7_3c167982:

    # w "It was the same when we cleaned my house together. You insisted on doing things manually..."
    w "C'était pareil lorsque l'on nettoyait ma maison ensemble. Tu insistais sur le fait de faire les choses manuellement."

# game/script.rpy:3727
translate fr ch7_7c5e0bd7:

    # w "Not that I minded at all. Seeing you lift so many heavy things was a treat in itself 💙"
    w "Bien que cela ne m'ait pas dérangé. Te voir soulever tant d'objets lourds était une bonne récompense 💙"

# game/script.rpy:3728
translate fr ch7_4caf8895:

    # p "Hahaha, well..."
    p "Hahaha, eh bien..."

# game/script.rpy:3729
translate fr ch7_10f7805a:

    # p "Ever since I was young... it was clear I was, um... \"ridiculously talented\", as they'd put it."
    p "Depuis mon plus jeune âge... il était évident que j'étais, hum... \"ridiculement talentueux\", comme elles disaient."

# game/script.rpy:3730
translate fr ch7_e85247dc:

    # p "My moms wanted me to be a traditional witch. They enrolled me in one of the top schools, so I could learn from the best."
    p "Mes mères voulaient que je sois un sorcier traditionnel."
    p "Elles m'ont mis dans une des meilleures écoles, pour que j'apprenne des meilleurs."

# game/script.rpy:3732
translate fr ch7_0b59e908:

    # p "I-it was an all-girls school, though... Guess I was young enough that no one realized I was a boy."
    p "C-c'était une école réservée aux filles... J'imagine que j'étais assez jeune pour que personne ne réalise que j'étais un garçon."

# game/script.rpy:3733
translate fr ch7_c1703821:

    # p "I really... didn't belong there. On any level."
    p "Je ne me sentais... vraiment pas à ma place. À tous les niveaux."

# game/script.rpy:3734
translate fr ch7_fa8d2d79:

    # p "But, I kept at it as long as I could. Just enough to keep my parents happy, until I could go out and live on my own."
    p "Mais j'ai gardé tout ça pour moi aussi longtemps que j'ai pu."
    p "Juste assez pour rendre mes parents heureux, jusqu'à ce que je puisse partir et vivre par moi-même."

# game/script.rpy:3736
translate fr ch7_73d8e924:

    # p "Haha, I still don't understand exactly why... but I always felt uncomfortable using my magic."
    p "Haha, je ne comprends pas exactement pourquoi... mais je me suis toujours senti inconfortable, quand j'utilise ma magie."

# game/script.rpy:3737
translate fr ch7_b1a584dd:

    # p "It felt like cheating. Like... this kind of power shouldn't come so easily."
    p "J'avais l'impression de tricher. Je veux dire... ce genre de pouvoir ne devrait pas venir aussi facilement."

# game/script.rpy:3738
translate fr ch7_f94b0797:

    # p "Sy thought so, too. I guess that's why I latched onto her when we met..."
    p "Sy pensait la même chose. J'imagine que c'est pour ça que je me suis attaché à elle, quand on s'est rencontré..."

# game/script.rpy:3739
translate fr ch7_b940b2af:

    # p "She used to really hate magic. Which worked out perfectly for me--it was a good excuse to pretend to be a regular human like her."
    p "Elle détestait vraiment la magie. Ce qui était parfait pour moi--"
    p "C'était une bonne excuse pour faire semblant d'être un humain normal, comme elle."

# game/script.rpy:3740
translate fr ch7_e058bb72:

    # p "So... that's what I did. For the past... seven years?"
    p "Alors... c'est ce que j'ai fait. Pendant... sept ans?"

# game/script.rpy:3743
translate fr ch7_fe2bf237:

    # w cute my "Seven years... that's quite a long time!"
    w cute my "Sept ans... c'est long!"

# game/script.rpy:3745
translate fr ch7_4d057338:

    # p "Yeah, but there was a lot to distract me back then... it took a while to get Atelier Sweets up and running."
    p "Ouais, mais il y avait assez de choses à faire pour m'en distraire... Atelier Sweets ne s'est pas construit en un jour."

# game/script.rpy:3746
translate fr ch7_dc3c7909:

    # p calm "And... Sy did eventually find out. I thought she'd disown me when she did..."
    p calm "Et... Sy a éventuellement découvert la vérité. Je pensais qu'elle me chasserait, si elle le savait..."

# game/script.rpy:3747
translate fr ch7_c13fd2df:

    # p ehe "But instead... she told me I shouldn't have hid it. Even though I doubt we would've become friends if I told her from the beginning..."
    p ehe "Mais au lieu de ça... elle m'a dit que je n'aurais pas dû à le cacher."
    p "Même si je doute que nous serions devenus amis si je lui l'avais dit dès le début..."

