    # w yell "You BROKE my magic! For weeks and weeks, all I could conjure was that stupid peach blossom scent...!"
    w yell "T'avais BRISÉ ma magie! Pendant des semaines tout ce que je pouvais créer, c'était cette stupide odeur de pêche...!"

# game/script.rpy:3915
translate fr ch7_b704fa44:

    # p woah "A-ah... really...?"
    p woah "A-ah... vraiment...?"

# game/script.rpy:3916
translate fr ch7_b58af626:

    # w nofair2 "Yes! Until just the other day... which I spent CRYING, in the dusty back room of the apothecary, telling Astragalus all about it...!"
    w nofair2 "Oui! Jusqu'à l'autre jour..."
    w "{size=-2}Que j'ai passé à PLEURER, dans l'arrière boutique poussiéreuse de la boutique d'apothicaire, à raconter tout ça à Astragalus...!{/size}"

# game/script.rpy:3917
translate fr ch7_03175381:

    # w nofair "After all that... everything I spent so long preparing my heart for... you have the NERVE to try to confess first...?!"
    w nofair "Et après ça... après tout le temps que j'ai mis pour préparer mon coeur... t'as le CULOT de vouloir faire ta confession en premier...?! "

# game/script.rpy:3918
translate fr ch7_ea73974b:

    # p aw "I'm sorry."
    p aw "Je suis désolé."

# game/script.rpy:3919
translate fr ch7_4abce74d:

    # w nofair2 "Don't apologize! I already said I won't forgive you!!" with vpunch
    w nofair2 "Ne t'excuse pas! Je te l'ai déjà dit, je ne te pardonnerai pas!!" with vpunch

# game/script.rpy:3920
translate fr ch7_937c48a8:

    # p ehe "What do you want me to do, then...?"
    p ehe "Qu'est-ce que tu veux que je fasse, dans ce cas...?"

# game/script.rpy:3921
translate fr ch7_2af101c3:

    # w insulted "I don't know, fucking kiss me if you love me so much!!!"
    w insulted "J'sais pas, embrasse-moi, si tu m'aimes tant que ça!!!"

# game/script.rpy:3929
translate fr ch7_71e3c067:

    # n "Pastille approaches, gently raising a hand to Periwinkle's cheek..."
    n "Pastille s'approche, pose gentillement sa main sur la joue de Periwinkle..."

# game/script.rpy:3931
translate fr ch7_c2b3fc7a:

    # n "...and does exactly as he's told."
    n "...et fait exactement ce qui lui a été demandé."

# game/script.rpy:3933
translate fr ch7_58024a15:

    # p "I love you."
    p "Je t'aime."

# game/script.rpy:3934
translate fr ch7_dde4b08e:

    # n "Periwinkle's heart skips a beat."
    n "Le coeur de Periwinkle ne fit qu'un bond."

# game/script.rpy:3936
translate fr ch7_2c91cb68:

    # w "I love you, too...!"
    w "Moi aussi, je t'aime...!"

# game/script.rpy:3937
translate fr ch7_ff617e74:

    # n "He hugs Pastille tightly, careful not to knock him over this time."
    n "Il serre tendrement Pastille, en faisant attention à ne pas le faire tomber, cette fois-ci."

# game/script.rpy:3944
translate fr ch7_33de9d18:

    # "It takes everything I've got to keep myself from bursting into tears."
    "Je dois me retenir avec tout ce que j'ai pour ne pas fondre en larmes."

# game/script.rpy:3945
translate fr ch7_57e13493:

    # "I won't ruin my makeup on this perfect date...!"
    "Je ne veux pas ruiner mon maquillage pendant ce rendez-vous parfait...!"

# game/script.rpy:3946
translate fr ch7_1c5f0457:

    # "This beautiful place, that Pastille chose just for us..."
    "Ce magnifique endroit, que Pastille a choisi rien que pour nous..."

# game/script.rpy:3947
translate fr ch7_bc3b2ea7:

    # "I can't have my memory of this perfect night obscured by tears...."
    "Je ne veux pas avoir le souvenir de cette nuit parfaite obscurci par des larmes...."

# game/script.rpy:3948
translate fr ch7_76b2fe88_4:

    # nvl clear
    nvl clear

# game/script.rpy:3954
translate fr ch7_ec2dd684:

    # p "It looks like the meteor shower's over...."
    p "Il semblerait que la pluie d'étoiles filantes soit terminée...."

# game/script.rpy:3955
translate fr ch7_75d5ddf8:

    # w cute pout "...Take me home...."
    w cute pout "...Ramène-moi à la maison...."

# game/script.rpy:3956
translate fr ch7_8bb2e9cd:

    # p ehe "A-are you still mad at me...?"
    p ehe "T-Tu es toujours en colère...?"

# game/script.rpy:3957
translate fr ch7_5b794844:

    # w oops "I'm not mad at you...."
    w oops "Je ne le suis pas...."

# game/script.rpy:3958
translate fr ch7_16f5b969:

    # p aw "I've never seen you like this. I don't know how else I should interpret it."
    p aw "Je ne t'ai jamais vu comme ça. Alors je ne sais pas comment je devrais l'interpréter."

# game/script.rpy:3959
translate fr ch7_f5a91280:

    # w conflicted "I'm overwhelmed. Elated... relieved... and frustrated...."
    w conflicted "Je suis dépassé. Exalté... soulagé... et frustré...."

# game/script.rpy:3960
translate fr ch7_8b592c68:

    # w ohhh "I-I want to get in bed... so that you can hold me close all night..."
    w ohhh "Je-je veux aller au lit... pour que tu puisses me tenir toute la nuit..."

# game/script.rpy:3961
translate fr ch7_ad678a44:

    # w ohhh2 "I don't think I'll be convinced that this was real unless you do that. So... please...?"
    w ohhh2 "Je n'arriverai pas à croire que tout ça est réel si tu ne le fais pas. Alors... s'il te plaît...?"

# game/script.rpy:3962
translate fr ch7_9cd2e04f:

    # p doki "That sounds... really nice...."
    p doki "Ça a l'air... vraiment agréable...."

# game/script.rpy:3963
translate fr ch7_23f5322d:

    # p happy "Okay ❤ If it's to convince you, I guess I have no choice...."
    p happy "Très bien ❤ Si c'est pour te convaincre, j'imagine que je n'ai pas le choix...."

