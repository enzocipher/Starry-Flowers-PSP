translate fr ch7_4ffcdd35:

    # a sure "Business associates. Don't forget I've got loads of orders for you now that you're back to normal."
    a sure "Associés. N'oublie pas que j'ai des tas de commandes pour toi, maintenant que tu vas mieux."

# game/script.rpy:3596
translate fr ch7_b19f23d3:

    # w happy "I'll go home and fill them right away! But first..."
    w happy "Je les préparerai dès que je rentre chez moi! Mais avant cela..."

