# game/script.rpy:708
translate fr start_66ce2a36:

    # n "Periwinkle gives him another peck on the lips, and leads him through the cluttered living room to his bedroom door..."
    n "Periwinkle lui donne un petit bisou, et l'emmène du salon jusqu'à la porte de la chambre..."

# game/script.rpy:721
translate fr ch2_7b49a2da:

    # centered "{w=3}{nw}"
    centered "{w=3}{nw}"

# game/script.rpy:727
translate fr ch2_420c2aa2:

    # "It took me ages to get out of bed that morning."
    "Me lever me pris une éternité, ce matin."

# game/script.rpy:728
translate fr ch2_d9e096c6:

    # "After all... I just couldn't stop thinking about how absolutely adorable Pastille was! 💙"
    "Après tout... Je ne pouvais pas m'empêcher de penser à quel point Pastille est absolument adorable! 💙"

# game/script.rpy:729
translate fr ch2_7c711ce7:

    # "He scrambled out of here almost as soon as he woke up, saying he couldn't be late for work..."
    "Il s'échappa d'ici dès le réveil, disant qu'il ne pouvait pas arriver en retard à son boulot..."

# game/script.rpy:730
translate fr ch2_e5f82cff:

    # "Such a shame. Would've been nice to get one last round in~"
    "C'est dommage. Vraiment. Un dernier round n'aurait pas été de refus~"

# game/script.rpy:731
translate fr ch2_a69cdafc:

    # "...I did get a kiss goodbye, though 💙"
    "...Mais j'ai eu mon baiser d'au revoir 💙"

# game/script.rpy:732
translate fr ch2_79c07e86:

    # nvl clear
    # w bed shy "Ahh, it's nice to feel like a housewife for a moment~"
    nvl clear
    w bed shy "Ahh, c'est agréable, de se sentir comme une petite épouse~"

# game/script.rpy:734
translate fr ch2_369e7bdd:

    # w smile "But I should get to work, too..."
    w smile "Mais je devrais me mettre au travail, moi aussi..."

# game/script.rpy:735
translate fr ch2_a95a50d1:

    # w happy "I have an order to fill, don't I~?"
    w happy "J'ai une commande à remplir, après tout~"

# game/script.rpy:738
translate fr ch2_3c76f5d0:

    # n "Periwinkle finally rolls out of bed and gets ready for the day..."
    n "Periwinkle se glisse enfin hors du lit et se prépare pour la journée..."

# game/script.rpy:741
translate fr ch2_5a13e7e9:

    # "The order in question is for a nearby apothecary."
    "La commande vient d'une apothicaire proche d'ici."

# game/script.rpy:742
translate fr ch2_35f25f34:

    # "Did you know? Aromagic like mine is actually quite good for you~"
    "Le savais-tu? De l'aromagie telle que la mienne est assez bénéfique~"

# game/script.rpy:743
translate fr ch2_8f79525a:

    # "It's got nothing on actual healing magic, but the calming atmosphere it creates does wonders for one's mood."
    "Ce n'est pas comparable à une véritable magie de soin, mais l'atmosphère calmante qu'elle crée fait des miracles, pour ce qui est de l'humeur."

# game/script.rpy:744
translate fr ch2_48c6a187:

    # nvl clear
    # "This particular batch is meant to help with insomnia..."
    nvl clear
    "Ce lot est spécialement fait pour lutter contre l'insomnie..."

# game/script.rpy:746
translate fr ch2_9bdec3ec:

    # "Which is ironic, considering how late I stayed up with Pastille 💙"
    "Ce qui est ironique, si on prend en compte la nuit que je viens de passer avec Pastille 💙"

# game/script.rpy:747
translate fr ch2_e22fb32a:

    # nvl clear
    # w pj teehee "Whoops, can't be getting distracted now~ I really need to finish up these last few bottles..."
    nvl clear
    w pj teehee "Oups, je ne peux pas me laisser distraire~ Je dois vraiment finir ces dernières bouteilles..."

# game/script.rpy:750
translate fr ch2_e708ef33:

    # w calm "{nw}"
    w calm "{nw}"

# game/script.rpy:751
translate fr ch2_2dd620a3:

    # n "Periwinkle closes his eyes and draws his wand."
    n "Periwinkle ferme les yeux et sort sa baguette."

# game/script.rpy:753
translate fr ch2_3425d8a6:

    # n "Large drops form at its tip, falling into the empty bottle one by one."
    n "De grandes goutes se forment au bout, avant de tomber dans la bouteille vide une par une."

# game/script.rpy:754
translate fr ch2_3222c5b9:

    # n "With each drip, the bottle's contents swell, and after only the fifth drop, it's completely filled."
    n "À chaque création, l'intérieur remue, et après la cinquième, la bouteille est remplie."

# game/script.rpy:757
translate fr ch2_fbaed311:

    # w innocent "Perfect! Ahh, it's so much easier to finish these with a clear mind..."
    w innocent "Parfait! Ahh, finir tout ça avec les idées claires est bien plus facile..."

# game/script.rpy:758
translate fr ch2_6e325112:

    # w shy "I can't help it if a refreshing night out is the only way to regain my focus 💙"
    w shy "Ce n'est pas ma faute, si une nuit rafraîchissante est le seul moyen de me concentrer 💙"

# game/script.rpy:759
translate fr ch2_afd133a7:

    # w teehee "Although~ I probably could've gotten one of these done last night if Pastille hadn't been so impatient... 💙"
    w teehee "Bien que~ J'aurais probablement pu remplir l'une d'entre elles la nuit dernière, si Pastille n'avait pas été si impatient... 💙"

# game/script.rpy:760
translate fr ch2_44174832:

    # w calm "No, no, mustn't let my mind wander too far from work now."
    w calm "Non, je ne devrais pas laisser mes pensées m'éloigner du travail."

# game/script.rpy:762
translate fr ch2_67507517:

    # n "Periwinkle fills the remaining bottles, screwing the lids on as he goes."
    n "Periwinkle remplit les bouteilles restantes, les bouchant à chaque fois."

# game/script.rpy:764
translate fr ch2_5bd5f285:

    # w smile "There. Hmhm, now my house is going to smell like lavender..."
    w smile "Comme ça. Hmhm, ma maison risque de sentir la lavande maintenant..."

# game/script.rpy:765
translate fr ch2_8bdf90ac:

    # w innocent "I'd better head out before I'm lulled to sleep by my own magic~"
    w innocent "Mieux vaut sortir avant que ma propre magie ne me donne envie de me recoucher~"

# game/script.rpy:779
translate fr ch2_85bf7599:

    # "The apothecary is only a short walk away, but I've never managed to walk in its doors on time."
    "La boutique d'apothicaire n'est pas très loin d'ici, mais je n'ai jamais réussi à franchir ses portes dans les temps."

# game/script.rpy:780
translate fr ch2_bd4b3ec4:

    # "Perhaps because it's so close, I always underestimate the time it takes to reach it..."
    "Peut-être qu'à cause de sa proximité, je pense toujours avoir assez de temps avant d'y aller..."

# game/script.rpy:781
translate fr ch2_3b3d6df9:

    # "I can hear the owner tapping her foot with impatience as soon as I open the door."
    "Je peux entendre la priopriétaire taper du pied avec impatience dès que j'ouvre la porte."

# game/script.rpy:782
translate fr ch2_76b2fe88:

    # nvl clear
    nvl clear

# game/script.rpy:785
translate fr ch2_a74c124f:

    # w happy "Astragalus~! I have that special order ready for you~"
    w happy "Astragalus~! J'ai une commande spéciale pour toi~"

# game/script.rpy:786
translate fr ch2_318b7805:

    # a annoyed "You're late again, Periwinkle."
    a annoyed "Encore en retard, Periwinkle."

# game/script.rpy:787
translate fr ch2_1019ebc0:

    # w innocent "Lost track of time 💙 You'll forgive me, won't you~?"
    w innocent "J'ai perdu la notion du temps 💙 Tu me pardonnes, pas vrai~?"

# game/script.rpy:788
translate fr ch2_7862874c:

    # a "You are literally my only provider who has no respect for appointments."
    a "Tu es littéralement mon seul fournisseur incapable de respecter un délai."

# game/script.rpy:789
translate fr ch2_2fb8a6f9:

    # w oh "That's simply not true! I never miss a date."
    w oh "C'est absolument faux! Je ne suis jamais en retard à un rendez-vous."

# game/script.rpy:790
translate fr ch2_acda7219:

    # a lol "There's the problem. You were out getting laid again, weren't you?"
    a lol "C'est ça le problème. T'es encore aller coucher avec je ne sais qui, n'est-ce pas?"

# game/script.rpy:791
translate fr ch2_dbeacd97:

    # w pout "How vulgar~ I had a romantic evening with a VERY cute boy..."
    w pout "Si vulgaire~ Sache que j'ai eu une soirée romantique avec un sorcier TRÈS mignon..."

# game/script.rpy:792
translate fr ch2_d7ebcbc7:

    # w innocent "Who then ended up sleeping over 💙"
    w innocent "Qui est finalement rester pour la nuit 💙"

# game/script.rpy:793
translate fr ch2_facdd2e0:

    # a whatever "Well, you had all week to fill the order. Try getting it done in advance next time."
    a whatever "Eh bien. T'avais toute la semaine pour remplir ma commande. Essaie de la finir en avance, la prochaine fois. "

# game/script.rpy:794
translate fr ch2_8de08278:

    # w calm "Yes, ma'am~"
    w calm "Bien sûr~"

# game/script.rpy:795
translate fr ch2_e220bd55:

    # a closed "Now let's see what you brought..."
    a closed "Voyons voir ce que tu as amené..."

# game/script.rpy:797
translate fr ch2_6aa2ff6b:

    # "I've worked with Astragalus for a few years now."
    "Je travaille avec Astragalus depuis maintenant quelques années."

# game/script.rpy:798
translate fr ch2_88aee593:

    # "She's COMPLETLY immune to my charms. Shocking, to say the least."
    "Elle est COMPLÈTEMENT immunisée à mes charmes. \"Choquant\" ne serait qu'un euphémisme."

# game/script.rpy:799
translate fr ch2_f1139fde:

    # "But it's meant we've been able to remain good friends all this time~"
    "Mais cela veut dire que nous avons pu rester de bons amis pendant tout ce temps~"

# game/script.rpy:800
translate fr ch2_4fc199f3:

    # "Or... hm. Let's see..."
    "Ou... hm. Voyons voir..."

# game/script.rpy:801
translate fr ch2_76b2fe88_1:

    # nvl clear
    nvl clear

# game/script.rpy:804
translate fr ch2_2c3696be:

    # w oh "Astragalus. Would you consider us to be good friends?"
    w oh "Astragalus. Est-ce que tu nous considérerais comme de bons amis?"

# game/script.rpy:805
translate fr ch2_c86bbb5c:

    # a whatever "I put up with you."
    a whatever "Je te supporte."

# game/script.rpy:806
translate fr ch2_373f7314:

    # w happy "My, but you don't put up with ANYONE! You must really like me 💙"
    w happy "Eh bien! Mais tu ne supportes pas n'importe qui! Ce qui veut dire que tu dois vraiment m'apprécier 💙"

# game/script.rpy:807
translate fr ch2_47067d4c:

    # a lol "You got a favor to ask or something? Is that what you're getting at?"
    a lol "T'as quelque chose à me demander? Qu'est-ce que tu veux de moi?"

# game/script.rpy:808
translate fr ch2_df3d1bd8:

    # w calm "No, I was just thinking of how to categorize our relationship."
    w calm "Rien du tout, je me demandais juste comment catégoriser notre relation."

# game/script.rpy:809
translate fr ch2_72e2a8ac:

    # a "\"Business associate\" works just fine, doesn't it?"
    a "\"Partenaires commerciaux\" me semble assez bien, tu ne penses pas?"

# game/script.rpy:810
translate fr ch2_5f78763b:

    # w happy "Come now, surely you consider us to be closer than that!"
    w happy "Allez, tu dois bien nous considérer plus proche que ça!"

# game/script.rpy:811
translate fr ch2_ce50824a:

    # a sure "I know better than to get involved with you, Periwinkle."
    a sure "J'ai mieux à faire que de m'engager avec toi, Periwinkle."

# game/script.rpy:812
translate fr ch2_17ce8a61:

    # w my "Why, whatever do you mean?"
    w my "Que veux-tu dire par là?"

# game/script.rpy:813
translate fr ch2_0ac87123:

    # a whatever "You're too dazzling."
    a whatever "Tu es beaucoup trop éclatant."

# game/script.rpy:814
translate fr ch2_4a6eea27:

    # w innocent "I take that as a compliment~"
    w innocent "Je prends ça comme un compliment~"

# game/script.rpy:815
translate fr ch2_d60255a0:

    # a annoyed "Great, now will you stop distracting me? I'm trying to count."
    a annoyed "Très bien, est-ce tu voudrais bien arrêter de me distraire, dans ce cas? J'essaie de compter."

# game/script.rpy:817
translate fr ch2_8c4a5641:

    # "Yes, we're definitely good friends."
    "Nous sommes définitivement de bons amis."

# game/script.rpy:818
translate fr ch2_9ecc4a32:

    # "\"Too dazzling\" though... I'm not sure there IS such a thing."
    "\"Trop éclatant\"... Je ne sais même pas si quelque chose comme ÇA existe."

# game/script.rpy:819
translate fr ch2_82c90c4f:

    # "And what would be wrong with it if there was? What point is there in not shining as brightly as one can?"
    "Et en quoi serait-ce un problème? Quel intérêt y a-t-il à ne pas briller autant que possible?"

# game/script.rpy:820
translate fr ch2_d0dcce99:

    # "Astragalus finishes counting the bottles, sighing in feigned exasperation as she marks them off her checklist..."
    "Astragalus finit de compter les bouteilles, soupirant avec une exaspération forcée tandis qu'elle les raye de sa liste..."

# game/script.rpy:821
translate fr ch2_529b0ff5:

    # nvl clear
    # a sure "You may always be late... but you deliver quality every time. You're consistent, if nothing else."
    nvl clear
    a sure "T'as beau arriver en retard à chaque fois... c'est toujours de la qualité. On peut au moins dire que tu ne changes jamais."

# game/script.rpy:824
translate fr ch2_389bf1e7:

    # w teehee "The waiting is part of the fun. It builds excitement, wouldn't you say?"
    w teehee "L'attente est son propre jeu. Ça ajoute du piment, tu ne penses pas? "

# game/script.rpy:825
translate fr ch2_2f490664:

    # a whatever "Nope, just builds frustration for me. But at least you always come through."
    a whatever "Nah, juste de la frustration. Cependant, je sais que mes commandes arriveront toujours."

# game/script.rpy:827
translate fr ch2_4251ed12:

    # n "She unlocks a small drawer behind the counter, and takes out an envelope with Periwinkle's name scribbled on it."
    n "Elle déverouille un petit tiroir derrière le comptoir, et en sort une enveloppe avec le nom de Periwinkle dessus."

# game/script.rpy:829
translate fr ch2_9104554e:

    # a closed "Here's the rest of your payment. Don't spend it all in one place."
    a closed "Voici le reste de ta paie. Ne dépense pas tout d'un coup."

# game/script.rpy:830
translate fr ch2_338d50e7:

    # w calm "Oh, I couldn't if I tried! Really, you're too generous..."
    w calm "Oh, je n'y arriverais pas même si je le voulais! Tu es si généreuse..."

# game/script.rpy:833
translate fr ch2_8daa5982:

    # n "Astragalus rolls her eyes and begins stocking the shelves with her new inventory."
    n "Astragalus lève les yeux au ciel avant de ranger son nouvel inventaire dans ses étagères."

# game/script.rpy:835
translate fr ch2_ffbdbe6c:

    # "Two or three orders a month... that's all it takes to support myself, entirely through this apothecary."
    "Deux ou trois commandes par mois... c'est tout ce qu'il me faut pour vivre, uniquement grâce à cette apothicaire."

# game/script.rpy:836
translate fr ch2_ba2406db:

    # "Hard to believe my magic is really worth so much, but who am I to complain?"
    "C'est quand même incroyable, de se dire que ma magie vaut autant, mais qui suis-je pour m'en plaindre?"

# game/script.rpy:837
translate fr ch2_acb5044d:

    # "It's certainly a more favorable balance compared to the kind of work I was doing years ago."
    "C'est en tout cas bien plus stable que le travail que j'avais il y a quelques années."

# game/script.rpy:838
translate fr ch2_7acd925f:

    # nvl clear
    # "And I do enjoy the freedom, the excessive amounts of time I have for partying, for dates..."
    nvl clear
    "Et j'apprécie toute ma liberté, tout ce temps que j'ai pour faire la fête, pour les rendez-vous..."

# game/script.rpy:840
translate fr ch2_a2058868:

    # "Ah, on that note~"
    "Ah, en parlant de cela~"

# game/script.rpy:841
translate fr ch2_0b1b7e93:

    # nvl clear
    # w happy "With all that business out of the way... would you like to hear about my date? 💙"
    nvl clear
    w happy "Maintenant que mon travail est terminé... voudrais-tu m'entendre parler de mon rendez-vous? 💙"

# game/script.rpy:844
translate fr ch2_fa857f5d:

    # a sure "Would I LIKE to? Not necessarily."
    a sure "Est-ce que je le VOUDRAIS? Pas vraiment."

# game/script.rpy:845
translate fr ch2_95d8347d:

    # w teehee "Please, Astragalus, as someone with no romance in your OWN life, the least you can do is live vicariously through me~"
    w teehee "Allez, Astragalus, en tant que personne n'ayant aucune romance dans sa PROPRE vie, tu pourrais au moins vivre à travers moi~"

# game/script.rpy:846
translate fr ch2_8be11c8d:

    # a whatever "The no romance thing is by choice. I listen to you gush for your own damn sake."
    a whatever "Le manque de romance est un choix. Je t'écoute juste pour ton propre bien."

# game/script.rpy:847
translate fr ch2_66b3a391:

    # w my "For MY sake?"
    w my "Pour MON bien?"

# game/script.rpy:848
translate fr ch2_e2b9789b:

    # a sure "Yeah, I'm afraid you might actually implode if you had no one to talk to about this stuff."
    a sure "Ouais, j'ai bien peur de te voir imploser si tu ne trouves personne à qui parler de ce genre de truc."

# game/script.rpy:849
translate fr ch2_fdfc2ccd:

    # a lol "I'm actually making a noble sacrifice every day that you come in here with new tales of romantic conquest."
    a lol "Je fais un noble sacrifice chaque jour où tu viens me voir avec de nouvelles histoires de conquêtes romantiques, à vrai dire."

# game/script.rpy:850
translate fr ch2_b3b6ebb7:

    # w pout "Hmph. If you're truly suffering, I shall desist..."
    w pout "Hmph. Si tu souffres autant, je ne devrais point t'importuner..."

# game/script.rpy:851
translate fr ch2_115b6d90:

    # a smile "That's the thing, though... I DO like seeing you all worked up over something, even if I don't understand it myself."
    a smile "Mais le truc, c'est que... J'aime bien te voir totalement excité à propos de quelque chose, même si je ne le comprends pas moi-même."

# game/script.rpy:852
translate fr ch2_dfd74c02:

    # w happy "Ahh, so there IS a mutual benefit! You'll listen, then? 💙"
    w happy "Ahh, donc il y a BIEN un bénéfice mutuel! Acceptes-tu de m'écouter, dans ce cas? 💙"

# game/script.rpy:853
translate fr ch2_e4b44b62:

    # a sure "Yeah, at least until I get all this put away. After that, I'm kicking you out for the day."
    a sure "Ouais, au moins jusqu'à ce que je mette tout ça autre part. Dès que j'ai fini, je te fais dégager pour aujourd'hui. "

# game/script.rpy:855
translate fr ch2_aa202e59:

    # w calm "Fair enough. I'd better be brief, then..."
    w calm "Très bien. Mieux vaut être bref, dans ce cas..."

# game/script.rpy:857
translate fr ch2_c163a19e:

    # w teehee "He's the absolute cutest thing! I picked him up at a candy shop yesterday 💙"
    w teehee "Il est tout simplement la chose la plus mignonne que je n'aie jamais vu! Je suis aller le chercher hier, à un magasin de bonbons 💙"

# game/script.rpy:858
translate fr ch2_7ea91466:

    # w happy "Fluffy pink hair, with golden eyes, naturally rosy cheeks that make him look as if he's always a little embarrassed by something..."
    w happy "{size=-4}Des cheveux roses bouclés, avec des yeux d'or, et des joues naturellement rosies qui lui donnent l'air de toujours être embarrassé par quelque chose...{/size}"

# game/script.rpy:859
translate fr ch2_78bc035b:

    # w shy "He's shy, but not the type that becomes paralyzed in the bedroom--"
    w shy "Il est timide, mais pas du genre à se figer une fois au lit--"

# game/script.rpy:860
translate fr ch2_e6e9e69b:

    # a augh "Periwinkle, for the last time, I do NOT need to hear about bedroom stuff." with vpunch
    a augh "Periwinkle, pour la dernière fois, je n'ai PAS besoin de savoir ce qui se passe dans la chambre." with vpunch

# game/script.rpy:861
translate fr ch2_91bce83e:

    # w my "I wasn't giving any details!"
    w my "Je n'allais pas donner le moindre détail!"

# game/script.rpy:862
translate fr ch2_f28bb905:

    # w shy "Although, the details ARE the best part 💙"
    w shy "Même si pour tout dire, les détails SONT la meilleure partie 💙"

# game/script.rpy:863
translate fr ch2_6f8d4d69:

    # a annoyed "This is a \"safe for work\" zone only. Break that rule, and you're outta here."
    a annoyed "C'est un endroit \"sûr pour le travail\" ici. Brise cette règle, et je te fais dégager."

# game/script.rpy:864
translate fr ch2_91ce2d8b:

    # w innocent "My apologies~ I'll refrain."
    w innocent "Mes excuses~ Je m'en abstiendrai."

# game/script.rpy:865
translate fr ch2_dc5be651:

    # w love "Anyway, my point is... he's EXTREMELY cute. Adorable, in fact!"
    w love "De toute façon, ce que je voulais dire... c'est qu'il est INCROYABLEMENT mignon. Je dirais qu'il est carrément adorable!"

# game/script.rpy:866
translate fr ch2_d8b497e3:

    # a eyeroll "Right, so, standard fare for you."
    a eyeroll "Très bien, donc comme d'habitude."

# game/script.rpy:867
translate fr ch2_fc605430:

    # w my "Absolutely not! If he was just your average cutie, would I be emphasizing his cuteness so much?"
    w my "Absolument pas! Si il était juste un peu mignon, est-ce que j'insisterais tant sur ce point?"

# game/script.rpy:868
translate fr ch2_a47387c2:

    # a sure "I don't meet these people, so it's all the same to me."
    a sure "Je ne rencontre aucune de ces personnes, donc ce sont un peu tous les mêmes pour moi."

# game/script.rpy:869
translate fr ch2_afb4034f:

    # w oh "How can it be~? The intensity is so drastically different... perhaps SO intense that I'm having trouble explaining it properly."
    w oh "Comment cela se peut-il~? L'intensité est si différente... peut-être qu'elle est SI intense que j'ai du mal à l'expliquer correctement."

# game/script.rpy:870
translate fr ch2_3da682aa:

    # a closed "I'll say. All you've really told me so far is that he's cute and shy."
    a closed "À vrai dire. Tout ce que je sais de lui est qu'il est mignon et timide."

# game/script.rpy:871
translate fr ch2_8e3642e4:

    # w shy "He's kind, as well! He saved the best part of our dessert for me without even asking!"
    w shy "Il est aussi très gentil! Il m'a gardé la meilleure part de notre dessert sans que je le lui demande!"

# game/script.rpy:872
translate fr ch2_dfa9b85a:

    # a lol "Wow, I would've led with that one."
    a lol "Wow, assez pour séduire n'importe qui."

# game/script.rpy:873
translate fr ch2_fdbe174a:

    # w pout "Ohh, enough of your sarcasm. When all my favorite details are off-limits, what do you suppose I'm LEFT with?"
    w pout "Ohh, assez de sarcasmes. Quand tous mes détails favori sont interdits, qu'est-ce qu'il me RESTE?"

# game/script.rpy:874
translate fr ch2_ab7c305b:

    # a happy "Well, what really matters is that you had a good night. Even if it meant you couldn't get here on time like I asked."
    a happy "Tout ce qui compte, c'est que t'aies passé une bonne nuit. Même si cela veut dire ne pas arriver à l'heure comme je te l'avais demandé."

# game/script.rpy:875
translate fr ch2_f5e62b00:

    # w love "Ahh~ I'm already hoping to see him again, to be honest..."
    w love "Ah~ J'espère déjà le revoir, pour être honnête..."

# game/script.rpy:876
translate fr ch2_0979287d:

    # a hm "Oh yeah? Don't hear that from you very often."
    a hm "Ah ouais? Assez rare de te voir dire ça."

# game/script.rpy:877
translate fr ch2_83be95f7:

    # w oh "Really? But I've gone on second dates all the time."
    w oh "Vraiment? J'ai pourtant eu de nombreux second rendez-vous."

# game/script.rpy:878
translate fr ch2_95f62998:

    # a lol2 "This guy got a name?"
    a lol2 "Ce gars a un nom?"

# game/script.rpy:879
translate fr ch2_899be6dd:

    # w shy "Hmhm, I don't kiss and tell 💙"
    w shy "Hmhm, je ne suis pas du genre qui divulgue les secrets de ses liaisons 💙"

# game/script.rpy:880
translate fr ch2_7b70ce89:

    # a sure "No, actually, you tell me about everyone you kiss."
    a sure "C'est plutôt le contraire. Tu me parles de tout ceux avec qui t'as une relation."

# game/script.rpy:881
translate fr ch2_44e74989:

    # a lol "C'mon, if he's really the absolute cutest, it's a shame to keep him anonymous, right? Not like I'm gonna tell anyone anyways."
    a lol "Allez, s'il est vraiment le plus mignon, ce serait dommage de ne pas avoir un nom à mettre sur lui, pas vrai?"
    a "C'est pas comme si j'allais le dire à qui que ce soit."

# game/script.rpy:882
translate fr ch2_cb259e44:

    # w calm "Fine... his name is Pastille."
    w calm "Très bien... son nom est Pastille."

# game/script.rpy:883
translate fr ch2_ce121fd3:

    # a annoyed "Hmph. Even his name's cute."
    a annoyed "Hmph. Même son nom est mignon."

# game/script.rpy:884
translate fr ch2_b434ce04:

    # w happy "Right~?"
    w happy "N'est-ce pas~?"

# game/script.rpy:885
translate fr ch2_2d463d2b:

    # w smile "Oh, that reminds me--he sold me some candies that share his name. Would you like to try?"
    w smile "Oh, cela me fait penser--il m'a vendu quelques bonbons à son nom. Voudrais-tu en goûter un? "

# game/script.rpy:886
translate fr ch2_628745c1:

    # a happy "Sure. How could a witch turn down free candy?"
    a happy "Bien sûr. Comment est-ce qu'une sorcière pourrait refuser des bonbons gratuits?"

# game/script.rpy:887
translate fr ch2_2ac72dd0:

    # n "Periwinkle digs into his bag and pulls out one of the pastilles."
    n "Periwinkle fouille dans son sac et en sort quelques pastilles."

# game/script.rpy:888
translate fr ch2_c90345e5:

    # n "He hands the candy to Astragalus, who promptly unwraps it and pops it into her mouth."
    n "Il donne le bonbon à Astragalus, qui le déballe avant de l'envoyer dans sa bouche.  "

# game/script.rpy:889
translate fr ch2_e3dc6cdf:

    # a hm "Mmf... Oh, these are GOOD. Where'd you say this candy shop was?"
    a hm "Mmf... Oh, ils sont VRAIMENT bons. Où est-ce que je peux trouver ce magasin de bonbons?"

# game/script.rpy:890
translate fr ch2_6e7c54dc:

    # w happy "Not far from here! I'll give you directions..."
    w happy "Pas très loin d'ici! Je vais te donner quelques indications..."

# game/script.rpy:897
translate fr ch2_58993334:

    # "Shortly after telling Astragalus where to find Atelier Sweets, she unceremoniously kicked me out..."
    "Peu après avoir dit à Astragalus où se trouvait l'Atelier Sweets, celle-ci me fit partir sans cérémonie..."

# game/script.rpy:898
translate fr ch2_7f4ee160:

    # "She'd long finished putting all those bottles away, after all."
    "Elle avait déjà fini de ranger toutes ces bouteilles, après tout."

# game/script.rpy:899
translate fr ch2_d635dbff:

    # "With money in my pocket, and no more work to be done for the moment... I'm free to begin pursuing my next date~"
    "Argent en poche, et n'ayant plus de travail à faire pour le moment... Je suis libre de partir à la recherche de mon prochain rendez-vous~"

# game/script.rpy:900
translate fr ch2_a4f99886:

    # nvl clear
    # "But wherever shall I go? It's a weekday, too early for parties, too early for drinks..."
    nvl clear
    "Mais où devrais-je aller? C'est la semaine, trop tôt pour la fête, trop tôt pour l'alcool..."

# game/script.rpy:902
translate fr ch2_1e5385aa:

    # "I suppose I could return home and straighten up the place. However..."
    "J'imagine que je pourrais rentrer à la maison et faire un peu de rangement. Cependant... "

# game/script.rpy:903
translate fr ch2_801baa18:

    # nvl clear
    # w calm "(Why would I busy myself with chores when I could be celebrating another order successfully filled?)"
    nvl clear
    w calm "(Pourquoi est-ce que je devrais m'embêter avec des corvées alors que je pourrais célébrer une commande réussie?)"

# game/script.rpy:906
translate fr ch2_7123d8ef:

    # n "Before Periwinkle can decide on where to go, a familiar witch approaches him."
    n "Avant que Periwinkle ne puisse décider où aller, une sorcière familière vient à sa rencontre."

# game/script.rpy:909
translate fr ch2_a7e53e02:

    # c "Periwinkle...?"
    c "Periwinkle...?"

# game/script.rpy:910
translate fr ch2_ed8e4bc5:

    # w happy "Ohh, Cassia! So lovely to see you~"
    w happy "Ohh, Cassia! Quel plaisir de te voir~"

# game/script.rpy:911
translate fr ch2_cca6951a:

    # c happy "Yay, I'm so glad we ran into each other~"
    c happy "Yeah, je suis si contente d'être tombée sur toi~"

# game/script.rpy:913
translate fr ch2_18cfade9:

    # "How to describe Cassia..."
    "Comment décrire Cassia..."

# game/script.rpy:914
translate fr ch2_0c67f0a0:

    # "She's exceedingly cuddly. We met at a party one night, during which she latched onto my arm and never let go. Quite endearing!"
    "Elle est excessivement câline. Nous nous sommes rencontrés à une fête, durant laquelle elle s'est attachée à mon bras et ne l'a jamais quitté. Assez attachante!"

# game/script.rpy:915
translate fr ch2_6535f464:

    # "Since then, we've gone on little dates from time to time..."
    "Depuis ce jour, nous avons eu quelques petits rendez-vous de temps en temps..."

# game/script.rpy:916
translate fr ch2_91a4c39c:

    # "She really loves my magic, so I tend to spoil her whenever we're together 💙"
    "Elle adore vraiment ma magie, alors j'ai tendance à lui faire plaisir dès que nous sommes ensemble 💙"

# game/script.rpy:917
translate fr ch2_fc9d5dc6:

    # nvl clear
    # w smile "Did you need something, dear?"
    nvl clear
    w smile "As-tu besoin de quelque chose, ma chère?"

# game/script.rpy:920
translate fr ch2_7206142c:

    # c aww "Ah, yes! I tried coming over last night, but you didn't seem to be home..."
    c aww "Ah, oui! J'ai essayé de venir chez toi la nuit dernière, mais tu n'avais pas l'air d'être là..."

# game/script.rpy:921
translate fr ch2_693e007a:

    # w shy "Aww, you came to visit me? I'm flattered 💙"
    w shy "Aww, tu es venue me rendre visite? Tu m'en vois flatté 💙"

# game/script.rpy:922
translate fr ch2_399869f1:

    # w smile "I must've been out to dinner at the time... Sorry that I missed you~"
    w smile "Je devais sûrement être en train de dîner à cette heure-ci... Désolé de t'avoir manqué~"

# game/script.rpy:923
translate fr ch2_2f0adf6c:

    # c smile "Oh, it's okay~ I was mostly looking to talk..."
    c smile "Oh, ce n'est pas grave~ Je voulais principalement parler..."

# game/script.rpy:924
translate fr ch2_c9ba5380:

    # c aww "So, um, if you're available right now... do you wanna go to a café?"
    c aww "Alors, hum, si tu es disponible maintenant... voudrais-tu venir prendre un café?"

# game/script.rpy:925
translate fr ch2_d5996b44:

    # w innocent "That sounds perfect! I would love to."
    w innocent "Cela me semble parfait! J'adorerais."

# game/script.rpy:931
translate fr ch2_e516a126:

    # "We take our seats at the nearby café."
    "Nous prenons place dans un café proche."

# game/script.rpy:932
translate fr ch2_07ec8f7d:

    # "It's a pleasant, sunny little place. I've come here often with all sorts of other witches."
    "C'est assez agréable, ce petit endroit ensoleillé. Je suis assez souvent venu ici avec d'autres sorciers."

# game/script.rpy:933
translate fr ch2_798bacd1:

    # "Cassia orders her usual hot chocolate with extra marshmallows, while I decide on a simple rose tea."
    "Cassia commande son habituel chocolat chaud avec des marshmallows, tandis que je décide de prendre un simple thé rose."

# game/script.rpy:934
translate fr ch2_13febc5a:

    # nvl clear
    # c oh "Ooh, Periwinkle, could you make my marshmallows smell like roses, too?"
    nvl clear
    c oh "Ooh, Periwinkle, est-ce que tu pourrais faire en sorte que mes marshmallows sentent la rose, eux aussi?"

# game/script.rpy:937
translate fr ch2_e1d1de4a:

    # w innocent "With pleasure 💙"
    w innocent "Avec plaisir 💙"

# game/script.rpy:938
translate fr ch2_d7d93e12:

    # n "Periwinkle's wand drops from his sleeve, and he gives Cassia's cup a quick little tap."
    n "La baguette de Periwinkle sort de sa manche, et il donne un petit coup sur la tasse de Cassia."

# game/script.rpy:939
translate fr ch2_9343669f:

    # c happy "Eheh, yay~ It really smells just like roses~!"
    c happy "Eheh, ouais~ Ça sent vraiment comme de la rose!"

# game/script.rpy:940
translate fr ch2_790200db:

    # w smile "Just as you asked, dear. It may slightly affect the taste, so let me know if you'd like the spell undone."
    w smile "Exactement comme tu me l'as demandé, ma chère."
    w "Cela pourrait affecter un peu le goût, alors n'hésite pas à me dire si tu veux que j'annule le sort."

# game/script.rpy:942
translate fr ch2_51b79206:

    # n "Cassia dips her spoon in and lifts a marshmallow to her lips, blowing on it lightly before popping it into her mouth."
    n "{size=-2}Cassia plonge sa cuillère à l'intérieur et amène un marshmallow jusqu'à ses lèvres, soufflant doucement dessus avant de le mettre en bouche.{/size}"

# game/script.rpy:943
translate fr ch2_bb00d05f:

    # c happy "Mmf... no, it's wonderful! Ehehe~ 🤎"
    c happy "Mmf... non, c'est merveilleux! Ehehe~ 🤎"

# game/script.rpy:946
translate fr ch2_88501500:

    # "She truly can find the joy in any little moment. Such a delight..."
    "Elle peut vraiment trouver son bonheur dans toute chose. Un véritable délice..."

# game/script.rpy:947
translate fr ch2_28e04d59:

    # "Definitely a contender for the title of absolute cutest witch. Though I would call her... absolutely cute, rather than the absolute cutest."
    "Une concurrente parfaite pour le titre de sorcière la plus mignonne. Bien que je la décrirais comme absolument mignonne, plutôt que la plus mignonne."

# game/script.rpy:948
translate fr ch2_22a82a32:

    # "It takes more than cuteness alone to earn the title of absolute cutest witch! That's where the difference lies, of course."
    "Cela demande bien plus que de la mignonnerie pour obtenir le titre de plus mignonne sorcière! Toute la différence est là-dedans."

# game/script.rpy:949
translate fr ch2_1167b98f:

    # nvl clear
    # "But what am I thinking? How rude it is, to begin ranking my dates in such a way."
    nvl clear
    "À quoi est-ce que je pense? Quel malpoli je fais, à comparer mes rencarts entre eux."

# game/script.rpy:951
translate fr ch2_89364570:

    # "I must be stuck on the thought from my earlier conversation with Astragalus... trying to put Pastille's cuteness into words."
    "Je dois sûrement être bloqué sur ma conversation avec Astragalus... à essayer de mettre des mots sur la mignonnerie de Pastille."

# game/script.rpy:952
translate fr ch2_f14542af:

    # "He really is something special... ah, it's all in the contrast! His polite, well-mannered and proper exterior, concealing such intense desire, begging you to make the first move, and then going ahead and taking it on his own as soon as you--"
    "Il est vraiment spécial... ah, tout est dans le contraste! Son extérieur, si poli et bien élevé, cachant un tel désir, qui te supplie de faire le premier pas, avant de se lancer et de prendre le sien dès que vous--"

# game/script.rpy:953
translate fr ch2_d02f8f43:

    # nvl clear
    # w oops "(...Enough of that! There's someone else in front of me now, isn't there?)" with vpunch
    nvl clear
    w oops "(...Assez! Il y a quelqu'un en face de moi, n'est-ce pas?)" with vpunch

# game/script.rpy:956
translate fr ch2_84a03c6d:

    # n "Cassia continues happily sipping her hot chocolate before speaking up again."
    n "Cassia continue de siroter son chocolat chaud gaiement, avant de prendre la parole à nouveau."

# game/script.rpy:958
translate fr ch2_4958d936:

    # c aw "Ahh, I missed you, Periwinkle~ I've been so busy with packing, I haven't had a chance to see you at all..."
    c aw "Ahh, tu m'as manqué, Periwinkle~ J'étais si occupée avec le déménagement que je n'ai pas eu la moindre occasion de te voir..."

# game/script.rpy:959
translate fr ch2_15a35145:

    # w my "Packing? And just where are you headed off to?"
    w my "Déménagement? Et où comptes-tu aller?"

# game/script.rpy:960
translate fr ch2_959ab161:

    # c oh "Oh, that's right! I never had a chance to tell you~"
    c oh "Oh, c'est vrai! Je n'ai pas eu l'occasion de t'en parler~"

# game/script.rpy:961
translate fr ch2_28a09411:

    # c happy "I'm finally moving in with my partners~! In two more days, the three of us will all be sleeping in the same bed~ 🤎"
    c happy "J'emménage enfin avec mes compagnes! Dans deux jours, nous serons toutes dans le même lit~ 🤎"

# game/script.rpy:962
translate fr ch2_1b9c5f18:

    # w happy "Ooh, that sounds cozy~ Congratulations!"
    w happy "Ooh, ça a l'air plutôt agréable~ Félicitations!"

# game/script.rpy:963
translate fr ch2_937fc8b0:

    # c aww "Ehe, thank you~ 🤎 I've looked forward to it for so long..."
    c aww "Ehe, merci~ 🤎 J'attendais ça depuis si longtemps..."

# game/script.rpy:964
translate fr ch2_aae442de:

    # w smile "It sounds like you're about to enter a lovely domestic life. You deserve it!"
    w smile "Il semblerait que tu vas maintenant avoir une belle vie de couple. Et tu le mérites! "

# game/script.rpy:965
translate fr ch2_f5692979:

    # c "Aww, hehehe... I'm really happy."
    c "Aww, hehehe... Je suis vraiment contente."

# game/script.rpy:966
translate fr ch2_d2fabfa3:

    # c oh "But, um... speaking of my partners. You've still never even met them..."
    c oh "Mais, hum... en parlant de mes compagnes. Tu ne les as jamais rencontrées..."

# game/script.rpy:967
translate fr ch2_f5612c00:

    # w calm "True. But I can imagine they're wonderful, just from how you've talked about them."
    w calm "Il est vrai. Mais j'imagine qu'il s'agit de merveilleuses personnes, vu la façon dont tu m'as parlé d'elles."

# game/script.rpy:968
translate fr ch2_f82c96ac:

    # c aww "Right~ but, um... what if you didn't have to imagine?"
    c aww "C'est vrai~ mais, hum... et si tu n'avais pas besoin de l'imaginer?"

# game/script.rpy:969
translate fr ch2_add80a4e:

    # c smile "That's what I've been wanting to talk to you about. I was hoping... we might all be able to go on a group date sometime!"
    c smile "C'était de ça dont je voulais te parler. J'espérais... que nous pourrions tous aller à un rendez-vous de groupe un de ces jours! "

# game/script.rpy:970
translate fr ch2_c81c387b:

    # w oh "Oh~?"
    w oh "Oh~??"

# game/script.rpy:971
translate fr ch2_8b6f2fb7:

    # c aw "Yeah~! Because, like... I just think you're so wonderful, Periwinkle. I want them to know you, too!"
    c aw "Ouais~! Car... je pense juste que t'es génial, Periwinkle. Alors j'aimerais qu'elles te connaissent aussi!"

# game/script.rpy:972
translate fr ch2_40b31e80:

    # w sorry "Mm... although it sounds like fun, I'm a bit..."
    w sorry "Mm... bien que cela aie l'air amusant, je dirais que je suis un peu..."

# game/script.rpy:973
translate fr ch2_7122e72f:

    # c please "W-wait, before you say no...!"
    c please "A-attends, avant de dire non...!"

# game/script.rpy:974
translate fr ch2_b6456ff5:

    # c "They're both very easygoing, and so loving, and nice...! I can promise it won't be overwhelming..."
    c "Elles sont vraiment agréables à vivre, et si affectueuses, et si gentilles...! Je te promets que ce ne sera pas du tout oppressant..."

# game/script.rpy:975
translate fr ch2_62b54e38:

    # w decline "That unfortunately isn't where the issue lies, my dear..."
    w decline "Le problème ne se trouve malheureusement pas là, ma chère..."

# game/script.rpy:976
translate fr ch2_bb65f581:

    # c sad "I-I know you said you didn't want to get involved before... but I just know that we would all get along so well!"
    c sad "J-Je sais que tu avais dit que tu ne voulais plus t'engager auparavant... mais je sais que nous irions si bien tous ensemble!  "

# game/script.rpy:977
translate fr ch2_9db7f2b9:

    # c "I'd like to reassure you however I can. But I understand if you still turn me down..."
    c "J'aimerais pouvoir te rassurer autant que possible. Mais je comprendrais si tu refuses quand même..."

# game/script.rpy:979
translate fr ch2_99af5b21:

    # "Matters of love are so tricky, aren't they?"
    "Les histoires d'amour sont compliquées, pas vrai?"

# game/script.rpy:980
translate fr ch2_b7229a67:

    # "I still recall the first time something like this was asked of me..."
    "Je me souviens encore de la première fois qu'on m'a demandé quelque chose comme ça..."

# game/script.rpy:981
translate fr ch2_70f4d8cb:

    nvl clear
    # "I had been nervous going in, but I had also never entered a group situation before. I attributed my anxiety solely to that."
    "J'étais très nerveux à l'idée d'y aller, mais je n'avais jamais eu de situation de groupe auparavant. J'ai donc attribué mon anxiété à cela. "

# game/script.rpy:982
translate fr ch2_5aaf6eab:

    # "However, it quickly became clear that I just wasn't suited to it at all..."
    "Cependant, il était très vite devenu évident que je n'étais pas fait pour ce genre de choses..."

# game/script.rpy:983
translate fr ch2_92e49d6c:

    # nvl clear
    # "I do love to spoil each of my partners--but strictly one at a time."
    "J'apprécie le fait de satisfaire chacun de mes partenaires--mais seulement un à la fois."
    nvl clear

# game/script.rpy:985
translate fr ch2_13099713:

    # "Perhaps I was left scarred by the breakdown in communication, the passionate fires of a long-established romance..."
    "Peut-être que j'ai été blessé par le manque de communication, le feu passionné d'une romance établit depuis longtemps déjà..."

# game/script.rpy:986
translate fr ch2_000f6a86:

    # "Surely Cassia and her partners are magnificent people. It may indeed be fun for a night."
    "Je suis sûr que Cassia et ses compagnes sont géniales. Et l'idée serait sûrement amusante pour une nuit."

# game/script.rpy:987
translate fr ch2_e1d8cf3a:

    # "But becoming entangled in committed relationships is something I've always avoided from the beginning, isn't it?"
    "Mais s'enfermer dans une relation sérieuse est quelque chose que j'ai toujours évité depuis le début, n'est-ce pas?"

# game/script.rpy:988
translate fr ch2_b61e07ce:

    # nvl clear
    # w neutral "This is all very sweet of you. But I do have to decline."
    nvl clear
    w neutral "C'est vraiment très gentil de ta part. Mais je me dois de refuser."

# game/script.rpy:991
translate fr ch2_d6eb3267:

    # c letdown "Aww... I can't help but feel a little broken-hearted."
    c letdown "Aww... J'imagine que je n'y peux rien, mais je me sens tout de même un peu navrée."

# game/script.rpy:992
translate fr ch2_02d40560:

    # w decline "I apologize... Truly, it's nothing personal."
    w decline "Je suis désolé... Ce n'est pas de ta faute, crois-moi."

# game/script.rpy:993
translate fr ch2_cea46204:

    # c aww "Oh, I know~ I don't take offense or anything..."
    c aww "Oh, je sais~ Je ne me sens pas vexée ou quoi que ce soit du genre..."

# game/script.rpy:994
translate fr ch2_13fca6f4:

    # c letdown "It's just sad. Now that I'm going to be living with them... and, knowing you don't want to meet them..."
    c letdown "C'est juste assez triste. Maintenant que je vais vivre avec elles... tout en sachant que tu ne veux pas les rencontrer..."

# game/script.rpy:995
translate fr ch2_82188b3a:

    # c sad "I think it's best we just break things off...."
    c sad "Je pense que ce serait sûrement mieux si on arrêtait là...."

# game/script.rpy:996
translate fr ch2_9b7a5305:

    # w neutral "Yes, I agree. As you said, it's for the best."
    w neutral "Il est vrai. Comme tu l'as dis toi-même, c'est sûrement ce qu'il y a de mieux."

# game/script.rpy:997
translate fr ch2_22bfa56a:

    # c aww "I hope we can still be friends, though~"
    c aww "Mais j'espère qu'on pourra toujours rester amis~"

# game/script.rpy:998
translate fr ch2_a119e9ad:

    # w smile "Of course~ 💙 I'm sure our paths will cross every now and again."
    w smile "Bien sûr 💙 Je suis sûr que nos chemins se croiseront à l'avenir. "

# game/script.rpy:999
translate fr ch2_96818197:

    # c happy "Yeah~! Thank you for always treating me so well, Periwinkle."
    c happy "Ouais~! Merci de toujours m'avoir si bien traitée, Periwinkle."

# game/script.rpy:1000
translate fr ch2_f9c0bf81:

    # w calm "Hmhm, it was my pleasure 💙"
    w calm "Hmhm, c'était un plaisir 💙"

# game/script.rpy:1003
translate fr ch2_482c7dd0:

    # "Even casual relationships can end in breakups like this."
    "Même des relations occasionnelles peuvent finir par des ruptures de ce genre."

# game/script.rpy:1004
translate fr ch2_7fabf76c:

    # "This is largely why I tend to prefer one-night affairs. Things can just become so messy as needs evolve..."
    "C'est la principale raison pour laquelle je préfère les coups d'un soir. Tout devient si compliqué, avec l'augmentation des besoins de chacun..."
    nvl clear
# game/script.rpy:1005
translate fr ch2_e8be9790:

    # "As Cassia and I go our separate ways, I can't help feeling a little blue."
    "Alors que Cassia et moi nous séparions, je ne puis m'empêcher de me sentir un peu attristé."

# game/script.rpy:1006
translate fr ch2_7b0bc9f1:

    # "Perhaps I'll return home for the day after all."
    "Peut-être que je vais finalement rentrer à la maison."

# game/script.rpy:1007
translate fr ch2_76b2fe88_2:

    # nvl clear
    nvl clear

# game/script.rpy:1018
translate fr ch2_80d3118f:

    # n "Periwinkle quickly changes into something more comfortable, dropping his bag unceremoniously onto the couch."
    n "Periwinkle enfile rapidement quelque chose de plus confortable, balançant son sac sur le canapé."

# game/script.rpy:1019
translate fr ch2_a9ff1a56:

    # w pj neutral "(I could use an afternoon nap...)"
    w pj neutral "(Je ferais bien une petite sieste...)"

# game/script.rpy:1020
translate fr ch2_10be0962:

    # w calm "(Yes, that's precisely what I need. I'll wake up feeling refreshed, and ready to go back out on the town~)"
    w calm "(C'est exactement ce dont j'ai besoin. Je me réveillerai en pleine forme, prêt pour aller en ville~)"

# game/script.rpy:1022
translate fr ch2_47c6e3ec:

    # n "He shoves some blankets aside and collapses onto the couch--and when he does, the contents of his bag spills onto the floor."
    n "Il prend quelques couvertures et s'affale sur le canapé--ce qui fait tomber le contenu de son sac au sol."

# game/script.rpy:1023
translate fr ch2_093623ac:

    # w oh "Ah..."
    w oh "Ah..."

# game/script.rpy:1024
translate fr ch2_189b671a:

    # n "Lazily leaning over to gather it up, he notices the candies from before..."
    n "Se penchant paresseusement pour les récupérer, il remarque les bonbons de la dernière fois... "

# game/script.rpy:1025
translate fr ch2_cba66395:

    # w neutral "...."
    w neutral "...."

# game/script.rpy:1030
translate fr ch2_ed23994c:

    # "Was I too hasty in saying I'd hoped to see Pastille again?"
    "Étais-je trop pressé, à dire que je voulais déjà revoir Pastille? "

# game/script.rpy:1031
translate fr ch2_cad66722:

    # "I suppose I'd forgotten the feeling of not being enough for someone."
    "J'imagine que j'avais oublié le sentiment de ne pas suffire à quelqu'un."

# game/script.rpy:1032
translate fr ch2_fc6603e2:

    # "Usually these things tend to dissipate naturally, without confrontation or notice."
    "Ce genre de choses finissent habituellement par disparaître, sans le moindre problème."

# game/script.rpy:1033
translate fr ch2_e7803a00:

    # "So when they don't... it stings."
    "Mais quand ce n'est pas le cas... ça pique."

# game/script.rpy:1034
translate fr ch2_fc4b9a1c:

    # nvl clear
    # n "Periwinkle scoops up the candies, dropping all but one of them back into his bag."
    nvl clear
    n "Periwinkle ramasse les bonbons et les range dans son sac, n'en gardant qu'un seul."

# game/script.rpy:1037
translate fr ch2_f16117de:

    # n "He settles into place on the couch, nestled in a tangled mess of blankets and cushions... and unwraps his chosen pastille."
    n "Il se met en place sur le canapé, au milieu de couvertures et de coussins... et déballe sa pastille."

# game/script.rpy:1040
translate fr ch2_2fa75bdb:

    # w pj calm "(...It IS sweet, though.)"
    w pj calm "(... C'est VRAIMENT sucré.)"

# game/script.rpy:1041
translate fr ch2_81ec8a05:

    # w shy "(What a shame that would be, if I never got to taste it again!)"
    w shy "(Quelle perte cela serait, de ne pas pouvoir en goûter de nouveau!)"

# game/script.rpy:1044
translate fr ch2_b429b989:

    # "That's right. I could never resist the promise of an entertaining night, no matter what may come down the line."
    "C'est ça. Je ne pourrais jamais résister à la promesse d'une nuit passionnée, peu importe ce qui arriverait."

# game/script.rpy:1045
translate fr ch2_13b346ec:

    # "I'm a hopeless hedonist after all 💙 Nothing to be done about that!"
    "Je suis un éternel hédoniste, après tout 💙 Je n'y peux rien!"

# game/script.rpy:1046
translate fr ch2_b6d8bcd7:

    # "Let fate decide, then. If he comes, he comes."
    "Voyons ce que le destin me réserve. S'il vient."

# game/script.rpy:1047
translate fr ch2_191d1d9c:

    # "And if we never meet again... I can always hold on to the memory of our perfect date 💙"
    "Et si nous ne nous voyons plus jamais... Je pourrais toujours m'accrocher au souvenir de notre magnifique rendez-vous 💙"

# game/script.rpy:1048
translate fr ch2_76b2fe88_3:

    # nvl clear
    nvl clear

# game/script.rpy:1053
translate fr ch2_1a34cacc:

    # n "Several hours later..."
    n "Plusieurs heures plus tard..."

# game/script.rpy:1054
translate fr ch2_3688e7d8:

    # n "...there's a knock at the door."
    n "...quelqu'un frappe à la porte."

# game/script.rpy:1060
translate fr ch2_f9db6787:

    # n "And right there on his doorstep, Periwinkle is pleasantly surprised to find..."
    n "Periwinkle est agréablement surpris de voir attendre sur son palier..."

# game/script.rpy:1062
translate fr ch2_40e54497:

    # w pj my "Pastille! I wasn't expecting to see you again so soon~"
    w pj my "Pastille! Je ne m'attendais pas à te revoir de si tôt~"

# game/script.rpy:1063
translate fr ch2_b15c4708:

    # w drool "(And treating me to another cute new look, no less! 💙)"
    w drool "(Et encore moins avec une tenue encore plus mignonne! 💙)"

# game/script.rpy:1064
translate fr ch2_99245a8a:

    # p "Sorry, I, um... I couldn't stop thinking about..."
    p "Désolé, je, hum... je ne pouvais pas m'empêcher de penser à..."

# game/script.rpy:1065
translate fr ch2_42189d4b:

    # p ehe2 "I-I mean--I realized, last night I never actually... got to sample your magic? The scents you mentioned..."
    p ehe2 "{size=-2}J-Je veux dire-- Je me suis rendu compte que, la nuit dernière, je n'avais jamais... eu un échantillon de ta magie? Les senteurs dont tu m'avais parlé...{/size}"

# game/script.rpy:1066
translate fr ch2_e2870f5e:

    # w oh "Oh, that's right..."
    w oh "Oh, il est vrai..."

# game/script.rpy:1067
translate fr ch2_974aa600:

    # w love "We were quite preoccupied, hm? 💙"
    w love "Nous étions assez occupés, pas vrai? 💙"

# game/script.rpy:1068
translate fr ch2_bddfdf51:

    # p seriously "Y-yes... so, th-that's why I'm here!"
    p seriously "O-oui... et donc, c-c'est pour ça que je suis venu!"

# game/script.rpy:1069
translate fr ch2_688d44a5:

    # n "He finally manages to make eye contact, but quickly averts his gaze once more."
    n "Il réussit finalement à regarder Periwinkle dans les yeux, mais détourne son regard de nouveau."

# game/script.rpy:1070
translate fr ch2_6ad797b9:

    # p shy "Ah--um, were you in bed? Sorry, I shouldn't have come so late...."
    p shy "Ah--hum, est-ce que tu étais en train de dormir? Désolé, je n'aurais pas dû venir si tard...."

# game/script.rpy:1071
translate fr ch2_e453f11a:

    # w calm "Hmhm, these aren't even my sexiest pajamas..."
    w calm "Hmhm, ce ne sont même pas mes pyjamas les plus séduisants..."

# game/script.rpy:1072
translate fr ch2_c0c9e69d:

    # p omg "I didn't say anything about that...!" with vpunch
    p omg "Je n'ai rien dit à ce sujet...!" with vpunch

# game/script.rpy:1073
translate fr ch2_ac06f781:

    # w innocent "But to answer your question, no, I wasn't."
    w innocent "Mais pour répondre à ta question, non, je ne dormais pas."

# game/script.rpy:1074
translate fr ch2_1837215c:

    # w smile "Although I did take a nap earlier this afternoon, I've otherwise been enjoying a relaxing night in."
    w smile "Bien que j'ai fait la sieste cet après-midi, j'étais en train d'apprécier une nuit de calme."

# game/script.rpy:1075
translate fr ch2_7eec0fd7:

    # w drool "(And I'm so very glad I didn't end up going out! I would've missed out on this flustered mess 💙)"
    w drool "(Et je suis si content de ne pas être sorti! J'aurais manqué cette boule d'embarras 💙)"

# game/script.rpy:1076
translate fr ch2_dfa9333a:

    # p ehe2 "Ah... haha...."
    p ehe2 "Ah... haha...."

# game/script.rpy:1077
translate fr ch2_47eb90b7:

    # w innocent "...Would you like to come in?"
    w innocent "...Aimerais-tu venir à l'intérieur?"

# game/script.rpy:1079
translate fr ch2_18ec9e87:

    # n "Pastille nods vigorously in response."
    n "Pastille hoche la tête en réponse.."

# game/script.rpy:1085
translate fr ch2_ee963e3c:

    # w pj calm "It's still a bit of a mess in here... I hope you don't mind~"
    w pj calm "Il y a toujours un peu de désordre... J'espère que cela ne te dérange pas~ "

# game/script.rpy:1086
translate fr ch2_cd5e4835:

    # p oh "There's a path through. I've seen worse."
    p oh "On peut encore marcher droit. J'ai déjà vu pire."

# game/script.rpy:1087
translate fr ch2_6f4d78ac:

    # w happy "Oh~ maybe I'll let it spiral further into chaos, then! I'm just so competitive, you know? 💙"
    w happy "Oh~ peut-être que je vais laisser le chaos prendre le contrôle, dans ce cas! Je suis si compétitif, tu sais? 💙"

# game/script.rpy:1088
translate fr ch2_63398835:

    # p ehe "I'm not sure that's a competition you'd really want to win..."
    p ehe "Je ne suis pas sûr qu'il s'agisse d'une compétition que tu voudrais vraiment gagner..."

# game/script.rpy:1089
translate fr ch2_8189bccf:

    # w calm "Hmhm, perhaps not."
    w calm "Hmhm, peut-être que non."

# game/script.rpy:1091
translate fr ch2_165173b4:

    # n "Periwinkle carefully steps over some of his clutter to dig through one of the boxes in the far corner of the room."
    n "Periwinkle enjambe quelques vêtements avant de fouiller une des boîtes dans le coin de la pièce."

# game/script.rpy:1093
translate fr ch2_843f2cc2:

    # w pj smile "Ah, here they are! My personal favorites..."
    w pj smile "Ah, les voici! Mes préférés..."

# game/script.rpy:1096
translate fr ch2_2a6d3b75:

    # w calm "This row here contains some of the more potent scents... most of them for relaxation, things to calm the nerves."
    w calm "Cette rangée contient mes plus fortes senteurs... la plupart servent à la relaxation, à calmer l'esprit."

# game/script.rpy:1097
translate fr ch2_861a81ad:

    # w smile "The rest, I just happen to like. Sweet scents, like strawberry, banana, bubblegum, mango..."
    w smile "Le reste est juste composé de ce que j'aime. Des odeurs douces, comme de la fraise, de la banane, du chewing-gum, de la mangue..."

# game/script.rpy:1098
translate fr ch2_25b75e0f:

    # p "I-is there a reason you're only naming candy flavors...?"
    p "Es-Est-ce que tu fais exprès de ne mentionner que des goûts de bonbons...?"

# game/script.rpy:1099
translate fr ch2_0d95e3c3:

    # w innocent "Hm~ must be a coincidence 💙"
    w innocent "Hm~ sûrement une coincidence 💙"

# game/script.rpy:1101
translate fr ch2_432e8e66:

    # n "Pastille picks out an unlabeled bottle, filled with a pale pink liquid..."
    n "Pastille attrape une bouteille sans indication, remplit d'un liquide rose..."

# game/script.rpy:1104
translate fr ch2_b279bf05:

    # p "What's this?"
    p "Qu'est-ce que c'est?"

# game/script.rpy:1105
translate fr ch2_51cf5f4c:

    # w teehee "Ahh, watch out~ that one's an aphrodisiac 💙"
    w teehee "Ahh, attention~ c'est un aphrodisiaque 💙"

# game/script.rpy:1106
translate fr ch2_93475faa:

    # p calm "Hm. We'll see about that."
    p calm "Hm. C'est ce qu'on va voir."

# game/script.rpy:1108
translate fr ch2_e9e24a9f:

    # n "Pastille locks eyes with Periwinkle as he opens the vial without hesitation."
    n "Pastille et Periwinkle fixent la bouteille tandis que Pastille l'ouvre sans la moindre hésitation."

# game/script.rpy:1109
translate fr ch2_2fb76492:

    # w drool "(How bold...!)"
    w drool "(Quelle audace...!)"

# game/script.rpy:1111
translate fr ch2_0042c176:

    # p ehe "...Oh, it's peach. Hah, I almost expected it to be overpowering..."
    p ehe "...Oh, c'est à la pêche. Hah, je m'attendais presque à quelque chose de fort..."

# game/script.rpy:1112
translate fr ch2_3da16e70:

    # w calm "Yes, well, the aphrodisiac bit was a lie. But I'm glad you like it."
    w calm "Oui, et puis, la partie aphrodisiaque était fausse. Mais je suis heureux de voir que tu l'apprécies."

# game/script.rpy:1113
translate fr ch2_84afb1db:

    # p smile "You're really good at this type of magic--I've never done anything like it..."
    p smile "Tu es vraiment doué avec ce type de magie--Je n'ai jamais fait quoi que ce soit de similaire..."

# game/script.rpy:1114
translate fr ch2_eac4cdca:

    # w smile "Would you like to try it on?"
    w smile "Est-ce que tu souhaiterais essayer?"

# game/script.rpy:1115
translate fr ch2_fa96959b:

    # p oh "Hm...?"
    p oh "Hm...?"

# game/script.rpy:1116
translate fr ch2_83bb61ec:

    # p shy "Oh, n-no, I don't do perfume or cologne or anything like that..."
    p shy "Oh, n-non, je ne mets pas de parfum ou d'eau de cologne, ou quoi que ce soit d'autre..."

# game/script.rpy:1117
translate fr ch2_7df5f505:

    # w oh "You've never tried it? Ohh, so would you say..."
    w oh "Tu n'as jamais essayé? Ohh, alors est-ce qu'on peut dire..."

# game/script.rpy:1118
translate fr ch2_cc464b9d:

    # w shy "You're a perfume virgin, then? 💙"
    w shy "Que tu es vierge de tout parfum? 💙"

# game/script.rpy:1119
translate fr ch2_3db42423:

    # p seriously "I-I'M NOT...! Who even says things like that?!" with vpunch
    p seriously "J-JE NE SUIS PAS...! Qui dit des trucs comme ça?!" with vpunch

# game/script.rpy:1120
translate fr ch2_2cfe21e1:

    # w happy "In my line of work, you'd be surprised~"
    w happy "C'est très utilisé dans mon travail~"

# game/script.rpy:1121
translate fr ch2_ba67bd24:

    # p shy "It's probably just you...."
    p shy "Tu es probablement le seul à le faire..."

# game/script.rpy:1122
translate fr ch2_27256bce:

    # w innocent "Hmhm, maybe so."
    w innocent "Hmhm, peut-être."

# game/script.rpy:1123
translate fr ch2_adc8879b:

    # w calm "If you're not going to try it, I'll have it back now, please~"
    w calm "Si tu ne vas pas l'essayer, je vais devoir le récupérer, s'il te plaît~"

# game/script.rpy:1124
translate fr ch2_0d918745:

    # p anxious "I could.. try...."
    p anxious "Je pourrais... essayer...."

# game/script.rpy:1125
translate fr ch2_66c51016:

    # p ehe2 "I just don't know how I'm supposed to apply it."
    p ehe2 "Je ne sais juste pas comment je suis censé en mettre."

# game/script.rpy:1126
translate fr ch2_a2e4ac6c:

    # w smile "May I?"
    w smile "Puis-je?"

# game/script.rpy:1129
translate fr ch2_b631c2d3:

    # n "Pastille nods, handing over the small vial."
    n "Pastille acquiesce, lui passant la petite fiole."

# game/script.rpy:1130
translate fr ch2_6b5afd7c:

    # n "Periwinkle seals the opening with his fingertip and swiftly tilts the bottle over and back."
    n "Periwinkle bouche l'entrée du bout du doigt et secoue la bouteille doucement."

# game/script.rpy:1133
translate fr ch2_9dd67e5b:

    # w "Here..."
    w "Et voici..."

# game/script.rpy:1134
translate fr ch2_f2f42b7a:

    # n "He lightly rubs a spot on Pastille's neck, engulfing them both in the pleasant scent of his magic."
    n "Il frotte légèrement la nuque de Pastille, les entourant d'une agréable odeur magique."

# game/script.rpy:1136
translate fr ch2_56fbbf51:

    # n "Their eyes meet, neither of them daring to be the first to move."
    n "Leurs yeux se rencontrent, aucun des deux n'osant faire le premier pas."

# game/script.rpy:1137
translate fr ch2_054c8a20:

    # w "Hmm... maybe the aphrodisiac bit wasn't a lie after all?"
    w "Hmm... peut-être que la partie aphrodisiaque était vrai, après tout?"

# game/script.rpy:1139
translate fr ch2_f010b7c9:

    # n "Pastille breaks the spell, rushing forward with a sudden kiss."
    n "Pastille brise le sort en se précipitant avec un baiser soudain."

# game/script.rpy:1141
translate fr ch2_90f6a8aa:

    # n "...And then retreats just as quickly."
    n "...avant de se retirer tout aussi vite."

# game/script.rpy:1144
translate fr ch2_e247d436:

    # p "Ah--um, sorry, I just--"
    p "Ah--hum, désolé, c'est juste--"

# game/script.rpy:1145
translate fr ch2_99717d55:

    # w pj yay "(He certainly is impulsive... not that I mind at all 💙)"
    w pj yay "(Eh bien! Toujours aussi impulsif... bien que cela ne me dérange pas le moins du monde 💙)"

# game/script.rpy:1146
translate fr ch2_655f5b82:

    # w drool "(I'm more than happy to go along with your little game, Pastille...)"
    w drool "(Suivre ton petit jeu ne ferait que me rendre encore plus heureux, Pastille...)"

# game/script.rpy:1147
translate fr ch2_50096bca:

    # w shy "Ohh nooo~ my own magic is working too well~!"
    w shy "Oh noooon~ ma propre magie semble être un peu trop efficace!~"

# game/script.rpy:1148
translate fr ch2_0bd2374d:

    # w teehee "I guess there's no choice but to have my way with you, my sweet 💙"
    w teehee "J'imagine que je n'ai d'autre choix que de te satisfaire, mon sucre d'orge 💙"

# game/script.rpy:1149
translate fr ch2_60a65ab5:

    # p dying "...O-oh nooo~"
    p dying "...O-oh noooon~"

# game/script.rpy:1153
translate fr ch2_de805c4f:

    # n "Pastille's halfhearted protests end there."
    n "La protestation timide de Pastille s'arrête ici."

# game/script.rpy:1154
translate fr ch2_016f8419:

    # n "Periwinkle's hands were already upon him, and would continue to be for the rest of the night..."
    n "Les mains de Periwinkle sont déjà sur lui, et continueront à l'être pour le restant de la nuit..."

# game/script.rpy:1166
translate fr ch3_7b49a2da:

    # centered "{w=3}{nw}"
    centered "{w=3}{nw}"

# game/script.rpy:1173
translate fr ch3_7ed57a35:

    # "Over the next month or so, we fell into quite an enjoyable pattern."
    "Pendant à peu près un mois, nous avons adopté un cycle assez plaisant."

# game/script.rpy:1174
translate fr ch3_4fb4a5d6:

    # "Pastille would show up at my doorstep maybe once or twice a week..."
    "Pastille vient à ma porte environ une ou deux fois par semaine..."

# game/script.rpy:1175
translate fr ch3_89332bf5:

    # "Sometimes we'd go out to dinner, but mostly he'd just spend the night 💙"
    "Nous allons quelque fois dîner, mais il vient majoritairement passer la nuit ici 💙"

# game/script.rpy:1176
translate fr ch3_ea2c2997:

    # nvl clear
    # "It was starting to become almost routine--though each visit was somehow just as exciting as the last~"
    nvl clear
    "Cela commençait presque à devenir notre routine-- bien que chaque visite était étrangement tout aussi excitante que la précédente~"

# game/script.rpy:1178
translate fr ch3_e1acc37c:

    # "The details of which... I'll choose to keep private, for Pastille's sake. That boy is insatiable, I WILL say that! 💙"
    "Dont les détails... sont un secret, pour le bien de Pastille. Je ne dirai qu'une chose, ce garçon est VRAIMENT insatiable! 💙"

# game/script.rpy:1179
translate fr ch3_2ae57261:

    # nvl clear
    # "Inevitably, after seeing someone for long enough, one begins to pick up on their habits..."
    nvl clear
    "Et lorsque que l'on passe autant de temps avec quelqu'un, on commence inévitablement à remarquer ses habitudes..."

# game/script.rpy:1181
translate fr ch3_308c6522:

    # "Cute habits. Like the way he kisses me on the cheek before rushing off to work in the early morning."
    "D'adorables habitudes. Comme celle de toujours m'embrasser sur la joue avant d'aller au travail, tôt le matin."

# game/script.rpy:1182
translate fr ch3_f8c37e9b:

    # "The way he runs his hand through his hair when he's thinking really hard about something."
    "La façon qu'il a de passer sa main dans ses cheveux lorsqu'il est en train de réfléchir à quelque chose."

# game/script.rpy:1183
translate fr ch3_7f9de784:

    # nvl clear
    # "Even his knock is specific--once, lightly, to test the waters. A pause, as he gathers his courage. Then three, firm and evenly-spaced."
    nvl clear
    "Même sa façon de frapper à la porte est spéciale--un coup, doucement, juste pour voir. Une pause, le temps de réunir son courage. Puis trois autres, fermes et également espacés."

# game/script.rpy:1185
translate fr ch3_13949e8f:

    # "I'm not sure which of these habits he's conscious of, but there's one I've decided he MUST be acting knowingly..."
    "Je ne suis pas sûr qu'il ait conscience de ces habitudes, mais il y en a une qui doit FORCÉMENT être volontaire..."

# game/script.rpy:1186
translate fr ch3_05e82852:

    # "Which is, his habit of leaving one of his personal effects behind with each visit."
    "Qui est de laisser un de ses effets personels derrière lui à chaque visite."

# game/script.rpy:1187
translate fr ch3_a1186f11:

    # nvl clear
    # "First, a barrette. Then an earring. His choker, a bracelet..."
    nvl clear
    "Une barrette, pour commencer. Puis une boucle d'oreille. Son collier, un bracelet..."

# game/script.rpy:1189
translate fr ch3_72eea756:

    # "And then he returns after a few days with an apology, explaining he had just come to pick up whatever he'd left behind."
    "Puis il revient quelques jours plus tard avec une excuse, expliquant qu'il venait juste récupérer ce qu'il avait oublié."

# game/script.rpy:1190
translate fr ch3_13faa860:

    # nvl clear
    # w pj calm "Sure, Pastille. Keep creating your little excuses to come back here... I'll happily go along with them."
    nvl clear
    w pj calm "Bien sûr, Pastille. Continue de te créer tes petites excuses pour revenir ici... Je les accepte volontiers."

# game/script.rpy:1193
translate fr ch3_80258f58:

    # w happy "Hmhm, what fun! I wonder what he'll come looking for THIS time~?"
    w happy "Hmhm, c'est si amusant! Qu'est-ce qu'il va venir chercher, cette fois-ci~?"

# game/script.rpy:1195
translate fr ch3_5245ed5c:

    # n "Periwinkle gathers up the discarded garments that had been left strewn across his bedroom, tossing them into a pile to be dealt with later."
    n "Periwinkle rassemble les vêtements éparpillés dans sa chambre, avant de les balancer dans une pile en attendant de s'en occuper."

# game/script.rpy:1197
translate fr ch3_57dc11fb:

    # w oh "He couldn't possibly leave his underwear behind, could he...?"
    w oh "Il n'aurait quand même pas laisser son caleçon derrière lui...?"

# game/script.rpy:1198
translate fr ch3_2577a914:

    # w calm "No, that would be impossible to explain. An earring, sure, but there's no way he'd walk out of here like THAT..."
    w calm "Non, ce serait impossible à expliquer. Une boucle d'oreille, pourquoi pas, mais il ne sortirait quand même pas comme ÇA..."

# game/script.rpy:1200
translate fr ch3_b4f5ffdc:

    # n "Periwinkle hums to himself as he makes the bed, double-checking between the sheets while he's at it..."
    n "Periwinkle fredonne tout seul en atteignant le lit, revérifiant entre les draps au passage... "

# game/script.rpy:1202
translate fr ch3_a6272f66:

    # w pout "...Hm. I'm almost disappointed."
    w pout "...Hm. Je suis presque déçu."

# game/script.rpy:1203
translate fr ch3_8b7cde78:

    # w oh "It's been so consistent, up until now. I suppose he could just be THAT forgetful..."
    w oh "C'était si régulier, jusque là. J'imagine qu'il est sûrement TRÈS étourdi..."

# game/script.rpy:1206
translate fr ch3_fcb994ab:

    # "Unable to find anything of Pastille's in my bedroom, I decide to spend the rest of the morning cleaning up the place."
    "Incapable de trouver quelque chose appartenant à Pastille dans ma chambre, je décide de passer le reste de la journée à faire du rangement."

# game/script.rpy:1207
translate fr ch3_c3a58deb:

    # "Now, mind you, I never let my house get DIRTY... only messy."
    "Mais attention, je ne laisserais jamais ma maison SALE... seulement désordonnée."

# game/script.rpy:1208
translate fr ch3_03008cfa:

    # "Leaving garbage or food waste about is out of the question."
    "Laisser des déchets ou des restes est absolument hors de question."

# game/script.rpy:1209
translate fr ch3_a4f20100:

    # "Everything else, though..."
    "Mais pour ce qui est du reste..."

# game/script.rpy:1210
translate fr ch3_1b81cc77:

    # nvl clear
    # "It's simply that many things don't make it back to their proper place. Or rather, I can never decide on a proper place for many of my things..."
    nvl clear
    "C'est juste que beaucoup de choses ne retournent pas à leur place. Ou plutôt, je n'ai jamais pu décider d'une place définitive pour mes affaires..."

# game/script.rpy:1212
translate fr ch3_e63b1b71:

    # "Toss them into boxes, shuffle the boxes around the room, and suddenly they've become unmanageable piles..."
    "Je les mets dans des boîtes, disperse celles-ci dans la pièce, et elles deviennent alors des piles ingérables..."

# game/script.rpy:1213
translate fr ch3_fc7696d4:

    # "To truly put everything away, these would all have to be emptied and sorted... a daunting task, to be sure!"
    "Pour tout ranger correctement, il faudrait vider et classer chaque chose... une tâche des plus ardues, bien évidemment!"

# game/script.rpy:1214
translate fr ch3_88c3865d:

    # nvl clear
    # "But it HAS been a while since my last attempt. I may as well put in some effort..."
    nvl clear
    "Mais il est vrai que cela fait UN MOMENT depuis ma dernière tentative. Je devrais peut-être y mettre un peu plus d'efforts..."

# game/script.rpy:1216
translate fr ch3_c56eb4b7:

    # nvl clear
    # w pj oops "But where to begin...?"
    nvl clear
    w pj oops "Mais par où commencer...?"

# game/script.rpy:1219
translate fr ch3_c9432365:

    # w oh "I suppose my work supplies have been a little difficult to navigate as of late."
    w oh "J'imagine que mes échantillons sont devenus un peu plus dur à retrouver ces derniers temps. "

# game/script.rpy:1220
translate fr ch3_6288f7b0:

    # w innocent "That's an achievable goal now, isn't it? And practical, as well!"
    w innocent "C'est un objectif accessible, n'est-ce pas? Et utile, par la même occasion!"

# game/script.rpy:1222
translate fr ch3_bd454459:

    # n "Periwinkle begins with the box of his favorite perfumes, that had been sitting out since one of Pastille's first visits."
    n "Periwinkle commence par la boîte avec ses parfums favoris, qui n'a pas bougé depuis l'une des premières visites de Pastille."

# game/script.rpy:1223
translate fr ch3_de62bb1c:

    # w drool "Ahh, yes... the \"aphrodisiac\"... hmhm, that was a fun night 💙"
    w drool "Ahh, oui...  le fameux \"aphrodisiaque\"... hmhm, c'était une bonne nuit 💙"

# game/script.rpy:1224
translate fr ch3_44f1f072:

    # n "He packs the bottles back into their places, then closes the box, sealing them safely inside."
    n "Il range chaque bouteille à leur place avant de fermer la boîte, pour les garder à l'abris."

# game/script.rpy:1226
translate fr ch3_eaaa499e:

    # w oh "This should go... hm, perhaps it'd be better to set it high on the bookshelf?"
    w oh "Cela devrait aller... hm, peut-être que ce serait mieux si je le mettais en haut de l'étagère?"

# game/script.rpy:1227
translate fr ch3_316ce3eb:

    # w calm "If I just rearrange things a bit, there should be room for everything...."
    w calm "Si je réarrange une ou deux choses, il devrait y avoir assez de place...."

# game/script.rpy:1229
translate fr ch3_7430db52:

    # n "As Periwinkle begins setting things aside, a new pile is born, precariously teetering on the back of the couch."
    n "Tandis que Periwinkle commence à mettre des choses de côté, une nouvelle pile précaire était née, vascillant contre le dos du canapé."

# game/script.rpy:1230
translate fr ch3_5cf41d37:

    # n "He places the box just where he wants it, and then stacks his various books and knickknacks around it."
    n "Il place une boîte là où il le souhaitait, puis empile de nombreux livres et babioles tout autour."

# game/script.rpy:1231
translate fr ch3_fcaff70c:

    # n "Just as he's made his way through half of the pile, a small portion of it topples forward, bouncing safely onto the couch cushions."
    n "{size=-4}Au moment où il atteignait la moitié de la pile, une partie de celle-ci tombe en avant, rebondissant sur des coussins posés sur le canapé.{/size}"

# game/script.rpy:1232
translate fr ch3_37943611:

    # w smile "Ha! Topple all you want. I was prepared..."
    w smile "Ha! Tu peux tomber autant que tu veux. J'avais tout prévu..."

# game/script.rpy:1233
translate fr ch3_6bb6158a:

    # w oh "...Hm?"
    w oh "...Hm?"

# game/script.rpy:1236
translate fr ch3_04349ffb:

    # n "He finally notices Pastille's jacket, which had expertly blended into the blankets and cushions around it."
    n "Il remarque enfin la veste de Pastille, qui était parfaitement cachée au milieu des couvertures et des coussins la recouvrant. "

# game/script.rpy:1237
translate fr ch3_b6d5bbbe:

    # w happy "Aha! Just when I'd finally worked up the energy to clean up around here, what do I find?"
    w happy "Aha! Pile quand j'avais enfin trouvé l'énergie de tout nettoyer, que vois-je donc?"

# game/script.rpy:1238
translate fr ch3_e82a855f:

    # w shy "Yes, this is no mere case of forgetfulness... it was indeed a little game all along!"
    w shy "Ce n'est clairement pas un simple oubli... mais bel et bien un petit jeu depuis le début!"

# game/script.rpy:1240
translate fr ch3_1da6cefd:

    # n "Periwinkle giddily laughs to himself, excited to have been proven right."
    n "Periwinkle rit d'un air étourdi, satisfait d'avoir eu raison."

# game/script.rpy:1243
translate fr ch3_4aed7301:

    # w love "You've escalated it too far, Pastille! To leave your jacket behind is just ridiculous 💙"
    w love "Tu es allé trop loin, Pastille! Laisser ta veste derrière toi est juste ridicule 💙"

# game/script.rpy:1244
translate fr ch3_ac8d902a:

    # w teehee "He leaves me no choice! I'll just have to return this myself~"
    w teehee "Il ne me laisse plus le choix! Je vais devoir la lui rendre moi-même~"

# game/script.rpy:1245
translate fr ch3_6f0e85f3:

    # n "Periwinkle abandons what he was doing, and skips off to his room to get dressed."
    n "Periwinkle abandonne ce qu'il était en train de faire, et court se changer dans sa chambre."

# game/script.rpy:1257
translate fr ch3_3eb32547:

    # "I hadn't had a chance to return to Atelier Sweets since first meeting Pastille."
    "Je n'ai pas eu la moindre occasion de retourner à Atelier Sweets depuis ma première rencontre avec Pastille."

# game/script.rpy:1258
translate fr ch3_88f3e23d:

    # "He was the one always showing up on MY doorstep, after all. There was no need."
    "Il est toujours celui qui vient à MA porte, après tout. Alors que rien ne l'y oblige."

# game/script.rpy:1259
translate fr ch3_928953dd:

    # "It's about time I paid him a visit, yes? I could restock on my favorite candies as well 💙"
    "Il est donc temps que j'aille lui rendre visite, pas vrai? Et je pourrais en profiter pour refaire le plein de bonbons 💙"

# game/script.rpy:1260
translate fr ch3_76b2fe88:

    # nvl clear
    nvl clear

# game/script.rpy:1263
translate fr ch3_8dc899ac:

    # "Upon reaching Atelier Sweets, though, I hesitate."
    "Mais après avoir atteint Atelier Sweets, j'hésite."

# game/script.rpy:1264
translate fr ch3_803e31e4:

    # "Would it be rude to barge in while he's working? I just know I wouldn't be able to resist teasing him..."
    "Serait-ce malpoli de s'inviter pendant qu'il travaille? Je sais que je ne pourrais pas résister à l'envie de l'embêter..."

# game/script.rpy:1265
translate fr ch3_e56c2f10:

    # "Hm. As to not become a nuisance, I shall make my presence known from here!"
    "Hm. Pour ne pas devenir une nuisance, je dois faire de ma présence un secret!"

# game/script.rpy:1266
translate fr ch3_d6ac3282:

    # nvl clear
    # n "Periwinkle boldly approaches the bench directly in front of the candy shop, and sits down..."
    nvl clear
    n "Periwinkle approche audacieusement le banc pile en face de la boutique de bonbons, et s'assoit... "

# game/script.rpy:1269
translate fr ch3_d2fc93d8:

    # n "...all while wearing Pastille's \"forgotten\" jacket."
    n "...tout en portant la veste \"oubliée\" par Pastille."

# game/script.rpy:1271
translate fr ch3_8cd95367:

    # w jacket calm "(And now, we wait 💙)"
    w jacket calm "(Plus qu'à attendre 💙)"

# game/script.rpy:1273
translate fr ch3_62dbec77:

    # "A few minutes pass."
    "Quelques minutes passèrent."

# game/script.rpy:1274
translate fr ch3_5822edc0:

    # "I can see Pastille through the shop window... he's currently preoccupied with a customer."
    "Je peux voir Pastille à travers la vitre de la boutique... il est actuellement occupé avec un client."

# game/script.rpy:1275
translate fr ch3_ae539d34:

    # "Luckily, I brought a lunch 💙 A simple peanut butter and jelly sandwich."
    "Heureusement, j'ai pris de quoi manger 💙 Un simple sandwich au beurre de cacahuète et à la confiture."

# game/script.rpy:1276
translate fr ch3_51d176a4:

    # "Hmhm, will he notice me before I finish it? The customer is walking out now..."
    "Hmhm, va-t-il me remarquer avant que je ne le finisse? Le client est en train de partir..."

# game/script.rpy:1277
translate fr ch3_e963a0d1:

    # nvl clear
    # w jacket shy "(...Ah! Our eyes met 💙)"
    nvl clear
    w jacket shy "(...Ah! Nos regards se sont croisés 💙)"

# game/script.rpy:1281
translate fr ch3_7d91d129:

    # "Pastille turns away, pacing a bit. I take another bite of my sandwich, still watching intently..."
    "Pastille se retourne, trépignant un peu. Je prends une autre bouchée de mon sandwhich, sans détourner le regard..."

# game/script.rpy:1282
translate fr ch3_83d21bc8:

    # "He stops for a moment, in front of the door behind the register... until finally making his way out of the store, broom in hand."
    "Il s'arrête un instant, devant la porte derrière la caisse... jusqu'à ce qu'il décide finalement de sortir de la boutique, balai à la main."

# game/script.rpy:1283
translate fr ch3_5f582295:

    # nvl clear
    # "But instead of coming over right away, he turns his back to me, sweeping the sidewalk in front of the entrance."
    nvl clear
    "Mais au lieu de venir à moi directement, il me tourne le dos, et nettoie le trottoir devant l'entrée.  "

# game/script.rpy:1285
translate fr ch3_07c4f7e6:

    # "Perhaps he has a strict supervisor?"
    "Peut-être qu'il a un superviseur très strict?"

# game/script.rpy:1286
translate fr ch3_e8ccb9c2:

    # "Ah, he keeps glancing over his shoulder..."
    "Ah, il jette quelques coups d'oeil par-dessus son épaule..."

# game/script.rpy:1287
translate fr ch3_3f34efc0:

    # nvl clear
    # w jacket smile "(Just come over here, you silly boy...)"
    nvl clear
    w jacket smile "(Allez, viens par là, idiot...)"

# game/script.rpy:1291
translate fr ch3_07af808c:

    # "His face is quite red, so I can say with confidence that I've successfully overwhelmed him once again."
    "Ses joues sont assez rouge, alors je pense pouvoir dire que j'ai réussi à le bouleverser une fois de plus."

# game/script.rpy:1292
translate fr ch3_3bd910eb:

    # "I've finished my sandwich by the time he approaches. He takes a seat on the opposite end of the bench."
    "Je terminais mon sandwich bien avant qu'il ne s'approche. Il s'assit à l'exact opposé du banc."

# game/script.rpy:1293
translate fr ch3_76b2fe88_1:

    # nvl clear
    nvl clear

# game/script.rpy:1296
translate fr ch3_3c3d8923:

    # w jacket happy "Hmhm, I thought you were ignoring me~"
    w jacket happy "Hmhm, je pensais que tu m'ignorais~"

# game/script.rpy:1297
translate fr ch3_421ea304:

    # p omgstop "N-no, I was just trying to decide what to do."
    p omgstop "N-non, j'essayais juste de décider quoi faire."

# game/script.rpy:1298
translate fr ch3_c04a6356:

    # w calm "Was this a bad time to return your jacket?"
    w calm "Étais-ce un mauvais moment pour te rendre ta veste?"

# game/script.rpy:1299
translate fr ch3_04cd4412:

    # p shy "Not the WORST time...."
    p shy "Pas le PIRE moment..."

# game/script.rpy:1300
translate fr ch3_4488af6d:

    # w smile "Hm~?"
    w smile "Hm~?"

# game/script.rpy:1304
translate fr ch3_f83add27:

    # n "Periwinkle unzips the jacket and shuffles out of it, casually folding it onto his lap."
    n "Periwinkle ouvre la veste et s'en extirpe, la pliant tranquillement sur ses genoux. "

# game/script.rpy:1306
translate fr ch3_d9929887:

    # w cute smile "I found it whilst I was cleaning up the place."
    w cute smile "Je l'ai trouvé pendant que je nettoyais."

# game/script.rpy:1307
translate fr ch3_83944680:

    # w calm "I suppose I could've waited for you to return, but since I was in the area..."
    w calm "Je suppose que j'aurais pu attendre ton retour, mais puisque je passais par là..."

# game/script.rpy:1308
translate fr ch3_41a02a3a:

    # p ehe2 "R-right... sorry, it's my fault for leaving it behind in the first place."
    p ehe2 "O-Oui... désolé, j'ai eu tord de l'avoir laissé derrière moi en premier lieu."

# game/script.rpy:1311
translate fr ch3_b8eb6db7:

    # "Pastille can barely look me in the eye."
    "Pastille arrive à peine à me regarder dans les yeux."

# game/script.rpy:1312
translate fr ch3_c5dbde65:

    # "It doesn't stop him from stealing glances at what I'm wearing..."
    "Ce qui ne l'empêche pas de lancer quelques coups d'oeil à ma tenue..."

# game/script.rpy:1313
translate fr ch3_2d3465a6:

    # "But who could resist that? I wore my cutest dress for this."
    "Mais qui pourrait résister à ça? J'ai spécialement choisi ma robe la plus adorable."

# game/script.rpy:1314
translate fr ch3_7a7605c3:

    # nvl clear
    # "Something seems a little off, though..."
    nvl clear
    "Mais quelque chose semble étrange..."

# game/script.rpy:1316
translate fr ch3_3b5bce35:

    # "He's usually a bundle of nerves, yes, but this is a bit much."
    "Il a toujours l'air sur les nerfs, il est vrai, mais rarement à ce point. "

# game/script.rpy:1317
translate fr ch3_949ca487:

    # "I'll get right to the point, then..."
    "Autant aller droit au but... "

# game/script.rpy:1318
translate fr ch3_76b2fe88_2:

    # nvl clear
    nvl clear

# game/script.rpy:1322
translate fr ch3_3a7b6288:

    # w cute happy "Oh, Pastille. You know you don't have to plant excuses just to visit me~"
    w cute happy "Oh, Pastille. Tu n'as pas besoin de te fabriquer des excuses juste pour venir me voir, tu sais~"

# game/script.rpy:1323
translate fr ch3_3cd8d13c:

    # p "I-I wasn't... planting anything. I just forgot it on my way out."
    p "J-Je... ne fabriquais rien. Je l'ai juste oublié quand je suis parti."

# game/script.rpy:1324
translate fr ch3_528b5cc1:

    # w innocent "I find that hard to believe, considering you've forgotten exactly one thing each time you visit 💙 Really, you should be more honest!"
    w innocent "{size=-2}J'ai du mal à y croire, étant donné que tu oublies quelque chose à chaque fois que tu viens 💙 Tu devrais être beaucoup plus honnête!{/size}"

# game/script.rpy:1325
translate fr ch3_c631c321:

    # p "...Sorry. Thank you, for returning it."
    p "...Désolé. Merci de me l'avoir ramené."

# game/script.rpy:1326
translate fr ch3_4428d35a:

    # w teehee "Oh, it's my pleasure 💙 It gave ME a good excuse to see your flustered little face again!"
    w teehee "Oh, avec plaisir 💙 C'était MA bonne excuse pour venir voir ta petite tête génée à nouveau!"

# game/script.rpy:1329
translate fr ch3_4f12e620:

    # n "Periwinkle sets the jacket on the empty space between them, and rises to take his leave..."
    n "Periwinkle pose la veste dans l'espace vide entre les deux, et se lève pour partir..."

# game/script.rpy:1330
translate fr ch3_c9072ea6:

    # n "But Pastille gently grasps his wrist before he goes."
    n "Mais Pastille lui attrape gentillement la manche avant cela."

# game/script.rpy:1333
translate fr ch3_4b4c0e76:

    # p ohno2 "Peri. I'm, um... Sorry I made you think I was ignoring you."
    p ohno2 "Peri. Je suis, hum... Désolé de t'avoir fait penser que je t'ignorais."

# game/script.rpy:1334
translate fr ch3_746feb0b:

    # w cute guilty "Hmhm, I was only teasing, my sweet..."
    w cute guilty "Hmhm, je rigolais, mon sucre d'orge..."

# game/script.rpy:1335
translate fr ch3_364bac5b:

    # p nervous "Still. I can't, um... I'm not ready to be open about who I see outside of work."
    p nervous "Quand même. Je ne peux pas, hum... Je ne suis pas encore prêt à parler de qui je vois en dehors du boulot."

# game/script.rpy:1336
translate fr ch3_b4a86c3f:

    # p flustered2 "I like to keep things VERY discreet--I don't want to have to explain anything to my friends. I'd die of embarrassment."
    p flustered2 "J'aime garder les choses TRÈS discrètes-- Je ne veux pas avoir à expliquer quoi que ce soit à mes amis. J'en mourrais d'embarras."

# game/script.rpy:1337
translate fr ch3_af748ba9:

    # w neutral "(So that's why...)"
    w neutral "(C'est donc ça...)"

# game/script.rpy:1338
translate fr ch3_a218c7e9:

    # w calm "Understood 💙 I'm actually used to being someone's little secret--"
    w calm "Je comprends 💙 À vrai dire, j'ai l'habitude d'être le petit secret de quelqu'un--"

# game/script.rpy:1339
translate fr ch3_eda2d17a:

    # w neutral "...Hm, that didn't sound quite right."
    w neutral "Hm, ça sonne faux."

# game/script.rpy:1340
translate fr ch3_0c3f8324:

    # w guilty "What I'm trying to say is, I don't mind at all! From now on, I'll just continue to let you come to me 💙"
    w guilty "Ce que j'essaye de dire, c'est que ça ne me dérange pas du tout! À partir de maintenant, je te laisserai juste venir à moi 💙"

# game/script.rpy:1341
translate fr ch3_a683dc07:

    # p nervous "Th-thank you... sorry."
    p nervous "M-Merci... désolé."

# game/script.rpy:1342
translate fr ch3_3eba0b21:

    # w smile "I don't know what you keep apologizing for, Pastille. I'll see you around, yes?"
    w smile "Je ne sais pas pourquoi tu continues de t'excuser, Pastille. À plus tard, d'accord? "

# game/script.rpy:1344
translate fr ch3_c525b41f:

    # n "Pastille nods... and finally lets go of his wrist."
    n "Pastille hoche la tête... et lâche enfin sa manche."

# game/script.rpy:1347
translate fr ch3_60877f15:

    # "A misstep."
    "Une erreur."

# game/script.rpy:1348
translate fr ch3_0850fd13:

    # "A HUGE misstep..."
    "Une ÉNORME erreur..."
    nvl clear

# game/script.rpy:1349
translate fr ch3_12ede38d:

    # "I should've guessed it, from the hints he's given--just a few things he's said here and there."
    "J'aurais dû le savoir, avec les indices à ma disposition--quelques petites choses dîtes par moment."

# game/script.rpy:1350
translate fr ch3_7808934e:

    # "It was enough to put it together, wasn't it?"
    "C'était plus qu'assez pour comprendre, n'est-ce pas?"

# game/script.rpy:1351
translate fr ch3_b3bd1b1f:

    # "The most obvious one being that he always comes to me, and not the other way around."
    "Le plus évident étant qu'il venait toujours chez moi, et non l'inverse."

# game/script.rpy:1352
translate fr ch3_938f9378:

    # nvl clear
    # "Our comfortable pattern, that I recklessly interrupted..."
    nvl clear
    "Notre petit cycle, que j'ai interrompu sans réfléchir..."

# game/script.rpy:1354
translate fr ch3_ec8d7b96:

    # "I should've known, from previous encounters with closeted individuals."
    "J'aurais dû le savoir, vu mes anciennes relations avec des personnes discrètes."

# game/script.rpy:1355
translate fr ch3_de6c6bc1:

    # nvl clear
    # "What's supposed to be a fun, surprise appearance can turn so quickly into a desperate rally to cling to normalcy, carefully constructed lies to conceal the piece of yourself that may not be accepted..."
    nvl clear
    "Ce qui était supposé être une amusante apparition surprise peut très vite devenir un danger pour une vie courante, soigneusement construite sur des mensonges pour cacher une partie de soi-même qui ne serait pas acceptée..."

# game/script.rpy:1357
translate fr ch3_21ce2d92:

    # "...whether it's by the individual themself, or by their loved ones."
    "...que ce soit par la personne elle-même, ou ceux qu'elle aime."

# game/script.rpy:1358
translate fr ch3_b4dd5416:

    # "Certainly an unenviable position to find oneself in."
    "Une situation dans laquelle personne n'aimerait se trouver, sans le moindre doute."

# game/script.rpy:1359
translate fr ch3_13b8ccf7:

    # nvl clear
    # "Pastille and I had been seeing a lot of each other during this past month. Was this the inevitable breaking point, then?"
