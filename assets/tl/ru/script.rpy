    # w smile "(Ah! There he is now~)"
    w smile "(Ах! А вот и он~)"

# game/script.rpy:385
translate ru start_3578f0d2:

    # p ehe "Hey! I hope I didn't keep you waiting too long..."
    p ehe "Привет! Надеюсь, я не заставил тебя ждать слишком долго..."

# game/script.rpy:386
