translate ru start_f5e481ca:

    # w teehee "Just that you've done nothing but exceed my expectations 💙"
    w teehee "Лишь о том, что ты только и делаешь, что превосходишь мои ожидания 💙"

# game/script.rpy:502
translate ru start_857b0c55:

    # p flustered "I-I'm not... doing anything...."
    p flustered "Н-но я же… ничего не делаю..."

# game/script.rpy:504
translate ru start_51513c28:

    # n "Pastille retreats behind his glass of water, overwhelmed by embarrassment once again."
    n "В очередной раз смущённый до потери речи, Пастиль прячется за стаканом с водой."

# game/script.rpy:505
translate ru start_0c12172a:

    # w love "(I did say I'd go a little easier on him, didn't I...? Ah, he's just too irresistible 💙)"
    w love "(Я обещал доводить его чуть менее активно, да?.. Ах, перед ним слишком сложно устоять 💙)"

# game/script.rpy:507
translate ru start_41bfaa4f:

    # w calm "Anywho... I bottle and sell scents like this one. It's fairly lucrative work, once you build a reputation for yourself."
    w calm "В общем… Запахи вроде этого я закупориваю во флаконы и продаю. Это довольно прибыльное дело, если создать себе репутацию."

# game/script.rpy:508
translate ru start_9b95030e:

    # p oh "Ah... sounds fulfilling."
    p oh "О… звучит как работа не только ради денег, но и для души."

# game/script.rpy:509
translate ru start_df636102:

    # w smile "What about you, Pastille? What kind of magic do you specialize in?"
    w smile "А что насчёт тебя, Пастиль? Ты на какой магии специализируешься?"

# game/script.rpy:510
translate ru start_acfb287e:

    # p shy "Oh, I... I had mostly been living without magic, until recently."
    p shy "Ой, если честно, я… Я по большей части жил вообще без магии. До недавних пор."

# game/script.rpy:511
translate ru start_ba1cda83:

    # w oh "Without magic...? I can't imagine."
    w oh "Без магии?.. Даже представить себе не могу."

# game/script.rpy:512
translate ru start_39cda655:

    # p smile "It's not so bad. I mean, humans do it, so why not?"
    p smile "Не так уж это и ужасно. Ну то есть, человеки живут без магии, так почему бы и нет?"

# game/script.rpy:513
translate ru start_1b160ca1:

    # w "I suppose that's true."
    w "И то правда."

# game/script.rpy:514
translate ru start_a901b988:

    # w smile "I very directly make a living off of mine, so I'd find myself in quite a bind if I wasn't able to use it!"
    w smile "Я зарабатываю своей магией на жизнь, так что её потеря связала бы меня по рукам и ногам!"

# game/script.rpy:515
translate ru start_a5adf706:

    # w teehee "Not that I mind being bound from time to time, you know 💙"
    w teehee "Впрочем... Иногда, под настроение, я даю себя связать – если ты понимаешь, о чём я 💙"

# game/script.rpy:516
translate ru start_49904814:

    # p omgstop "H-how do you keep doing that...?! Every time I think we're talking about something innocent..."
    p omgstop "Как это у тебя получается?!.. Каждый раз, когда я думаю, что мы обсуждаем что-то совершенно невинное..."

# game/script.rpy:517
translate ru start_cbd9ddf7:

    # w love "(Ah, I just can't help myself, can I?)"
    w love "(Ах, но могу ли я удержаться?)"

# game/script.rpy:518
translate ru start_5f36b5b8:

    # w teehee "Deliberate word choice, my sweet~ would you like me to hold back a little more?"
    w teehee "Я нарочно так подбираю слова, моя конфетка~ мне стоит чуток притормозить?"

# game/script.rpy:519
translate ru start_04132ea6:

    # p um "N-no, it's okay... I was just..."
    p um "Н-нет, всё в порядке… Просто это..."

# game/script.rpy:520
translate ru start_89193a14:

    # p embarrassed "Kinda impressed...."
    p embarrassed "Весьма впечатляет..."

# game/script.rpy:526
translate ru start_ca622856:

    # "We finish up our meals, and decide on sharing a slice of strawberry cheesecake for dessert."
    "Под конец ужина мы решаем взять один десерт на двоих – порцию клубничного чизкейка."

# game/script.rpy:527
translate ru start_d1910196:

    # "Pastille deliberately leaves the larger bits of strawberries for me..."
    "Пастиль оставляет мне кусочки клубники покрупнее – явно намеренно..."

# game/script.rpy:528
translate ru start_014b42bb:

    # "I wonder, is it because he doesn't like them? Or is he just THAT kind?"
    "Интересно, это потому что ему не нравится клубника? Или он НАСТОЛЬКО великодушен?"

# game/script.rpy:529
translate ru start_a37124b7:

    # "Either way, this has quickly become my most favorite date of the past few months 💙"
    "В любом случае, это свидание очень быстро стало моим любимым за последние несколько месяцев 💙"

# game/script.rpy:530
translate ru start_76b2fe88_5:

    # nvl clear
    nvl clear

# game/script.rpy:534
translate ru start_a47a6a63:

    # w smile "Tell me more about yourself, Pastille. I'm afraid the only thing I know is that you work at the renowned Atelier Sweets..."
    w smile "Расскажи мне о себе, Пастиль. Боюсь, единственное, что я знаю – то, что ты работаешь в знаменитом Ателье Сладостей..."

# game/script.rpy:535
translate ru start_a256d276:

    # p ehe "Oh, um... there's not much else to know...."
    p ehe "Ох, хм… да кроме этого обо мне и знать особо нечего..."

# game/script.rpy:536
translate ru start_b5d5581a:

    # w happy "Surely there's plenty more than just that! Any hobbies, perhaps?"
    w happy "Наверняка найдётся много всякого! Хобби, например?"

# game/script.rpy:537
translate ru start_ff0c91f6:

    # p shy "C...cleaning, maybe?"
    p shy "У...уборка, пожалуй?"

# game/script.rpy:538
translate ru start_323445d9:

    # w calm "Any NON work-related hobbies, dear."
    w calm "Что-то НЕ связанное с работой, ненаглядный."

# game/script.rpy:539
translate ru start_452a98f0:

    # p ehe2 "Sorry, I never know how to answer these types of questions..."
    p ehe2 "Прости, я не знаю толком, как отвечать на такие вопросы..."

# game/script.rpy:540
translate ru start_bd8b2307:

    # p smile "My best friend is an alchemist, so I've recently been going on little adventures to help gather ingredients for her craft."
    p smile "Моя лучшая подруга – алхимик, так что в последнее время мы иногда пускаемся в маленькие приключения в поисках ингредиентов для её ремесла."

# game/script.rpy:541
translate ru start_6c670493:

    # w my "Now THERE'S something interesting!"
    w my "А ВОТ ЭТО интересненько!"

# game/script.rpy:542
translate ru start_e955536c:

    # p shy "Other than that, I honestly don't get out much... I have my hands full running the store."
    p shy "В остальном я особо и не выхожу никуда… Вести дела в Ателье довольно хлопотно, так что я постоянно занят."

# game/script.rpy:543
translate ru start_d04e37c7:

    # w smile "So diligent 💙 Does that mean this is your first night out in a while?"
    w smile "Какой ты прилежный 💙 Значит ли это, что ты сейчас выбрался на свидание в первый раз за долгое время?"

# game/script.rpy:544
translate ru start_03f245f3:

    # p oh "Ah... yeah, I guess it is."
    p oh "А… да, так и есть."

# game/script.rpy:545
translate ru start_97012fb5:

    # w innocent "I'm honored you were willing to share it with me, then~"
    w innocent "Тогда я польщён, что ты решил разделить его именно со мной~"

# game/script.rpy:546
translate ru start_8c01ab99:

    # p shy "Yeah! I don't think I ever would've tried this place if you hadn't brought me in..."
    p shy "Ага! И я думаю, если бы не твоё приглашение, я бы никогда здесь не побывал..."

# game/script.rpy:547
translate ru start_ddcf714a:

    # p ehe "So... it's been worth it so far. Thanks, Periwinkle."
    p ehe "Так что… Оно стоило того. Спасибо, Барвинок."

# game/script.rpy:553
translate ru start_79c59f28:

    # "The table had long been cleared, and yet our conversation continued through the night."
    "Приборы давно унесли, но наш разговор продолжался до глубокой ночи."

# game/script.rpy:554
translate ru start_1efc9d29:

    # "This place is never too busy, which always leaves me free to linger here without the guilt of taking up any much-needed table space."
    "В этом ресторанчике никогда не бывает многолюдно, так что я могу спокойно задерживаться здесь и не волноваться, что занимаю зря место."

# game/script.rpy:555
translate ru start_b7237054:

    # "The longer the date, the more satisfying the finale 💙 That's something I live by."
    "Чем дольше свидание, тем слаще его кульминация 💙 Можно сказать, это мой девиз."

# game/script.rpy:556
translate ru start_6ec3835a:

    # "Rushing straight to the climax inevitably gets a bit dull after a while. I want to enjoy this night to its fullest 💙"
    "Бежать сразу к финишной прямой… со временем спешка приедается. Я хочу взять от этой ночи всё 💙"

# game/script.rpy:557
translate ru start_76b2fe88_6:

    # nvl clear
    nvl clear

# game/script.rpy:560
translate ru start_2ff85601:

    # w love "Hmhmhm... Pastille... do you see the witch at that table over there?"
    w love "Хмхмхм… Пастиль… Видишь ведьму вооон за тем столиком?"

# game/script.rpy:561
translate ru start_8185ca92:

    # p neutral "Hm...?"
    p neutral "Хм?.."

# game/script.rpy:563
translate ru start_9f7508ef:

    # w happy "Don't be too obvious, now. The one with the tall hat, you see...?"
    w happy "Чш, только так чтобы оне нас не заметили. С высокой шляпой, видишь?.."

# game/script.rpy:564
translate ru start_69f4106c:

    # p uhoh "Ah... y-yeah, I see them."
    p uhoh "А... а-ага, вижу."

# game/script.rpy:565
translate ru start_e8772676:

    # w teehee "I brought them here about two weeks ago. I guess they agreed that it made a nice date spot!"
    w teehee "У меня с неми было свидание недели две назад, прямо здесь! Значит, не один я теперь считаю, что это отличное место для романтических встреч!"

# game/script.rpy:566
translate ru start_b7da8094:

    # p ehe2 "Hahaha... I, um... I actually..."
    p ehe2 "Хахаха… Я, м… Как бы сказать..."

# game/script.rpy:567
translate ru start_b052a575:

    # p uhoh "Th-the guy sitting across from them... I'm pretty sure I've been with him before."
    p uhoh "Тот парень, с которым ех теперешнее свидание… Я почти уверен, что у нас с ним тоже было."

# game/script.rpy:569
translate ru start_9590f34f:

    # w my "NO... surely, you're joking, Pastille!"
    w my "НЕ МОЖЕТ… да ты шутишь, Пастиль!"

# game/script.rpy:570
translate ru start_d1b5f16c:

    # p omgstop "SH-SHHHH!!! Don't say my name so loudly...!"
    p omgstop "ЧШ-ШШШШ!!! Не так громко, ещё и по имени!.."

# game/script.rpy:571
translate ru start_2eb04fd0:

    # w happy "Just keep your head low, I'm sure he won't notice."
    w happy "Пригнись, и я уверен, что он ничего не заметит."

# game/script.rpy:572
translate ru start_ffe0c64f:

    # w oh "...Oh, he's just looked this way."
    w oh "...Ох, он только что посмотрел в нашу сторону."

# game/script.rpy:573
translate ru start_50c22d14:

    # p scream "AAAAAHH...!!!" with vpunch
    p scream "ААААААХ!!!..." with vpunch

# game/script.rpy:574
translate ru start_f4ea47ed:

    # w teehee "Only kidding 💙"
    w teehee "Я шучу 💙"

# game/script.rpy:575
translate ru start_e2427086:

    # p flustered "P-Peri...!!"
    p flustered "...В-винок!!.."

# game/script.rpy:576
translate ru start_fc329306:

    # w shy "Ooh, a nickname already? We're moving so fast..."
    w shy "Ооо, уже уменьшительно-ласкательное? Наши отношения развиваются так быстро..."

# game/script.rpy:577
translate ru start_212fa4c4:

    # p seriously "You're the one who's been calling me \"my sweet\" all night...!"
    p seriously "А кто весь вечер называл меня \"моя конфетка\"!.."

# game/script.rpy:578
translate ru start_3e500425:

    # w oh "Well, you are, aren't you? Whose fault is it that you share a name with candy?"
    w oh "М, но ведь так и есть? Кто виноват, что ты делишь имя со сладким лакомством?"

# game/script.rpy:579
translate ru start_54dcfd58:

    # p shout "Not mine!!"
    p shout "Уж точно не я!!"

# game/script.rpy:580
translate ru start_bb5f7312:

    # w smile "Still. Do you think those two make a good couple?"
    w smile "И всё же. Как думаешь, хорошая ли из этих двоих пара?"

# game/script.rpy:581
translate ru start_831b1ea7:

    # p flustered2 "How should I know...?!"
    p flustered2 "Откуда мне знать?!.."

# game/script.rpy:582
translate ru start_b2b6228d:

    # w happy "Just imagine the kind of person I'd go on a date with, and pair them with the other!"
    w happy "Просто представь, с какой личностью я бы пошёл на свидание, и предположи, как она сочтётся с тем, кого знаешь ты!"

# game/script.rpy:583
translate ru start_9fb1f04a:

    # p shy "And what kind of person is that...?"
    p shy "И с какой же это личностью?.."

# game/script.rpy:584
translate ru start_33e2c8d5:

    # w innocent "You, for one 💙"
    w innocent "С такой, как ты, например 💙"

# game/script.rpy:585
translate ru start_adb706d7:

    # p ehe "Pfft--maybe they wouldn't be so good together..."
    p ehe "Пффт– да нет, думаю, не так уж они и подошли бы друг другу..."

# game/script.rpy:586
translate ru start_43faf218:

    # w oh "My, am I supposed to take offense to that?"
    w oh "Оу, что это, критика моих вкусов?"

# game/script.rpy:587
translate ru start_881b271e:

    # p smile "Nah, that guy was just kinda pushy."
    p smile "Да нет, просто тот парень был довольно бесцеремонным."

# game/script.rpy:588
translate ru start_bbb521cf:

    # w happy "Hmhm... ahaha, you're too much, Pastille!"
    w happy "Хмхм… ахаха, ну ты даёшь, Пастиль!"

# game/script.rpy:594
translate ru start_4554f13a:

    # "We eventually made our way out of the restaurant that night..."
    "Спустя какое-то время мы всё же покинули ресторан..."

# game/script.rpy:595
translate ru start_7211b97d:

    # "It had gotten quite late already. When's the last time I stayed until closing...?"
    "Было это уже ночью. Когда в последний раз я задерживался до самого закрытия?.."

# game/script.rpy:596
translate ru start_bc63f4b9:

    # "There was never a moment of awkward silence between us. Only Pastille's embarrassed pauses--clear attempts to steer his mind away from debauchery 💙"
    "Между нами ни на мгновение не повисала неловкая тишина. Если не считать смущённых замолканий Пастиля – явных попыток перевести мысли в менее развратное русло 💙"

# game/script.rpy:597
translate ru start_1f9c5254:

    # "As we wander back into the night air, he's the first to speak up again..."
    "Когда мы вышли на свежий воздух под ночное небо, он вновь заговорил первым..."

# game/script.rpy:598
translate ru start_76b2fe88_7:

    # nvl clear
    nvl clear

# game/script.rpy:601
translate ru start_a046c557:

    # p "You could've at least let me cover the tip..."
    p "Ты бы хоть позволил мне покрыть чаевые..."

# game/script.rpy:602
translate ru start_bbd42092:

    # w innocent "Nonsense. I'm the one who asked you out tonight, you don't have to cover a thing."
    w innocent "Ерунда. Это я тебя пригласил провести вместе вечер, с чего это ты должен что-то покрывать."

# game/script.rpy:603
translate ru start_ffe053ec:

    # p anxious "...."
    p anxious "..."

# game/script.rpy:604
translate ru start_14e8a9bb:

    # w teehee "In fact, I'd prefer if you DIDN'T cover--"
    w teehee "Если уж на то пошло, я бы предпочёл, чтобы ты НЕ покрывал–"

# game/script.rpy:605
translate ru start_d7542b15:

    # p omg "Okay, I saw that one coming this time! Y-you don't have to say it..." with vpunch
    p omg "Ладно, на этот раз я был готов к тому, что ты что-то такое скажешь! Т-тебе не обязательно договаривать!" with vpunch

# game/script.rpy:606
translate ru start_ddc15564:

    # w happy "Too easy, hm? Ahaha~"
    w happy "Слишком напрашивается, хм? Хаха~"

# game/script.rpy:607
translate ru start_b2f2809d:

    # w smile "But really, it's a shame to hide such a cute outfit from the world 💙"
    w smile "Но правда же, так жаль скрывать от мира столь милый наряд 💙"

# game/script.rpy:608
translate ru start_71e4cdd4:

    # p ehe "I-I don't have the confidence..."
    p ehe "М-мне не хватает уверенности в себе..."

# game/script.rpy:609
translate ru start_00c0a8d9:

    # w shy "Ahh. Reminds me of my youth..."
    w shy "Ахх. Напоминает меня в мои юные годы... Ты придёшь к этому, моя конфетка."

# game/script.rpy:610
translate ru start_151a84c5:

    # w smile "You'll get there, my sweet. One day, you'll be able to toss aside any feelings of inadequacy, and wear all sorts of daring outfits with pride!"
    w smile "{size=-2}Однажды у тебя получится отмести в сторону чувство неполноценности или неуместности, и ты будешь с гордостью носить всякие-разные наряды, даже самые вызывающие!{/size}"

# game/script.rpy:611
translate ru start_e98f9e49:

    # p neutral "N-no, it's not a matter of self esteem or anything. It's just..."
    p neutral "Н-нет, это не вопрос самооценки или чего-то вроде. Просто..."

# game/script.rpy:612
translate ru start_e62d49d4:

    # p embarrassed "If anyone I knew saw me in this, I would die."
    p embarrassed "Если бы меня в этом увидел кто-то, кого я знаю, я умер бы на месте."

# game/script.rpy:615
translate ru start_c0d59d1c:

    # "So that's how it is, hm~?"
    "Так вот оно как, хм?~"

# game/script.rpy:616
translate ru start_7db31c84:

    # "I'm being treated to a more intimate side of this witch boy right now 💙"
    "Значит, мне выдалась благословенная возможность увидеть более интимную сторону этого ведьмальчика 💙"

# game/script.rpy:617
translate ru start_ca35036d:

    # "We walk together under the street lights, until we reach our original meeting place..."
    "Мы вместе бредём под светом уличных фонарей, пока не добираемся до нашего изначального места встречи..."

# game/script.rpy:618
translate ru start_76b2fe88_8:

    # nvl clear
    nvl clear

# game/script.rpy:622
translate ru start_ae339b7f:

    # w oh "Would you like me to escort you home?"
    w oh "Как ты смотришь на то, чтобы я проводил тебя до дома?"

# game/script.rpy:623
translate ru start_0cb1f383:

    # p wha "N-no, that's okay..."
    p wha "Д-да нет, не стоит..."

# game/script.rpy:624
translate ru start_56666e95:

    # w smile "Then, if you don't mind... my place is just down the street."
    w smile "Тогда, если ты не против… я живу тут недалеко, на этой самой улице."

# game/script.rpy:625
translate ru start_f4615b4a:

    # w innocent "Perhaps you'd like to accompany me?"
    w innocent "Быть может, ты предпочёл бы сопроводить меня?"

# game/script.rpy:626
translate ru start_21bf7ae8:

    # p embarrassed "Yes--I mean... I wouldn't want you to have to walk alone in the dark."
    p embarrassed "Да– То есть… Мне не хотелось бы, чтобы ты возвращался домой по темноте в одиночку."

# game/script.rpy:627
translate ru start_de097d15:

    # w calm "Such a gentleman 💙"
    w calm "Истинный джентельмен 💙"

# game/script.rpy:632
translate ru start_d36a9b3e:

    # n "Periwinkle expertly slides his hand up and under Pastille's mantle, linking arms as they go along."
    n "Барвинок умелым движением запускает руку под накидку Пастиля и берёт его под локоть."

# game/script.rpy:633
translate ru start_1353eaa8:

    # n "They walk in comfortable silence, toward Periwinkle's house..."
    n "Так они и идут к дому Барвинка – рука об руку, в уютном молчании..."

# game/script.rpy:639
translate ru start_94642492:

    # w calm "Well, this is me..."
    w calm "Ну что ж, пришли..."

# game/script.rpy:640
translate ru start_78aeb21b:

