    # nvl clear
    nvl clear

# game/script.rpy:417
translate ru start_95b9df83:

    # n "Pastille slides into the booth, following Periwinkle's lead."
    n "Следуя примеру Барвинка, Пастиль усаживается за столик."

# game/script.rpy:418
translate ru start_ac7632e0:

    # n "One hand holds his mantle in place, while the other brushes his bangs aside anxiously..."
    n "Одной рукой он придерживает накидку, а другой нервно поправляет пряди волос..."

# game/script.rpy:419
translate ru start_21398492:

    # w smile "Is this your first time?"
    w smile "Это твой первый раз?"

# game/script.rpy:420
translate ru start_db90c8f0:

    # p wha "Huh...?"
    p wha "А?.."

# game/script.rpy:421
translate ru start_c33cac40:

