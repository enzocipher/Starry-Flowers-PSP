# game/script.rpy:434
translate ru start_cb1d6efd:

    # w oh "Oh?"
    w oh "Оу?"

# game/script.rpy:435
translate ru start_140c840a:

    # p ehe "I'm not looking for anything serious. In fact, I kinda prefer when it's just a one-night thing..."
    p ehe "Я не ищу ничего серьёзного. В общем-то, для меня комфортнее всего встречи на одну ночь..."

# game/script.rpy:436
translate ru start_4711c7fe:

