    # p embarrassed "...Which is probably for the best, actually. No one should be allowed to go around creating souls spontaneously...!"
    p embarrassed "...Что, на самом деле, наверное, и к лучшему. Нельзя допускать, чтобы ведьмы создавали души направо и налево, когда им взбредёт в голову!.."

# game/script.rpy:2150
translate ru ch4_29508975:

    # w neutral "Hm..."
    w neutral "Хм…"

