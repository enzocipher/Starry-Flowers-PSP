# game/script.rpy:439
translate ru start_3f4a3176:

    # w happy "Certainly! I'm open to that as well."
    w happy "Конечно! Я тоже открыт для этого."

# game/script.rpy:440
translate ru start_d287ebe0:

    # p um "Did you have... any other ground rules? Sorry, I didn't mean to cut you off..."
    p um "Есть ли у тебя… какие-то ещё правила или принципы? Извини, я не хотел тебя перебивать..."

