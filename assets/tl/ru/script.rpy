# game/script.rpy:2172
translate ru ch4_87960f32:

    # p sure "Sure. Maybe one day."
    p sure "Конечно. Возможно, когда-нибудь."

# game/script.rpy:2175
translate ru ch4_e955de1d:

    # "Pastille is amazing."
    "Пастиль потрясающий."

# game/script.rpy:2176
