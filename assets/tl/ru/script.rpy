# game/script.rpy:372
translate ru start_3201de99:

    # "When I told him to meet me here, he could only manage to nod in response."
    "Когда я предложил ему встретиться в условленном месте, у него вышло только кивнуть в ответ."

# game/script.rpy:373
translate ru start_de85fd75:

    # nvl clear
    # w happy "(So cute... ah, my favorite type to pursue!)"
