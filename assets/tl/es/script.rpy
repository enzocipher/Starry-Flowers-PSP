    p shy "Mientras estemos afuera, no acabaremos... um...."

# game/script.rpy:1818
translate es ch4_db519a24:

    # w my "(Oh, is he going to say it~?)"
    w my "(Oh, ¿va a decirlo~?)"

# game/script.rpy:1819
translate es ch4_ae3f626a:

    # p omg "Y-you know...."
    p omg "Y-ya sabes...."

# game/script.rpy:1820
translate es ch4_143046d9:

    # w innocent "(Hmhm, of course not 💙)"
    w innocent "(Hmhm, por supuesto que no 💙)"

# game/script.rpy:1821
translate es ch4_98697be5:

    # p wha "I actually like when we get to talk...!"
    p wha "¡De hecho me gusta cuando podemos hablar...!"

# game/script.rpy:1822
translate es ch4_09628e53:

    # p uhoh "I-I mean, not that we DON'T when I sleep over, it's just... a different kind...."
    p uhoh "Q-quiero decir, no es que NO lo hagamos cuando me quedo a dormir, solo es... de una forma diferente...."

# game/script.rpy:1823
translate es ch4_c6264bf7:

    # w calm "True... 💙"
    w calm "Cierto... 💙"

# game/script.rpy:1824
translate es ch4_b63fac77:

    # p flustered2 "Sorry... now I feel like I'm talking too much."
    p flustered2 "Lo siento... ahora siento que estoy hablando demasiado."

# game/script.rpy:1825
translate es ch4_b1f80a86:

    # w love "Not at all, my sweet! I have to say, I rather enjoy our chats as well~"
    w love "¡Para nada, dulzura! Tengo que decir que también disfruto bastante de nuestras conversaciones~"

# game/script.rpy:1826
translate es ch4_062a8003:

    # w teehee "Even if you can't resist cutting them short once we're behind closed doors 💙"
    w teehee "Aunque no puedas resistirte a terminarlas una vez que estamos a solas 💙"

# game/script.rpy:1827
translate es ch4_8ad9efbe:

    # p omgstop "I-I'm really sorry...!" with vpunch
    p omgstop "¡L-lo siento mucho...!" with vpunch

# game/script.rpy:1829
translate es ch4_7f6c0c2e:

    # "He's simply too much fun..."
    "Es simplemente tan divertido..."

# game/script.rpy:1830
translate es ch4_a556fc99:

    # "Ah, but this is no time for my usual teasing~! I can't forget what brought us here..."
    "Ah, ¡pero no es momento para mis bromas de siempre~! No debo olvidar lo que nos trajo aquí..."

# game/script.rpy:1832
translate es ch4_23b094b1:

    # "This is the perfect opportunity to become more deeply acquainted."
    "Esta es la oportunidad perfecta para conocernos en profundidad."

# game/script.rpy:1833
translate es ch4_d08bb998:

    # "I'll learn all about Pastille, so that I don't end up crossing the line again..."
    "Aprenderé todo sobre Pastille, así no terminaré sobrepasando la línea otra vez..."

# game/script.rpy:1834
translate es ch4_76b2fe88_4:

    # nvl clear
    nvl clear

# game/script.rpy:1837
translate es ch4_631bf0aa:

    # w oh "In the interest of defining boundaries... are there any subjects I should avoid bringing up with you?"
    w oh "A fin de definir límites... ¿hay algún tema que deba evitar sacar contigo?"

# game/script.rpy:1838
translate es ch4_0d8de333:

    # w guilty "On that note, has there ever been anything I've said that's caused you discomfort in the slightest? Please don't hold back."
    w guilty "Respecto a eso, ¿alguna vez he dicho algo que te haya incomodado en lo más mínimo? Por favor no te contengas."

# game/script.rpy:1839
translate es ch4_84306ef7:

    # p think "Hmm... nothing really comes to mind...."
    p think "Hmm... no se me ocurre nada en verdad...."

# game/script.rpy:1840
translate es ch4_a73c1ed9:

    # p shy "I mean, I've always felt... pretty comfortable around you... so we could probably talk about anything and it'd be okay."
    p shy "Quiero decir, siempre me he sentido... bastante cómodo a tu lado..."
    p "Así que probablemente podríamos hablar de cualquier cosa y estaría bien."

# game/script.rpy:1841
translate es ch4_15ab8bed:

    # w love "Anything, really? Surely you must have SOME sensitive topics you'd like to avoid."
    w love "¿Nada, de verdad? Seguro hay ALGÚN tema delicado que prefieras evitar."

# game/script.rpy:1842
translate es ch4_7af929e3:

    # p oh "I guess so... but I wouldn't really be worried talking about them with you."
    p oh "Supongo que sí... pero en realidad no me molestaría hablar de esas cosas contigo."

# game/script.rpy:1843
translate es ch4_d4971bd3:

    # p ehe "Actually, you might be the most attentive person I've ever met. Maybe that's why I'm not worried at all."
    p ehe "De hecho, puede que seas la persona más atenta que he conocido. Tal vez es por eso que no me preocupa."

# game/script.rpy:1844
translate es ch4_5e290654:

    # w innocent "Hmhm, I'm glad to hear that 💙"
    w innocent "Hmhm, me alegra oír eso 💙"

# game/script.rpy:1845
translate es ch4_3e0eb085:

    # w smile "But you've certainly piqued my curiosity... what kinds of sensitive topics, if you don't mind me asking?"
    w smile "Aunque a decir verdad despertaste mi curiosidad... ¿Qué tipo de temas delicados, si no importa que pregunte?"

# game/script.rpy:1846
translate es ch4_55849c5e:

    # p think "Like... for example. You've never made me feel weird about gender stuff."
    p think "Como... por ejemplo. Nunca me has hecho sentir incómodo con respecto al género."

# game/script.rpy:1847
translate es ch4_7baf213c:

    # w oh "I'd certainly hope not! That one's a bit sensitive for me as well."
    w oh "¡Esperaba que no! Eso también es algo un poco delicado para mí."

# game/script.rpy:1848
translate es ch4_6486f9c9:

    # p happy "See? That's why it feels okay to talk about with you."
    p happy "¿Ves? Por eso se siente bien hablarlo contigo."

# game/script.rpy:1849
translate es ch4_6927813d:

    # p shy "I'm, well... not very masculine. So I get mistaken for a girl every now and then..."
    p shy "No soy, bueno... muy masculino. Por lo que de vez en cuando me confunden por una chica..."

# game/script.rpy:1850
translate es ch4_0f2dfa36:

    # p oh "Not that it's something I get mad about or anything. I've always dealt with it, ever since I was little."
    p oh "No es que sea algo que me enoje ni nada. Siempre he lidiado con eso, desde que era pequeño."

# game/script.rpy:1852
translate es ch4_be78c7ec:

    # p flustered2 "Still, I think it bothers me in particular, since... well, you know, I'm intersex."
    p flustered2 "Aún así, creo que eso me molesta en particular, ya que... bueno, ya sabes, soy intersex."

# game/script.rpy:1853
translate es ch4_6f967fdb:

    # w decline "Mm, right."
    w decline "Mm, cierto."

# game/script.rpy:1854
translate es ch4_136e9d0e:

    # p ohno2 "I want to be recognized as a boy. But I like wearing feminine clothes, too..."
    p ohno2 "Quiero que me reconozcan como un chico. Pero también me gusta usar ropa femenina..."

# game/script.rpy:1855
translate es ch4_b2e10257:

    # w happy "Yes, that's it exactly! I feel the very same!"
    w happy "¡Sí, es exactamente eso! ¡Me siento igual!"

# game/script.rpy:1856
translate es ch4_e80b7732:

    # p ehe "Right? Like, I don't wanna be limited to presenting only one way... even if I'm fine with boyish clothes, too."
    p ehe "¿Verdad? O sea, no quiero limitarme a presentarme de una sola manera... incluso si igual estoy bien con ropa masculina."

# game/script.rpy:1857
translate es ch4_8ba96462:

    # w calm "For me, it's simply about looking beautiful. I dress to fit my ideal."
    w calm "Para mí, simplemente se trata de lucir hermoso. Me visto acorde a mi ideal."

# game/script.rpy:1858
translate es ch4_ad75be97:

    # w oh "It's not a matter of gender, but aesthetic preference. These are the clothes I feel best in."
    w oh "No es cuestión de género, sino de preferencia estética. Esta es la ropa con la que mejor me siento."

# game/script.rpy:1859
translate es ch4_fc9182ac:

    # p embarrassed "You, um... look really good in them, too...."
    p embarrassed "Tú, um... te ves realmente bien en ella, además...."

# game/script.rpy:1860
translate es ch4_f6672aa7:

    # w innocent "Why, thank you! And I must say, YOUR sense of style never fails to impress 💙"
    w innocent "¡Oh, gracias! Y tengo que decir, TU sentido de la moda nunca deja de impresionar 💙"

# game/script.rpy:1861
translate es ch4_e09db7a3:

    # p omg "Ah, haha... I'm glad you like it...."
    p omg "Ah, jaja... me alegra que te guste...."

# game/script.rpy:1863
translate es ch4_403c728d:

    # n "Pastille sips his drink while Periwinkle continues."
    n "Pastille bebe de su bebida mientras Periwinkle continúa."

# game/script.rpy:1865
translate es ch4_6a1d304f:

    # w calm "When I was young... I didn't have the confidence to dress so beautifully. Hmhm, can you even imagine it?"
    w calm "Cuando era joven... no tenía la confianza para vestirme así de bien. Hmhm, ¿siquiera puedes imaginarlo?"

# game/script.rpy:1866
translate es ch4_40871af5:

    # p ehe "You, without confidence? No, I'm not sure that's possible."
    p ehe "¿Tú, sin confianza? No, dudo que eso sea posible."

# game/script.rpy:1867
translate es ch4_3ddf3ee7:

    # w happy "Right~? I suppose I was a different person back then."
    w happy "¿Cierto~? Supongo que era una persona diferente en ese entonces."

# game/script.rpy:1868
translate es ch4_58aae749:

    # w neutral "Where I grew up... things were much more black and white. You were either a boy or a girl, and you HAD to dress accordingly."
    w neutral "Donde crecí... era todo más en blanco y negro. O eras un chico o una chica, y TENÍAS que vestirte como tal."

# game/script.rpy:1869
translate es ch4_51a7c612:

    # p ohno2 "Ah, that sounds harsh..."
    p ohno2 "Ah, eso suena duro..."

# game/script.rpy:1870
translate es ch4_c463434f:

    # w my "It very much was! I was completely MISERABLE!"
    w my "¡De verdad que lo era! ¡Era completamente MISERABLE!"

# game/script.rpy:1871
translate es ch4_424e83ef:

    # w oh "Perhaps it's because I come from that sort of environment... that I want it to be known, I look this glamorous as a BOY."
    w oh "Tal vez se deba a que vengo de ese tipo de entorno... que quiero que se sepa que me veo así de glamoroso siendo un CHICO."

# game/script.rpy:1872
translate es ch4_9d701ab1:

    # w pout "Not to say that this is easy for ANY gender--I only wish for my efforts to be acknowledged!"
    w pout "No quiero decir que sea fácil para CUALQUIER género--¡solo deseo que se reconozcan mis esfuerzos!"

# game/script.rpy:1873
translate es ch4_180fe63a:

    # p shy "Haha, I think that's just your competitive spirit again."
    p shy "Jaja, creo que eso es solo tu espíritu competitivo otra vez."

# game/script.rpy:1874
translate es ch4_564ec052:

    # w happy "See, you truly understand me~!"
    w happy "¡Ves, tú de verdad me entiendes~!"

# game/script.rpy:1876
translate es ch4_50f5fa7a:

    # n "They laugh together. Periwinkle relaxes into his chair and finishes his drink with a big smile on his face..."
    n "Ríen juntos. Periwinkle se relaja en su silla y termina su bebida con una gran sonrisa en su rostro..."

# game/script.rpy:1880
translate es ch4_ab260034:

    # "Pastille and I depart from the café and make our way down the street."
    "Pastille y yo salimos del café y nos dirigimos a la calle."

# game/script.rpy:1881
translate es ch4_3d888206:

    # "With no destination in mind, the details of our surroundings--things I've never really paid any mind to, make themselves known."
    "Sin destino en mente, los detalles de nuestro alrededor--a los que nunca les había prestado atención, se dan a conocer."

# game/script.rpy:1882
translate es ch4_00e39214:

    # "Aromas from the bakery, the flower shop, the patisserie; each distinct and enticing. I'm left with a peaceful feeling as we pass each of them by."
    "Los aromas de la panadería, la floristería, la pastelería; cada uno distinto y atrayente. Me quedo con una sensación de paz al pasar frente a cada uno."

# game/script.rpy:1883
translate es ch4_01ac64e9:

    # nvl clear
    # "Now there's a fun idea... a scent that transforms over time, giving you a sense of place--"
    nvl clear
    "Tengo una idea divertida... un perfume que se transforma con el tiempo, dando la sensación del lugar--"

# game/script.rpy:1885
translate es ch4_5e60bbe1:

    # "Ah, but I shouldn't be thinking about work while I'm on a date~!"
    "Ah, ¡pero no debería estar pensando en el trabajo mientras estoy en una cita~!"

# game/script.rpy:1886
translate es ch4_6b51ed02:

    # "I turn my attention back to Pastille."
    "Devuelvo mi atención hacia Pastille."

# game/script.rpy:1887
translate es ch4_76b2fe88_5:

    # nvl clear
    nvl clear

# game/script.rpy:1890
translate es ch4_d421c7da:

    # w date smile "With gender thoroughly discussed, the next personal question would have to be..."
    w date smile "Con el género discutido a fondo, la siguiente pregunta personal tendría que ser..."

# game/script.rpy:1891
translate es ch4_83f1994a:

    # w happy "Ooh, sexuality! Which type of partner gets you THE MOST hot and bothered~?"
    w happy "¡Ooh, sexualidad! ¿Qué tipo de pareja te calienta MÁS~?"

# game/script.rpy:1892
translate es ch4_4c24ed9b:

    # p omgstop "SHH...! You can't just shout those words in the middle of a crowd...!!" with vpunch
    p omgstop "¡SHH...! ¡¡No puedes ir gritando esas palabras en medio de tanta gente...!!" with vpunch

# game/script.rpy:1893
translate es ch4_747240e4:

    # w calm "Ohh, who's even listening? I certainly wasn't shouting."
    w calm "Ohh, ¿siquiera alguien nos está escuchando? Ciertamente no estaba gritando."

# game/script.rpy:1894
translate es ch4_7e39cd48:

    # p flustered "Please don't talk about that stuff too loudly... people will start giving us weird looks...!"
    p flustered "Por favor no hables tan alto de esas cosas... ¡la gente empezará a mirarnos raro...!"

# game/script.rpy:1895
translate es ch4_4e9876f6:

