    # p oh "Ah... sounds fulfilling."
    p oh "Ah... suena gratificante."

# game/script.rpy:509
translate es start_df636102:

    # w smile "What about you, Pastille? What kind of magic do you specialize in?"
    w smile "Qué hay de ti, Pastille? ¿En qué tipo de magia te especializas?"

# game/script.rpy:510
translate es start_acfb287e:

    # p shy "Oh, I... I had mostly been living without magic, until recently."
    p shy "Oh, yo... he estado viviendo principalmente sin magia, hasta hace poco."

# game/script.rpy:511
translate es start_ba1cda83:

    # w oh "Without magic...? I can't imagine."
    w oh "¿Sin magia...? No me lo puedo imaginar."

# game/script.rpy:512
translate es start_39cda655:

    # p smile "It's not so bad. I mean, humans do it, so why not?"
    p smile "No es tan malo. Quiero decir, los humanos lo hacen, ¿así que por qué no?"

# game/script.rpy:513
translate es start_1b160ca1:

    # w "I suppose that's true."
    w "Supongo que es verdad."

# game/script.rpy:514
