    p ehe "Aja, comprensible..."

# game/script.rpy:430
translate es start_1fb598dd:

    # w smile "Next, expectations. I consider clarity in this regard to be a key part of ensuring we both enjoy ourselves to the fullest."
    w smile "Segundo, expectativas. Considero que ser claros en este aspecto es fundamental para garantizar que ambos disfrutemos al máximo."

# game/script.rpy:431
translate es start_9ddac06c:

    # w "I do this sort of thing often, you see. As such, I have a couple of ground rules to establish."
    w "Verás, hago este tipo de cosas seguido. Por lo tanto, hay un par de reglas básicas que establezco."

# game/script.rpy:433
translate es start_d94542f4:

    # p smile "Sure. I'm actually glad you brought it up..."
    p smile "Claro. De hecho, me alegra que lo menciones..."

# game/script.rpy:434
translate es start_cb1d6efd:

    # w oh "Oh?"
    w oh "¿Oh?"

# game/script.rpy:435
translate es start_140c840a:

    # p ehe "I'm not looking for anything serious. In fact, I kinda prefer when it's just a one-night thing..."
    p ehe "No estoy buscando nada serio. De hecho, prefiero cuando es algo de una sola noche..."

# game/script.rpy:436
translate es start_4711c7fe:

