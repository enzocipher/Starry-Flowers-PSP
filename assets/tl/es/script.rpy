    # w calm "You've certainly changed your tune...."
    w calm "Parece que cambiaste de opinión...."

# game/script.rpy:2053
translate es ch4_d330e65c:

    # a happy "He's cute. I get a good vibe from him."
    a happy "Es lindo. Me transmite buenas vibraciones."

# game/script.rpy:2054
translate es ch4_f8e67399:

    # a lol2 "Anyway, bring him back in sometime so I can get this lamp fixed. Got it?"
    a lol2 "En todo caso, tráelo de vuelta en alguna ocasión para que pueda reparar este bombillo. ¿Entendido?"

# game/script.rpy:2055
translate es ch4_743dec44:

    # w happy "He won't be doing that!!"
    w happy "¡¡Él no hará eso!!"

# game/script.rpy:2056
translate es ch4_91bd044b:

    # a neutral "Seriously, though. Where I'm from, we were taught that you can tell a lot about a witch from their magic..."
    a neutral "Pero en serio. De donde vengo, se nos enseñaba que se puede saber mucho de un brujo por su magia."

# game/script.rpy:2057
translate es ch4_f2f55ac5:

    # a closed "And his? Very empathetic. Sincere, compassionate."
    a closed "¿Y de él? Muy empático. Sincero, compasivo."

# game/script.rpy:2058
translate es ch4_7019ca7c:

    # w love "Well, you aren't wrong, but... how can you judge that sort of thing after witnessing one little spell?"
    w love "Bueno, no te equivocas, pero... ¿cómo puedes juzgar ese tipo de cosas solo con presenciar un pequeño hechizo?"

# game/script.rpy:2059
translate es ch4_bd2d025d:

    # a lol "Ha, wouldn't YOU like to know?"
    a lol "Ja, ¿no te GUSTARÍA saberlo?"

# game/script.rpy:2060
translate es ch4_768d16f3:

    # w calm "Hmhm, I don't need your superstitions. I have a date to get back to."
    w calm "Hmhm, no necesito tus superticiones. Tengo una cita a la que regresar."

# game/script.rpy:2061
translate es ch4_dfa92959:

    # a smile "Heh, alright. Have fun, Periwinkle...."
    a smile "Heh, está bien. Diviértete, Periwinkle...."

# game/script.rpy:2062
translate es ch4_c2b45ec4:

    # w innocent "Oh, I very much intend to 💙"
    w innocent "Oh, eso es lo que pretendo 💙"

# game/script.rpy:2066
translate es ch4_7cd4194b:

    # n "Smiling to himself, Periwinkle strides confidently out the door to where Pastille is waiting."
    n "Con una sonrisa, Periwinkle se dirige a paso firme hacia la puerta donde Pastille le espera."

# game/script.rpy:2074
translate es ch4_d3b6758e:

    # p "Hey--um... do I still need to pay for that bottle?"
    p "Hey-um... ¿aún tengo que pagar por esa botella?"

# game/script.rpy:2075
translate es ch4_c189c5fa:

    # w date calm "She didn't mention it."
    w date calm "Ni siquiera lo mencionó."

# game/script.rpy:2076
translate es ch4_3e5dc9da:

    # p calm "Phew. I'm glad I could fix it... I was worried it might be expensive."
    p calm "Uf. Me alegra haber podido arreglarlo... me preocupaba que pudiera ser caro."

# game/script.rpy:2077
translate es ch4_b7aae312:

    # w smile "You never told me you were so good with magic. As I recall, you said you had been living without it?"
    w smile "Nunca me contaste que eras tan bueno con la magia. Si no recuerdo mal, ¿dijiste que estuviste viviendo sin ella?"

# game/script.rpy:2078
translate es ch4_ae7d5ce2:

    # p think "Yeah, mostly."
    p think "Sí, en su mayoría."

# game/script.rpy:2079
translate es ch4_d4e69b9f:

    # p ehe "I won't get into the reasons why... but I got back into studying it recently."
    p ehe "No me adentraré en las razones... pero volví a estudiarla recientemente."

# game/script.rpy:2080
translate es ch4_b20c986a:

    # w happy "Astragalus certainly thought you were talented. I'm impressed too, of course."
    w happy "Ciertamente Astragalus pensó que tenías talento. Yo también quedé impresionado, por supuesto."

# game/script.rpy:2081
translate es ch4_537846ba:

    # p shy "Th-thanks... haha, if only I could use magic to stop myself from being a klutz...."
    p shy "G-gracias... jaja, si tan solo pudiera usar magia para dejar de ser un torpe...."

# game/script.rpy:2082
translate es ch4_e7496cc5:

    # w teehee "Oh, are you embracing that nickname now?"
    w teehee "Oh, ¿ya estás aceptando ese apodo?"

# game/script.rpy:2083
translate es ch4_32e4b18b:

    # p scream "N-no!! Please go back to saying \"my sweet\"!!!" with vpunch
    p scream "¡¡N-no!! ¡¡¡Por favor vuelve a llamarme \"dulzura\"!!!" with vpunch

# game/script.rpy:2084
translate es ch4_e86c0674:

    # w love "Ah~ if you like that one so much, I suppose I have no choice! 💙"
    w love "Ah~ Si tanto te gusta ese, ¡supongo que no tengo otra opción! 💙"

# game/script.rpy:2085
translate es ch4_419d487f:

    # p omgstop "I-I... I just meant...!"
    p omgstop "¡Y-yo... solo quería decir...!"

# game/script.rpy:2086
translate es ch4_8c34b708:

    # p flustered "N-Nevermind!! Don't call me anything...!" with vpunch
    p flustered "¡¡O-olvídalo!! ¡No me llames de ninguna manera...!" with vpunch

# game/script.rpy:2087
translate es ch4_58252808:

    # w shy "Hmhmhm 💙 Oh, Pastille...."
    w shy "Hmhmhm 💙 Oh, Pastille...."

# game/script.rpy:2090
translate es ch4_5df76680:

    # "We resume our stroll around town..."
    "Retomamos nuestro paseo por la ciudad..."

# game/script.rpy:2091
translate es ch4_df4e55af:

    # "This time, it's Pastille who takes the lead. He seems to have someplace in mind, but hasn't said as much."
    "Esta vez, es Pastille quien nos dirige. Parece tener un lugar en mente, pero no ha dicho nada."

# game/script.rpy:2092
translate es ch4_5623091f:

    # "He merely takes my hand and leads me up a labyrinth of stairs..."
    "Solamente me toma de la mano y me lleva por un laberinto de escaleras..."

# game/script.rpy:2093
translate es ch4_76b2fe88_10:

    # nvl clear
    nvl clear

# game/script.rpy:2097
translate es ch4_fd97df8a:

    # "And once we reach the top..."
    "Y una vez que llegamos a la cima..."

# game/script.rpy:2098
translate es ch4_37819467:

    # "A gust of wind swoops through the trees overhead, showering us in flower petals."
    "Una ráfaga de viento atraviesa los árboles que hay sobre nosotros, bañándonos en pétalos de flores."

# game/script.rpy:2099
translate es ch4_af3d310d:

    # nvl clear
    # w date ah "Ah. Peach blossoms..."
    nvl clear
    w date ah "Ah. Flores de durazno..."

# game/script.rpy:2103
translate es ch4_bf824512:

    # p "It's nice, isn't it?"
    p "Es lindo, ¿no es así?"

# game/script.rpy:2104
translate es ch4_745730c3:

    # w love "Hmhm, I can't help but think you're trying to tell me something right now~"
    w love "Hmhm, no puedo evitar pensar que intentas decirme algo ahora mismo~"

# game/script.rpy:2105
translate es ch4_36d2e96b:

    # p oh "Huh...?"
    p oh "¿Huh...?"

# game/script.rpy:2106
translate es ch4_7daf2c79:

    # w smile "Don't you remember? My \"aphrodisiac\" was also peach-scented..."
    w smile "¿No lo recuerdas? Mi \"afrodisíaco\" también olía a durazno..."

# game/script.rpy:2107
translate es ch4_290ca16a:

    # p wha "Ah..."
    p wha "Ah..."

# game/script.rpy:2108
translate es ch4_d493bae3:

    # p kyaa "A-AH...! I WASN'T THINKING ABOUT THAT...!!!" with vpunch
    p kyaa "¡A-AH...! ¡¡¡NO ESTABA PENSANDO EN ESO...!!!" with vpunch

# game/script.rpy:2109
translate es ch4_d739c596:

    # p wow "I-I just, was trying to think of other places we could go, and this one came to mind..."
    p wow "S-solo, intentaba pensar en otros lugares a los que podríamos ir, y este se me vino a la mente..."

# game/script.rpy:2110
translate es ch4_eab2cf4c:

    # w happy "It's lovely. Very romantic 💙"
    w happy "Es encantador. Muy romántico 💙"

# game/script.rpy:2111
translate es ch4_2f1a8383:

    # w shy "(Straight out of a shoujo manga, honestly... how does he know I'm weak to such things?)"
    w shy "(Sacado de un manga shoujo, honestamente... ¿cómo supo que esas cosas son mi debilidad?)"

# game/script.rpy:2112
translate es ch4_9218331e:

    # p omg "We don't have to stay... I mean, we've already walked around so much--it's okay if you wanna head back now..."
    p omg "No tenemos que quedarnos... quiero decir, ya hemos caminado mucho--está bien si quieres regresar ahora..."

# game/script.rpy:2113
translate es ch4_18984878:

    # p omgstop "N-NOT TO... DO THINGS... I just meant...! I-I'm gonna stop talking......" with vpunch
    p omgstop "N-NO PARA... HACER COSAS... ¡Solo decía...! D-dejaré de hablar......" with vpunch

# game/script.rpy:2114
translate es ch4_6d760657:

    # w love "Pastille."
    w love "Pastille."

# game/script.rpy:2115
translate es ch4_7a8b97fb:

    # p seriously "Y-yes...?"
    p seriously "¿S-sí...?"

# game/script.rpy:2116
translate es ch4_ec1d1b34:

    # w calm "You've presented me quite the conundrum. If I kiss you now, you'll definitely want to return home with me as soon as possible..."
    w calm "Me presentaste un gran dilema. Si te beso ahora, definitivamente querrás que volvamos a casa lo antes posible..."

# game/script.rpy:2117
translate es ch4_80145f9c:

    # w happy "But I wasn't done learning all about you. I'm not ready for our date to end 💙"
    w happy "Pero no he terminado de aprender todo sobre ti. No estoy listo para que nuestra cita termine 💙"

# game/script.rpy:2118
translate es ch4_5974e4ff:

    # p embarrassed "O-oh... that IS a conundrum...."
    p embarrassed "O-oh... eso ES un dilema...."

# game/script.rpy:2119
translate es ch4_dbc74acd:

    # w love "Yes, you see? Both options are equally appealing. However can I decide~?"
    w love "Sí, ¿lo ves? Ambas opciones son igual de llamativas. ¿Cómo podría decidirme~?"

# game/script.rpy:2120
translate es ch4_ec2c6956:

    # p shy "Haha, um, well... i-it's still light out! Maybe we can hold back until after dinner...."
    p shy "Jaja, um, bueno... ¡a-aún es de día! Tal vez podamos aguantar hasta después de la cena...."

# game/script.rpy:2121
translate es ch4_584de9f1:

    # w teehee "Or I could have YOU for dinner 💙"
    w teehee "O podría tenerte a TI de cena 💙"

# game/script.rpy:2122
translate es ch4_31907a91:

    # p kyaa "A-AH...!" with vpunch
    p kyaa "¡A-AH...!" with vpunch

# game/script.rpy:2123
translate es ch4_f4a3afbc:

    # w calm "On the other hand, you bring up a valid point. Holding back is fun in itself."
    w calm "Por otro lado, tienes un buen punto. Aguantarse de por sí es divertido."

# game/script.rpy:2124
translate es ch4_9d41c26b:

    # p omgstop "Do you expect me to recover after what you just said...?!"
    p omgstop "¡¿Esperas que me recupere luego de lo que acabas de decir...?!"

# game/script.rpy:2125
translate es ch4_32adccf0:

    # w happy "See~? This IS quite fun!"
    w happy "¿Ves~? ¡Esto ES muy divertido!"

# game/script.rpy:2126
translate es ch4_b5263d43:

    # w calm "It's decided, then. The date continues."
    w calm "Está decidido, entonces. La cita continúa."

# game/script.rpy:2130
translate es ch4_98062818:

    # "I give Pastille a moment to calm himself."
    "Le doy a Pastille un momento para calmarse."

# game/script.rpy:2131
translate es ch4_43346300:

    # "We walk up to the railing and look out at the town..."
    "Nos acercamos a la barandilla y miramos la ciudad..."

# game/script.rpy:2132
translate es ch4_2e739e18:

    # nvl clear
    # "You can see Atelier Sweets from here. And the train station next to it."
    "Desde aquí se puede ver Atelier Sweets. Y la estación de tren que hay a su lado."

# game/script.rpy:2134
translate es ch4_65c0b220:

    # "My house is... somewhere in a row of similarly built homes. Inconspicuous."
    "Mi casa está... en algún lugar en una hilera de casas construidas de forma similar. Poco visible."
    nvl clear

# game/script.rpy:2135
translate es ch4_140deac1:

    # "Fallen petals litter the bricks at our feet, with every little breeze carrying a few more over the railing to land somewhere unknown."
    "Los pétalos caídos ensucian las baldosas a nuestros pies, y cada pequeña brisa se lleva algunos más por la barandilla para aterrizar en un paradero desconocido."

# game/script.rpy:2136
translate es ch4_9b3a7e5d:

    # "After watching them for a while, I turn back to Pastille."
    "Después de observarlos por un rato, me giro hacia Pastille."

# game/script.rpy:2137
translate es ch4_76b2fe88_11:

    # nvl clear
    nvl clear

# game/script.rpy:2140
translate es ch4_6319f667:

    # w date "Tell me about your magic."
    w date "Cuéntame sobre tu magia."

# game/script.rpy:2141
translate es ch4_81ee26b5:

    # p um "O-okay... what do you want to know?"
    p um "B-bien... ¿qué te gustaría saber?"

# game/script.rpy:2142
translate es ch4_c829cbee:

    # w innocent "Your specialty, dear!"
    w innocent "¡Tu especialidad, querido!"

# game/script.rpy:2143
translate es ch4_9847abef:

    # w smile "If you were that good at reconstruction, I imagine it must fall somewhere in that category...?"
    w smile "Si eres tan bueno en la reconstrucción, ¿imagino que debe entrar en esa categoría...?"

# game/script.rpy:2144
translate es ch4_b09961bf:

    # p ehe "Um, not really... I'm actually an astral witch."
    p ehe "Um, no realmente... en realidad soy un brujo astral."

# game/script.rpy:2145
translate es ch4_443121bc:

    # w my "My, how rare! And what exactly does that entail for you?"
    w my "¡Vaya, qué raro! ¿Y eso qué implica exactamente para ti?"

# game/script.rpy:2146
translate es ch4_44c2df3e:

    # p shy "Ahh, well, I mostly use it for fire spells, like anyone else..."
    p shy "Ahh, bueno, principalmente lo uso para hechizos de fuego, como todos los demás..."

# game/script.rpy:2147
translate es ch4_bcabe313:

    # w oh "Forgive me, I'm not well-versed in magic theory... but doesn't astral magic have something to do with creation?"
    w oh "Perdón, no estoy muy familiarizado con la teoría mágica... ¿pero la magia astral no tiene que ver con la creación?"

# game/script.rpy:2148
translate es ch4_ac2d501e:

    # p ehe2 "It does... but that stuff is pretty advanced. I haven't been able to find any books explaining how to use it."
    p ehe2 "Así es... pero eso es bastante avanzado. No he logrado encontrar ningún libro que explique como usarla."

# game/script.rpy:2149
translate es ch4_02f8bfe1:

    # p embarrassed "...Which is probably for the best, actually. No one should be allowed to go around creating souls spontaneously...!"
    p embarrassed "...Lo que probablemente es lo mejor, en realidad. ¡Nadie debería tener permitido ir por ahí creando almas como si nada...!"

# game/script.rpy:2150
translate es ch4_29508975:

    # w neutral "Hm..."
    w neutral "Hm..."

# game/script.rpy:2152
translate es ch4_1b5322bf:

    # "Pastille rubs the back of his neck, looking off into the distance."
    "Pastille se rasca la nuca, mirando en la distancia."

# game/script.rpy:2153
translate es ch4_309805fa:

    # "He seems so troubled by the subject..."
    "Parecía muy intranquilo con ese tema..."

# game/script.rpy:2154
translate es ch4_9604342e:

    # "I suppose because he had been living without magic, it may feel strange to openly discuss it?"
    "Supongo que como estuvo viviendo sin magia, ¿puede resultarle extraño hablar abiertamente de ella?"

# game/script.rpy:2155
translate es ch4_48123bf8:

    # nvl clear
    # "An astral witch, though... I wouldn't have guessed."
    nvl clear
    "Aunque un brujo astral... no lo hubiera adivinado."

# game/script.rpy:2157
translate es ch4_c8d56a68:

    # "Putting two and two together, ONE thing makes perfect sense now..."
    "Atando los cabos, UNA cosa cobra sentido ahora..."

# game/script.rpy:2158
translate es ch4_551942a5:

    # nvl clear
    # w ah "So the famous Atelier Sweets golem was YOUR creation?"
    nvl clear
    w ah "¿Así que la famosa golem de Atelier Sweets fue TU creación?"

# game/script.rpy:2161
translate es ch4_2c8fd31f:

    # p ehe2 "Haha, is she really that famous? I'd expect our sales to be a little better if that were the case..."
    p ehe2 "Jaja, ¿en serio es tan famosa? Esperaría que nuestras ventas fueran un poco mejores si ese fuera el caso..."

# game/script.rpy:2162
translate es ch4_fd97e90a:

    # p flustered2 "But... yeah. Just don't go around telling everyone--I didn't know what I was doing when I made her."
    p flustered2 "Pero... sí. Solo no vayas por ahí contándole a todo el mundo--no sabía lo que estaba haciendo cuando la creé."

# game/script.rpy:2163
translate es ch4_e7fb158c:

    # w my "What an amazing feat... and yet you sound almost ashamed of it!"
    w my "Qué hazaña tan asombrosa... ¡y sin embargo suenas casi avergonzado de ello!"

# game/script.rpy:2164
translate es ch4_0bf92251:

    # p ohno "I-it's not like I regret it or anything... Gumdrop is really great! I just..."
    p ohno "N-no es que me arrepienta ni nada... ¡Gumdrop es realmente genial! Es solo..."

# game/script.rpy:2165
translate es ch4_2ed99bc8:

    # p nervous "I feel bad that she's stuck in a body with so many limitations. Like, she didn't ask to be made that way..."
    p nervous "Me siento mal de que esté atrapada en un cuerpo con tantas limitaciones. O sea, ella no pidió ser hecha de esa manera..."

# game/script.rpy:2166
translate es ch4_8694e630:

    # p flustered2 "I didn't know you could even make golems that felt real emotions, so of course I never considered any of that."
    p flustered2 "No sabía que se podían hacer golems con emociones reales, así que claramente no consideré nada de eso."

# game/script.rpy:2167
translate es ch4_cde66f06:

    # p shy "...Sorry to go off about it. I-I've just been feeling guilty lately--kind of a heavy topic."
    p shy "...Perdón por seguir con el tema. M-me he sentido culpable últimamente--es como un tema pesado."

# game/script.rpy:2168
translate es ch4_9931704c:

    # w ah "No, no... thank you for telling me."
    w ah "No, no... gracias por contármelo."

# game/script.rpy:2169
translate es ch4_b7df5332:

    # w calm "It's as if I've discovered a whole new side of you today. I'm grateful to know it."
    w calm "Es como si hubiera descubierto un lado completamente nuevo de ti hoy. Agradezco conocerlo."

# game/script.rpy:2170
translate es ch4_d2da19ee:

    # p ehe "Thanks for listening... I don't get many chances to talk about things like this, so I'm grateful for it, too."
    p ehe "Gracias por escuchar... no tengo tantas oportunidades de hablar de cosas como esta, así que también lo agradezco."

# game/script.rpy:2171
translate es ch4_2f822c09:

    # w love "Hmhm, hearing you speak of her though, I'd love to meet this golem of yours one day."
    w love "Hmhm, aunque al oírte hablar sobre ella, me encantaría conocer a esa golem tuya algún día."

# game/script.rpy:2172
translate es ch4_87960f32:

    # p sure "Sure. Maybe one day."
    p sure "Seguro. Tal vez algún día."

# game/script.rpy:2175
translate es ch4_e955de1d:

    # "Pastille is amazing."
    "Pastille es increíble."

# game/script.rpy:2176
translate es ch4_dd1b4e98:

    # "I've never met anyone who would downplay their talents this much--I could ask a thousand questions and still only scratch the surface..."
    "Nunca había conocido a alguien que minimizara tanto sus talentos--podría hacer miles de preguntar y seguiría solo rozando la superficie..."

# game/script.rpy:2177
translate es ch4_034046bb:

    # "My, now I'M the insatiable one. How the tables have turned!"
    "Vaya, ahora YO soy el insaciable. ¡Cómo han cambiado las cosas!"

# game/script.rpy:2178
translate es ch4_aa528040:

    # nvl clear
    # "We decide it's time to move on, and descend the stairs from whence we came..."
    nvl clear
    "Decidimos que es hora de irnos, y bajamos las escaleras de donde vinimos..."

# game/script.rpy:2180
translate es ch4_5310cd5c:

    # "...Still chatting endlessly as we decide where we'll wander to next."
    "...Seguimos charlando sin parar mientras decidimos a qué lugar nos dirigiremos."

# game/script.rpy:2181
translate es ch4_76b2fe88_12:

    # nvl clear
    nvl clear

# game/script.rpy:2184
translate es ch4_ab4f864b:

    # "Over dinner, Pastille opens up a little more."
    "Durante la cena, Pastille se abre un poco más."

# game/script.rpy:2185
translate es ch4_2a1a4890:

    # "We trade anecdotes, listening intently to each others' stories no matter how unremarkable the events told within them."
    "Intercambiamos anécdotas, escuchando atentamente las historias del otro, sin importar cuán irrelevantes sean los hechos contados en ellas."

# game/script.rpy:2186
translate es ch4_a504ab29:

    # "I could never tire of it~ I was hooked by his every word."
    "Nunca me cansaría de esto~ Me atrapaba cada una de sus palabras."

# game/script.rpy:2187
translate es ch4_efbe6e4c:

    # nvl clear
    # "Alas, the hours flew by, and our day together was quickly approaching its end..."
    nvl clear
    "Por desgracia, las horas pasaron volando, y nuestro día juntos rápidamente se acercaba a su fin..."

# game/script.rpy:2189
translate es ch4_d04a4349:

    # "But now we had the whole night to look forward to 💙"
    "Pero teníamos toda la noche por delante 💙"

# game/script.rpy:2190
translate es ch4_b7200d05:

    # "The sun was on its way down as we emerged back onto the street, the atmosphere so different than it had been just a short while ago."
    "El sol estaba descendiendo cuando regresamos a la calle, el ambiente era muy distinto al de hace un rato."

# game/script.rpy:2191
translate es ch4_d4905e0a:

    # "Pastille brushes his bangs aside and asks..."
    "Pastille se aparta el flequillo y pregunta..."

# game/script.rpy:2192
translate es ch4_76b2fe88_13:

    # nvl clear
    nvl clear

# game/script.rpy:2194
translate es ch4_b2bdea1d:

    # p "Do you wanna head back? It's starting to get late...."
    p "¿Quieres regresar? Se está haciendo tarde..."

# game/script.rpy:2195
translate es ch4_843a037d:

    # w date shy "Hmhm, you've waited so patiently to be able to say that."
    w date shy "Hmhm, esperaste tan pacientemente para poder decir eso."

# game/script.rpy:2196
translate es ch4_8b799080:

    # p embarrassed "I-it's not like you aren't thinking of it too..."
    p embarrassed "N-no es como si no estuvieras pensando en ello también..."

