    # "What a lovely day for a date 💙"
    "Qué hermoso día para una cita 💙"

# game/script.rpy:1791
translate es ch4_1b84dc6c:

    # "We walk side by side, Pastille with his hands stuffed into oversized pockets. So cute..."
    "Caminamos uno junto al otro, Pastille ocultando sus manos dentro de sus grandes bolsillos. Tan lindo..."

# game/script.rpy:1792
translate es ch4_2b607e30:

    # "He's in the perfect position to be clinged to~ But, I must refrain."
    "Está en la posición perfecta para abrazarle~ Pero debo de abstenerme."

# game/script.rpy:1793
translate es ch4_6a692108:

    # "I doubt he'd be comfortable with me hanging all over him in broad daylight. Besides, there's no need to jump into such overt affections just yet."
    "Dudo que se sienta cómodo conmigo abrazándole a plena luz del día. Además, no hay necesidad de pasar a afectos en público aún."

# game/script.rpy:1794
translate es ch4_76b2fe88_2:

    # nvl clear
    nvl clear

# game/script.rpy:1801
translate es ch4_b6217edd:

    # "When we reach the café, Pastille orders us some doughnuts to share."
    "Cuando llegamos al café, Pastille pide unas donas para compartir."

# game/script.rpy:1802
translate es ch4_f8a53225:

    # "I wonder what else he has planned...?"
    "Me pregunto, ¿qué más tiene planeado...?"

# game/script.rpy:1803
translate es ch4_d90128ed:

    # "He only mentioned hanging out--who knows what that could entail~?"
    "Solo mencionó salir--¿Quién sabe lo que eso podría implicar~?"

# game/script.rpy:1804
translate es ch4_98bb6b9f:

    # "Munching away at our breakfast, I study his face for clues..."
    "Mientras comemos nuestro desayuno, analizo su rostro en busca de pistas..."

# game/script.rpy:1805
translate es ch4_76b2fe88_3:

    # nvl clear
    nvl clear

# game/script.rpy:1807
translate es ch4_4e7d5c55:

    # "He really is so cute."
    "Es realmente muy lindo."

# game/script.rpy:1808
translate es ch4_adc44e53:

    # "I remember the choker. He wore it on our first date as well 💙"
    "Me acuerdo de ese collar. También lo llevaba puesto en nuestra primera cita 💙"

# game/script.rpy:1810
translate es ch4_1e8c7e1f:

    # "And that's the same barrette he left behind after one of our sleepovers~ Such pointed choice in accessories..."
    "Y ese es el mismo pasador que dejó tras una de nuestras noches juntos~ Una elección tan indicada de accesorios..."

# game/script.rpy:1812
translate es ch4_1fd546cf:

    # "Ah, and now all my staring has embarrassed him. You're too easily flustered, my sweet 💙"
    "Ah, y ahora se avergonzó de tanto mirarlo. Te pones nervioso tan fácilmente, dulzura 💙"

# game/script.rpy:1813
translate es ch4_0f78683c:

    # nvl clear
    # w date "Forgive me for staring; I was trying to intuit what you might have planned for us after this."
    nvl clear
    w date "Perdón por quedarme mirándote; intentaba descifrar lo que podrías estar planeando para hacer después de esto."

# game/script.rpy:1815
translate es ch4_bbf68c72:

    # p ehe "Oh, um, nothing in particular... wandering around town is enough for me."
    p ehe "Oh, um... nada en particular... caminar por la ciudad es suficiente para mí."

# game/script.rpy:1816
translate es ch4_0455f80a:

    # w calm "I see 💙 Loitering does facilitate conversation quite well."
    w calm "Ya veo 💙 Deambular facilita bastante la conversación."

# game/script.rpy:1817
translate es ch4_39f199d8:

