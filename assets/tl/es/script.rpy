    # nvl clear
    # n "Periwinkle takes his plate to the sink and begins to wash up."
    nvl clear
    n "Periwinkle lleva su plato al fregadero y empieza a lavarlo."

# game/script.rpy:3283
translate es ch6_3e0f9893:

    # p wha "Ah--I can take care of that!"
    p wha "Ah--¡Yo me puedo encargar de eso!"

# game/script.rpy:3284
translate es ch6_e738bebe:

    # w love "Nonsense, you just cooked us dinner! It's your turn to relax, my sweet 💙"
    w love "¡Tonterías, tú preparaste la cena! Es tu turno de relajarte, dulzura 💙"

# game/script.rpy:3285
translate es ch6_56c4b6d1:

    # p shy "Are you sure I can't help...? I wouldn't mind at all...."
    p shy "¿Seguro que no puedo ayudar...? No me importaría en absoluto...."

# game/script.rpy:3286
translate es ch6_bc36cfb7:

    # w calm "You can help by bringing me your plate when you're finished."
    w calm "Puedes ayudar trayendo tu plato cuando hayas terminado."

# game/script.rpy:3287
translate es ch6_c83acea9:

    # p ehe "Okaaay...."
    p ehe "Bueeeno...."

# game/script.rpy:3290
translate es ch6_4911fe5a:

    # n "Pastille does as he's told, then wanders over to the couch."
    n "Pastille hace lo que le dijo, y luego se dirige al sofá."

# game/script.rpy:3293
translate es ch6_e34ed609:

    # p "Hey, um..."
    p "Hey, um..."

# game/script.rpy:3294
translate es ch6_fe1d1ce2:

    # p "If you have anyone you want to introduce me to, I'd be happy to meet them. Return the favor, sort of thing."
    p "Si hay alguien a quien quieras presentarme, estaré encantado de conocerle. Para devolver el favor, por así decirlo."

# game/script.rpy:3296
translate es ch6_bbf226dc:

    # p "I-I know it can be awkward though, so... if not, that's okay too...."
    p "A-aunque sé que puede ser incómodo, así que... si no, tampoco pasa nada...."

# game/script.rpy:3297
translate es ch6_6753e7b3:

    # w "Hm... no, no one comes to mind."
    w "Hm... no, nadie se me viene a la mente."

# game/script.rpy:3298
translate es ch6_a367466f:

    # p "...Huh? Really?"
    p "¿...Huh? ¿De verdad?"

# game/script.rpy:3299
translate es ch6_6e2dd70d:

    # w "Sure, I know a lot of people. But I couldn't say I'm particularly close with any of them..."
    w "Seguro, conozco un montón de gente. Pero no podría decir que soy cercano a alguno de ellos en particular..."

# game/script.rpy:3301
translate es ch6_8585d2d5:

    # w "Except maybe one? But you've already met my business partner."
    w "¿Puede que excepto alguien? Pero ya conociste a mi compañera de negocios."

# game/script.rpy:3302
translate es ch6_0aad42dd:

    # p "Oh! At the apothecary, right?"
    p "¡Oh! En la botica, ¿verdad?"

# game/script.rpy:3304
translate es ch6_05485f5a:

    # w "Precisely."
    w "Precisamente."

# game/script.rpy:3305
translate es ch6_d5c67421_1:

    # p "...."
    p "...."

# game/script.rpy:3307
translate es ch6_01f6d082:

    # w "Hm~? What's with that look."
    w "¿Hm~? A qué viene esa mirada."

# game/script.rpy:3309
translate es ch6_c50b5f2b:

    # p "N-no, nothing... I just don't know what to say now."
    p "N-no, nada... solo no sabía qué decir."

# game/script.rpy:3310
translate es ch6_1af14dea:

    # w "Hmhm, you expected someone as charismatic as me to have all sorts of new people to introduce you to, then?"
    w "Hmhm, ¿esperabas que alguien tan carismático como yo tuviera todo tipo de gente nueva a la que presentarte?"

# game/script.rpy:3311
translate es ch6_9e2f690d:

    # p "I guess so. I'm just surprised..."
    p "Supongo que sí. Solo estoy sorprendido..."

# game/script.rpy:3312
translate es ch6_e3fe1cd7:

    # p "I, um, really like... being around you... so I expected that to be true for your other friends, too."
    p "A mí, um, me gusta mucho... estar contigo... así que esperaba que también fuera así para tus otros amigos."

# game/script.rpy:3313
translate es ch6_81608c29:

    # w "Hmm..."
    w "Hmm..."

# game/script.rpy:3315
translate es ch6_04156cdb:

    # w "I'd say you're probably the closest I've ever been with someone."
    w "Diría que probablemente eres la persona a la que más me he acercado."

# game/script.rpy:3316
translate es ch6_291e005a:

    # w "...Literally speaking."
    w "...Literalmente hablando."

# game/script.rpy:3320
translate es ch6_ba9915e5:

    # n "They laugh together, then fall into a comfortable silence..."
    n "Ríen juntos, y acaban en un cómodo silencio..."

# game/script.rpy:3321
translate es ch6_34bec6e3:

    # n "With their heads leaned together, Periwinkle nuzzles his face into Pastille's shoulder affectionately."
    n "Con sus cabezas juntas, Periwinkle acaricia su rostro cariñosamente en el hombro de Pastille."

# game/script.rpy:3322
translate es ch6_7680a727:

    # n "After a few moments, Pastille asks..."
    n "Luego de unos minutos, Pastille pregunta..."

# game/script.rpy:3325
translate es ch6_7e4e52b8:

    # p "Do you... wanna get in bed?"
    p "¿Quieres... ir a la cama?"

# game/script.rpy:3326
translate es ch6_08b40548:

    # w shutin teehee "For sleep, or for pleasure?"
    w shutin teehee "¿Para dormir, o por diversión?"

# game/script.rpy:3327
translate es ch6_275c3be8:

    # p omg "U-um, that's up to you...!" with vpunch
    p omg "¡U-um, eso depende de ti...!" with vpunch

# game/script.rpy:3329
translate es ch6_1609c48e:

    # n "Periwinkle stands, then turns around to take Pastille's hands."
    n "Periwinkle se levanta, y se da la vuelta para tomar las manos de Pastille."

# game/script.rpy:3330
translate es ch6_a6d0b21a:

    # w shutin "Come, then."
    w shutin "Ven, entonces."

# game/script.rpy:3335
translate es ch6_e0c4b6a5:

    # n "He leads him into the bedroom, closing the door behind them."
    n "Lo lleva a su habitación, cerrando la puerta a sus espaldas."

# game/script.rpy:3336
translate es ch6_17bd39fe:

    # n "When he does, Pastille speaks up again..."
    n "Al hacerlo, Pastille vuelve a hablar..."

# game/script.rpy:3339
translate es ch6_90e29b25:

    # p "You know... I'm still finding it hard to believe there's no one else you're close to."
    p "Sabes... aún me cuesta creer que no hay nadie más a quien seas cercano."

# game/script.rpy:3340
translate es ch6_25de1dd0:

    # w shutin "Hm~? Two is a reasonable number."
    w shutin "¿Hm~? Dos es un número razonable."

# game/script.rpy:3341
translate es ch6_48ef453d:

    # w calm "You had two friends as well, did you not? Syrup and Gumdrop."
    w calm "Tú tienes dos amigas también, ¿no es así? Syrup y Gumdrop."

# game/script.rpy:3342
translate es ch6_dcd034df:

    # p sure "Fair point... but counting YOU makes three."
    p sure "Buen punto... pero contándote a TI son tres."

# game/script.rpy:3343
translate es ch6_1da53c55:

    # w love "Ah, you have me beat. Perhaps I should try harder to catch up."
    w love "Ah, me ganaste. Tal vez debería esforzarme más para alcanzarte."

# game/script.rpy:3346
translate es ch6_c5a565be:

    # n "Periwinkle collapses into bed, while Pastille sits down beside him."
    n "Periwinkle se echa en la cama, mientras que Pastille se sienta a su lado."

# game/script.rpy:3349
translate es ch6_85981fc3:

    # w "I think I've preferred it, though. Keeping a healthy distance from others..."
    w "Aunque creo que lo he preferido así. Mantener una distancia sana de los demás..."

# game/script.rpy:3350
translate es ch6_43989462:

    # p "Really? How come?"
    p "¿En serio? ¿Por qué?"

# game/script.rpy:3351
translate es ch6_a40f3b27:

    # w "The alternative has been disastrous in my experience. I'm far too intense."
    w "La otra opción en mi experiencia ha sido desastrosa. Soy demasiado intenso."

# game/script.rpy:3352
translate es ch6_c4dfb99a:

    # p "Ha, what do you mean by THAT...?"
    p "Ja, ¿qué quieres decir con ESO...?"

# game/script.rpy:3353
translate es ch6_d85fd387:

    # w "Goodness, my best example is the worst one..."
    w "Santo cielo, mi mejor ejemplo es el peor..."

# game/script.rpy:3355
translate es ch6_0c4b9b3e:

    # w "In my teenage years... there was a boy I would've done anything for."
    w "En mi adolescencia... había un chico por el que hubiera hecho lo que sea."

# game/script.rpy:3356
translate es ch6_567cfdcb:

    # w "I wanted his approval so badly. I wanted to be loved."
    w "Deseaba desesperadamente su aprobación. Quería ser amado."

# game/script.rpy:3357
translate es ch6_53f3ef0f:

    # w "...It's funny, I can't even think of what drew me to him."
    w "...Es gracioso, ni siquiera puedo pensar en lo que me llamó la atención de él."

# game/script.rpy:3359
translate es ch6_b214fa05:

    # w "I suppose he was just a vessel to project onto. An idealized boyfriend, this... shortcut to happiness."
    w "Supongo que solo era un medio en el qué proyectarse. Un novio idealizado, un... atajo a la felicidad."

# game/script.rpy:3360
translate es ch6_1201679b:

    # w "Hmhm... poor guy. He didn't know what to do with the torrent of feelings I'd been forcing onto him. We were young."
    w "Hmhm... pobre chico. No supo qué hacer con el torrente de sentimientos que le estaba imponiendo. Éramos jóvenes."

# game/script.rpy:3361
translate es ch6_7ae36a53:

    # w "A love like that is much too painful. If it can even be called love...."
    w "Un amor así es demasiado doloroso. Si es que se le puede llamar amor...."

# game/script.rpy:3363
translate es ch6_4235f80c:

    # w "It took some practice to be able to separate the emotions out."
    w "Llevó algo de práctica poder separar esas emociones."

# game/script.rpy:3364
translate es ch6_094487a5:

    # w "To be able to indulge in the romantic and sexual energy I craved, while protecting my fragile heart..."
    w "Para poder disfrutar de la energía romántica y sexual que anhelaba, mientras protegía mi frágil corazón..."

# game/script.rpy:3365
translate es ch6_c9592a6d:

    # w "But, ever since I figured it out, I've gotten to experience all sorts of love through these casual flings~"
    w "Pero, desde que lo resolví, he logrado experimentar todo tipo de amor mediante estos encuentros casuales~"

# game/script.rpy:3366
translate es ch6_bd22f0ce:

    # w "(What am I saying...?)"
    w "(¿Qué estoy diciendo...?)"

# game/script.rpy:3367
translate es ch6_b87e6b7a:

    # w "It's perfect for me 💙 The ideal life, really."
    w "Es perfecto para mí 💙 La vida ideal, realmente."

# game/script.rpy:3368
translate es ch6_694c6d8c:

    # w "(Don't listen to me, Pastille....)"
    w "(No me escuches, Pastille....)"

# game/script.rpy:3373
translate es ch6_a29244df:

    # p "Hmm..."
    p "Hmm..."

# game/script.rpy:3374
translate es ch6_884754a7:

    # p smile "I don't know if your heart is as fragile as you think."
    p smile "No sé si tu corazón sea tan frágil como piensas."

# game/script.rpy:3375
translate es ch6_cb22988c:

    # w shutin love "You don't believe me? Despite what it seems, I have the heart of an innocent maiden~!"
    w shutin love "¿No me crees? ¡A pesar de lo que aparento, tengo el corazón de un doncel inocente~!"

# game/script.rpy:3376
translate es ch6_1dece50f:

    # p sure "Haha, I don't know about innocent, but..."
    p sure "Jaja, no sé si inocente, pero..."

# game/script.rpy:3380
translate es ch6_ea6c8d9d:

    # n "Pastille leans forward and lays his head on Periwinkle's chest."
    n "Pastille se inclina hacia adelante y apoya su cabeza en el pecho de Pastille."

# game/script.rpy:3381
translate es ch6_192176bb:

    # p "...Sounds pretty strong to me."
    p "...Para mí suena bastante fuerte."

# game/script.rpy:3382
translate es ch6_075d682d:

    # w "...!!"
    w "¡¡...!!"

# game/script.rpy:3384
translate es ch6_77261c10:

    # p "Ah, it's beating harder now."
    p "Ah, ahora late más fuerte."

# game/script.rpy:3386
translate es ch6_51fe2183:

    # w "B-because you suddenly embraced me! See, this is what I mean by fragile...!" with vpunch
    w "¡P-porque te acercaste de la nada! ¡Ves, a esto me refiero con que es frágil...!" with vpunch

# game/script.rpy:3389
translate es ch6_afbec36c:

    # n "Periwinkle struggles out from under him, and the pair sits facing each other on the bed."
    n "Periwinkle escapa de él, y la pareja se sienta frente a frente en la cama."

# game/script.rpy:3392
translate es ch6_f8a67d56:

    # p "You know... at first, I thought romantic stuff was just a formality for you. But you actually love it, huh?"
    p "Sabes... al principio, pensaba que las cosas románticas eran solo una formalidad para ti. Pero en realidad te encanta, ¿huh?"

# game/script.rpy:3393
translate es ch6_9c15c768:

    # w shutin love "Are you only realizing that NOW?"
    w shutin love "¿Te das cuenta AHORA?"

# game/script.rpy:3394
translate es ch6_35b3829b:

    # p ehe "Haha, I guess not...."
    p ehe "Jaja, supongo que no...."

# game/script.rpy:3398
translate es ch6_d170010a:

    # "What are you trying to say, Pastille?"
    "¿Qué intentas decir, Pastille?"

# game/script.rpy:3399
translate es ch6_736befba:

    # "That it's okay for me to love you...?"
    "¿Que está bien que te ame...?"

# game/script.rpy:3400
translate es ch6_310f8fb1:

    # "That I'll be safe?"
    "¿Que estaré a salvo?"

# game/script.rpy:3401
translate es ch6_76b2fe88_9:

    # nvl clear
    nvl clear

# game/script.rpy:3404
translate es ch6_94871324:

    # w "Then, hurry up and kiss me."
    w "Entonces, date prisa y bésame."

# game/script.rpy:3406
translate es ch6_4a8350ae:

    # p "Okay ❤ Sorry to keep you waiting."
    p "Bien ❤ Siento hacerte esperar."

# game/script.rpy:3408
translate es ch6_d66b3318:

    # n "Pastille closes the distance between them..."
    n "Pastille cierra la distancia entre ellos..."

# game/script.rpy:3409
translate es ch6_54a35ace:

    # "I'm too weak."
    "Soy demasiado débil."

# game/script.rpy:3410
translate es ch6_139334f1:

    # "The words won't come out..."
    "Las palabras no me saldrán..."

# game/script.rpy:3411
translate es ch6_76b2fe88_10:

    # nvl clear
    nvl clear

# game/script.rpy:3413
translate es ch6_0f7e6da5:

    # n "As they kiss, Periwinkle becomes more and more entangled in his thoughts..."
    n "Mientras se besan, Periwinkle se enreda más y más en sus pensamientos..."

# game/script.rpy:3414
translate es ch6_f42e65a6:

    # "Ahh, it hurts...!"
    "¡Ahh, me lastima...!"

# game/script.rpy:3415
translate es ch6_d63ae36a:

    # "I want to be even closer...."
    "Quiero estar aún más cerca...."

# game/script.rpy:3416
translate es ch6_76b2fe88_11:

    # nvl clear
    nvl clear

# game/script.rpy:3418
translate es ch6_341a3f02:

    # n "He lets himself fall backward, bringing Pastille down with him."
    n "Se deja caer hacia atrás, llevando a Pastille con él."

# game/script.rpy:3419
translate es ch6_443d47e5:

    # "This isn't nearly enough to satisfy me..."
    "Esto no es suficiente para satisfacerme..."

# game/script.rpy:3420
translate es ch6_c8df87cf:

    # "Just, please, don't stop...."
    "Solo, por favor, no pares...."

# game/script.rpy:3421
translate es ch6_76b2fe88_12:

    # nvl clear
    nvl clear

# game/script.rpy:3425
translate es ch6_cb671a59:

    # n "Periwinkle's heart cried out..."
    n "El corazón de Periwinkle gritó..."

# game/script.rpy:3426
translate es ch6_a66018f1:

    # n "His jumbled emotions caught in his throat, manifesting through his hands, clinging desperately to Pastille..."
    n "{size=-2}Sus confusas emociones se atoran en su garganta, manifestándose a través de sus manos, aferrándose desesperadamente a Pastille...{/size}"

# game/script.rpy:3427
translate es ch6_5f6ba41c:

    # n "...who continued to kiss him and hold him through the night."
    n "...quien continuó besándolo y abrazándolo a lo largo de la noche."

# game/script.rpy:3438
translate es ch7_7b49a2da:

    # centered "{w=3}{nw}"
    centered "{w=3}{nw}"

# game/script.rpy:3443
translate es ch7_6f509ab8:

    # n "The next morning, Periwinkle steps out onto his doorstep with a heavy sigh."
    n "A la mañana siguiente, Periwinkle sale por la puerta con un profundo suspiro."

# game/script.rpy:3445
translate es ch7_a6ad8caa:

    # w hood empty "(If I lay around in bed all day, I'll only feel more miserable...)"
    w hood empty "(Si me quedo en cama todo el día, solo me sentiré más miserable...)"

# game/script.rpy:3446
translate es ch7_bfb25d37:

    # w oops "(I need to stop avoiding my work. I have to talk to Astragalus....)"
    w oops "(Debo dejar de evadir mi trabajo. Tengo que hablar con Astragalus....)"

# game/script.rpy:3447
translate es ch7_3eb69f61:

    # w empty "(She isn't going to be pleased with me though....)"
    w empty "(Aunque no va a estar contenta conmigo....)"

# game/script.rpy:3449
translate es ch7_c0771f75:

    # n "Holding his mantle tightly, he makes his way to the apothecary..."
    n "Sujetando firmemente su manto, se dirige a la botica..."

# game/script.rpy:3457
translate es ch7_ec45006e:

    # n "When he arrives, Astragalus is preoccupied with arranging some of her merchandise."
    n "Cuando llega, Astragalus está ocupada ordenando algunos de sus productos."

# game/script.rpy:3458
translate es ch7_2eb737f5:

    # n "She turns abruptly at the unexpected sound of the door's chime."
    n "Se gira bruscamente ante el inesperado sonido del timbre de la puerta."

# game/script.rpy:3461
translate es ch7_23102229:

    # a augh "Hey, we're not open yet--!" with vpunch
    a augh "¡Oiga, aún no abrimos--!" with vpunch

# game/script.rpy:3463
translate es ch7_21ae3d6f:

    # a hm "...Huh? Periwinkle?"
    a hm "¿...Huh? ¿Periwinkle?"

# game/script.rpy:3464
translate es ch7_0cfdf83c:

    # w hood decline "Good morning, Astragalus."
    w hood decline "Buenos días, Astragalus."

# game/script.rpy:3465
translate es ch7_ca42047f:

    # a uh "I haven't seen you all month--I barely recognized you under that hood!"
    a uh "Hace un mes que no te veo--¡apenas te reconocí bajo esa capucha!"

# game/script.rpy:3466
translate es ch7_a59d0c89:

    # a augh "I was about to come and knock on your damn door if you didn't show your face here soon. You've got a huge backlog of orders waiting!"
    a augh "Estaba a punto de ir y tocar tu maldita puerta si no te presentabas aquí pronto. ¡Tienes muchos pedidos pendientes acumulados!"

# game/script.rpy:3467
translate es ch7_6328fc6a:

    # w empty "...I can't take them. My magic is useless."
    w empty "...No puedo hacerlos. Mi magia es inútil."

# game/script.rpy:3468
translate es ch7_709a7b6c:

    # a uh "Whaddaya mean, \"useless\"?"
    a uh "¿Qué quieres decir con \"inútil\"?"

# game/script.rpy:3469
translate es ch7_78308c9b:

    # n "Periwinkle meekly hands over one of his pale pink vials."
    n "Periwinkle entrega resignadamente uno de sus frascos color rosa claro."

# game/script.rpy:3470
translate es ch7_e6a68b87:

    # w ohhh "This is all I can make... it's been this way for ages."
    w ohhh "Esto es todo lo que puedo hacer... lleva así desde hace siglos."

# game/script.rpy:3471
translate es ch7_c42de9e7:

    # a whatever "*sigh* Let's see..."
    a whatever "*suspiro* Veamos..."

# game/script.rpy:3472
translate es ch7_60a7f254:

    # n "Astragalus unscrews the top, and eyes Periwinkle suspiciously before giving it a whiff..."
    n "Astragalus desenrosca la tapa, y mira a Periwinkle con desconfianza antes de olerlo..."

# game/script.rpy:3473
translate es ch7_0d690c65:

    # a uh "Whew, that's powerful!!" with vpunch
    a uh "¡¡Uff, esto es potente!!" with vpunch

# game/script.rpy:3474
translate es ch7_2b253749:

    # a think "Not bad, though... warms me right up. Could stand to be diluted a little, just to make it less overwhelming..."
    a think "Aunque no está mal... me acalora de inmediato. Podría ser diluido un poco, solo para hacerlo menos abrumador..."

# game/script.rpy:3475
translate es ch7_40f53860:

    # a lol "So. What's got you stuck on a scent like this?"
    a lol "Entonces. ¿Qué es lo que te tiene atascado en un perfume como este?"

# game/script.rpy:3476
translate es ch7_de42c61a:

    # w ohhh2 "...It's Pastille...."
    w ohhh2 "...Es Pastille...."

# game/script.rpy:3477
translate es ch7_0381a0e1:

    # w whine2 "He's ruined me! I'll never be able to return to the way I was before...!"
    w whine2 "¡Él me arruinó! ¡Nunca podré volver a ser como antes...!"

# game/script.rpy:3478
translate es ch7_4bd0f1d4:

    # a closed "I see. So things got complicated, just like I warned you."
    a closed "Ya veo. Así que las cosas se complicaron, justo como te lo advertí."

# game/script.rpy:3479
translate es ch7_1fb3e795:

    # w cwy "Mhm... *sniffle*..."
    w cwy "Mhm... *sollozo*..."

# game/script.rpy:3480
translate es ch7_6be39aa2:

    # w cwy2 "I-I love him so much, I think I might die...."
    w cwy2 "L-lo amo demasiado, creo que podría morir...."

# game/script.rpy:3481
translate es ch7_48204255:

    # a neutral "Come on... Back room. Now."
    a neutral "Vamos... a la trastienda. Ahora."

# game/script.rpy:3485
translate es ch7_7d77e570:

    # n "Periwinkle nods and obediently follows Astragalus into her private office..."
    n "Periwinkle asiente y sigue obedientemente a Astragalus a su oficina privada..."

# game/script.rpy:3490
translate es ch7_1be0328f:

    # n "He quietly takes in his surroundings before she suddenly turns to him with a raised finger."
    n "Observa su alrededor en silencio antes de que de repente ella se dirija a él con un dedo levantado."

# game/script.rpy:3492
translate es ch7_170b612d:

    # a "Don't touch anything."
    a "No toques nada."

# game/script.rpy:3493
translate es ch7_90a8c977:

    # w hood ohhh "...?"
    w hood ohhh "¿...?"

# game/script.rpy:3495
translate es ch7_020bb483:

    # n "Astragalus drags a bean bag chair out from the corner and plops it in the middle of the room unceremoniously."
    n "Astragalus arrastra un puff de la esquina y lo tira bruscamente en el centro de la habitación."

# game/script.rpy:3497
translate es ch7_507ec09a:

    # a "Sit."
    a "Siéntate."

# game/script.rpy:3498
translate es ch7_e6ea4d0e:

    # w hood ohhh "...It's dusty...."
    w hood ohhh "...Está polvoriento..."

# game/script.rpy:3499
translate es ch7_44201857:

    # a augh "UGH, you're such a diva..."
    a augh "UGH, eres un divo..."

# game/script.rpy:3500
translate es ch7_c4c193b3:

    # n "She gives it a couple good smacks, beating the dust into the air instead."
    n "Le da un buen par de golpes, sacudiendo el polvo en el aire."

# game/script.rpy:3501
translate es ch7_c411bd45:

    # a annoyed "...NOW sit."
    a annoyed "...AHORA siéntate."

# game/script.rpy:3502
translate es ch7_ca9dcc70:

    # w oops "Very well...."
    w oops "Muy bien...."

# game/script.rpy:3505
translate es ch7_86603b28:

    # n "He complies, and Astragalus spins her office chair around to face him."
    n "Le obedece, y Astragalus gira su silla de oficina para mirarlo."

# game/script.rpy:3508
translate es ch7_46e11470:

    # a "Alright, Periwinkle. Here's what's gonna happen."
    a "Muy bien, Periwinkle. Esto es lo que vamos a hacer."

# game/script.rpy:3509
translate es ch7_89a00474:

    # a "I'm gonna brew us up some tea, and you're gonna explain everything. From the beginning."
    a "Voy a servirnos un poco de té, y tú vas a explicar todo. Desde el principio."

# game/script.rpy:3510
translate es ch7_0ccf1ed0:

    # w hood sorry "Explain what...?"
    w hood sorry "¿Explicar qué...?"

# game/script.rpy:3511
translate es ch7_0e7a98bb:

    # a "About Pastille. Even the stuff I already know. Everything, from the top."
    a "Sobre Pastille. Incluso las cosas que ya sé. Todo, desde el comienzo."

# game/script.rpy:3512
translate es ch7_30cf76fb:

    # w ohhh "Everything...?"
    w ohhh "¿Todo...?"

# game/script.rpy:3513
translate es ch7_4f05ba39:

    # a "Skip the bedroom details, obviously. Just walk me through anything important that happened since you met."
    a "Excepto lo sexual, obviamente. Solo cuéntame todo lo que haya sido importante desde que se conocieron."

# game/script.rpy:3514
translate es ch7_c147a5e1:

    # w whine "I-I don't want to! Reliving it all is only going to make things worse...!"
    w whine "¡N-no quiero! ¡Revivirlo todo solo empeorará las cosas...!"

# game/script.rpy:3517
translate es ch7_d617b2fd:

    # n "Astragalus stands and walks over to her kettle to start the tea."
    n "Astragalus se levanta y va hacia su tetera para preparar el té."

# game/script.rpy:3519
translate es ch7_c88d1b30:

    # a "Alright, you lovesick dolt..."
    a "De acuerdo, tonto enamorado..."

# game/script.rpy:3520
translate es ch7_95976d4b:

    # a annoyed "You wanna know why exactly your magic's been stuck like that? It's because you don't have an outlet for all those emotions."
    a annoyed "¿Quieres saber con exactitud por qué tu magia se ha atascado así? Es porque no has dejado salir todas esas emociones."

# game/script.rpy:3521
translate es ch7_ea89bd51:

    # a closed "Instead, you keep bottling them up--literally, I guess. It's all that comes out because it's all there is inside you."
    a closed "En cambio, sigues almacenándolas--literalmente, supongo. Es todo lo que sale porque es todo lo que hay dentro de ti."

# game/script.rpy:3522
translate es ch7_61f43815:

    # w hood ohhh "...."
    w hood ohhh "...."

# game/script.rpy:3523
translate es ch7_4d08edac:

    # a lol2 "So, let it all out! What, you think I'm gonna judge you?"
    a lol2 "¡Así que déjalo salir todo! ¿Qué, crees que te voy a juzgar?"

# game/script.rpy:3524
translate es ch7_0e405e25:

    # w oops "No... I don't know."
    w oops "No... no lo sé."

# game/script.rpy:3525
translate es ch7_a2f71b21:

    # a lol "Would you rather spill it all to him instead?"
    a lol "¿Prefieres contárselo todo a él en vez de eso?"

# game/script.rpy:3526
translate es ch7_237d6381:

    # w cwy "I can't...! It's too much!"
    w cwy "¡No puedo...! ¡Es demasiado!"

# game/script.rpy:3527
translate es ch7_61ef0d5e:

    # a sure "Then tell it to me, a neutral third party."
    a sure "Entonces cuéntamelo a mí, que no estoy involucrada."

# game/script.rpy:3528
translate es ch7_5df175e3:

    # a uh "Actually, I can't say that I'm neutral... I'd need to find a new supplier if you couldn't fill my orders anymore."
    a uh "En realidad, no puedo decir que no me afecta... tendría que encontrar un nuevo distribuidor si ya no pudieras cumplir con mis pedidos."

# game/script.rpy:3529
translate es ch7_3a7ea07c:

    # w oops "I do feel a little more at ease imagining this is all a business matter for you...."
    w oops "Me siento un poco más tranquilo imaginando que ves todo esto como un asunto de negocios...."

# game/script.rpy:3530
translate es ch7_969f721a:

    # a smile "Then just think of it like that."
    a smile "Entonces piénsalo de esa forma."

# game/script.rpy:3532
translate es ch7_e9b2e9b2:

    # n "Astragalus pours their tea and returns to her seat with two mugs in hand."
    n "Astragalus sirve el té y regresa a su asiento con dos tazas en mano."

# game/script.rpy:3533
translate es ch7_a98ff37d:

    # n "With a heavy sigh, Periwinkle finally relents and begins his story..."
    n "Con un profundo suspiro, Periwinkle finalmente cede y comienza su historia..."

# game/script.rpy:3539
translate es ch7_d30066c5:

    # "I told her everything I could think of..."
    "Le conté todo lo que pude pensar..."

# game/script.rpy:3540
translate es ch7_33d9f84f:

    # "My first impressions of him. How he continuously subverted my expectations."
    "Mis primeras impresiones de él. Como trastornaba constantemente mis expectativas."

# game/script.rpy:3541
translate es ch7_c5f52926:

    # "My mistakes. Appearing where I shouldn't have, then going into a desperate spiral as I tried to rid myself of the guilt over it."
    "Mis errores. Apareciendo donde no debía, y luego hundirme en desesperación mientras intentaba librarme de la culpa que me generaba."

# game/script.rpy:3542
translate es ch7_1bbf690f:

    # "How he was the one to come to apologize afterward..."
    "Como fue él quien vino a disculparse después..."

# game/script.rpy:3543
translate es ch7_c5838a34:

    # nvl clear
    # "Our date that day, which was so, so wonderful... but which also laid bare the feelings I was too afraid to acknowledge."
    nvl clear
    "Nuestra cita aquel día, que fue tan, tan maravillosa... pero que a la vez puso al descubierto los sentimientos que tanto me asustaba reconocer."

# game/script.rpy:3545
translate es ch7_e6e49546:

    # "How I latched on to any alternative explanation I could in order to escape them."
    "Como me aferré a cualquier explicación alternativa posible con tal de escapar de ellos."

# game/script.rpy:3546
translate es ch7_4e84de73:

    # "The moment I could finally admit it to myself. All the ways he'd changed my life for the better."
    "El momento en que finalmente pude admitirlo para mí mismo. Todas las formas en que él cambió mi vida para mejor."
    nvl clear

# game/script.rpy:3547
translate es ch7_6a07a020:

    # "How we grew closer and closer, while I held those feelings tighter to my chest..."
    "Como nos hicimos más y más cercanos, mientras retenía con fuerza aquellos sentimientos en mi pecho..."

# game/script.rpy:3548
translate es ch7_d4484d1e:

    # nvl clear
    # "I told her how he had finally worked up the courage to introduce me to his friends."
    nvl clear
    "Le conté como finalmente se armó de valor para presentarme a sus amigas."

# game/script.rpy:3550
translate es ch7_65da988b:

    # "How his hand trembled in mine as we walked out the door together."
    "Como su mano temblaba en la mía mientras salíamos juntos por la puerta."

# game/script.rpy:3551
translate es ch7_ee6b35c9:

    # "This point of contention, a far-off goal I had decided would have to be met before advancing..."
    "Este punto de conflicto, una meta lejana que decidí que tenía que cumplir antes de avanzar..."

# game/script.rpy:3552
translate es ch7_ca54ab44:

    # "Everything, up to the state I'm in now. Useless, paralyzed, and sobbing."
    "Todo, hasta el estado en que me encuentro ahora. Inútil, paralizado y sollozando."

# game/script.rpy:3553
translate es ch7_92f40e14:

    # nvl clear
    # "Astragalus listened patiently through all of it."
    nvl clear
    "Astragalus escuchó todo pacientemente."

# game/script.rpy:3555
translate es ch7_343d2423:

    # "She asked questions from time to time. Clarification on the timeframe, certain details..."
    "Hacía preguntas de vez en cuando. Aclaraciones sobre el orden de los acontecimientos, ciertos detalles..."

# game/script.rpy:3556
translate es ch7_87e644fe:

    # "Her reaffirming comments offered such comfort, such relief to this pain I'd kept confined to my own heart."
    "Sus comentarios ratificantes me reconfortaron, aliviando el dolor que estuve reprimiendo en mi propio corazón."

# game/script.rpy:3557
translate es ch7_b69014f7:

    # "Until finally, I had nothing left to say."
    "Hasta que finalmente, no tenía nada más que decir."

# game/script.rpy:3558
translate es ch7_d27b4990:

    # nvl clear
    # n "Astragalus sits back in her chair and heaves a sigh."
    nvl clear
    n "Astragalus regresa a su silla y suspira."

# game/script.rpy:3562
translate es ch7_a8670c2a:

    # a "So? How are you feeling?"
    a "¿Entonces? ¿Cómo te sientes?"

# game/script.rpy:3563
translate es ch7_04d072f1:

    # w hood oh2 "There's a certain clarity in laying it all out at once..."
    w hood oh2 "Lo veo con cierta claridad al soltarlo todo de una vez..."

# game/script.rpy:3564
translate es ch7_547bdb80:

    # w ohhh "But, I still... don't know what I can do to push things forward... could I even handle the rejection...?"
    w ohhh "Pero, todavía... no sé que puedo hacer para que las cosas avancen... ¿podría siquiera soportar el rechazo...?"

# game/script.rpy:3565
translate es ch7_a359177e:

    # a eyeroll "He won't reject you."
    a eyeroll "No va a rechazarte."

# game/script.rpy:3566
translate es ch7_229785e7:

    # w sorry "What makes you so certain...?"
    w sorry "¿Cómo estás tan segura...?"

# game/script.rpy:3567
translate es ch7_47ddd304:

    # a lmao "That boy is madly in love with you!! Why else would he devote all that time and energy to making you happy?"
    a lmao "¡¡Ese chico está locamente enamorado de ti!! ¿Por qué más dedicaría todo ese tiempo y energía en hacerte feliz?"

# game/script.rpy:3568
translate es ch7_a282e00e:

    # w pout "Because I'm great in bed! Obviously!!" with vpunch
    w pout "¡Porque soy bueno en la cama! ¡¡Es obvio!!" with vpunch

# game/script.rpy:3569
translate es ch7_7d78d80b:

    # a lol2 "Quit deflecting! You know that's not all it is."
    a lol2 "¡Deja de desviarte! Sabes que eso no es todo."

# game/script.rpy:3570
translate es ch7_c44bc880:

    # w nofair2 "I don't want to leave any room for doubt... if I were to confess now, and it didn't go well, I'd... I'd be destroyed beyond repair!"
    w nofair2 "No quiero dejar lugar a dudas... si me confesara ahora, y no saliera bien, estaría... ¡Estaría destruido por completo!"

# game/script.rpy:3571
translate es ch7_699f61db:

    # w nofair "That's why, if I'm going to say it, I want it to be a sure thing."
    w nofair "Es por eso que, si voy a decirlo, quiero que sea algo seguro."

# game/script.rpy:3572
translate es ch7_70aa9f4c:

    # a sure "Life ain't about \"sure things\"."
    a sure "La vida no trata de \"cosas seguras\"."

# game/script.rpy:3573
translate es ch7_1ce1b2b1:

    # w oops "Even so. I'm going to wait for the opportune moment before exposing my vulnerable heart...."
    w oops "Aún así. Voy a esperar el momento oportuno antes de exponer a mi vulnerable corazón...."

# game/script.rpy:3574
translate es ch7_67d2fe6a:

    # a eyeroll "As long as you've got a plan."
    a eyeroll "Siempre y cuando tengas un plan."

# game/script.rpy:3576
translate es ch7_5c6e9d30:

    # n "Astragalus leans down to pick up Periwinkle's empty mug, then holds it out in front of him."
    n "Astragalus se inclina para recoger la taza vacía de Pastille, y la sostiene frente a él."

# game/script.rpy:3577
translate es ch7_05b45148:

    # a happy "Try your magic again. Whatever scent you want, just pour it right in the cup."
    a happy "Prueba tu magia otra vez. El aroma que quieras, viértelo directamente en la taza."

# game/script.rpy:3578
translate es ch7_61f43815_1:

    # w hood ohhh "...."
    w hood ohhh "...."

# game/script.rpy:3582
translate es ch7_bffebb26:

    # n "Periwinkle nervously draws his wand, holds it out to the cup... then closes his eyes, and taps."
    n "Periwinkle saca nerviosamente su varita, la acerca a la taza... luego cierra los ojos y da un golpecito."

# game/script.rpy:3585
translate es ch7_62bd9f4e:

    # w hood ohhh2 "...Is it...?"
    w hood ohhh2 "¿...Es...?"

# game/script.rpy:3586
translate es ch7_31d796dc:

    # a "...."
    a "...."

# game/script.rpy:3587
translate es ch7_a378f6db:

    # a hm "Chamomile?"
    a hm "¿Manzanilla?"

# game/script.rpy:3588
translate es ch7_a5fd1669:

    # w my "It isn't peach...!"
    w my "¡No es durazno...!"

# game/script.rpy:3589
translate es ch7_48779aee:

    # w happy "I-I'm cured!!" with vpunch
    w happy "¡¡E-estoy sanado!!" with vpunch

# game/script.rpy:3590
translate es ch7_c8bd051e:

    # a lol2 "Yeah, dumbass! Did you forget this is an apothecary?"
    a lol2 "¡Sí, idiota! ¿Olvidaste que esto es una botica?"

# game/script.rpy:3591
translate es ch7_15718a3f:

    # w ohdear "Ah... it is, isn't it...."
    w ohdear "Ah... lo es, no es así...."

# game/script.rpy:3592
translate es ch7_21466243:

    # a eyeroll "Next time you've got a problem with your magic, don't sit around crying about it on your own. Come straight to me, and I'll fix you up."
    a eyeroll "La proxima vez que tengas un problema con tu magia, no te quedes llorando por tu cuenta. Acude directamente a mí, y yo te arreglaré."

# game/script.rpy:3593
translate es ch7_ba5c6de9:

    # w love "Thank you... I..."
    w love "Gracias... yo..."

# game/script.rpy:3594
translate es ch7_44e91ae4:

    # w shy "I'm truly glad that we're friends... I would be lost without you."
    w shy "Realmente estoy feliz de que seamos amigos... estaría perdido sin ti."

# game/script.rpy:3595
translate es ch7_4ffcdd35:

    # a sure "Business associates. Don't forget I've got loads of orders for you now that you're back to normal."
    a sure "Compañeros de negocios. No olvides que tengo un montón de pedidos para ti ahora que has vuelto a la normalidad."

# game/script.rpy:3596
translate es ch7_b19f23d3:

    # w happy "I'll go home and fill them right away! But first..."
    w happy "¡Iré a casa y me encargaré de inmediato! Pero antes..."

# game/script.rpy:3597
translate es ch7_9d2c05b0:

    # w love "May I hug you?"
    w love "¿Puedo abrazarte?"

# game/script.rpy:3598
translate es ch7_04792b09:

    # a augh "Not a chance!" with vpunch
    a augh "¡Ni lo sueñes!" with vpunch

# game/script.rpy:3599
translate es ch7_d733da0f:

    # w teehee "Hmhm, it was worth a shot. You'll accept my platonic affection one day~!"
    w teehee "Hmhm, había que intentarlo. ¡Algún día aceptarás mi afecto platónico~!"

# game/script.rpy:3600
translate es ch7_7f7593b0:

    # a happy "Yeah, yeah... get outta my office, Periwinkle."
    a happy "Sí, sí... fuera de mi oficina, Periwinkle."

# game/script.rpy:3607
translate es ch7_875a28a9:

    # n "The pair exits the back room, but they only make it a few steps out before Periwinkle turns on his heel."
    n "Ambos salen de la trastienda, pero solo dan unos pasos antes de que Periwinkle se dé media vuelta."

# game/script.rpy:3608
translate es ch7_4d17f35d:

    # w hood oh "Ah, one more thing, before I go..."
    w hood oh "Ah, una cosa más, antes de irme..."

# game/script.rpy:3610
translate es ch7_3f808ca6:

    # a "Hm? What's up."
    a "¿Hm? Qué pasa."

# game/script.rpy:3611
translate es ch7_faf56b4e:

    # w smile "I've been curious to ask. The last time I was here, you told me that magic can be interpreted as a judge of one's character..."
    w smile "Tenía curiosidad por preguntar. La última vez que estuve aquí, me dijiste que la magia puede interpretar el carácter de quien la hace..."

# game/script.rpy:3612
translate es ch7_09ac5a27:

    # a think "Oh, right. When I changed my mind about Pastille."
    a think "Oh, exacto. Cuando cambié de opinión sobre Pastille."

# game/script.rpy:3613
translate es ch7_e02f8699:

    # w calm "Yes, precisely. It's rather impressive that you could see through to his true nature, despite having only just met..."
    w calm "{size=-2}Sí, precisamente. Es impresionante que pudieras ver a través de su verdadera naturaleza, a pesar de que acababas de conocerlo...{/size}"

# game/script.rpy:3614
translate es ch7_d75c0f1f:

    # a lol "Sure, but he was pretty easy to read. Don't be too impressed."
    a lol "Claro, pero él era bastante fácil de leer. No te impresiones demasiado."

# game/script.rpy:3615
translate es ch7_7bba75e2:

    # w love "...Well?"
    w love "¿...Bueno?"

# game/script.rpy:3616
translate es ch7_21235aed:

    # a lol2 "Well what?"
    a lol2 "¿Bueno qué?"

# game/script.rpy:3617
translate es ch7_665ef7a8:

    # w happy "What does my magic say about me~? I'm dying to know 💙"
    w happy "¿Qué dice mi magia sobre mí~? Me muero por saber 💙"

# game/script.rpy:3618
translate es ch7_f33dfb60:

    # a sure "YOUR magic... was always lively and carefree. Compassionate, too. Like Pastille's."
    a sure "TU magia... siempre ha sido enérgica y libre. También compasiva. Como la de Pastille."

# game/script.rpy:3619
translate es ch7_08b17c47:

    # w love "How can you possibly read something like \"carefree\" from perfume?"
    w love "¿Cómo es que puedas interpretar algo como \"libre\" de un perfume?"

# game/script.rpy:3620
translate es ch7_e94ff0db:

    # a lol "Hey, I'm just telling you the vibes I've gotten over the years."
    a lol "Oye, solo estoy contándote las vibraciones que he recibido con los años."

# game/script.rpy:3621
translate es ch7_a2de6d44:

    # a think "Your aromas prioritize pleasure. But there was definitely a hint of loneliness in them, too..."
    a think "Tus aromas priorizan el placer. Pero definitivamente había algo de soledad en ellos también..."

# game/script.rpy:3622
translate es ch7_d8043053:

    # w teehee "Alright, now I KNOW you're making things up. I've always had someone to keep me company 💙"
    w teehee "De acuerdo, ahora SÉ que estás inventando cosas. Siempre he tenido a alguien que me hiciera compañía 💙"

# game/script.rpy:3623
translate es ch7_15310979:

    # a smile "Just because you've always got someone around doesn't mean you can't be lonely."
    a smile "El hecho de que siempre tengas a alguien cerca no significa que no puedas sentirte solo."

# game/script.rpy:3624
translate es ch7_c61d8bb7:

    # w calm "And I suppose someone like you would know a thing or two about loneliness, hm?"
    w calm "Y supongo que alguien como tú sabe un par de cosas sobre la soledad, ¿hm?"

# game/script.rpy:3625
translate es ch7_c94c969b:

    # a hm "I'm not lonely at all. In fact, I PREFER to be alone."
    a hm "No me siento para nada sola. De hecho, PREFIERO estarlo."

# game/script.rpy:3626
translate es ch7_adf9c46f:

    # a closed "YOU on the other hand... can't stand it even for a second. That's why you'd always run off chasing someone to fill the void."
    a closed "TÚ por otro lado... no puedes soportarlo ni por un segundo. Por eso siempre vas detrás de alguien para llenar ese vacío."

# game/script.rpy:3627
translate es ch7_cd947219:

    # w ohdear "...Well THAT certainly isn't true."
    w ohdear "...Bueno, ESO no es cierto."

# game/script.rpy:3628
translate es ch7_be244ae7:

    # a lol "The peach stuff you gave me earlier was PURE loneliness. It was crying out, like \"Please, Pastille, never leave me~!\""
    a lol "El de durazno que me diste antes era soledad PURA. Era como si gritara \"¡Por favor, Pastille, nunca me dejes~!\""

# game/script.rpy:3629
translate es ch7_27338eed:

    # w pout "This isn't fun anymore. Forget that I asked!"
    w pout "Esto ya no es divertido. ¡Olvida lo que pregunté!"

# game/script.rpy:3630
translate es ch7_11cf638a:

    # a happy "Sorry. Couldn't resist."
    a happy "Lo siento. No me pude resistir."

# game/script.rpy:3631
translate es ch7_7623f766:

    # w oops "...."
    w oops "...."

# game/script.rpy:3632
translate es ch7_b80c39a5:

    # w ohhh "I suppose you're right, though... I haven't been able to tell him that in words."
    w ohhh "Aunque supongo que tienes razón... no he logrado decírselo con palabras."

# game/script.rpy:3633
translate es ch7_ad5bdd9e:

    # w nofair2 "I can't keep holding back... he has to know. No matter the outcome."
    w nofair2 "No puedo seguir guardándomelo... tiene que saberlo. No importa lo que pase."

# game/script.rpy:3634
translate es ch7_60359fd7:

    # a smile "Good luck, okay? I'm sure it'll turn out just fine."
    a smile "Buena suerte, ¿sí? Estoy segura de que todo saldrá bien."

# game/script.rpy:3635
translate es ch7_a4d8dbdf:

    # w ohhh "Yes... yes, it likely will."
    w ohhh "Sí... sí, es muy probable."

# game/script.rpy:3636
translate es ch7_0f7a9daf:

    # w shy "Thank you again... I'm truly grateful for all that you've done for me."
    w shy "Gracias otra vez... estoy realmente agradecido por todo lo que has hecho por mí."

# game/script.rpy:3641
translate es ch7_47504267:

    # n "Astragalus waves him off, and Periwinkle leaves the apothecary with new resolve..."
    n "Astragalus se despide, y Periwinkle sale de la botica con una nueva determinación..."

# game/script.rpy:3651
translate es ch7_8954e2f7:

    # "I spent the next several days catching up on my work."
    "Pasé los días siguientes poniéndome al día con mi trabajo."

# game/script.rpy:3652
translate es ch7_c124ee6b:

    # "Magic truly does come so easily with a clear mind! If only I'd swallowed my pride sooner."
    "¡La magia es realmente sencilla con la mente despejada! Si tan solo hubiera dejado mi orgullo de lado antes."

# game/script.rpy:3653
translate es ch7_1e30c6c5:

    # "I completed batch after batch almost effortlessly, going down the long checklist Astragalus had given me..."
    "Completé un lote tras otro casi sin esfuerzo, reduciendo la larga lista de pedidos que me dio Astragalus..."
    nvl clear

# game/script.rpy:3654
translate es ch7_ba772060:

    # "I hadn't even felt tired by the end of it. As if all this energy had been stored up inside me all along!"
    "Ni siquiera me sentí cansado cuando terminé. ¡Como si toda esta energía se hubiese estado acumulado dentro de mí todo este tiempo!"

# game/script.rpy:3655
translate es ch7_2d728c30:

    # nvl clear
    # "It was a relief to return to somewhat normalcy."
    nvl clear
    "Fue un alivio volver un poco a la normalidad."

# game/script.rpy:3657
translate es ch7_e65838f7:

    # "Thinking of Pastille no longer caused my heart to ache... at least, not enough to put me in a state of total despondence."
    "Pensar en Pastille ya no era doloroso para mi corazón... al menos, no lo suficiente como para hacerme perder totalmente el ánimo."

# game/script.rpy:3658
translate es ch7_b8bdf17b:

    # "Instead, those thoughts served as motivation. The way forward was clear."
    "En su lugar, esos pensamientos sirvieron como motivación. El camino a seguir estaba claro."

# game/script.rpy:3659
translate es ch7_975f7c4e:

    # "I would tell him how I felt... and surely..."
    "Le hablaría sobre como me sentía... y seguramente..."

# game/script.rpy:3660
translate es ch7_38f5635f:

    # nvl clear
    # w pj calm "Surely things will turn out just fine...."
    nvl clear
    w pj calm "Seguramente las cosas saldrán bien...."

# game/script.rpy:3665
translate es ch7_94b11f24:

    # n "The following night... Pastille shows up on Periwinkle's doorstep."
    n "A la noche siguiente... Pastille aparece en la puerta de Periwinkle."

# game/script.rpy:3667
translate es ch7_1810d3ec:

    # p "Get dressed. I wanna take you somewhere."
    p "Vístete. Quiero llevarte a un lugar."

# game/script.rpy:3668
translate es ch7_89d40548:

    # w pj happy "Oh~ and where exactly am I being whisked away to? 💙"
    w pj happy "Oh~ ¿y a dónde sería llevado exactamente? 💙"

# game/script.rpy:3669
translate es ch7_f5ebb1d6:

    # p happy "You'll see. Wear comfortable shoes, okay?"
    p happy "Ya verás. Ponte zapatos cómodos, ¿sí?"

# game/script.rpy:3670
translate es ch7_cd6c9ac9:

    # w calm "How mysterious..."
    w calm "Qué misterioso..."

# game/script.rpy:3671
translate es ch7_c60adcac:

    # w smile "Hmhm, very well. I'll be ready momentarily 💙"
    w smile "Hmhm, muy bien. Estaré listo enseguida 💙"

# game/script.rpy:3674
translate es ch7_98348ebf:

    # "This is it..."
    "Llegó el momento..."

# game/script.rpy:3675
translate es ch7_09cbb0da:

    # "The dramatic confession scene is upon us!"
    "¡La dramática escena de confesión se aproxima!"

# game/script.rpy:3676
translate es ch7_e135b4c9:

    # "I have to look my best! For good luck, of course."
    "¡Tengo que verme lo mejor posible! Para la buena suerte, por supuesto."

# game/script.rpy:3677
translate es ch7_572f99bc:

    # "And for confidence...."
    "Y para la confianza...."

# game/script.rpy:3678
translate es ch7_76b2fe88:

    # nvl clear
    nvl clear

# game/script.rpy:3690
translate es ch7_28d525bc:

    # n "Hand in hand, the pair makes their way to the train station."
    n "De la mano, la pareja se dirige a la estación de tren."

# game/script.rpy:3691
translate es ch7_931bcf8a:

    # w cute innocent "(Hmhm~ had he been planning something while I was sequestered away with my work?)"
    w cute innocent "(Hmhm~ ¿habrá planeado algo mientras estaba encerrado trabajando?)"

# game/script.rpy:3692
translate es ch7_db582720:

    # w love "(Pastille is always so full of surprises... how positively delightful 💙)"
    w love "(Pastille siempre está tan lleno de sorpresas... es tan encantador 💙)"

# game/script.rpy:3695
translate es ch7_b5146a9c:

    # p "I hope I didn't interrupt any plans you had for the night...."
    p "Espero no haber interrumpido algún plan que tuvieras para la noche...."

# game/script.rpy:3696
translate es ch7_028375c7:

    # w happy "Oh, not at all~! It was about time I got out of the house again."
    w happy "¡Oh, para nada~! Ya era hora de que volviera a salir de casa."

# game/script.rpy:3697
translate es ch7_dd0f85ec:

    # w smile "I've actually had a very productive past several days, you know. Toiling away over my perfumes."
    w smile "De hecho, he tenido unos días muy productivos, ya sabes. Trabajando duro en mis perfumes."

# game/script.rpy:3698
translate es ch7_dcf1b0e8:

    # p ehe "Haha, I thought that might be the case, since you hadn't dropped by in a while."
    p ehe "Jaja, pensé que ese podría ser el caso, ya que no te habías pasado por la tienda hace tiempo."

# game/script.rpy:3699
translate es ch7_fb3a840a:

    # w innocent "Did you miss me? 💙"
    w innocent "¿Me extrañaste? 💙"

# game/script.rpy:3700
translate es ch7_13104245:

    # p embarrassed "W-well...."
    p embarrassed "B-bueno...."

# game/script.rpy:3702
translate es ch7_b1056d27:

    # n "Periwinkle hugs Pastille's arm tightly as they continue their walk."
    n "Periwinkle abraza firmemente el brazo de Pastille mientras siguen caminando."

# game/script.rpy:3703
translate es ch7_9e455bb5:

    # w cute shy "(I missed you, too...)"
    w cute shy "(También te extrañé...)"

# game/script.rpy:3706
translate es ch7_92a9892d:

    # "When Pastille and I step off the train, we're greeted by grassy fields and a sky full of luminous stars."
    "Cuando Pastille y yo bajamos del tren, nos reciben campos de hierba y un cielo lleno de luminosas estrellas."

# game/script.rpy:3707
translate es ch7_1242c23a:

    # "Just where has he taken me...?"
    "¿Dónde me trajo...?"

# game/script.rpy:3708
translate es ch7_924bc4f2:

    # "A trail of lanterns lights the lone path forward..."
    "Un sendero de linternas ilumina el solitario camino hacia adelante..."

# game/script.rpy:3709
translate es ch7_27428714:

    # "Pastille takes the lead."
    "Pastille va por delante."

# game/script.rpy:3710
translate es ch7_76b2fe88_1:

    # nvl clear
    nvl clear

# game/script.rpy:3713
translate es ch7_794d51f4:

    # p "It's a bit of a walk from here... but I promise it'll be worth it."
    p "Está un poco lejos de aquí... pero prometo que valdrá la pena."

# game/script.rpy:3714
translate es ch7_dd9f0107:

    # w cute love "A long walk, hm? Couldn't we take a ride on your broom together~?"
    w cute love "Un paseo largo, ¿hm? ¿No podemos ir en tu escoba juntos~?"

# game/script.rpy:3715
translate es ch7_6e405e15:

    # p sure "Nah, it'd defeat the purpose. It'll feel more rewarding getting there on foot."
    p sure "Nah, eso arruinaría el objetivo. Será más satisfactorio llegar a pie."

# game/script.rpy:3716
translate es ch7_ebba887b:

    # w calm "Hmhm... fair enough. Tragic, though, that you'd willingly pass on an opportunity for me to cling to you."
    w calm "Hmhm... está bien. Sin embargo, es lamentable que voluntariamente dejaras pasar la oportunidad de que te abrazara."

# game/script.rpy:3717
translate es ch7_34a0afcc:

    # p ehe "Haha, we can fly on the way back if you want."
    p ehe "Jaja, podemos volar cuando regresemos si quieres."

# game/script.rpy:3719
translate es ch7_4f263e5f:

    # n "Pastille offers his hand again, which Periwinkle takes with a smile."
    n "Pastille ofrece nuevamente su mano, la cual Periwinkle toma con una sonrisa."

# game/script.rpy:3724
translate es ch7_59ddd814:

    # w "...Tell me more about your relationship with magic."
    w "...Cuéntame más sobre tu relación con la magia."

# game/script.rpy:3725
translate es ch7_2528ce76:

    # p "Hm? What do you mean?"
    p "¿Hm? ¿A qué te refieres?"

# game/script.rpy:3726
translate es ch7_3c167982:

    # w "It was the same when we cleaned my house together. You insisted on doing things manually..."
    w "Fue lo mismo cuando limpiamos mi casa juntos. Insististe en hacer las cosas manualmente..."

# game/script.rpy:3727
translate es ch7_7c5e0bd7:

    # w "Not that I minded at all. Seeing you lift so many heavy things was a treat in itself 💙"
    w "Tampoco es como si me molestara. Era divertido verte llevar tantas cosas pesadas 💙"

# game/script.rpy:3728
translate es ch7_4caf8895:

    # p "Hahaha, well..."
    p "Jajaja, bueno..."

# game/script.rpy:3729
translate es ch7_10f7805a:

    # p "Ever since I was young... it was clear I was, um... \"ridiculously talented\", as they'd put it."
    p "Desde que era joven... estaba claro que era, um... \"ridículamente talentoso\", como decían."

# game/script.rpy:3730
translate es ch7_e85247dc:

    # p "My moms wanted me to be a traditional witch. They enrolled me in one of the top schools, so I could learn from the best."
    p "Mis madres querían que fuera un brujo tradicional."
    p "Me inscribieron en una de las mejores escuelas, para que pudiera aprender con los mejores."

# game/script.rpy:3732
translate es ch7_0b59e908:

    # p "I-it was an all-girls school, though... Guess I was young enough that no one realized I was a boy."
    p "S-sin embargo, era una escuela para chicas... Supongo que era demasiado joven para que se dieran cuenta de que era un chico."

# game/script.rpy:3733
translate es ch7_c1703821:

    # p "I really... didn't belong there. On any level."
    p "Realmente... no pertenecía allí. En ningún aspecto."

# game/script.rpy:3734
translate es ch7_fa8d2d79:

    # p "But, I kept at it as long as I could. Just enough to keep my parents happy, until I could go out and live on my own."
    p "Pero seguí estudiando tanto como pude. Lo suficiente para hacer felices a mis madres, hasta que pudiera irme a vivir por mi cuenta."

# game/script.rpy:3736
translate es ch7_73d8e924:

    # p "Haha, I still don't understand exactly why... but I always felt uncomfortable using my magic."
    p "Jaja, sigo sin entender por qué exactamente... pero siempre me sentí incómodo usando mi magia."

# game/script.rpy:3737
translate es ch7_b1a584dd:

    # p "It felt like cheating. Like... this kind of power shouldn't come so easily."
    p "Se sentía como hacer trampa. Como... este tipo de poder que no debería darse tan fácilmente."

# game/script.rpy:3738
translate es ch7_f94b0797:

    # p "Sy thought so, too. I guess that's why I latched onto her when we met..."
    p "Sy también pensaba así. Supongo que por eso me aferré a ella cuando nos conocimos..."

# game/script.rpy:3739
translate es ch7_b940b2af:

    # p "She used to really hate magic. Which worked out perfectly for me--it was a good excuse to pretend to be a regular human like her."
    p "Ella solía odiar la magia. Lo cual me venía perfecto--era una buena excusa para fingir ser un humano normal como ella."

# game/script.rpy:3740
translate es ch7_e058bb72:

    # p "So... that's what I did. For the past... seven years?"
    p "Así que... eso es lo que hice. Durante los últimos... ¿siete años?"

# game/script.rpy:3743
translate es ch7_fe2bf237:

    # w cute my "Seven years... that's quite a long time!"
    w cute my "Siete años... ¡eso es demasiado tiempo!"

# game/script.rpy:3745
translate es ch7_4d057338:

    # p "Yeah, but there was a lot to distract me back then... it took a while to get Atelier Sweets up and running."
    p "Sí, pero había muchas cosas para distraerme en ese entonces... tomó un tiempo poner en marcha Atelier Sweets."

# game/script.rpy:3746
translate es ch7_dc3c7909:

    # p calm "And... Sy did eventually find out. I thought she'd disown me when she did..."
    p calm "Y... Sy eventualmente lo descubrió. Pensé que me repudiaría cuando lo hizo..."

# game/script.rpy:3747
translate es ch7_c13fd2df:

    # p ehe "But instead... she told me I shouldn't have hid it. Even though I doubt we would've become friends if I told her from the beginning..."
    p ehe "Pero en vez de eso... me dijo que no debí haberlo ocultado."
    p "Aunque dudo que nos hubiésemos hecho amigos si se lo decía desde el principio..."

# game/script.rpy:3748
translate es ch7_53e2aed6:

    # w calm "Quite impossible to please, hm?"
    w calm "Bastante imposible de complacer, ¿hm?"

# game/script.rpy:3749
translate es ch7_03a0e69e:

    # p sure "You have no idea...."
    p sure "No tienes idea...."

# game/script.rpy:3750
translate es ch7_6dc476af:

    # p smile "But... ever since she said that, I've been able to start embracing magic again. On my own terms."
    p smile "Pero... desde que dijo eso, he sido capaz de retomar mi magia. En mis propios términos."

# game/script.rpy:3751
translate es ch7_3832c226:

    # w "(I'm beginning to grasp why he values her so highly...)"
    w "(Empiezo a entender por qué la valora tanto...)"

# game/script.rpy:3752
translate es ch7_ff5b5b21:

    # p ohno "Um, sorry that I just keep talking about myself...."
    p ohno "Um, perdón por seguir hablando sobre mí...."

# game/script.rpy:3753
translate es ch7_d3905dce:

    # w happy "Don't apologize~! I'm the one who asked."
    w happy "¡No te disculpes~! Yo soy el que preguntó."

# game/script.rpy:3754
translate es ch7_7c140cec:

    # w smile "Besides, I'm content to listen. Say as much as you like."
    w smile "Además, me agrada escucharte. Cuenta todo lo que quieras."

# game/script.rpy:3755
translate es ch7_acb13031:

    # p embarrassed "Thanks...."
    p embarrassed "Gracias...."

# game/script.rpy:3758
translate es ch7_ea22c411:

    # n "Periwinkle gives Pastille's hand a reassuring squeeze."
    n "Periwinkle le da a Pastille un apretón reconfortante en la mano."

# game/script.rpy:3760
translate es ch7_6ce8c1d1:

    # "I love him..."
    "Lo amo..."

# game/script.rpy:3761
translate es ch7_aa288728:

    # "I have to find the right moment to tell him that."
    "Tengo que encontrar el momento adecuado para decírselo."

# game/script.rpy:3762
translate es ch7_973b0143:

    # "Should it be now? During this romantic walk?"
    "¿Debería ser ahora? ¿Durante este paseo romántico?"

# game/script.rpy:3763
translate es ch7_34c7c040:

    # "Ah, but he still has yet to reveal our destination..."
    "Ah, pero aún falta que revele nuestro destino..."

# game/script.rpy:3764
translate es ch7_87cfcf28:

    # "What do you have in store for me, Pastille...?"
    "¿Qué me estás preparando, Pastille...?"

# game/script.rpy:3765
translate es ch7_76b2fe88_2:

    # nvl clear
    nvl clear

# game/script.rpy:3768
translate es ch7_cd548b59:

    # p "I think I might be too used to how Sy is... she's usually so preoccupied with her own stuff."
    p "Creo que estoy muy acostumbrado a como es Sy... generalmente está muy inmersa en sus propias cosas."

# game/script.rpy:3769
translate es ch7_e4e3ea32:

    # p smile "So it's nice... having someone who actually wants to listen to me."
    p smile "Así que es lindo... tener a alguien que realmente quiera escucharme."

# game/script.rpy:3770
translate es ch7_63040b81:

    # p flustered2 "Agh, that makes her sound like such a horrible friend...! She's really not!!" with vpunch
    p flustered2 "¡Agh, eso la hace sonar como una amiga horrible...! ¡¡No es así!!" with vpunch

# game/script.rpy:3771
translate es ch7_0bd17d69:

    # w cute happy "You certainly haven't made a convincing case for her~!"
    w cute happy "¡No has dado un argumento convincente de que lo sea~!"

# game/script.rpy:3772
translate es ch7_92bac40c:

    # p calm "*sigh* I know. But that wasn't the point I was trying to make..."
    p calm "*suspiro* lo sé. Pero ese no era el punto al que quería llegar..."

# game/script.rpy:3773
translate es ch7_cb1d6efd:

    # w oh "Oh?"
    w oh "¿Oh?"

# game/script.rpy:3774
translate es ch7_6f213e95:

    # p ohno2 "I really...!"
    p ohno2 "¡Yo en serio...!"

# game/script.rpy:3775
translate es ch7_2ddcc144:

    # p flustered2 "...."
    p flustered2 "...."

# game/script.rpy:3776
translate es ch7_5793c0e9:

    # w love "Yes...?"
    w love "¿Sí...?"

# game/script.rpy:3777
translate es ch7_bd8caf25:

    # p seriously "Let me start over."
    p seriously "Déjame empezar de nuevo."

# game/script.rpy:3780
translate es ch7_4457e2ee:

    # n "Pastille takes a deep breath before continuing..."
    n "Pastille respira profundamente antes de continuar..."

# game/script.rpy:3781
translate es ch7_3c52a2e3:

    # p wha "Going back to... what we were talking about before. With my magic and everything."
    p wha "Regresando a... lo que hablábamos antes. Sobre a mi magia y todo eso."

# game/script.rpy:3782
translate es ch7_b651cf3a:

    # p think "I think I have trouble accepting myself for what I am... I tend to hide things, even when I don't need to."
    p think "Creo que tengo problemas para aceptarme por lo que soy... tiendo a esconder cosas, incluso cuando no es necesario."

# game/script.rpy:3783
translate es ch7_8c631518:

    # p oh "Being with YOU feels like... it's better not to hide? Like, I'm allowed to just BE."
    p oh "Cuando estoy CONTIGO siento que... ¿es mejor no esconderme? Como si simplemente pudiera ser YO."

# game/script.rpy:3784
translate es ch7_bd2d007a:

    # p shy "Or, more like... celebrated? For being? I-I don't know, that feels weird to say."
    p shy "O, más bien... ¿se me reconociera? ¿Por ser yo? N-no lo sé, se siente raro decirlo."

# game/script.rpy:3785
translate es ch7_f3a624fa:

    # w cute wow "...."
    w cute wow "...."

# game/script.rpy:3786
translate es ch7_a1e89604:

    # p ehe "Y-you can stop me if I'm being too much...."
    p ehe "P-puedes pedir que pare si me excedo...."

# game/script.rpy:3787
translate es ch7_cb9e5642:

    # w nofair2 "(IT'S BECAUSE I LOVE YOU...! Why can't I just say that...?!)" with vpunch
    w nofair2 "(¡ES PORQUE TE AMO...! ¿¡Por qué no puedo simplemente decir eso...?!)" with vpunch

# game/script.rpy:3789
translate es ch7_0e54bcb0:

    # p smile "Oh! We're here!"
    p smile "¡Oh! ¡Ya llegamos!"

# game/script.rpy:3790
translate es ch7_f344f25d:

    # w my "W-we are...?"
    w my "¿L-llegamos...?"

# game/script.rpy:3799
translate es ch7_01fc1362:

    # "When we came up over the hill..."
    "Cuando subimos la colina..."

# game/script.rpy:3800
translate es ch7_5d572078:

    # "The vastness of the night sky overwhelmed me."
    "La inmensidad del cielo nocturno me impresionó."

# game/script.rpy:3801
translate es ch7_38f127a1:

    # "But more than that..."
    "Pero además de eso..."

# game/script.rpy:3802
translate es ch7_6294189d:

    # "The field of small blue flowers, that stretched as far as the eye could see..."
    "El campo de pequeñas flores azules, que se extendía hasta donde alcanzaba la vista..."

# game/script.rpy:3803
translate es ch7_69330f7d:

    # "Matched it so perfectly."
    "Combinaba a la perfección."

# game/script.rpy:3804
translate es ch7_76b2fe88_3:

    # nvl clear
    nvl clear

# game/script.rpy:3808
translate es ch7_c19eb018:

    # w cute shock "Pastille...!"
    w cute shock "¡Pastille...!"

# game/script.rpy:3811
translate es ch7_00d275ec:

    # p "They're periwinkles. When I looked up where to find some... I found out about this place."
    p "Son vincas. Cuando estaba buscando en dónde encontrar algunas... descubrí este lugar."

# game/script.rpy:3812
translate es ch7_36ad9faf:

    # p doki "A-apparently it's a famous date spot... I thought you'd like to see it, so...."
    p doki "A-aparentemente es un sitio popular para citas... pensé que te gustaría verlo, así que..."

# game/script.rpy:3814
translate es ch7_3d805e46:

    # w "I... I-I...!"
    w "¡Yo... y-yo...!"

# game/script.rpy:3815
translate es ch7_8adde88a:

    # w whine2 "I shouldn't have told you I'm weak to romance...!! Pastille!!!" with vpunch
    w whine2 "¡¡No debí decirte que el romance es mi debilidad...!! ¡¡¡Pastille!!!" with vpunch

# game/script.rpy:3819
translate es ch7_05c9cbbc:

    # n "A glint catches Periwinkle's eye,{nw}"
    n "Periwinkle percibe un destello con la mirada,{nw}"

# game/script.rpy:3821
translate es ch7_a8567a09:

    # extend " and he looks up to notice... a meteor shower has begun."
    extend " y mira hacia arriba para descubrir... que había iniciado una lluvia de estrellas."

# game/script.rpy:3823
translate es ch7_73f1a48a:

    # w my "Ah...!"
    w my "¡Ah...!"

# game/script.rpy:3824
translate es ch7_559af831:

    # p happy "Oh, good! It started just in time...."
    p happy "¡Oh, qué bien! Empezó justo a tiempo...."

# game/script.rpy:3825
translate es ch7_060caff3:

    # w shock "You planned this, too?!" with vpunch
    w shock "¡¿También planeaste esto?!" with vpunch

# game/script.rpy:3826
translate es ch7_a08d1d6b:

    # p embarrassed "Well, I knew this was supposed to be happening tonight... so...."
    p embarrassed "Bueno, sabía que estaba previsto para esta noche... así que...."

# game/script.rpy:3831
translate es ch7_e01493c6:

    # w overwhelmed "PASTILLE!!!!!!!"
    w overwhelmed "¡¡¡¡¡¡¡PASTILLE!!!!!!!"

# game/script.rpy:3833
translate es ch7_b1a81c31:

    # p "WAH--!!" with vpunch
    p "¡¡WAH--!!" with vpunch

# game/script.rpy:3838
translate es ch7_e7ad4e10:

    # n "Periwinkle tackles Pastille to the ground, landing them in the field of flowers..."
    n "Periwinkle arroja a Pastille al suelo, cayendo juntos en el campo de flores..."

# game/script.rpy:3842
translate es ch7_993f86f6:

    # w "This is perfect..."
    w "Esto es perfecto..."

# game/script.rpy:3843
translate es ch7_29d90c6e:

    # w "I-I don't know what else to say...! I'm speechless...."
    w "¡N-no sé qué más decir...! Estoy sin palabras...."

# game/script.rpy:3844
translate es ch7_74dc2d6c:

    # p "Haha, I guess I went a little overboard...."
    p "Jaja, supongo que me excedí un poco...."

# game/script.rpy:3845
translate es ch7_71a07f4f:

    # w "A little?! This is the most romantic thing anyone's ever done for me!!!" with vpunch
    w "¡¿Un poco?! ¡¡¡Esto es lo más romántico que alguien ha hecho por mí!!" with vpunch

# game/script.rpy:3846
translate es ch7_e978b8e5:

    # n "He buries his face in Pastille's chest, holding him close."
    n "Entierra su rostro en el pecho de Pastille, abrazándolo."

# game/script.rpy:3847
translate es ch7_16aecb80:

    # p "Well... there's actually... one more thing I wanted to say."
    p "Bueno... de hecho hay... una cosa más que quería decir."

# game/script.rpy:3849
translate es ch7_2f9a6199:

    # n "He can feel Pastille's heart pounding."
    n "Puede sentir los latidos del corazón de Pastille."

# game/script.rpy:3850
translate es ch7_3890f9c5:

    # p "Ahh, where do I start... um...."
    p "Ahh, por dónde empiezo... um...."

# game/script.rpy:3851
translate es ch7_e74b39bd:

    # p "You know how... Sy and Gumdrop are really important to me?"
    p "¿Sabes cuan... importantes son Sy y Gumdrop para mí?"

# game/script.rpy:3852
translate es ch7_d67e120d:

    # p "I always thought that I needed to keep myself available for them. To take care of the store and everything."
    p "Siempre pensé que tenía mantenerme disponible para ellas. Para encargarme de la tienda y todo eso."

# game/script.rpy:3853
translate es ch7_2ebc1e5f:

    # p "But in practice, that just meant... I never really took any time for myself."
    p "Pero en la práctica, eso solo significó... que nunca me tomé un tiempo para mí."

# game/script.rpy:3854
translate es ch7_dc57cb02:

    # p "Like, my own needs were something I could just bury, and it would be fine... because it's for their sake."
    p "Como si mis propias necesidades fueran algo que simplemente pudiera ignorar, y eso estaría bien... porque es por el bien de ellas."

# game/script.rpy:3856
translate es ch7_3e7da720:

    # p "I guess that's part of why... I'd go out with random guys in secret. As something just for me, totally detached from everything else."
    p "{size=-2}Supongo que en parte es por eso... que salía con cualquier chico en secreto. Como algo solo para mí, totalmente desvinculado de todo lo demás.{/size}"

# game/script.rpy:3857
translate es ch7_a24acfbd:

    # p "I tried... having a real relationship once. It didn't work out, obviously. I-I never told Sy about him..."
    p "Una vez... intenté tener una relación seria. No funcionó, obviamente. N-nunca le conté a Sy sobre él..."

# game/script.rpy:3858
translate es ch7_4e3c6695:

    # p "But that made me think... that I was right to continue on the way I had been. Since I wasn't willing to let my priorities shift."
    p "Pero eso me hizo pensar..."
    p "Que era correcto seguir el camino que había tomado. Ya que no estaba dispuesto a dejar que mis prioridades cambiaran."

# game/script.rpy:3859
translate es ch7_03dafb87:

    # n "Periwinkle grips Pastille's cloak a little tighter."
    n "Periwinkle sujeta la capa de Pastille con un poco más de fuerza."

# game/script.rpy:3860
translate es ch7_8f89c97b:

    # w "Wh-what are you saying...?"
    w "¿Q-qué estás diciendo...?"

# game/script.rpy:3861
translate es ch7_ed9ffa87:

    # p "I guess, um... that, with you... I don't mind it as much."
    p "Supongo, um... que, contigo... eso no me importa tanto."

# game/script.rpy:3868
translate es ch7_1b31e9f8:

    # "H-he's... he's going to beat me to it at this rate!!"
    "E-él... ¡¡se me adelantará a este paso!!"

# game/script.rpy:3869
translate es ch7_5760d7ef:

    # "I-I can't let that happen...!"
    "¡No puedo dejar que eso pase...!"

# game/script.rpy:3870
translate es ch7_e860da44:

    # nvl clear
    # n "Periwinkle suddenly rolls himself on top of Pastille, pinning him down."
    nvl clear
    n "Periwinkle repentinamente se pone encima de Pastille, inmovilizándolo."

# game/script.rpy:3875
translate es ch7_e3a3d605:

    # w "Pastille, I'm in love with you!!!"
    w "¡¡¡Pastille, estoy enamorado de ti!!!"

# game/script.rpy:3876
translate es ch7_3353d4b4:

    # p "Wh-wha--??!?!? S-since when?!" with vpunch
    p "¿¿¡¿¡¿Q-qué--??!?!? ¡¿D-desde cuándo?!" with vpunch

# game/script.rpy:3878
translate es ch7_d08ef308:

    # w "I-I don't know, maybe this whole time?!"
    w "N-no lo sé, ¡¿tal vez todo este tiempo?!"

# game/script.rpy:3879
translate es ch7_fc9fe40d:

    # w "I only admitted it to myself that morning you made me pancakes...."
    w "Apenas lo admití para mí mismo esa mañana en la que me hiciste panqueques...."

# game/script.rpy:3881
translate es ch7_69ecef14:

    # p "That's what it took..?"
    p "¿Eso era lo que hacía falta...?"

# game/script.rpy:3882
translate es ch7_72ea541b:

    # w "Why? How long have YOU felt this way?"
    w "¿Por qué? ¿Hace cuánto TÚ te sientes así?"

# game/script.rpy:3884
translate es ch7_1e470d14:

    # p "Since... having to carry you home, after spending the day together? I think that's when I first realized it..."
    p "¿Desde... que tuve que llevarte a casa, después de pasar el día juntos? Creo que fue cuando me di cuenta por primera vez..."

# game/script.rpy:3885
translate es ch7_f1180398:

    # w "Then why didn't you say something?! I've been suffering in silence this entire time...!" with vpunch
    w "¡¿Entonces por qué no dijiste nada?! ¡He estado sufriendo en silencio todo este tiempo...!" with vpunch

# game/script.rpy:3887
translate es ch7_350e8d77:

    # p "I-I thought you wanted to keep it casual...?"
    p "¿P-pensé que querías mantenerlo como algo casual...?"

# game/script.rpy:3888
translate es ch7_2ded0261:

    # w "We saw each other almost every day!! How is that casual?!"
    w "¡¡Nos veíamos casi todos los días!! ¡¿Qué tiene eso de casual?!"

# game/script.rpy:3889
translate es ch7_8f5651d3:

    # p "But you never acted any differently...! A-and I was busy sorting through my own feelings anyway...."
    p "¡Pero nunca actuaste de forma diferente...! Y-y de todos modos estaba ocupado asimilando mis propios sentimientos...."

# game/script.rpy:3891
translate es ch7_8cca7f14:

    # w "Mmmnnnnnn...!!!!!!! So was I...."
    w "¡¡¡¡¡¡¡Mmmnnnnnn...!!!!!!! Igual que yo..."

# game/script.rpy:3892
translate es ch7_56b8e860:

    # w "But that's no excuse for how long you kept me waiting...! I-I won't forgive you!"
    w "¡Pero eso no justifica todo el tiempo que me hiciste esperar...! ¡N-no te perdonaré!"

# game/script.rpy:3894
translate es ch7_d5c67421:

    # p "...."
    p "...."

# game/script.rpy:3895
translate es ch7_47bd51eb:

    # w "Wh-what...? Why are you smiling like that?"
    w "¿Q-qué...? ¿Por qué sonríes así?"

# game/script.rpy:3896
translate es ch7_fbb1d3e9:

    # p "It's cute... seeing you all worked up like this."
    p "Es lindo... verte así de alterado."

# game/script.rpy:3897
translate es ch7_ae85e999:

    # w "--!!"
    w "¡¡--!!"

# game/script.rpy:3900
translate es ch7_ed75769f:

    # n "Periwinkle struggles to his feet and begins stomping away."
    n "Periwinkle lucha por ponerse de pie y se aleja pisoteando."

# game/script.rpy:3902
translate es ch7_f6c38887:

    # w cute nofair2 "Y-you could've saved me a lot of heartache, you know...!"
    w cute nofair2 "¡P-podrías haberme ahorrado tantos dolores de cabeza, sabes...!"

# game/script.rpy:3903
translate es ch7_7dc24b88:

    # n "Pastille sits up, straightening out his cloak and retrieving his hat."
    n "Pastille se sienta, se acomoda su capa y recupera su sombrero."

# game/script.rpy:3906
translate es ch7_ff9468ab:

    # p "Where are you going...? Come back."
    p "¿A dónde vas...? Regresa."

# game/script.rpy:3907
translate es ch7_f6894d83:

    # w nofair "No!! I'm too upset!" with vpunch
    w nofair "¡¡No!! ¡Estoy muy enojado!" with vpunch

# game/script.rpy:3908
translate es ch7_ff48b4a6:

    # p ehe "Peri...."
    p ehe "Peri...."

# game/script.rpy:3909
translate es ch7_34963f72:

    # w yell "I was convinced... CONVINCED, that I'd cursed myself with some kind of love potion! My fake aphrodisiac turned real!"
    w yell "{size=-2}Estaba convencido... CONVENCIDO, de que me había maldecido con algún tipo de poción de amor! ¡Mi afrodisíaco falso se había hecho real!{/size}"

# game/script.rpy:3910
translate es ch7_c9c42113:

    # p "What in the world...?"
    p "¿Qué demonios....?"

# game/script.rpy:3911
translate es ch7_ca056bf8:

    # w "Because we didn't fuck that day! Fucking was supposed to be the entire point of it!!" with vpunch
    w "¡Porque no cogimos ese día! ¡¡Se suponía que coger era el objetivo de todo eso!!" with vpunch

# game/script.rpy:3912
translate es ch7_03d3511b:

    # p dying "P-PERI...!"
    p dying "¡P-PERI...!"

# game/script.rpy:3913
translate es ch7_21cbb225:

    # w nofair2 "Everything spiraled out of control since then...! I couldn't stop thinking about you!!"
    w nofair2 "¡Todo se salió de control desde entonces...! ¡¡No podía parar de pensar en ti!!"

# game/script.rpy:3914
translate es ch7_c400f965:

    # w yell "You BROKE my magic! For weeks and weeks, all I could conjure was that stupid peach blossom scent...!"
    w yell "¡ARRUINASTE mi magia! Por semanas y semanas, todo lo que podía conjurar era ese estúpido perfume de durazno...!"

# game/script.rpy:3915
translate es ch7_b704fa44:

    # p woah "A-ah... really...?"
    p woah "¿A-ah... de verdad...?"

# game/script.rpy:3916
translate es ch7_b58af626:

    # w nofair2 "Yes! Until just the other day... which I spent CRYING, in the dusty back room of the apothecary, telling Astragalus all about it...!"
    w nofair2 "¡Sí! Hasta el otro día... en el que la pasé LLORANDO, en la polvorienta trastienda de la botica, contándole todo a Astragalus...!"

# game/script.rpy:3917
translate es ch7_03175381:

    # w nofair "After all that... everything I spent so long preparing my heart for... you have the NERVE to try to confess first...?!"
    w nofair "Después de todo eso... todo el tiempo que pasé preparando mi corazón... ¡¿tienes el DESCARO de intentar confesarte pimero...?!"

# game/script.rpy:3918
translate es ch7_ea73974b:

    # p aw "I'm sorry."
    p aw "Lo siento."

# game/script.rpy:3919
translate es ch7_4abce74d:

    # w nofair2 "Don't apologize! I already said I won't forgive you!!" with vpunch
    w nofair2 "¡No te disculpes! ¡¡Ya dije que no te iba a perdonar!!" with vpunch

# game/script.rpy:3920
translate es ch7_937c48a8:

    # p ehe "What do you want me to do, then...?"
    p ehe "¿Qué quieres que haga, entonces...?"

# game/script.rpy:3921
translate es ch7_2af101c3:

    # w insulted "I don't know, fucking kiss me if you love me so much!!!"
    w insulted "¡¡¡No lo sé, dame un puto beso si me amas tanto!!!"

# game/script.rpy:3929
translate es ch7_71e3c067:

    # n "Pastille approaches, gently raising a hand to Periwinkle's cheek..."
    n "Pastille se acerca, alzando una mano gentilmente hacia la mejilla de Periwinkle..."

# game/script.rpy:3931
translate es ch7_c2b3fc7a:

    # n "...and does exactly as he's told."
    n "...y hace exactamente lo que le dice."

# game/script.rpy:3933
translate es ch7_58024a15:

    # p "I love you."
    p "Te amo."

# game/script.rpy:3934
translate es ch7_dde4b08e:

    # n "Periwinkle's heart skips a beat."
    n "El corazón de Periwinkle late fuertemente."

# game/script.rpy:3936
translate es ch7_2c91cb68:

    # w "I love you, too...!"
    w "¡También te amo...!"

# game/script.rpy:3937
translate es ch7_ff617e74:

    # n "He hugs Pastille tightly, careful not to knock him over this time."
    n "Abraza a Pastille con fuerza, con cuidado de no tirarlo esta vez."

# game/script.rpy:3944
translate es ch7_33de9d18:

    # "It takes everything I've got to keep myself from bursting into tears."
    "Me cuesta todo lo que tengo para evitar romper en llanto."

# game/script.rpy:3945
translate es ch7_57e13493:

    # "I won't ruin my makeup on this perfect date...!"
    "¡No arruinaré mi maquillaje en esta cita perfecta...!"

# game/script.rpy:3946
translate es ch7_1c5f0457:

    # "This beautiful place, that Pastille chose just for us..."
    "Este hermoso lugar, que Pastille eligió solo para nosotros..."

# game/script.rpy:3947
translate es ch7_bc3b2ea7:

    # "I can't have my memory of this perfect night obscured by tears...."
    "No puedo tener el recuerdo de esta noche perfecta cubierto de lágrimas...."

# game/script.rpy:3948
translate es ch7_76b2fe88_4:

    # nvl clear
    nvl clear

# game/script.rpy:3954
translate es ch7_ec2dd684:

    # p "It looks like the meteor shower's over...."
    p "Parece que la lluvia de estrellas acabó...."

# game/script.rpy:3955
translate es ch7_75d5ddf8:

    # w cute pout "...Take me home...."
    w cute pout "...Llévame a casa...."

# game/script.rpy:3956
translate es ch7_8bb2e9cd:

    # p ehe "A-are you still mad at me...?"
    p ehe "¿S-sigues enojado conmigo...?"

# game/script.rpy:3957
translate es ch7_5b794844:

    # w oops "I'm not mad at you...."
    w oops "No estoy enojado contigo...."

# game/script.rpy:3958
translate es ch7_16f5b969:

    # p aw "I've never seen you like this. I don't know how else I should interpret it."
    p aw "Nunca te había visto así. No sé como más debería interpretarlo."

# game/script.rpy:3959
translate es ch7_f5a91280:

    # w conflicted "I'm overwhelmed. Elated... relieved... and frustrated...."
    w conflicted "Estoy abrumado. Exaltado... aliviado... y frustrado...."

# game/script.rpy:3960
translate es ch7_8b592c68:

    # w ohhh "I-I want to get in bed... so that you can hold me close all night..."
    w ohhh "Q-quiero ir a la cama... para que puedas abrazarme toda la noche..."

# game/script.rpy:3961
translate es ch7_ad678a44:

    # w ohhh2 "I don't think I'll be convinced that this was real unless you do that. So... please...?"
    w ohhh2 "No creo que pueda convencerme de que todo esto fue real si no lo haces. Así que... ¿por favor...?"

# game/script.rpy:3962
translate es ch7_9cd2e04f:

    # p doki "That sounds... really nice...."
    p doki "Eso suena... muy agradable...."

# game/script.rpy:3963
translate es ch7_23f5322d:

    # p happy "Okay ❤ If it's to convince you, I guess I have no choice...."
    p happy "Bueno ❤ si es para convencerte, supongo que no tengo otra opción...."

