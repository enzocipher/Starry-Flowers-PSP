    "Navegando por las estanterías de manuales de hechizos y enciclopedias, me siento algo abrumado..."
    nvl clear

# game/script.rpy:2385
translate es ch5_a61feed8:

    # "But soon, the shopkeeper comes to my aid."
    "Pero pronto, la encargada viene en mi ayuda."

# game/script.rpy:2386
translate es ch5_76b2fe88:

    # nvl clear
    nvl clear

# game/script.rpy:2389
translate es ch5_7486fc1c:

    # r "Good afternoon, Periwinkle! And what might you be looking for today?"
    r "¡Buenas tardes, Periwinkle! ¿Qué podrías estar buscando hoy?"

# game/script.rpy:2390
translate es ch5_c89d618d:

    # r wink "New bottles? A book? Or perhaps... ME? 💙"
    r wink "¿Recipientes nuevos? ¿Un libro? O tal vez... ¿A MÍ? 💙"

# game/script.rpy:2391
translate es ch5_682c05bf:

    # w happy "Amaretti~! It's lovely to see you, but I'm strictly here for business."
    w happy "¡Amaretti~! Me alegra verte, pero estoy aquí estrictamente por negocios."

# game/script.rpy:2392
translate es ch5_69e7637e:

    # r smirk "Playing the professional today, I see. Your loss~"
    r smirk "Haciendo de profesional hoy, ya veo. Tú te lo pierdes~"

# game/script.rpy:2394
translate es ch5_c467d8e2:

    # "Few witches have ever come close to my level of flirty energy, but Amaretti is one of them."
    "Pocas brujas han estado cerca de mi nivel de coquetería, pero Amaretti es una de ellas."

# game/script.rpy:2395
translate es ch5_1860b4ae:

    # "We may have fooled around at a party once or twice, but who's to say~?"
    "Puede que nos hayamos enrollado en una fiesta o dos, ¿pero quién sabe~?"

# game/script.rpy:2396
translate es ch5_3d07a8b4:

    # "As much as her company would be a welcome distraction, I'm afraid removing my self-inflicted curse takes priority."
    "Por más que su compañía sería una buena distracción, me temo que eliminar mi maldición autoinfligida es prioridad."

# game/script.rpy:2397
translate es ch5_639cf832:

    # nvl clear
    # w calm "There IS actually something you can help me with..."
    nvl clear
    w calm "En realidad, HAY algo en lo que puedes ayudarme..."

# game/script.rpy:2400
translate es ch5_87508ba5:

    # w oh "But first, would you happen to know anything about aphrodisiacs?"
    w oh "Pero antes, ¿de casualidad sabes algo sobre afrodisíacos?"

# game/script.rpy:2401
translate es ch5_ada29de2:

    # r tell "Ahh, aphrodisiacs! Magic that sways the heart, stimulates the libido..."
    r tell "¡Ahh, afrodisíacos! Magia que agita el corazón, estimula la libido..."

# game/script.rpy:2402
translate es ch5_78401cad:

    # r no "They DO end up being classified as dark magic because of the manipulative aspects, but..."
    r no "ACABAN siendo clasificados como magia oscura por sus aspectos manipuladores, pero..."

# game/script.rpy:2403
translate es ch5_aaa27385:

    # r wink "A few popular spellbooks happen to contain instructions for consensual usage. Is that what you'd be looking for?"
    r wink "Algunos libros populares de hechizos incluyen instrucciones para su uso consensuado. ¿Es eso lo que buscas?"

# game/script.rpy:2404
translate es ch5_f3b1d738:

    # w guilty "Yes--er, rather, assuming those books also contained instructions for CANCELLING the effects..."
    w guilty "Sí--er, más bien, asumiendo que esos libros también contienen instrucciones para CANCELAR los efectos..."

# game/script.rpy:2405
translate es ch5_b538f47c:

    # r think "Hmm...."
    r think "Hmm...."

# game/script.rpy:2406
translate es ch5_cf23c93b:

    # r smirk "Did something go wrong in the bedroom? You can tell me! Nothing to get embarrassed about~"
    r smirk "¿Algo salió mal en la cama? ¡Puedes decírmelo! No hay nada de qué avergonzarse~"

# game/script.rpy:2407
translate es ch5_1faa2750:

    # w oops "No, it's much more complicated than that..."
    w oops "No, es mucho más complicado que eso..."

# game/script.rpy:2408
translate es ch5_4eb2fa73:

    # w oh "Which spellbooks did you say I could find this information in? I'd like to look through them if possible."
    w oh "¿En qué libros de hechizos dijiste que podía encontrar esa información? Me gustaría revisarlos si es posible."

# game/script.rpy:2409
translate es ch5_1e7e3e3d:

    # r think "Hmmmmmm......"
    r think "Hmmmmmm......"

# game/script.rpy:2410
translate es ch5_c522ed48:

    # r smirk "You're lying to me, aren't you? You just wanna learn these spells to spice things up in the bedroom."
    r smirk "Me estás mintiendo, ¿no? Solo quieres aprender esos hechizos para avivar las cosas en la cama."

# game/script.rpy:2411
translate es ch5_d369f5be:

    # w pout "Not everything is related to sex, Amaretti."
    w pout "No todo tiene que ver con sexo, Amaretti."

# game/script.rpy:2412
translate es ch5_aa4f7e0f:

    # r think "Love, then...? No, you aren't the type...."
    r think "¿Amor, entonces...? No, no eres de ese tipo...."

# game/script.rpy:2413
translate es ch5_9a95397c:

    # r wink "Come on, why won't you just tell me? I can't help if you won't give up any details."
    r wink "Vamos, ¿por qué no solo me lo dices? No puedo ayudar si no das ningún detalle."

# game/script.rpy:2414
translate es ch5_779ec9fd:

    # w oops "All I want to know is whether or not aphrodisiac-induced feelings of romantic love can be nullified...! The details aren't important!"
    w oops "¡Solo quiero saber si los sentimientos de amor romántico inducidos por el afrodisíaco pueden eliminarse...! ¡Los detalles son irrelevantes!"

# game/script.rpy:2415
translate es ch5_30630cc1:

    # r tell "So it IS love...! Hmmmm...... hm, hm, hm. Hmm!"
    r tell "¡Entonces ES amor...! Hmmmm...... hm, hm, hm. ¡Hmm!"

# game/script.rpy:2416
translate es ch5_07ba1235:

    # w insulted "(Why does she insist on wasting my time...?!)"
    w insulted "(¡¿Por qué insiste en hacerme perder el tiempo...?!)"

# game/script.rpy:2419
translate es ch5_bf1c9c82:

    # n "A large, resounding thud from down the aisle startles both Amaretti and Periwinkle."
    n "Un rotundo golpe proveniente del pasillo sobresalta a Amaretti y a Periwinkle."

# game/script.rpy:2420
translate es ch5_18274f1f:

    # n "The pair turns to see a much shorter witch standing there, fuming..."
    n "El par se da vuelta para ver a una bruja mucho más baja parada allí, enfurecida..."

# game/script.rpy:2422
translate es ch5_6dba0f24:

    # u "UGH...! If I have to listen to you two IGNORAMUSES babble on for another second, I am going to LOSE IT!!" with vpunch
    u "¡UGH...! Si tengo que escuchar a ustedes dos IGNORANTES balbucear un segundo más, ¡¡voy a ENLOQUECER!!" with vpunch

# game/script.rpy:2423
translate es ch5_3ffaf986:

    # w ohdear "(There was another customer here...? How long have they been listening?)"
    w ohdear "(¿Había otra clienta aquí...? ¿Cuánto tiempo lleva escuchando?)"

# game/script.rpy:2424
translate es ch5_4e151ed3:

    # u "First off--stop conflating aphrodisiacs and love potions! They're ENTIRELY SEPARATE CATEGORIES!!"
    u "En primer lugar--¡paren de confundir afrodisíacos con pociones de amor! ¡¡Son DE CATEGORÍAS COMPLETAMENTE DISTINTAS!!"

# game/script.rpy:2425
translate es ch5_8e0b52b2:

    # u "A witch who sells POTION SUPPLIES should at least know THAT much! You sell a whole book about it right here!!"
    u "¡Una bruja que vende SUMINISTROS DE POCIONES debería como mínimo saber ESO!"
    u "¡¡Vendes un libro entero de ese tema justo aquí!!"

# game/script.rpy:2426
translate es ch5_32af5759:

    # n "She gestures to the thick tome she had slammed onto the floor at the beginning of her outburst."
    n "Señala el grueso libro que había arrojado al piso al inicio de su arrebato."

# game/script.rpy:2427
translate es ch5_190cea79:

    # r wink "So THAT'S the one I was thinking of...! You'll find everything you need to know about cancelling your love spell in there, Periwinkle."
    r wink "¡Así que ESE es el que estaba pensando...! Ahí encontrarás todo lo que necesitas saber para cancelar tu hechizo de amor, Periwinkle."

# game/script.rpy:2428
translate es ch5_f7c275b4:

    # u "NO!! YOU WON'T!!!" with vpunch
    u "¡¡NO!! NO LO HARÁS!!!" with vpunch

# game/script.rpy:2429
translate es ch5_c74bb768:

    # r uhoh "He won't...?"
    r uhoh "¿No lo hará...?"

# game/script.rpy:2430
translate es ch5_9052ca3c:

    # u "Because it's not a freakin' ~love spell~ to begin with!"
    u "¡Porque no es un maldito ~hechizo de amor~ para empezar!"

# game/script.rpy:2431
translate es ch5_304f62c3:

    # u "I find it MAAAAJORLY unlikely someone's been able to pull off a spell like that, when I've been trying for LITERALLY YEARS!!!!"
    u "{size=-2}Se me hace MUUUUY improbable que alguien lograra hacer un hechizo así, cuando yo lo he estado intentando por LITERALMENTE AÑOS!!!!{/size}"

# game/script.rpy:2432
translate es ch5_b8b3bb86:

    # w happy "Ah... well, thank you! That certainly answers my question!"
    w happy "Ah... bueno, ¡gracias! ¡Eso ciertamente responde a mi pregunta!"

# game/script.rpy:2433
translate es ch5_2897b47f:

    # w my "Since you're familiar with these things, I must ask--if not a love spell, could it have been a side effect of some OTHER type of magic?"
    w my "Ya que estás familiarizada con estas cosas, debo preguntar--"
    w "Si no es un hechizo de amor, ¿pudo haber sido un efecto secundario de algún OTRO tipo de magia?"

# game/script.rpy:2434
translate es ch5_5d616ae4:

    # u "HA...! A side effect... you think it's so easy it could be tacked on, just like that?!"
    u "¡JA...! Un efecto secundario... ¡¿piensas que es tan fácil añadirlo, así sin más?!"

# game/script.rpy:2435
translate es ch5_01652a3d:

    # u "PLACEBO effect is more like it! In which case, all you'd need to do is stop thinking about it, and it'd go away! (Dumbass...)"
    u "¡Sería más bien un efecto PLACEBO! En tal caso, todo lo que tienes que hacer es dejar de pensar en ello, ¡y desaparecerá! (Idiota...)"

# game/script.rpy:2436
translate es ch5_a6530901:

    # w happy "Oh, really~? That saves me so much trouble! Thanks for the advice!"
    w happy "Oh, ¿de verdad~? ¡Eso me ahorra muchos problemas! ¡Gracias por el consejo!"

# game/script.rpy:2437
translate es ch5_15e688b0:

    # u "H-HMPH...! If that shopkeeper woulda done her RESEARCH...."
    u "¡H-HMPH...! Si esa encargada hubiera INVESTIGADO...."

# game/script.rpy:2439
translate es ch5_aa1f8b73:

    # n "The witch's angry shouts fade into placated mumbles as she storms out of the shop."
    n "Los gritos furiosos de la bruja se desvanecen en forma de murmullos mientras abandona la tienda."

# game/script.rpy:2440
translate es ch5_977449e6:

    # r tell "...You handled that so well! You should work in retail."
    r tell "¡...Lo manejaste muy bien! Deberías trabajar como minorista."

# game/script.rpy:2441
translate es ch5_049f717f:

    # w calm "Oh, so I'M the one in need of a new career now...? After THAT exchange?"
    w calm "Oh, ¿ahora soy YO el que necesita un cambio de profesión...? ¿Después de ESA conversación?"

# game/script.rpy:2443
translate es ch5_48d1f5c4:

    # n "Amaretti gives a nervous laugh and steps away to return the spellbook to its proper shelf."
    n "Amaretti ríe nerviosamente y se aparta para devolver el libro de hechizos a su estantería correspondiente."

# game/script.rpy:2444
translate es ch5_c8f75af2:

    # n "After bidding her farewell, Periwinkle exits the store to begin his short walk home..."
    n "Luego de despedirse de ella, Periwinkle sale de la tienda para iniciar su breve camino a casa..."

# game/script.rpy:2448
translate es ch5_c9fa2beb:

    # "A placebo... of course it was just a placebo~!"
    "Un placebo... ¡por supuesto que era solo un placebo~!"

# game/script.rpy:2449
translate es ch5_f8469479:

    # "I should've thought of it sooner. There was never any cause for alarm."
    "Debería habérmelo imaginado. Nunca hubo razones para alarmarse."

# game/script.rpy:2450
translate es ch5_8aca814e:

    # "This is just like before--it has nothing to do with Pastille. He just happens to be the one my mind is fixating on!"
    "Es lo mismo que antes--no tiene nada que ver con Pastille. ¡Da la casualidad de que mi mente justo se fija en él!"

# game/script.rpy:2451
translate es ch5_acc12d29:

    # "It's precisely as that tempermental little witch said: if I stop thinking about him, the problem will resolve on its own 💙"
    "Es precisamente lo que decía esa pequeña bruja temperamental: si dejo de pensar en él, el problema se resolverá por sí solo 💙"

# game/script.rpy:2452
translate es ch5_e74671f6:

    # nvl clear
    # "And so... I must take a few days to focus on myself!"
    nvl clear
    "Así que... ¡Debo tomarme unos días para centrarme en mí mismo!"

# game/script.rpy:2454
translate es ch5_b149db3c:

    # "At least until I can find my way out of this odd state I've ended up in...."
    "Al menos hasta que pueda encontrar la forma de salir de este extraño estado en el que terminé...."

# game/script.rpy:2455
translate es ch5_76b2fe88_1:

    # nvl clear
    nvl clear

# game/script.rpy:2462
translate es ch5_41374bae:

    # n "Operation \"Stop thinking about Pastille\"\nDay 1"
    n "Operación \"Dejar de pensar en Pastille\"\nDía 1"

# game/script.rpy:2464
translate es ch5_78eaa119:

    # w calm "Let's see... the optimal distracting task would be..."
    w calm "Veamos... la mejor actividad distractoria sería..."

# game/script.rpy:2465
translate es ch5_e68a8deb:

    # w happy "Work, of course! Perhaps I could begin with the transforming aroma I thought of yesterday--"
    w happy "¡Trabajar, por supuesto! Podría empezar por el perfume transformador que se me ocurrió ayer--"

# game/script.rpy:2466
translate es ch5_0f9c3a34:

    # w ohdear "Ah, but that idea came about during our date... I should be avoiding any and all memories tied to him at the moment."
    w ohdear "Ah, pero tuve esa idea durante nuestra cita... debería evitar todo tipo de recuerdos relacionados a él por el momento."

# game/script.rpy:2467
translate es ch5_592a73cd:

    # w oops "Hm... this may prove more difficult than I anticipated..."
    w oops "Hm... esto puede ser más difícil de lo que esperaba..."

# game/script.rpy:2468
translate es ch5_fe203ad7:

    # w happy "No matter! I'll just warm up with a nice bergamot scent for now 💙"
    w happy "¡No importa! Por ahora entraré en calor con una agradable esencia de bergamota 💙"

# game/script.rpy:2472
translate es ch5_e1610e30:

    # n "Periwinkle retrieves a few empty vials from his box of perfume supplies, and readies his wand."
    n "Periwinkle toma unos frascos vacíos de su caja de suministros de perfume, y prepara su varita."

# game/script.rpy:2473
translate es ch5_04c3bf1e:

    # n "But instead of the bright green drops he expected, what comes out is a familiar pale pink..."
    n "Pero en lugar de las brillantes gotas verde que esperaba, lo que sale es un reconocible rosa claro..."

# game/script.rpy:2476
translate es ch5_f23df9f2:

    # w ohdear "Peach...? Aha, that isn't right at all...."
    w ohdear "¿Durazno...? Aja, eso no es nada bueno...."

# game/script.rpy:2478
translate es ch5_f23f79a8:

    # n "He seals the bottle and moves on to the next..."
    n "Cierra la botella y pasa a la siguiente..."

# game/script.rpy:2479
translate es ch5_9642d0ad:

    # n "...which, much to his dismay, yields the same result."
    n "...que, para su desgracia, obtiene el mismo resultado."

# game/script.rpy:2480
translate es ch5_f95e4a27:

    # w mad "...."
    w mad "...."

# game/script.rpy:2481
translate es ch5_5d25a848:

    # w oops "Okay. Magic is tied to emotions... I mustn't get frustrated. I have to focus."
    w oops "Bien. La magia se vincula a las emociones... No debo frustrarme. Tengo que concentrarme."

# game/script.rpy:2482
translate es ch5_a5ede285:

    # w decline "Deep breaths. It never helps to force it... just imagine the desired scent, and...."
    w decline "Respira profundo. No sirve de nada forzarlo... solo imagina el aroma deseado, y...."

# game/script.rpy:2485
translate es ch5_a6226304:

    # n "He tries for a third time..."
    n "Lo intenta por tercera vez..."

# game/script.rpy:2486
translate es ch5_818ee6b1:

    # n "...and yet..."
    n "...y sin embargo..."

# game/script.rpy:2489
translate es ch5_9250f26a:

    # w yell "Peach again?!" with vpunch
    w yell "¡¿Durazno otra vez?!" with vpunch

# game/script.rpy:2490
translate es ch5_aec19f40:

    # w pout "This is a waste of supplies. So much for my attempt at diligence...!"
    w pout "Esto es un desperdicio de suministros. ¡Hasta aquí mi intento de diligencia...!"

# game/script.rpy:2491
translate es ch5_2f58dc58:

    # w oops "If I can't conjure other scents, I'll have to find something else to occupy my time...."
    w oops "Si no puedo conjurar otros aromas, tendré que buscar algo distinto para ocupar mi tiempo...."

# game/script.rpy:2492
translate es ch5_c94aab20:

    # w innocent "Ahh, housework! I can finally get some chores done around here~!"
    w innocent "¡Ahh, labores domésticas! ¡Finalmente puedo hacer algunas tareas por aquí~!"

# game/script.rpy:2493
translate es ch5_199d4349:

    # w aha "Nothing could possibly distract me from finishing them today... they ARE the distraction!"
    w aha "Nada podría distraerme de terminarlas hoy... ¡ellas SON la distracción!"

# game/script.rpy:2494
translate es ch5_db67403d:

    # w oh "Oh, that's right! I still had laundry to put away, didn't I?"
    w oh "¡Oh, es cierto! Aún tengo ropa sucia que guardar, ¿no es así?"

# game/script.rpy:2497
translate es ch5_b6cfe690:

    # n "Periwinkle walks into his bedroom to face the pile of clothes he hadn't folded yet."
    n "Periwinkle entra en su habitación para encontrarse con la pila de ropa que tenía sin doblar."

# game/script.rpy:2498
translate es ch5_9af0cc6b:

    # w guilty "Whenever I tell myself I'll get to it later, I tend to leave it for days...."
    w guilty "Siempre que digo que me ocuparé de ello más tarde, tiendo a dejarlo durante días...."

# game/script.rpy:2499
translate es ch5_7561ad39:

    # n "But the single large pile he expected wasn't there. Instead, it was split in two, with one half already neatly folded..."
    n "Pero la única pila grande que esperaba ver no estaba allí. En su lugar, estaba dividida en dos, con una mitad ya doblada impecablemente..."

# game/script.rpy:2500
translate es ch5_7ae4391f:

    # w my "Ah... I don't remember making this much progress...."
    w my "Ah... no recuerdo haber avanzado tanto...."

# game/script.rpy:2501
translate es ch5_8e27678f:

    # w insulted "N-no...! Pastille did this, didn't he?! When he came to pick me up yesterday!!" with vpunch
    w insulted "¡N-no...! Pastille hizo esto, ¡¿no es así?! ¡¡Cuando vino a dejarme ayer!!" with vpunch

# game/script.rpy:2502
translate es ch5_ebbaaa9d:

    # w oops "Curses... he's too good! I can't touch this right now...!"
    w oops "Maldición... ¡es demasiado bueno! ¡Ya no puedo tocar esto...!"

# game/script.rpy:2503
translate es ch5_fabf3693:

    # n "Periwinkle covers the pile of neatly folded clothes with the rest of the unfolded ones in retaliation."
    n "Periwinkle cubre la pila de ropa bien doblada con el resto de la desdoblada para desquitarse."

# game/script.rpy:2504
translate es ch5_7f95d5c9:

    # w aha "There. One less reminder to worry about."
    w aha "Listo. Un recordatorio menos del que preocuparse."

# game/script.rpy:2505
translate es ch5_6d9815d8:

    # w decline "Now I'm going to have to think of something else to do...."
    w decline "Ahora tendré que pensar en otra cosa que hacer...."

# game/script.rpy:2510
translate es ch5_99c1ff41:

    # "So far, my attempts at forgetting about Pastille have been completely futile."
    "Hasta ahora, mis intentos de olvidar a Pastille han sido completamente inútiles."

# game/script.rpy:2511
translate es ch5_80ef4d03:

    # "But that's perfectly fine...! No one said it was going to be easy."
    "¡Pero eso está completamente bien...! Nadie dijo que sería fácil."

# game/script.rpy:2512
translate es ch5_9c18fb74:

    # "Ironically, the more you tell yourself NOT to think of something, the more your mind will be enticed by it...."
    "Irónicamente, mientras más te digas que NO pienses en algo, más incitas a tu mente a hacerlo...."

# game/script.rpy:2513
translate es ch5_896a9911:

    # nvl clear
    # "I mustn't let this consume me. I have to find a way to relax."
    nvl clear
    "No debo dejar que esto me consuma. Tengo que encontrar una forma de relajarme."

# game/script.rpy:2515
translate es ch5_67f5662b:

    # "A nice bath should help to calm my nerves..."
    "Un buen baño debería ayudar a calmar mis nervios..."

# game/script.rpy:2516
translate es ch5_76b2fe88_2:

    # nvl clear
    nvl clear

# game/script.rpy:2521
translate es ch5_142a3147:

    # n "Later that evening..."
    n "Más tarde esa noche..."

# game/script.rpy:2523
translate es ch5_b084a8a3:

    # w shutin happy "I'm feeling so refreshed, I could do just about anything~!"
    w shutin happy "Me siento como nuevo, ¡podría hacer cualquier cosa~!"

# game/script.rpy:2524
translate es ch5_bfecbb7d:

    # w smile "I should try cooking for myself tonight... Now THERE'S a task that'll require my full attention!"
    w smile "Debería intentar cocinarme algo esta noche... ¡Esta SÍ es una tarea que requerirá toda mi atención!"

# game/script.rpy:2525
translate es ch5_5e931d21:

    # n "Periwinkle opens up the fridge for ideas..."
    n "Periwinkle abre el refrigerador en busca de ideas..."

# game/script.rpy:2526
translate es ch5_eb1a4107:

    # w oh "A pint of milk. A few cups of yogurt, some eggs, whipped cream..."
    w oh "Una jarra de leche. Unas tazas de yogur, algunos huevos, crema batida..."

# game/script.rpy:2527
translate es ch5_a167090a:

    # w pout "There isn't much in the way of meals, is there? This is why I never cook..."
    w pout "No hay mucha variedad de comidas, ¿verdad? Es por esto que nunca cocino..."

# game/script.rpy:2528
translate es ch5_c2f55194:

    # w happy "Ah, but I could try making an omelet! Breakfast for dinner~ oh, what fun~"
    w happy "¡Ah, pero podría intentar preparar un omelet! Desayuno para la cena~ oh, qué divertido~"

# game/script.rpy:2531
translate es ch5_b1019ee6:

    # n "Periwinkle cheerfully reaches for the eggs, then pauses."
    n "Periwinkle va alegremente a por los huevos, pero se detiene."

# game/script.rpy:2532
translate es ch5_9393331d:

    # w shutin oh "...Actually. Can I cook without magic...?"
    w shutin oh "...En realidad. ¿Puedo cocinar sin magia...?"

# game/script.rpy:2533
translate es ch5_94dffac0:

    # n "He turns to face the stove."
    n "Se gira hacia la cocina."

# game/script.rpy:2534
translate es ch5_d5bc20eb:

    # w neutral "This burner... is the kind you'd light with a spell."
    w neutral "Esta hornilla... es de las que se encienden con un hechizo."

# game/script.rpy:2535
translate es ch5_5df0ebaf:

    # w oops "I'm far too nervous my magic is going to come out smelling of peaches again..."
    w oops "Me preocupa demasiado que mi magia acabe oliendo a duraznos otra vez..."

# game/script.rpy:2536
translate es ch5_f95e4a27_1:

    # w mad "...."
    w mad "...."

# game/script.rpy:2537
translate es ch5_98438b48:

    # n "Periwinkle slams the fridge shut."
    n "Periwinkle cierra de golpe el refrigerador."

# game/script.rpy:2538
translate es ch5_04db34f2:

    # w innocent "Forget cooking! What was I thinking~? I'm not cut out to be a chef 💙"
    w innocent "¡Olvídate de cocinar! ¿En qué estaba pensando~? No estoy hecho para ser un chef 💙"

# game/script.rpy:2539
translate es ch5_ce61890c:

    # w "(Pastille on the other hand...)"
    w "(Pastille, por otro lado...)"

# game/script.rpy:2540
translate es ch5_72f902e5:

    # w oops "No, no, no...! Thinking of him in this delightful domestic context is ESPECIALLY banned!"
    w oops "¡No, no, no...! ¡Pensar en él en un lindo contexto doméstico está ESPECIALMENTE prohibido!"

# game/script.rpy:2541
translate es ch5_fdc8fc60:

    # w whine "No matter how much I want to eat his cooking now...! He's obviously the type to be good at it...!"
    w whine "¡No importa cuánto quiera probar de su comida...! ¡Obviamente es del tipo que es bueno en eso...!"

# game/script.rpy:2542
translate es ch5_cba66395:

    # w neutral "...."
    w neutral "...."

# game/script.rpy:2543
translate es ch5_351d08ce:

    # w empty "Ahh, this is depressing... I'm already right back to where I started."
    w empty "Ahh, esto es deprimente... ya estoy de vuelta en donde empecé."

# game/script.rpy:2544
translate es ch5_9f77ed17:

    # w sleepy "*sigh* I'll just order takeout...."
    w sleepy "*suspiro* solo pediré algo para llevar...."

# game/script.rpy:2547
translate es ch5_0cc969eb:

    # n "Periwinkle goes to bed that night utterly incapable of forgetting about Pastille."
    n "Periwinkle se va a la cama esa noche completamente incapaz de olvidar de Pastille."

# game/script.rpy:2553
translate es ch5_9d3aad6a:

    # n "Operation \"SERIOUSLY, do not think about that boy!\" - Day 2"
    n "Operación \"¡EN SERIO, no pienses en ese chico!\" - Día 2"

# game/script.rpy:2554
translate es ch5_3e78daf8:

    # "I've tried working... I've tried doing chores... I've even tried to cook! All miserable failures."
    "Intenté trabajar... intenté hacer labores domésticas... ¡incluso intenté cocinar! Todos miserables fracasos."

# game/script.rpy:2555
translate es ch5_cd9bef67:

    # "That's why, today, I'm taking drastic measures: complete escapism!"
    "Por eso, hoy voy a tomar medidas drásticas: ¡escapismo total!"

# game/script.rpy:2556
translate es ch5_5895572f:

    # "I'm returning to my roots. I'll reread one of my favorite series! If nothing else, it should make a nice source of inspiration..."
    "Estoy regresando a mis raíces. ¡Releeré una de mis sagas favoritas! Por lo menos, debería ser una buena fuente de inspiración..."

# game/script.rpy:2557
translate es ch5_7c3c5f99:

    # nvl clear
    # n "Periwinkle pulls out volume one of a certain manga from his bookshelf."
    nvl clear
    n "Periwinkle saca de su estantería el primer tomo de un manga en específico."

# game/script.rpy:2561
translate es ch5_c39703ae:

    # w shutin happy "\"Fabric of our Love\"! How many years has it been~?"
    w shutin happy "¡\"Tejido de nuestro Amor\"! ¿Cuántos años han pasado~?"

# game/script.rpy:2562
translate es ch5_45eda1a9:

    # w love "The dresses were always drawn so beautifully in this series... I still think of them from time to time."
    w love "Los vestidos siempre estaban dibujados de manera hermosa en esta saga... aún me acuerdo de ellos de vez en cuando."

# game/script.rpy:2565
translate es ch5_4ce77425:

    # "It's the story of a girl who's fallen for a handsome prince 💙 Standard fare for the types of manga I read."
    "Es la historia de una chica que se enamora de un apuesto príncipe 💙 Algo típico del tipo de manga que leo."

# game/script.rpy:2566
translate es ch5_c86d4767:

    # "Her mother is a talented seamstress who designs all sorts of dazzling gowns for her to wear... and when the prince sees her in one, he becomes smitten with her!"
    "Su madre es una talentosa costurera que diseña todo tipo de maravillosos vestidos para ella... y cuando el príncipe la vea en uno, ¡quede rendido ante ella!"

# game/script.rpy:2567
translate es ch5_1a90caff:

    # nvl clear
    # "At first, she's in heaven! This is the prince of her dreams~!"
    nvl clear
    "¡Al principio, ella está en el paraíso! ¡Es el príncipe de sus sueños~!"

# game/script.rpy:2569
translate es ch5_ebf04359:

    # "But she soon wonders if the prince is only attracted to the dresses, the glamour... and not the poor girl underneath."
    "Pero pronto se pregunta si al príncipe solo le atraen los vestidos, el glamour...  y no la pobre chica que hay debajo."

# game/script.rpy:2570
translate es ch5_bbca257f:

    # "Until the prince reveals... ah, I shouldn't spoil it! 💙 The ending is too sweet~!"
    "Hasta que el príncipe revela... ¡ah, no debería hacer spoiler! 💙 ¡El final es tan dulce~!"

# game/script.rpy:2571
translate es ch5_8ea6ec16:

    # nvl clear
    # n "After admiring the cover art for a while, Periwinkle finally opens the book and begins to read."
    nvl clear
    n "Luego de contemplar la portada durante un rato, Periwinkle finalmente abre el libro y empieza a leer."

# game/script.rpy:2575
translate es ch5_558ae81a:

    # w shutin love "Just as lovely as I remember... such delicate linework...."
    w shutin love "Tan hermoso como lo recordaba... qué trazo tan delicado...."

# game/script.rpy:2576
translate es ch5_c6240c65:

    # w calm "I wouldn't blame that prince for noticing the dresses before the girl. They really are so beautiful."
    w calm "No culparía a ese príncipe por fijarse en los vestidos antes que en la chica. Son realmente muy hermosos."

# game/script.rpy:2577
translate es ch5_63862a4b:

    # w oh "Come to think of it, the way this prince is drawn..."
    w oh "Ahora que lo pienso, la forma en que este príncipe está dibujado..."

# game/script.rpy:2578
translate es ch5_130cf072:

    # w "His short, fluffy hair, his gentle features... remind me of..."
    w "Su cabello corto y esponjoso, sus facciones delicadas... me recuerdan a..."

# game/script.rpy:2581
translate es ch5_6e0c6c75:

    # n "Periwinkle closes the book in a panic."
    n "Periwinkle cierra el libro en pánico."

# game/script.rpy:2583
translate es ch5_30eaa72d:

    # w shutin mad "That was dangerous. I can't risk even thinking his name...!"
    w shutin mad "Eso fue peligroso. ¡Ni siquiera puedo arriesgarme a pensar en su nombre...!"

# game/script.rpy:2584
translate es ch5_f09961e7:

    # w whine "Ahh, and there's even a later chapter where he's dressed in servants' clothing! There are too many parallels...!"
    w whine "Ahh, ¡e incluso hay un capítulo más adelante donde se viste con ropa de sirviente! ¡Hay demasiadas similitudes...!"

# game/script.rpy:2585
translate es ch5_41e8eb06:

    # n "Periwinkle rolls across his bed and slides the book back into its place on his shelf."
    n "Periwinkle rueda por su cama y devuelve el libro a su lugar en la estantería."

# game/script.rpy:2586
translate es ch5_5b74eeff:

    # w pout "This isn't fair... how can one of my most beloved series be off-limits in my time of need...?"
    w pout "No es justo... ¿cómo puedo tener que prohibirme una de mis sagas favoritas cuando la necesito...?"

# game/script.rpy:2587
translate es ch5_8b1d5778:

    # n "He scans through the different titles once more, before landing on a 12-volume series..."
    n "Vuelve a revisar los diferentes libros, antes de aterrizar en una saga de 12 volúmenes..."

# game/script.rpy:2589
translate es ch5_f3715939:

    # w neutral "I don't remember this one as clearly... but as an all-girls story, it should be safe...."
    w neutral "Este no lo recuerdo tan claramente... pero como es una historia solo de chicas, debería ser segura...."

# game/script.rpy:2591
translate es ch5_57ab056b:

    # n "Periwinkle pulls the new book from his shelf, and quietly immerses himself in its fictional world..."
    n "Periwinkle saca el nuevo libro de su estantería, y se sumerge en silencio dentro de su mundo ficticio..."

# game/script.rpy:2595
translate es ch5_0630a164:

    # "Before I knew it, I'd finished reading all 12 volumes. The whole day had flown right by."
    "Antes de darme cuenta, había terminado de leer los 12 volúmenes. El día entero se pasó volando."

# game/script.rpy:2596
translate es ch5_7bca8e7b:

    # "I couldn't help but keep turning the pages... the story was so much more than I remembered!"
    "No pude evitar seguir pasando las páginas... ¡la historia era mucho mejor de lo que recordaba!"

# game/script.rpy:2597
translate es ch5_34844c79:

    # "The protagonist was nothing to write home about, but her childhood friend? Ah, what a moving character arc...!"
    "La protagonista no era nada del otro mundo, ¿pero su amiga de la infancia? Ah, ¡qué arco de personaje tan conmovedor...!"

# game/script.rpy:2598
translate es ch5_33580eee:

    # nvl clear
    # "She's very charismatic from the start. The kind of person you'd think has it all figured out... but you couldn't be more wrong!"
    nvl clear
    "Es muy carismática desde el inicio. El tipo de persona que pensarías que tiene todo bajo control... ¡pero no podrías estar más equivocado!"

# game/script.rpy:2600
translate es ch5_49da7a6c:

    # "Over the course of the series, she goes through so many love interests... back in the day, I had assumed it was because the author couldn't make up their mind!"
    "En el transcurso de la saga, pasa por muchos intereses amorosos... ¡en su momento, pensaba que era porque el autor no se podía decidir!"

# game/script.rpy:2601
translate es ch5_e0af319b:

    # nvl clear
    # "But reading it all at once, it must've been planned from the beginning... these doomed relationships are merely self-sabotage! A distraction from pursuing her one true love!"
    nvl clear
    "Pero al leerlo todo seguido, debió estar planeado desde el principio... ¡estas relaciones fallidas no son más que un autosabotaje! ¡Una distracción de perseguir a su único y verdadero amor!"

# game/script.rpy:2603
translate es ch5_9828e662:

    # "She never realizes the obvious answer until the very end...! And what an emotional finale!"
    "¡No se da cuenta de la respuesta obvia hasta el final...! ¡Y qué final tan emotivo!"

# game/script.rpy:2604
translate es ch5_967fea48:

    # "When she finally confesses, and the two girls share their first kiss...!"
    "¡Cuando finalmente se confiesa, y ambas chicas comparten su primer beso...!"

# game/script.rpy:2605
translate es ch5_a29c652c:

    # nvl clear
    # w shutin love "Ah~! The fireworks!! Could anything be more romantic?!" with vpunch
    nvl clear
    w shutin love "¡Ah~! ¡¡Los fuegos artificiales!! ¡¿Puede haber algo más romántico?!" with vpunch

# game/script.rpy:2608
translate es ch5_bf1c8f6a:

    # w happy "Her tears of happiness...! Finally being honest with herself, and with her best friend...! How lovely!"
    w happy "¡Sus lágrimas de felicidad...! ¡Finalmente es honesta consigo misma, y con su mejor amiga...! ¡Qué adorable!"

# game/script.rpy:2609
translate es ch5_bab1bf08:

    # w calm "The well of loneliness that is her character was portrayed so flawlessly... she's the most real of them all."
    w calm "La soledad que caracteriza a su personaje fue plasmada a la perfección... es la más real de todas."

# game/script.rpy:2610
translate es ch5_3c397fdf:

    # w love "Ending the story any other way would've been an injustice. She deserves the world...!"
    w love "Que la historia terminara de otra manera hubiera sido una injusticia. ¡Ella merece el mundo...!"

# game/script.rpy:2611
translate es ch5_4f0b1bd8:

    # w oh "Hmm... I own this author's follow-up series as well, don't I...?"
    w oh "Hmm... también tengo otras sagas de este autor, ¿no...?"

# game/script.rpy:2612
translate es ch5_7b7b7eff:

    # w happy "Time to get some snacks and start searching for it 💙 I can't resist diving in right away~!"
    w happy "Hora de ir por unos bocadillos y ponerse a buscarlas 💙 ¡No me resisto a engancharme ya mismo~!"

# game/script.rpy:2616
translate es ch5_e43c6f26:

    # n "Operation \"Escape reality\" - Day 3"
    n "Operación \"Escape de la realidad\" - Día 3"

# game/script.rpy:2617
translate es ch5_f8a47392:

    # n "Periwinkle continued to read..."
    n "Periwinkle siguió leyendo..."

# game/script.rpy:2621
translate es ch5_18ee21a7:

    # n "...and read..."
    n "...y leyendo..."

# game/script.rpy:2625
translate es ch5_577f25be:

    # n "...and read."
    n "...y leyendo."

# game/script.rpy:2627
translate es ch5_6b9ceb2b:

    # n "Until he heard a knock at his door."
    n "Hasta que escuchó un llamado a la puerta."

# game/script.rpy:2629
translate es ch5_eb6b9ef1:

    # w shutin oh "(Pastille...? No, that isn't his knock.)"
    w shutin oh "(¿Pastille...? No, esa no es su forma de golpear.)"

# game/script.rpy:2630
translate es ch5_add831c5:

    # w oops "(Ah, wait--I was trying to forget about him!)"
    w oops "(Ah, espera--¡Estaba intentando olvidarme de él!)"

# game/script.rpy:2631
translate es ch5_49e273c0:

    # w oh "(Though I suppose it means I was successful for a while... I even forgot that I was avoiding something to begin with....)"
    w oh "(Aunque supongo que significa que lo logré durante un rato... incluso olvidé que estaba evitando algo para empezar....)"

# game/script.rpy:2637
translate es ch5_3fd120b3:

    # n "When he opens the door, Periwinkle is greeted by a small crowd of friends and acquaintances."
    n "Al abrir la puerta, Periwinkle es recibido por una pequeña multitud de amigos y conocidos."

# game/script.rpy:2640
translate es ch5_24c4f6ca:

    # h "Periwinkle~! Get dressed, we're hitting the clubs!"
    h "¡Periwinkle~! ¡Vístete, nos vamos a los clubes!"

# game/script.rpy:2641
translate es ch5_2c561f37:

    # w shutin happy "Wow~ the whole cavalry's arrived!"
    w shutin happy "Wow~ ¡toda la pandilla está aquí!"

# game/script.rpy:2642
translate es ch5_ccfacf58:

    # w love "Unfortunately, I'm going to have to decline... tonight isn't going to work for me."
    w love "Lamentablemente, tendré que rechazar... esta noche no será para mí."

# game/script.rpy:2643
translate es ch5_0c4017c9:

    # h "Whaaat~?! But no one's seen you in AGES! You haven't abandoned us for a new scene, have you?"
    h "¡¿Queeé~?! ¡Pero nadie te ha visto en AÑOS! No nos estarás cambiando, ¿verdad?"

# game/script.rpy:2644
translate es ch5_547f416c:

    # w guilty "Oh, nothing like that... I've just been a little preoccupied. I'm taking some time to myself at the moment."
    w guilty "Oh, nada de eso... solo he estado algo ocupado. Estoy tomándome un tiempo para mí mismo por ahora."

# game/script.rpy:2645
translate es ch5_1bc1c398:

    # h "Nothing wrong with a little self-care, but... are you suuure you don't wanna come out and enjoy the night life?"
    h "No está mal un poco de autocuidado, pero... ¿estás seguuuro de que no quieres salir y disfrutar de la vida nocturna?"

# game/script.rpy:2646
translate es ch5_e857923b:

    # w love "Ahh, I don't know... I've fallen so far behind on my work."
    w love "Ahh, no lo sé... he estado muy retrasado con mi trabajo."

# game/script.rpy:2647
translate es ch5_87ce4ec9:

    # h "Choosing work over getting laid? Now I KNOW something's up with you!"
    h "¿Escogiendo el trabajo antes que tirar? ¡Ahora SÉ que te pasa algo!"

# game/script.rpy:2648
translate es ch5_7d59c83b:

    # w happy "How offensive~! I have more going on than just going out and flirting with everyone I meet!"
    w happy "¡Qué ofensivo~! ¡Tengo más cosas que hacer que salir y coquetear con cualquiera que me encuentre!"

# game/script.rpy:2649
translate es ch5_c159c59e:

    # h "Haahaha! Of course, of course~!"
    h "¡Jaajaja! ¡Claro, claro~!"

# game/script.rpy:2650
translate es ch5_87163668:

    # w calm "I do appreciate the invitation, though. Thank you for thinking of me."
    w calm "Aún así, agradezco la invitación. Gracias por pensar en mí."

# game/script.rpy:2651
translate es ch5_d75fa27b:

    # h "We just had to come and make sure you were still alive. The clubs are lonely without you~!"
    h "Teníamos que venir y asegurarnos de que siguieras vivo. ¡Los clubes se sienten solos sin ti~!"

# game/script.rpy:2652
translate es ch5_5fa75dc3:

    # w happy "I'll have to make my grand return some other time, then. Have a lovely evening~!"
    w happy "Tendré que hacer mi gran regreso en otro momento, entonces. ¡Tengan una maravillosa noche~!"

# game/script.rpy:2655
translate es ch5_84d367b4:

    # n "The group waves goodbye and disappears into the night..."
    n "El grupo se despide y desaparece en la oscuridad..."

# game/script.rpy:2659
translate es ch5_1fb460c7:

    # w shutin calm "Hmhm... it's been a while since I've had to turn them down...."
    w shutin calm "Hmhm... hace mucho que no tenía que rechazarlos...."

# game/script.rpy:2660
translate es ch5_bd0d5988:

    # n "Periwinkle leans his back against the door and sighs."
    n "Periwinkle se apoya contra la puerta y suspira."

# game/script.rpy:2662
translate es ch5_a96c004e:

    # "I'm definitely not in any state to go clubbing right now."
    "Definitivamente no estoy en condiciones de salir de fiesta ahora mismo."

# game/script.rpy:2663
translate es ch5_8fa632dc:

    # "No matter how much it warms my heart to know that I am missed, I won't be making the same mistake as the other night!"
    "No importa cuánto me enternezca saber que me extrañan, ¡No cometeré el mismo error que la otra noche!"

# game/script.rpy:2664
translate es ch5_ab8d7c49:

    # "I can't go recklessly diving into the comforting arms of another as long as my mind is still hung up on Pastille..."
    "No puedo ir imprudentemente a refugiarme en los brazos de alguien más mientras mi mente sigue atrapada en Pastille..."

# game/script.rpy:2665
translate es ch5_31e9e456:

    # nvl clear
    # "But how long will I remain in this state?"
    nvl clear
    "¿Pero por cuánto tiempo seguiré en este estado?"

# game/script.rpy:2667
translate es ch5_87296cd0:

    # "Shutting myself away, binge-reading comics..."
    "Aislándome, leyendo cómics compulsivamente..."

# game/script.rpy:2668
translate es ch5_6ab20be7:

    # "These were emergency measures. I can't avoid the outside world forever."
    "Esas fueron medidas de emergencia. No puedo evitar el mundo exterior para siempre."

# game/script.rpy:2669
translate es ch5_091fa9e2:

    # nvl clear
    # "In any case, shouldn't Pastille be returning here at some point?"
    nvl clear
    "En todo caso, ¿No debería Pastille volver aquí en algún momento?"

# game/script.rpy:2671
translate es ch5_ee826e83:

    # "From where we left off, I'd have expected him to come knocking as soon as possible!"
    "Desde donde lo dejamos, ¡esperaba que apareciera en la puerta lo antes posible!"

# game/script.rpy:2672
translate es ch5_16870329:

    # "And yet... it's been three full days now, hasn't it?"
    "Y sin embargo... han pasado tres días enteros, ¿no?"

# game/script.rpy:2673
translate es ch5_efc836eb:

    # "How long could he possibly abstain from my touch! Or is something wrong...?"
    "¡Cuánto tiempo podría abstenerse de mi tacto! ¿O algo anda mal...?"

# game/script.rpy:2674
translate es ch5_282afc69:

    # nvl clear
    # "I shouldn't be thinking about any of this... but I'm beginning to feel..."
    nvl clear
    "No debería estar pensando en todo esto... pero empiezo a sentirme...."

# game/script.rpy:2676
translate es ch5_bb1c3e4d:

    # "Annoyed? Confused...?"
    "¿Molesto? ¿Confundido...?"

# game/script.rpy:2677
translate es ch5_82208e45:

    # nvl clear
    # w shutin conflicted "(If he never comes back, I suppose my problem would go away on its own...)"
    nvl clear
    w shutin conflicted "(Si nunca regresa, supongo que mi problema desaparecería por sí solo...)"

# game/script.rpy:2680
translate es ch5_7082d627:

    # w oops "(But I hate the thought of that. As things are now, I'd only be haunted by thoughts of what I could've possibly done wrong.)"
    w oops "(Pero odio esa idea. Por como están las cosas, solo me atormentaría con pensamientos de qué es lo que pude haber hecho mal.)"

# game/script.rpy:2681
translate es ch5_6a2ef4f7:

    # w empty "(What IS my plan, then? Continue to ping-pong back and forth between these extreme emotional states?)"
    w empty "(¿CUÁL es mi plan, entonces? ¿Seguir alternando entre estos estados emocionales extremos?)"

# game/script.rpy:2682
translate es ch5_eba87ac9:

    # n "He rubs his eyes in exhaustion."
    n "Se frota los ojos con cansancio."

# game/script.rpy:2683
translate es ch5_e4efba8a:

    # w sleepy "...I'll worry about this tomorrow...."
    w sleepy "...Me preocuparé de esto mañana...."

# game/script.rpy:2685
translate es ch5_4025cec7:

    # n "Periwinkle steps back into his room and tucks himself into bed with his books..."
    n "Periwinkle regresa a su habitación y se mete en la cama con sus libros..."

# game/script.rpy:2691
translate es ch5_9fbba0e4:

    # n "But an hour later... another knock comes."
    n "Pero una hora después... vuelven a llamar a la puerta."

# game/script.rpy:2692
translate es ch5_48a3bbb2:

    # n "This time, the pattern is unmistakable."
    n "Esta vez, el patrón es inconfundible."

# game/script.rpy:2693
translate es ch5_5b483588:

    # w shutin ah "(Pastille is here....)"
    w shutin ah "(Pastille está aquí....)"

# game/script.rpy:2695
translate es ch5_5a00cde9:

    # "Well, well, well..."
    "Bueno, bueno, bueno..."

# game/script.rpy:2696
translate es ch5_5f55459f:

    # "So he's come after all."
    "Así que vino después de todo."

# game/script.rpy:2697
translate es ch5_16205056:

    # nvl clear
    # "Despite all my hard work of trying to forget..."
    nvl clear
    "Después de todo mi esfuerzo por intentar olvidarlo..."

# game/script.rpy:2699
translate es ch5_5eb7e5c9:

    # "I've actually been waiting for this moment, haven't I?"
    "En realidad he estado esperando este momento, ¿no es así?"

# game/script.rpy:2700
translate es ch5_b9f40f3e:

    # "I don't care what these feelings might mean anymore. I'm tired of fighting them."
    "Ya no me importa lo que puedan significar estos sentimientos. Estoy cansado de pelear con ellos."

