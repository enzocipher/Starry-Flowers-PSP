translate es ch6_4d52c35b:

    # "The problem now is what to DO about it...."
    "El problema ahora es qué HACER al respecto...."

# game/script.rpy:2902
translate es ch6_76b2fe88_1:

    # nvl clear
    nvl clear

# game/script.rpy:2905
translate es ch6_b4d687b8:

    # p "Weird question, but..."
    p "Pregunta rara, pero..."

# game/script.rpy:2906
translate es ch6_36c7f47d:

    # p shy "Would you want to... um..."
    p shy "¿Te gustaría... um..."

# game/script.rpy:2907
translate es ch6_1e42307e:

    # w pj innocent "(Date you? Yes!!)"
    w pj innocent "(¿Salir contigo? ¡¡Sí!!)"

# game/script.rpy:2908
translate es ch6_1977ea6f:

    # p seriously "...Clean the rest of your house together?" with vpunch
    p seriously "...limpiar el resto de la casa juntos?" with vpunch

# game/script.rpy:2909
translate es ch6_4cd578fd:

    # w ohdear "...Hm?"
    w ohdear "¿...Hm?"

# game/script.rpy:2910
translate es ch6_bdf3c1ab:

    # p shy "I-it'll be more fun than it sounds! And if you get bored, we can do something else..."
    p shy "¡S-será más divertido de lo que suena! Y si te aburres, podemos hacer otra cosa..."

# game/script.rpy:2911
translate es ch6_a76308ac:

    # w calm "Pastille..."
    w calm "Pastille..."

# game/script.rpy:2912
translate es ch6_80a12d07:

    # p embarrassed "I just thought if we did it together, you'd get a say in where everything goes, so nothing ends up getting lost...!"
    p embarrassed "¡Solo pensé que si lo hacíamos juntos, podrías decidir en dónde va todo, y así nada acabaría perdiéndose...!"

# game/script.rpy:2913
translate es ch6_ee213eff:

    # w love "Pastille...!"
    w love "¡Pastille...!"

# game/script.rpy:2914
translate es ch6_c8b7db60:

    # p ehe2 "And it's totally fine if you don't want me going through your stuff anymore. We really don't have to--"
    p ehe2 "Y está completamente bien si no quieres que siga hurgando entre tus cosas. Realmente no tenemos que--"

# game/script.rpy:2915
translate es ch6_38742bdf:

    # w happy "Pastille, it's fine! I think it's a lovely idea."
    w happy "¡Pastille, está bien! Pienso que es una idea encantadora."

# game/script.rpy:2916
translate es ch6_d3b99301:

    # p wha "R-really...?"
    p wha "¿D-de verdad...?"

# game/script.rpy:2917
translate es ch6_d5f25738:

    # w innocent "Yes. In fact, I'd appreciate your help."
    w innocent "Sí. De hecho, apreciaría tu ayuda."

# game/script.rpy:2918
translate es ch6_4ba187a4:

    # w love "One thing or another has always come up when I try to clean on my own. I'm simply useless at it."
    w love "Siempre surge una cosa u otra cuando intento limpiar por mi cuenta. Simplemente soy inútil en eso."

# game/script.rpy:2919
translate es ch6_c049910d:

    # p happy "Then... I'll take the lead! I wanted to start with these boxes by the couch..."
    p happy "Entonces... ¡yo llevaré el mando! Quería empezar con estas cajas junto al sofá..."

# game/script.rpy:2923
translate es ch6_98446b5c:

    # "Pastille already had a plan for everything, it seemed."
    "Pastille ya tenía un plan en mente, al parecer."

# game/script.rpy:2924
translate es ch6_80b953ec:

    # "His energy was contagious. He was right that it would be fun--it was entertaining even just watching him go."
    "Su energía era contagiosa. Tenía razón en que sería divertido--incluso era entretenido verlo ir de un lado a otro."

# game/script.rpy:2925
translate es ch6_8e73e0b2:

    # "To see him dart around the room so energetically, finding the perfect place for every little thing..."
    "Verlo moverse por la habitación con tanta energía, encontrando el lugar perfecto para cada pequeña cosa..."

# game/script.rpy:2926
translate es ch6_f19b7285:

    # "He truly has a talent for organization."
    "Realmente tiene un don para la organización."

# game/script.rpy:2927
translate es ch6_8bb41e57:

    # nvl clear
    # "Meanwhile, I mostly played the role of assistant."
    nvl clear
    "Mientras tanto, yo cumplía principalmente el rol de asistente."

# game/script.rpy:2929
translate es ch6_a1ad8874:

    # "He would ask for my input every now and then, or instruct me to place something he found somewhere across the room."
    "De vez en cuando pedía mi opinión, o me indicaba que pusiera algo que se encontraba en algún lado de la habitación."

# game/script.rpy:2930
translate es ch6_092cda92:

    # "He made little decisions like that so easily. If it were me, I'd get stuck on every one..."
    "Tomaba pequeñas decisiones como esa con mucha facilidad. Si fuera yo, me atascaría en cada una de ellas..."

# game/script.rpy:2931
translate es ch6_48fd29c3:

    # "But he saw everything through, effortlessly. It was nothing short of amazing."
    "Pero se ocupó de todo, sin esfuerzo. Era nada menos que fascinante."

# game/script.rpy:2932
translate es ch6_8d433bab:

    # nvl clear
    # n "And so, in a short few hours..."
    nvl clear
    n "Y así, en unas pocas horas..."

# game/script.rpy:2938
translate es ch6_80154118:

    # n "...The entire house had become neat and tidy."
    n "...La casa entera quedó limpia y ordenada."

# game/script.rpy:2941
translate es ch6_fe44cae1:

    # p "Okay... I think I'm satisfied. You?"
    p "Bien... creo que estoy satisfecho. ¿Y tú?"

# game/script.rpy:2942
translate es ch6_9e685ed1:

    # w pj shy "Hmm~ don't you think you deserve to be rewarded for all your hard work? 💙"
    w pj shy "Hmm~ ¿no crees que mereces ser recompensado por tu arduo trabajo? 💙"

# game/script.rpy:2943
translate es ch6_876e21b0:

    # p uhoh "Ah--I-I should've seen that one coming...!"
    p uhoh "Ah--D-debí haber visto eso venir...!"

# game/script.rpy:2944
translate es ch6_09a70627:

    # p shy "But no, not right now! I should actually get going...."
    p shy "¡Pero no, no ahora! De hecho, debería irme ya...."

# game/script.rpy:2945
translate es ch6_4a104fcf:

    # w smile "You won't stay?"
    w smile "¿No vas a quedarte?"

# game/script.rpy:2946
translate es ch6_7477ec63:

    # p smile "I promised Gumdrop I'd be back for the afternoon shift. She'll start to worry if I don't come back soon."
    p smile "Le prometí a Gumdrop que volvería para el turno de tarde. Empezará a preocuparse si no regreso pronto."

# game/script.rpy:2947
translate es ch6_7efae89a:

    # w calm "Hmhm... I'll save your reward for next time, then."
    w calm "Hmhm... guardaré tu recompensa para la próxima, entonces."

# game/script.rpy:2950
translate es ch6_ebdb2310:

    # n "Pastille slips on his jacket and shoes."
    n "Pastille se pone su chaqueta y sus zapatos."

# game/script.rpy:2951
translate es ch6_4a339e2c:

    # n "Just before he leaves, he turns back to face Periwinkle..."
    n "Justo antes de irse, se gira hacia Periwinkle..."

# game/script.rpy:2954
translate es ch6_931329ba:

    # p "By the way, um... I was thinking..."
    p "Por cierto, um... estaba pensando..."

# game/script.rpy:2955
translate es ch6_97a64bda:

    # w pj "Yes...?"
    w pj "¿Sí...?"

# game/script.rpy:2956
translate es ch6_55b62f87:

    # p oh "There are some days my friends travel out of town. For alchemy stuff."
    p oh "Algunos días mis amigas viajan fuera de la ciudad. Para cosas de alquimia."

# game/script.rpy:2957
translate es ch6_5634565b:

    # p shy "So if you ever wanted to drop by while I'm working on those days... I think that'd be okay..."
    p shy "Así que si uno de esos días quieres pasarte mientras trabajo... creo que estaría bien..."

# game/script.rpy:2958
translate es ch6_9d4854d5:

    # p ehe "That's, um... the most I can do right now... sorry."
    p ehe "Eso es, um... todo lo que puedo hacer por ahora... lo siento."

# game/script.rpy:2959
translate es ch6_41c1209f:

    # w happy "I'll gladly take you up on that! I'd love to keep you company 💙"
    w happy "¡Con gusto lo aceptaré! Me encantaría hacerte compañía 💙"

# game/script.rpy:2960
translate es ch6_8fc6bb84:

    # p smile "Great! Okay, then...."
    p smile "¡Genial! Bien, entonces...."

# game/script.rpy:2964
translate es ch6_7cabd49b:

    # n "Pastille gives him a quick peck on the cheek..."
    n "Pastille le da un beso fugaz en la mejilla..."

# game/script.rpy:2966
translate es ch6_3305bee7:

    # n "...before saying goodbye, and walking out the door."
    n "...antes de despedirse y salir por la puerta."

# game/script.rpy:2971
translate es ch6_7969eade:

    # w pj wow "...."
    w pj wow "...."

# game/script.rpy:2973
translate es ch6_c71484d3:

    # "What... WAS all of that?"
    "¿Qué... FUE todo eso?"

# game/script.rpy:2974
translate es ch6_77393381:

    # "It was extremely domestic! I can't be imagining things, can I?"
    "¡Fue extremadamente doméstico! No puedo estar imaginando cosas, ¿verdad?"

# game/script.rpy:2975
translate es ch6_a79fc5b9:

    # "He said it was okay... to come and visit him...?"
    "¿Dijo que estaba bien... que fuera a visitarlo...?"

# game/script.rpy:2976
translate es ch6_3ed40c2c:

    # "That has to mean something, doesn't it?"
    "Eso tiene que significar algo, ¿no es así?"

# game/script.rpy:2977
translate es ch6_b3442fd3:

    # nvl clear
    # w pj nofair "......"
    nvl clear
    w pj nofair "......"

# game/script.rpy:2980
translate es ch6_d0687ab0:

    # n "Periwinkle begins pacing around the room."
    n "Periwinkle comienza a pasearse por la habitación."

# game/script.rpy:2982
translate es ch6_ee66677e:

    # "Now, now... let's not get carried away."
    "Ya, ya... no te dejes llevar."

# game/script.rpy:2983
translate es ch6_da436e71:

    # "This is a delicate situation. Dropping these intense feelings onto him out of nowhere may only serve to scare him off."
    "Esta es una situación delicada. Dejar salir estos fuertes sentimientos de la nada solo conseguirá asustarlo."

# game/script.rpy:2984
translate es ch6_9440b0fe:

    # "Neither of us was looking for a committed relationship from the beginning--that was made explicitly clear early on!"
    "Ninguno de los dos estaba buscando una relación seria desde el principio--¡eso fue aclarado de forma explícita!"

# game/script.rpy:2985
translate es ch6_43ab76b1:

    # "And yet... and yet...!"
    "¡Y aún así... y aún así...!"

# game/script.rpy:2986
translate es ch6_6333e45c:

    # nvl clear
    # w nofair2 "He isn't playing fair...! My heart can't take this!"
    nvl clear
    w nofair2 "¡No está jugando limpio...! ¡Mi corazón no puede soportar esto!"

# game/script.rpy:2989
translate es ch6_027ff050:

    # n "Periwinkle throws himself onto the couch dramatically."
    n "Periwinkle se tira dramáticamente en el sofá."

# game/script.rpy:2990
translate es ch6_e25e9729:

    # w pj yell "There's no way I'll be able to stop thinking of him now... even being at home has become a reminder in and of itself...!"
    w pj yell "Ya no hay forma de que pueda dejar de pensar en él... ¡hasta el hecho de estar en casa se convirtió en un recordatorio...!"

# game/script.rpy:2991
translate es ch6_08637e4e:

    # w nofair "Everything is nice because of him! And now I'm suffering...!!"
    w nofair "¡Todo es lindo por su culpa! ¡¡Y ahora estoy sufriendo...!!!"

# game/script.rpy:2993
translate es ch6_c2595cfb:

    # "This is simply too much..."
    "Es simplemente demasiado..."

# game/script.rpy:2994
translate es ch6_b7a26f25:

    # "There has to be a way for me to safely indulge in these romantic feelings."
    "Tiene que haber alguna forma de poder disfrutar de estos sentimientos románticos a salvo."

# game/script.rpy:2995
translate es ch6_f0e953fa:

    # "Things are fine as they are. Progressing, even."
    "Las cosas están bien como están. Progresando, incluso."

# game/script.rpy:2996
translate es ch6_8a9f8371:

    # "If I just let it run its natural course, then maybe we'll end up..."
    "Si dejo que esto siga su ruta natural, puede que acabemos terminando..."

# game/script.rpy:2997
translate es ch6_74c39862:

    # nvl clear
    # "Ah... what do I want out of this?"
    nvl clear
    "Ah... ¿qué es lo que quiero de esto?"

# game/script.rpy:2999
translate es ch6_d0086124:

    # "To be with him forever? ME?!"
    "¿Estar con él para siempre? ¡¿YO?!"

# game/script.rpy:3000
translate es ch6_54531ff3:

    # "I haven't had a single healthy long-term relationship in my entire life! Love isn't in the cards for someone like me..."
    "¡No he tenido ni una relación sana y duradera en toda mi vida! El amor no está en las cartas para alguien como yo..."

# game/script.rpy:3001
translate es ch6_de6de606:

    # "Ugh, I... I can't even recognize myself right now...!"
    "Ugh, yo... ¡ni siquiera puedo reconocerme en este momento...!"

# game/script.rpy:3002
translate es ch6_c71bbc8b:

    # nvl clear
    # w decline "*sigh* ...Calm down."
    nvl clear
    w decline "*suspiro* ...Cálmate."

# game/script.rpy:3004
translate es ch6_e31dafc0:

    # w neutral "I'm overreacting again. Nothing has effectively changed just yet."
    w neutral "De nuevo estoy exagerando. Por ahora nada ha cambiado con certeza."

# game/script.rpy:3006
translate es ch6_ac683799:

    # "I can't keep fighting myself on this..."
    "No puedo seguir luchando contra mí mismo al respecto..."

# game/script.rpy:3007
translate es ch6_58b7973a:

    # "I'm in love with Pastille--No matter what it entails, that's the reality."
    "Estoy enamorado de Pastille--No importa lo que implique, esa es la realidad."

# game/script.rpy:3008
translate es ch6_77ae6378:

    # "He still isn't quite ready for me to meet his friends, which means... there isn't any room to advance further at the moment."
    "Aún no está listo para que conozca a sus amigas, lo que significa... que no hay chances de avanzar más por el momento."

# game/script.rpy:3009
translate es ch6_82b36bbd:

    # "I have to be patient."
    "Tengo que ser paciente."

# game/script.rpy:3010
translate es ch6_1b1e1fde:

    # nvl clear
    # w empty "At the very least, I hope accepting all this lets my magic return to normal..."
    nvl clear
    w empty "Por lo menos, espero que aceptar todo esto haga que mi magia vuelva a la normalidad..."

# game/script.rpy:3012
translate es ch6_aab52ef0:

    # w sleepy "*sigh* ...I need a nap."
    w sleepy "*suspiro* ...necesito una siesta."

# game/script.rpy:3017
translate es ch6_4bc6b794:

    # n "And so, over the next few weeks..."
    n "Y así, durante las semanas siguientes..."

# game/script.rpy:3019
translate es ch6_ed3721c2:

    # n "Periwinkle would come by Atelier Sweets to spend time with Pastille."
    n "Periwinkle pasaría por Atelier Sweets para pasar tiempo con Pastille."

# game/script.rpy:3031
translate es ch6_650246fd:

    # "He always stood there so sweetly behind the counter."
    "Siempre estaba allí adorablemente detrás del mostrador."

# game/script.rpy:3032
translate es ch6_038e0033:

    # "And then I would waltz in, pretending to be just another customer, browsing the aisles before meandering over to him..."
    "Y entonces entraba, pretendiendo ser un cliente más, recorriendo los pasillos antes de acercarme a él..."

# game/script.rpy:3034
translate es ch6_958370f1:

    # "Others would stop in every now and again, but there was ample time in which I had him completely to myself 💙"
    "Algunos se acercaban de vez en cuando, pero gran parte del tiempo lo tenía solo para mí 💙"

# game/script.rpy:3035
translate es ch6_cc1ef0c4:

    # "That's when I'd take the opportunity to chat..."
    "Ahí es cuando aprovecho la oportunidad para conversar..."

# game/script.rpy:3036
translate es ch6_76b2fe88_2:

    # nvl clear
    nvl clear

# game/script.rpy:3038
translate es ch6_372a5a1f:

    # w calm "Hmhm, this place smells just like you, my sweet~"
    w calm "Hmhm, este lugar huele como tú, dulzura~"

# game/script.rpy:3039
translate es ch6_f8395ebd:

    # p ehe "I think it's the other way around... d-do I smell like candy or something?"
    p ehe "Creo que es al revés... ¿h-huelo a dulce o algo así?"

# game/script.rpy:3040
translate es ch6_504d2a88:

    # w happy "Why else do you think I want to eat you up?"
    w happy "¿Por qué más crees que quiero comerte?"

# game/script.rpy:3041
translate es ch6_c62c6083:

    # p omg "A-aaahh...! Please don't say things like that when there are customers here!" with vpunch
    p omg "¡A-aaahh...! ¡Por favor no digas cosas así cuando hay clientes aquí!" with vpunch

# game/script.rpy:3042
translate es ch6_d4eebef7:

    # w oh "Customers? I don't see anyone."
    w oh "¿Clientes? Yo no veo a nadie."

# game/script.rpy:3043
translate es ch6_726b4f8e:

    # p flustered "I-I know, I mean... just, in general...."
    p flustered "L-lo sé, quiero decir... en general...."

# game/script.rpy:3044
translate es ch6_fde4125f:

    # w love "You don't want to get turned on at work? 💙"
    w love "¿No quieres calentarte en el trabajo? 💙"

# game/script.rpy:3045
translate es ch6_bbf2a841:

    # p scream "THAT!! THAT'S NOT ALLOWED!!!" with vpunch
    p scream "¡¡ESO!! ¡¡NO ESTÁ PERMITIDO!!" with vpunch

# game/script.rpy:3048
translate es ch6_8f5a93ed:

    # "Our exchanges were mostly innocent, unlike other partners I've paid visits to in the past."
    "Nuestras conversaciones eran en su mayoría inocentes, a diferencia de otras parejas a las que he visitado en el pasado."

# game/script.rpy:3049
translate es ch6_0ec556fd:

    # "He was very adamant about not fooling around at work..."
    "Él era muy inflexible sobre no coquetear en el trabajo..."

# game/script.rpy:3050
translate es ch6_67128253:

    # "Not that it ever stopped me from teasing him about it 💙"
    "No es como si me impidiera molestarlo por eso 💙"

# game/script.rpy:3051
translate es ch6_078fe372:

    # nvl clear
    # centered "{nw}"
    nvl clear
    centered "{nw}"

# game/script.rpy:3058
translate es ch6_edfaa106:

    # n "Periwinkle watches as Pastille, armed with a rag and a bottle of cleaner, sprays down the counter in front of him."
    n "Periwinkle observa como Pastille, con paño y limpiador en mano, rocía el mostrador frente a él."

# game/script.rpy:3059
translate es ch6_a7891201:

    # w happy "Hmhm... I think I underestimated your love of cleaning."
    w happy "Hmhm... creo que subestimé tu amor por la limpieza."

# game/script.rpy:3060
translate es ch6_417ae944:

    # p shy "Are you making fun of me? This is my job, y'know...."
    p shy "¿Te estás burlando de mí? Es mi trabajo, ya sabes...."

# game/script.rpy:3061
translate es ch6_bc08a037:

    # w love "Oh~ should I have paid you when you cleaned my house?"
    w love "Oh~ ¿debí haberte pagado cuando limpiaste mi casa?"

# game/script.rpy:3062
translate es ch6_216856b4:

    # p sure "I'll send you an invoice."
    p sure "Te enviaré una factura."

# game/script.rpy:3063
translate es ch6_6a5c5d4d:

    # w happy "Could I pay you in kisses?"
    w happy "¿Puedo pagarte con besos?"

# game/script.rpy:3064
translate es ch6_772ce41a:

    # p omgstop "That's...! Hard to turn down, actually...." with vpunch
    p omgstop "¡Eso es...! Difícil de rechazar, en realidad...." with vpunch

# game/script.rpy:3067
translate es ch6_3c3687df:

    # "It was fun seeing him hard at work."
    "Fue divertido verlo trabajar duro."

# game/script.rpy:3068
translate es ch6_82255766:

    # "The only side of him most people would ever be aware of."
    "El único lado de él que la mayoría de gente puede conocer."

# game/script.rpy:3069
translate es ch6_ed8ea56f:

    # "They'll never know of the lust bubbling beneath the surface. His nervous, vulnerable laughter when I've said something he wanted to hear..."
    "Nunca sabrán del deseo que oculta en su interior. Su risa nerviosa y vulnerable cuando le digo algo que quería escuchar..."

# game/script.rpy:3070
translate es ch6_a0b0a92b:

    # nvl clear
    # "His gentle touch. The way he can take my hand so casually, and yet becomes a stuttering mess as soon as I lean over him..."
    nvl clear
    "Su suave tacto. La forma en que toma mi mano tan casualmente, y que sin embargo se vuelve un manojo de nervios apenas me acerco a él..."

# game/script.rpy:3072
translate es ch6_e3045e18:

    # "His sense of humor. His sincerity. His quirks."
    "Su sentido del humor. Su sinceridad. Sus particularidades."

# game/script.rpy:3073
translate es ch6_cb504fb4:

    # "His genuine desire to always provide the exact perfect thing to make me smile..."
    "Su genuino deseo de siempre darme la cosa exacta para hacerme sonreír..."

# game/script.rpy:3074
translate es ch6_fdebbc43:

    # "No... the depths of Pastille are reserved for me alone 💙"
    "No... la intimidad de Pastille está reservada solo para mí 💙"

# game/script.rpy:3075
translate es ch6_078fe372_1:

    # nvl clear
    # centered "{nw}"
    nvl clear
    centered "{nw}"

# game/script.rpy:3085
translate es ch6_8921453e:

    # w "Welcome to Atelier Sweets~!"
    w "¡Bienvenido a Atelier Sweets~!"

# game/script.rpy:3086
translate es ch6_89278b3d:

    # n "Periwinkle gives a little twirl and winks to Pastille, who's trying his best to stifle his laughter."
    n "Periwinkle hace un leve giro y le guiña un ojo a Pastille, quien se esfuerza por aguantar la risa."

# game/script.rpy:3089
translate es ch6_dea29edc:

    # w uniform smile "How was that? Do you think it suits me?"
    w uniform smile "¿Cómo estuvo? ¿Crees que me queda bien?"

# game/script.rpy:3090
translate es ch6_e23b1f70:

    # p ehe "Not in the slightest... you're too elegant for a place like this."
    p ehe "Ni en lo mas mínimo... eres muy elegante para un lugar como este."

# game/script.rpy:3091
translate es ch6_17331e15:

    # w happy "I can be cute, too, can't I?"
    w happy "Puedo ser lindo también, ¿no?"

# game/script.rpy:3092
translate es ch6_fe4a5b77:

    # p sure "You are... but you're gonna need more than that on your résumé if you want the job."
    p sure "Lo eres... pero vas a necesitar más que eso en tu currículum si quieres el trabajo."

# game/script.rpy:3093
translate es ch6_cd4c0960:

    # w love "What, you mean I can't get in through nepotism alone?"
    w love "¿Quieres decir que no puedo conseguirlo solo con nepotismo?"

# game/script.rpy:3094
translate es ch6_5b776cb9:

