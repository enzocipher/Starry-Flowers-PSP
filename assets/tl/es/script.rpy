translate es ch3_a6272f66:

    # w pout "...Hm. I'm almost disappointed."
    w pout "...Hm. Estoy algo decepcionado."

# game/script.rpy:1203
translate es ch3_8b7cde78:

    # w oh "It's been so consistent, up until now. I suppose he could just be THAT forgetful..."
    w oh "Había sido tan consistente hasta ahora. Supongo que simplemente podría ser ASÍ de olvidadizo..."

# game/script.rpy:1206
translate es ch3_fcb994ab:

    # "Unable to find anything of Pastille's in my bedroom, I decide to spend the rest of the morning cleaning up the place."
    "Incapaz de encontrar algo de Pastille en mi habitación, decido pasar el resto de la mañana limpiando mi casa."

# game/script.rpy:1207
translate es ch3_c3a58deb:

    # "Now, mind you, I never let my house get DIRTY... only messy."
    "Eso sí, nunca dejo que la casa se ENSUCIE... solo que esté desordenada."

# game/script.rpy:1208
translate es ch3_03008cfa:

    # "Leaving garbage or food waste about is out of the question."
    "Dejar por ahí basura o restos de comida es algo impensable."

# game/script.rpy:1209
translate es ch3_a4f20100:

    # "Everything else, though..."
    "Sin embargo, todo lo demás..."

# game/script.rpy:1210
translate es ch3_1b81cc77:

    # nvl clear
    # "It's simply that many things don't make it back to their proper place. Or rather, I can never decide on a proper place for many of my things..."
    nvl clear
    "Es solo que muchas cosas no regresan al lugar que les corresponde. O mejor dicho, nunca puedo decidir un lugar adecuado para muchas de mis cosas..."

# game/script.rpy:1212
translate es ch3_e63b1b71:

    # "Toss them into boxes, shuffle the boxes around the room, and suddenly they've become unmanageable piles..."
    "Guárdalas en cajas, espárcelas por la habitación, y de pronto se convierten en montones inmanejables..."

