    n "Con una mano sujeta su capa, y con la otra aparta ansiosamente su flequillo..."

# game/script.rpy:419
translate es start_21398492:

    # w smile "Is this your first time?"
    w smile "¿Es tu primera vez?"

# game/script.rpy:420
translate es start_db90c8f0:

    # p wha "Huh...?"
    p wha "¿Ah...?"

# game/script.rpy:421
translate es start_c33cac40:

