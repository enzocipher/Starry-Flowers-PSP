    # "We finish up our meals, and decide on sharing a slice of strawberry cheesecake for dessert."
    "Terminamos nuestra comida, y decidimos compartir un trozo de tarta de queso con fresas de postre."

# game/script.rpy:527
translate es start_d1910196:

    # "Pastille deliberately leaves the larger bits of strawberries for me..."
    "Pastille deja intencionalmente la mayor parte de fresas para mí..."

# game/script.rpy:528
translate es start_014b42bb:

    # "I wonder, is it because he doesn't like them? Or is he just THAT kind?"
    "Me pregunto, ¿Es porque no le gustan? ¿O solo es TAN amable?"

# game/script.rpy:529
translate es start_a37124b7:

    # "Either way, this has quickly become my most favorite date of the past few months 💙"
    "En todo caso, esta rápidamente se ha convertido en mi cita favorita de los últimos meses 💙"

# game/script.rpy:530
translate es start_76b2fe88_5:

    # nvl clear
    nvl clear

# game/script.rpy:534
translate es start_a47a6a63:

    # w smile "Tell me more about yourself, Pastille. I'm afraid the only thing I know is that you work at the renowned Atelier Sweets..."
    w smile "Cuéntame más sobre ti, Pastille. Me temo que lo único que sé es que trabajas en el renombrado Atelier Sweets..."

# game/script.rpy:535
translate es start_a256d276:

    # p ehe "Oh, um... there's not much else to know...."
    p ehe "Oh, um... no hay mucho más que decir...."

# game/script.rpy:536
translate es start_b5d5581a:

    # w happy "Surely there's plenty more than just that! Any hobbies, perhaps?"
    w happy "¡Seguro hay mucho más que solo eso! ¿Algún pasatiempo, quizás?"

# game/script.rpy:537
translate es start_ff0c91f6:

    # p shy "C...cleaning, maybe?"
    p shy "L...limpiar, ¿Tal vez?"

# game/script.rpy:538
translate es start_323445d9:

    # w calm "Any NON work-related hobbies, dear."
    w calm "Algún pasatiempo NO relacionado al trabajo, querido."

# game/script.rpy:539
translate es start_452a98f0:

    # p ehe2 "Sorry, I never know how to answer these types of questions..."
    p ehe2 "Lo siento, nunca sé cómo responder a ese tipo de preguntas..."

# game/script.rpy:540
translate es start_bd8b2307:

    # p smile "My best friend is an alchemist, so I've recently been going on little adventures to help gather ingredients for her craft."
    p smile "{size=-4}Mi mejor amiga es alquimista, por lo que recientemente he ido en pequeñas aventuras para ayudarla a conseguir ingredientes para su trabajo.{/size}"

# game/script.rpy:541
translate es start_6c670493:

    # w my "Now THERE'S something interesting!"
    w my "¡Eso SÍ es algo interesante!"

# game/script.rpy:542
translate es start_e955536c:

    # p shy "Other than that, I honestly don't get out much... I have my hands full running the store."
    p shy "Fuera de eso, honestamente no salgo mucho... Siempre estoy muy ocupado encargándome de la tienda."

# game/script.rpy:543
translate es start_d04e37c7:

    # w smile "So diligent 💙 Does that mean this is your first night out in a while?"
    w smile "Tan aplicado 💙 ¿Eso significa que es tu primera noche fuera en mucho tiempo?"

# game/script.rpy:544
translate es start_03f245f3:

    # p oh "Ah... yeah, I guess it is."
    p oh "Ah... sí, supongo que lo es."

# game/script.rpy:545
translate es start_97012fb5:

    # w innocent "I'm honored you were willing to share it with me, then~"
    w innocent "Me honra que estuvieras dispuesto a compartirla conmigo, entonces~"

# game/script.rpy:546
translate es start_8c01ab99:

    # p shy "Yeah! I don't think I ever would've tried this place if you hadn't brought me in..."
    p shy "¡Sí! creo que nunca habría probado este lugar si no me hubieras traído..."

# game/script.rpy:547
translate es start_ddcf714a:

    # p ehe "So... it's been worth it so far. Thanks, Periwinkle."
    p ehe "Así que... ha valido la pena hasta ahora. Gracias, Periwinkle."

# game/script.rpy:553
translate es start_79c59f28:

    # "The table had long been cleared, and yet our conversation continued through the night."
    "Desde hace rato la mesa estaba despejada, y aún así nuestra conversación continuó durante la noche."

# game/script.rpy:554
translate es start_1efc9d29:

    # "This place is never too busy, which always leaves me free to linger here without the guilt of taking up any much-needed table space."
    "Este lugar nunca está muy lleno, lo cual siempre me da la libertad de quedarme sin miedo de estar ocupando un espacio de las mesas muy necesario."
    nvl clear

# game/script.rpy:555
translate es start_b7237054:

    # "The longer the date, the more satisfying the finale 💙 That's something I live by."
    "Mientras más larga la cita, más satisfactorio es el final 💙 Eso es algo por lo que vivo."

# game/script.rpy:556
translate es start_6ec3835a:

    # "Rushing straight to the climax inevitably gets a bit dull after a while. I want to enjoy this night to its fullest 💙"
    "Irse directamente al clímax se vuelve inevitablemente aburrido después de un tiempo. Quiero disfrutar de esta noche al máximo 💙"

# game/script.rpy:557
translate es start_76b2fe88_6:

    # nvl clear
    nvl clear

# game/script.rpy:560
translate es start_2ff85601:

    # w love "Hmhmhm... Pastille... do you see the witch at that table over there?"
    w love "Hmhmhm... Pastille... ¿Ves a la bruja de la mesa de allí?"

# game/script.rpy:561
translate es start_8185ca92:

    # p neutral "Hm...?"
    p neutral "¿Hm...?"

# game/script.rpy:563
translate es start_9f7508ef:

    # w happy "Don't be too obvious, now. The one with the tall hat, you see...?"
    w happy "No seas tan obvio. Del sombrero alto, ¿ves...?"

# game/script.rpy:564
translate es start_69f4106c:

    # p uhoh "Ah... y-yeah, I see them."
    p uhoh "Ah... s-sí, le veo."

# game/script.rpy:565
translate es start_e8772676:

    # w teehee "I brought them here about two weeks ago. I guess they agreed that it made a nice date spot!"
    w teehee "Le traje aquí hace unas dos semanas. ¡Supongo que estuvo de acuerdo en que era un buen lugar para una cita!"

# game/script.rpy:566
translate es start_b7da8094:

    # p ehe2 "Hahaha... I, um... I actually..."
    p ehe2 "Jajaja... yo, um... en realidad..."

# game/script.rpy:567
translate es start_b052a575:

    # p uhoh "Th-the guy sitting across from them... I'm pretty sure I've been with him before."
    p uhoh "E-el chico que está sentado en frente suyo... estoy bastante seguro de que he estado con él antes."

# game/script.rpy:569
translate es start_9590f34f:

    # w my "NO... surely, you're joking, Pastille!"
    w my "NO... ¡debes estar bromeando, Pastille!"

# game/script.rpy:570
translate es start_d1b5f16c:

    # p omgstop "SH-SHHHH!!! Don't say my name so loudly...!"
    p omgstop "¡¡¡SH-SHHHH!!! ¡No digas mi nombre tan fuerte...!"

# game/script.rpy:571
translate es start_2eb04fd0:

    # w happy "Just keep your head low, I'm sure he won't notice."
    w happy "Solo mantén la cabeza baja, estoy seguro de que no se dará cuenta."

# game/script.rpy:572
translate es start_ffe0c64f:

    # w oh "...Oh, he's just looked this way."
    w oh "...Oh, acaba de mirar hacia acá."

# game/script.rpy:573
translate es start_50c22d14:

    # p scream "AAAAAHH...!!!" with vpunch
    p scream "¡¡¡AAAAAHH...!!!" with vpunch

# game/script.rpy:574
translate es start_f4ea47ed:

    # w teehee "Only kidding 💙"
    w teehee "Solo bromeo 💙"

# game/script.rpy:575
translate es start_e2427086:

    # p flustered "P-Peri...!!"
    p flustered "¡¡P-Peri...!!"

# game/script.rpy:576
translate es start_fc329306:

    # w shy "Ooh, a nickname already? We're moving so fast..."
    w shy "Ooh, ¿ya un apodo? Estamos avanzando tan rápido..."

# game/script.rpy:577
translate es start_212fa4c4:

    # p seriously "You're the one who's been calling me \"my sweet\" all night...!"
    p seriously "¡Tú eres el que ha estado llamándome \"dulzura\" toda la noche...!"

# game/script.rpy:578
translate es start_3e500425:

    # w oh "Well, you are, aren't you? Whose fault is it that you share a name with candy?"
    w oh "Bueno, lo eres, ¿no? ¿Quién tiene la culpa de que compartas nombre con un dulce?"

# game/script.rpy:579
translate es start_54dcfd58:

    # p shout "Not mine!!"
    p shout "¡¡No es mi culpa!!"

# game/script.rpy:580
translate es start_bb5f7312:

    # w smile "Still. Do you think those two make a good couple?"
    w smile "En fin. ¿Crees que esos dos hacen una buena pareja?"

# game/script.rpy:581
translate es start_831b1ea7:

    # p flustered2 "How should I know...?!"
    p flustered2 "¿¡Cómo voy a saber...!?"

# game/script.rpy:582
translate es start_b2b6228d:

    # w happy "Just imagine the kind of person I'd go on a date with, and pair them with the other!"
    w happy "¡Imagina el tipo de persona con la que yo tendría una cita, y emparéjala con el otro!"

# game/script.rpy:583
translate es start_9fb1f04a:

    # p shy "And what kind of person is that...?"
    p shy "¿Y qué tipo de persona es esa...?"

# game/script.rpy:584
translate es start_33e2c8d5:

    # w innocent "You, for one 💙"
    w innocent "Tú, por ejemplo 💙"

# game/script.rpy:585
translate es start_adb706d7:

    # p ehe "Pfft--maybe they wouldn't be so good together..."
    p ehe "Pfft--puede que no estén tan bien juntos..."

# game/script.rpy:586
translate es start_43faf218:

    # w oh "My, am I supposed to take offense to that?"
    w oh "Oh, ¿Se supone que debo ofenderme por eso?"

# game/script.rpy:587
translate es start_881b271e:

    # p smile "Nah, that guy was just kinda pushy."
    p smile "Nah, solo ese chico era algo molesto."

# game/script.rpy:588
translate es start_bbb521cf:

    # w happy "Hmhm... ahaha, you're too much, Pastille!"
    w happy "Hmhm... ajaja, ¡eres demasiado, Pastille!"

# game/script.rpy:594
translate es start_4554f13a:

    # "We eventually made our way out of the restaurant that night..."
    "Finalmente salimos del restaurante esa noche..."

# game/script.rpy:595
translate es start_7211b97d:

    # "It had gotten quite late already. When's the last time I stayed until closing...?"
    "Ya se había hecho bastante tarde. ¿Cuándo fue la última vez que me quedé hasta el cierre...?"

# game/script.rpy:596
translate es start_bc63f4b9:

    # "There was never a moment of awkward silence between us. Only Pastille's embarrassed pauses--clear attempts to steer his mind away from debauchery 💙"
    "Nunca hubo un silencio incómodo entre nosotros. Solo las pausas avergonzadas de Pastille--evidentes intentos de alejar su mente del libertinaje 💙"
    nvl clear

# game/script.rpy:597
translate es start_1f9c5254:

    # "As we wander back into the night air, he's the first to speak up again..."
    "Cuando regresamos al aire nocturno, es el primero en volver a hablar..."

# game/script.rpy:598
translate es start_76b2fe88_7:

    # nvl clear
    nvl clear

# game/script.rpy:601
translate es start_a046c557:

    # p "You could've at least let me cover the tip..."
    p "Podrías al menos haberme dejado cubrir la propina..."

# game/script.rpy:602
translate es start_bbd42092:

    # w innocent "Nonsense. I'm the one who asked you out tonight, you don't have to cover a thing."
    w innocent "Tonterías. Yo soy el que te invitó a salir esta noche, no tienes que cubrir ningún gasto."

# game/script.rpy:603
translate es start_ffe053ec:

    # p anxious "...."
    p anxious "...."

# game/script.rpy:604
translate es start_14e8a9bb:

    # w teehee "In fact, I'd prefer if you DIDN'T cover--"
    w teehee "De hecho, preferiría que NO cubrieras--"

# game/script.rpy:605
translate es start_d7542b15:

    # p omg "Okay, I saw that one coming this time! Y-you don't have to say it..." with vpunch
    p omg "De acuerdo, ¡Lo vi venir esta vez! N-no tienes que decirlo..." with vpunch

# game/script.rpy:606
translate es start_ddc15564:

    # w happy "Too easy, hm? Ahaha~"
    w happy "Muy fácil, ¿hm? Ajaja~"

# game/script.rpy:607
translate es start_b2f2809d:

    # w smile "But really, it's a shame to hide such a cute outfit from the world 💙"
    w smile "Pero en serio, es una pena esconder un atuendo tan lindo al mundo 💙"

# game/script.rpy:608
translate es start_71e4cdd4:

    # p ehe "I-I don't have the confidence..."
    p ehe "N-no tengo la confianza..."

# game/script.rpy:609
translate es start_00c0a8d9:

    # w shy "Ahh. Reminds me of my youth..."
    w shy "Ahh. Me recuerda a mi juventud..."

# game/script.rpy:610
translate es start_151a84c5:

    # w smile "You'll get there, my sweet. One day, you'll be able to toss aside any feelings of inadequacy, and wear all sorts of daring outfits with pride!"
    w smile "{size=-4}Lo lograrás, dulzura. Algún día, podrás dejar de lado cualquier sentimiento de insuficiencia, ¡y llevarás todo tipo de atuendos atrevidos con orgullo!{/size}"

# game/script.rpy:611
translate es start_e98f9e49:

    # p neutral "N-no, it's not a matter of self esteem or anything. It's just..."
    p neutral "N-no, no es cuestión de autoestima ni nada. Es solo..."

# game/script.rpy:612
translate es start_e62d49d4:

    # p embarrassed "If anyone I knew saw me in this, I would die."
    p embarrassed "Si alguien que conozco me viera en esto, moriría."

# game/script.rpy:615
translate es start_c0d59d1c:

    # "So that's how it is, hm~?"
    "¿Así es como es, hm~?"

# game/script.rpy:616
translate es start_7db31c84:

    # "I'm being treated to a more intimate side of this witch boy right now 💙"
    "Este brujo está mostrándome un lado más íntimo de sí mismo 💙"

# game/script.rpy:617
translate es start_ca35036d:

    # "We walk together under the street lights, until we reach our original meeting place..."
    "Caminamos juntos bajo las luces de la calle, hasta llegar a nuestro punto de encuentro original..."

# game/script.rpy:618
translate es start_76b2fe88_8:

    # nvl clear
    nvl clear

# game/script.rpy:622
translate es start_ae339b7f:

    # w oh "Would you like me to escort you home?"
    w oh "¿Quieres que te acompañe a casa?"

# game/script.rpy:623
translate es start_0cb1f383:

    # p wha "N-no, that's okay..."
    p wha "N-no, está bien..."

# game/script.rpy:624
translate es start_56666e95:

    # w smile "Then, if you don't mind... my place is just down the street."
    w smile "Entonces, si no te importa... mi casa está justo al final de la calle."

# game/script.rpy:625
translate es start_f4615b4a:

    # w innocent "Perhaps you'd like to accompany me?"
    w innocent "¿Quizás te gustaría acompañarme?"

# game/script.rpy:626
translate es start_21bf7ae8:

    # p embarrassed "Yes--I mean... I wouldn't want you to have to walk alone in the dark."
    p embarrassed "Sí--Es decir... No quisiera que tuvieras que caminar solo en la oscuridad."

# game/script.rpy:627
translate es start_de097d15:

    # w calm "Such a gentleman 💙"
    w calm "Todo un caballero 💙"

# game/script.rpy:632
translate es start_d36a9b3e:

    # n "Periwinkle expertly slides his hand up and under Pastille's mantle, linking arms as they go along."
    n "Periwinkle desliza hábilmente su mano sobre y debajo de la capa de Pastille, entrelazando sus brazos a medida que avanzan."

# game/script.rpy:633
translate es start_1353eaa8:

    # n "They walk in comfortable silence, toward Periwinkle's house..."
    n "Caminan en un cómodo silencio, dirigiéndose a la casa de Periwinkle..."

# game/script.rpy:639
translate es start_94642492:

    # w calm "Well, this is me..."
    w calm "Bueno, aquí estamos..."

# game/script.rpy:640
translate es start_78aeb21b:

    # w innocent "I had a most lovely evening. Thank you for accompanying me to dinner tonight 💙"
    w innocent "Tuve una velada encantadora. Gracias por acompañarme a cenar esta noche 💙"

# game/script.rpy:641
translate es start_59d5d240:

    # p wha "I-I had fun, too... thanks for inviting me out."
    p wha "T-también me divertí... gracias por invitarme a salir."

# game/script.rpy:643
translate es start_5e0cd997:

    # n "Pastille fidgets as if he has something to ask, but can't find the words."
    n "Pastille parece inquietarse como si tuviera algo que preguntar, pero no encuentra las palabras."

# game/script.rpy:645
translate es start_915dfd7a:

    # w smile "Pastille."
    w smile "Pastille."

# game/script.rpy:647
translate es start_c33092e1:

    # n "Periwinkle takes a step closer."
    n "Periwinkle da un paso más cerca."

# game/script.rpy:649
translate es start_b2502cf7:

    # p "Y-yes...?"
    p "¿S-sí...?"

# game/script.rpy:654
translate es start_6f64de6b:

    # n "He leans in, pausing for any sort of reaction..."
    n "Se inclina, deteniéndose ante cualquier tipo de reacción..."

# game/script.rpy:656
translate es start_d62e590f:

    # n "...only for Pastille's lips to come clumsily crashing forward."
    n "...solo para que los labios de Pastille avanzaran torpemente."

# game/script.rpy:659
translate es start_5d610763:

    # w drool "(He's in more of a rush than I thought...!)"
    w drool "(¡Tiene más prisa de lo que pensaba...!)"

# game/script.rpy:660
translate es start_f378704d:

    # w shy "(Then again, I DID spend all night winding him up....)"
    w shy "(Por otro lado, PASÉ toda la noche provocándolo....)"

# game/script.rpy:663
translate es start_d5c67421:

    # p "...."
    p "...."

# game/script.rpy:664
translate es start_446d0040:

    # w love "(So cute...! 💙)"
    w love "(¡Tan lindo...! 💙)"

# game/script.rpy:665
translate es start_79e2b8c5:

    # w oh "Ah, Pastille... I just remembered."
    w oh "Ah, Pastille... acabo de recordar."

# game/script.rpy:666
translate es start_ba66744e:

    # w innocent "Since we're here... would you like to come in and sample some of my magic?"
    w innocent "Ya que estamos aquí... ¿Te gustaría entrar y probar algo de mi magia?"

# game/script.rpy:667
translate es start_c82fd8a6:

    # p kyaa "I-I'd like that, yes...!"
    p kyaa "¡M-me gustaría, sí...!"

# game/script.rpy:668
translate es start_3cf70de4:

    # w calm "Very well, then 💙"
    w calm "Muy bien, entonces 💙"

# game/script.rpy:671
translate es start_38a91372:

    # "We both knew from the beginning that he would be staying the night, of course."
    "Ambos sabíamos que pasaría la noche aquí desde un inicio, por supuesto."

# game/script.rpy:672
translate es start_073ddabd:

    # "It's just so much more fun drawing it out like this... 💙"
    "Solo que es mucho más divertido hacerlo de esta forma... 💙"

# game/script.rpy:673
translate es start_90128a54:

    # "Ah, but if that kiss is any indication of things to come... I may have gone a little overboard tonight."
    "Ah, pero si ese beso es una indicación de lo que vendrá... puede que me haya excedido un poco esta noche."

# game/script.rpy:674
translate es start_3dc4f1af:

    # "If so... we're in for quite a sleepover 💙"
    "Si es así... nos espera una gran noche juntos 💙"

# game/script.rpy:675
translate es start_76b2fe88_9:

    # nvl clear
    nvl clear

# game/script.rpy:681
translate es start_889df456:

    # w calm "Sorry about the mess. I just haven't found the time to tidy up~"
    w calm "Lamento el desorden. Es solo que no he encontrado el tiempo de ordenar~"

# game/script.rpy:682
translate es start_ef3726ee:

    # w oh "{nw}"
    w oh "{nw}"

# game/script.rpy:684
translate es start_91d784bf:

    # n "The door closes loudly behind them. When Pastille doesn't respond, Periwinkle turns back to face him..."
    n "La puerta a sus espaldas se cierra con un fuerte ruido. Al Pastille no responder, Periwinkle se gira para verlo..."

# game/script.rpy:690
translate es start_00b95dae:

    # n "Pastille's back is against the door as he fumbles to untie his mantle."
    n "Pastille está de espaldas contra la puerta mientras intenta desatar torpemente su capa."

# game/script.rpy:694
translate es start_09ae6c7c:

    # w drool "(He's completely run out of patience, hasn't he...!)"
    w drool "(Se le ha acabado completamente la paciencia, al parecer...!)"

# game/script.rpy:695
translate es start_9c346134:

    # w shy "(Then I'm afraid I simply have no choice but to indulge him~)"
    w shy "(Pues me temo que no tengo más opción que complacerlo~)"

# game/script.rpy:700
translate es start_033d605a:

    # w "Hmhm, I shouldn't keep you waiting a second longer, now should I?"
    w "Hmhm, no debería hacerte esperar ni un segundo más, ¿verdad?"

# game/script.rpy:701
translate es start_4a130bfc:

    # p "M-mn...!"
    p "¡M-mn...!"

# game/script.rpy:703
translate es start_90ffdfad:

    # w "Ah, but I still need to change into something a little easier to take off..."
    w "Ah, pero aún tengo que ponerme algo más fácil de quitar..."

# game/script.rpy:704
translate es start_6e757cc4:

    # w "Looking this good comes at a price, you see. I promise I won't keep you waiting."
    w "Verás, verse así de bien tiene un precio. Prometo que no te haré esperar."

# game/script.rpy:705
translate es start_827e34fc:

    # p "O-okay..."
    p "B-bien..."

# game/script.rpy:708
translate es start_66ce2a36:

    # n "Periwinkle gives him another peck on the lips, and leads him through the cluttered living room to his bedroom door..."
    n "Periwinkle le da otro beso en los labios, y lo lleva por la desordenada sala de estar a la puerta de su habitación..."

# game/script.rpy:721
translate es ch2_7b49a2da:

    # centered "{w=3}{nw}"
    centered "{w=3}{nw}"

# game/script.rpy:727
translate es ch2_420c2aa2:

    # "It took me ages to get out of bed that morning."
    "Me tomó años levantarme de la cama esa mañana."

# game/script.rpy:728
translate es ch2_d9e096c6:

    # "After all... I just couldn't stop thinking about how absolutely adorable Pastille was! 💙"
    "Después de todo... ¡No podía dejar de pensar en lo increíblemente adorable que era Pastille! 💙"

# game/script.rpy:729
translate es ch2_7c711ce7:

    # "He scrambled out of here almost as soon as he woke up, saying he couldn't be late for work..."
    "Se fue de aquí apenas se despertó, diciendo que no podía llegar tarde al trabajo..."
    nvl clear

# game/script.rpy:730
translate es ch2_e5f82cff:

    # "Such a shame. Would've been nice to get one last round in~"
    "Es una pena. Una última ronda no hubiera estado mal~"

# game/script.rpy:731
translate es ch2_a69cdafc:

    # "...I did get a kiss goodbye, though 💙"
    "...me dio un beso de despedida, aún así 💙"

# game/script.rpy:732
translate es ch2_79c07e86:

    # nvl clear
    # w bed shy "Ahh, it's nice to feel like a housewife for a moment~"
    nvl clear
    w bed shy "Ahh, es agradable sentirse como amo de casa por un momento~"

# game/script.rpy:734
translate es ch2_369e7bdd:

    # w smile "But I should get to work, too..."
    w smile "Pero también debería ponerme a trabajar..."

# game/script.rpy:735
translate es ch2_a95a50d1:

    # w happy "I have an order to fill, don't I~?"
    w happy "Tengo un pedido por cumplir, ¿no es así~?"

# game/script.rpy:738
translate es ch2_3c76f5d0:

    # n "Periwinkle finally rolls out of bed and gets ready for the day..."
    n "Periwinkle finalmente se levanta de la cama y se prepara para el día..."

# game/script.rpy:741
translate es ch2_5a13e7e9:

    # "The order in question is for a nearby apothecary."
    "El pedido en cuestión es para una botica cerca de aquí."

# game/script.rpy:742
translate es ch2_35f25f34:

    # "Did you know? Aromagic like mine is actually quite good for you~"
    "¿Sabías? La aromagia como la mía es realmente de gran ayuda~"

# game/script.rpy:743
translate es ch2_8f79525a:

    # "It's got nothing on actual healing magic, but the calming atmosphere it creates does wonders for one's mood."
    "No se compara a la magia curativa real, pero la atmósfera relajante que crea hace maravillas en el estado de ánimo."

# game/script.rpy:744
translate es ch2_48c6a187:

    # nvl clear
    # "This particular batch is meant to help with insomnia..."
    nvl clear
    "Este lote en particular está hecho para ayudar con el insomnio..."

# game/script.rpy:746
translate es ch2_9bdec3ec:

    # "Which is ironic, considering how late I stayed up with Pastille 💙"
    "Lo cual es irónico, considerando lo tarde que me quedé despierto con Pastille 💙"

# game/script.rpy:747
translate es ch2_e22fb32a:

    # nvl clear
    # w pj teehee "Whoops, can't be getting distracted now~ I really need to finish up these last few bottles..."
    nvl clear
    w pj teehee "Ups, no debo distraerme ahora~ Necesito terminar estas últimas botellas..."

# game/script.rpy:750
translate es ch2_e708ef33:

    # w calm "{nw}"
    w calm "{nw}"

# game/script.rpy:751
translate es ch2_2dd620a3:

    # n "Periwinkle closes his eyes and draws his wand."
    n "Periwinkle cierra los ojos y saca su varita."

# game/script.rpy:753
translate es ch2_3425d8a6:

    # n "Large drops form at its tip, falling into the empty bottle one by one."
    n "En su punta se generan numerosas gotas, que caen una a una dentro de la botella vacía."

# game/script.rpy:754
translate es ch2_3222c5b9:

    # n "With each drip, the bottle's contents swell, and after only the fifth drop, it's completely filled."
    n "Con cada goteo el contenido de la botella aumenta, y luego de la quinta gota, está completamente llena."

# game/script.rpy:757
translate es ch2_fbaed311:

    # w innocent "Perfect! Ahh, it's so much easier to finish these with a clear mind..."
    w innocent "¡Perfecto! Ahh, es mucho más fácil terminar esto con la mente despejada..."

# game/script.rpy:758
translate es ch2_6e325112:

    # w shy "I can't help it if a refreshing night out is the only way to regain my focus 💙"
    w shy "No puedo evitar que una noche refrescante sea la única forma de recuperar mi concentración 💙"

# game/script.rpy:759
translate es ch2_afd133a7:

    # w teehee "Although~ I probably could've gotten one of these done last night if Pastille hadn't been so impatient... 💙"
    w teehee "Aunque~ Probablemente pude haber terminado una de estas anoche si Pastille no hubiera sido tan impaciente... 💙"

# game/script.rpy:760
translate es ch2_44174832:

    # w calm "No, no, mustn't let my mind wander too far from work now."
    w calm "No, no, no debo dejar que mi mente se desvíe del trabajo ahora."

# game/script.rpy:762
translate es ch2_67507517:

    # n "Periwinkle fills the remaining bottles, screwing the lids on as he goes."
    n "Periwinkle llena las botellas restantes, enroscando las tapas a medida que avanza."

# game/script.rpy:764
translate es ch2_5bd5f285:

    # w smile "There. Hmhm, now my house is going to smell like lavender..."
    w smile "Listo. Hmhm, ahora mi casa va a oler a lavanda..."

# game/script.rpy:765
translate es ch2_8bdf90ac:

    # w innocent "I'd better head out before I'm lulled to sleep by my own magic~"
    w innocent "Será mejor que salga antes que ser adormecido por mi propia magia~"

# game/script.rpy:779
translate es ch2_85bf7599:

    # "The apothecary is only a short walk away, but I've never managed to walk in its doors on time."
    "La botica está a tan solo unos minutos de aquí, pero nunca he conseguido entrar en sus puertas a tiempo."

# game/script.rpy:780
translate es ch2_bd4b3ec4:

    # "Perhaps because it's so close, I always underestimate the time it takes to reach it..."
    "Tal vez como está cerca, siempre subestimo el tiempo que tomará llegar..."

# game/script.rpy:781
translate es ch2_3b3d6df9:

    # "I can hear the owner tapping her foot with impatience as soon as I open the door."
    "Escucho a la dueña dar golpes con el pie con impaciencia tan pronto como abro la puerta."

# game/script.rpy:782
translate es ch2_76b2fe88:

    # nvl clear
    nvl clear

# game/script.rpy:785
translate es ch2_a74c124f:

    # w happy "Astragalus~! I have that special order ready for you~"
    w happy "¡Astragalus~! Tengo el pedido especial listo para ti~"

# game/script.rpy:786
translate es ch2_318b7805:

    # a annoyed "You're late again, Periwinkle."
    a annoyed "Llegas tarde otra vez, Periwinkle."

# game/script.rpy:787
translate es ch2_1019ebc0:

    # w innocent "Lost track of time 💙 You'll forgive me, won't you~?"
    w innocent "Perdí la noción del tiempo 💙 Me perdonarás, ¿verdad~?"

# game/script.rpy:788
translate es ch2_7862874c:

    # a "You are literally my only provider who has no respect for appointments."
    a "Eres literalmente mi único distribuidor que no respeta las citas."

# game/script.rpy:789
translate es ch2_2fb8a6f9:

    # w oh "That's simply not true! I never miss a date."
    w oh "¡Eso no es cierto! Nunca me pierdo una cita."

# game/script.rpy:790
translate es ch2_acda7219:

    # a lol "There's the problem. You were out getting laid again, weren't you?"
    a lol "Ahí está el problema. Saliste a echar un polvo otra vez, ¿no?"

# game/script.rpy:791
translate es ch2_dbeacd97:

    # w pout "How vulgar~ I had a romantic evening with a VERY cute boy..."
    w pout "Qué vulgar~ tuve una noche romántica con un chico MUY lindo..."

# game/script.rpy:792
translate es ch2_d7ebcbc7:

    # w innocent "Who then ended up sleeping over 💙"
    w innocent "Que luego acabó quedándose a dormir 💙"

# game/script.rpy:793
translate es ch2_facdd2e0:

    # a whatever "Well, you had all week to fill the order. Try getting it done in advance next time."
    a whatever "Bueno, tuviste toda la semana para hacer el pedido. Trata de hacerlo con anticipación la próxima vez."

# game/script.rpy:794
translate es ch2_8de08278:

    # w calm "Yes, ma'am~"
    w calm "Sí, señora~"

# game/script.rpy:795
translate es ch2_e220bd55:

    # a closed "Now let's see what you brought..."
    a closed "Ahora veamos lo que trajiste..."

# game/script.rpy:797
translate es ch2_6aa2ff6b:

    # "I've worked with Astragalus for a few years now."
    "He estado trabajando con Astragalus durante algunos años."

# game/script.rpy:798
translate es ch2_88aee593:

    # "She's COMPLETLY immune to my charms. Shocking, to say the least."
    "Ella es COMPLETAMENTE inmune a mis encantos. Impresionante, por decir lo menos."

# game/script.rpy:799
translate es ch2_f1139fde:

    # "But it's meant we've been able to remain good friends all this time~"
    "Pero eso ha significado que pudiéramos seguir siendo buenos amigos todo este tiempo~"

# game/script.rpy:800
translate es ch2_4fc199f3:

    # "Or... hm. Let's see..."
    "O... hm. Veamos..."

# game/script.rpy:801
translate es ch2_76b2fe88_1:

    # nvl clear
    nvl clear

# game/script.rpy:804
translate es ch2_2c3696be:

    # w oh "Astragalus. Would you consider us to be good friends?"
    w oh "Astragalus. ¿Consideras que somos buenos amigos?"

# game/script.rpy:805
translate es ch2_c86bbb5c:

    # a whatever "I put up with you."
    a whatever "Te tolero."

# game/script.rpy:806
translate es ch2_373f7314:

    # w happy "My, but you don't put up with ANYONE! You must really like me 💙"
    w happy "¡Jo, pero si tú no soportas a NADIE! Realmente te debo agradar 💙"

# game/script.rpy:807
translate es ch2_47067d4c:

    # a lol "You got a favor to ask or something? Is that what you're getting at?"
    a lol "¿Tienes que pedir un favor o algo así? ¿Es eso lo que intentas conseguir?"

# game/script.rpy:808
translate es ch2_df3d1bd8:

    # w calm "No, I was just thinking of how to categorize our relationship."
    w calm "No, solo estaba pensando en cómo clasificar nuestra relación."

# game/script.rpy:809
translate es ch2_72e2a8ac:

    # a "\"Business associate\" works just fine, doesn't it?"
    a " \"Compañeros de negocios\" funciona bien, ¿no?"

# game/script.rpy:810
translate es ch2_5f78763b:

    # w happy "Come now, surely you consider us to be closer than that!"
    w happy "Vamos, ¡Seguro nos consideras más cercanos que eso!"

# game/script.rpy:811
translate es ch2_ce50824a:

    # a sure "I know better than to get involved with you, Periwinkle."
    a sure "Sé que lo mejor es no involucrarme contigo, Periwinkle."

# game/script.rpy:812
translate es ch2_17ce8a61:

    # w my "Why, whatever do you mean?"
    w my "Perdón, ¿qué quieres decir?"

# game/script.rpy:813
translate es ch2_0ac87123:

    # a whatever "You're too dazzling."
    a whatever "Eres muy deslumbrante."

# game/script.rpy:814
translate es ch2_4a6eea27:

    # w innocent "I take that as a compliment~"
    w innocent "Tomaré eso como un cumplido~"

# game/script.rpy:815
translate es ch2_d60255a0:

    # a annoyed "Great, now will you stop distracting me? I'm trying to count."
    a annoyed "Genial, ¿ahora dejarás de distraerme? estoy tratando de contar."

# game/script.rpy:817
translate es ch2_8c4a5641:

    # "Yes, we're definitely good friends."
    "Sí, definitivamente somos buenos amigos."

# game/script.rpy:818
translate es ch2_9ecc4a32:

    # "\"Too dazzling\" though... I'm not sure there IS such a thing."
    "Aunque \"muy deslumbrante\"... dudo que SEA así."

# game/script.rpy:819
translate es ch2_82c90c4f:

    # "And what would be wrong with it if there was? What point is there in not shining as brightly as one can?"
    "¿Y qué tendría de malo si lo fuera? ¿Qué sentido tiene no brillar tan intensamente como pueda?"

# game/script.rpy:820
translate es ch2_d0dcce99:

    # "Astragalus finishes counting the bottles, sighing in feigned exasperation as she marks them off her checklist..."
    "Astragalus termina de contar las botellas, suspirando con falsa exasperación mientras las tacha de su lista..."

# game/script.rpy:821
translate es ch2_529b0ff5:

    # nvl clear
    # a sure "You may always be late... but you deliver quality every time. You're consistent, if nothing else."
    nvl clear
    a sure "Puede que siempre llegues tarde... pero tus entregas siempre son de calidad. Eres consistente, al menos."

# game/script.rpy:824
translate es ch2_389bf1e7:

    # w teehee "The waiting is part of the fun. It builds excitement, wouldn't you say?"
    w teehee "La espera es parte de la diversión. Genera entusiasmo, ¿no lo crees?"

# game/script.rpy:825
translate es ch2_2f490664:

    # a whatever "Nope, just builds frustration for me. But at least you always come through."
    a whatever "No, a mí solo me genera frustración. Pero al menos siempre cumples."

# game/script.rpy:827
translate es ch2_4251ed12:

    # n "She unlocks a small drawer behind the counter, and takes out an envelope with Periwinkle's name scribbled on it."
    n "Abre un pequeño cajón detrás del mostrador, y saca un sobre con el nombre de Periwinkle escrito en él."

# game/script.rpy:829
translate es ch2_9104554e:

    # a closed "Here's the rest of your payment. Don't spend it all in one place."
    a closed "Aquí está el resto de tu pago. No lo gastes todo de golpe."

# game/script.rpy:830
translate es ch2_338d50e7:

    # w calm "Oh, I couldn't if I tried! Really, you're too generous..."
    w calm "Oh, ¡No podría aunque lo intentara! En serio, eres demasiado generosa..."

# game/script.rpy:833
translate es ch2_8daa5982:

    # n "Astragalus rolls her eyes and begins stocking the shelves with her new inventory."
    n "Astragalus rueda los ojos y procede a abastecer las estanterías con su nuevo inventario."

# game/script.rpy:835
translate es ch2_ffbdbe6c:

    # "Two or three orders a month... that's all it takes to support myself, entirely through this apothecary."
    "Dos o tres pedidos al mes... eso es todo lo que necesito para mantenerme, todo gracias a esta bótica."

# game/script.rpy:836
translate es ch2_ba2406db:

    # "Hard to believe my magic is really worth so much, but who am I to complain?"
    "Cuesta creer que mi magia tenga tanto valor, ¿Pero quién soy yo para quejarme?"

# game/script.rpy:837
translate es ch2_acb5044d:

    # "It's certainly a more favorable balance compared to the kind of work I was doing years ago."
    "Sin duda es un saldo más favorable comparado con el tipo de trabajo que hacía hace años."

# game/script.rpy:838
translate es ch2_7acd925f:

    # nvl clear
    # "And I do enjoy the freedom, the excessive amounts of time I have for partying, for dates..."
    nvl clear
    "Y disfruto de la libertad, de la excesiva cantidad de tiempo que tengo para salir de fiesta, de citas..."

# game/script.rpy:840
translate es ch2_a2058868:

    # "Ah, on that note~"
    "Ah, hablando de eso~"

# game/script.rpy:841
translate es ch2_0b1b7e93:

    # nvl clear
    # w happy "With all that business out of the way... would you like to hear about my date? 💙"
    nvl clear
    w happy "Dejando los negocios de lado... ¿te gustaría escuchar sobre mi cita? 💙"

# game/script.rpy:844
translate es ch2_fa857f5d:

    # a sure "Would I LIKE to? Not necessarily."
    a sure "¿Que si me GUSTARÍA? No necesariamente."

# game/script.rpy:845
translate es ch2_95d8347d:

    # w teehee "Please, Astragalus, as someone with no romance in your OWN life, the least you can do is live vicariously through me~"
    w teehee "Por favor, Astragalus, al no tener romance en tu PROPIA vida, lo mínimo que puedes hacer es vivirlo indirectamente a través de mi~"

# game/script.rpy:846
translate es ch2_8be11c8d:

    # a whatever "The no romance thing is by choice. I listen to you gush for your own damn sake."
    a whatever "El no tener vida amorosa es por decisión propia. Que te escuche es solo por tu propio bien."

# game/script.rpy:847
translate es ch2_66b3a391:

    # w my "For MY sake?"
    w my "¿Por MI bien?"

# game/script.rpy:848
translate es ch2_e2b9789b:

    # a sure "Yeah, I'm afraid you might actually implode if you had no one to talk to about this stuff."
    a sure "Claro, me temo que podrías explotar si no tuvieras a quién hablarle de estas cosas."

# game/script.rpy:849
translate es ch2_fdfc2ccd:

    # a lol "I'm actually making a noble sacrifice every day that you come in here with new tales of romantic conquest."
    a lol "La verdad es que hago un noble sacrificio cada día que llegas con una nueva historia de conquista romántica."

# game/script.rpy:850
translate es ch2_b3b6ebb7:

    # w pout "Hmph. If you're truly suffering, I shall desist..."
    w pout "Hmph. Si tanto estás sufriendo, desistiré..."

# game/script.rpy:851
translate es ch2_115b6d90:

    # a smile "That's the thing, though... I DO like seeing you all worked up over something, even if I don't understand it myself."
    a smile "Aunque esa es la cuestión... me GUSTA verte emocionado por algo, incluso si no lo puedo comprender por mí misma."

# game/script.rpy:852
translate es ch2_dfd74c02:

    # w happy "Ahh, so there IS a mutual benefit! You'll listen, then? 💙"
    w happy "Ahh, ¡Entonces SÍ hay un beneficio mutuo! ¿Me escucharás, entonces? 💙"

# game/script.rpy:853
translate es ch2_e4b44b62:

    # a sure "Yeah, at least until I get all this put away. After that, I'm kicking you out for the day."
    a sure "Sí, al menos hasta que ordene todo esto. Después de eso, te largas de aquí por hoy."

# game/script.rpy:855
translate es ch2_aa202e59:

    # w calm "Fair enough. I'd better be brief, then..."
    w calm "Me parece bien. Será mejor que sea breve, entonces..."

# game/script.rpy:857
translate es ch2_c163a19e:

    # w teehee "He's the absolute cutest thing! I picked him up at a candy shop yesterday 💙"
    w teehee "¡Él es la cosa más linda! Lo encontré ayer en una tienda de dulces 💙"

# game/script.rpy:858
translate es ch2_7ea91466:

    # w happy "Fluffy pink hair, with golden eyes, naturally rosy cheeks that make him look as if he's always a little embarrassed by something..."
    w happy "Esponjoso cabello rosado, con ojos dorados, mejillas naturalmente rosadas que hacen que parezca siempre avergonzado por algo..."

# game/script.rpy:859
translate es ch2_78bc035b:

    # w shy "He's shy, but not the type that becomes paralyzed in the bedroom--"
    w shy "Es tímido, pero no del tipo que se paraliza en la cama--"

# game/script.rpy:860
translate es ch2_e6e9e69b:

    # a augh "Periwinkle, for the last time, I do NOT need to hear about bedroom stuff." with vpunch
    a augh "Periwinkle, por última vez, NO necesito saber ese tipo de información." with vpunch

# game/script.rpy:861
translate es ch2_91bce83e:

    # w my "I wasn't giving any details!"
    w my "¡No estoy dando ningún detalle!"

# game/script.rpy:862
translate es ch2_f28bb905:

    # w shy "Although, the details ARE the best part 💙"
    w shy "Aunque, los detalles SON la mejor parte 💙"

# game/script.rpy:863
translate es ch2_6f8d4d69:

    # a annoyed "This is a \"safe for work\" zone only. Break that rule, and you're outta here."
    a annoyed "Esta es una zona exclusivamente \"segura para el trabajo\". Rompes esa regla, y te vas de aquí."

# game/script.rpy:864
translate es ch2_91ce2d8b:

    # w innocent "My apologies~ I'll refrain."
    w innocent "Mis disculpas~ me abstendré."

# game/script.rpy:865
translate es ch2_dc5be651:

    # w love "Anyway, my point is... he's EXTREMELY cute. Adorable, in fact!"
    w love "En todo caso, la cosa es que...es EXTREMADAMENTE lindo. ¡Adorable, en realidad!"

# game/script.rpy:866
translate es ch2_d8b497e3:

    # a eyeroll "Right, so, standard fare for you."
    a eyeroll "Bien, entonces, lo de siempre."

# game/script.rpy:867
translate es ch2_fc605430:

    # w my "Absolutely not! If he was just your average cutie, would I be emphasizing his cuteness so much?"
    w my "¡Por supuesto que no! Si fuera igual que los demás, ¿Estaría resaltando tanto su ternura?"

# game/script.rpy:868
translate es ch2_a47387c2:

    # a sure "I don't meet these people, so it's all the same to me."
    a sure "No conozco a esas personas, así que es lo mismo para mí."

# game/script.rpy:869
translate es ch2_afb4034f:

    # w oh "How can it be~? The intensity is so drastically different... perhaps SO intense that I'm having trouble explaining it properly."
    w oh "¿Cómo es posible~? La diferencia de intensidad es tan drástica..."
    w "Quizás es TANTA intensidad que me cuesta explicarlo correctamente."

# game/script.rpy:870
translate es ch2_3da682aa:

    # a closed "I'll say. All you've really told me so far is that he's cute and shy."
    a closed "Lo diré. Todo lo que me has dicho hasta ahora es que es lindo y tímido."

# game/script.rpy:871
translate es ch2_8e3642e4:

    # w shy "He's kind, as well! He saved the best part of our dessert for me without even asking!"
    w shy "¡También es amable! ¡Guardó la mejor parte del postre para mí sin siquiera preguntarme!"

# game/script.rpy:872
translate es ch2_dfa9b85a:

    # a lol "Wow, I would've led with that one."
    a lol "Wow, hubieras empezado por ahí."

# game/script.rpy:873
translate es ch2_fdbe174a:

    # w pout "Ohh, enough of your sarcasm. When all my favorite details are off-limits, what do you suppose I'm LEFT with?"
    w pout "Ohh, basta de tu sarcasmo. Cuando se juntan todos mis detalles favoritos, ¿qué crees que me QUEDA?"

# game/script.rpy:874
translate es ch2_ab7c305b:

    # a happy "Well, what really matters is that you had a good night. Even if it meant you couldn't get here on time like I asked."
    a happy "Bueno, lo importante es que tuviste una buena noche. Incluso si eso significa que no hayas podido llegar a tiempo como pedí."

# game/script.rpy:875
translate es ch2_f5e62b00:

    # w love "Ahh~ I'm already hoping to see him again, to be honest..."
    w love "Ahh~ Ya estoy esperando volver a verlo, para ser honesto..."

# game/script.rpy:876
translate es ch2_0979287d:

    # a hm "Oh yeah? Don't hear that from you very often."
    a hm "Oh, ¿sí? no se oye eso de ti a menudo."

# game/script.rpy:877
translate es ch2_83be95f7:

    # w oh "Really? But I've gone on second dates all the time."
    w oh "¿En serio? pero si siempre he tenido segundas citas."

# game/script.rpy:878
translate es ch2_95f62998:

    # a lol2 "This guy got a name?"
    a lol2 "¿Tiene nombre este chico?"

# game/script.rpy:879
translate es ch2_899be6dd:

    # w shy "Hmhm, I don't kiss and tell 💙"
    w shy "Hmhm, no beso y cuento 💙"

# game/script.rpy:880
translate es ch2_7b70ce89:

    # a sure "No, actually, you tell me about everyone you kiss."
    a sure "No, de hecho, me cuentas de todas las personas a las que besas."

# game/script.rpy:881
translate es ch2_44e74989:

    # a lol "C'mon, if he's really the absolute cutest, it's a shame to keep him anonymous, right? Not like I'm gonna tell anyone anyways."
    a lol "Vamos, si realmente es el más lindo, es una pena dejarlo en el anonimato, ¿no? No es como si fuera a decírselo a alguien de todos modos."

# game/script.rpy:882
translate es ch2_cb259e44:

    # w calm "Fine... his name is Pastille."
    w calm "Bien... su nombre es Pastille."

# game/script.rpy:883
translate es ch2_ce121fd3:

    # a annoyed "Hmph. Even his name's cute."
    a annoyed "Hmph. Incluso su nombre es lindo."

# game/script.rpy:884
translate es ch2_b434ce04:

    # w happy "Right~?"
    w happy "¿Cierto~?"

# game/script.rpy:885
translate es ch2_2d463d2b:

    # w smile "Oh, that reminds me--he sold me some candies that share his name. Would you like to try?"
    w smile "Oh, eso me recuerda--me vendió unos dulces con su nombre. ¿Quieres probarlos?"

# game/script.rpy:886
translate es ch2_628745c1:

    # a happy "Sure. How could a witch turn down free candy?"
    a happy "Claro. ¿Cómo podría una bruja rechazar dulces gratis?"

# game/script.rpy:887
translate es ch2_2ac72dd0:

    # n "Periwinkle digs into his bag and pulls out one of the pastilles."
    n "Periwinkle busca en su bolso y saca una de las pastillas dulces."

# game/script.rpy:888
translate es ch2_c90345e5:

    # n "He hands the candy to Astragalus, who promptly unwraps it and pops it into her mouth."
    n "Le da el caramelo a Astragalus, quien rápidamente lo desenvuelve y se lo echa a la boca."

# game/script.rpy:889
translate es ch2_e3dc6cdf:

    # a hm "Mmf... Oh, these are GOOD. Where'd you say this candy shop was?"
    a hm "Mmf... Oh, estos son BUENOS. ¿Dónde dijiste que estaba esa tienda de dulces?"

# game/script.rpy:890
translate es ch2_6e7c54dc:

    # w happy "Not far from here! I'll give you directions..."
    w happy "¡No muy lejos de aquí! Te daré la dirección..."

# game/script.rpy:897
translate es ch2_58993334:

    # "Shortly after telling Astragalus where to find Atelier Sweets, she unceremoniously kicked me out..."
    "Poco después de indicarle a Astragalus donde encontrar Atelier Sweets, me echó del lugar sin cortesías..."

# game/script.rpy:898
translate es ch2_7f4ee160:

    # "She'd long finished putting all those bottles away, after all."
    "Ya hace mucho que había terminado de guardar todas esas botellas, después de todo."

# game/script.rpy:899
translate es ch2_d635dbff:

    # "With money in my pocket, and no more work to be done for the moment... I'm free to begin pursuing my next date~"
    "Con dinero en mi bolsillo, y sin más trabajo pendiente de momento... soy libre de empezar a buscar a mi próxima cita~"

# game/script.rpy:900
translate es ch2_a4f99886:

    # nvl clear
    # "But wherever shall I go? It's a weekday, too early for parties, too early for drinks..."
    nvl clear
    "¿Pero a dónde debería ir? es día entre semana, muy pronto para fiestas, muy pronto para bebidas..."

# game/script.rpy:902
translate es ch2_1e5385aa:

    # "I suppose I could return home and straighten up the place. However..."
    "Supongo que podría volver a casa y ordenar el lugar. Sin embargo..."

# game/script.rpy:903
translate es ch2_801baa18:

    # nvl clear
    # w calm "(Why would I busy myself with chores when I could be celebrating another order successfully filled?)"
    nvl clear
    w calm "(¿Por qué iba a ocuparme de los quehaceres cuando podría estar festejando otro pedido terminado con éxito?)"

# game/script.rpy:906
translate es ch2_7123d8ef:

    # n "Before Periwinkle can decide on where to go, a familiar witch approaches him."
    n "Antes de que Periwinkle pueda decidir a dónde ir, una bruja conocida se le acerca."

# game/script.rpy:909
translate es ch2_a7e53e02:

    # c "Periwinkle...?"
    c "¿Periwinkle...?"

# game/script.rpy:910
translate es ch2_ed8e4bc5:

    # w happy "Ohh, Cassia! So lovely to see you~"
    w happy "¡Ohh, Cassia! Me alegra verte~"

# game/script.rpy:911
translate es ch2_cca6951a:

    # c happy "Yay, I'm so glad we ran into each other~"
    c happy "Yay, estoy tan feliz de que nos encontráramos~"

# game/script.rpy:913
translate es ch2_18cfade9:

    # "How to describe Cassia..."
    "Cómo describir a Cassia..."

# game/script.rpy:914
translate es ch2_0c67f0a0:

    # "She's exceedingly cuddly. We met at a party one night, during which she latched onto my arm and never let go. Quite endearing!"
    "Es extremadamente cariñosa. Nos conocimos en una noche de fiesta, durante la cual se agarró de mi brazo y nunca lo soltó. ¡Muy entrañable!"

# game/script.rpy:915
translate es ch2_6535f464:

    # "Since then, we've gone on little dates from time to time..."
    "Desde entonces, hemos tenido pequeñas citas de vez en cuando..."

# game/script.rpy:916
translate es ch2_91a4c39c:

    # "She really loves my magic, so I tend to spoil her whenever we're together 💙"
    "A ella le encanta mi magia, por lo que suelo consentirla cada vez que estamos juntos 💙"

# game/script.rpy:917
translate es ch2_fc9d5dc6:

    # nvl clear
    # w smile "Did you need something, dear?"
    nvl clear
    w smile "¿Necesitabas algo, querida?"

# game/script.rpy:920
translate es ch2_7206142c:

    # c aww "Ah, yes! I tried coming over last night, but you didn't seem to be home..."
    c aww "¡Ah, sí! Intenté visitarte anoche, pero no parecías estar en casa..."

# game/script.rpy:921
translate es ch2_693e007a:

    # w shy "Aww, you came to visit me? I'm flattered 💙"
    w shy "Aww, ¿viniste a visitarme? Me siento halagado 💙"

# game/script.rpy:922
translate es ch2_399869f1:

    # w smile "I must've been out to dinner at the time... Sorry that I missed you~"
    w smile "Debí haber salido a cenar en ese momento... Siento no haberte atendido~"

# game/script.rpy:923
translate es ch2_2f0adf6c:

    # c smile "Oh, it's okay~ I was mostly looking to talk..."
    c smile "Oh, está bien~ Estaba buscando hablar más que nada..."

# game/script.rpy:924
translate es ch2_c9ba5380:

    # c aww "So, um, if you're available right now... do you wanna go to a café?"
    c aww "Entonces, um, si estás libre ahora... ¿Quieres ir a un café?"

# game/script.rpy:925
translate es ch2_d5996b44:

    # w innocent "That sounds perfect! I would love to."
    w innocent "¡Suena perfecto! Me encantaría."

# game/script.rpy:931
translate es ch2_e516a126:

    # "We take our seats at the nearby café."
    "Tomamos asiento en la cafetería más cercana."

# game/script.rpy:932
translate es ch2_07ec8f7d:

    # "It's a pleasant, sunny little place. I've come here often with all sorts of other witches."
    "Es un lugar soleado y agradable. He venido aquí en varias ocasiones con usuarios mágicos de todo tipo."

# game/script.rpy:933
translate es ch2_798bacd1:

    # "Cassia orders her usual hot chocolate with extra marshmallows, while I decide on a simple rose tea."
    "Cassia pide su habitual chocolate caliente con malvaviscos extra, mientras yo me decido por un simple té de rosas."

# game/script.rpy:934
translate es ch2_13febc5a:

    # nvl clear
    # c oh "Ooh, Periwinkle, could you make my marshmallows smell like roses, too?"
    nvl clear
    c oh "Ooh, Periwinkle, ¿Podrías hacer que mis malvaviscos huelan a rosas también?"

# game/script.rpy:937
translate es ch2_e1d1de4a:

    # w innocent "With pleasure 💙"
    w innocent "Con gusto 💙"

# game/script.rpy:938
translate es ch2_d7d93e12:

    # n "Periwinkle's wand drops from his sleeve, and he gives Cassia's cup a quick little tap."
    n "La varita de Periwinkle cae de su manga, y le da un golpecito a la taza de Cassia."

# game/script.rpy:939
translate es ch2_9343669f:

    # c happy "Eheh, yay~ It really smells just like roses~!"
    c happy "Jeje, yay~ ¡Realmente huele como las rosas~!"

# game/script.rpy:940
translate es ch2_790200db:

    # w smile "Just as you asked, dear. It may slightly affect the taste, so let me know if you'd like the spell undone."
    w smile "Justo como lo pediste, querida. Puede afectar un poco al sabor, así que avísame si quieres deshacer el hechizo."

# game/script.rpy:942
translate es ch2_51b79206:

    # n "Cassia dips her spoon in and lifts a marshmallow to her lips, blowing on it lightly before popping it into her mouth."
    n "Cassia sumerge la cuchara y se lleva un malvavisco a los labios, soplándolo un poco antes de echárselo a la boca."

# game/script.rpy:943
translate es ch2_bb00d05f:

    # c happy "Mmf... no, it's wonderful! Ehehe~ 🤎"
    c happy "Mmf... no, ¡es fabuloso! Jejeje~ 🤎"

# game/script.rpy:946
translate es ch2_88501500:

    # "She truly can find the joy in any little moment. Such a delight..."
    "Ella realmente puede disfrutar de cada pequeño momento. Todo un encanto..."

# game/script.rpy:947
translate es ch2_28e04d59:

    # "Definitely a contender for the title of absolute cutest witch. Though I would call her... absolutely cute, rather than the absolute cutest."
    "Es sin duda una aspirante al título de la bruja más linda. Aunque la llamaría... completamente linda, en lugar de solo la que más lo es."

# game/script.rpy:948
translate es ch2_22a82a32:

    # "It takes more than cuteness alone to earn the title of absolute cutest witch! That's where the difference lies, of course."
    "¡Se necesita más que solo ternura para ganarse el título de la bruja más linda! Ahí es donde radica la diferencia, por supuesto."

# game/script.rpy:949
translate es ch2_1167b98f:

    # nvl clear
    # "But what am I thinking? How rude it is, to begin ranking my dates in such a way."
    nvl clear
    "¿Pero qué estoy pensando? Es muy grosero de mi parte empezar a clasificar a mis citas así."

# game/script.rpy:951
translate es ch2_89364570:

    # "I must be stuck on the thought from my earlier conversation with Astragalus... trying to put Pastille's cuteness into words."
    "Debo estar atascado en el pensamiento de mi última conversación con Astragalus... tratando de poner en palabras la ternura de Pastille."

# game/script.rpy:952
translate es ch2_f14542af:

    # "He really is something special... ah, it's all in the contrast! His polite, well-mannered and proper exterior, concealing such intense desire, begging you to make the first move, and then going ahead and taking it on his own as soon as you--"
    "Él realmente es algo especial... ¡ah, todo está en el contraste! Su apariencia cortés, correcta y educada, que oculta un ferviente deseo, rogando que des el primer paso, y entonces se adelanta y lo hace él mismo tan pronto como--"

# game/script.rpy:953
translate es ch2_d02f8f43:

    # nvl clear
    # w oops "(...Enough of that! There's someone else in front of me now, isn't there?)" with vpunch
    nvl clear
    w oops "(...¡Es suficiente! Tengo a alguien en frente mío ahora mismo, ¿no es así?)" with vpunch

# game/script.rpy:956
translate es ch2_84a03c6d:

    # n "Cassia continues happily sipping her hot chocolate before speaking up again."
    n "Cassia sigue felizmente bebiendo su chocolate caliente antes de volver a hablar."

# game/script.rpy:958
translate es ch2_4958d936:

    # c aw "Ahh, I missed you, Periwinkle~ I've been so busy with packing, I haven't had a chance to see you at all..."
    c aw "Ahh, te extrañaba, Periwinkle~ he estado tan ocupada empacando que no he tenido ninguna oportunidad de verte..."

# game/script.rpy:959
translate es ch2_15a35145:

    # w my "Packing? And just where are you headed off to?"
    w my "¿Empacando? ¿Y hacia dónde te diriges?"

# game/script.rpy:960
translate es ch2_959ab161:

    # c oh "Oh, that's right! I never had a chance to tell you~"
    c oh "Oh, ¡Es cierto! Nunca tuve la oportunidad de contártelo~"

# game/script.rpy:961
translate es ch2_28a09411:

    # c happy "I'm finally moving in with my partners~! In two more days, the three of us will all be sleeping in the same bed~ 🤎"
    c happy "¡Finalmente estoy mudándome con mis parejas~! En dos días más, estaremos los tres durmiendo en la misma cama~ 🤎"

# game/script.rpy:962
translate es ch2_1b9c5f18:

    # w happy "Ooh, that sounds cozy~ Congratulations!"
    w happy "Ooh, eso suena acogedor~ ¡Felicitaciones!"

# game/script.rpy:963
translate es ch2_937fc8b0:

    # c aww "Ehe, thank you~ 🤎 I've looked forward to it for so long..."
    c aww "Jeje, gracias~ 🤎 Lo he estado esperando con ansias desde hace mucho..."

# game/script.rpy:964
translate es ch2_aae442de:

    # w smile "It sounds like you're about to enter a lovely domestic life. You deserve it!"
    w smile "Suena a que estás a punto de tener una agradable vida doméstica. ¡Te lo mereces!"

# game/script.rpy:965
translate es ch2_f5692979:

    # c "Aww, hehehe... I'm really happy."
    c "Aww, jejeje... estoy tan feliz."

# game/script.rpy:966
translate es ch2_d2fabfa3:

    # c oh "But, um... speaking of my partners. You've still never even met them..."
    c oh "Pero, um... hablando de mis parejas. No les has conocido aún..."

# game/script.rpy:967
translate es ch2_f5612c00:

    # w calm "True. But I can imagine they're wonderful, just from how you've talked about them."
    w calm "Es cierto. Pero me puedo imaginar que son maravillosos, solo por como has hablado de ellos."

# game/script.rpy:968
translate es ch2_f82c96ac:

    # c aww "Right~ but, um... what if you didn't have to imagine?"
    c aww "Claro~ pero, um... ¿y si no tuvieras que imaginarlo?"

# game/script.rpy:969
translate es ch2_add80a4e:

    # c smile "That's what I've been wanting to talk to you about. I was hoping... we might all be able to go on a group date sometime!"
    c smile "Eso era de lo que quería hablar contigo. Esperaba... ¡que pudiéramos tener una cita grupal alguna vez!"

# game/script.rpy:970
translate es ch2_c81c387b:

    # w oh "Oh~?"
    w oh "¿Oh~?"

# game/script.rpy:971
translate es ch2_8b6f2fb7:

    # c aw "Yeah~! Because, like... I just think you're so wonderful, Periwinkle. I want them to know you, too!"
    c aw "¡Sí~! Porque, bueno... simplemente pienso que eres increíble, Periwinkle. ¡Quiero que ellos te conozcan también!"

# game/script.rpy:972
translate es ch2_40b31e80:

    # w sorry "Mm... although it sounds like fun, I'm a bit..."
    w sorry "Mm... aunque suena divertido, me siento algo..."

# game/script.rpy:973
translate es ch2_7122e72f:

    # c please "W-wait, before you say no...!"
    c please "¡E-Espera, antes de que digas que no...!"

# game/script.rpy:974
translate es ch2_b6456ff5:

    # c "They're both very easygoing, and so loving, and nice...! I can promise it won't be overwhelming..."
    c "¡Ambos son tranquilos, y muy cariñosos y agradables...! Prometo que no será abrumador..."

# game/script.rpy:975
translate es ch2_62b54e38:

    # w decline "That unfortunately isn't where the issue lies, my dear..."
    w decline "Desafortunadamente ahí no está el problema, querida..."

# game/script.rpy:976
translate es ch2_bb65f581:

    # c sad "I-I know you said you didn't want to get involved before... but I just know that we would all get along so well!"
    c sad "S-Sé que dijiste que no querías involucrarte antes... ¡pero sé que nos llevaríamos muy bien!"

# game/script.rpy:977
translate es ch2_9db7f2b9:

    # c "I'd like to reassure you however I can. But I understand if you still turn me down..."
    c "Quisiera convencerte como sea posible. Pero entiendo si aún prefieres rechazar..."

# game/script.rpy:979
translate es ch2_99af5b21:

    # "Matters of love are so tricky, aren't they?"
    "Las cosas del amor son tan complicadas, ¿no?"

# game/script.rpy:980
translate es ch2_b7229a67:

    # "I still recall the first time something like this was asked of me..."
    "Aún recuerdo la primera vez en que me invitaron a algo así..."

# game/script.rpy:981
translate es ch2_70f4d8cb:

    # "I had been nervous going in, but I had also never entered a group situation before. I attributed my anxiety solely to that."
    "Había estado nervioso por ir, y además nunca había estado en una situación grupal antes. Atribuí mi ansiedad únicamente a eso."

# game/script.rpy:982
translate es ch2_5aaf6eab:

    # "However, it quickly became clear that I just wasn't suited to it at all..."
    "Sin embargo, pronto quedó claro que simplemente no era para mí..."

# game/script.rpy:983
translate es ch2_92e49d6c:

    # nvl clear
    # "I do love to spoil each of my partners--but strictly one at a time."
    nvl clear
    "Amo consentir a mis citas-- pero estrictamente una a la vez."

# game/script.rpy:985
translate es ch2_13099713:

    # "Perhaps I was left scarred by the breakdown in communication, the passionate fires of a long-established romance..."
    "Tal vez quedé marcado por la ruptura de comunicación, la viva pasión de un romance establecido desde hace tiempo..."

# game/script.rpy:986
translate es ch2_000f6a86:

    # "Surely Cassia and her partners are magnificent people. It may indeed be fun for a night."
    "Seguramente Cassia y sus parejas son personas maravillosas. Podría ser divertido por una noche."
    nvl clear

# game/script.rpy:987
translate es ch2_e1d8cf3a:

    # "But becoming entangled in committed relationships is something I've always avoided from the beginning, isn't it?"
    "Pero involucrarme en relaciones comprometidas es algo que he evitado desde el principio, ¿no es así?"

# game/script.rpy:988
translate es ch2_b61e07ce:

    # nvl clear
    # w neutral "This is all very sweet of you. But I do have to decline."
    nvl clear
    w neutral "Todo esto es muy dulce de tu parte. Pero tengo que rechazar."

# game/script.rpy:991
translate es ch2_d6eb3267:

    # c letdown "Aww... I can't help but feel a little broken-hearted."
    c letdown "Aww... no puedo evitar sentirme un poco adolorida."

# game/script.rpy:992
translate es ch2_02d40560:

    # w decline "I apologize... Truly, it's nothing personal."
    w decline "Mis disculpas... de veras, no es nada personal."

# game/script.rpy:993
translate es ch2_cea46204:

    # c aww "Oh, I know~ I don't take offense or anything..."
    c aww "Oh, lo sé~ No me ofende ni nada..."

# game/script.rpy:994
translate es ch2_13fca6f4:

    # c letdown "It's just sad. Now that I'm going to be living with them... and, knowing you don't want to meet them..."
    c letdown "Solo es triste. Ahora que voy a vivir con ellos... y, sabiendo que no quieres conocerlos..."

# game/script.rpy:995
translate es ch2_82188b3a:

    # c sad "I think it's best we just break things off...."
    c sad "Creo que es mejor que terminemos las cosas...."

# game/script.rpy:996
translate es ch2_9b7a5305:

    # w neutral "Yes, I agree. As you said, it's for the best."
    w neutral "Sí, estoy de acuerdo. Como dijiste, es lo mejor."

# game/script.rpy:997
translate es ch2_22bfa56a:

    # c aww "I hope we can still be friends, though~"
    c aww "Espero que sigamos siendo amigos, aún así~"

# game/script.rpy:998
translate es ch2_a119e9ad:

    # w smile "Of course~ 💙 I'm sure our paths will cross every now and again."
    w smile "Por supuesto~ 💙 seguro nuestros caminos se cruzarán de vez en cuando."

# game/script.rpy:999
translate es ch2_96818197:

    # c happy "Yeah~! Thank you for always treating me so well, Periwinkle."
    c happy "¡Sí~! Gracias por ser siempre ser tan amable conmigo, Periwinkle."

# game/script.rpy:1000
translate es ch2_f9c0bf81:

    # w calm "Hmhm, it was my pleasure 💙"
    w calm "Hmhm, el placer es mío 💙"

# game/script.rpy:1003
translate es ch2_482c7dd0:

    # "Even casual relationships can end in breakups like this."
    "Incluso las relaciones casuales pueden terminar en rupturas como esta."

# game/script.rpy:1004
translate es ch2_7fabf76c:

    # "This is largely why I tend to prefer one-night affairs. Things can just become so messy as needs evolve..."
    "En gran parte es por esto que prefiero las cosas de una sola noche. Las cosas pueden complicarse tanto a medida que las necesidades crecen..."

# game/script.rpy:1005
translate es ch2_e8be9790:

    # "As Cassia and I go our separate ways, I can't help feeling a little blue."
    "Cuando Cassia y yo nos vamos por distintos caminos, no puedo evitar sentirme un poco triste."
    nvl clear

# game/script.rpy:1006
translate es ch2_7b0bc9f1:

    # "Perhaps I'll return home for the day after all."
    "Puede que vuelva a casa por hoy después de todo."

# game/script.rpy:1007
translate es ch2_76b2fe88_2:

    # nvl clear
    nvl clear

# game/script.rpy:1018
translate es ch2_80d3118f:

    # n "Periwinkle quickly changes into something more comfortable, dropping his bag unceremoniously onto the couch."
    n "Periwinkle se pone rápidamente algo más cómodo, y deja su bolso caer bruscamente en el sofá."

# game/script.rpy:1019
translate es ch2_a9ff1a56:

    # w pj neutral "(I could use an afternoon nap...)"
    w pj neutral "(Me vendría bien una siesta vespertina...)"

# game/script.rpy:1020
translate es ch2_10be0962:

    # w calm "(Yes, that's precisely what I need. I'll wake up feeling refreshed, and ready to go back out on the town~)"
    w calm "(Sí, eso es precisamente lo que necesito. Me despertaré sintiéndome renovado y listo para volver a salir a la ciudad~)"

# game/script.rpy:1022
translate es ch2_47c6e3ec:

    # n "He shoves some blankets aside and collapses onto the couch--and when he does, the contents of his bag spills onto the floor."
    n "Aparta algunas mantas y se echa en el sofá--y al hacerlo, el contenido de su bolso se derrama por el suelo."

# game/script.rpy:1023
translate es ch2_093623ac:

    # w oh "Ah..."
    w oh "Ah..."

# game/script.rpy:1024
translate es ch2_189b671a:

    # n "Lazily leaning over to gather it up, he notices the candies from before..."
    n "Agachándose vagamente para recogerlo, se fija en los dulces de antes..."

# game/script.rpy:1025
translate es ch2_cba66395:

    # w neutral "...."
    w neutral "...."

# game/script.rpy:1030
translate es ch2_ed23994c:

    # "Was I too hasty in saying I'd hoped to see Pastille again?"
    "¿Fui muy deprisa al decir que esperaba volver a ver a Pastille?"

# game/script.rpy:1031
translate es ch2_cad66722:

    # "I suppose I'd forgotten the feeling of not being enough for someone."
    "Supongo que había olvidado el sentimiento de no ser suficiente para alguien."

# game/script.rpy:1032
translate es ch2_fc6603e2:

    # "Usually these things tend to dissipate naturally, without confrontation or notice."
    "Normalmente estas cosas tienden a desaparecer de forma natural, sin confrontación o aviso."

# game/script.rpy:1033
translate es ch2_e7803a00:

    # "So when they don't... it stings."
    "Entonces cuando no es así... duele."

# game/script.rpy:1034
translate es ch2_fc4b9a1c:

    # nvl clear
    # n "Periwinkle scoops up the candies, dropping all but one of them back into his bag."
    nvl clear
    n "Periwinkle recoge los dulces, dejando todos en el bolso a excepción de uno."

# game/script.rpy:1037
translate es ch2_f16117de:

    # n "He settles into place on the couch, nestled in a tangled mess of blankets and cushions... and unwraps his chosen pastille."
    n "Se acomoda en el sofá, acurrucado en un revoltijo de mantas y cojines... y desenvuelve la pastilla que escogió."

# game/script.rpy:1040
translate es ch2_2fa75bdb:

    # w pj calm "(...It IS sweet, though.)"
    w pj calm "(...Aunque ES dulce.)"

# game/script.rpy:1041
translate es ch2_81ec8a05:

    # w shy "(What a shame that would be, if I never got to taste it again!)"
    w shy "(¡Sería una lástima si no pudiera volver a probarlo!)"

# game/script.rpy:1044
translate es ch2_b429b989:

