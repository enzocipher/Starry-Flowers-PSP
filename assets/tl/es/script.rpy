    p neutral "Nunca había estado aquí antes. Parece elegante."

# game/script.rpy:424
translate es start_f4e0eba9:

    # w calm "I'm a fan of the atmosphere. The food isn't bad, either."
    w calm "Me gusta mucho el ambiente. La comida tampoco no está mal."

# game/script.rpy:426
translate es start_db213eb7:

    # w smile "Now, let's get a few formalities out of the way, shall we? First and foremost... your pronouns?"
    w smile "Ahora dejemos algunas formalidades de lado, ¿Está bien? Primero que nada... ¿tus pronombres?"

# game/script.rpy:427
translate es start_a5b368da:

    # p oh "Oh, um, I just use he/him. What about you?"
    p oh "Oh, um, solo uso \"él\". ¿Qué hay de ti?"

# game/script.rpy:428
translate es start_e13d1dc4:

    # w calm "The same. Though I don't necessarily mind being called by others... especially considering my presentation."
    w calm "Igualmente. Aunque no me importa necesariamente ser llamado por otros..."
    w "Especialmente teniendo en cuenta mi presentación."

# game/script.rpy:429
