    # nvl clear
    # "But it HAS been a while since my last attempt. I may as well put in some effort..."
    nvl clear
    "Pero HA pasado un tiempo desde la última vez que lo intenté. Bien podría esforzarme un poco..."

# game/script.rpy:1216
translate es ch3_c56eb4b7:

    # nvl clear
    # w pj oops "But where to begin...?"
    nvl clear
    w pj oops "¿Pero por dónde empezar...?"

# game/script.rpy:1219
translate es ch3_c9432365:

    # w oh "I suppose my work supplies have been a little difficult to navigate as of late."
    w oh "Supongo que ha sido algo difícil buscar entre mis suministros de trabajo últimamente."

# game/script.rpy:1220
translate es ch3_6288f7b0:

    # w innocent "That's an achievable goal now, isn't it? And practical, as well!"
    w innocent "Esa es una meta realista por ahora, ¿no? ¡Y además, es práctica!"

# game/script.rpy:1222
translate es ch3_bd454459:

    # n "Periwinkle begins with the box of his favorite perfumes, that had been sitting out since one of Pastille's first visits."
    n "Periwinkle comienza por la caja de sus perfumes favoritos, que habían quedado fuera desde una de las primeras visitas de Pastille."

# game/script.rpy:1223
translate es ch3_de62bb1c:

    # w drool "Ahh, yes... the \"aphrodisiac\"... hmhm, that was a fun night 💙"
    w drool "Ahh, sí... el \"afrodisíaco\"... hmhm, esa fue una noche divertida 💙"

# game/script.rpy:1224
translate es ch3_44f1f072:

    # n "He packs the bottles back into their places, then closes the box, sealing them safely inside."
    n "Pone las botellas de vuelta en su sitio, y luego cierra la caja, sellándolas a salvo adentro."

# game/script.rpy:1226
translate es ch3_eaaa499e:

    # w oh "This should go... hm, perhaps it'd be better to set it high on the bookshelf?"
    w oh "Esto debería ir... hm, ¿Quizás sería mejor dejarla en lo alto de la estantería?"

# game/script.rpy:1227
translate es ch3_316ce3eb:

    # w calm "If I just rearrange things a bit, there should be room for everything...."
    w calm "Si reacomodo un poco las cosas, debería haber espacio para todo...."

# game/script.rpy:1229
translate es ch3_7430db52:

    # n "As Periwinkle begins setting things aside, a new pile is born, precariously teetering on the back of the couch."
    n "Cuando Periwinkle empieza a apartar las cosas, se crea una nueva pila, que se tambalea inestablemente en el respaldo del sofá."

# game/script.rpy:1230
translate es ch3_5cf41d37:

    # n "He places the box just where he wants it, and then stacks his various books and knickknacks around it."
    n "Ubica la caja justo como quería, y luego apila sus diversos libros y cachivaches a su alrededor."

# game/script.rpy:1231
translate es ch3_fcaff70c:

    # n "Just as he's made his way through half of the pile, a small portion of it topples forward, bouncing safely onto the couch cushions."
    n "Justo al acabar con la mitad de la pila, una pequeña parte de esta cae hacia adelante, rebotando a salvo sobre los cojines del sofá."

# game/script.rpy:1232
translate es ch3_37943611:

    # w smile "Ha! Topple all you want. I was prepared..."
    w smile "¡Ja! Cae todo lo que quieras. Estaba preparado..."

# game/script.rpy:1233
translate es ch3_6bb6158a:

    # w oh "...Hm?"
    w oh "¿...Hm?"

# game/script.rpy:1236
translate es ch3_04349ffb:

    # n "He finally notices Pastille's jacket, which had expertly blended into the blankets and cushions around it."
    n "Finalmente se percata de la chaqueta de Pastille, que se había camuflado hábilmente entre las mantas y cojines que la rodeaban."

# game/script.rpy:1237
translate es ch3_b6d5bbbe:

    # w happy "Aha! Just when I'd finally worked up the energy to clean up around here, what do I find?"
    w happy "¡Ajá! Justo cuando finalmente me animo a limpiar por aquí, ¿qué es lo que me encuentro?"

# game/script.rpy:1238
translate es ch3_e82a855f:

    # w shy "Yes, this is no mere case of forgetfulness... it was indeed a little game all along!"
    w shy "Sí, este no es el simple caso de un descuido... ¡Se trató de un pequeño juego todo este tiempo!"

# game/script.rpy:1240
translate es ch3_1da6cefd:

    # n "Periwinkle giddily laughs to himself, excited to have been proven right."
    n "Periwinkle ríe frenéticamente para sí mismo, satisfecho de haber tenido razón."

# game/script.rpy:1243
translate es ch3_4aed7301:

    # w love "You've escalated it too far, Pastille! To leave your jacket behind is just ridiculous 💙"
    w love "¡Fuiste demasiado lejos, Pastille! Olvidarte de tu chaqueta es simplemente ridículo 💙"

# game/script.rpy:1244
translate es ch3_ac8d902a:

    # w teehee "He leaves me no choice! I'll just have to return this myself~"
    w teehee "¡No me deja opción! Tendré que devolvérsela yo mismo~"

# game/script.rpy:1245
translate es ch3_6f0e85f3:

    # n "Periwinkle abandons what he was doing, and skips off to his room to get dressed."
    n "Periwinkle deja lo que estaba haciendo, y va a su habitación para vestirse."

# game/script.rpy:1257
translate es ch3_3eb32547:

    # "I hadn't had a chance to return to Atelier Sweets since first meeting Pastille."
    "No había tenido la oportunidad de volver a Atelier Sweets desde mi primer encuentro con Pastille."

# game/script.rpy:1258
translate es ch3_88f3e23d:

    # "He was the one always showing up on MY doorstep, after all. There was no need."
    "Él era el que siempre se aparecía en MI puerta, después de todo. No hubo necesidad."

# game/script.rpy:1259
translate es ch3_928953dd:

    # "It's about time I paid him a visit, yes? I could restock on my favorite candies as well 💙"
    "Ya va siendo hora de que lo visite, ¿verdad? Podría reabastecerme de mis dulces favoritos también 💙"

# game/script.rpy:1260
translate es ch3_76b2fe88:

    # nvl clear
    nvl clear

# game/script.rpy:1263
translate es ch3_8dc899ac:

    # "Upon reaching Atelier Sweets, though, I hesitate."
    "Sin embargo, al llegar a Atelier Sweets, empiezo a dudar."

# game/script.rpy:1264
translate es ch3_803e31e4:

    # "Would it be rude to barge in while he's working? I just know I wouldn't be able to resist teasing him..."
    "¿Sería descortés irrumpir mientras trabaja? Solo sé que no podría resistirme a molestarlo..."

# game/script.rpy:1265
translate es ch3_e56c2f10:

    # "Hm. As to not become a nuisance, I shall make my presence known from here!"
    "Hm. Para no volverme una molestia, ¡haré saber mi presencia desde aquí!"

# game/script.rpy:1266
translate es ch3_d6ac3282:

    # nvl clear
    # n "Periwinkle boldly approaches the bench directly in front of the candy shop, and sits down..."
    nvl clear
    n "Periwinkle audazmente se acerca al banco que hay justo delante de la tienda de dulces, y se sienta..."

# game/script.rpy:1269
translate es ch3_d2fc93d8:

    # n "...all while wearing Pastille's \"forgotten\" jacket."
    n "...mientras lleva puesta la chaqueta \"olvidada\" de Pastille."

# game/script.rpy:1271
translate es ch3_8cd95367:

    # w jacket calm "(And now, we wait 💙)"
    w jacket calm "(Y ahora, esperamos 💙)"

# game/script.rpy:1273
translate es ch3_62dbec77:

    # "A few minutes pass."
    "Unos cuantos minutos pasan."

# game/script.rpy:1274
translate es ch3_5822edc0:

    # "I can see Pastille through the shop window... he's currently preoccupied with a customer."
    "Puedo ver a Pastille por la ventana de la tienda... ahora mismo se encuentra ocupado con un cliente."

# game/script.rpy:1275
translate es ch3_ae539d34:

    # "Luckily, i brought a lunch 💙 A simple peanut butter and jelly sandwich."
    "Por suerte, traje una merienda 💙 un simple sándwich de mantequilla de maní y jalea."

# game/script.rpy:1276
translate es ch3_51d176a4:

    # "Hmhm, will he notice me before I finish it? The customer is walking out now..."
    "Hmhm, ¿Se dará cuenta antes de que lo termine? El cliente ya se está yendo..."

# game/script.rpy:1277
translate es ch3_e963a0d1:

    # nvl clear
    # w jacket shy "(...Ah! Our eyes met 💙)"
    nvl clear
    w jacket shy "(...Ah! Nuestros ojos se encontraron 💙)"

# game/script.rpy:1281
translate es ch3_7d91d129:

    # "Pastille turns away, pacing a bit. I take another bite of my sandwich, still watching intently..."
    "Pastille se da la vuelta, paseando un poco. Le doy otro mordisco a mi sandwich, sin dejar de observar atentamente..."

# game/script.rpy:1282
translate es ch3_83d21bc8:

    # "He stops for a moment, in front of the door behind the register... until finally making his way out of the store, broom in hand."
    "Se detiene por un momento, frente a la puerta que hay detrás de la caja registradora... hasta que finalmente sale de la tienda, escoba en mano."

# game/script.rpy:1283
translate es ch3_5f582295:

    # nvl clear
    # "But instead of coming over right away, he turns his back to me, sweeping the sidewalk in front of the entrance."
    nvl clear
    "Pero en vez de venir directamente, me da la espalda y barre la vereda frente a la entrada."

# game/script.rpy:1285
translate es ch3_07c4f7e6:

    # "Perhaps he has a strict supervisor?"
    "¿Quizás tenga un supervisor estricto?"

# game/script.rpy:1286
translate es ch3_e8ccb9c2:

    # "Ah, he keeps glancing over his shoulder..."
    "Ah, sigue mirándome por encima del hombro..."

# game/script.rpy:1287
translate es ch3_3f34efc0:

    # nvl clear
    # w jacket smile "(Just come over here, you silly boy...)"
    nvl clear
    w jacket smile "(Solo ven aquí, chico tonto...)"

# game/script.rpy:1291
translate es ch3_07af808c:

    # "His face is quite red, so I can say with confidence that I've successfully overwhelmed him once again."
    "Su cara estaba bastante roja, así que puedo decir con certeza que lo he abrumado con éxito una vez más."

# game/script.rpy:1292
translate es ch3_3bd910eb:

    # "I've finished my sandwich by the time he approaches. He takes a seat on the opposite end of the bench."
    "Cuando se acerca, ya he terminado mi sándwich. Toma asiento en el extremo opuesto del banco."

# game/script.rpy:1293
translate es ch3_76b2fe88_1:

    # nvl clear
    nvl clear

# game/script.rpy:1296
translate es ch3_3c3d8923:

    # w jacket happy "Hmhm, I thought you were ignoring me~"
    w jacket happy "Hmhm, pensé que estabas ignorándome~"

# game/script.rpy:1297
translate es ch3_421ea304:

    # p omgstop "N-no, I was just trying to decide what to do."
    p omgstop "N-no, solo intentaba decidir qué hacer."

# game/script.rpy:1298
translate es ch3_c04a6356:

    # w calm "Was this a bad time to return your jacket?"
    w calm "¿Es un mal momento para devolver tu chaqueta?"

# game/script.rpy:1299
translate es ch3_04cd4412:

    # p shy "Not the WORST time...."
    p shy "No es el PEOR momento...."

# game/script.rpy:1300
translate es ch3_4488af6d:

    # w smile "Hm~?"
    w smile "¿Hm~?"

# game/script.rpy:1304
translate es ch3_f83add27:

    # n "Periwinkle unzips the jacket and shuffles out of it, casually folding it onto his lap."
    n "Periwinkle se desabrocha la chaqueta y se la saca, doblándola tranquilamente sobre su regazo."

# game/script.rpy:1306
translate es ch3_d9929887:

    # w cute smile "I found it whilst I was cleaning up the place."
    w cute smile "La encontré mientras limpiaba mi casa."

# game/script.rpy:1307
translate es ch3_83944680:

    # w calm "I suppose I could've waited for you to return, but since I was in the area..."
    w calm "Supongo que podría haber esperado a que regresaras, pero ya que estaba en los alrededores..."

# game/script.rpy:1308
translate es ch3_41a02a3a:

    # p ehe2 "R-right... sorry, it's my fault for leaving it behind in the first place."
    p ehe2 "C-claro... lo siento, es mi culpa por olvidarla en primer lugar."

# game/script.rpy:1311
translate es ch3_b8eb6db7:

    # "Pastille can barely look me in the eye."
    "Pastille apenas puede mirarme a los ojos."

# game/script.rpy:1312
translate es ch3_c5dbde65:

    # "It doesn't stop him from stealing glances at what I'm wearing..."
    "Eso no le impide echar un vistazo a lo que llevo puesto..."

# game/script.rpy:1313
translate es ch3_2d3465a6:

    # "But who could resist that? I wore my cutest dress for this."
    "¿Pero quién podría resistirse? Me puse mi vestido más lindo para esto."

# game/script.rpy:1314
translate es ch3_7a7605c3:

    # nvl clear
    # "Something seems a little off, though..."
    nvl clear
    "Sin embargo, algo parece un poco fuera de lugar..."

# game/script.rpy:1316
translate es ch3_3b5bce35:

    # "He's usually a bundle of nerves, yes, but this is a bit much."
    "Normalmente es un manojo de nervios, sí, pero esto es demasiado."

# game/script.rpy:1317
translate es ch3_949ca487:

    # "I'll get right to the point, then..."
    "Iré directo al grano, entonces..."

# game/script.rpy:1318
translate es ch3_76b2fe88_2:

    # nvl clear
    nvl clear

# game/script.rpy:1322
translate es ch3_3a7b6288:

    # w cute happy "Oh, Pastille. You know you don't have to plant excuses just to visit me~"
    w cute happy "Oh, Pastille. Sabes que no necesitas poner excusas solo para visitarme~"

# game/script.rpy:1323
translate es ch3_3cd8d13c:

    # p "I-I wasn't... planting anything. I just forgot it on my way out."
    p "N-no estaba... poniendo excusas. Solo la olvidé cuando salía."

# game/script.rpy:1324
translate es ch3_528b5cc1:

    # w innocent "I find that hard to believe, considering you've forgotten exactly one thing each time you visit 💙 Really, you should be more honest!"
    w innocent "Me cuesta creerlo, considerando que has olvidado exactamente una cosa cada vez que me visitas 💙"
    w "En serio, ¡deberías ser más honesto!"

# game/script.rpy:1325
translate es ch3_c631c321:

    # p "...Sorry. Thank you, for returning it."
    p "...Lo siento. Gracias, por devolvérmela."

# game/script.rpy:1326
translate es ch3_4428d35a:

    # w teehee "Oh, it's my pleasure 💙 It gave ME a good excuse to see your flustered little face again!"
    w teehee "Oh, el placer es mío 💙 ¡Me DIO una buena excusa para ver tu adorable rostro avergonzado otra vez!"

# game/script.rpy:1329
translate es ch3_4f12e620:

    # n "Periwinkle sets the jacket on the empty space between them, and rises to take his leave..."
    n "Periwinkle deja la chaqueta en el espacio vacío entre ellos, y se levanta para despedirse..."

# game/script.rpy:1330
translate es ch3_c9072ea6:

    # n "But Pastille gently grasps his wrist before he goes."
    n "Pero Pastille toma gentilmente su muñeca antes de que se vaya."

# game/script.rpy:1333
translate es ch3_4b4c0e76:

    # p ohno2 "Peri. I'm, um... Sorry I made you think I was ignoring you."
    p ohno2 "Peri. Yo, um... Perdón por hacerte pensar que estaba ignorándote."

# game/script.rpy:1334
translate es ch3_746feb0b:

    # w cute guilty "Hmhm, I was only teasing, my sweet..."
    w cute guilty "Hmhm, solo estaba bromeando, dulzura..."

# game/script.rpy:1335
translate es ch3_364bac5b:

    # p nervous "Still. I can't, um... I'm not ready to be open about who I see outside of work."
    p nervous "Aún así. No puedo, um... no estoy listo para abrirme sobre quién veo fuera del trabajo."

# game/script.rpy:1336
translate es ch3_b4a86c3f:

    # p flustered2 "I like to keep things VERY discreet--I don't want to have to explain anything to my friends. I'd die of embarrassment."
    p flustered2 "Prefiero mantener las cosas MUY discretas--No quiero tener que explicar nada a mis amigas. Moriría de la vergüenza."

# game/script.rpy:1337
translate es ch3_af748ba9:

    # w neutral "(So that's why...)"
    w neutral "(Así que es por eso...)"

# game/script.rpy:1338
translate es ch3_a218c7e9:

    # w calm "Understood 💙 I'm actually used to being someone's little secret--"
    w calm "Es comprensible 💙 De hecho estoy acostumbrado a que me tengan como un secreto--"

# game/script.rpy:1339
translate es ch3_eda2d17a:

    # w neutral "...Hm, that didn't sound quite right."
    w neutral "...Hm, eso no sonó del todo bien."

# game/script.rpy:1340
translate es ch3_0c3f8324:

    # w guilty "What I'm trying to say is, I don't mind at all! From now on, I'll just continue to let you come to me 💙"
    w guilty "Lo que intento decir es, ¡no pasa nada! Desde ahora, me limitaré a que solo tú vengas a mí 💙"

# game/script.rpy:1341
translate es ch3_a683dc07:

    # p nervous "Th-thank you... sorry."
    p nervous "G-gracias... lo siento."

# game/script.rpy:1342
translate es ch3_3eba0b21:

    # w smile "I don't know what you keep apologizing for, Pastille. I'll see you around, yes?"
    w smile "No sé de qué te sigues disculpando, Pastille. Nos vemos pronto, ¿sí?"

# game/script.rpy:1344
translate es ch3_c525b41f:

    # n "Pastille nods... and finally lets go of his wrist."
    n "Pastille asiente... y finalmente suelta su muñeca."

# game/script.rpy:1347
translate es ch3_60877f15:

    # "A misstep."
    "Un paso en falso."

# game/script.rpy:1348
translate es ch3_0850fd13:

    # "A HUGE misstep..."
    "Un GRAN paso en falso..."

# game/script.rpy:1349
translate es ch3_12ede38d:

    # "I should've guessed it, from the hints he's given--just a few things he's said here and there."
    "Debí haberlo adivinado, por las pistas que dejó--unas cuantas cosas que ha dicho aquí y allá."

# game/script.rpy:1350
translate es ch3_7808934e:

    # "It was enough to put it together, wasn't it?"
    "Era suficiente para darse cuenta, ¿no es así?"

# game/script.rpy:1351
translate es ch3_b3bd1b1f:

    # "The most obvious one being that he always comes to me, and not the other way around."
    "La más obvia es que siempre es él quien viene a mí, y no al revés."

# game/script.rpy:1352
translate es ch3_938f9378:

    # nvl clear
    # "Our comfortable pattern, that I recklessly interrupted..."
    nvl clear
    "Nuestro cómodo patrón, que interrumpí imprudentemente..."

# game/script.rpy:1354
translate es ch3_ec8d7b96:

    # "I should've known, from previous encounters with closeted individuals."
    "Debí haberlo sabido, al ya haber tenido encuentros con personas así de cerradas antes."

# game/script.rpy:1355
translate es ch3_de6c6bc1:

    # nvl clear
    # "What's supposed to be a fun, surprise appearance can turn so quickly into a desperate rally to cling to normalcy, carefully constructed lies to conceal the piece of yourself that may not be accepted..."
    nvl clear
    "Lo que debía ser una divertida aparición sorpresa puede acabar convirtiéndose en un desesperado intento de aferrarse a la normalidad, en mentiras cuidadosamente elaboradas para ocultar un lado de ti que podría no ser aceptado..."

# game/script.rpy:1357
translate es ch3_21ce2d92:

    # "...whether it's by the individual themself, or by their loved ones."
    "...ya sea por el individuo mismo, o por sus seres queridos."

# game/script.rpy:1358
translate es ch3_b4dd5416:

    # "Certainly an unenviable position to find oneself in."
    "Ciertamente, una situación poco envidiable en la cual encontrarse."

# game/script.rpy:1359
translate es ch3_13b8ccf7:

    # nvl clear
    # "Pastille and I had been seeing a lot of each other during this past month. Was this the inevitable breaking point, then?"
    nvl clear
    "Pastille y yo nos estuvimos viendo bastante durante este último mes. ¿Era este el inevitable punto de ruptura, entonces?"

# game/script.rpy:1361
translate es ch3_6c9c44e5:

    # "It can only become more complicated from here..."
    "Solo puede volverse más complicado a partir de ahora..."

# game/script.rpy:1362
translate es ch3_c8a0c4e8:

    # "Ah, but it was going so perfectly for so long! Perhaps I'm being overdramatic..."
    "Ah, ¡Pero iba tan perfectamente hasta ahora! Quizás estoy siendo demasiado dramático..."

# game/script.rpy:1363
translate es ch3_e10ad652:

    # "I haven't grown tired of him at all... which is precisely the problem."
    "No me he cansado para nada de él... lo cual es precisamente el problema."

# game/script.rpy:1364
translate es ch3_454f79c8:

    # nvl clear
    # "Unwilling to return home so soon, I walk in the direction of the apothecary."
    nvl clear
    "Indispuesto a volver a casa tan pronto, camino en dirección a la botica."

# game/script.rpy:1366
translate es ch3_3454f89c:

    # "Astragalus will be able to knock some sense in me. She always does."
    "Astragalus logrará hacerme entrar en razón. Siempre lo hace."

# game/script.rpy:1367
translate es ch3_76b2fe88_3:

    # nvl clear
    nvl clear

# game/script.rpy:1376
translate es ch3_91bceeeb:

    # w cute whine "Astragalus~~ Are you busy~~~?"
    w cute whine "Astragalus~~ ¿Estás ocupada~~?"

# game/script.rpy:1378
translate es ch3_6043f839:

    # a "Ugh, I know that whine. You've shifted into dramatic bitch mode."
    a "Ugh, conozco ese lloriqueo. Cambiaste al modo de perro dramático."

# game/script.rpy:1379
translate es ch3_b9bb5e72:

    # w pout "Take pity on me. I'm having a bad day."
    w pout "Ten piedad de mí. Estoy teniendo un mal día."

# game/script.rpy:1380
translate es ch3_637bc98d:

    # a whatever "Alright, ya baby, tell me what happened. (Things are slow today anyhow...)"
    a whatever "Muy bien, muchacho, dime qué pasó. (Las cosas están lentas hoy de todos modos...)"

# game/script.rpy:1386
translate es ch3_06ace653:

    # "Astragalus listened patiently as I explained the events of the day..."
    "Astragalus escuchó pacientemente mientras explicaba los acontecimientos del día..."

# game/script.rpy:1387
translate es ch3_4ad450d5:

    # "I've learned to come straight to her whenever I find myself unable to make a decision."
    "He aprendido a acudir directamente a ella cada vez que me veo incapaz de tomar una decisión."

# game/script.rpy:1388
translate es ch3_fcc6a442:

    # "Although she often puts things far too bluntly, I DO always end up feeling more grounded after her consolation..."
    "Aunque suele decir las cosas con demasiada sinceridad, SIEMPRE termino sintiéndome más tranquilo luego de su consuelo..."

# game/script.rpy:1389
translate es ch3_c8e8adb4:

    # nvl clear
    # a annoyed "So... you're upset, because you overstepped his bounds."
    nvl clear
    a annoyed "Entonces... te sientes mal, ya que sobrepasaste sus límites."

# game/script.rpy:1392
translate es ch3_67e72a49:

    # w cute whine2 "Accidentally!! You always leave out key information..."
    w cute whine2 "¡¡Accidentalmente!! Siempre olvidas información clave..."

# game/script.rpy:1393
translate es ch3_2ed789cb:

    # a whatever "And now you think it's over between you two."
    a whatever "Y ahora piensas que todo terminó entre ustedes dos."

# game/script.rpy:1394
translate es ch3_bb6894dc:

    # w oops "When you put it like that, I really DO sound dramatic..."
    w oops "Cuando lo pones así, SUENO realmente dramático..."

# game/script.rpy:1395
translate es ch3_c1b6eb3c:

    # a think "I mean, you are. But you also have a point."
    a think "Es decir, lo eres. Pero también tienes un punto."

# game/script.rpy:1396
translate es ch3_28a5e162:

    # a neutral "If you wanna avoid things getting complicated, this is your sign to get out."
    a neutral "Si quieres evitar que las cosas se compliquen, esta es tu señal para alejarte."

# game/script.rpy:1397
translate es ch3_5e7d2a22:

    # a lol "I gotta say, though... for two guys who AREN'T in a committed relationship, you sure do sound like you're in one."
    a lol "Aunque debo decir... para ser dos chicos que NO están en una relación seria, realmente suena como si estuvieran en una."

# game/script.rpy:1398
translate es ch3_aa0b0ee9:

    # w pout "It's purely casual. I've still been seeing a few others in the midst of this!"
    w pout "Es puramente casual. ¡He seguido viéndome con algunos más en medio de esto!"

# game/script.rpy:1399
translate es ch3_382e4d30:

    # a sure "Buuut all you talk about is Pastille. Every time you come in here--"
    a sure "Peeero Pastille es de todo lo que hablas. Siempre que vienes aquí--"

# game/script.rpy:1400
translate es ch3_e8d058af:

    # w conflicted "Ugh, I know! I know..."
    w conflicted "Ugh, ¡Lo sé! Lo sé..."

# game/script.rpy:1401
translate es ch3_1b2b8580:

    # w oops "I just wish I hadn't gone to return the jacket. It was supposed to be fun, but now..."
    w oops "Solo desearía no haber ido a devolver la chaqueta. Se suponía que sería divertido, pero ahora..."

# game/script.rpy:1402
translate es ch3_e4e99817:

    # a whatever "Yeah, honestly, I think he's being unfair. He shows up to your place whenever he wants, right?"
    a whatever "Sí, honestamente, creo que está siendo injusto. Él aparece en tu casa cuando quiere, ¿verdad?"

# game/script.rpy:1403
translate es ch3_d71e409e:

    # w sorry "Yes, but I don't have anything else going on! He has a respectable job and all..."
    w sorry "Sí, ¡Pero yo no tengo nada más que hacer! Él tiene un trabajo respetable y todo..."

# game/script.rpy:1404
translate es ch3_bf1c7745:

    # a think "Mm... Sounds like you just have less self-respect, and this guy isn't treating you right."
    a think "Mm... Suenas como si tuvieras poco respeto por ti mismo, y que este chico no te está tratando bien."

# game/script.rpy:1405
translate es ch3_ec693909:

    # w pout "Now THAT'S unfair. He simply said he wasn't READY--it doesn't mean..."
    w pout "ESO sí es injusto. Solo dijo que no estaba LISTO--eso no significa..."

# game/script.rpy:1406
translate es ch3_8014452b:

    # a lmao "Hah, making excuses now? You are REALLY hung up on him! This is too hilarious to watch!" with vpunch
    a lmao "Ja, ¿Ahora pones excusas? ¡EN SERIO estás enganchado a él! ¡Esto es tan gracioso de ver!" with vpunch

# game/script.rpy:1407
translate es ch3_7d2a4c03:

    # w yell "Enough!! I-I...!"
    w yell "¡¡Basta!! ¡Y-Yo...!"

# game/script.rpy:1408
translate es ch3_2092e4fa:

    # w whine "I simply cannot help it if he's just the cutest thing! Of course I don't want to stop seeing him!"
    w whine "¡Simplemente no puedo evitarlo cuando es la cosa más linda! ¡Claro que no quiero dejar de verlo!"

# game/script.rpy:1413
translate es ch3_94eb88e1:

    # "At that moment, a familiar chime sounded, marking a customer's arrival."
    "En ese momento, suena un timbre familiar, que indica la llegada de un cliente."

# game/script.rpy:1414
translate es ch3_6f5dcd39:

    # "I turn my head instinctively to see..."
    "Volteo la cabeza instintivamente para ver..."

# game/script.rpy:1415
translate es ch3_76b2fe88_4:

    # nvl clear
    nvl clear

# game/script.rpy:1418
translate es ch3_5c881dad:

    # j "Periwinkle? Omg, you look so cute today!"
    j "¿Periwinkle? Oh dios, ¡te ves muy lindo hoy!"

# game/script.rpy:1419
translate es ch3_64869387:

    # w cute innocent "Why, thank you! I certainly didn't expect to see you here, Jam!"
    w cute innocent "¡Oh, gracias! ¡Ciertamente no esperaba verte aquí, Jam!"

# game/script.rpy:1421
translate es ch3_d980971d:

    # n "Astragalus walks into the back room, still laughing at Periwinkle's expense."
    n "Astragalus se dirige a la trastienda, aún riéndose a espaldas de Periwinkle."

# game/script.rpy:1423
translate es ch3_d4d720aa:

    # j ehe "I've been coming here to buy your magic!"
    j ehe "¡Vine aquí para comprar tu magia!"

# game/script.rpy:1424
translate es ch3_85592859:

    # j wink "Remember when you did a little demo for everyone at that one party? You totally sold me on it back then."
    j wink "¿Recuerdas cuando hiciste una pequeña demostración para todos en una fiesta? Me atrapaste totalmente en ese entonces."

# game/script.rpy:1425
translate es ch3_4e79c9b8:

    # w calm "Hm, I've done a few, so I can't recall... but I'm happy to hear it regardless!"
    w calm "Hm, lo he hecho unas cuantas veces, así que no lo recuerdo... ¡Pero me alegra oír eso de todas formas!"

# game/script.rpy:1426
translate es ch3_f9bf92a0:

    # j oh "So what are YOU doing here? On a date, or on the job?"
    j oh "¿Y qué estás haciendo TÚ aquí? ¿En una cita, o en el trabajo?"

# game/script.rpy:1427
translate es ch3_b4e34e50:

    # w decline "No date today. I ruined my chance at THAT..."
    w decline "No hay cita hoy. Arruiné ESA oportunidad..."

# game/script.rpy:1428
translate es ch3_cd4e936d:

    # j whaaat "Aww man, what?! That's such a bummer..."
    j whaaat "Aww hombre, ¡¿qué?! Eso es una pena..."

# game/script.rpy:1429
translate es ch3_97e4a9ca:

    # j think "Really never thought I'd hear of the day YOU of all people couldn't get a date, though. You date, like, EVERYONE..."
    j think "Aunque nunca pensé que llegaría el día en que TÚ de todas las personas no pudieras obtener una cita. Sales con, bueno, TODOS..."

# game/script.rpy:1430
translate es ch3_05e71c7d:

    # w smile "It'd be more accurate to say I \"go on dates\" with everyone, rather than ACTUALLY date them."
    w smile "Sería más apropiado decir que \"tengo citas\" con todo el mundo, más que REALMENTE salir con ellos."

# game/script.rpy:1431
translate es ch3_634602b5:

    # j smile "Aww, same diff. You're like, the thirstmaster."
    j smile "Aww, es lo mismo. Eres como, el amo del deseo."

# game/script.rpy:1432
translate es ch3_f2f6583a:

    # w neutral "(Mm... she's right. It's not as if Pastille is my only option if I'm looking for a good time.)"
    w neutral "(Mm... tiene razón. No es como si Pastille fuera mi única opción si lo que busco es pasar un buen rato.)"

# game/script.rpy:1433
translate es ch3_31a53245:

    # j ehe "Anyway, are you going to Chirval's party tonight?"
    j ehe "De todos modos, ¿irás a la fiesta de Chirval esta noche?"

# game/script.rpy:1434
translate es ch3_033d403f:

    # w oh "No, this is the first I've heard of it! He's throwing yet another soirée?"
    w oh "No, ¡Es primera vez que lo escucho! ¿Está organizando otra velada?"

# game/script.rpy:1435
translate es ch3_be55c58e:

    # j oh "Yeah, I'm surprised you didn't know!"
    j oh "Sí, ¡Me sorprende que no lo supieras!"

# game/script.rpy:1436
translate es ch3_a54aaec3:

    # w guilty "I suppose I've been more out of the loop on these things than usual..."
    w guilty "Supongo que he estado menos al margen de estas cosas que de lo habitual..."

# game/script.rpy:1437
translate es ch3_de488a64:

    # w oops "(I haven't bothered with as many parties, since...)"
    w oops "(No me he molestado con demasiadas fiestas, desde entonces...)"

# game/script.rpy:1438
translate es ch3_7188d2a4:

    # j smile "Well, you should come! They're good luck. Like, in terms of love~ and romance~!"
    j smile "Bueno, ¡deberías venir! Son de buena suerte. O sea, en términos de amor~ ¡y de romance~!"

# game/script.rpy:1439
translate es ch3_3aa62bce:

    # j embarrassed "I mean, I'm finally dating my best friend, thanks to that last one...!"
    j embarrassed "Quiero decir, ¡Al fin estoy saliendo con mi mejor amiga, gracias a la última que hubo...!"

# game/script.rpy:1440
translate es ch3_61645db5:

    # w oh "Ah--Marzipan, wasn't it? You weren't together before that?"
    w oh "Ah--¿Marzipan, se llamaba? ¿No estaban juntas desde antes?"

# game/script.rpy:1441
translate es ch3_a063a141:

    # j whaaat "AHHHH, I knew everyone thought we were...! Ugh, so embarrassing..." with vpunch
    j whaaat "AHHHH, ¡Sabía que todos pensaban que lo estábamos...! Ugh, qué vergonzoso..." with vpunch

# game/script.rpy:1442
translate es ch3_949360b6:

    #j embarrassed2 "I guess what matters is we could finally be totally honest with each other, though... Ahh, I'm really happy...."
    j embarrassed2 "Aunque supongo que lo importante es que al fin podemos ser totalmente honestas la una con la otra... Ahh, estoy tan feliz...."

# game/script.rpy:1443
translate es ch3_c9023fe1:

    # w happy "Well, congratulations! You deserve that happiness."
    w happy "¡Vaya, felicidades! Te mereces esa felicidad."

# game/script.rpy:1444
translate es ch3_802b14e9:

    # j wink "Yeah!! So like, if you ever need relationship advice, I'm your gal!"
    j wink "¡¡Sí!! Así que, si llegas a necesitar consejos sobre relaciones, ¡aquí me tienes!"

# game/script.rpy:1445
translate es ch3_f17415bb:

    # j think "Oh--but I guess you wouldn't, since you don't actually date anyone..."
    j think "Oh--pero supongo que no lo harías, ya que en realidad no sales con nadie..."

# game/script.rpy:1447
translate es ch3_3f2cc2ed:

    # n "Periwinkle hears Astragalus snorting with laughter in the back room."
    n "Periwinkle oye a Astragalus resoplar de la risa en la trastienda."

# game/script.rpy:1449
translate es ch3_18044365:

    # w insulted "(How dare she! I came here to be comforted, not ridiculed...!)" with vpunch
    w insulted "(¡Cómo se atreve! ¡Vine aquí para que me consuelen, no que me ridiculicen...!)" with vpunch

# game/script.rpy:1450
translate es ch3_d074eaf6:

    # w innocent "Jam, dear. What time did you say that party started?"
    w innocent "Jam, querida. ¿A qué hora dijiste que empezaba esa fiesta?"

# game/script.rpy:1451
translate es ch3_79b12204:

    # j oh "Oh, like... a few hours from now? I think?"
    j oh "Oh, como en.. ¿dentro de unas horas? ¿Creo?"

# game/script.rpy:1452
translate es ch3_26dd1657:

    # j embarrassed "Sorry, I can never remember the time difference between here and the Netherworld...."
    j embarrassed "Lo siento, nunca recuerdo la diferencia horaria entre aquí y el Inframundo...."

# game/script.rpy:1453
translate es ch3_b3aad0af:

    # w calm "No matter. These things tend to go all night, and I prefer to arrive fashionably late."
    w calm "No importa. Estas cosas suelen durar toda la noche, y además prefiero llegar elegantemente tarde."

# game/script.rpy:1454
translate es ch3_08184ed7:

    # w smile "Now if you'll excuse me, I'm going to return home to freshen up before the soirée."
    w smile "Ahora si me disculpas, regresaré a mi casa para arreglarme antes de la velada."

# game/script.rpy:1455
translate es ch3_fc7b2769:

    # j ehe "Sure! See ya there~"
    j ehe "¡Seguro! Nos vemos allá~"

# game/script.rpy:1461
translate es ch3_bbcb516d:

    # n "Periwinkle marches home in a huff."
    n "Periwinkle se marcha enfadado a casa."

# game/script.rpy:1462
translate es ch3_61c2becd:

    # w cute pout "(Hmph... Astragalus thinks I'm lacking in self-respect.)"
    w cute pout "(Hmph... Astragalus cree que me falta respeto por mí mismo.)"

# game/script.rpy:1463
translate es ch3_68f32e6f:

    # w "(I'll show her...!)"
    w "(¡Le enseñaré...!)"

# game/script.rpy:1465
translate es ch3_dcc6e26c:

    # "I'm going to find someone to spoil me tonight!"
    "¡Encontraré a alguien con quien pasarla esta noche!"

# game/script.rpy:1466
translate es ch3_c3ca6d80:

    # "Netherworld parties happen to be the perfect venue--always filled with cute faces I haven't yet encountered."
    "Las fiestas del inframundo resultan ser el lugar perfecto--siempre lleno de caras lindas que no me había encontrado antes."

# game/script.rpy:1467
translate es ch3_439ac636:

    # "Plenty of incubi as well... they LIVE to please their partners."
    "Muchos íncubos también... ellos VIVEN para complacer a sus parejas."

# game/script.rpy:1468
translate es ch3_8e765de2:

    # "It's been a while since I've slept with a demon... 💙 I'm looking forward to this now~!"
    "Hacía tiempo que no me acostaba con un demonio... 💙 ¡Estoy esperándolo con ansias~!"

# game/script.rpy:1469
translate es ch3_078fe372:

    # nvl clear
    # centered "{nw}"
    nvl clear
    centered "{nw}"

# game/script.rpy:1481
translate es ch3_fb133186:

    # n "And so, a few hours later..."
    n "Y así, unas horas más tarde..."

# game/script.rpy:1487
translate es ch3_09c7b9d1:

    # n "Periwinkle arrives at the soirée."
    n "Periwinkle llega a la velada."

# game/script.rpy:1490
translate es ch3_a3391362:

    # w drool "(Let's see... who looks available~?)"
    w drool "(Veamos... ¿Quién luce disponible~?)"

# game/script.rpy:1491
translate es ch3_fdd167fd:

    # n "Scanning the room, he spots both Jam and Chirval happily chatting with the other guests."
    n "Examinando la sala, ve a Jam y a Chirval charlando alegremente con el resto de invitados."

# game/script.rpy:1492
translate es ch3_56343088:

    # w shy "(Chirval himself certainly isn't a bad lay... but I couldn't go stealing the host of the party~!)"
    w shy "(Chirval sin duda no es malo en la cama... ¡Pero no puedo ir robándome al anfitrión de la fiesta~!)"

# game/script.rpy:1494
translate es ch3_cbeff3b4:

    # n "Periwinkle begins to gravitate toward the snack table, still scoping out the various party-goers."
    n "Periwinkle comienza a moverse hacia la mesa de aperitivos, aún observando a los diversos asistentes a la fiesta."

# game/script.rpy:1495
translate es ch3_200cad0c:

    # w smile "(Plenty of candidates to choose from... however will I decide? 💙)"
    w smile "(Tantos candidatos para elegir... ¿Por quién me decidiré? 💙)"

# game/script.rpy:1496
translate es ch3_70adf595:

    # n "Before he can make up his mind about who to approach, a taller demon slides into the empty space beside him to start a conversation."
    n "Antes de poder decidir a quién acercarse, un demonio más alto se cuela en el espacio vacío a su lado para iniciar una conversación."

# game/script.rpy:1499
translate es ch3_404ac1b2:

    # k "Lotsa cute witches at this soirée, huh?"
    k "Muchos brujos lindos en esta fiesta, ¿huh?"

# game/script.rpy:1500
translate es ch3_356d9a00:

    # w drool "(Oh, so it's been decided FOR me~! I'm ALREADY being spoiled 💙)"
    w drool "(Oh, ¡entonces fue decidido POR mí~! YA estoy siendo consentido 💙)"

# game/script.rpy:1501
translate es ch3_2c4909af:

    # w calm "I didn't come here for the witches."
    w calm "No vine aquí por los brujos."

# game/script.rpy:1502
translate es ch3_4245e0f8:

    # k happy "Hah! ...I'm Kardaemon."
    k happy "¡Ja! ...soy Kardaemon."

# game/script.rpy:1503
translate es ch3_02708700:

    # w smile "Periwinkle."
    w smile "Periwinkle."

# game/script.rpy:1504
translate es ch3_f4579e3e:

    # k shy "Periwinkle... So, this is gonna sound weird, but..."
    k shy "Periwinkle... Bien, esto sonará extraño, pero..."

# game/script.rpy:1505
translate es ch3_8c6f158c:

    # k ask "Do I... know you from somewhere?"
    k ask "¿Te... conozco de alguna parte?"

# game/script.rpy:1506
translate es ch3_c35e243b:

    # w teehee "Your dreams, perhaps?"
    w teehee "¿Tus sueños, quizás?"

# game/script.rpy:1507
translate es ch3_51d2fdbc:

    # k laugh "Naww, for real! Something about your face is just so familiar..."
    k laugh "¡Nahh, de verdad! Algo en tu rostro se me hace muy familiar..."

# game/script.rpy:1508
translate es ch3_1dab2d42:

    # w smile "I frequent these type of events, so it's likely we've crossed paths at some point."
    w smile "Frecuento este tipo de eventos, por lo que es probable que nos hayamos cruzado en algún momento."

# game/script.rpy:1509
translate es ch3_97371c3b:

    # k shy "Hmmmm... that's not it. I woulda tried hitting on you if we did."
    k shy "Hmmmm... no es eso. Si lo fuera hubiera intentado coquetear contigo."

# game/script.rpy:1510
translate es ch3_9e11e78c:

    # w happy "Hmhm, well, you're certainly free to do so now 💙"
    w happy "Hmhm, bueno, pues eres libre de hacerlo ahora 💙"

# game/script.rpy:1511
translate es ch3_7862bf1b:

    # k happy "I'll give it a shot! With your permission, haha..."
    k happy "¡Voy a intentarlo! Con tu permiso, jaja..."

# game/script.rpy:1512
translate es ch3_96386f57:

    # w smile "(This one isn't bad... I do appreciate how straightforward he's being.)"
    w smile "(Este no está mal... aprecio lo directo que está siendo.)"

# game/script.rpy:1513
translate es ch3_c4cc7630:

    # k smile "So! What ARE you here for, if not the witches?"
    k smile "¡Entonces! ¿Qué te TRAE por aquí, si no son los brujos?"

# game/script.rpy:1514
translate es ch3_f5eef97f:

    # w innocent "I had intended to find someone to spoil me... and incubi are rumored to be good for exactly that 💙"
    w innocent "Pensaba encontrar a alguien con quien pasarla esta noche... y se rumorea que los íncubos son justamente buenos en eso 💙"

# game/script.rpy:1515
translate es ch3_513f012e:

    # k shy "We are, we are..."
    k shy "Lo somos, lo somos..."

# game/script.rpy:1516
translate es ch3_19ddae00:

    # w my "So the rumors are true~? I'm in luck, then!"
    w my "¿Así que los rumores son ciertos~? ¡Entonces estoy de suerte!"

# game/script.rpy:1517
translate es ch3_f89607ce:

    # w teehee "Would you happen to have any friends who would be interested in dancing with a cute little witch like me~?"
    w teehee "¿De casualidad tienes algún amigo que esté interesado en bailar con un lindo brujito como yo~?"

# game/script.rpy:1518
translate es ch3_6d7a44bf:

    # k "Hmmmmmmm... I could ask around."
    k "Hmmmmmmm... podría preguntar por ahí."

# game/script.rpy:1519
translate es ch3_5efc4a86:

    # k smile "Or! Better idea. You could just settle for me?"
    k smile "¡O! Mejor idea. ¿Podrías solo conformarte conmigo?"

# game/script.rpy:1520
translate es ch3_c9017794:

    # w calm "Hmhm, I suppose you'll do 💙"
    w calm "Hmhm, supongo que así será 💙"

# game/script.rpy:1523
translate es ch3_50b7709f:

    # "I present my hand, and Kardaemon gives an exaggerated bow."
    "Ofrezco mi mano, y Kardaemon hace una exagerada reverencia."

# game/script.rpy:1524
translate es ch3_084b6170:

    # "He pulls me in, albeit a little clumsily, with his gigantic demon hands. Always enjoyable to be swept up in the arms of a larger man 💙"
    "Me atrae hacía él, con algo de torpeza, con sus gigantescas manos de demonio. Siempre es agradable ser arrastrado por los brazos de un hombre más grande 💙"

# game/script.rpy:1525
translate es ch3_272b335d:

    # "My own hand is almost entirely consumed by his. Unlike with Pastille's, which fit so--"
    "Mi mano está casi enteramente consumida por la suya. A diferencia de la de Pastille, que encaja perfec--"

# game/script.rpy:1526
translate es ch3_36f5d814:

    # nvl clear
    # "...Pastille?"
    nvl clear
    "¿...Pastille?"

# game/script.rpy:1528
translate es ch3_bd6489c5:

    # "Am I STILL comparing everyone to him?"
    "¿SIGO comparándo a todos con él?"

# game/script.rpy:1529
translate es ch3_c405272e:

    # "I shake the thought and return to the moment..."
    "Me deshago de ese pensamiento y regreso al presente..."

# game/script.rpy:1530
translate es ch3_76b2fe88_5:

    # nvl clear
    nvl clear

# game/script.rpy:1533
translate es ch3_4dfd153d:

    # n "The pair twirls around the dance floor, losing themselves in the music."
    n "La pareja da vueltas por la pista de baile, perdiéndose en la música."

# game/script.rpy:1534
translate es ch3_17b0a74e:

    # n "After a while, Kardaemon suddenly speaks up."
    n "Después de un rato, Kardaemon habla de repente."

# game/script.rpy:1535
translate es ch3_122eb838:

    # k "...OH! I think I just realized where I know you from!"
    k "¡...OH! ¡Creo que ya sé de dónde te conozco!"

# game/script.rpy:1536
translate es ch3_5a8eabf4:

    # w love "Really, now?"
    w love "¿De verdad?"

# game/script.rpy:1537
translate es ch3_5ae9085a:

    # k "Yeah, you were in the magazine I work for!"
    k "Sí, ¡estuviste en la revista para la que trabajo!"

# game/script.rpy:1538
translate es ch3_a784e394:

    # k "I'm an editor. We used your photos for an issue a couple years back."
    k "Soy un editor. Usamos tus fotos para un artículo hace un par de años."

# game/script.rpy:1539
translate es ch3_efcb9510:

    # w oh "Ah... what a coincidence. I DID used to do some modeling, in the past..."
    w oh "Ah... qué coincidencia. SOLÍA hacer algo de modelaje, en el pasado..."

# game/script.rpy:1540
translate es ch3_07b8e242:

    # w calm "And in the past it shall remain. I'm in a different line of work now."
    w calm "Y permanecerá en el pasado. Ahora trabajo en algo diferente."

# game/script.rpy:1541
translate es ch3_e86cb7f9:

    # k "Aww, really? That's too bad. I always thought you looked amazing."
    k "Aww, ¿en serio? Es una lástima. Siempre pensé que te veías fantástico."

# game/script.rpy:1542
translate es ch3_014598d5:

    # w smile "Hmhm, I appreciate that 💙"
    w smile "Hmhm, te lo agradezco 💙"

# game/script.rpy:1545
translate es ch3_eac59ccf:

    # w neutral "(Well this certainly complicates things... I'd much prefer to have been complete strangers.)"
    w neutral "(Bueno, esto ciertamente complica las cosas... hubiera preferido que fuésemos completamente extraños.)"

# game/script.rpy:1546
translate es ch3_54236a36:

    # w decline "(How unfortunate... just when I was beginning to enjoy myself.)"
    w decline "(Qué inoportuno... justo cuando empezaba a divertirme.)"

# game/script.rpy:1549
translate es ch3_7c244efe:

    # k "Haha, wow, I can't believe I ran into you like this. Maybe it's a sign...?"
    k "Jaja, wow, no puedo creer que me haya encontrado contigo así. ¿Tal vez sea una señal...?"

# game/script.rpy:1550
translate es ch3_f26130c5:

    # w smile "A sign? Of what, dare I ask?"
    w smile "¿Una señal? ¿De qué, se puede saber?"

# game/script.rpy:1551
translate es ch3_41d59cda:

    # k smile "That you should come back to modeling! I can get you in our magazine again--if you're interested, that is."
    k smile "¡De que deberías volver al modelaje! Puedo conseguir que vuelvas a nuestra revista--si te interesa, claro."

# game/script.rpy:1552
translate es ch3_24632a00:

    # w guilty "I appreciate the offer, but I've moved on. It put too much of a strain on my relationship with fashion, among other things..."
    w guilty "Aprecio la oferta, pero he pasado de página. Me causaba demasiada presión en mi relación con la moda, entre otras cosas..."

# game/script.rpy:1553
translate es ch3_9bbf2611:

    # k shy "Ah... well, at least take my card! In case you change your mind."
    k shy "Ah... bueno, ¡al menos toma mi tarjeta! Por si cambias de opinión."

# game/script.rpy:1554
translate es ch3_1ae6e450:

    # w calm "No thank you. I don't see that happening."
    w calm "No, gracias. Dudo que eso pase."

# game/script.rpy:1555
translate es ch3_12306026:

    # k laugh "Aww, come on... you'd be so great! It feels like such a waste of talent...."
    k laugh "Aww, vamos... ¡Estarías tan genial! Se siente como un desperdicio de talento...."

# game/script.rpy:1556
translate es ch3_51eac4d1:

    # w neutral "(Hm... I'm quickly growing tired of this.)"
    w neutral "(Hm... ya me estoy cansando de esto.)"

# game/script.rpy:1557
translate es ch3_c4d486cb:

    # w smile "Thank you for the dance... but I really should be going now."
    w smile "Gracias por el baile... pero en realidad debería irme ya."

# game/script.rpy:1558
translate es ch3_33e9643f:

    # k huh "Huh? Ah, uh... sure."
    k huh "¿Huh? Ah, uh... claro."

# game/script.rpy:1559
translate es ch3_b30b1ced:

    # w innocent "This was fun. Perhaps we'll meet again sometime 💙"
    w innocent "Fue divertido. Puede que nos volvamos a encontrar en otra ocasión 💙"

# game/script.rpy:1560
translate es ch3_0d5df227:

    # k sad "Y-yeah...."
    k sad "S-Sí...."

# game/script.rpy:1567
translate es ch3_ef15a56c:

    # "I didn't expect to be reminded of my modeling days of all things..."
    "De todas las cosas no esperaba que me hiciesen recordar mis días de modelaje..."

# game/script.rpy:1568
translate es ch3_bad021ca:

    # "Although his excitement was understandable, the way he went about it certainly ruined the mood."
    "Aunque su entusiasmo era comprensible, la forma en que lo abordó arruinó el ambiente."

# game/script.rpy:1569
translate es ch3_72a95f04:

    # "I hate to admit it, but I'd gone into this night far too unstable to begin with. For such a small thing to get to me..."
    "Odio admitirlo, pero llegué a esta noche muy inestable para empezar. Para que una cosa tan pequeña me afecte..."

# game/script.rpy:1570
translate es ch3_5ad7ada1:

    # nvl clear
    # "I'm not even here on my own terms, am I?"
    nvl clear
    "Ni siquiera estoy aquí bajo mis propios términos, ¿no?"

# game/script.rpy:1572
translate es ch3_2f4d44d7:

    # "This was all to prove a point. That's certainly not in the spirit of a friendly soirée..."
    "Todo esto fue para demostrar algo. Sin duda ese no es el espíritu de una velada agradable..."

# game/script.rpy:1573
translate es ch3_d4b47508:

    # "It's best I just return home and--"
    "Será mejor que solo vuelva a casa y--"

# game/script.rpy:1574
translate es ch3_f36f833e:

    # nvl clear
    # k "Periwinkle, wait!"
    nvl clear
    k "¡Periwinkle, espera!"

# game/script.rpy:1577
translate es ch3_f6a6af3b:

    # n "He turns his head to find that Kardaemon has chased after him, stumbling into the lonely night air."
    n "Se voltea para descubrir que Kardaemon lo había perseguido, tropezando en el oscuro aire nocturno."

# game/script.rpy:1579
translate es ch3_29be8e4a:

    # k "Hey--I, uh... I'm sorry if I said anything to upset you."
    k "Hey--Yo, uh... perdón si dije algo que te molestara."

# game/script.rpy:1580
translate es ch3_63733355:

    # w oh "...Upset me? Perish the thought!"
    w oh "¿...Me molestara? ¡De ninguna manera!"

# game/script.rpy:1581
translate es ch3_7415dc79:

    # w guilty "It's simply that I'm feeling a little off tonight. I realized I may have come here for the wrong reasons..."
    w guilty "Es solo que me siento un poco mal esta noche. Me di cuenta de que quizás vine aquí por las razones equivocadas..."

# game/script.rpy:1582
translate es ch3_5567e155:

    # k pls "Look... I'm sorry that I suddenly started talking about work. That wasn't why I approached you at all."
    k pls "Mira... Siento haber empezado a hablar repentinamente del trabajo. En serio no fue por eso que me acerqué a ti."

# game/script.rpy:1583
translate es ch3_01a63751:

    # k sorry "You came here for a good time, right? Well, a party's definitely the place to find it!"
    k sorry "Viniste aquí para pasar un buen rato, ¿verdad? Bueno, ¡una fiesta es definitivamente el lugar apropiado!"

# game/script.rpy:1584
translate es ch3_1e7ddd47:

    # k lookoff "Heck, it's what I'M here for, too... so, you're not wrong to come looking for that."
    k lookoff "Diablos, también es por eso que YO estoy aquí... así que, no te equivocas si viniste buscando eso."

# game/script.rpy:1585
translate es ch3_3219922b:

    # w neutral "(He's completely misread the situation... Although, it IS starting to look salvageable from here.)"
    w neutral "(Ha malinterpretado completamente la situación... Aunque EMPIEZA a parecer rescatable desde aquí.)"

# game/script.rpy:1586
translate es ch3_07c62861:

    # k sorry "Anyway, please forget about the magazine stuff--it doesn't matter. We were having fun before that right?"
    k sorry "Como sea, por favor olvida lo de la revista--ya no importa. Estábamos divirtiéndonos antes de eso, ¿cierto?"

# game/script.rpy:1587
translate es ch3_88dfd8df:

    # w calm "Dancing was nice, yes..."
    w calm "Bailar fue agradable, sí..."

# game/script.rpy:1588
translate es ch3_0e1aab5c:

    # k sad "I-I wanna do more than just dance with you."
    k sad "Q-Quiero hacer más que solo bailar contigo."

# game/script.rpy:1589
translate es ch3_80ca340f:

    # w drool "(Oho, there it is~ Now we're getting somewhere.)"
    w drool "(Oho, ahí está~ Ahora estamos llegando a algún lado.)"

# game/script.rpy:1590
translate es ch3_26564ac5:

    # w shy "More than dance? And what could that mean~?"
    w shy "¿Más que bailar? ¿Y qué podría significar eso~?"

# game/script.rpy:1591
translate es ch3_107e0d19:

    # k shy "Hah, well, don't make me spell it out..."
    k shy "Ja, bueno, no me hagas explicarlo..."

# game/script.rpy:1592
translate es ch3_70331591:

    # w smile "A kiss, perhaps?"
    w smile "¿Un beso, tal vez?"

# game/script.rpy:1593
translate es ch3_1dbec082:

    # k smile "Sure. And, well, you know... whatever else you'd like to do! As an incubus, I live to please."
    k smile "Seguro. Y, bueno, ya sabes.... ¡Cualquier cosa que quieras hacer! Al ser un íncubo, vivo para complacer."

# game/script.rpy:1594
translate es ch3_43a052fd:

    # w love "(Since he apologized, I may as well...)"
    w love "(Ya que se disculpó, bien podría...)"

# game/script.rpy:1595
translate es ch3_d84e6f35:

    # w calm "Kissing is a fine start."
    w calm "Un beso es un buen comienzo."

# game/script.rpy:1598
translate es ch3_91dabae0:

    # n "Kardaemon holds out his arms, inviting Periwinkle into a soft embrace."
    n "Kardaemon extiende sus brazos, invitando a Periwinkle a un suave abrazo."

# game/script.rpy:1599
translate es ch3_890d5fb6:

    # n "Periwinkle's hands glide up his chest, and he wraps his arms around the demon's neck. Their faces just inches apart, he pauses..."
    n "Las manos de Periwinkle suben por su pecho, y rodea el cuello del demonio con sus brazos."
    n "Se detiene, a tan solo unos centímetros de distancia..."

# game/script.rpy:1600
translate es ch3_5db6b259:

    # k "...?"
    k "¿...?"

# game/script.rpy:1601
translate es ch3_62b5b0bb:

    # w ah "(...Ah. I expected him to close the gap.)"
    w ah "(...Ah. Esperaba que él acortara la distancia.)"

# game/script.rpy:1602
translate es ch3_d0a1702b:

    # w conflicted "(Pastille would've kissed me. I've grown far too accustomed to that, so I automatically...)"
    w conflicted "(Pastille me hubiera besado. Me he acostumbrado demasiado a eso, por lo que automáticamente...)"

# game/script.rpy:1603
translate es ch3_6c100ae0:

    # w oops "(Shit. This was a mistake...)"
    w oops "(Mierda. Esto fue un error...)"

# game/script.rpy:1604
translate es ch3_795ea425:

    # n "Periwinkle gives him a light peck on the cheek before pulling away."
    n "Periwinkle le da un pequeño beso en la mejilla antes de alejarse."

# game/script.rpy:1607
translate es ch3_01751b4a:

    # w decline "...My apologies. I do actually need to get going now."
    w decline "...Mis disculpas. Necesito irme ahora."

# game/script.rpy:1608
translate es ch3_466c52d9:

    # k huh "Huh...?"
    k huh "¿Huh...?"

# game/script.rpy:1609
translate es ch3_d3799d4c:

    # w neutral "I shouldn't have led you on. I'm terribly sorry."
    w neutral "No debí haberte entusiasmado. Lo siento muchísimo."

# game/script.rpy:1610
translate es ch3_e029c081:

    # k sorry "Oh--n-no, don't worry about that... If you don't want to, it's fine."
    k sorry "Oh--n-no, no te preocupes por eso... Si no quieres, está bien."

# game/script.rpy:1611
translate es ch3_c9e5ee71:

    # k sad "I'm, uh... a little confused, though... Did I do something wrong?"
    k sad "Aunque, uh... estoy algo confundido... ¿Hice algo mal?"

# game/script.rpy:1612
translate es ch3_6e012f78:

    # w decline "It's not you--you're very nice. Very firm muscles."
    w decline "No eres tú--tú eres muy agradable. Muy firmes músculos."

# game/script.rpy:1613
translate es ch3_1de73ec5:

    # k shy "Hah, thanks."
    k shy "Ja, gracias."

# game/script.rpy:1614
translate es ch3_dc4c50ae:

    # w neutral "If it were any other night, things would've gone very differently. Please believe me when I say that."
    w neutral "Si fuera cualquier otra noche, las cosas hubieran sido muy diferentes. Por favor créeme cuando digo eso."

# game/script.rpy:1615
translate es ch3_7e78fb2a:

    # k lookoff "Seriously... is all this mysterious talk supposed to make me want you less...?"
    k lookoff "En serio... ¿Se supone que toda esta extraña conversación hará que te quiera menos...?"

# game/script.rpy:1616
translate es ch3_47a1fbc2:

    # w calm "I'm sure you'll have great luck with the witches inside. You're very charming."
    w calm "Estoy seguro de que tendrás mucha suerte con los brujos adentro. Eres muy encantador."

# game/script.rpy:1617
translate es ch3_c29eff2b:

    # k pls "...Damn. Well, alright..."
    k pls "...Mierda. Bueno, está bien..."

# game/script.rpy:1618
translate es ch3_e35a87bd:

    # k sorry "Get home safe, Periwinkle. Hope to see you again... on any other night, like you said."
    k sorry "Que llegues bien a casa, Periwinkle. Espero volver a verte... en cualquier otra noche, como dijiste."

# game/script.rpy:1619
translate es ch3_92af379d:

    # w innocent "Thank you for keeping me entertained. Farewell~"
    w innocent "Gracias por haberme entretenido. Hasta pronto~"

# game/script.rpy:1622
translate es ch3_3e90a2df:

    # "I shouldn't have come..."
    "No debí haber venido..."

# game/script.rpy:1623
translate es ch3_eed2f11e:

    # "What exactly have I proven here tonight? That I'm willing to pursue the first pink-haired boy I come across, out of sheer desperation?"
    "¿Exactamente qué demostré esta noche? ¿Que estoy dispuesto a ir por el primer chico de cabello rosa que se me cruce, por pura desesperación?"

# game/script.rpy:1624
translate es ch3_e4b0829d:

    # "I wanted Astragalus to be wrong for once. To admit that I'm hung up on someone is just...!"
    "Quiero que por una vez Astragalus esté equivocada. ¡Admitir que estoy enganchándome a alguien es simplemente...!"

# game/script.rpy:1625
translate es ch3_0a84e19c:

    # "I don't feel like myself at all..."
    "No me siento como yo mismo en absoluto..."

# game/script.rpy:1626
translate es ch3_76b2fe88_6:

    # nvl clear
    nvl clear

# game/script.rpy:1639
translate es ch3_f6133343:

    # n "Periwinkle arrives home, lazily slipping out of his shoes and dress. He tosses his hat somewhere and collapses onto the couch."
    n "Periwinkle llega a casa y se quita sus zapatos y vestido con desgana. Arroja su sombrero a alguna parte y se echa en el sofá."

# game/script.rpy:1640
translate es ch3_bcd66a5f:

    # w lazy oops "(Ugh... I feel even more miserable than before.)"
    w lazy oops "(Ugh... me siento aún más miserable que antes.)"

# game/script.rpy:1641
translate es ch3_cba66395:

    # w neutral "...."
    w neutral "...."

# game/script.rpy:1642
translate es ch3_b315e641:

    # n "Periwinkle finds himself staring at the front door, half-expecting to hear a familiar knock..."
    n "Periwinkle se encuentra mirando la puerta principal, con esperanzas de oír un golpe familiar..."

# game/script.rpy:1643
translate es ch3_d186408e:

    # w guilty "(The state Pastille would find me in if he were to show up tonight...)"
    w guilty "(El estado en el que Pastille me encontraría si apareciera esta noche...)"

# game/script.rpy:1644
translate es ch3_db6282c6:

    # w empty "...."
    w empty "...."

# game/script.rpy:1645
translate es ch3_3e0e2f15:

    # w oops "(...I should get in bed.)"
    w oops "(...debería irme a la cama.)"

# game/script.rpy:1647
translate es ch3_f44ca24a:

    # n "But he doesn't. Instead, he buries his face in the cushion and falls asleep..."
    n "Pero no lo hace. En su lugar, entierra su cara en el cojín y se queda dormido..."

# game/script.rpy:1658
translate es ch4_7b49a2da:

    # centered "{w=3}{nw}"
    centered "{w=3}{nw}"

# game/script.rpy:1664
translate es ch4_646d0d17:

    # n "Periwinkle bolts awake to the sound of a knock on his door."
    n "Periwinkle depierta con el sonido de un llamado a la puerta."

# game/script.rpy:1665
translate es ch4_442e5a09:

    # w lazy sleepy "(Ugh, what time is it...?)"
    w lazy sleepy "(Ugh, ¿Qué hora es...?)"

# game/script.rpy:1666
translate es ch4_eddf3c07:

    # n "He rises from the couch and lightly treads over to check who might be visiting him so early in the morning..."
    n "Se levanta del sofá y se asoma para ver quién podría estar visitándolo tan temprano..."

# game/script.rpy:1667
translate es ch4_451d8daa:

    # w ah "(Ah...)"
    w ah "(Ah...)"

# game/script.rpy:1669
translate es ch4_ce446219:

    # "At first, I thought my eyes were playing tricks on me."
    "Al principio, pensé que mis ojos me engañaban."

# game/script.rpy:1670
translate es ch4_16ee5917:

    # "It took several moments to register the fact that Pastille was on my doorstep."
    "Me tomó un largo rato percatarme de que Pastille estaba en mi puerta."

# game/script.rpy:1671
translate es ch4_26279968:

    # "The knocking comes again, snapping me out of my stupor."
    "Vuelve a golpear, sacándome del estupor."

# game/script.rpy:1672
translate es ch4_c04c89fd:

    # nvl clear
    # w lazy guilty "*ahem* One moment, please~!"
    nvl clear
    w lazy guilty "*ejem* ¡Un momento, por favor~!"

# game/script.rpy:1674
translate es ch4_f1422f42:

    # n "Periwinkle gathers up the clothes he'd left on the floor and stuffs them out of sight."
    n "Periwinkle recoge la ropa que había dejado en el suelo y la esconde."

# game/script.rpy:1675
translate es ch4_f6a25d83:

    # n "Next, he scrambles into the bathroom to check his makeup."
    n "Luego, corre al baño para revisar su maquillaje."

# game/script.rpy:1676
translate es ch4_18e27ee5:

    # w oh "(Passable, considering the circumstances...)"
    w oh "(Pasable, considerando las circunstancias...)"

# game/script.rpy:1677
translate es ch4_93c9bcce:

    # n "Wrapping a blanket around his shoulders in an attempt to look half-decent, he finally opens the door..."
    n "Envuelve una manta alrededor de sus hombros intentando verse medianamente decente, y finalmente abre la puerta..."

# game/script.rpy:1683
translate es ch4_9c6ed696:

    # p "Hi! I took the day off, so I..."
    p "¡Hola! Me tomé el día libre, así que..."

# game/script.rpy:1684
translate es ch4_1d0b3106:

    # p ohno2 "Sorry, did I wake you up?"
    p ohno2 "Lo siento, ¿te desperté?"

# game/script.rpy:1685
translate es ch4_4ce7e2ad:

    # w decent my "Yes... yes, I had a late night. Um..."
    w decent my "Sí... sí, me dormí tarde anoche. Um..."

# game/script.rpy:1686
translate es ch4_6ca14993:

    # w guilty "Come in, come in! I'll be ready in just a moment."
    w guilty "¡Pasa, pasa! Estaré listo enseguida."

# game/script.rpy:1690
translate es ch4_09875e01:

    # "Pastille is here."
    "Pastille está aquí."

# game/script.rpy:1691
translate es ch4_af7a5d1a:

    # "But WHY is he here--a day off...? Not that he HAS the day off, but that he chose to TAKE it... and then came here...?"
    "¿Pero POR QUÉ está aquí--un día libre...? No es que TENGA el día libre, sino que eligió TOMÁRSELO... ¿y entonces vino aquí...?"

# game/script.rpy:1692
translate es ch4_075c02d6:

    # "...Let's just put that aside for now. I need to get dressed."
    "...Dejemos eso de lado por ahora. Tengo que vestirme."

# game/script.rpy:1693
translate es ch4_76b2fe88:

    # nvl clear
    nvl clear

# game/script.rpy:1696
translate es ch4_4f79473d:

    # n "Periwinkle scurries back to his bedroom to change, while Pastille waits politely by the door."
    n "Periwinkle regresa a su habitación para cambiarse, mientras Pastille espera amablemente junto a la puerta."

# game/script.rpy:1698
translate es ch4_75f30f98:

    # w decent guilty "So, your day off, hm...? And you chose to visit ME? I'm flattered 💙"
    w decent guilty "Así que, tu día libre, ¿hm...? ¿Y lo escogiste para VISITARME? me siento halagado 💙"

# game/script.rpy:1699
translate es ch4_1fb7729e:

    # p ehe "Well, it's not just to visit... I was hoping to, um... take you on a date?"
    p ehe "Bueno, no solo para visitarte... esperaba poder, um... ¿llevarte a una cita?"

# game/script.rpy:1700
translate es ch4_e40ce8d7:

    # w my "Ooh, a date~? Usually we've reserved those for dinnertime, haven't we?"
    w my "Ooh, ¿una cita~? Normalmente las dejamos para la hora de cenar, ¿no es así?"

# game/script.rpy:1701
translate es ch4_bd8f092f:

    # p shy "I-I wanted to make up for yesterday."
    p shy "Q-quería compensar lo de ayer."

# game/script.rpy:1702
translate es ch4_072a72f7:

    # p smile "So, if you didn't have any other plans... I was thinking we could just... hang out for a while?"
    p smile "Entonces, si no tenías otros planes... Estaba pensando si podríamos... ¿salir un rato?"

# game/script.rpy:1703
translate es ch4_c6dcddca:

    # w oh "Sure. I don't mind, but..."
    w oh "Claro. No me importa, pero..."

# game/script.rpy:1704
translate es ch4_dee387e1:

    # w guilty "What exactly is there to make up for, my sweet?"
    w guilty "¿Qué es exactamente lo que hay que compensar, dulzura?"

# game/script.rpy:1705
translate es ch4_a90e46d0:

    # p nervous "Y-you know... how I told you not to come back to the shop, even though you only showed up to do me a favor?"
    p nervous "Y-ya sabes... ¿Como te dije que no volvieras a la tienda, pese a que solo fuiste para hacerme un favor?"

# game/script.rpy:1706
translate es ch4_048cc125:

    # w ah "(He... has it completely backwards.)"
    w ah "(Él... lo entendió todo al revés.)"

# game/script.rpy:1707
translate es ch4_b8322e5c:

    # n "Periwinkle pokes his head out from the bedroom to look Pastille in the eye."
    n "Periwinkle asoma la cabeza fuera de la habitación para mirar a Pastille a los ojos."

# game/script.rpy:1708
translate es ch4_15e38cb2:

    # w oh "Au contraire, Pastille, I should be the one to apologize for putting you in such an uncomfortable position!"
    w oh "Al contrario, Pastille, ¡yo soy quien debería disculparse por ponerte en una situación tan incómoda!"

# game/script.rpy:1709
translate es ch4_5d652605:

    # w decline "I shouldn't have shown up unannounced. It wasn't my intention to cause you any ACTUAL discomfort..."
    w decline "No debí haber aparecido sin avisar. No era mi intención causar que REALMENTE te sintieras incómodo..."

# game/script.rpy:1710
translate es ch4_96acaede:

    # p ohno2 "N-no, I...! I don't think I clarified my boundaries from the beginning, so..."
    p ohno2 "¡N-no, yo...! Creo que no aclaré mis límites desde el principio, así que..."

# game/script.rpy:1711
translate es ch4_fd2511e1:

    # p ehe "That's... not your fault at all."
    p ehe "Eso... no es tu culpa en absoluto."

# game/script.rpy:1712
translate es ch4_dccde7da:

    # w ah "(Then it seems... everything is fine now?)"
    w ah "(Al parecer... ¿Todo está bien ahora?)"

# game/script.rpy:1713
translate es ch4_a8cb5d95:

    # w innocent "Hm~ perhaps I could get to know those boundaries better during our date, then?"
    w innocent "Hm~ ¿quizás podría conocer mejor dichos límites durante nuestra cita, entonces?"

# game/script.rpy:1714
translate es ch4_f037abcc:

    # p uhoh "Wh-why does it sound suggestive you when you say it...?"
    p uhoh "¿P-por qué suena sugerente cuando lo dices...?"

# game/script.rpy:1715
translate es ch4_f9ad8445:

    # n "Periwinkle retreats back to his room with a smile."
    n "Periwinkle regresa a su habitación con una sonrisa."

# game/script.rpy:1720
translate es ch4_7d42dba1:

    # "This boy has truly caught me off guard."
    "Este chico realmente me pilló desprevenido."

# game/script.rpy:1721
translate es ch4_aaac7486:

    # "I'm almost frustrated that the spiral of guilt and confusion I lost myself in yesterday could be resolved so quickly..."
    "Es casi frustrante que el sentimiento de culpa y confusión que me atormentaba ayer pudiera deshacerse tan rápido..."

# game/script.rpy:1722
translate es ch4_05d347aa:

    # nvl clear
    # "Ah, that's all it was!"
    nvl clear
    "¡Ah, eso era todo!"

# game/script.rpy:1724
translate es ch4_2325265a:

    # "I had merely been fixating on my mistake. It had nothing to do with Pastille, per se..."
    "Simplemente me había obsesionado con mi error. No tenía nada que ver con Pastille, de por sí..."

# game/script.rpy:1725
translate es ch4_3c6c1592:

    # "He just happened to be the one at the center of it, so of course all of my attention was unnecessarily directed toward him."
