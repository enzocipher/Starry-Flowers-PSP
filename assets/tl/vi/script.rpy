    j embarrassed2 "Quan trọng là cuối cùng thì bọn tớ cũng thành thật được với nhau... Aaa, hạnh phúc xỉu...."

# game/script.rpy:1443
translate vi ch3_c9023fe1:

    # w happy "Well, congratulations! You deserve that happiness."
    w happy "Ồi, chúc mừng nha! Cậu xứng đáng với niềm hạnh phúc đó."

# game/script.rpy:1444
translate vi ch3_802b14e9:

    # j wink "Yeah!! So like, if you ever need relationship advice, I'm your gal!"
    j wink "Ừ!! Nên là, nếu cậu có cần cố vấn tình cảm thì cứ hỏi tớ nha!"

# game/script.rpy:1445
translate vi ch3_f17415bb:

    # j think "Oh--but I guess you wouldn't, since you don't actually date anyone..."
    j think "Ô--nhưng mà chắc cậu cũng không cần, cậu đâu quen ai..."

# game/script.rpy:1447
translate vi ch3_3f2cc2ed:

    # n "Periwinkle hears Astragalus snorting with laughter in the back room."
    n "Periwinkle nghe tiếng Astragalus phụt cười từ phòng trong."

# game/script.rpy:1449
translate vi ch3_18044365:

    # w insulted "(How dare she! I came here to be comforted, not ridiculed...!)" with vpunch
    w insulted "(Bạn bè như cái bẹn bà! Tui tới đây là để được an ủi chứ không phải để bị chọc quê...!)" with vpunch

# game/script.rpy:1450
translate vi ch3_d074eaf6:

    # w innocent "Jam, dear. What time did you say that party started?"
    w innocent "Mấy giờ bữa tiệc bắt đầu vậy Jam yêu dấu?"

# game/script.rpy:1451
translate vi ch3_79b12204:

    # j oh "Oh, like... a few hours from now? I think?"
    j oh "Ờ... vài tiếng nữa thì phải?"

# game/script.rpy:1452
translate vi ch3_26dd1657:

    # j embarrassed "Sorry, I can never remember the time difference between here and the Netherworld...."
    j embarrassed "Xin lỗi nha, tớ chả bao giờ nhớ nổi cách biệt thời gian giữa Âm Phủ với dương gian cả...."

# game/script.rpy:1453
translate vi ch3_b3aad0af:

    # w calm "No matter. These things tend to go all night, and I prefer to arrive fashionably late."
    w calm "Chẳng sao đâu. Mấy bữa tiệc kiểu này thường là chơi thâu đêm, hơn nữa tớ là kiểu thích tới muộn."

# game/script.rpy:1454
translate vi ch3_08184ed7:

    # w smile "Now if you'll excuse me, I'm going to return home to freshen up before the soirée."
    w smile "Vậy tớ xin phép về trước nhé, tớ cần sửa soạn cho bữa dạ tiệc."

# game/script.rpy:1455
translate vi ch3_fc7b2769:

    # j ehe "Sure! See ya there~"
    j ehe "Bái bai, hẹn gặp cậu sau~"

# game/script.rpy:1461
translate vi ch3_bbcb516d:

    # n "Periwinkle marches home in a huff."
    n "Periwinkle giận dữ chạy hùng hục về nhà."

# game/script.rpy:1462
translate vi ch3_61c2becd:

    # w cute pout "(Hmph... Astragalus thinks I'm lacking in self-respect.)"
    w cute pout "(Hứ... Astragalus bảo mình thiếu tự trọng ư.)"

# game/script.rpy:1463
translate vi ch3_68f32e6f:

    # w "(I'll show her...!)"
    w "(Chống mắt lên mà xem tui...!)"

# game/script.rpy:1465
translate vi ch3_dcc6e26c:

    # "I'm going to find someone to spoil me tonight!"
    "Tui sẽ tìm một người chiều chuộng tui hết đêm nay!"

# game/script.rpy:1466
translate vi ch3_c3ca6d80:

    # "Netherworld parties happen to be the perfect venue--always filled with cute faces I haven't yet encountered."
    "Bữa tiệc dưới Âm Phủ là một địa điểm hoàn hảo--luôn tràn ngập những gương mặt lạ đáng yêu mà tui chưa từng gặp qua."

# game/script.rpy:1467
translate vi ch3_439ac636:

    # "Plenty of incubi as well... they LIVE to please their partners."
    "Và nhiều Incubi nữa... những con người sống để chiều chuộng bạn tình."

# game/script.rpy:1468
translate vi ch3_8e765de2:

    # "It's been a while since I've slept with a demon... 💙 I'm looking forward to this now~!"
    "Cũng lâu rồi chưa ngủ với ác ma nào... 💙 Hóng~!"

# game/script.rpy:1469
translate vi ch3_078fe372:

    # nvl clear
    # centered "{nw}"
    nvl clear
    centered "{nw}"

# game/script.rpy:1481
translate vi ch3_fb133186:

    # n "And so, a few hours later..."
    n "Và rồi, vài tiếng sau..."

# game/script.rpy:1487
translate vi ch3_09c7b9d1:

    # n "Periwinkle arrives at the soirée."
    n "Periwinkle đã có mặt tại buổi dạ tiệc."

# game/script.rpy:1490
translate vi ch3_a3391362:

    # w drool "(Let's see... who looks available~?)"
    w drool "(Để xem... ai được đây ta~?)"

# game/script.rpy:1491
translate vi ch3_fdd167fd:

    # n "Scanning the room, he spots both Jam and Chirval happily chatting with the other guests."
    n "Cậu đảo mắt khắp phòng và phát hiện Jam cùng Chirval đang trò chuyện vui vẻ với những vị khách khác."

# game/script.rpy:1492
translate vi ch3_56343088:

    # w shy "(Chirval himself certainly isn't a bad lay... but I couldn't go stealing the host of the party~!)"
    w shy "(Chirval là một con mồi không tệ... nhưng tui không thể cướp mất chủ nhân của bữa tiệc đi được~!)"

# game/script.rpy:1494
translate vi ch3_cbeff3b4:

    # n "Periwinkle begins to gravitate toward the snack table, still scoping out the various party-goers."
    n "Periwinkle tiến về bàn ăn vặt, mắt vẫn không ngừng dò xét những vị khách tham gia bữa tiệc."

# game/script.rpy:1495
translate vi ch3_200cad0c:

    # w smile "(Plenty of candidates to choose from... however will I decide? 💙)"
    w smile "(Quá nhiều ứng cử viên... tui sẽ quyết định sao đây? 💙)"

# game/script.rpy:1496
translate vi ch3_70adf595:

    # n "Before he can make up his mind about who to approach, a taller demon slides into the empty space beside him to start a conversation."
    n "Nhưng trước khi kịp quyết định sẽ tiếp cận ai, một ác quỷ cao to đã tiến đến chỗ cậu bắt chuyện."

# game/script.rpy:1499
translate vi ch3_404ac1b2:

    # k "Lotsa cute witches at this soirée, huh?"
    k "Nhiều phù thủy đáng yêu ở bữa dạ tiệc này quá hả?"

# game/script.rpy:1500
translate vi ch3_356d9a00:

    # w drool "(Oh, so it's been decided FOR me~! I'm ALREADY being spoiled 💙)"
    w drool "(Ý trời~! Cầu được ước thấy 💙)"

# game/script.rpy:1501
translate vi ch3_2c4909af:

    # w calm "I didn't come here for the witches."
    w calm "Mục tiêu của tui không phải mấy bạn phù thủy."

# game/script.rpy:1502
translate vi ch3_4245e0f8:

    # k happy "Hah! ...I'm Kardaemon."
    k happy "Ha! ...Tôi là Kardaemon."

# game/script.rpy:1503
translate vi ch3_02708700:

    # w smile "Periwinkle."
    w smile "Periwinkle."

# game/script.rpy:1504
translate vi ch3_f4579e3e:

    # k shy "Periwinkle... So, this is gonna sound weird, but..."
    k shy "Periwinkle... Ừm, cái này có thể nghe hơi kỳ, cơ mà..."

# game/script.rpy:1505
translate vi ch3_8c6f158c:

    # k ask "Do I... know you from somewhere?"
    k ask "Tôi... có từng gặp qua cậu ở đâu đó chưa?"

# game/script.rpy:1506
translate vi ch3_c35e243b:

    # w teehee "Your dreams, perhaps?"
    w teehee "Trong mơ chăng?"

# game/script.rpy:1507
translate vi ch3_51d2fdbc:

    # k laugh "Naww, for real! Something about your face is just so familiar..."
    k laugh "Nàoooo, tôi hỏi thật đấy! Nhìn mặt cậu quen lắm..."

# game/script.rpy:1508
translate vi ch3_1dab2d42:

    # w smile "I frequent these type of events, so it's likely we've crossed paths at some point."
    w smile "Tui hay tới mấy bữa tiệc kiểu này lắm, nên có thể chúng ta từng chạm mặt qua rồi."

# game/script.rpy:1509
translate vi ch3_97371c3b:

    # k shy "Hmmmm... that's not it. I woulda tried hitting on you if we did."
    k shy "Hừmmmm... Không phải. Nếu từng gặp qua cậu thì chắc tui đã lao tới thả thính rồi."

# game/script.rpy:1510
translate vi ch3_9e11e78c:

    # w happy "Hmhm, well, you're certainly free to do so now 💙"
    w happy "Vậy giờ anh cứ thả tự nhiên đi 💙"

# game/script.rpy:1511
translate vi ch3_7862bf1b:

    # k happy "I'll give it a shot! With your permission, haha..."
    k happy "Tôi sẽ thử! Đương nhiên là với sự cho phép của cậu, haha..."

# game/script.rpy:1512
translate vi ch3_96386f57:

    # w smile "(This one isn't bad... I do appreciate how straightforward he's being.)"
    w smile "(Anh chàng này không tệ tí nào... Tui đánh giá cao sự thẳng thắn này.)"

# game/script.rpy:1513
translate vi ch3_c4cc7630:

    # k smile "So! What ARE you here for, if not the witches?"
    k smile "Vậy nếu không phải phù thủy, thì mục tiêu của cậu là ai?"

# game/script.rpy:1514
translate vi ch3_f5eef97f:

    # w innocent "I had intended to find someone to spoil me... and incubi are rumored to be good for exactly that 💙"
    w innocent "Tui muốn tìm một người nuông chiều mình... mà nghe đồn Incubi giỏi mấy vụ đấy lắm 💙"

# game/script.rpy:1515
translate vi ch3_513f012e:

    # k shy "We are, we are..."
    k shy "Hẳn rồi..."

# game/script.rpy:1516
translate vi ch3_19ddae00:

    # w my "So the rumors are true~? I'm in luck, then!"
    w my "Vậy lời đồn là thật hả~? Thế thì tui gặp may rồi!"

# game/script.rpy:1517
translate vi ch3_f89607ce:

    # w teehee "Would you happen to have any friends who would be interested in dancing with a cute little witch like me~?"
    w teehee "Anh có người bạn nào có hứng muốn khiêu vũ với phù thủy nhỏ đáng yêu như tui đây không~?"

# game/script.rpy:1518
translate vi ch3_6d7a44bf:

    # k "Hmmmmmmm... I could ask around."
    k "Hừmmmmmmm... Để tôi hỏi xung quanh thử."

# game/script.rpy:1519
translate vi ch3_5efc4a86:

    # k smile "Or! Better idea. You could just settle for me?"
    k smile "Hoặc ở đây có sẵn một người nè, cậu thấy sao?"

# game/script.rpy:1520
translate vi ch3_c9017794:

    # w calm "Hmhm, I suppose you'll do 💙"
    w calm "Cũng được 💙"

# game/script.rpy:1523
translate vi ch3_50b7709f:

    # "I present my hand, and Kardaemon gives an exaggerated bow."
    "Tui đưa tay ra và Kardaemon cúi người."

# game/script.rpy:1524
translate vi ch3_084b6170:

    # "He pulls me in, albeit a little clumsily, with his gigantic demon hands. Always enjoyable to be swept up in the arms of a larger man 💙"
    "Anh ấy kéo tôi vào lòng một cách vụng về với đôi tay to lớn kia. Nằm trong vòng tay của mấy anh cao to lúc nào cũng dễ chịu 💙"

# game/script.rpy:1525
translate vi ch3_272b335d:

    # "My own hand is almost entirely consumed by his. Unlike with Pastille's, which fit so--"
    "Tay tôi hoàn toàn nằm gọn trong tay anh ấy. Không vừa in như với Pastille--"

# game/script.rpy:1526
translate vi ch3_36f5d814:

    # nvl clear
    # "...Pastille?"
    nvl clear
    "...Pastille?"

# game/script.rpy:1528
translate vi ch3_bd6489c5:

    # "Am I STILL comparing everyone to him?"
    "Tui VẪN tiếp tục so sánh người khác với cậu ta?"

# game/script.rpy:1529
translate vi ch3_c405272e:

    # "I shake the thought and return to the moment..."
    "Tui cố rũ bỏ mớ suy nghĩ kia để trở lại hiện thực..."

# game/script.rpy:1530
translate vi ch3_76b2fe88_5:

    # nvl clear
    nvl clear

# game/script.rpy:1533
translate vi ch3_4dfd153d:

    # n "The pair twirls around the dance floor, losing themselves in the music."
    n "Hai chúng tôi xoay vòng trên sàn nhảy, chìm đắm theo dòng nhạc."

# game/script.rpy:1534
translate vi ch3_17b0a74e:

    # n "After a while, Kardaemon suddenly speaks up."
    n "Sau một hồi, Kardaemon đột nhiên lên tiếng."

# game/script.rpy:1535
translate vi ch3_122eb838:

    # k "...OH! I think I just realized where I know you from!"
    k "...Ô! Tôi nghĩ mình nhớ ra đã thấy cậu ở đâu rồi!"

# game/script.rpy:1536
translate vi ch3_5a8eabf4:

    # w love "Really, now?"
    w love "Thật á?"

# game/script.rpy:1537
translate vi ch3_5ae9085a:

    # k "Yeah, you were in the magazine I work for!"
    k "Cậu ở trên bìa cuốn tạp chí mà tôi làm!"

# game/script.rpy:1538
translate vi ch3_a784e394:

    # k "I'm an editor. We used your photos for an issue a couple years back."
    k "Tôi là biên tập viên. Hồi mấy năm trước bọn tôi có dùng ảnh của cậu đó."

# game/script.rpy:1539
translate vi ch3_efcb9510:

    # w oh "Ah... what a coincidence. I DID used to do some modeling, in the past..."
    w oh "A... tình cờ ghê. Đúng là hồi đó tui có làm người mẫu ảnh..."

# game/script.rpy:1540
translate vi ch3_07b8e242:

    # w calm "And in the past it shall remain. I'm in a different line of work now."
    w calm "Và quá khứ là quá khứ. Hiện tại tui làm ngành khác rồi."

# game/script.rpy:1541
translate vi ch3_e86cb7f9:

    # k "Aww, really? That's too bad. I always thought you looked amazing."
    k "Uầy, vậy sao? Tiếc quá, cậu đẹp thế kia..."

# game/script.rpy:1542
translate vi ch3_014598d5:

    # w smile "Hmhm, I appreciate that 💙"
    w smile "Quá khen 💙"

# game/script.rpy:1545
translate vi ch3_eac59ccf:

    # w neutral "(Well this certainly complicates things... I'd much prefer to have been complete strangers.)"
    w neutral "(Phiền phức đây... Tui thích người hoàn toàn xa lạ không biết gì về mình cơ.)"

# game/script.rpy:1546
translate vi ch3_54236a36:

    # w decline "(How unfortunate... just when I was beginning to enjoy myself.)"
    w decline "(Thật xúi quẩy... Vừa mới bắt đầu tận hưởng được một tí vậy mà...)"

# game/script.rpy:1549
translate vi ch3_7c244efe:

    # k "Haha, wow, I can't believe I ran into you like this. Maybe it's a sign...?"
    k "Haha, không tin được là tôi lại chạm mặt cậu trong tình huống thế này. Có thể đây là tín hiệu chăng...?"

# game/script.rpy:1550
translate vi ch3_f26130c5:

    # w smile "A sign? Of what, dare I ask?"
    w smile "Tín hiệu? Của cái gì cơ?"

# game/script.rpy:1551
translate vi ch3_41d59cda:

    # k smile "That you should come back to modeling! I can get you in our magazine again--if you're interested, that is."
    k smile "Tín hiệu cậu nên quay về nghiệp người mẫu chứ gì nữa! Nếu cậu hứng, tôi có thể đưa cậu lên tạp chí của bọn tôi."

# game/script.rpy:1552
translate vi ch3_24632a00:

    # w guilty "I appreciate the offer, but I've moved on. It put too much of a strain on my relationship with fashion, among other things..."
    w guilty "Cảm ơn lời đề nghị của anh, nhưng tui cắt duyên hẳn với nghề đấy rồi."
    w "Nó làm tui áp lực, không thể yêu thích thời trang một cách thuần túy nữa, và nhiều lý do khác..."

# game/script.rpy:1553
translate vi ch3_9bbf2611:

    # k shy "Ah... well, at least take my card! In case you change your mind."
    k shy "A... Vậy ít nhất hãy nhận danh thiếp của tôi đi, phòng khi cậu đổi ý!"

# game/script.rpy:1554
translate vi ch3_1ae6e450:

    # w calm "No thank you. I don't see that happening."
    w calm "Cảm ơn, nhưng không. Đấy là chuyện không thể xảy ra rồi."

# game/script.rpy:1555
translate vi ch3_12306026:

    # k laugh "Aww, come on... you'd be so great! It feels like such a waste of talent...."
    k laugh "Nàooooo... cậu sẽ cực đỉnh luôn mà! Chứ thế này thì phí phạm tài năng quá...."

# game/script.rpy:1556
translate vi ch3_51eac4d1:

    # w neutral "(Hm... I'm quickly growing tired of this.)"
    w neutral "(...Mệt rồi nha.)"

# game/script.rpy:1557
translate vi ch3_c4d486cb:

    # w smile "Thank you for the dance... but I really should be going now."
    w smile "Cảm ơn đã nhảy với tui... nhưng giờ tui phải đi rồi."

# game/script.rpy:1558
translate vi ch3_33e9643f:

    # k huh "Huh? Ah, uh... sure."
    k huh "Hở? À, ừm... được."

# game/script.rpy:1559
translate vi ch3_b30b1ced:

    # w innocent "This was fun. Perhaps we'll meet again sometime 💙"
    w innocent "Khiêu vũ với anh vui lắm. Nếu có duyên thì lúc nào đó chúng ta lại gặp nhé 💙"

# game/script.rpy:1560
translate vi ch3_0d5df227:

    # k sad "Y-yeah...."
    k sad "À-Ừ...."

# game/script.rpy:1567
translate vi ch3_ef15a56c:

    # "I didn't expect to be reminded of my modeling days of all things..."
    "Ai mà ngờ lại bị khơi lại chuyện hồi còn làm người mẫu đâu..."

# game/script.rpy:1568
translate vi ch3_bad021ca:

    # "Although his excitement was understandable, the way he went about it certainly ruined the mood."
    "Mặc dù biết là anh ta hào hứng, nhưng cách anh ta thúc ép như vậy đúng là làm tụt hết cảm xúc."

# game/script.rpy:1569
translate vi ch3_72a95f04:

    # "I hate to admit it, but I'd gone into this night far too unstable to begin with. For such a small thing to get to me..."
    "Tuy không muốn nhưng phải thừa nhận, đêm nay tui đến đây trong trạng thái thiếu ổn định vô cùng. Để chuyện nhỏ nhặt tác động mình thế này..."

# game/script.rpy:1570
translate vi ch3_5ad7ada1:

    # nvl clear
    # "I'm not even here on my own terms, am I?"
    nvl clear
    "Thậm chí tui đến đây chẳng phải vì mình muốn thế nữa chứ?"

# game/script.rpy:1572
translate vi ch3_2f4d44d7:

    # "This was all to prove a point. That's certainly not in the spirit of a friendly soirée..."
    "Tui đến chỉ để chứng minh cái tôi ngốc nghếch của mình. Và rõ ràng đấy không phải là tinh thần đúng đắn để tham dự dạ tiệc..."

# game/script.rpy:1573
translate vi ch3_d4b47508:

    # "It's best I just return home and--"
