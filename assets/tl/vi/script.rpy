translate vi ch3_3aa62bce:

    # j embarrassed "I mean, I'm finally dating my best friend, thanks to that last one...!"
    j embarrassed "Như tớ nè, nhờ bữa tiệc lần trước mà cuối cùng tớ cũng thành đôi với cô bạn thân...!"

# game/script.rpy:1440
translate vi ch3_61645db5:

    # w oh "Ah--Marzipan, wasn't it? You weren't together before that?"
    w oh "A--là Marzipan phải không? Bộ không phải hai người quen nhau từ trước à?"

# game/script.rpy:1441
translate vi ch3_a063a141:

    # j whaaat "AHHHH, I knew everyone thought we were...! Ugh, so embarrassing..." with vpunch
    j whaaat "AAAAA, tui biết ngay mọi người đều nghĩ vậy mà...! Ui là trời, ngại chết đi..." with vpunch

# game/script.rpy:1442
translate vi ch3_949360b6:

