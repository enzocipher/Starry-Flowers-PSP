translate vi ch5_87ce4ec9:

    # h "Choosing work over getting laid? Now I KNOW something's up with you!"
    h "Chọn công việc thay vì một đêm trăng hoa hưởng lạc á? Rõ ràng có chuyện gì rồi phải không!"

# game/script.rpy:2648
translate vi ch5_7d59c83b:

    # w happy "How offensive~! I have more going on than just going out and flirting with everyone I meet!"
    w happy "Quá đáng~! Cuộc sống tui có nhiều chuyện ngoài việc ra ngoài thả thính với bất kỳ ai tui gặp mà!"

# game/script.rpy:2649
translate vi ch5_c159c59e:

    # h "Haahaha! Of course, of course~!"
    h "Hahaha! Rồi rồi~!"

