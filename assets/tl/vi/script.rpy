translate vi ch5_a5ede285:

    # w decline "Deep breaths. It never helps to force it... just imagine the desired scent, and...."
    w decline "Hít một hơi thật sâu. Cưỡng ép cũng không ích gì mà... cứ tưởng tượng mùi hương mình mong muốn và..."

# game/script.rpy:2485
translate vi ch5_a6226304:

    # n "He tries for a third time..."
    n "Periwinkle thử lần thứ ba..."

# game/script.rpy:2486
translate vi ch5_818ee6b1:

    # n "...and yet..."
    n "...và..."

# game/script.rpy:2489
translate vi ch5_9250f26a:

    # w yell "Peach again?!" with vpunch
    w yell "Lại đào?!" with vpunch

# game/script.rpy:2490
translate vi ch5_aec19f40:

    # w pout "This is a waste of supplies. So much for my attempt at diligence...!"
    w pout "Đúng là phí của. Mất cả công tui cố làm một công dân chăm chỉ gương mẫu...!"

# game/script.rpy:2491
translate vi ch5_2f58dc58:

    # w oops "If I can't conjure other scents, I'll have to find something else to occupy my time...."
    w oops "Nếu tui cứ tiếp tục không thể tạo ra mùi hương nào khác, có lẽ tui phải tìm chuyện gì đó để giết thời gian..."

# game/script.rpy:2492
translate vi ch5_c94aab20:

    # w innocent "Ahh, housework! I can finally get some chores done around here~!"
    w innocent "A, việc nhà! Cuối cùng cũng có dịp để tới công chuyện với tui~!"

# game/script.rpy:2493
translate vi ch5_199d4349:

    # w aha "Nothing could possibly distract me from finishing them today... they ARE the distraction!"
    w aha "Giờ thì không gì có thể cản trở tui dọn dẹp cái nhà cho xong hôm nay... chính nó là thứ để tui xao nhãng lúc này mà!"

# game/script.rpy:2494
translate vi ch5_db67403d:

    # w oh "Oh, that's right! I still had laundry to put away, didn't I?"
    w oh "Ô, phải rồi! Tui vẫn còn mớ quần áo phải xếp cất mà nhỉ?"

# game/script.rpy:2497
translate vi ch5_b6cfe690:

    # n "Periwinkle walks into his bedroom to face the pile of clothes he hadn't folded yet."
    n "Periwinkle bước vào phòng để đối diện với đống đồ mà mình còn chất đó chưa xếp."

# game/script.rpy:2498
translate vi ch5_9af0cc6b:

    # w guilty "Whenever I tell myself I'll get to it later, I tend to leave it for days...."
    w guilty "Tui cứ tự bảo bản thân sẽ xử sau, và nhiều ngày sau đó không nhúc nhích đả động gì tới...."

# game/script.rpy:2499
translate vi ch5_7561ad39:

    # n "But the single large pile he expected wasn't there. Instead, it was split in two, with one half already neatly folded..."
    n "{size=-2}Nhưng không như cậu nghĩ, thay vì một đống siêu to khổng lồ chất chồng, thì nó đã được chia ra làm đôi, với một nửa đã được xếp gọn gàng...{/size}"

# game/script.rpy:2500
translate vi ch5_7ae4391f:

    # w my "Ah... I don't remember making this much progress...."
    w my "A... Tui không nhớ mình có xếp được nhiều thế này...."

# game/script.rpy:2501
translate vi ch5_8e27678f:

    # w insulted "N-no...! Pastille did this, didn't he?! When he came to pick me up yesterday!!" with vpunch
    w insulted "Kh-không...! Là Pastille làm mà?! Cái lúc mà cậu ta chọn đồ cho mình hôm qua ấy!!" with vpunch

# game/script.rpy:2502
translate vi ch5_ebbaaa9d:

    # w oops "Curses... he's too good! I can't touch this right now...!"
    w oops "Chết tiệt cái sự tử tế của cậu ta...! Giờ thì tui không thể đụng tay vào được nữa...!"

# game/script.rpy:2503
translate vi ch5_fabf3693:

    # n "Periwinkle covers the pile of neatly folded clothes with the rest of the unfolded ones in retaliation."
    n "Periwinkle phủ đống đồ chưa xếp lên chồng đồ đã xếp rồi."

# game/script.rpy:2504
translate vi ch5_7f95d5c9:

    # w aha "There. One less reminder to worry about."
    w aha "Xong. Bớt được một thứ gợi nhớ về cậu ta."

# game/script.rpy:2505
translate vi ch5_6d9815d8:

    # w decline "Now I'm going to have to think of something else to do...."
    w decline "Giờ lại phải kiếm việc khác để mà làm...."

# game/script.rpy:2510
translate vi ch5_99c1ff41:

    # "So far, my attempts at forgetting about Pastille have been completely futile."
    "Mọi nỗ lực để cố quên đi Pastille của tui nãy giờ đều không xi nhê."

# game/script.rpy:2511
translate vi ch5_80ef4d03:

    # "But that's perfectly fine...! No one said it was going to be easy."
    "Nhưng không sao...! Đâu ai bảo chuyện này sẽ dễ đâu đúng không."

# game/script.rpy:2512
translate vi ch5_9c18fb74:

    # "Ironically, the more you tell yourself NOT to think of something, the more your mind will be enticed by it...."
    "Trớ trêu thay, càng tự nhủ KHÔNG ĐƯỢC nghĩ tới cái gì thì tâm trí càng nghĩ tới thứ đó...."

# game/script.rpy:2513
translate vi ch5_896a9911:

    # nvl clear
    # "I mustn't let this consume me. I have to find a way to relax."
    nvl clear
    "Không được nản chí. Phải tìm cái gì đó để thư giãn mới được."

# game/script.rpy:2515
translate vi ch5_67f5662b:

    # "A nice bath should help to calm my nerves..."
    "Tắm rửa sạch sẽ có lẽ sẽ xoa dịu tinh thần cho mình..."

# game/script.rpy:2516
translate vi ch5_76b2fe88_2:

    # nvl clear
    nvl clear

# game/script.rpy:2521
translate vi ch5_142a3147:

    # n "Later that evening..."
    n "Chiều tối hôm đó..."

# game/script.rpy:2523
translate vi ch5_b084a8a3:

    # w shutin happy "I'm feeling so refreshed, I could do just about anything~!"
    w shutin happy "Thoải mái ghê, giờ tui cảm thấy mình có thể làm được mọi thứ~!"

# game/script.rpy:2524
translate vi ch5_bfecbb7d:

    # w smile "I should try cooking for myself tonight... Now THERE'S a task that'll require my full attention!"
    w smile "Hôm nay thử tự nấu ăn cho bản thân xem sao... Đó cũng là một nhiệm vụ cần dồn mọi sự tập trung của tui!"

# game/script.rpy:2525
translate vi ch5_5e931d21:

    # n "Periwinkle opens up the fridge for ideas..."
    n "Periwinkle mở tủ lạnh để xem có thể làm món gì..."

# game/script.rpy:2526
translate vi ch5_eb1a4107:

    # w oh "A pint of milk. A few cups of yogurt, some eggs, whipped cream..."
    w oh "Một pint sữa. Vài cốc sữa chua, vài quả trứng, kem béo...\n{size=24}*Ghi chú: 1 pint =568ml{/size}"

# game/script.rpy:2527
translate vi ch5_a167090a:

    # w pout "There isn't much in the way of meals, is there? This is why I never cook..."
    w pout "Cũng chẳng có gì mấy để nấu nhỉ? Đấy là lý do tại sao tui chả bao giờ nấu nướng..."

# game/script.rpy:2528
translate vi ch5_c2f55194:

    # w happy "Ah, but I could try making an omelet! Breakfast for dinner~ oh, what fun~"
    w happy "A, nhưng mình có thể thử làm omelet! Nấu món dành cho bữa sáng để ăn tối~ chà, vui đấy~"

# game/script.rpy:2531
translate vi ch5_b1019ee6:

    # n "Periwinkle cheerfully reaches for the eggs, then pauses."
    n "Periwinkle hí hửng với tới lấy trứng, nhưng đột nhiên khựng lại."

# game/script.rpy:2532
translate vi ch5_9393331d:

    # w shutin oh "...Actually. Can I cook without magic...?"
    w shutin oh "...Thực ra thì, tui nấu mà không dùng phép thì sao nhỉ...?"

# game/script.rpy:2533
translate vi ch5_94dffac0:

    # n "He turns to face the stove."
    n "Cậu quay mặt về phía bếp lò."

# game/script.rpy:2534
translate vi ch5_d5bc20eb:

    # w neutral "This burner... is the kind you'd light with a spell."
    w neutral "Cái lò này... là loại phải dùng ma thuật ánh sáng để sử dụng."

# game/script.rpy:2535
translate vi ch5_5df0ebaf:

    # w oops "I'm far too nervous my magic is going to come out smelling of peaches again..."
    w oops "Nhưng giờ tui vô cùng quan ngại nếu dùng phép lại ra cái gì đó mùi đào..."

# game/script.rpy:2536
translate vi ch5_f95e4a27_1:

    # w mad "...."
    w mad "...."

# game/script.rpy:2537
translate vi ch5_98438b48:

    # n "Periwinkle slams the fridge shut."
    n "Periwinkle đóng sầm cửa tủ lạnh lại."

# game/script.rpy:2538
translate vi ch5_04db34f2:

    # w innocent "Forget cooking! What was I thinking~? I'm not cut out to be a chef 💙"
    w innocent "Dẹp vụ nấu nướng đi! Tui đang nghĩ cái quái gì thế này~? Tui đâu có ý định làm đầu bếp chứ 💙"

# game/script.rpy:2539
translate vi ch5_ce61890c:

    # w "(Pastille on the other hand...)"
    w "(Còn Pastille thì...)"

# game/script.rpy:2540
translate vi ch5_72f902e5:

    # w oops "No, no, no...! Thinking of him in this delightful domestic context is ESPECIALLY banned!"
    w oops "Không không không...! Nghĩ tới hình ảnh cậu ta làm nội trợ lúc này là TUYỆT ĐỐI cấm kỵ!"

# game/script.rpy:2541
translate vi ch5_fdc8fc60:

    # w whine "No matter how much I want to eat his cooking now...! He's obviously the type to be good at it...!"
    w whine "Mặc xác chuyện giờ tui muốn ăn đồ cậu ta nấu tới mức nào đi nữa...! Cậu ta rõ là tuýp giỏi mấy chuyện bếp núc...!"

# game/script.rpy:2542
translate vi ch5_cba66395:

    # w neutral "...."
    w neutral "...."

# game/script.rpy:2543
translate vi ch5_351d08ce:

    # w empty "Ahh, this is depressing... I'm already right back to where I started."
    w empty "Aaa, tuyệt vọng thực sự... Tui lại trở về vạch xuất phát rồi."

# game/script.rpy:2544
translate vi ch5_9f77ed17:

    # w sleepy "*sigh* I'll just order takeout...."
    w sleepy "*thở dài* Đặt đồ ăn giao tới nhà vậy...."

# game/script.rpy:2547
translate vi ch5_0cc969eb:

    # n "Periwinkle goes to bed that night utterly incapable of forgetting about Pastille."
    n "Tối đó, Periwinkle lên giường ngủ trong tâm thế hoàn toàn không quên được Pastille."

# game/script.rpy:2553
translate vi ch5_9d3aad6a:

    # n "Operation \"SERIOUSLY, do not think about that boy!\" - Day 2"
    n "Hoạt động \"NGHIÊM TÚC ĐẤY, đừng có nghĩ về cái tên đó nữa!\" - Ngày thứ hai"

# game/script.rpy:2554
translate vi ch5_3e78daf8:

    # "I've tried working... I've tried doing chores... I've even tried to cook! All miserable failures."
    "Tui đã cố làm việc... làm việc nhà... và cả nấu ăn nữa! Tất cả đều thất bại thảm hại."

# game/script.rpy:2555
translate vi ch5_cd9bef67:

    # "That's why, today, I'm taking drastic measures: complete escapism!"
    "Nên hôm nay, tui sẽ dùng tới biện pháp quyết liệt hơn: cách ly hoàn toàn!"

# game/script.rpy:2556
translate vi ch5_5895572f:

    # "I'm returning to my roots. I'll reread one of my favorite series! If nothing else, it should make a nice source of inspiration..."
    "Tui sẽ ôn lại kỷ niệm xưa: đọc lại sê-ri truyện tranh yêu thích của mình! Có thể nó sẽ tạo nên nguồn cảm hứng hay ho nào đó cũng nên..."

# game/script.rpy:2557
translate vi ch5_7c3c5f99:

    # nvl clear
    # n "Periwinkle pulls out volume one of a certain manga from his bookshelf."
    nvl clear
    n "Periwinkle lấy ra một cuốn truyện từ kệ sách."

# game/script.rpy:2561
translate vi ch5_c39703ae:

    # w shutin happy "\"Fabric of our Love\"! How many years has it been~?"
    w shutin happy "\"Fabric of our Love\"! Không biết đã bao nhiêu năm rồi mới đọc lại đây~?"

# game/script.rpy:2562
translate vi ch5_45eda1a9:

    # w love "The dresses were always drawn so beautifully in this series... I still think of them from time to time."
    w love "Những chiếc váy trong sê-ri này được vẽ siêu đẹp... Lâu lâu tui vẫn nghĩ về chúng."

# game/script.rpy:2565
translate vi ch5_4ce77425:

    # "It's the story of a girl who's fallen for a handsome prince 💙 Standard fare for the types of manga I read."
    "Đấy là câu chuyện về một cô gái phải lòng một chàng hoàng tử tuấn tú 💙 Một mô típ vô cùng phổ biến."

# game/script.rpy:2566
translate vi ch5_c86d4767:

    # "Her mother is a talented seamstress who designs all sorts of dazzling gowns for her to wear... and when the prince sees her in one, he becomes smitten with her!"
    "Mẹ cô là một thợ may tài năng, người đã thiết kế đủ loại váy áo lộng lẫy cho cổ mặc... và khi hoàng tử tình cở bắt gặp cô trong bộ váy áo, chàng đã si mê cô!"

# game/script.rpy:2567
translate vi ch5_1a90caff:

    # nvl clear
    # "At first, she's in heaven! This is the prince of her dreams~!"
    nvl clear
    "Ban đầu thì cổ hạnh phúc muốn thăng thiên! Đấy là chàng hoàng tử trong mơ của cô mà~!"

# game/script.rpy:2569
translate vi ch5_ebf04359:

    # "But she soon wonders if the prince is only attracted to the dresses, the glamour... and not the poor girl underneath."
    "Nhưng sau đó cô lo sợ rằng chàng hoàng tử chỉ bị quyến rũ bởi những chiếc váy áo lộng lẫy cô mặc... chứ không phải con người cô."

# game/script.rpy:2570
translate vi ch5_bbca257f:

    # "Until the prince reveals... ah, I shouldn't spoil it! 💙 The ending is too sweet~!"
    "Cho tới khi hoàng tử tiết lộ... a, tui không nên spoil! Cái kết siêu ngọt luôn~!"

# game/script.rpy:2571
translate vi ch5_8ea6ec16:

    # nvl clear
    # n "After admiring the cover art for a while, Periwinkle finally opens the book and begins to read."
    nvl clear
    n "Sau khi ngắm nghía bìa sách một hồi, Periwinkle bắt đầu mở cuốn sách ra đọc."

# game/script.rpy:2575
translate vi ch5_558ae81a:

    # w shutin love "Just as lovely as I remember... such delicate linework...."
    w shutin love "Vẫn đỉnh như ngày nào... những nét vẽ tinh tế thế này...."

# game/script.rpy:2576
translate vi ch5_c6240c65:

    # w calm "I wouldn't blame that prince for noticing the dresses before the girl. They really are so beautiful."
    w calm "Sao mà trách hoàng tử để ý bộ váy thay vì cô gái được, đẹp thế kia mà."

# game/script.rpy:2577
translate vi ch5_63862a4b:

    # w oh "Come to think of it, the way this prince is drawn..."
    w oh "Nói tới thì, nét vẽ bạn hoàng tử..."

# game/script.rpy:2578
translate vi ch5_130cf072:

    # w "His short, fluffy hair, his gentle features... remind me of..."
    w "Mái tóc ngắn bồng bền, đường nét dịu dàng trên khuôn mặt... làm tui nhớ đến..."

# game/script.rpy:2581
translate vi ch5_6e0c6c75:

    # n "Periwinkle closes the book in a panic."
    n "Periwinkle hoảng hốt gấp cuốn truyện lại."

# game/script.rpy:2583
translate vi ch5_30eaa72d:

    # w shutin mad "That was dangerous. I can't risk even thinking his name...!"
    w shutin mad "Nguy hiểm quá. Tui còn không dám nghĩ tới tên của cậu ta...!"

# game/script.rpy:2584
translate vi ch5_f09961e7:

    # w whine "Ahh, and there's even a later chapter where he's dressed in servants' clothing! There are too many parallels...!"
    w whine "A, mấy chương sau còn có cảnh hoàng tử mặc đồ của người hầu! Thực sự là có quá nhiều điểm tương đồng...!"

# game/script.rpy:2585
translate vi ch5_41e8eb06:

    # n "Periwinkle rolls across his bed and slides the book back into its place on his shelf."
    n "Periwinkle lăn khỏi giường, trả cuốn sách về vị trí của nó trên kệ."

# game/script.rpy:2586
translate vi ch5_5b74eeff:

    # w pout "This isn't fair... how can one of my most beloved series be off-limits in my time of need...?"
    w pout "Không công bằng... giờ với cả sê-ri yêu thích nhất của tui cũng không thể đụng ngay trong lúc cấp thiết thế này ư...?"

# game/script.rpy:2587
translate vi ch5_8b1d5778:

    # n "He scans through the different titles once more, before landing on a 12-volume series..."
    n "Cậu lướt mắt qua các tựa truyện trên kệ một lần nữa, và chuyển sang một sê-ri 12 quyển..."

# game/script.rpy:2589
translate vi ch5_f3715939:

    # w neutral "I don't remember this one as clearly... but as an all-girls story, it should be safe...."
    w neutral "Tui không nhớ rõ nội dung bộ này lắm... nhưng đây là truyện chỉ có toàn gái nên chắc sẽ an toàn thôi..."

# game/script.rpy:2591
translate vi ch5_57ab056b:

    # n "Periwinkle pulls the new book from his shelf, and quietly immerses himself in its fictional world..."
    n "Periwinkle lôi cuốn sách mới khỏi kệ, lặng lẽ chìm đắm trong thế giới ảo..."

# game/script.rpy:2595
translate vi ch5_0630a164:

    # "Before I knew it, I'd finished reading all 12 volumes. The whole day had flown right by."
    "Quay qua quay lại, tui đã đọc hết cả bộ 12 quyển. Nguyên một ngày trời lướt qua như một cơn gió."

# game/script.rpy:2596
translate vi ch5_7bca8e7b:

    # "I couldn't help but keep turning the pages... the story was so much more than I remembered!"
    "Tui không ngừng đọc được luôn... câu chuyện còn tuyệt hơn những gì tui nhớ nữa!"

# game/script.rpy:2597
translate vi ch5_34844c79:

    # "The protagonist was nothing to write home about, but her childhood friend? Ah, what a moving character arc...!"
    "Nữ chính thì không có gì để nói mấy. Nhưng bạn thân từ nhỏ của cổ á? A, nguyên một trường đoạn phát triển nhân vật siêu cảm động luôn...!"

# game/script.rpy:2598
translate vi ch5_33580eee:

    # nvl clear
    # "She's very charismatic from the start. The kind of person you'd think has it all figured out... but you couldn't be more wrong!"
    nvl clear
    "Từ đầu cổ là một nhân vô cùng thu hút. Là kiểu người mà bạn nghĩ nắm hết mọi chuyện trong lòng bàn tay... nhưng hoàn toàn không phải!"

# game/script.rpy:2600
translate vi ch5_49da7a6c:

    # "Over the course of the series, she goes through so many love interests... back in the day, I had assumed it was because the author couldn't make up their mind!"
    "Trong suốt diễn biến truyện, cô ấy đã trải qua rất nhiều mối tình... hồi đó thì tui đã nghĩ tác giả lan man thế là do không biết giải quyết thế nào nên nhây cơ!"

# game/script.rpy:2601
translate vi ch5_e0af319b:

    # nvl clear
    # "But reading it all at once, it must've been planned from the beginning... these doomed relationships are merely self-sabotage! A distraction from pursuing her one true love!"
    nvl clear
    "Nhưng đọc hết một lượt thì có thể thấy rõ là tác giả đã có dụng ý ngay từ đầu luôn... những mối quan hệ kia chỉ là đánh lạc hướng trên con đường tìm kiếm tình yêu đích thực!"

# game/script.rpy:2603
translate vi ch5_9828e662:

    # "She never realizes the obvious answer until the very end...! And what an emotional finale!"
    "Cổ không tự nhận ra câu trả lời rõ mồn một cho tới mãi về sau...! Một cái kết siêu cảm động!"

# game/script.rpy:2604
translate vi ch5_967fea48:

    # "When she finally confesses, and the two girls share their first kiss...!"
