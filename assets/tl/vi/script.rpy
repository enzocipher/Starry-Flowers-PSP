translate vi ch3_3eba0b21:

    # w smile "I don't know what you keep apologizing for, Pastille. I'll see you around, yes?"
    w smile "Không hiểu cậu đang xin lỗi cái gì luôn đó. Gặp lại sau, nhé?"

# game/script.rpy:1344
translate vi ch3_c525b41f:

    # n "Pastille nods... and finally lets go of his wrist."
    n "Pastille gật đầu và buông tay Periwinkle ra..."

