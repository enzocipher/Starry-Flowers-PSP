    # w happy "My, but you don't put up with ANYONE! You must really like me 💙"
    w happy "Đấy thấy chưa, đâu phải ai bà cũng chịu đựng đâu! Có nghĩa là bà thích tui lắm đó 💙"

# game/script.rpy:807
translate vi ch2_47067d4c:

    # a lol "You got a favor to ask or something? Is that what you're getting at?"
    a lol "Cậu đang muốn xin xỏ tui cái gì đấy à?"

# game/script.rpy:808
translate vi ch2_df3d1bd8:

    # w calm "No, I was just thinking of how to categorize our relationship."
    w calm "Đâu có, tui chỉ đang cố phân loại xem quan hệ giữa chúng ta là gì."

# game/script.rpy:809
translate vi ch2_72e2a8ac:

    # a "\"Business associate\" works just fine, doesn't it?"
    a "\"Đối tác làm ăn\" không phải chuẩn bài nhất rồi sao?"

# game/script.rpy:810
translate vi ch2_5f78763b:

    # w happy "Come now, surely you consider us to be closer than that!"
    w happy "NÀO, quan hệ của tụi mình phải hơn thế chứ!"

# game/script.rpy:811
translate vi ch2_ce50824a:

    # a sure "I know better than to get involved with you, Periwinkle."
    a sure "Tui biết thừa chả có gì tốt lành khi dính vô cậu cả, Periwinkle thân mến ạ."

# game/script.rpy:812
translate vi ch2_17ce8a61:

    # w my "Why, whatever do you mean?"
    w my "Có ý gì đây?"

# game/script.rpy:813
translate vi ch2_0ac87123:

    # a whatever "You're too dazzling."
    a whatever "Cậu quá bung lụa."

# game/script.rpy:814
translate vi ch2_4a6eea27:

    # w innocent "I take that as a compliment~"
    w innocent "Tui sẽ xem như đó là lời khen~"

# game/script.rpy:815
translate vi ch2_d60255a0:

    # a annoyed "Great, now will you stop distracting me? I'm trying to count."
    a annoyed "Tốt, giờ thì đừng làm phiền tui nữa dùm, đang bận đếm."

# game/script.rpy:817
translate vi ch2_8c4a5641:

    # "Yes, we're definitely good friends."
    "Thấy chưa, tụi tui là mẫu bạn tốt điển hình."

# game/script.rpy:818
translate vi ch2_9ecc4a32:

    # "\"Too dazzling\" though... I'm not sure there IS such a thing."
    "Cơ mà \"quá bung lụa\"... Cái này thì tui không chắc lắm."

# game/script.rpy:819
translate vi ch2_82c90c4f:

    # "And what would be wrong with it if there was? What point is there in not shining as brightly as one can?"
    "Với cả dù có thế thì đã sao? Ở đời mà không cháy hết mình thì còn gì vui?"

# game/script.rpy:820
translate vi ch2_d0dcce99:

    # "Astragalus finishes counting the bottles, sighing in feigned exasperation as she marks them off her checklist..."
    "Astragalus kiểm tra số lượng lọ xong, cổ làm bộ thở dài khó chịu và gạch nó khỏi danh sách..."

# game/script.rpy:821
translate vi ch2_529b0ff5:

    # nvl clear
    # a sure "You may always be late... but you deliver quality every time. You're consistent, if nothing else."
    nvl clear
    a sure "Tuy là lúc nào cũng giao muộn... nhưng hàng lần nào cũng rất chất lượng. Đúng là một con người nhất quán."

# game/script.rpy:824
translate vi ch2_389bf1e7:

    # w teehee "The waiting is part of the fun. It builds excitement, wouldn't you say?"
    w teehee "Đợi chờ là hạnh phúc mà. Có đợi chờ thì mới tạo cảm giác trông ngóng kích thích, không phải sao?"

# game/script.rpy:825
translate vi ch2_2f490664:

    # a whatever "Nope, just builds frustration for me. But at least you always come through."
    a whatever "Không hề, đợi chờ là niềm đau. Ít nhất thì hàng của cậu luôn đạt chuẩn nên thôi."

# game/script.rpy:827
translate vi ch2_4251ed12:

    # n "She unlocks a small drawer behind the counter, and takes out an envelope with Periwinkle's name scribbled on it."
    n "Cổ mở ngăn kéo nhỏ sau quầy, và lấy ra một chiếc phong bì có tên Periwinkle được viết nguệch ngoạc trên đó."

# game/script.rpy:829
translate vi ch2_9104554e:

    # a closed "Here's the rest of your payment. Don't spend it all in one place."
    a closed "Tiền công của cậu đây. Đừng có mà phung phí hết trong một lần chơi bời đấy."

# game/script.rpy:830
translate vi ch2_338d50e7:

    # w calm "Oh, I couldn't if I tried! Really, you're too generous..."
    w calm "Tui có cố cũng không được đâu! Bà hào phóng quá mà..."

# game/script.rpy:833
translate vi ch2_8daa5982:

    # n "Astragalus rolls her eyes and begins stocking the shelves with her new inventory."
    n "Astragalus đảo mắt và bắt đầu bày hàng mới lên kệ."

# game/script.rpy:835
translate vi ch2_ffbdbe6c:

    # "Two or three orders a month... that's all it takes to support myself, entirely through this apothecary."
    "Cứ một tháng hai ba đơn hàng từ hiệu thuốc này, và nhiêu đó là đủ để nuôi sống tui..."

# game/script.rpy:836
translate vi ch2_ba2406db:

    # "Hard to believe my magic is really worth so much, but who am I to complain?"
    "Thật khó tin là phép của tui có giá như vậy, nhưng tui có tư cách gì phàn nàn chứ."

# game/script.rpy:837
translate vi ch2_acb5044d:

    # "It's certainly a more favorable balance compared to the kind of work I was doing years ago."
    "Làm công việc này sướng hơn nhiều so với những công việc mà tui làm cách đây vài năm."

# game/script.rpy:838
translate vi ch2_7acd925f:

    # nvl clear
    # "And I do enjoy the freedom, the excessive amounts of time I have for partying, for dates..."
    nvl clear
    "Tui cũng tận hưởng sự tự do, thời gian rỗi rãi để hẹn hò tiệc tùng thả ga thế này..."

# game/script.rpy:840
translate vi ch2_a2058868:

    # "Ah, on that note~"
    "À, mà nói tới~"

# game/script.rpy:841
translate vi ch2_0b1b7e93:

    # nvl clear
    # w happy "With all that business out of the way... would you like to hear about my date? 💙"
    nvl clear
    w happy "Công chuyện cũng xong rồi... bà muốn nghe tui kể về buổi hẹn hò đó không? 💙"

# game/script.rpy:844
translate vi ch2_fa857f5d:

    # a sure "Would I LIKE to? Not necessarily."
    a sure "Tui MUỐN nghe không á? Không cần."

# game/script.rpy:845
translate vi ch2_95d8347d:

    # w teehee "Please, Astragalus, as someone with no romance in your OWN life, the least you can do is live vicariously through me~"
    w teehee "Làm ơn đi Astragalus à, với một người không có lấy mảnh tình vắt vai như bà thì nên trải nghiệm gián tiếp thông qua tui đó~"

# game/script.rpy:846
translate vi ch2_8be11c8d:

    # a whatever "The no romance thing is by choice. I listen to you gush for your own damn sake."
    a whatever "Độc thân vui tính là do tui muốn chứ không phải vì ế. Đây chỉ nghe vì cậu thôi, nên biết ơn đi."

# game/script.rpy:847
translate vi ch2_66b3a391:

    # w my "For MY sake?"
    w my "Vì TUI á?"

# game/script.rpy:848
translate vi ch2_e2b9789b:

    # a sure "Yeah, I'm afraid you might actually implode if you had no one to talk to about this stuff."
    a sure "Chứ còn gì nữa, tui lo là đằng ấy sẽ bùng nổ vì không có ai làm thùng rác cho đằng ấy xả hết."

# game/script.rpy:849
translate vi ch2_fdfc2ccd:

    # a lol "I'm actually making a noble sacrifice every day that you come in here with new tales of romantic conquest."
    a lol "Ngày nào tui cũng phải hy sinh cao cả nghe cậu tới đây huyên thuyên như sớ về mấy chuyện tình ái."

# game/script.rpy:850
translate vi ch2_b3b6ebb7:

    # w pout "Hmph. If you're truly suffering, I shall desist..."
    w pout "Hứ, đã vậy thì tui cũng không thèm kể nữa..."

# game/script.rpy:851
translate vi ch2_115b6d90:

    # a smile "That's the thing, though... I DO like seeing you all worked up over something, even if I don't understand it myself."
    a smile "Thế lại đỡ quá, mặc dù... tui PHẢI thừa nhận là nhìn cậu hào hứng như vậy khá thú vị, dù tui chả hiểu cho lắm."

# game/script.rpy:852
translate vi ch2_dfd74c02:

    # w happy "Ahh, so there IS a mutual benefit! You'll listen, then? 💙"
    w happy "Đó, đôi bên cùng có lợi thấy chưa! Vậy là chịu nghe đúng hơm? 💙"

# game/script.rpy:853
translate vi ch2_e4b44b62:

    # a sure "Yeah, at least until I get all this put away. After that, I'm kicking you out for the day."
    a sure "Ừ thì nghe, ít nhất là cho tới khi tui xếp xong mớ hàng này lên kệ. Xong rồi là tui sẽ đá cậu khỏi tiệm liền để còn nghỉ nữa."

# game/script.rpy:855
translate vi ch2_aa202e59:

    # w calm "Fair enough. I'd better be brief, then..."
    w calm "Cũng được thôi. Tui sẽ vắn tắt ngắn gọn vậy..."

# game/script.rpy:857
translate vi ch2_c163a19e:

    # w teehee "He's the absolute cutest thing! I picked him up at a candy shop yesterday 💙"
    w teehee "Cậu ta đúng là người dễ thương nhất quả đất! Tui tia được ở tiệm kẹo hôm qua đó 💙"

# game/script.rpy:858
translate vi ch2_7ea91466:

    # w happy "Fluffy pink hair, with golden eyes, naturally rosy cheeks that make him look as if he's always a little embarrassed by something..."
    w happy "Mái tóc hồng bồng bềnh và đôi mắt vàng, cặp má ửng hồng tự nhiên khiến cậu ta lúc nào trông cũng như đang xấu hổ..."

# game/script.rpy:859
translate vi ch2_78bc035b:

    # w shy "He's shy, but not the type that becomes paralyzed in the bedroom--"
    w shy "Cậu ta nhút nhát, nhưng là lên giường sẽ hóa sói--"

# game/script.rpy:860
translate vi ch2_e6e9e69b:

    # a augh "Periwinkle, for the last time, I do NOT need to hear about bedroom stuff." with vpunch
    a augh "Lần cuối nhé Periwinkle, tui KHÔNG có nhu cầu nghe chuyện giường chiếu của cậu." with vpunch

# game/script.rpy:861
translate vi ch2_91bce83e:

    # w my "I wasn't giving any details!"
    w my "Tui có kể chi tiết gì chuyện đó đâu!"

# game/script.rpy:862
translate vi ch2_f28bb905:

    # w shy "Although, the details ARE the best part 💙"
    w shy "Cơ mà chi tiết CHỖ ĐÓ mới là phần ngon nhất 💙"

# game/script.rpy:863
translate vi ch2_6f8d4d69:

    # a annoyed "This is a \"safe for work\" zone only. Break that rule, and you're outta here."
    a annoyed "Đây là môi trường làm việc, cà chớn là đi ra ngoài."

# game/script.rpy:864
translate vi ch2_91ce2d8b:

    # w innocent "My apologies~ I'll refrain."
    w innocent "Xin lỗi mà~ Tui sẽ tiết chế lại."

# game/script.rpy:865
translate vi ch2_dc5be651:

    # w love "Anyway, my point is... he's EXTREMELY cute. Adorable, in fact!"
    w love "Túm lại là... cậu ấy CỰC KỲ dễ thương. Cưng muốn xỉu lên xỉu xuống luôn!"

# game/script.rpy:866
translate vi ch2_d8b497e3:

    # a eyeroll "Right, so, standard fare for you."
    a eyeroll "Rồi, kiểu con mồi tiêu chuẩn của cậu ha."

# game/script.rpy:867
translate vi ch2_fc605430:

    # w my "Absolutely not! If he was just your average cutie, would I be emphasizing his cuteness so much?"
    w my "KHÔNG! Nếu cậu ta chỉ dễ thương ở tầm trung thì việc gì tui phải nhấn mạnh tới lui sự dễ thương của cậu ta tới vậy?"

# game/script.rpy:868
translate vi ch2_a47387c2:

    # a sure "I don't meet these people, so it's all the same to me."
    a sure "Tui có gặp mấy người đó đâu, chỉ nghe qua lời cậu kể thôi, vậy nên với tui ai cũng như ai."

# game/script.rpy:869
translate vi ch2_afb4034f:

    # w oh "How can it be~? The intensity is so drastically different... perhaps SO intense that I'm having trouble explaining it properly."
    w oh "Sao vậy được~? Sự chênh lệch quá khác biệt... tới mức tui quằn quại vì không thể lột tả hết được bằng lời đây này."

# game/script.rpy:870
translate vi ch2_3da682aa:

    # a closed "I'll say. All you've really told me so far is that he's cute and shy."
    a closed "Tui phải nói là tất cả những gì nãy giờ tui được nghe chỉ là cậu ta dễ thương và nhút nhát."

# game/script.rpy:871
translate vi ch2_8e3642e4:

    # w shy "He's kind, as well! He saved the best part of our dessert for me without even asking!"
    w shy "Còn tử tế nữa chứ! Cậu ta không nói không rằng, tự động nhường phần ngon nhất trong món tráng miệng cho tui!"

# game/script.rpy:872
translate vi ch2_dfa9b85a:

    # a lol "Wow, I would've led with that one."
    a lol "Quào, nếu là cậu trai như thế chắc tui cũng muốn thử hẹn đấy."

# game/script.rpy:873
translate vi ch2_fdbe174a:

    # w pout "Ohh, enough of your sarcasm. When all my favorite details are off-limits, what do you suppose I'm LEFT with?"
    w pout "Nèee, khịa đủ rồi nha. Mấy chỗ hay nhất thì bị cấm hết rồi, còn gì mấy cho tui kể đâu?"

# game/script.rpy:874
translate vi ch2_ab7c305b:

    # a happy "Well, what really matters is that you had a good night. Even if it meant you couldn't get here on time like I asked."
    a happy "Thì chốt lại vẫn là cậu được một đêm thăng hoa và trễ hẹn với tui thôi."

# game/script.rpy:875
translate vi ch2_f5e62b00:

    # w love "Ahh~ I'm already hoping to see him again, to be honest..."
    w love "Aaa~ Thật lòng mà nói thì tui lại muốn gặp cậu ta rồi..."

# game/script.rpy:876
translate vi ch2_0979287d:

    # a hm "Oh yeah? Don't hear that from you very often."
    a hm "Ô hô? Chẳng mấy khi nghe được câu này từ cậu đấy."

# game/script.rpy:877
translate vi ch2_83be95f7:

    # w oh "Really? But I've gone on second dates all the time."
    w oh "Thiệt hả? Nhưng ai tui cũng hẹn hò hai lần mà."

# game/script.rpy:878
translate vi ch2_95f62998:

    # a lol2 "This guy got a name?"
    a lol2 "Tên cậu ta là gì ấy?"

# game/script.rpy:879
translate vi ch2_899be6dd:

    # w shy "Hmhm, I don't kiss and tell 💙"
    w shy "Hừm, tui không phải dạng dễ dãi gì cũng khai cho đâu nha 💙"

# game/script.rpy:880
translate vi ch2_7b70ce89:

    # a sure "No, actually, you tell me about everyone you kiss."
    a sure "Ủa, chứ ai cứ bô lô ba la khai tuốt tuồn tuột mấy người mình xà nẹo vậy kìa."

# game/script.rpy:881
translate vi ch2_44e74989:

    # a lol "C'mon, if he's really the absolute cutest, it's a shame to keep him anonymous, right? Not like I'm gonna tell anyone anyways."
    a lol "{size=-4}Nào, nếu cậu ta dễ thương đến thế, chỉ để cậu ta là người vô danh A trong ấn tượng của tui không phải phí quá sao? Tui cũng chả tính kể cho ai đâu mà lo.{/size}"

# game/script.rpy:882
translate vi ch2_cb259e44:

    # w calm "Fine... his name is Pastille."
    w calm "Rồi rồi... tên của cậu ấy là Pastille."

# game/script.rpy:883
translate vi ch2_ce121fd3:

    # a annoyed "Hmph. Even his name's cute."
    a annoyed "Hừ, kể cả tên cũng dễ thương."

# game/script.rpy:884
translate vi ch2_b434ce04:

    # w happy "Right~?"
    w happy "Đã bảo mà~"

# game/script.rpy:885
translate vi ch2_2d463d2b:

    # w smile "Oh, that reminds me--he sold me some candies that share his name. Would you like to try?"
    w smile "Nói mới nhớ--cậu ta bán tui loại kẹo trùng tên với cậu ta đó. Ăn thử không?"

# game/script.rpy:886
translate vi ch2_628745c1:

    # a happy "Sure. How could a witch turn down free candy?"
    a happy "Ok. Phù thủy nào lại từ chối kẹo miễn phí chứ."

# game/script.rpy:887
translate vi ch2_2ac72dd0:

    # n "Periwinkle digs into his bag and pulls out one of the pastilles."
    n "Periwinkle thò tay vào túi lấy ra một viên kẹo ngậm đưa cho Astragalus."

# game/script.rpy:888
translate vi ch2_c90345e5:

    # n "He hands the candy to Astragalus, who promptly unwraps it and pops it into her mouth."
    n "Astragalus nhanh chóng gỡ giấy gói và cho viên kẹo vào miệng."

# game/script.rpy:889
translate vi ch2_e3dc6cdf:

    # a hm "Mmf... Oh, these are GOOD. Where'd you say this candy shop was?"
    a hm "Măm... Ê, cái này ngon nè. Tiệm này ở đâu thế?"

# game/script.rpy:890
translate vi ch2_6e7c54dc:

    # w happy "Not far from here! I'll give you directions..."
    w happy "Cũng gần đây thôi! Để tui viết địa chỉ cho..."

# game/script.rpy:897
translate vi ch2_58993334:

    # "Shortly after telling Astragalus where to find Atelier Sweets, she unceremoniously kicked me out..."
    "Sau khi chỉ đường đến Atelier Sweets cho Astragalus, cổ thẳng thừng đá tui khỏi tiệm luôn..."

# game/script.rpy:898
translate vi ch2_7f4ee160:

    # "She'd long finished putting all those bottles away, after all."
    "Mà dù sao cổ cũng xếp xong đống lọ đó từ lâu rồi."

# game/script.rpy:899
translate vi ch2_d635dbff:

    # "With money in my pocket, and no more work to be done for the moment... I'm free to begin pursuing my next date~"
    "Không có việc gì khác để làm, và tiền thì đang rủng rỉnh trong túi... Giờ tui có thể bắt đầu tìm kiếm con mồi tiếp theo~"

# game/script.rpy:900
translate vi ch2_a4f99886:

    # nvl clear
    # "But wherever shall I go? It's a weekday, too early for parties, too early for drinks..."
    nvl clear
    "Nhưng đi đâu bây giờ? Giờ vẫn còn trong tuần, quá sớm để tiệc tùng nhậu nhẹt..."

# game/script.rpy:902
translate vi ch2_1e5385aa:

    # "I suppose I could return home and straighten up the place. However..."
    "Tui có thể về thẳng nhà dọn dẹp mớ bừa bộn kia. Có điều..."

# game/script.rpy:903
translate vi ch2_801baa18:

    # nvl clear
    # w calm "(Why would I busy myself with chores when I could be celebrating another order successfully filled?)"
    nvl clear
    w calm "(Sao tui phải phí thời gian cho ba cái chuyện dọn dẹp nhà cửa, trong khi có thể quẩy để ăn mừng một đơn hàng nữa lại trót lọt chứ?)"

# game/script.rpy:906
translate vi ch2_7123d8ef:

    # n "Before Periwinkle can decide on where to go, a familiar witch approaches him."
    n "Trước khi Periwinkle quyết định được sẽ đi đâu thì một phù thủy quen mặt tiến đến."

# game/script.rpy:909
translate vi ch2_a7e53e02:

    # c "Periwinkle...?"
    c "Periwinkle phải không...?"

# game/script.rpy:910
translate vi ch2_ed8e4bc5:

    # w happy "Ohh, Cassia! So lovely to see you~"
    w happy "Ô, Cassia đây mà! Lâu rồi mới gặp nha~"

# game/script.rpy:911
translate vi ch2_cca6951a:

    # c happy "Yay, I'm so glad we ran into each other~"
    c happy "Tình cờ gặp cậu thế này thật hay quá~"

# game/script.rpy:913
translate vi ch2_18cfade9:

    # "How to describe Cassia..."
    "Cassia... nói sao ta..."

# game/script.rpy:914
translate vi ch2_0c67f0a0:

    # "She's exceedingly cuddly. We met at a party one night, during which she latched onto my arm and never let go. Quite endearing!"
    "Cổ bám dai cực. Bọn tui gặp nhau trong một bữa tiệc, và suốt đêm đó cổ bám chặt cánh tay tui không buông luôn. Khá là dễ mến!"

# game/script.rpy:915
translate vi ch2_6535f464:

    # "Since then, we've gone on little dates from time to time..."
    "Từ dạo đó, thi thoảng bọn tui lại hẹn hò dăm ba lần..."

# game/script.rpy:916
translate vi ch2_91a4c39c:

    # "She really loves my magic, so I tend to spoil her whenever we're together 💙"
    "Cổ mê tít phép thuật của tui, nên lần nào tụi tui bên nhau tui cũng chìu cổ hết 💙"

# game/script.rpy:917
translate vi ch2_fc9d5dc6:

    # nvl clear
    # w smile "Did you need something, dear?"
    nvl clear
    w smile "Cục cưng có cần gì không?"

# game/script.rpy:920
translate vi ch2_7206142c:

    # c aww "Ah, yes! I tried coming over last night, but you didn't seem to be home..."
    c aww "Có! Tối qua tớ có ghé nhưng hình như cậu không có nhà..."

# game/script.rpy:921
translate vi ch2_693e007a:

    # w shy "Aww, you came to visit me? I'm flattered 💙"
    w shy "Ầu, cậu ghé thăm hả? Ngại quớ 💙"

# game/script.rpy:922
translate vi ch2_399869f1:

    # w smile "I must've been out to dinner at the time... Sorry that I missed you~"
    w smile "Chắc lúc đó tui đang đi ăn tối... Xin lỗi nha~"

# game/script.rpy:923
translate vi ch2_2f0adf6c:

    # c smile "Oh, it's okay~ I was mostly looking to talk..."
    c smile "Không sao đâu~ Chủ yếu tớ tính gặp để nói chuyện..."

# game/script.rpy:924
translate vi ch2_c9ba5380:

    # c aww "So, um, if you're available right now... do you wanna go to a café?"
    c aww "Nên, ừm, nếu giờ cậu rảnh... tụi mình đi cà phê nha?"

# game/script.rpy:925
translate vi ch2_d5996b44:

    # w innocent "That sounds perfect! I would love to."
    w innocent "Tuyệt cú mèo! Ok luôn nha."

# game/script.rpy:931
translate vi ch2_e516a126:

    # "We take our seats at the nearby café."
    "Bọn tui ngồi vào bàn tại một quán cà phê gần đó."

# game/script.rpy:932
translate vi ch2_07ec8f7d:

    # "It's a pleasant, sunny little place. I've come here often with all sorts of other witches."
    "Đó là một quán nhỏ nhắn ngập tràn nắng ấm. Tui thường tới đây với đủ kiểu phù thủy khác nhau."

# game/script.rpy:933
translate vi ch2_798bacd1:

    # "Cassia orders her usual hot chocolate with extra marshmallows, while I decide on a simple rose tea."
    "Cassia gọi món tủ của cô ấy, sô-cô-la nóng nhiều kẹo xốp marshmallow, còn tui chỉ gọi một tách trà hoa hồng đơn giản."

# game/script.rpy:934
translate vi ch2_13febc5a:

    # nvl clear
    # c oh "Ooh, Periwinkle, could you make my marshmallows smell like roses, too?"
    nvl clear
    c oh "Periwinkle nè, cậu làm marshmallow của tớ có mùi hoa hồng với, được không?"

# game/script.rpy:937
translate vi ch2_e1d1de4a:

    # w innocent "With pleasure 💙"
    w innocent "Rất sẵn lòng 💙"

# game/script.rpy:938
translate vi ch2_d7d93e12:

    # n "Periwinkle's wand drops from his sleeve, and he gives Cassia's cup a quick little tap."
    n "Periwinkle lấy đũa phép từ ống tay áo và gõ nhẹ lên cốc của Cassia."

# game/script.rpy:939
translate vi ch2_9343669f:

    # c happy "Eheh, yay~ It really smells just like roses~!"
    c happy "Ehe, tuyệt~ Nó có mùi như hoa hồng thật này~!"

# game/script.rpy:940
translate vi ch2_790200db:

    # w smile "Just as you asked, dear. It may slightly affect the taste, so let me know if you'd like the spell undone."
    w smile "Như yêu cầu của cục cưng thôi. Nhưng có thể nó sẽ ảnh hưởng đôi chút tới hương vị, nên nếu muốn gỡ chú thuật thì nhớ nói nha."

# game/script.rpy:942
translate vi ch2_51b79206:

    # n "Cassia dips her spoon in and lifts a marshmallow to her lips, blowing on it lightly before popping it into her mouth."
    n "Cassia múc một viên kẹo xốp lên, thổi nhẹ trước khi đưa vào miệng."

# game/script.rpy:943
translate vi ch2_bb00d05f:

    # c happy "Mmf... no, it's wonderful! Ehehe~ 🤎"
    c happy "Măm... không cần đâu, ngon tuyệt luôn đó! Ehehe~ 🤎"

# game/script.rpy:946
translate vi ch2_88501500:

    # "She truly can find the joy in any little moment. Such a delight..."
    "Cổ thực sự có thể tìm thấy niềm vui từ những chuyện nhỏ nhất. Khiến người ta cũng vui vẻ theo..."

# game/script.rpy:947
translate vi ch2_28e04d59:

    # "Definitely a contender for the title of absolute cutest witch. Though I would call her... absolutely cute, rather than the absolute cutest."
    "Chắc chắn là một trong những ứng cử viên cho danh hiệu phù thủy đáng yêu nhất. Mặc dù... tui thấy cổ cực kỳ dễ thương hơn là đáng yêu."

# game/script.rpy:948
translate vi ch2_22a82a32:

    # "It takes more than cuteness alone to earn the title of absolute cutest witch! That's where the difference lies, of course."
    "Để dành được danh hiệu đó thì chỉ dễ thương thôi là không đủ! Đó là cái làm nên sự khác biệt."

# game/script.rpy:949
translate vi ch2_1167b98f:

    # nvl clear
    # "But what am I thinking? How rude it is, to begin ranking my dates in such a way."
    nvl clear
    "Nhưng tui đang nghĩ cái quái gì thế này? Thiệt quá là khiếm nhã khi xếp hạng những bạn hẹn của mình như vậy mà."

# game/script.rpy:951
translate vi ch2_89364570:

    # "I must be stuck on the thought from my earlier conversation with Astragalus... trying to put Pastille's cuteness into words."
    "Chắc tui vẫn còn kẹt trong mớ suy nghĩ ban nãy... khi cố mô tả sự dễ thương của Pastille thành lời cho Astragalus hiểu."

# game/script.rpy:952
translate vi ch2_f14542af:

    # "He really is something special... ah, it's all in the contrast! His polite, well-mannered and proper exterior, concealing such intense desire, begging you to make the first move, and then going ahead and taking it on his own as soon as you--"
    "Cậu ta thực sự có cái gì đó rất đặc biệt... à, chính là sức hút đối nghịch! Bên ngoài lịch thiệp đứng đắn là thế, lại che giấu bên trong ham muốn mãnh liệt tới vậy, cầu xin người ta động thủ nhưng rồi sau đó lại tấn công trước--"

# game/script.rpy:953
translate vi ch2_d02f8f43:

    # nvl clear
    # w oops "(...Enough of that! There's someone else in front of me now, isn't there?)" with vpunch
    nvl clear
    w oops "(...Đủ rồi! Trước mặt mình đang là người khác kia mà?)" with vpunch

# game/script.rpy:956
translate vi ch2_84a03c6d:

    # n "Cassia continues happily sipping her hot chocolate before speaking up again."
    n "Cassia vui vẻ nhấm nháp ly sô-cô-la nóng rồi lại cất tiếng."

# game/script.rpy:958
translate vi ch2_4958d936:

    # c aw "Ahh, I missed you, Periwinkle~ I've been so busy with packing, I haven't had a chance to see you at all..."
    c aw "Aaa, tớ nhớ cậu chết đi được Periwinkle ơi~ Tớ lu bu dọn đồ quá nên không có thời gian gặp cậu luôn..."

# game/script.rpy:959
translate vi ch2_15a35145:

    # w my "Packing? And just where are you headed off to?"
    w my "Dọn đồ? Cậu tính chuyển đi đâu thế?"

# game/script.rpy:960
translate vi ch2_959ab161:

    # c oh "Oh, that's right! I never had a chance to tell you~"
    c oh "Ồ, phải ha, tớ chả có cơ hội thông báo cho cậu~"

# game/script.rpy:961
translate vi ch2_28a09411:

    # c happy "I'm finally moving in with my partners~! In two more days, the three of us will all be sleeping in the same bed~ 🤎"
    c happy "Tớ dọn tới sống chung với người yêu đó~! Hai ngày nữa là cả ba chúng tớ có thể ngủ chung giường rồi~ 🤎"

# game/script.rpy:962
translate vi ch2_1b9c5f18:

    # w happy "Ooh, that sounds cozy~ Congratulations!"
    w happy "Ỏ, nghe ấm cúng ghê~ Chúc mừng nha!"

# game/script.rpy:963
translate vi ch2_937fc8b0:

    # c aww "Ehe, thank you~ 🤎 I've looked forward to it for so long..."
    c aww "Ehe, cảm ơn cậu~ 🤎 Tớ đã mong đợi ngày này từ lâu lắm rồi..."

# game/script.rpy:964
translate vi ch2_aae442de:

    # w smile "It sounds like you're about to enter a lovely domestic life. You deserve it!"
    w smile "Nghe như cậu sắp bước vào một cuộc sống gia đình đầy yêu thương. Cậu thực sự xứng đáng với điều đó!"

# game/script.rpy:965
translate vi ch2_f5692979:

    # c "Aww, hehehe... I'm really happy."
    c "Hehehe... Tớ hạnh phúc muốn chết luôn."

# game/script.rpy:966
translate vi ch2_d2fabfa3:

    # c oh "But, um... speaking of my partners. You've still never even met them..."
    c oh "Nhưng mà, ừm... nói tới người yêu của tớ, cậu vẫn chưa gặp họ..."

# game/script.rpy:967
translate vi ch2_f5612c00:

    # w calm "True. But I can imagine they're wonderful, just from how you've talked about them."
    w calm "Ừ. Nhưng tớ có thể hình dung được là họ rất tuyệt vời như cách cậu kể về họ vậy."

# game/script.rpy:968
translate vi ch2_f82c96ac:

    # c aww "Right~ but, um... what if you didn't have to imagine?"
    c aww "Phải ha~ nhưng, ừm... nếu cậu không cần tưởng tượng nữa thì sao?"

# game/script.rpy:969
translate vi ch2_add80a4e:

    # c smile "That's what I've been wanting to talk to you about. I was hoping... we might all be able to go on a group date sometime!"
    c smile "Đó là cái tớ muốn cậu nói ý. Tớ thực sự mong... một lúc nào đó tụi mình có thể đi hẹn hò nhóm!"

# game/script.rpy:970
translate vi ch2_c81c387b:

    # w oh "Oh~?"
    w oh "Ô~?"

# game/script.rpy:971
translate vi ch2_8b6f2fb7:

    # c aw "Yeah~! Because, like... I just think you're so wonderful, Periwinkle. I want them to know you, too!"
    c aw "Ừ thì, kiểu... Periwinkle với tớ là một người vô cùng tuyệt vời, nên tớ cũng muốn họ được làm quen với cậu nữa!"

# game/script.rpy:972
translate vi ch2_40b31e80:

    # w sorry "Mm... although it sounds like fun, I'm a bit..."
    w sorry "Hưm... mặc dù nghe có vẻ vui đấy, nhưng mà..."

# game/script.rpy:973
translate vi ch2_7122e72f:

    # c please "W-wait, before you say no...!"
    c please "Đ-đợi đã, khoan từ chối đã...!"

# game/script.rpy:974
translate vi ch2_b6456ff5:

    # c "They're both very easygoing, and so loving, and nice...! I can promise it won't be overwhelming..."
    c "Hai người họ rất dễ tính, đáng yêu và tốt bụng luôn...! Tớ đảm bảo là sẽ không có gì khó xử ở đây hết..."

# game/script.rpy:975
translate vi ch2_62b54e38:

    # w decline "That unfortunately isn't where the issue lies, my dear..."
    w decline "Cục cưng à, tớ rất tiếc phải nói đó không phải là vấn đề..."

# game/script.rpy:976
translate vi ch2_bb65f581:

    # c sad "I-I know you said you didn't want to get involved before... but I just know that we would all get along so well!"
    c sad "T-Tớ biết là cậu từng bảo không muốn dính líu sâu chuyện đời tư của nhau... tớ chỉ biết là tụi mình sẽ rất hợp nhau thôi!"

# game/script.rpy:977
translate vi ch2_9db7f2b9:

    # c "I'd like to reassure you however I can. But I understand if you still turn me down..."
    c "Tớ muốn thử thuyết phục cậu hết mức có thể, nhưng nếu cậu từ chối thì tớ cũng hiểu..."

# game/script.rpy:979
translate vi ch2_99af5b21:

    # "Matters of love are so tricky, aren't they?"
    "Mấy chuyện tình ái thiệt là phức tạp ha?"

# game/script.rpy:980
translate vi ch2_b7229a67:

    # "I still recall the first time something like this was asked of me..."
    "Tui vẫn còn nhớ như in cái lần đầu nhận được yêu cầu kiểu này..."

# game/script.rpy:981
translate vi ch2_70f4d8cb:

    # "I had been nervous going in, but I had also never entered a group situation before. I attributed my anxiety solely to that."
    "Lúc hẹn tui cực kỳ lo lắng, nhưng vì chưa hẹn hò nhóm bao giờ nên cứ nghĩ sự lo lắng của tui chỉ là vì thế."

# game/script.rpy:982
translate vi ch2_5aaf6eab:

    # "However, it quickly became clear that I just wasn't suited to it at all..."
    "Tuy nhiên, tui nhanh chóng nhận ra vụ hẹn hò nhóm này không hợp với mình tí nào..."

# game/script.rpy:983
translate vi ch2_92e49d6c:

    # nvl clear
    # "I do love to spoil each of my partners--but strictly one at a time."
    nvl clear
    "Tui thích chiều chuộng bạn hẹn của mình--nhưng mỗi lần hẹn chỉ duy nhất một người mà thôi."

# game/script.rpy:985
translate vi ch2_13099713:

    # "Perhaps I was left scarred by the breakdown in communication, the passionate fires of a long-established romance..."
    "Có lẽ ngọn lửa cuồng nhiệt của mối tình lâu năm, sự đổ vỡ của mối quan hệ vì ít nói chuyện với nhau đã để lại vết sẹo trong tui..."
    nvl clear

# game/script.rpy:986
translate vi ch2_000f6a86:

    # "Surely Cassia and her partners are magnificent people. It may indeed be fun for a night."
    "Chắc chắn rằng Cassia và người yêu của cổ đều là những con người tuyệt vời. Có thể đó sẽ là một đêm tràn ngập tiếng cười."

# game/script.rpy:987
translate vi ch2_e1d8cf3a:

    # "But becoming entangled in committed relationships is something I've always avoided from the beginning, isn't it?"
    "Nhưng không phải từ đầu tui vẫn luôn né mấy mối quan hệ ràng buộc như vậy sao?"

# game/script.rpy:988
translate vi ch2_b61e07ce:

    # nvl clear
    # w neutral "This is all very sweet of you. But I do have to decline."
    nvl clear
    w neutral "Cảm ơn tấm lòng của cậu, nhưng chuyện này tớ đành từ chối."

# game/script.rpy:991
translate vi ch2_d6eb3267:

    # c letdown "Aww... I can't help but feel a little broken-hearted."
    c letdown "...Tuy biết trước nhưng tớ vẫn cảm thấy đau lòng nha."

# game/script.rpy:992
translate vi ch2_02d40560:

    # w decline "I apologize... Truly, it's nothing personal."
    w decline "Xin lỗi mà... Không phải do có thù hằn cá nhân gì đâu, thật đó."

# game/script.rpy:993
translate vi ch2_cea46204:

    # c aww "Oh, I know~ I don't take offense or anything..."
    c aww "Tớ biết mà~ Tớ không cảm thấy bị xúc phạm hay gì đâu..."

# game/script.rpy:994
translate vi ch2_13fca6f4:

    # c letdown "It's just sad. Now that I'm going to be living with them... and, knowing you don't want to meet them..."
    c letdown "Tớ chỉ buồn thôi. Giờ tớ sắp sống chung với họ... và cậu thì không muốn gặp họ..."

# game/script.rpy:995
translate vi ch2_82188b3a:

    # c sad "I think it's best we just break things off...."
    c sad "Tớ nghĩ tốt nhất là chúng ta không hẹn hò với nhau nữa..."

# game/script.rpy:996
translate vi ch2_9b7a5305:

    # w neutral "Yes, I agree. As you said, it's for the best."
    w neutral "Cái này thì tớ đồng ý, vậy là tốt nhất."

# game/script.rpy:997
translate vi ch2_22bfa56a:

    # c aww "I hope we can still be friends, though~"
    c aww "Nhưng tớ hy vọng tụi mình vẫn là bạn~"

# game/script.rpy:998
translate vi ch2_a119e9ad:

    # w smile "Of course~ 💙 I'm sure our paths will cross every now and again."
    w smile "Tất nhiên rồi~ 💙 Tụi mình vẫn sẽ gặp lại nhau thôi mà."

# game/script.rpy:999
translate vi ch2_96818197:

    # c happy "Yeah~! Thank you for always treating me so well, Periwinkle."
    c happy "Ừ~! Cảm ơn vì cậu luôn đối tốt với tớ nha, Periwinkle."

# game/script.rpy:1000
translate vi ch2_f9c0bf81:

    # w calm "Hmhm, it was my pleasure 💙"
    w calm "Rất hân hạnh 💙"

# game/script.rpy:1003
translate vi ch2_482c7dd0:

    # "Even casual relationships can end in breakups like this."
    "Kể cả những mối quan hệ bình thường cũng có thể kết thúc thế này đây."

# game/script.rpy:1004
translate vi ch2_7fabf76c:

    # "This is largely why I tend to prefer one-night affairs. Things can just become so messy as needs evolve..."
    "Đây là lý do to bự vì sao tui thích tình một đêm. Quan hệ càng sâu đậm thì càng rắc rối..."

# game/script.rpy:1005
translate vi ch2_e8be9790:

    # "As Cassia and I go our separate ways, I can't help feeling a little blue."
    "Khi đi về, tui không thể không cảm thấy chút cô đơn trống vắng dấy lên trong lòng."

# game/script.rpy:1006
translate vi ch2_7b0bc9f1:

    # "Perhaps I'll return home for the day after all."
    "Có lẽ tui sẽ về thẳng nhà luôn vậy."

# game/script.rpy:1007
translate vi ch2_76b2fe88_2:

    # nvl clear
    nvl clear

# game/script.rpy:1018
translate vi ch2_80d3118f:

    # n "Periwinkle quickly changes into something more comfortable, dropping his bag unceremoniously onto the couch."
    n "Periwinkle hờ hững thả chiếc túi lên đi văng, và nhanh chóng thay một bộ đồ thoải mái hơn."

# game/script.rpy:1019
translate vi ch2_a9ff1a56:

    # w pj neutral "(I could use an afternoon nap...)"
    w pj neutral "(Đánh một giấc cái đã...)"

# game/script.rpy:1020
translate vi ch2_10be0962:

    # w calm "(Yes, that's precisely what I need. I'll wake up feeling refreshed, and ready to go back out on the town~)"
    w calm "{size=-2}(Phải, đấy chính xác là thứ mình đang cần. Sau đó mình sẽ tỉnh dậy với một tinh thần sảng khoái, và sẵn sàng trở lại với cuộc vui ngoài kia~){/size}"

# game/script.rpy:1022
translate vi ch2_47c6e3ec:

    # n "He shoves some blankets aside and collapses onto the couch--and when he does, the contents of his bag spills onto the floor."
    n "Periwinkle đẩy mấy tấm chăn qua một bên rồi nằm gục xuống đi văng---và khiến mớ đồ trong túi rơi xuống sàn."

# game/script.rpy:1023
translate vi ch2_093623ac:

    # w oh "Ah..."
    w oh "A..."

# game/script.rpy:1024
translate vi ch2_189b671a:

    # n "Lazily leaning over to gather it up, he notices the candies from before..."
    n "Khi cúi xuống nhặt mớ đồ một cách lười biếng, cậu thấy mấy viên kẹo ban nãy..."

# game/script.rpy:1025
translate vi ch2_cba66395:

    # w neutral "...."
