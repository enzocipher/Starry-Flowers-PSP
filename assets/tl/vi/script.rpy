    p wow "T-tôi chỉ cố nghĩ xem nên đi đâu, và nơi này hiện lên trong đầu..."

# game/script.rpy:2110
translate vi ch4_eab2cf4c:

    # w happy "It's lovely. Very romantic 💙"
    w happy "Rất xinh đẹp tuyệt vời 💙"

# game/script.rpy:2111
translate vi ch4_2f1a8383:

    # w shy "(Straight out of a shoujo manga, honestly... how does he know I'm weak to such things?)"
    w shy "(Y như trong truyện tranh thiếu nữ luôn... sao cậu ấy biết tui yếu đuối trước mấy thứ này chứ?)"

# game/script.rpy:2112
translate vi ch4_9218331e:

    # p omg "We don't have to stay... I mean, we've already walked around so much--it's okay if you wanna head back now..."
    p omg "Nếu cậu không muốn thì chúng ta không cần nán lại... Ý tôi là, dù gì thì cũng đã đi bộ cả ngày nay rồi--giờ đi về cũng được..."

# game/script.rpy:2113
translate vi ch4_18984878:

    # p omgstop "N-NOT TO... DO THINGS... I just meant...! I-I'm gonna stop talking......" with vpunch
    p omgstop "K-KHÔNG... KHÔNG PHẢI ĐỂ LÀM CÁI CHUYỆN KIA ĐÂU... Ý tôi là...! T-tôi nên tắt văn thì hơn......" with vpunch

# game/script.rpy:2114
translate vi ch4_6d760657:

    # w love "Pastille."
    w love "Pastille."

# game/script.rpy:2115
translate vi ch4_7a8b97fb:

    # p seriously "Y-yes...?"
    p seriously "V-vâng...?"

# game/script.rpy:2116
translate vi ch4_ec1d1b34:

    # w calm "You've presented me quite the conundrum. If I kiss you now, you'll definitely want to return home with me as soon as possible..."
    w calm "Chà, cậu đặt tui vào bài toán hóc búa đây. Nếu giờ tui hun cậu, chắc chắn cậu sẽ muốn kéo tui về ngay và luôn..."

# game/script.rpy:2117
translate vi ch4_80145f9c:

    # w happy "But I wasn't done learning all about you. I'm not ready for our date to end 💙"
    w happy "Nhưng tui vẫn chưa tìm hiểu về cậu xong. Tui vẫn chưa sẵn sàng kết thúc buổi hẹn của chúng ta bây giờ 💙"

# game/script.rpy:2118
translate vi ch4_5974e4ff:

    # p embarrassed "O-oh... that IS a conundrum...."
    p embarrassed "Ô... đúng là bài toán hóc búa...."

# game/script.rpy:2119
translate vi ch4_dbc74acd:

    # w love "Yes, you see? Both options are equally appealing. However can I decide~?"
    w love "Đó, thấy chưa? Cả hai lựa chọn tui đều thích. Giờ tui phải quyết sao đây~?"

# game/script.rpy:2120
translate vi ch4_ec2c6956:

    # p shy "Haha, um, well... i-it's still light out! Maybe we can hold back until after dinner...."
    p shy "Haha, ừ thì... g-giờ trời vẫn còn sáng mà! Chúng ta có thể đợi đến sau bữa tối...."

# game/script.rpy:2121
translate vi ch4_584de9f1:

    # w teehee "Or I could have YOU for dinner 💙"
    w teehee "Hoặc tui có thể dùng CẬU làm bữa tối 💙"

# game/script.rpy:2122
translate vi ch4_31907a91:

    # p kyaa "A-AH...!" with vpunch
    p kyaa "A-A...!" with vpunch

# game/script.rpy:2123
translate vi ch4_f4a3afbc:

    # w calm "On the other hand, you bring up a valid point. Holding back is fun in itself."
    w calm "Mặt khác, cậu cũng đưa ra một lựa chọn không tồi. Đợi chờ là hạnh phúc mà."

# game/script.rpy:2124
translate vi ch4_9d41c26b:

    # p omgstop "Do you expect me to recover after what you just said...?!"
    p omgstop "Cậu muốn tôi hồi phục kiểu gì sau cái câu vừa nãy...?!"

# game/script.rpy:2125
translate vi ch4_32adccf0:

    # w happy "See~? This IS quite fun!"
    w happy "Thấy chưa~? Vui mà!"

# game/script.rpy:2126
translate vi ch4_b5263d43:

    # w calm "It's decided, then. The date continues."
    w calm "Quyết định rồi nhé. Chúng ta tiếp tục buổi hẹn."

# game/script.rpy:2130
translate vi ch4_98062818:

    # "I give Pastille a moment to calm himself."
    "Tui đợi một lúc cho Pastille trấn tĩnh lại."

# game/script.rpy:2131
translate vi ch4_43346300:

    # "We walk up to the railing and look out at the town..."
    "Bọn tui bước dọc theo lan can, ngắm nhìn khu phố..."

# game/script.rpy:2132
translate vi ch4_2e739e18:

    # nvl clear
    # "You can see Atelier Sweets from here. And the train station next to it."
    nvl clear
    "Tui có thể thấy Atelier Sweets từ chỗ này. Kế đó là nhà ga."

# game/script.rpy:2134
translate vi ch4_65c0b220:

    # "My house is... somewhere in a row of similarly built homes. Inconspicuous."
    "Nhà của tui thì... loanh quanh đâu đó trong cái dãy nhà được xây na ná nhau, rất khó tìm."

# game/script.rpy:2135
translate vi ch4_140deac1:

    # "Fallen petals litter the bricks at our feet, with every little breeze carrying a few more over the railing to land somewhere unknown."
    "Những cánh hoa rơi vương vãi dưới chân chúng tôi cứ cuốn theo từng cơn gió đến vùng đất lạ."

# game/script.rpy:2136
translate vi ch4_9b3a7e5d:

    # "After watching them for a while, I turn back to Pastille."
    "Sau khi ngắm nhìn chúng một hồi, tui quay mặt về Pastille."

# game/script.rpy:2137
translate vi ch4_76b2fe88_11:

    # nvl clear
    nvl clear

# game/script.rpy:2140
translate vi ch4_6319f667:

    # w date "Tell me about your magic."
    w date "Kể tui nghe về phép thuật của cậu đi."

# game/script.rpy:2141
translate vi ch4_81ee26b5:

    # p um "O-okay... what do you want to know?"
    p um "Đ-được thôi... cậu muốn biết về cái gì?"

# game/script.rpy:2142
translate vi ch4_c829cbee:

    # w innocent "Your specialty, dear!"
    w innocent "Tất nhiên là phép thuật chuyên môn của cậu rồi!"

# game/script.rpy:2143
translate vi ch4_9847abef:

    # w smile "If you were that good at reconstruction, I imagine it must fall somewhere in that category...?"
    w smile "Cậu giỏi tái thiết như vậy, nên tui hình dung chắc phải là cái gì đó liên quan...?"

# game/script.rpy:2144
translate vi ch4_b09961bf:

    # p ehe "Um, not really... I'm actually an astral witch."
    p ehe "Ừm, cũng không hẳn... Thực ra tôi là phù thủy tinh tú."

# game/script.rpy:2145
translate vi ch4_443121bc:

    # w my "My, how rare! And what exactly does that entail for you?"
    w my "Chà, hàng hiếm nha! Dùng để làm gì thế?"

# game/script.rpy:2146
translate vi ch4_44c2df3e:

    # p shy "Ahh, well, I mostly use it for fire spells, like anyone else..."
    p shy "A, tôi chủ yếu dùng cho chú thuật lửa như mọi người thôi..."

# game/script.rpy:2147
translate vi ch4_bcabe313:

    # w oh "Forgive me, I'm not well-versed in magic theory... but doesn't astral magic have something to do with creation?"
    w oh "Thứ lỗi vì tui không thạo lý thuyết phép thuật... nhưng không phải phép thuật tinh tú liên quan tới sáng tạo sao?"

# game/script.rpy:2148
translate vi ch4_ac2d501e:

    # p ehe2 "It does... but that stuff is pretty advanced. I haven't been able to find any books explaining how to use it."
    p ehe2 "Đúng là vậy... nhưng cái đó là kỹ năng nâng cao. Tôi vẫn chưa tìm được cuốn sách nào hướng dẫn cách sử dụng nó cả."

# game/script.rpy:2149
translate vi ch4_02f8bfe1:

    # p embarrassed "...Which is probably for the best, actually. No one should be allowed to go around creating souls spontaneously...!"
    p embarrassed "...Nhưng như vậy lại tốt. Không ai nên được phép tự tiện tạo ra linh hồn cả...!"

# game/script.rpy:2150
translate vi ch4_29508975:

    # w neutral "Hm..."
    w neutral "Hừm..."

# game/script.rpy:2152
translate vi ch4_1b5322bf:

    # "Pastille rubs the back of his neck, looking off into the distance."
    "Pastille gãi cổ, nhìn về xa xăm."

# game/script.rpy:2153
translate vi ch4_309805fa:

    # "He seems so troubled by the subject..."
    "Cậu ấy có vẻ lo ngại chủ đề này..."

# game/script.rpy:2154
translate vi ch4_9604342e:

    # "I suppose because he had been living without magic, it may feel strange to openly discuss it?"
    "Chắc là vì cậu ấy trước giờ sống không dựa vào phép thuật, nên giờ bàn luận về chủ đề này có hơi lạ chăng?"

# game/script.rpy:2155
translate vi ch4_48123bf8:

    # nvl clear
    # "An astral witch, though... I wouldn't have guessed."
    nvl clear
    "Phù thủy tinh tú à... Tui không đoán được luôn đó."

# game/script.rpy:2157
translate vi ch4_c8d56a68:

    # "Putting two and two together, ONE thing makes perfect sense now..."
    "Nhưng mà liên kết lại thì tui hiểu ra được một chuyện..."

# game/script.rpy:2158
translate vi ch4_551942a5:

    # nvl clear
    # w ah "So the famous Atelier Sweets golem was YOUR creation?"
    nvl clear
    w ah "Hóa ra golem trứ danh của Atelier Sweets là do cậu tạo hả?"

# game/script.rpy:2161
translate vi ch4_2c8fd31f:

    # p ehe2 "Haha, is she really that famous? I'd expect our sales to be a little better if that were the case..."
    p ehe2 "Haha, nó nổi tiếng vậy sao? Nếu vậy tôi nghĩ tiệm phải đông khách hơn chứ..."

# game/script.rpy:2162
translate vi ch4_fd97e90a:

    # p flustered2 "But... yeah. Just don't go around telling everyone--I didn't know what I was doing when I made her."
    p flustered2 "Đừng nói cho ai biết nhé--Tôi cũng không hiểu mình làm cái quái gì lúc tạo ra cô ấy nữa."

# game/script.rpy:2163
translate vi ch4_e7fb158c:

    # w my "What an amazing feat... and yet you sound almost ashamed of it!"
    w my "Quả là một kỳ tích... vậy mà cậu có vẻ xấu hổ về chuyện đó nữa chứ!"

# game/script.rpy:2164
translate vi ch4_0bf92251:

    # p ohno "I-it's not like I regret it or anything... Gumdrop is really great! I just..."
    p ohno "C-cũng không phải tôi hối hận hay gì... Gumdrop là một cô gái tuyệt vời! Chỉ là..."

# game/script.rpy:2165
translate vi ch4_2ed99bc8:

    # p nervous "I feel bad that she's stuck in a body with so many limitations. Like, she didn't ask to be made that way..."
    p nervous "Tôi cảm thấy có lỗi khi cô ấy mắc kẹt trong một cơ thể có quá nhiều giới hạn như vậy. Cô ấy còn chẳng đòi được tạo nên như thế cơ..."

# game/script.rpy:2166
translate vi ch4_8694e630:

    # p flustered2 "I didn't know you could even make golems that felt real emotions, so of course I never considered any of that."
    p flustered2 "Tôi không biết mình có thể tạo nên những golem có cảm xúc thực sự, nên tôi chưa bao giờ nghĩ tới chuyện đó cả."

# game/script.rpy:2167
translate vi ch4_cde66f06:

    # p shy "...Sorry to go off about it. I-I've just been feeling guilty lately--kind of a heavy topic."
    p shy "...Xin lỗi vì lải nhải nhiều vậy. D-dạo gần đây tôi cứ cảm thấy tội lỗi ấy--nên đây là một chủ đề hơi nặng nề với tôi."

# game/script.rpy:2168
translate vi ch4_9931704c:

    # w ah "No, no... thank you for telling me."
    w ah "Không đâu... cảm ơn đã nói cho tui nghe nhé."

# game/script.rpy:2169
translate vi ch4_b7df5332:

    # w calm "It's as if I've discovered a whole new side of you today. I'm grateful to know it."
    w calm "Hôm nay được khám phá một khía cạnh hoàn toàn mới của cậu thế này, tui vui lắm."

# game/script.rpy:2170
translate vi ch4_d2da19ee:

    # p ehe "Thanks for listening... I don't get many chances to talk about things like this, so I'm grateful for it, too."
    p ehe "Cảm ơn cậu đã lắng nghe... Tôi không có mấy cơ hội để nói về những chuyện thế này, nên tôi cũng cảm thấy vui nữa."

# game/script.rpy:2171
translate vi ch4_2f822c09:

    # w love "Hmhm, hearing you speak of her though, I'd love to meet this golem of yours one day."
    w love "Nhưng mà, nghe cậu kể như vậy làm tui muốn được gặp golem đó ghê ý."

# game/script.rpy:2172
translate vi ch4_87960f32:

    # p sure "Sure. Maybe one day."
    p sure "Được thôi, có lẽ vào một ngày nào đó."

# game/script.rpy:2175
translate vi ch4_e955de1d:

    # "Pastille is amazing."
    "Pastille quá tuyệt vời."

# game/script.rpy:2176
translate vi ch4_dd1b4e98:

    # "I've never met anyone who would downplay their talents this much--I could ask a thousand questions and still only scratch the surface..."
    "Tui chưa gặp ai tự hạ thấp tài năng của mình như vậy--Thậm chí, tui có hỏi hàng nghìn câu thì nó vẫn mới chỉ là bề nổi..."

# game/script.rpy:2177
translate vi ch4_034046bb:

    # "My, now I'M the insatiable one. How the tables have turned!"
    "Giờ thì tui mới là người tham lam vô độ. Đúng là nghiệp quật!"

# game/script.rpy:2178
translate vi ch4_aa528040:

    # nvl clear
    # "We decide it's time to move on, and descend the stairs from whence we came..."
    nvl clear
    "Cả hai quyết định đã tới lúc đi tiếp và đi xuống cầu thang, nơi mà bọn tui đi lên lúc nãy..."

# game/script.rpy:2180
translate vi ch4_5310cd5c:

    # "...Still chatting endlessly as we decide where we'll wander to next."
    "...Vừa quyết định điểm đến kế tiếp vừa tám nhảm trên trời dưới đất."

# game/script.rpy:2181
translate vi ch4_76b2fe88_12:

    # nvl clear
    nvl clear

# game/script.rpy:2184
translate vi ch4_ab4f864b:

    # "Over dinner, Pastille opens up a little more."
    "Trong bữa tối, Pastille có mở lòng với tui thêm một xíu."

# game/script.rpy:2185
translate vi ch4_2a1a4890:

    # "We trade anecdotes, listening intently to each others' stories no matter how unremarkable the events told within them."
    "Bọn tui kể nhau nghe những câu chuyện dù là vặt vãnh nhất."

# game/script.rpy:2186
translate vi ch4_a504ab29:

    # "I could never tire of it~ I was hooked by his every word."
    "Tui thề là bản thân không chán một giây phút nào luôn~ Cứ bị cuốn theo từng lời cậu ấy kể."

# game/script.rpy:2187
translate vi ch4_efbe6e4c:

    # nvl clear
    # "Alas, the hours flew by, and our day together was quickly approaching its end..."
    nvl clear
    "Sau nhiều giờ đồng hồ thấm thoắt trôi nhanh, buổi hẹn cũng dần đi đến hồi kết..."

# game/script.rpy:2189
translate vi ch4_d04a4349:

    # "But now we had the whole night to look forward to 💙"
    "Nhưng bọn tui vẫn còn cả một đêm dài đáng trông mong 💙"

# game/script.rpy:2190
translate vi ch4_b7200d05:

    # "The sun was on its way down as we emerged back onto the street, the atmosphere so different than it had been just a short while ago."
    "Mặt trời đang lặn dần khi bọn tui xuống phố, chỉ trong một thời gian ngắn mà bầu không khí đã rất khác."

# game/script.rpy:2191
translate vi ch4_d4905e0a:

    # "Pastille brushes his bangs aside and asks..."
    "Pastille lấy tay gạt tóc mái sang một bên rồi hỏi..."

# game/script.rpy:2192
translate vi ch4_76b2fe88_13:

    # nvl clear
    nvl clear

# game/script.rpy:2194
translate vi ch4_b2bdea1d:

    # p "Do you wanna head back? It's starting to get late...."
    p "Cậu muốn về nhà chưa? Cũng trễ rồi...."

# game/script.rpy:2195
translate vi ch4_843a037d:

    # w date shy "Hmhm, you've waited so patiently to be able to say that."
    w date shy "Cậu đã nói vậy, chứng tỏ cũng rất ngoan ngoãn chờ đợi rồi nhỉ."

# game/script.rpy:2196
translate vi ch4_8b799080:

    # p embarrassed "I-it's not like you aren't thinking of it too..."
    p embarrassed "C-cậu cũng nghĩ tới chuyện đó còn gì..."

# game/script.rpy:2197
translate vi ch4_6cca094e:

    # w innocent "Let's go through the park. It's a shorter walk 💙"
    w innocent "Đi lối qua công viên nhé, đường đó ngắn hơn 💙"

# game/script.rpy:2198
translate vi ch4_027952fc:

    # p ehe "Sure...! A-after you...."
    p ehe "Được...! C-cậu đi trước đi..."

# game/script.rpy:2200
translate vi ch4_7984db30:

    # n "Periwinkle extends his hand, which Pastille takes without hesitation."
    n "Periwinkle đưa tay ra, Pastille nắm lấy không ngần ngại."

# game/script.rpy:2201
translate vi ch4_93861845:

    # n "Under cover of dusk, they walk toward the park with fingers gently intertwined..."
    n "Tay trong tay, họ tiến về phía công viên dưới ánh hoàng hôn..."

# game/script.rpy:2205
translate vi ch4_25bb3367:

    # "This park, during twilight hours, is nearly always deserted."
    "Công viên này vào buổi chạng vạng hầu như luôn vắng vẻ."

# game/script.rpy:2206
translate vi ch4_df0cd7c9:

    # "Tonight was no exception. We had the entire place to ourselves 💙"
    "Đêm nay cũng không ngoại lệ. Nên bọn tui có thể chiếm dụng nó cho riêng mình 💙"

# game/script.rpy:2207
translate vi ch4_6ecf5db9:

    # "This way I can cling to Pastille all I want~! And on top of that..."
    "Như vậy tui có thể đu bám thân mật các kiểu với Pastille thoải mái~! Và quan trọng nhất là..."

# game/script.rpy:2208
translate vi ch4_76b2fe88_14:

    # nvl clear
    nvl clear

# game/script.rpy:2210
translate vi ch4_4d0933e5:

    # w date calm "Hmhm... 💙"
    w date calm "He he... 💙"

# game/script.rpy:2211
translate vi ch4_861071a6:

    # p ehe "What are you smiling about?"
    p ehe "Cậu cười chuyện gì đấy?"

# game/script.rpy:2212
translate vi ch4_94a989eb:

    # w happy "Finally, no one's around! We can talk about all the inappropriate things we want 💙"
    w happy "Thì, mãi mới chỉ còn hai đứa mình thế này! Giờ thì có thể thoải mái nói những chủ đề chong tối rồi 💙"

# game/script.rpy:2213
translate vi ch4_f130417b:

    # p shy "Ahh, haha, I knew there was something dangerous about taking this shortcut...."
    p shy "A, haha, biết ngay mà, cậu đòi đi đường tắt là có mùi rồi...."

# game/script.rpy:2214
translate vi ch4_3e2e4df1:

    # w innocent "It's ok then, right~? No one will overhear your lascivious confessions."
    w innocent "Được mà~? Giờ thì không ai ngoài tui nghe được lời thú nhận dâm đãng của cậu."

# game/script.rpy:2215
translate vi ch4_bf583b65:

    # p flustered "Mnnmmmnnn..."
    p flustered "Ưmmmmmmmmm..."

# game/script.rpy:2216
translate vi ch4_7af38195:

    # p omg "Okay. Wh-what do you want to know...?"
    p omg "Rồi. C-cậu muốn biết chuyện gì...?"

# game/script.rpy:2217
translate vi ch4_888ea3f4:

    # w my "Oh--I didnt think you'd actually agree! I don't have anything prepared...."
