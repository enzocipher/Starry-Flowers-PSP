translate thai ch4_768d16f3:

    # w calm "Hmhm, I don't need your superstitions. I have a date to get back to."
    w calm "ฮุ ๆ ไม่อยากรู้เรื่องงมงายอะไรนั่นของเธอหรอก ฉันต้องกลับไปเดตต่อแล้ว"

    # game/script.rpy:2023
translate thai ch4_dfa92959:

    # a smile "Heh, alright. Have fun, Periwinkle...."
    a smile "หึ ตามสบาย ขอให้สนุกนะเพริวิงเคิล..."

    # game/script.rpy:2024
translate thai ch4_c2b45ec4:

    # w innocent "Oh, I very much intend to 💙"
    w innocent "แหม ฉันก็ตั้งใจจะสนุกให้ได้อยู่แล้วแหละ 💙"

    # game/script.rpy:2028
translate thai ch4_7cd4194b:

    # n "Smiling to himself, Periwinkle strides confidently out the door to where Pastille is waiting."
    n "เพริวิงเคิลยิ้มกับตัวเองแล้วก็เดินออกจากร้านด้วยความมั่นใจ ไปหาแพสทีที่กำลังรออยู่"

    # game/script.rpy:2036
translate thai ch4_d3b6758e:

    # p "Hey--um... do I still need to pay for that bottle?"
    p "นี่--เอ่อ... ผมยังต้องจ่ายค่าขวดที่แตกอยู่หรือเปล่า ?"

    # game/script.rpy:2037
translate thai ch4_c189c5fa:

    # w date calm "She didn't mention it."
