translate thai ch4_8c34b708:

    # p flustered "N-Nevermind!! Don't call me anything...!" with vpunch
    p flustered "ช-ช่างมันเถอะ !! ไม่ต้องเรียกผมว่าอะไรทั้งนั้นแหละ...!" with vpunch

    # game/script.rpy:2049
translate thai ch4_58252808:

    # w shy "Hmhmhm 💙 Oh, Pastille...."
    w shy "ฮุฮุฮุ 💙 โธ่ พ่อแพสที..."

    # game/script.rpy:2052
translate thai ch4_5df76680:

    # "We resume our stroll around town..."
