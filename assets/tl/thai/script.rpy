    # game/script.rpy:312
translate thai start_197230b2:

    # w happy "Then without further ado... let's get ready for my first date with Pastille~! 💙"
    w happy "งั้นถ้าไม่มีอะไรแล้ว... เราไปเตรียมตัวออกเดตแรกของผมกับแพสทีกันเลยคร้าบ~! 💙"

    # game/script.rpy:317
translate thai start_7584d0b6:

    # w calm "Then without further ado..."
    w calm "งั้นถ้าไม่มีอะไรแล้ว..."

