    # game/script.rpy:2038
translate thai ch4_3e5dc9da:

    # p calm "Phew. I'm glad I could fix it... I was worried it might be expensive."
    p calm "เฮ้อ ดีใจจังที่ซ่อมได้... กลัวว่ามันจะแพงอยู่พอดี"

    # game/script.rpy:2039
translate thai ch4_b7aae312:

    # w smile "You never told me you were so good with magic. As I recall, you said you had been living without it?"
    w smile "นายไม่เห็นเคยบอกเลยว่าใช้เวทมนตร์เก่งแบบนี้ เท่าที่จำได้ นายบอกว่านายอยู่โดยไม่ใช้เวทมาพักนึงนี่ ?"

    # game/script.rpy:2040
translate thai ch4_ae7d5ce2:

    # p think "Yeah, mostly."
