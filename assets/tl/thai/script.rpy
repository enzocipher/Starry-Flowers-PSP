translate thai ch4_fd97df8a:

    # "And once we reach the top..."
    "แล้วพอเรามาถึงด้านบน..."

    # game/script.rpy:2060
translate thai ch4_37819467:

    # "A gust of wind swoops through the trees overhead, showering us in flower petals."
    "ลมหอบหนึ่งก็พัดผ่านต้นไม้ที่สูงเหนือหัวเรา ก่อนที่กลีบดอกไม้จะโปรยลงมา"

    # game/script.rpy:2061
translate thai ch4_af3d310d:

    # nvl clear
    # w date ah "Ah. Peach blossoms..."
    nvl clear
    w date ah "อ๊ะ ดอกพีช..."

    # game/script.rpy:2065
translate thai ch4_bf824512:

    # p "It's nice, isn't it?"
    p "สวยเนอะ ?"

    # game/script.rpy:2066
translate thai ch4_745730c3:

    # w love "Hmhm, I can't help but think you're trying to tell me something right now~"
    w love "ฮุ ๆ อดคิดไม่ได้เลยนะเนี่ยว่านายจะสื่ออะไรหรือเปล่าน้า~"

    # game/script.rpy:2067
translate thai ch4_36d2e96b:

    # p oh "Huh...?"
    p oh "หือ...?"

    # game/script.rpy:2068
translate thai ch4_7daf2c79:

    # w smile "Don't you remember? My \"aphrodisiac\" was also peach-scented..."
    w smile "จำไม่ได้เหรอ ? ยา \"ปลุกกำหนัด\" ของฉันก็เป็นกลิ่นพีชนะ..."

    # game/script.rpy:2069
translate thai ch4_290ca16a:

    # p wha "Ah..."
    p wha "อ๊ะ..."

    # game/script.rpy:2070
translate thai ch4_d493bae3:

    # p kyaa "A-AH...! I WASN'T THINKING ABOUT THAT...!!!" with vpunch
    p kyaa "อ-อ๊า...! ผมไม่ได้คิดอะไรแบบนั้นนะ...!!!" with vpunch

    # game/script.rpy:2071
translate thai ch4_d739c596:

    # p wow "I-I just, was trying to think of other places we could go, and this one came to mind..."
