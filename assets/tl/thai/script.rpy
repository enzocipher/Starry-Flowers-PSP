    w teehee "ฉันคงทำอะไรไม่ได้ มีแต่ต้องตามใจนายสิน้าพ่อยาใจ 💙"

    # game/script.rpy:1111
translate thai ch2_60a65ab5:

    # p dying "...O-oh nooo~"
    p dying "...อ-โอ้ ไม่น้า~"

    # game/script.rpy:1115
translate thai ch2_de805c4f:

    # n "Pastille's halfhearted protests end there."
    n "เสียงร้องประท้วงแบบไม่จริงจังเท่าไหร่ของแพสทีหยุดลงแต่เพียงเท่านี้"

    # game/script.rpy:1116
translate thai ch2_016f8419:

    # n "Periwinkle's hands were already upon him, and would continue to be for the rest of the night..."
