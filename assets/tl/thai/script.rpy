    # game/script.rpy:2045
translate thai ch4_32e4b18b:

    # p scream "N-no!! Please go back to saying \"my sweet\"!!!" with vpunch
    p scream "ป-เปล่าสักหน่อย !! กลับไปใช้คำว่า \"ยาใจ\" เถอะ !!!" with vpunch

    # game/script.rpy:2046
translate thai ch4_e86c0674:

    # w love "Ah~ if you like that one so much, I suppose I have no choice! 💙"
    w love "อ๋า~ ถ้าชอบคำนั้นมากขนาดนี้ ฉันก็คงไม่มีทางเลือกเนอะ 💙"

    # game/script.rpy:2047
translate thai ch4_419d487f:

    # p omgstop "I-I... I just meant...!"
