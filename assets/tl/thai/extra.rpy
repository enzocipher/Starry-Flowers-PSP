translate thai ch4b_58fdf0f7:

    # p nervous "(So tempting that... it scares me a little....)"
    p nervous "(มากจน... ทำให้ผมกลัวขึ้นมาหน่อย ๆ เลย....)"

    # game/extra.rpy:183
translate thai ch4b_9f4ec5a3:

    # p ohno2 "...."
    p ohno2 "...."

    # game/extra.rpy:185
translate thai ch4b_dd073ad1:

    # n "Pastille takes Periwinkle's hand and tucks it back under the blanket."
    n "แพสทีจับมือเพริวิงเคิลไว้แล้วสอดกลับเข้าใต้ผ้าห่ม"

    # game/extra.rpy:186
translate thai ch4b_27bd1f72:

    # p ehe "Sleep well, okay...?"
    p ehe "หลับให้สบายนะ โอเคไหม...?"

    # game/extra.rpy:192
translate thai ch4b_d5c67421:

    # p "...."
    p "...."

    # game/extra.rpy:193
translate thai ch4b_ffe63e17:

    # p shy "(I have to head back... Sy's already gonna ask all sorts of questions....)"
    p shy "(ผมต้องกลับแล้ว... ไซต้องถามอะไรเยอะแยะแหงเลย....)"

    # game/extra.rpy:194
translate thai ch4b_4c1cca4f:

    # p nervous "(It was only supposed to be a few hours...! But I was having too much fun, I couldn't just....)"
    p nervous "(จริง ๆ กะไว้ว่าแค่ไม่กี่ชั่วโมงแท้ ๆ...! แต่มันเพลินมาก ถ้าต้องตัดจบผมคง....)"

    # game/extra.rpy:195
translate thai ch4b_dc4bf3cb:

    # p flustered2 "......"
    p flustered2 "......"

    # game/extra.rpy:196
translate thai ch4b_7f8ad697:

    # p nervous "(Ahhh... this is serious, isn't it...?)"
    p nervous "(อ่าาา... นี่มันเรื่องจริงจังแล้วไหมนะ...?)"

    # game/extra.rpy:199
translate thai ch4b_2d0b4090:

    # n "Pastille hurriedly makes his way out the door, a hand over his mouth to hide his troubled expression...."
    n "แพสทีรีบเดินออกมานอกประตู พร้อมกับมือที่ปิดปากซ่อนสีหน้าลำบากใจไว้..."

    # game/extra.rpy:219
translate thai ex1_c7fa8f0c:

    # n "Today, Astragalus has asked Pastille to work his magic on her busted lamp."
    n "วันนี้แอสทรากาลัสขอให้แพสทีมาช่วยใช้เวทมนตร์ซ่อมหลอดไฟแตก ๆ ให้หน่อย"

    # game/extra.rpy:220
translate thai ex1_76941416:

    # n "He happily agrees. Meanwhile, Periwinkle looks on, arms folded and pouting..."
