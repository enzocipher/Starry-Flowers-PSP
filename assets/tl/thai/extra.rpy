    # game/extra.rpy:66
translate thai ch0_dfca331a:

    # w drool "(...Ah! I don't see her, but I DO see something I like...!)"
    w drool "(...อ๊ะ ! ไม่เจอสาว แต่ก็เจออย่างอื่นที่โดนใจอยู่นะ...!)"

    # game/extra.rpy:73
translate thai ch0_1c24cd1b:

    # n "Periwinkle walks in, and promptly approaches the sweet pink-haired boy at the counter..."
    n "เพริวิงเคิลเดินเข้าร้าน ตรงดิ่งไปหาพ่อหนุ่มผมสีชมพูที่เคาน์เตอร์ทันที"

    # game/extra.rpy:74
translate thai ch0_34bd6345:

    # w drool "(My, he's even cuter up close...!)"
    w drool "(หูย เห็นใกล้ ๆ ยิ่งน่ารัก...!)"

    # game/extra.rpy:75
translate thai ch0_f86c2b17:

    # w innocent "Why, hello there! This is the shop famous for the Candy Golem, is it not?"
    w innocent "สวัสดีครับ ! ร้านนี้ที่มีโกเลมลูกกวาดชื่อดังใช่ไหมเอ่ย ?"

    # game/extra.rpy:76
translate thai ch0_23769f52:

    # p ehe "Oh! Um, yes, it is!"
    p ehe "โอ๊ะ ! เอ่อ ใช่แล้วครับ !"

    # game/extra.rpy:77
translate thai ch0_dd5c1252:

    # p smile "If you wanted to meet Gumdrop, you unfortunately just missed her."
    p smile "ถ้าคุณอยากเจอกัมดรอป น่าเสียดายที่วันนี้คลาดกันพอดีเลยนะครับ"

    # game/extra.rpy:78
translate thai ch0_523dc01e:

    # w calm "Mm... bad luck on my part. I'll have to come back another time, I suppose."
    w calm "อืม... ดวงไม่ดีเองแฮะ สงสัยต้องมาวันอื่นแล้ว"

    # game/extra.rpy:79
translate thai ch0_35bbf6dd:

    # p "Sorry about that. Have a nice day!"
    p "ขอโทษด้วยนะครับ ขอให้โชคดีครับ !"

    # game/extra.rpy:80
translate thai ch0_805bf189:

    # w smile "Oh, I wasn't planning on leaving just yet. After all, I came all this way..."
    w smile "อ้อ แต่ฉันยังไม่ไปหรอก ไหน ๆ ก็มาถึงนี่แล้ว..."

    # game/extra.rpy:81
translate thai ch0_6e44e9fb:

    # p ehe "Right... in that case, I'll leave you to browse our selection!"
    p ehe "อ๋อครับ... ถ้าอย่างนั้นก็เชิญเลือกสินค้าตามสบายเลยนะครับ !"

    # game/extra.rpy:82
translate thai ch0_28a6fc88:

    # w innocent "Ohhh no, you're not getting away that easily. Keep me company, won't you?"
    w innocent "โอ๊ยยยไม่ได้นะ ไม่ให้เลี่ยงกันไปง่าย ๆ แบบนั้นหรอก อยู่เป็นเพื่อนหน่อยสิ ได้ไหม ?"

    # game/extra.rpy:83
translate thai ch0_31f387a8:

    # p wha "H-huh?"
    p wha "อ-เอ๋ ?"

    # game/extra.rpy:84
translate thai ch0_c17ef390:

    # w shy "I'm absolutely useless at making decisions, you see..."
    w shy "คือฉันน่ะตัดสินใจอะไรไม่เก่งเลย..."

    # game/extra.rpy:85
translate thai ch0_d04abaa0:

    # p shy "Oh! Certainly...!"
    p shy "อ้อ ! ได้เลยครับ...!"

    # game/extra.rpy:89
translate thai ch0_4921749b:

    # n "Visibly flustered by Periwinkle's words, the pink-haired boy comes out from behind the counter to assist his customer..."
    n "พ่อหนุ่มผมชมพูที่ดูตื่นตกใจกับคำของเพริวิงเคิลเดินออกมาจากหลังเคาน์เตอร์เพื่อช่วยลูกค้าเลือกของ..."

    # game/extra.rpy:91
translate thai ch0_0a59ab6f:

    # p "Do you have a favorite type of candy? Or maybe flavor? Anything to narrow it down...?"
    p "ชอบลูกกวาดชนิดไหนบ้างไหมครับ ? หรืออาจจะรสที่ชอบ ? มีอะไรให้ตีวงให้แคบลงมาได้บ้าง...?"

    # game/extra.rpy:92
translate thai ch0_a3230f71:

    # w smile "Mm... I'm a little fickle. What would you recommend?"
    w smile "อืม... ฉันออกจะใจโลเลน่ะ มีอันไหนแนะนำบ้าง ?"

    # game/extra.rpy:93
translate thai ch0_4c8d8bbd:

    # p think "Well, these ones have been pretty popular lately..."
    p think "งั้นช่วงนี้เป็นเจ้าพวกนี้ที่คนซื้อกันเยอะ..."

    # game/extra.rpy:94
translate thai ch0_19a0dc4e:

    # n "He gestures to the shelf in front of them. Periwinkle takes a step closer..."
    n "เขาชี้ชั้นวางที่อยู่ด้านหน้าของทั้งสองคน แต่เพริวิงเคิลกลับเดินเข้าไปใกล้เขาอีกก้าว..."

    # game/extra.rpy:95
translate thai ch0_8144cefd:

    # w oh "I'm not asking what's popular, I'm asking what you'd recommend, Mister...?"
    w oh "ไม่ได้ถามสักหน่อยว่าคนซื้ออันไหนกันเยอะ ถามว่าคุณน่ะจะแนะนำอะไรให้ฉันดี คุณ...?"

    # game/extra.rpy:96
translate thai ch0_b7d62e38:

    # p wha "Pastille."
    p wha "แพสทีครับ"

    # game/extra.rpy:97
translate thai ch0_0b2e9ec8:

    # w happy "Pastille... hmhm, is that why you decided to work at a candy shop? Because of your name?"
    w happy "แพสที... ฮุ ๆ ก็เลยมาทำงานที่ร้านลูกกวาดเหรอ ? เป็นเพราะชื่อนี่เอง ?"

    # game/extra.rpy:98
translate thai ch0_30b93b81:

    # p ehe2 "N-no, I just ended up here..."
    p ehe2 "ป-เปล่าครับ ทำไปทำมาก็มาอยู่นี่เอง..."

    # game/extra.rpy:99
translate thai ch0_928ff8dc:

    # w drool "I don't think I've ever tried pastilles before... how would you say they compare to other candies?"
    w drool "ฉันก็ไม่เคยลองลูกอมแพสทีมาก่อนด้วย... เทียบกับลูกกวาดอย่างอื่นแล้วมันต่างกันยังไงเหรอ ?"

    # game/extra.rpy:100
translate thai ch0_2a068fe0:

    # p embarrassed "Ah-haha, um, I-I'm not sure how to answer that!"
    p embarrassed "อ่า-หะ ๆ เอ่อ ผ-ผมก็ไม่แน่ใจว่าจะตอบยังไงดี !"

    # game/extra.rpy:101
translate thai ch0_c3ea70e9:

    # n "Periwinkle leans in a little closer..."
    n "เพริวิงเคิลโน้มตัวเข้าไปใกล้อีกนิด..."

    # game/extra.rpy:102
translate thai ch0_9620a3ea:

    # w innocent "Suppose I'll have to taste for myself, hm?"
