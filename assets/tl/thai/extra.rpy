    # w pj shy "...Stay...."
    w pj shy "...อยู่ต่อนะ..."

    # game/extra.rpy:177
translate thai ch4b_a81de006:

    # p "...?"
    p "...?"

    # game/extra.rpy:178
translate thai ch4b_9fb7003a:

    # p shy "...Peri...?"
    p shy "...เพริ...?"

    # game/extra.rpy:179
translate thai ch4b_44efd505_1:

    # w "......"
    w "......"

    # game/extra.rpy:180
translate thai ch4b_b07b82f5:

    # p flustered "...Nnnn......"
    p flustered "...งื้อออ......"

    # game/extra.rpy:181
translate thai ch4b_51f44f83:

    # p omgstop "(It's really tempting... it's really, REALLY tempting...!)"
    p omgstop "(มันน่าอยู่ต่อมาก... มากแบบว่า มาก จริง ๆ...!)"

