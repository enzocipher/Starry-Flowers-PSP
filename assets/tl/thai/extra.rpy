    # w happy "(Ahh, so this is where it is! The place with the cute golem mascot everyone is talking about.)"
    w happy "(อ๋ออ อยู่ตรงนี้นี่เอง ! ร้านที่มีโกเลมน่ารัก ๆ เป็นมาสค็อตร้าน คนเขาพูดถึงกันให้แซดเลย)"

    # game/extra.rpy:64
translate thai ch0_17b65b8e:

    # w oh "(I wonder if she's there...?)"
    w oh "(วันนี้จะอยู่ร้านไหมนะ...?)"

    # game/extra.rpy:65
translate thai ch0_dffb30dd:

    # n "Periwinkle takes a peek through the window..."
