translate thai ch0_20c4440e:

    # p omg "O-okay! I'll ring you up!!" with vpunch
    p omg "อ-โอเค ! เดี๋ยวผมไปคิดเงินให้ !!" with vpunch

    # game/extra.rpy:107
translate thai ch0_34866dbe:

    # n "Pastille retreats behind the counter once more. Periwinkle can hardly keep himself from giggling with delight."
    n "แพสทีถอยกลับไปหลังเคาน์เตอร์อีกครั้ง เพริวิงเคิลแทบกลั้นเสียงหัวเราะคิกคักชอบใจไม่ไหว"

    # game/extra.rpy:108
translate thai ch0_17b5c69e:

    # w drool "(Oh, THIS one is going to be fun...)"
    w drool "(โอ๊ย ตาหนุ่มคนนี้ต้องสนุกแน่...)"

