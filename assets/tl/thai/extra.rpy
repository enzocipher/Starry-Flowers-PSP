    # p aw "Wanna tell me what it's from? Or are you still sound asleep?"
    p aw "บอกหน่อยสิว่ามาจากเรื่องไหน ? หรือนี่ยังหลับสนิทอยู่ ?"

    # game/extra.rpy:135
translate thai ch4b_2c0c50bb:

    # w date calm "...Mmnm...."
    w date calm "...อื้มมม...."

